  ["@//pkg", "//pkg:pkg", "main repository, apparent, implicit name"],
  ["@//:tgt", "//:tgt", "main repository root, apparent"],
  ["@@//pkg:tgt", "//pkg:tgt", "main repository, canonical"],
  ["@@//pkg", "//pkg:pkg", "main repository, canonical, implicit name"],
