"""A default 'run' task that builds a target with `bazel build` and runs the resulting binary."""

load("@aspect//bazel/build_events.axl", "announce_bes_sinks", "bes_args", "bes_link_data", "collect_bes_sinks", "summarize_bes_upload")
load("@aspect//bazel.axl", "BazelTrait", "dispatch_bazel_attempt_end", "dispatch_bazel_build_end", bzl = "bazel")
load("@std//time.axl", "sleep_iter")
load("./private/lib/artifacts.axl", "artifacts")
load("./private/lib/bazel_results.axl", "BES_DRAIN_TICK_MS", "conclusion", "init_data", "process_event")
load("./private/lib/environment.axl", "error")
load("./private/lib/health_check.axl", "HealthCheckTrait")
load("./private/lib/lifecycle.axl", "phases")
load("./private/lib/runnable.axl", "RUN_IN_DESCRIPTION", "resolve_run_in", "runnable")
load("./private/lib/tips.axl", "tips")
load("./private/lib/watch.axl", "watch")

_WATCH_TICK_MS = 100

# Target tag opting into the ibazel notify protocol: instead of a restart, the
# child is spawned with IBAZEL_NOTIFY_CHANGES=y and piped stdin, and each watch
# cycle writes IBAZEL_BUILD_STARTED / IBAZEL_BUILD_COMPLETED <verdict> lines so
# the process (e.g. a devserver) reloads in place.
# https://github.com/bazelbuild/bazel-watcher#running-a-target
_IBAZEL_TAG = "ibazel_notify_changes"

# Additional tag for the versioned protocol: after the legacy completed line,
# the child also receives `IBAZEL_EVENT {json}` describing the build and the
# filesystem changes that triggered it.
_IBAZEL_V1_TAG = "ibazel_notify_changes_v1"

# Files whose change alters the build graph rather than a target's sources,
# reported as kind "graph" in v1 events.
_GRAPH_FILES = ["BUILD", "BUILD.bazel", "MODULE.bazel", "WORKSPACE", "WORKSPACE.bazel"]

def _v1_event(build_success: bool, batch) -> str:
    changes = []
    for c in batch.changes:
        name = c.path.rsplit("/", 1)[-1]
        kind = "graph" if name in _GRAPH_FILES or name.endswith(".bzl") else "source"
        changes.append({"path": c.path, "kind": kind})
    return "IBAZEL_EVENT " + json.encode({
        "version": 1,
        "type": "build_completed",
        "success": build_success,
        "changes": changes,
    }) + "\n"

def _notify_write(stdin, line: str) -> bool:
    """Deliver one whole protocol frame over the child's nonblocking stdin.

    try_write reports bytes accepted and may take a short prefix; a partial
    frame corrupts the notify framing, so retry the unwritten suffix briefly
    and report False on a closed or persistently full pipe. Frames are ASCII
    (json.encode escapes non-ASCII), so character and byte offsets agree.
    """
    remaining = line
    n = stdin.try_write(remaining)
    if n >= len(remaining):
        return True
    if n > 0:
        remaining = remaining[n:]
    for tick in sleep_iter(10):
        n = stdin.try_write(remaining)
        if n >= len(remaining):
            return True
        if n > 0:
            remaining = remaining[n:]
        if tick >= 50:
            break
    return False

def _build_once(ctx: TaskContext, ph, r, target: str, flags: list[str], rc, announce_version: bool, announce_command: bool, phase, label: str):
    """One `bazel build` of `target` with BES drained into `ph.data` and the
    runnable tracker `r`. Returns the BuildStatus."""
    bazel_trait = ctx.traits[BazelTrait]
    bes_sinks = collect_bes_sinks(ctx, bazel_trait, rc)
    ph.data.update(bes_link_data(bazel_trait, rc, bes_sinks))
    events = bazel.build_events.iterator()
    build_events = [events] + bes_sinks

    for hook in bazel_trait.build_start:
        hook(ctx)

    ph.update(
        "running",
        phases.ProgressStyles(
            body = label + "...",
            stream = label,
        ),
        kind = "bazel_results",
        phase = phase,
    )

    # After the phase line, so the streams are announced under the spawn they
    # belong to.
    announce_bes_sinks(ctx, bes_sinks)

    build = ctx.bazel.build(
        target,
        build_events = build_events,
        flags = flags,
        aspects = r.aspects,
        announce_version = announce_version,
        announce_command = announce_command,
    )

    for _tick in sleep_iter(BES_DRAIN_TICK_MS):
        for _ in range(10000):
            event = events.try_pop()
            if event == None:
                break
            r.event(event)
            for handler in bazel_trait.build_event:
                handler(ctx, event)
            process_event(ph.data, event)
        if events.done:
            break

    build_status = build.wait()
    for sink in bes_sinks:
        sink.wait()
    summarize_bes_upload(ctx, bes_sinks)
    dispatch_bazel_attempt_end(ctx, bazel_trait, build_status.code)
    dispatch_bazel_build_end(ctx, bazel_trait, build_status.code)
    return build_status

def _stop_child(child: std.process.Child) -> None:
    """Stop the running target and reap it before the next spawn."""
    child.kill()
    child.wait()

def _spawn_target(ctx: TaskContext, ph, r, target: str, forward_args: list[str], spawn_cwd: str | None, watching: bool) -> struct | None:
    """Resolve the entrypoint and spawn the target; None when unresolvable.

    Returns `struct(child, stdin)`: `stdin` is the child's piped stdin when the
    target opted into the ibazel notify protocol under `--watch`, else None."""
    entrypoint = r.determine_entrypoint(target)
    if entrypoint == None:
        error(ctx.std, "Failed to determine the run entrypoint for %s." % target)
        return None
    notify = watching and _IBAZEL_TAG in entrypoint.tags
    structured = notify and _IBAZEL_V1_TAG in entrypoint.tags
    body = "Running %s (watching for changes)..." if watching else "Running %s..."
    ph.update(
        "running",
        phases.ProgressStyles(
            body = body % target,
            stream = "Running %s" % target,
        ),
        phase = phases.Phase(name = "run", description = "Run target", emoji = "🚀"),
    )
    child = r.spawn(
        entrypoint,
        forward_args,
        cwd = spawn_cwd,
        stdin = "piped" if notify else None,
        env = {"IBAZEL_NOTIFY_CHANGES": "y"} if notify else {},
    )
    return struct(
        child = child,
        stdin = child.stdin() if notify else None,
        structured = structured,
    )

def _watch_loop(ctx: TaskContext, ph, r, target: str, forward_args: list[str], spawn_cwd: str | None, flags: list[str], rc, announce_version: bool, announce_command: bool):
    """Watch loop: rebuild on each settled batch of workspace changes, then
    either notify the running target over the ibazel stdin protocol (targets
    tagged `ibazel_notify_changes`) or terminate and respawn it. Runs until
    Ctrl-C, whose SIGINT the terminal delivers to the child too (it shares
    this process group)."""
    ws = watch.new(ctx)

    build_status = _build_once(
        ctx,
        ph,
        r,
        target,
        flags,
        rc,
        announce_version,
        announce_command,
        phases.Phase(name = "build", description = "Build run target", emoji = "🔨"),
        "Building %s" % target,
    )

    proc = None
    if build_status.success:
        proc = _spawn_target(ctx, ph, r, target, forward_args, spawn_cwd, watching = True)
    else:
        ph.update(
            "running",
            phases.ProgressStyles(body = "Build failed — watching %s for changes..." % ws.root),
            kind = "bazel_results",
        )

    cycle = 0
    for _tick in sleep_iter(_WATCH_TICK_MS):
        if proc != None:
            status = proc.child.try_wait()
            if status != None:
                ph.update(
                    "running",
                    phases.ProgressStyles(
                        body = "%s exited with code %s — watching for changes..." % (target, status.code),
                        stream = "%s exited with code %s" % (target, status.code),
                    ),
                )
                proc = None

        batch = ws.try_pop()
        if batch == None:
            continue

        # The notify path is only taken while every stdin write lands; a failed
        # write means the child closed its end, and the cycle falls back to a
        # restart.
        notify = proc != None and proc.stdin != None
        if notify:
            notify = _notify_write(proc.stdin, "IBAZEL_BUILD_STARTED\n")

        cycle += 1
        ph.reset(init_data())
        build_status = _build_once(
            ctx,
            ph,
            r,
            target,
            flags,
            rc,
            False,
            announce_command,
            phases.Phase(
                name = "rebuild_%d" % cycle,
                description = "Rebuild run target",
                emoji = "🔨",
            ),
            "Rebuilding %s" % target,
        )
        # Deliberately no drain: bazel writes its outputs outside the
        # workspace (the ignore list covers the convenience symlinks), so
        # pending events here are the user's own mid-build edits — dropping
        # them would silently miss a rebuild.

        if not build_status.success:
            if notify:
                _notify_write(proc.stdin, "IBAZEL_BUILD_COMPLETED FAILURE\n")
                if proc.structured:
                    _notify_write(proc.stdin, _v1_event(False, batch))
            ph.update(
                "running",
                phases.ProgressStyles(body = "Build failed — watching for changes..."),
                kind = "bazel_results",
            )
            continue

        if notify:
            delivered = _notify_write(proc.stdin, "IBAZEL_BUILD_COMPLETED SUCCESS\n")
            if delivered and proc.structured:
                delivered = _notify_write(proc.stdin, _v1_event(True, batch))
            if delivered:
                ph.update(
                    "running",
                    phases.ProgressStyles(
                        body = "Notified %s (watching for changes)..." % target,
                        stream = "Notified %s of completed build" % target,
                    ),
                )
                continue

        if proc != None:
            _stop_child(proc.child)
        proc = _spawn_target(ctx, ph, r, target, forward_args, spawn_cwd, watching = True)

def _impl(ctx: TaskContext) -> int | TaskConclusion:
    target = ctx.args.target[0]
    forward_args = list(ctx.args.run_args)

    # Resolve --run-in up front: a bad value (typo, `git-root` outside
    # a git repo) must fail before phases.setup opens status surfaces
    # and before the build spends time.
    spawn_cwd = resolve_run_in(ctx, ctx.args.run_in)

    ph = phases.new(ctx, init_data())

    # The single pre-task setup phase (status surface, rc parse, health
    # checks); returns the resolved flags (a failed health check fails the task
    # inside phases.setup). Expand the "build" rc section, not "run": this task
    # ultimately invokes `ctx.bazel.build`, which spawns a literal `bazel
    # build`. The `run:` rc section can contain options Bazel's `build` command
    # rejects as unrecognized (e.g. `--script_path`).
    rc = ph.setup(target, "bazel_results", "build")
    announce_version, announce_command = bzl.announce.resolve(ctx)
    endpoint_auth_flags = bzl.rc_flags(ctx, rc, "build")

    # `rc=` opts into the runinfo aspect: `r.flags` then carries the spawn
    # flags + aspect injection that capture the executable, the `args` attribute,
    # and the target env so `r.spawn` replays them the way `bazel run` does.
    r = runnable(ctx, [target], rc = rc)
    flags = r.flags + endpoint_auth_flags

    def _conclude(status, code, text):
        """Emit the terminal `task_update` and return the task's conclusion.

        Every exit path goes through here. Without a terminal update the status
        surfaces keep whatever "running" state they last saw — a finished run
        shows as still in progress for as long as the PR comment lives, because
        nothing ever supersedes it.
        """
        ph.dispatch(phases.Update(
            kind = "bazel_results",
            status = status,
            final = True,
            conclusion = text,
            data = ph.data,
            progress = phases.ProgressStyles(body = text),
        ))
        return TaskConclusion(exit_code = code, text = text, flagged = False)

    # The watch loop never concludes: it runs until Ctrl-C ends the process.
    if ctx.args.watch:
        return _watch_loop(ctx, ph, r, target, forward_args, spawn_cwd, flags, rc, announce_version, announce_command)

    build_status = _build_once(
        ctx,
        ph,
        r,
        target,
        flags,
        rc,
        announce_version,
        announce_command,
        phases.Phase(name = "build", description = "Build run target", emoji = "🔨"),
        "Building %s" % target,
    )
    if not build_status.success:
        return _conclude("failed", build_status.code, conclusion("failed", ph.data))

    proc = _spawn_target(ctx, ph, r, target, forward_args, spawn_cwd, watching = False)
    if proc == None:
        return _conclude("failed", 1, "Could not determine the run entrypoint for %s" % target)

    code = proc.child.wait().code
    if code == 0:
        return _conclude("passed", code, "Ran %s" % target)

    # The build succeeded and the program failed. Record that so the renderer
    # reports a run failure rather than falling back to "Failed to build",
    # which is what a failed status with no failure buckets otherwise means.
    ph.data["run"] = {"exit_code": code}
    return _conclude("failed", code, "%s exited %d" % (target, code))

run = task(
    summary = "Build a target with bazel and run the resulting binary.",
    args = {
        "target": args.positional(
            minimum = 1,
            maximum = 1,
            description = "Bazel target to build and run.",
        ),
        "run_args": args.trailing_var_args(
            description = "Arguments forwarded to the target binary. Separate from `aspect run`'s own flags with `--`, e.g. `aspect run //foo:bar -- --binary-arg value`.",
        ),
        "run_in": args.string(
            default = "",
            description = RUN_IN_DESCRIPTION + (
                " Set this for binaries that resolve workspace-relative " +
                "file arguments against the process cwd rather than reading " +
                "`$BUILD_WORKSPACE_DIRECTORY` — e.g. " +
                "`@buildifier_prebuilt//buildifier`, a symlink to the raw " +
                "Go binary with no shell wrapper. Wrapper-based binaries " +
                "that already `cd $BUILD_WORKSPACE_DIRECTORY` on entry see " +
                "this flag as a no-op."
            ),
        ),
    } | watch.ARGS | bzl.flags.args("the build") | bzl.announce.args("the build") | bes_args(),
    traits = [
        BazelTrait,
        HealthCheckTrait,
    ] + phases.TRAITS + artifacts.TRAITS + tips.TRAITS,
    implementation = _impl,
)
