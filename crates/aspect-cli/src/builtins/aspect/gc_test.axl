"""Unit tests for gc.axl — what gets deleted, and whether deleting may proceed.

Run with:
  aspect dev test-gc

Two things decide whether a multi-gigabyte tree is removed, so both are covered
directly:

  - **Classification.** The rule order is tested on the pure `_classify`, and
    the tests build a real output-base-shaped tree under a temp dir and run the
    real `_scan` over it, every state included. The data-loss case is
    `install/` and `cache/`, which sit beside the output bases under the same
    root and are shared by every workspace on the machine — counting them as
    bases offers tens of gigabytes of live cache for deletion.
  - **Consent.** Shared with every other destructive task, so it lives in
    `lib/confirm.axl` and is covered by `aspect dev test-confirm`.

`_reap` is exercised against real trees rather than mocked: it has to survive
the read-only directories Bazel leaves under `bazel-out/`, and it must not
follow the execroot's symlinks out into the user's checkout.

Symlinks are made with `ln -s` because AXL's `fs` has `hard_link` but no
symlink creation, and ages are set with `touch -t` for want of a `utimes`.
"""

load("@aspect//gc.axl", "testonly_classify", "testonly_configured_output_user_root", "testonly_document", "testonly_du_kb", "testonly_fmt_age", "testonly_fmt_kb", "testonly_is_output_base_name", "testonly_move_to_trash", "testonly_outcome", "testonly_plan", "testonly_reap", "testonly_remove_tree", "testonly_scan", "testonly_scan_download_cache", "testonly_select", "testonly_workspace_of")
load("@std//time.axl", "time")

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

# Output bases are md5-named; `_scan` ignores anything else under the root.
_LIVE = "11111111111111111111111111111111"
_DEAD = "22222222222222222222222222222222"
_WEIRD = "33333333333333333333333333333333"
_CMDLINE = "44444444444444444444444444444444"
_BOTH = "55555555555555555555555555555555"
_MARKER = "66666666666666666666666666666666"

_HOUR_US = 3600 * 1000000
_DAY_US = 24 * _HOUR_US

# Long enough ago to be past any age the tests configure.
_LONG_AGO = "202001010000"

def _now_us():
    return time.now_ms() * 1000

def _backdate(ctx: TaskContext, path: str) -> None:
    """Set the mtime and atime of `path` and everything under it to
    `_LONG_AGO`, without following symlinks out of it."""
    ctx.std.process.command("find").args([path, "-exec", "touch", "-h", "-t", _LONG_AGO, "{}", "+"]) \
        .stdout("null").stderr("null").spawn().wait()

def _symlink(ctx: TaskContext, target: str, link: str) -> None:
    ctx.std.process.command("ln").args(["-s", target, link]) \
        .stdout("null").stderr("null").spawn().wait()

def _make_base(ctx: TaskContext, root: str, name: str, workspace: str) -> None:
    """An output base shaped like Bazel's: an execroot holding an absolute
    source symlink back into `workspace`."""
    execroot = root + "/" + name + "/execroot/_main"
    ctx.std.fs.create_dir_all(execroot)
    _symlink(ctx, workspace + "/MODULE.bazel", execroot + "/MODULE.bazel")

def _write_cmdline(ctx: TaskContext, base: str, workspace: str) -> None:
    """A `server/cmdline` shaped like Bazel's: NUL-separated argv."""
    ctx.std.fs.create_dir_all(base + "/server")
    argv = [
        "/usr/local/bin/bazel",
        "--output_base=" + base,
        "--workspace_directory=" + workspace,
        "build",
    ]
    ctx.std.fs.write(base + "/server/cmdline", "\x00".join(argv))

def _fixture(ctx: TaskContext) -> str:
    """A root holding one live base, one orphan, one unattributable base, and
    the two shared directories that must never be classified.

    Every base is backdated, so the orphans are past the grace period; tests
    that care about age pass the max age they mean.
    """
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-test")
    root = tmp + "/root"
    live_ws = tmp + "/live-workspace"
    ctx.std.fs.create_dir_all(root)
    ctx.std.fs.create_dir_all(live_ws)
    ctx.std.fs.write(live_ws + "/MODULE.bazel", "module(name = \"live\")\n")

    _make_base(ctx, root, _LIVE, live_ws)
    _make_base(ctx, root, _DEAD, tmp + "/workspace-that-was-deleted")

    # A base whose execroot never got a symlink forest and whose server left no
    # command line behind: nothing can attribute it, and it must not be guessed
    # at.
    ctx.std.fs.create_dir_all(root + "/" + _WEIRD + "/execroot")
    ctx.std.fs.write(root + "/" + _WEIRD + "/execroot/DO_NOT_BUILD_HERE", "")

    # An invocation that died before analysis: Bazel created the execroot on
    # server start but never populated it, so only `server/cmdline` names the
    # workspace. A tenth of the bases on a developer machine look like this.
    _write_cmdline(ctx, root + "/" + _CMDLINE + "", tmp + "/workspace-also-deleted")
    ctx.std.fs.create_dir_all(root + "/" + _CMDLINE + "/execroot")

    # Both sources present and disagreeing. The execroot reflects the last
    # build, `server/cmdline` the last server start, so the execroot wins.
    _make_base(ctx, root, _BOTH, live_ws)
    _write_cmdline(ctx, root + "/" + _BOTH + "", tmp + "/stale-from-cmdline")

    # Shared infrastructure, not output bases.
    ctx.std.fs.create_dir_all(root + "/install/abc123")
    ctx.std.fs.create_dir_all(root + "/cache/repos/v1/contents")

    # Not md5-shaped, so not a base, whatever it holds.
    _make_base(ctx, root, "not-a-base", tmp + "/workspace-that-was-deleted")

    _backdate(ctx, root)
    return root

def _scan(ctx, root, max_age_us = 0):
    return testonly_scan(ctx, root, _now_us(), max_age_us)

def _doc(ctx, root, verbose, sizes = {}, stale = []):
    """The document for `root`'s real classification, at a given verbosity,
    as a dry run that would remove the orphans."""
    bases = _scan(ctx, root)
    plan = testonly_plan(
        bases = bases,
        removals = [b for b in bases if b.state == "orphan"],
        sizes = sizes,
        cache_entries = len(stale),
        stale = stale,
    )
    outcome = testonly_outcome(reaped = 0, reaped_kb = 0, pruned = 0, pruned_kb = 0)
    return testonly_document(root, True, verbose, {"base_max_age_days": 30}, plan, outcome, {})

def _test_document_counts_every_state(ctx):
    """`output_bases` carries a count for every state, zero included, so a
    consumer reads a key rather than probing for it."""
    root = _fixture(ctx)
    counts = _doc(ctx, root, False)["output_bases"]
    _eq("keys", sorted(counts.keys()), ["idle", "live", "orphaned", "orphaned_within_grace", "trash", "undetermined"])
    _eq("live", counts["live"], 2)
    _eq("orphaned", counts["orphaned"], 2)
    _eq("undetermined", counts["undetermined"], 1)

def _test_document_removals_carry_state_and_size(ctx):
    root = _fixture(ctx)
    path = root + "/" + _DEAD
    doc = _doc(ctx, root, False, sizes = {path: 300})
    removals = {r["path"]: r for r in doc["removals"]}
    _eq("state", removals[path]["state"], "orphan")
    _eq("measured size", removals[path]["kb"], 300)
    _eq("an unmeasured base claims no size", "kb" in removals[root + "/" + _CMDLINE], False)
    _eq("policy passed through", doc["policy"], {"base_max_age_days": 30})
    _eq("reclaimable sums bases and cache", _doc(ctx, root, False, sizes = {path: 300}, stale = [struct(path = "x", kb = 4)])["reclaimable_kb"], 304)

def _test_verbose_lists_what_was_left_alone(ctx):
    """`--verbose` exists so a classification can be checked rather than taken
    on trust, so the kept bases have to carry the workspace each was attributed
    to — that is the part a reader is auditing."""
    root = _fixture(ctx)
    doc = _doc(ctx, root, True)

    _eq("every live base listed", len(doc["live_bases"]), 2)
    _eq("every undetermined base listed", len(doc["undetermined_bases"]), 1)
    _eq("live entries name their workspace", all([e["workspace"] for e in doc["live_bases"]]), True)
    _eq("an undetermined base has none to name", doc["undetermined_bases"][0]["workspace"], "")

    # Nothing sizes the kept bases: a `du` over every live base on the machine
    # would cost more than the run, to report what will not be reclaimed.
    _eq("no sizes claimed", all(["kb" not in e for e in doc["live_bases"]]), True)

def _test_verbose_is_additive_only(ctx):
    """A consumer that never passes `--verbose` must see the same document, so
    the flag may only add keys."""
    root = _fixture(ctx)
    plain = _doc(ctx, root, False)
    verbose = _doc(ctx, root, True)

    _eq("no kept bases by default", "live_bases" in plain, False)
    _eq("none by default either", "undetermined_bases" in plain, False)
    for key in plain:
        _eq("key %s unchanged" % key, verbose[key], plain[key])

# Shuts the machine's own rc files out, so these assert what the fixture says
# rather than whatever the host configured. An Aspect Workflows runner sets
# --output_user_root for the machine, and without this it answers for the
# fixture.
_ISOLATED = ["--nosystem_rc", "--nohome_rc"]

def _rc_fixture(ctx, body):
    """A workspace whose `.bazelrc` is `body`."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-rc")
    ctx.std.fs.write(tmp + "/MODULE.bazel", "")
    ctx.std.fs.write(tmp + "/.bazelrc", body)
    return tmp

def _test_a_workspace_rc_names_the_root_to_collect(ctx):
    """`--output_user_root` is a startup option, so it is the one thing that
    decides which root a workspace's bases live under. Reading it means `gc`
    collects the right root in a repo that relocates it, rather than reporting
    an empty platform default."""
    tmp = _rc_fixture(ctx, "startup --output_user_root=/somewhere/else\n")
    _eq("read from the rc", testonly_configured_output_user_root(ctx, tmp, _ISOLATED), "/somewhere/else")

def _test_a_workspace_without_the_flag_defers(ctx):
    """No override means no opinion, so the caller falls back to the platform
    default rather than being handed a guess."""
    tmp = _rc_fixture(ctx, "build --jobs=4\n")
    _eq("nothing to report", testonly_configured_output_user_root(ctx, tmp, _ISOLATED), "")

def _test_a_relative_root_resolves_against_the_workspace(ctx):
    """Bazel resolves a relative `--output_user_root` against the workspace
    root. Reading it as cwd-relative instead agrees only when the two coincide,
    so `gc` run from any subdirectory would scan somewhere else — or, worse,
    whatever happened to sit at that relative path.
    """
    tmp = _rc_fixture(ctx, "startup --output_user_root=relroot\n")
    _eq(
        "joined to the workspace root",
        testonly_configured_output_user_root(ctx, tmp, _ISOLATED),
        tmp + "/relroot",
    )

def _test_an_absolute_root_is_left_alone(ctx):
    tmp = _rc_fixture(ctx, "startup --output_user_root=/already/absolute\n")
    _eq("untouched", testonly_configured_output_user_root(ctx, tmp, _ISOLATED), "/already/absolute")

def _test_the_last_rc_entry_wins(ctx):
    """The rc chain is last-wins, which is what lets a `~/.bazelrc` relocate the
    root for a whole machine over any workspace's own setting. Asserted within
    one file, since the chain across files is the parser's to get right."""
    tmp = _rc_fixture(ctx, "startup --output_user_root=/first\nstartup --output_user_root=/second\n")
    _eq("last wins", testonly_configured_output_user_root(ctx, tmp, _ISOLATED), "/second")

def _test_fmt_kb(ctx):
    _eq("bytes stay KB", testonly_fmt_kb(512), "512 KB")
    _eq("exact MB", testonly_fmt_kb(1024), "1 MB")
    _eq("MB rounds to nearest", testonly_fmt_kb(2047), "2 MB")
    _eq("GB keeps one decimal", testonly_fmt_kb(1048576), "1.0 GB")
    _eq("7.6 GB", testonly_fmt_kb(7969177), "7.6 GB")
    _eq("zero", testonly_fmt_kb(0), "0 KB")

def _test_workspace_resolves_from_the_execroot_symlink(ctx):
    root = _fixture(ctx)
    live = testonly_workspace_of(ctx, root + "/" + _LIVE)
    _eq("resolved workspace ends with live-workspace", live.endswith("/live-workspace"), True)

def _test_scan_classifies_the_three_outcomes(ctx):
    root = _fixture(ctx)
    bases = _scan(ctx, root)
    states = {}
    for b in bases:
        states[b.name] = b.state
    _eq("live workspace still exists", states[_LIVE], "live")
    _eq("deleted workspace", states[_DEAD], "orphan")
    _eq("no symlink to resolve", states[_WEIRD], "unknown")

def _test_shared_directories_are_never_classified(ctx):
    """The data-loss case: `install/` and `cache/` are shared by every workspace
    and sit beside the output bases. Classifying them would offer tens of
    gigabytes of live cache for deletion."""
    root = _fixture(ctx)
    names = [b.name for b in _scan(ctx, root)]
    _eq("install is not a base", "install" in names, False)
    _eq("cache is not a base", "cache" in names, False)
    _eq("nor is a directory not named like one", "not-a-base" in names, False)
    _eq("only the real bases", sorted(names), [_LIVE, _DEAD, _WEIRD, _CMDLINE, _BOTH])

def _test_orphan_carries_the_workspace_it_lost(ctx):
    """The report names the workspace that went away; without it a reader can't
    tell whether the deletion is safe."""
    root = _fixture(ctx)
    for b in _scan(ctx, root):
        if b.name == _DEAD:
            _eq("names the vanished workspace", b.workspace.endswith("/workspace-that-was-deleted"), True)
            return
    fail("deadbase was not scanned")

def _test_cmdline_attributes_a_base_with_an_empty_execroot(ctx):
    """A build that died before analysis leaves the execroot empty, and on a
    developer machine that is a tenth of all bases. Without the `server/cmdline`
    fallback they stay undetermined and are never reclaimed."""
    root = _fixture(ctx)
    ws = testonly_workspace_of(ctx, root + "/" + _CMDLINE + "")
    _eq("resolved from cmdline", ws.endswith("/workspace-also-deleted"), True)

    for b in _scan(ctx, root):
        if b.name == _CMDLINE:
            _eq("classified, not left undetermined", b.state, "orphan")
            return
    fail("cmdlinebase was not scanned")

def _test_execroot_wins_over_a_stale_cmdline(ctx):
    """`server/cmdline` records the last server *start*; the execroot records
    the last build. When they disagree the execroot is the fresher answer, and
    reading the stale one could call a live base an orphan."""
    root = _fixture(ctx)
    ws = testonly_workspace_of(ctx, root + "/" + _BOTH + "")
    _eq("execroot wins", ws.endswith("/live-workspace"), True)

def _test_reap_removes_a_base_bazel_left_read_only(ctx):
    """Bazel strips the owner-write bit from action output directories under
    `bazel-out/`, and unlinking a child needs write on its parent. Without the
    `chmod` this fails with EACCES on every base that completed a build — which
    is every base large enough to be worth reclaiming.
    """
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-perm")
    base = tmp + "/base"
    locked = base + "/execroot/_main/bazel-out/k8-fastbuild/bin/pkg/build_script.out_dir"
    ctx.std.fs.create_dir_all(locked)
    ctx.std.fs.write(locked + "/out.txt", "an action output\n")
    ctx.std.fs.set_permissions(locked, 0o555)

    reaped = testonly_reap(ctx, base, 0)
    _eq("reported as reaped", reaped, True)
    _eq("actually gone", ctx.std.fs.exists(base), False)

def _test_reap_does_not_reach_outside_the_base(ctx):
    """The execroot is a forest of absolute symlinks into the user's checkout,
    so the `chmod -R` that makes a base removable must not follow them. If it
    did, `aspect gc` would quietly relax permissions across real source trees —
    and the `rm` that follows must not reach them either.
    """
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-escape")
    ws = tmp + "/workspace"
    base = tmp + "/base"
    execroot = base + "/execroot/_main"
    ctx.std.fs.create_dir_all(ws)
    ctx.std.fs.create_dir_all(execroot)
    ctx.std.fs.write(ws + "/source.txt", "a file the user owns\n")
    ctx.std.fs.set_permissions(ws + "/source.txt", 0o444)
    _symlink(ctx, ws + "/source.txt", execroot + "/source.txt")
    _symlink(ctx, ws, execroot + "/wsdir")

    _eq("reaped", testonly_reap(ctx, base, 0), True)
    _eq("base is gone", ctx.std.fs.exists(base), False)
    _eq("the workspace survives", ctx.std.fs.exists(ws + "/source.txt"), True)
    _eq("and is still read-only", ctx.std.fs.metadata(ws + "/source.txt").readonly, True)

def _test_a_base_neither_source_resolves_stays_undetermined(ctx):
    """The conservative end of the fallback: no symlinks and no cmdline means
    no deletion."""
    root = _fixture(ctx)
    _eq("no workspace", testonly_workspace_of(ctx, root + "/" + _WEIRD), "")

def _test_classify_rule_order(ctx):
    """First match wins: a gone workspace decides before age, the grace hour
    holds back a just-used orphan, and age applies whether or not the
    workspace exists."""
    month = 30 * _DAY_US
    _eq("orphan past grace", testonly_classify("/ws", False, 2 * _HOUR_US, month), "orphan")
    _eq("orphan within grace", testonly_classify("/ws", False, _HOUR_US // 2, month), "grace")
    _eq("an old orphan is still an orphan", testonly_classify("/ws", False, 2 * month, month), "orphan")
    _eq("live and recent", testonly_classify("/ws", True, _DAY_US, month), "live")
    _eq("live but idle", testonly_classify("/ws", True, month, month), "idle")
    _eq("age 0 turns the age rule off", testonly_classify("/ws", True, 100 * month, 0), "live")
    _eq("undetermined and recent", testonly_classify("", False, _DAY_US, month), "unknown")
    _eq("undetermined and idle", testonly_classify("", False, month, month), "idle")

def _test_output_base_names_are_md5_shaped(ctx):
    _eq("md5", testonly_is_output_base_name("d41d8cd98f00b204e9800998ecf8427e"), True)
    _eq("install", testonly_is_output_base_name("install"), False)
    _eq("upper-case hex", testonly_is_output_base_name("D41D8CD98F00B204E9800998ECF8427E"), False)
    _eq("31 chars", testonly_is_output_base_name("d41d8cd98f00b204e9800998ecf8427"), False)
    _eq("trash", testonly_is_output_base_name(".gc-trash-d41d8cd98f00b204e9800998ecf8427e"), False)

def _test_do_not_build_here_is_read_first(ctx):
    """Bazel's own record of the workspace beats the symlinks a last build left."""
    root = _fixture(ctx)
    tmp = root[:root.rfind("/")]
    _make_base(ctx, root, _MARKER, tmp + "/live-workspace")
    ctx.std.fs.write(root + "/" + _MARKER + "/DO_NOT_BUILD_HERE", tmp + "/from-the-marker\n")
    _eq("marker wins", testonly_workspace_of(ctx, root + "/" + _MARKER), tmp + "/from-the-marker")

def _test_a_just_used_orphan_is_held_back(ctx):
    """A worktree recreated at the same path wants its base back; deleting it in
    the gap between teardown and setup throws away the reason the path was kept."""
    root = _fixture(ctx)
    ctx.std.fs.write(root + "/" + _DEAD + "/java.log", "")
    states = {b.name: b.state for b in _scan(ctx, root)}
    _eq("held back", states[_DEAD], "grace")

def _test_an_idle_base_is_removed_even_with_its_workspace(ctx):
    root = _fixture(ctx)
    states = {b.name: b.state for b in _scan(ctx, root, 30 * _DAY_US)}
    _eq("live workspace, idle base", states[_LIVE], "idle")
    _eq("undetermined, idle", states[_WEIRD], "idle")
    _eq("orphan stays an orphan", states[_DEAD], "orphan")

    ctx.std.fs.write(root + "/" + _LIVE + "/command.profile.gz", "")
    states = {b.name: b.state for b in _scan(ctx, root, 30 * _DAY_US)}
    _eq("a fresh marker keeps it", states[_LIVE], "live")

def _test_scan_lists_youngest_first(ctx):
    root = _fixture(ctx)
    ctx.std.fs.write(root + "/" + _CMDLINE + "/java.log", "")
    names = [b.name for b in _scan(ctx, root)]
    _eq("the just-used base leads", names[0], _CMDLINE)
    ages = [b.last_used for b in _scan(ctx, root)]
    _eq("descending last use", ages, sorted(ages, reverse = True))

def _test_reap_leaves_no_trash(ctx):
    root = _fixture(ctx)
    _eq("reaped", testonly_reap(ctx, root + "/" + _DEAD, 0), True)
    _eq("base gone", ctx.std.fs.exists(root + "/" + _DEAD), False)
    _eq("trash gone", ctx.std.fs.exists(root + "/.gc-trash-" + _DEAD), False)

def _test_a_base_is_moved_to_the_trash_before_deletion(ctx):
    """What makes a failed delete retryable: once renamed, whatever is left of
    the base is found by name rather than by the files a partial delete may
    have taken with it."""
    root = _fixture(ctx)
    trash = testonly_move_to_trash(ctx, root + "/" + _DEAD)
    _eq("renamed beside it", trash, root + "/.gc-trash-" + _DEAD)
    _eq("original gone", ctx.std.fs.exists(root + "/" + _DEAD), False)
    _eq("contents moved", ctx.std.fs.exists(trash + "/execroot"), True)
    _eq("trash stays put", testonly_move_to_trash(ctx, trash), trash)

def _test_trash_from_an_interrupted_run_is_finished(ctx):
    """A delete that failed part way leaves `.gc-trash-<name>`; the next run
    must recognise it, even though nothing in it names a workspace any more."""
    root = _fixture(ctx)
    trash = root + "/.gc-trash-" + _DEAD
    ctx.std.fs.rename(root + "/" + _DEAD, trash)
    found = [b for b in _scan(ctx, root) if b.name == ".gc-trash-" + _DEAD]
    _eq("picked up", len(found), 1)
    _eq("as trash", found[0].state, "trash")
    _eq("reaped where it lies", testonly_reap(ctx, trash, 0), True)
    _eq("gone", ctx.std.fs.exists(trash), False)

def _cache_entry(ctx, root, digest, size):
    entry = root + "/cache/repos/v1/content_addressable/sha256/" + digest
    ctx.std.fs.create_dir_all(entry)
    ctx.std.fs.write(entry + "/file", "x" * size)
    return entry

def _test_download_cache_prunes_by_last_use(ctx):
    root = _fixture(ctx)
    old = _cache_entry(ctx, root, "a" * 64, 4096)
    fresh = _cache_entry(ctx, root, "b" * 64, 10)
    _backdate(ctx, old)
    seen, stale = testonly_scan_download_cache(ctx, root, _now_us() - 30 * _DAY_US)
    _eq("both seen", seen, 2)
    _eq("only the old one", [e.path for e in stale], [old])
    _eq("sized from the file", stale[0].kb, 4)
    _eq("the fresh one is not touched", ctx.std.fs.exists(fresh), True)

def _test_download_cache_honours_a_recent_atime(ctx):
    """Either timestamp keeps an entry: Bazel touches the mtime on a hit, and
    where the filesystem records reads, a recent atime counts too."""
    root = _fixture(ctx)
    entry = _cache_entry(ctx, root, "c" * 64, 10)
    _backdate(ctx, entry)
    ctx.std.process.command("touch").args(["-a", entry + "/file"]).stdout("null").stderr("null").spawn().wait()
    _seen, stale = testonly_scan_download_cache(ctx, root, _now_us() - 30 * _DAY_US)
    _eq("kept", len(stale), 0)

def _test_no_download_cache_is_nothing_to_do(ctx):
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-nocas")
    _eq("empty", testonly_scan_download_cache(ctx, tmp, _now_us()), (0, []))

def _test_fmt_age(ctx):
    _eq("minutes", testonly_fmt_age(5 * 60 * 1000000), "5m")
    _eq("hours", testonly_fmt_age(3 * _HOUR_US), "3h")
    _eq("hours up to two days", testonly_fmt_age(47 * _HOUR_US), "47h")
    _eq("days", testonly_fmt_age(45 * _DAY_US), "45d")
    _eq("clock skew reads as zero", testonly_fmt_age(-5), "0m")

def _test_a_running_server_vetoes_the_age_rule(ctx):
    """An idle base whose workspace exists is kept while its server runs:
    deleting it would pull the server's state out from under it. The stand-in
    server is a process whose command line names the base, which is what
    `_is_this_bases_server` matches on."""
    root = _fixture(ctx)
    base = root + "/" + _LIVE
    server = ctx.std.process.command("sh").args(["-c", "sleep 10; :", base]) \
        .stdout("null").stderr("null").spawn()
    ctx.std.fs.create_dir_all(base + "/server")
    ctx.std.fs.write(base + "/server/server.pid.txt", str(server.id()))
    _backdate(ctx, base)
    states = {b.name: b.state for b in _scan(ctx, root, 30 * _DAY_US)}
    server.kill()
    _eq("kept while its server runs", states[_LIVE], "live")

    states = {b.name: b.state for b in _scan(ctx, root, 30 * _DAY_US)}
    _eq("idle once it has stopped", states[_LIVE], "idle")

def _test_remove_tree_clears_read_only_directories(ctx):
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-rm")
    entry = tmp + "/sha256/abc"
    ctx.std.fs.create_dir_all(entry)
    ctx.std.fs.write(entry + "/file", "payload")
    ctx.std.fs.set_permissions(entry, 0o555)
    _eq("no error", testonly_remove_tree(ctx, entry), "")
    _eq("gone", ctx.std.fs.exists(entry), False)
    _eq("already gone is success", testonly_remove_tree(ctx, entry), "")

def _test_du_keeps_sizes_when_one_path_is_missing(ctx):
    """`du` exits non-zero when any path fails, as a base removed since the scan
    does; the paths it did measure must still be reported."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-du")
    ctx.std.fs.create_dir_all(tmp + "/present")
    ctx.std.fs.write(tmp + "/present/f", "x" * 8192)
    sizes = testonly_du_kb(ctx, [tmp + "/present", tmp + "/missing"])
    _eq("measured", sizes.get(tmp + "/present", 0) >= 8, True)
    _eq("missing has no entry", tmp + "/missing" in sizes, False)

def _test_select_by_hash_or_path(ctx):
    """`--bazel-output-base` takes a hash or a path; either names a base the scan
    found, whatever its state."""
    root = _fixture(ctx)
    bases = _scan(ctx, root)
    selected, unmatched = testonly_select(bases, root, [_WEIRD, root + "/" + _LIVE + "/", _WEIRD])
    _eq("both found, once each", [b.name for b in selected], [_WEIRD, _LIVE])
    _eq("an undetermined base can be named", selected[0].state, "unknown")
    _eq("nothing unmatched", unmatched, [])

def _test_select_refuses_what_the_scan_did_not_find(ctx):
    """It deletes what it is pointed at, so a name that is not an output base
    under the root — a typo, `install`, or a path elsewhere — matches nothing."""
    root = _fixture(ctx)
    bases = _scan(ctx, root)
    elsewhere = "/somewhere/else/" + _LIVE
    _selected, unmatched = testonly_select(bases, root, ["install", elsewhere, "deadbeef"])
    _eq("all refused", unmatched, ["install", elsewhere, "deadbeef"])

_UNIT_TESTS = [
    _test_verbose_lists_what_was_left_alone,
    _test_verbose_is_additive_only,
    _test_a_workspace_rc_names_the_root_to_collect,
    _test_a_workspace_without_the_flag_defers,
    _test_the_last_rc_entry_wins,
    _test_a_relative_root_resolves_against_the_workspace,
    _test_an_absolute_root_is_left_alone,
    _test_fmt_kb,
    _test_workspace_resolves_from_the_execroot_symlink,
    _test_scan_classifies_the_three_outcomes,
    _test_shared_directories_are_never_classified,
    _test_orphan_carries_the_workspace_it_lost,
    _test_cmdline_attributes_a_base_with_an_empty_execroot,
    _test_execroot_wins_over_a_stale_cmdline,
    _test_reap_removes_a_base_bazel_left_read_only,
    _test_reap_does_not_reach_outside_the_base,
    _test_a_base_neither_source_resolves_stays_undetermined,
    _test_classify_rule_order,
    _test_output_base_names_are_md5_shaped,
    _test_do_not_build_here_is_read_first,
    _test_a_just_used_orphan_is_held_back,
    _test_an_idle_base_is_removed_even_with_its_workspace,
    _test_scan_lists_youngest_first,
    _test_reap_leaves_no_trash,
    _test_a_base_is_moved_to_the_trash_before_deletion,
    _test_trash_from_an_interrupted_run_is_finished,
    _test_download_cache_prunes_by_last_use,
    _test_download_cache_honours_a_recent_atime,
    _test_no_download_cache_is_nothing_to_do,
    _test_fmt_age,
    _test_document_counts_every_state,
    _test_document_removals_carry_state_and_size,
    _test_a_running_server_vetoes_the_age_rule,
    _test_remove_tree_clears_read_only_directories,
    _test_du_keeps_sizes_when_one_path_is_missing,
    _test_select_by_hash_or_path,
    _test_select_refuses_what_the_scan_did_not_find,
]

def _test_impl(ctx):
    for t in _UNIT_TESTS:
        t(ctx)
    print("gc.axl: OK (%d tests)" % len(_UNIT_TESTS))
    return 0

gc_tests = task(
    summary = "Run the gc output-base classifier unit tests.",
    kind = "test-gc",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
