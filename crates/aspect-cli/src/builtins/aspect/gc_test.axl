"""Unit tests for gc.axl — what gets removed, and how.

Run with:
  aspect dev test-gc

Classification is `lib/output_bases.axl`'s, covered by `aspect dev
test-output-bases`; consent is `lib/confirm.axl`'s, covered by `aspect dev
test-confirm`. This suite covers what `gc` adds: the plan and its document,
`--bazel-output-base` selection, the period flags, download-cache pruning, and
removal itself.

`_reap` is exercised against real trees rather than mocked: it has to survive
the read-only directories Bazel leaves under `bazel-out/`, and it must not
follow the execroot's symlinks out into the user's checkout.
"""

load("@aspect//gc.axl", "testonly_document", "testonly_move_to_trash", "testonly_outcome", "testonly_plan", "testonly_policy_entry", "testonly_policy_from_args", "testonly_reap", "testonly_remove_tree", "testonly_scan_download_cache", "testonly_select")
load("@aspect//private/lib/output_bases_fixtures.axl", fx = "fixtures")

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _doc(ctx, root, sizes = {}, stale = []):
    """The document for `root`'s real classification, as a dry run that would
    remove the orphans."""
    bases = fx.scan(ctx, root)
    plan = testonly_plan(
        bases = bases,
        removals = [b for b in bases if b.state == "orphan"],
        sizes = sizes,
        cache_entries = len(stale),
        stale = stale,
    )
    outcome = testonly_outcome(reaped = 0, reaped_kb = 0, pruned = 0, pruned_kb = 0)
    return testonly_document(root, True, {"base_max_age_days": 30}, plan, outcome)

def _test_document_counts_every_state(ctx):
    """`output_bases` carries a count for every state, zero included, so a
    consumer reads a key rather than probing for it."""
    root = fx.fixture(ctx)
    counts = _doc(ctx, root)["output_bases"]
    _eq("keys", sorted(counts.keys()), ["idle", "live", "orphaned", "orphaned_within_grace", "pooled", "trash", "undetermined"])
    _eq("live", counts["live"], 2)
    _eq("orphaned", counts["orphaned"], 2)
    _eq("undetermined", counts["undetermined"], 1)

def _test_document_removals_carry_state_and_size(ctx):
    root = fx.fixture(ctx)
    path = root + "/" + fx.DEAD
    doc = _doc(ctx, root, sizes = {path: 300})
    removals = {r["path"]: r for r in doc["removals"]}
    _eq("state", removals[path]["state"], "orphan")
    _eq("measured size", removals[path]["kb"], 300)
    _eq("an unmeasured base claims no size", "kb" in removals[root + "/" + fx.CMDLINE], False)
    _eq("policy passed through", doc["policy"], {"base_max_age_days": 30})
    _eq("reclaimable sums bases and cache", _doc(ctx, root, sizes = {path: 300}, stale = [struct(path = "x", kb = 4)])["reclaimable_kb"], 304)

def _test_reap_removes_a_base_bazel_left_read_only(ctx):
    """Bazel strips the owner-write bit from action output directories under
    `bazel-out/`, and unlinking a child needs write on its parent. Without the
    `chmod` this fails with EACCES on every base that completed a build — which
    is every base large enough to be worth reclaiming.
    """
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-perm")
    base = tmp + "/base"
    locked = base + "/execroot/_main/bazel-out/k8-fastbuild/bin/pkg/build_script.out_dir"
    ctx.std.fs.create_dir_all(locked)
    ctx.std.fs.write(locked + "/out.txt", "an action output\n")
    ctx.std.fs.set_permissions(locked, 0o555)

    reaped = testonly_reap(ctx, base, 0)
    _eq("reported as reaped", reaped, True)
    _eq("actually gone", ctx.std.fs.exists(base), False)

def _test_reap_does_not_reach_outside_the_base(ctx):
    """The execroot is a forest of absolute symlinks into the user's checkout,
    so the `chmod -R` that makes a base removable must not follow them. If it
    did, `aspect gc` would quietly relax permissions across real source trees —
    and the `rm` that follows must not reach them either.
    """
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-escape")
    ws = tmp + "/workspace"
    base = tmp + "/base"
    execroot = base + "/execroot/_main"
    ctx.std.fs.create_dir_all(ws)
    ctx.std.fs.create_dir_all(execroot)
    ctx.std.fs.write(ws + "/source.txt", "a file the user owns\n")
    ctx.std.fs.set_permissions(ws + "/source.txt", 0o444)
    fx.symlink(ctx, ws + "/source.txt", execroot + "/source.txt")
    fx.symlink(ctx, ws, execroot + "/wsdir")

    _eq("reaped", testonly_reap(ctx, base, 0), True)
    _eq("base is gone", ctx.std.fs.exists(base), False)
    _eq("the workspace survives", ctx.std.fs.exists(ws + "/source.txt"), True)
    _eq("and is still read-only", ctx.std.fs.metadata(ws + "/source.txt").readonly, True)

def _test_reap_leaves_no_trash(ctx):
    root = fx.fixture(ctx)
    _eq("reaped", testonly_reap(ctx, root + "/" + fx.DEAD, 0), True)
    _eq("base gone", ctx.std.fs.exists(root + "/" + fx.DEAD), False)
    _eq("trash gone", ctx.std.fs.exists(root + "/.gc-trash-" + fx.DEAD), False)

def _test_a_base_is_moved_to_the_trash_before_deletion(ctx):
    """What makes a failed delete retryable: once renamed, whatever is left of
    the base is found by name rather than by the files a partial delete may
    have taken with it."""
    root = fx.fixture(ctx)
    trash = testonly_move_to_trash(ctx, root + "/" + fx.DEAD)
    _eq("renamed beside it", trash, root + "/.gc-trash-" + fx.DEAD)
    _eq("original gone", ctx.std.fs.exists(root + "/" + fx.DEAD), False)
    _eq("contents moved", ctx.std.fs.exists(trash + "/execroot"), True)
    _eq("trash stays put", testonly_move_to_trash(ctx, trash), trash)

def _test_trash_from_an_interrupted_run_is_finished(ctx):
    """A delete that failed part way leaves `.gc-trash-<name>`; the next run
    must recognise it, even though nothing in it names a workspace any more."""
    root = fx.fixture(ctx)
    trash = root + "/.gc-trash-" + fx.DEAD
    ctx.std.fs.rename(root + "/" + fx.DEAD, trash)
    found = [b for b in fx.scan(ctx, root) if b.name == ".gc-trash-" + fx.DEAD]
    _eq("picked up", len(found), 1)
    _eq("as trash", found[0].state, "trash")
    _eq("reaped where it lies", testonly_reap(ctx, trash, 0), True)
    _eq("gone", ctx.std.fs.exists(trash), False)

def _cache_entry(ctx, root, digest, size):
    entry = root + "/cache/repos/v1/content_addressable/sha256/" + digest
    ctx.std.fs.create_dir_all(entry)
    ctx.std.fs.write(entry + "/file", "x" * size)
    return entry

def _test_download_cache_prunes_by_last_use(ctx):
    root = fx.fixture(ctx)
    old = _cache_entry(ctx, root, "a" * 64, 4096)
    fresh = _cache_entry(ctx, root, "b" * 64, 10)
    fx.backdate(ctx, old)
    seen, stale = testonly_scan_download_cache(ctx, root, fx.now_us() - 30 * fx.DAY_US)
    _eq("both seen", seen, 2)
    _eq("only the old one", [e.path for e in stale], [old])
    _eq("sized from the file", stale[0].kb, 4)
    _eq("the fresh one is not touched", ctx.std.fs.exists(fresh), True)

def _test_download_cache_honours_a_recent_atime(ctx):
    """Either timestamp keeps an entry: Bazel touches the mtime on a hit, and
    where the filesystem records reads, a recent atime counts too."""
    root = fx.fixture(ctx)
    entry = _cache_entry(ctx, root, "c" * 64, 10)
    fx.backdate(ctx, entry)
    ctx.std.process.command("touch").args(["-a", entry + "/file"]).stdout("null").stderr("null").spawn().wait()
    _seen, stale = testonly_scan_download_cache(ctx, root, fx.now_us() - 30 * fx.DAY_US)
    _eq("kept", len(stale), 0)

def _test_no_download_cache_is_nothing_to_do(ctx):
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-nocas")
    _eq("empty", testonly_scan_download_cache(ctx, tmp, fx.now_us()), (0, []))

def _test_remove_tree_clears_read_only_directories(ctx):
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-gc-rm")
    entry = tmp + "/sha256/abc"
    ctx.std.fs.create_dir_all(entry)
    ctx.std.fs.write(entry + "/file", "payload")
    ctx.std.fs.set_permissions(entry, 0o555)
    _eq("no error", testonly_remove_tree(ctx, entry), "")
    _eq("gone", ctx.std.fs.exists(entry), False)
    _eq("already gone is success", testonly_remove_tree(ctx, entry), "")

def _test_policy_from_args(ctx):
    """Each period flag lands in its policy field in microseconds, and a
    negative one is refused."""
    args = struct(base_max_age_days = 30, orphan_grace_hours = 2, download_cache_max_age_days = 0)
    p = testonly_policy_from_args(args)
    _eq("days", p.base_max_age_us, 30 * fx.DAY_US)
    _eq("hours", p.orphan_grace_us, 2 * fx.HOUR_US)
    _eq("zero", p.download_cache_max_age_us, 0)
    _eq("negative refused", testonly_policy_from_args(struct(base_max_age_days = -1, orphan_grace_hours = 1, download_cache_max_age_days = 30)), None)

def _test_policy_entry_reports_the_flags_units(ctx):
    entry = testonly_policy_entry(fx.policy(30 * fx.DAY_US, 2 * fx.HOUR_US, 7 * fx.DAY_US), ["abc"])
    _eq("entry", entry, {
        "orphan_grace_hours": 2,
        "base_max_age_days": 30,
        "download_cache_max_age_days": 7,
        "bazel_output_bases": ["abc"],
    })

def _test_select_by_hash_or_path(ctx):
    """`--bazel-output-base` takes a hash or a path; either names a base the scan
    found, whatever its state."""
    root = fx.fixture(ctx)
    bases = fx.scan(ctx, root)
    selected, unmatched = testonly_select(bases, root, [fx.WEIRD, root + "/" + fx.LIVE + "/", fx.WEIRD])
    _eq("both found, once each", [b.name for b in selected], [fx.WEIRD, fx.LIVE])
    _eq("an undetermined base can be named", selected[0].state, "unknown")
    _eq("nothing unmatched", unmatched, [])

def _test_select_refuses_what_the_scan_did_not_find(ctx):
    """It deletes what it is pointed at, so a name that is not an output base
    under the root — a typo, `install`, or a path elsewhere — matches nothing."""
    root = fx.fixture(ctx)
    bases = fx.scan(ctx, root)
    elsewhere = "/somewhere/else/" + fx.LIVE
    _selected, unmatched = testonly_select(bases, root, ["install", elsewhere, "deadbeef"])
    _eq("all refused", unmatched, ["install", elsewhere, "deadbeef"])

_UNIT_TESTS = [
    _test_document_counts_every_state,
    _test_document_removals_carry_state_and_size,
    _test_reap_removes_a_base_bazel_left_read_only,
    _test_reap_does_not_reach_outside_the_base,
    _test_reap_leaves_no_trash,
    _test_a_base_is_moved_to_the_trash_before_deletion,
    _test_trash_from_an_interrupted_run_is_finished,
    _test_download_cache_prunes_by_last_use,
    _test_download_cache_honours_a_recent_atime,
    _test_no_download_cache_is_nothing_to_do,
    _test_remove_tree_clears_read_only_directories,
    _test_policy_from_args,
    _test_policy_entry_reports_the_flags_units,
    _test_select_by_hash_or_path,
    _test_select_refuses_what_the_scan_did_not_find,
]

def _test_impl(ctx):
    for t in _UNIT_TESTS:
        t(ctx)
    print("gc.axl: OK (%d tests)" % len(_UNIT_TESTS))
    return 0

gc_tests = task(
    summary = "Run the gc unit tests.",
    kind = "test-gc",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
