"""Public facade re-exporting the tips authoring API.

The implementation lives in `lib/tips.axl` (see it for docstrings and
field semantics). This file exists so user `config.axl` files can author
and customize tips with a single import:

    load("@aspect//tips.axl",
         "add_tip",
         "tips",
         "TIP_WARNING",
         "TIP_IMPORTANT",
         "TIP_SUGGESTION",
         "TIP_NOTE",
         "TIP_TEMPLATE_RAW",
         "TIP_TEMPLATE_FORMAT",
         "TIP_TEMPLATE_JINJA2",
         "TIP_SHOW_EACH",
         "TIP_SHOW_FIRST",
         "TIP_SHOW_END",
         "TIP_MAX_SHOWN",
         "SURFACE_CLI",
         "SURFACE_DASHBOARD",
         "SURFACE_GITHUB_STATUS_CHECKS",
         "SURFACE_BUILDKITE_ANNOTATIONS",
         "SURFACE_GITHUB_PR_SUMMARY",
         "TASK_SCREENS",
         "AGGREGATE_SCREENS",
         "SURFACE_ALL",
         "TipsTrait",
         "TipInfo",
         "TipSuggestion",
         "TIP_ACCEPT",
         "TIP_REJECT",
         "tip_replace",
         "tip_rule",
         "on_console_line",
         "agg",
         "TipRule")

This is the customer-facing surface; internal modules load directly from
`lib/tips.axl`.
"""

load(
    "./private/lib/tips.axl",
    _AGGREGATE_SCREENS = "AGGREGATE_SCREENS",
    _SURFACE_ALL = "SURFACE_ALL",
    _SURFACE_BUILDKITE_ANNOTATIONS = "SURFACE_BUILDKITE_ANNOTATIONS",
    _SURFACE_CLI = "SURFACE_CLI",
    _SURFACE_DASHBOARD = "SURFACE_DASHBOARD",
    _SURFACE_GITHUB_PR_SUMMARY = "SURFACE_GITHUB_PR_SUMMARY",
    _SURFACE_GITHUB_STATUS_CHECKS = "SURFACE_GITHUB_STATUS_CHECKS",
    _TASK_SCREENS = "TASK_SCREENS",
    _TIP_ACCEPT = "TIP_ACCEPT",
    _TIP_IMPORTANT = "TIP_IMPORTANT",
    _TIP_INFO = "TIP_INFO",
    _TIP_MAX_SHOWN = "TIP_MAX_SHOWN",
    _TIP_NOTE = "TIP_NOTE",
    _TIP_REJECT = "TIP_REJECT",
    _TIP_SHOW_EACH = "TIP_SHOW_EACH",
    _TIP_SHOW_END = "TIP_SHOW_END",
    _TIP_SHOW_FIRST = "TIP_SHOW_FIRST",
    _TIP_SUGGESTION = "TIP_SUGGESTION",
    _TIP_TEMPLATE_FORMAT = "TIP_TEMPLATE_FORMAT",
    _TIP_TEMPLATE_JINJA2 = "TIP_TEMPLATE_JINJA2",
    _TIP_TEMPLATE_RAW = "TIP_TEMPLATE_RAW",
    _TIP_WARNING = "TIP_WARNING",
    _TipAction = "TipAction",
    _TipInfo = "TipInfo",
    _TipRule = "TipRule",
    _TipSuggestion = "TipSuggestion",
    _TipsTrait = "TipsTrait",
    _add_tip = "add_tip",
    _agg = "agg",
    _on_console_line = "on_console_line",
    _tip_replace = "tip_replace",
    _tip_rule = "tip_rule",
    _tips = "tips",
)

# Severities, most urgent first. `TIP_INFO` is an alias of `TIP_NOTE`.
TIP_WARNING = _TIP_WARNING
TIP_IMPORTANT = _TIP_IMPORTANT
TIP_SUGGESTION = _TIP_SUGGESTION
TIP_NOTE = _TIP_NOTE
TIP_INFO = _TIP_INFO

# Template types.
TIP_TEMPLATE_RAW = _TIP_TEMPLATE_RAW
TIP_TEMPLATE_FORMAT = _TIP_TEMPLATE_FORMAT
TIP_TEMPLATE_JINJA2 = _TIP_TEMPLATE_JINJA2

# When a tip shows on the terminal (`show`), and how many of an id's tips
# print before the rest are counted (`max_shown`).
TIP_SHOW_EACH = _TIP_SHOW_EACH
TIP_SHOW_FIRST = _TIP_SHOW_FIRST
TIP_SHOW_END = _TIP_SHOW_END
TIP_MAX_SHOWN = _TIP_MAX_SHOWN

# Surfaces + shorthands.
SURFACE_CLI = _SURFACE_CLI
SURFACE_DASHBOARD = _SURFACE_DASHBOARD
SURFACE_GITHUB_STATUS_CHECKS = _SURFACE_GITHUB_STATUS_CHECKS
SURFACE_BUILDKITE_ANNOTATIONS = _SURFACE_BUILDKITE_ANNOTATIONS
SURFACE_GITHUB_PR_SUMMARY = _SURFACE_GITHUB_PR_SUMMARY
TASK_SCREENS = _TASK_SCREENS
AGGREGATE_SCREENS = _AGGREGATE_SCREENS
SURFACE_ALL = _SURFACE_ALL

# Rules: a tip and the condition that emits it (see "Tip rules" in
# `lib/tips.axl`). Append to `ctx.traits[TipsTrait].rules`.
tip_rule = _tip_rule
on_console_line = _on_console_line
agg = _agg
TipRule = _TipRule

# Producer API.
#
# `add_tip` and the built-in `tip_*` functions are typed pass-throughs to
# the implementations in `lib/tips.axl` (loaded with a `_` prefix). The
# public signature carries the `ctx: TaskContext` annotation and the
# authoring docstring (this is the surface that rolls up into generated
# docs); the `_`-prefixed impl leaves `ctx` untyped so internal callers
# and tests can drive it with a stub context.

def add_tip(
        ctx: TaskContext,
        id: str,
        severity: str,
        title: str,
        body: str,
        type: str = TIP_TEMPLATE_RAW,
        key: str = "",
        vars: dict = {},
        accumulate: dict = {},
        surfaces: list = [],
        combine_across_tasks: bool = False,
        show: str = TIP_SHOW_EACH,
        max_shown: int = TIP_MAX_SHOWN,
        aggregates: dict = {}):
    """Add a tip to the task's tip storage and show it on the terminal as
    `show` says (subject to the owner feature's `auto_print` arg):

        TIP[<id>] 💡 suggestion: <title>
          <body, indented>

    with 🟡 warning, 📌 important or 💬 note for the other severities;
    the emoji shows under the `emoji` and `silent` presets only. Once the
    task ends, a line per id counts what was not printed, and a last tip,
    `tips-hint`, says how to silence a tip.

    The single entry point for tips.

    A tip is identified by `(id, key)`. Re-emitting the same `(id, key)`
    within a task replaces the stored content (accumulate fields ride
    along); a different `key` is a distinct tip. Silencing is always by
    `id`: no-op if `id` is in the silence list.

    No-op overall when the `Tips` feature is disabled — the trait's
    `add` callable falls back to its null-object default.

    Args:
      ctx: The task context the tip is added to.
      id: Stable identifier — the kind of tip and its silence key. Tips
        with the same `(id, key)` are the same tip (re-emit replaces);
        `id` alone is what `--tips:silence=<id>` and the silence list match.
      severity: One of `TIP_WARNING` / `TIP_IMPORTANT` / `TIP_SUGGESTION` /
        `TIP_NOTE` (`TIP_INFO`), most urgent first: drives ordering and
        the emoji and label.
      title: Short headline, interpreted per `type`.
      body: Markdown body, interpreted per `type`.
      type: The interpolation engine for `title` / `body`:
        `TIP_TEMPLATE_RAW` (default) surfaces them as-is;
        `TIP_TEMPLATE_FORMAT` applies Starlark `str.format(**vars)`;
        `TIP_TEMPLATE_JINJA2` renders them as Jinja2 against `vars` +
        `accumulate`, keeping the source so a re-emit or cross-task union
        can re-render.
      key: Optional discriminator distinguishing same-`id` tips about
        different subjects (e.g. one flaky-test tip per label). Empty
        means a single tip per `id`.
      vars: Fixed scalar values for `TIP_TEMPLATE_FORMAT` /
        `TIP_TEMPLATE_JINJA2` interpolation. Ignored for
        `TIP_TEMPLATE_RAW`. A name set in both `vars` and `accumulate`
        is an error.
      accumulate: List-valued Jinja2 fields (a `{{ name }}` reference
        sees a list). Each re-emit unions in new values (deduped, first
        seen first); with `combine_across_tasks` the union also spans tasks.
        `TIP_TEMPLATE_JINJA2` only.
      surfaces: Allowlist of surface identifiers (`SURFACE_CLI` /
        `SURFACE_DASHBOARD`, the Dashboard's screen: a tip listing
        `SURFACE_CLI` without it is the terminal's alone /
        `SURFACE_GITHUB_STATUS_CHECKS` / `SURFACE_BUILDKITE_ANNOTATIONS` /
        `SURFACE_GITHUB_PR_SUMMARY`, or the `TASK_SCREENS` /
        `AGGREGATE_SCREENS` shorthands) that may
        render the tip. Empty (the default) shows it everywhere
        (`SURFACE_ALL`). The terminal print is gated on `SURFACE_CLI`;
        omit `SURFACE_GITHUB_PR_SUMMARY` to keep the tip off the cross-task
        rollup.
      combine_across_tasks: How same-`(id, key)` tips from sibling tasks
        combine in the PR summary.
      show: When the id's tips print on the terminal, as its first tip
        says: `TIP_SHOW_EACH` (default) prints each emit whose content
        changed, up to `max_shown`; `TIP_SHOW_FIRST` prints the first;
        `TIP_SHOW_END` prints each of the id's tips at the end, in its final
        state. What an id did not print is counted in one line at the end
        of the task. Status surfaces always show the final state.
      max_shown: How many of the id's tips print before the rest are only
        counted; 0 for no limit.
      aggregates: Named values that merge on each re-emit and across tasks
        by kind, `{name: {"kind", "value", "truncated", "max"}}` with kinds
        `count`, `unique`, `all`, `count_distinct`, `count_by`, `first`,
        `last` (as a tip rule's `agg.*` makes them). `TIP_TEMPLATE_JINJA2`
        only; each is a variable of its value, and `truncated` lists those
        that stopped at their `max`.
    """
    _add_tip(
        ctx,
        id = id,
        severity = severity,
        title = title,
        body = body,
        type = type,
        key = key,
        vars = vars,
        accumulate = accumulate,
        surfaces = surfaces,
        combine_across_tasks = combine_across_tasks,
        show = show,
        max_shown = max_shown,
        aggregates = aggregates,
    )

tips = _tips

# tip_suggestion hook.
TipsTrait = _TipsTrait
TipAction = _TipAction
TipInfo = _TipInfo
TipSuggestion = _TipSuggestion
TIP_ACCEPT = _TIP_ACCEPT
TIP_REJECT = _TIP_REJECT
tip_replace = _tip_replace
