"""`aspect gc` — reclaim Bazel state that nothing else collects.

Bazel ships a garbage collector for the disk cache, the action cache, the install
base and the repo *contents* cache. It ships none for two things that grow
without bound:

  - **Output bases.** One per workspace path, kept forever. Deleting a git
    worktree strands its base, with its `external/` tree and action cache, and a
    workspace nobody builds in any more keeps its base just the same. A machine
    that creates a worktree per task — which is what coding agents do —
    accumulates one per task, permanently.
  - **The download cache** (`cache/repos/v1/content_addressable`). There is no
    `--repository_cache_gc_*` flag in any Bazel release; entries are written once
    and never collected.

This task removes the bases `lib/output_bases.axl` classifies as removable —
orphaned past `--orphan-grace-hours`, idle past `--base-max-age-days`, or trash
an earlier run left — and download-cache entries unused for
`--download-cache-max-age-days`. Each period takes 0: the grace period to remove
orphans at once, the ages to turn their rule off. Everything removed is
re-creatable: a pruned base costs a cold build, a pruned download one re-fetch.
`aspect output-bases` lists what it sees, read-only.

Nothing is deleted without saying so first: what will go is listed in full, then
confirmed on the terminal. `--force` answers for you and is **required** off a
terminal, so a `gc` wired into CI or a cron has to state that it deletes rather
than inheriting it from a default.

It never touches a base with a running server whose workspace exists, a pooled
`aspect worktree` slot, or anything under the output user root not named like an
output base, unless named with `--bazel-output-base`. That removes the named
bases outright, whatever their state, stopping a running server first, and
leaves the download cache alone. An orphan's server is stopped before its base
is removed: nothing can use it.

A base is renamed to `.gc-trash-<name>` before it is deleted. A delete that fails
part way would otherwise leave a base that has lost what attributes it to a
workspace; the trash name keeps it recognisable, and the next run finishes it.
"""

load("@std//time.axl", "time")
load("./private/lib/confirm.axl", "confirm")
load("./private/lib/environment.axl", "info", "warn")
load("./private/lib/output_bases.axl", "output_bases")
load("./private/lib/text.axl", "pluralize")

# Bumped whenever a key in the `--output=json` document is renamed, removed, or
# changes meaning. Additive keys do not bump it.
_SCHEMA_VERSION = 2

_CacheEntry = record(
    path = field(str),
    kb = field(int),
)

# What a run found, and what it would remove. `sizes` maps each removal's path
# to its `du` size in KB.
_Plan = record(
    bases = field(list),
    removals = field(list),
    sizes = field(dict),
    cache_entries = field(int),
    stale = field(list),
)

_Outcome = record(
    reaped = field(int),
    reaped_kb = field(int),
    pruned = field(int),
    pruned_kb = field(int),
)

def _capitalize(s: str) -> str:
    """First letter upper-cased, so one phrase can serve both a sentence that
    starts with it and one that embeds it."""
    return s[:1].upper() + s[1:]

def _entries(n: int) -> str:
    return pluralize(n, "Bazel download cache entry", "Bazel download cache entries")

def _removal_kb(plan) -> int:
    return output_bases.total_kb([plan.sizes.get(b.path, 0) for b in plan.removals])

def _stale_kb(plan) -> int:
    return output_bases.total_kb([e.kb for e in plan.stale])

def _document(root: str, dry_run: bool, policy: dict, plan, outcome) -> dict:
    """The `--output=json` document.

    `reclaimable_kb` is what the removals and stale download-cache entries hold,
    and `freed_kb` what was actually removed; under `--dry-run`, or when a
    removal failed, they differ. The key names are a contract, so
    `_SCHEMA_VERSION` moves when they do.
    """
    stale_kb = _stale_kb(plan)
    return {
        "schema_version": _SCHEMA_VERSION,
        "output_user_root": root,
        "dry_run": dry_run,
        "policy": policy,
        "output_bases": output_bases.counts(plan.bases),
        "removals": [output_bases.base_entry(b, plan.sizes) for b in plan.removals],
        "download_cache": {
            "entries": plan.cache_entries,
            "stale_entries": len(plan.stale),
            "stale_kb": stale_kb,
            "pruned": outcome.pruned,
            "freed_kb": outcome.pruned_kb,
        },
        "reclaimable_kb": _removal_kb(plan) + stale_kb,
        "reaped": outcome.reaped,
        "freed_kb": outcome.reaped_kb + outcome.pruned_kb,
    }

def _policy_entry(policy, requested: list[str]) -> dict:
    """The policy for the document, in the units its flags take."""
    entry = {p.arg: getattr(policy, p.field) // p.unit_us for p in output_bases.PERIODS.values()}
    entry["bazel_output_bases"] = requested
    return entry

def _policy_from_args(args):
    """The `Policy` the period flags ask for, or None when one is negative."""
    us = {}
    for p in output_bases.PERIODS.values():
        value = getattr(args, p.arg)
        if value < 0:
            return None
        us[p.field] = value * p.unit_us
    return output_bases.Policy(**us)

def _why(b, now_us: int) -> str:
    """The reason a base is being removed, for the listing."""
    s = output_bases.STATES[b.state]
    workspace = "; workspace " + b.workspace if b.workspace else ""
    if not s.removable:
        return "requested; " + s.label + workspace
    if b.state == output_bases.TRASH:
        return "left by an interrupted gc"
    if b.state == output_bases.ORPHAN:
        return "workspace gone: " + b.workspace
    return "unused for " + output_bases.fmt_age(now_us - b.last_used) + workspace

def _print_plan(streaming: bool, plan, policy, now_us: int) -> None:
    """Everything a run will remove, listed before it asks, so the confirmation
    is answered with the whole picture rather than a count."""
    say = output_bases.say
    fmt_kb = output_bases.fmt_kb
    if plan.removals:
        say(streaming, "  %s to remove, %s:" % (pluralize(len(plan.removals), output_bases.BASE), fmt_kb(_removal_kb(plan))))
    for b in plan.removals:
        say(streaming, "    " + fmt_kb(plan.sizes.get(b.path, 0)) + "  " + b.name + "  (" + _why(b, now_us) + ")")
    if plan.stale:
        say(streaming, "  Bazel download cache: %d of %s unused for %s or more, %s" % (
            len(plan.stale),
            pluralize(plan.cache_entries, "entry", "entries"),
            output_bases.fmt_age(policy.download_cache_max_age_us),
            fmt_kb(_stale_kb(plan)),
        ))

def _scan_download_cache(ctx: TaskContext, root: str, cutoff_us: int) -> tuple:
    """`(entries_seen, stale_entries)` for the download cache under `root`.

    An entry is `<algo>/<hash>/`, holding the `file` and any `id-*` canonical-id
    markers beside it, and is removed as a unit. Its last use is the newer of
    the file's mtime and atime: Bazel touches the mtime on every cache hit, and
    atime alone is unreliable — APFS does not update it on read, and Linux
    `relatime` lags it by up to a day.
    """
    cas = root + "/" + output_bases.DOWNLOAD_CACHE
    if not ctx.std.fs.exists(cas):
        return (0, [])
    seen = 0
    stale = []
    for algo in ctx.std.fs.read_dir(cas):
        if not algo.is_dir:
            continue
        algo_dir = cas + "/" + algo.path
        for entry in ctx.std.fs.read_dir(algo_dir):
            if not entry.is_dir:
                continue
            seen += 1
            path = algo_dir + "/" + entry.path
            err, meta = catch(ctx.std.fs.metadata, path + "/file")
            if err != None:
                used, kb = output_bases.mtime_us(ctx, path), 0
            else:
                used, kb = max(meta.modified or 0, meta.accessed or 0), (meta.size + 1023) // 1024
            if used < cutoff_us:
                stale.append(_CacheEntry(path = path, kb = kb))
    return (seen, stale)

def _remove_tree(ctx: TaskContext, path: str) -> str:
    """Delete `path` and everything under it; "" on success, else the error.

    A first attempt that fails is retried once the tree is writable. Bazel
    strips the owner-write bit from the action output directories under
    `bazel-out/`, and unlinking a child needs write on its parent — the same
    reason `bazel clean` runs a `chmod`. Trying first skips that `chmod` for the
    trees that never needed it, such as each of thousands of download-cache
    entries. A path already gone counts as removed.
    """
    err, _ = catch(ctx.std.fs.remove_dir_all, path)
    if err == None or not ctx.std.fs.exists(path):
        return ""
    _make_writable(ctx, path)
    err, _ = catch(ctx.std.fs.remove_dir_all, path)
    if err == None or not ctx.std.fs.exists(path):
        return ""
    return str(err)

def _make_writable(ctx: TaskContext, path: str) -> None:
    """Restore the owner-write bit across `path`, so the tree can be unlinked.

    One `chmod -R` rather than an AXL walk: a single output base holds hundreds
    of read-only directories and tens of thousands of files, and spawning once
    beats a per-entry round trip. Failure is not reported here — the removal
    that follows reports it, with the error the caller actually cares about.
    """
    ctx.std.process.command("chmod").args(["-R", "u+w", path]) \
        .stdout("null").stderr("null").spawn().wait()

def _move_to_trash(ctx: TaskContext, path: str) -> str:
    """Rename `path` to `.gc-trash-<name>` beside it and return the new path,
    or "" when the rename failed. A path already in the trash is returned as
    is."""
    idx = path.rfind("/")
    name = path[idx + 1:]
    if name.startswith(output_bases.TRASH_PREFIX):
        return path
    trash = path[:idx + 1] + output_bases.TRASH_PREFIX + name
    err, _ = catch(ctx.std.fs.rename, path, trash)
    if err != None:
        warn(ctx.std, "could not move " + path + " aside to delete it: " + str(err))
        return ""
    return trash

def _reap(ctx: TaskContext, path: str, pid: int) -> bool:
    """Stop the base's server if it is really its server, then delete the base
    by way of the trash.

    The server is signalled rather than asked to shut down over its RPC port:
    `bazel shutdown` against a dead workspace would start a server to shut it
    down, and everything the running one holds lives in the directory about to
    be removed.
    """
    if output_bases.is_this_bases_server(ctx, pid, path):
        ctx.std.process.command("kill").args([str(pid)]) \
            .stdout("null").stderr("null").spawn().wait()
    trash = _move_to_trash(ctx, path)
    if not trash:
        return False
    err = _remove_tree(ctx, trash)
    if err:
        warn(ctx.std, "could not remove " + trash + ": " + err + " (the next `aspect gc` retries it)")
        return False
    return True

def _select(bases: list, root: str, requested: list[str]) -> tuple:
    """`(selected, unmatched)` for the bases `--bazel-output-base` names.

    Each name is a base's directory name (its md5) or its path. A path must sit
    directly under `root`: this deletes what it is pointed at, so it only ever
    points at something the scan found there.
    """
    by_name = {b.name: b for b in bases}
    selected = []
    unmatched = []
    for req in requested:
        name = req.rstrip("/")
        idx = name.rfind("/")
        if idx >= 0:
            name = name[idx + 1:] if name[:idx] == root else ""
        b = by_name.get(name)
        if b == None:
            unmatched.append(req)
        elif b not in selected:
            selected.append(b)
    return (selected, unmatched)

def _collect(ctx: TaskContext, streaming: bool, plan):
    """Remove everything in `plan`, narrating each base before its removal: a
    gigabyte tree takes seconds to unlink, and the line says where that time
    goes."""
    reaped, reaped_kb = 0, 0
    for i, b in enumerate(plan.removals):
        kb = plan.sizes.get(b.path, 0)
        output_bases.say(streaming, "  [%d/%d] removing %s  %s" % (i + 1, len(plan.removals), output_bases.fmt_kb(kb), b.name))
        if _reap(ctx, b.path, b.pid):
            reaped += 1
            reaped_kb += kb
    if plan.stale:
        output_bases.say(streaming, "  pruning %s…" % _entries(len(plan.stale)))
    pruned, pruned_kb = 0, 0
    for e in plan.stale:
        if not _remove_tree(ctx, e.path):
            pruned += 1
            pruned_kb += e.kb
    return _Outcome(reaped = reaped, reaped_kb = reaped_kb, pruned = pruned, pruned_kb = pruned_kb)

def _failure(plan, outcome):
    """The conclusion for a run that could not remove everything, or None."""
    failed = []
    if outcome.reaped < len(plan.removals):
        failed.append(pluralize(len(plan.removals) - outcome.reaped, output_bases.BASE))
    if outcome.pruned < len(plan.stale):
        failed.append(_entries(len(plan.stale) - outcome.pruned))
    if not failed:
        return None
    return TaskConclusion(exit_code = 1, message = " and ".join(failed) + " could not be removed")

def _impl(ctx: TaskContext) -> int | TaskConclusion:
    """Scan, list, confirm, collect, report.

    It narrates as it goes rather than reporting at the end: classifying walks
    every base, sizing shells out to `du`, and deleting a multi-gigabyte tree
    takes seconds apiece, so a reader needs to see which of those it is waiting
    on.
    """
    say = output_bases.say
    fmt_kb = output_bases.fmt_kb
    policy = _policy_from_args(ctx.args)
    if policy == None:
        return TaskConclusion(
            exit_code = 1,
            message = ", ".join(["--" + p.arg.replace("_", "-") for p in output_bases.PERIODS.values()]) + " take 0 or more",
        )

    root = output_bases.output_user_root(ctx, ctx.args.output_user_root)
    if not ctx.std.fs.exists(root):
        return TaskConclusion(
            exit_code = 1,
            message = "no Bazel output user root at " + root +
                      " — pass --output-user-root to point at one",
        )

    streaming = ctx.args.output != "json"
    info(ctx.std, "Bazel output user root: " + root)
    now_us = time.now_ms() * 1000

    say(streaming, "  scanning %ss…" % output_bases.BASE)
    bases = output_bases.scan(ctx, root, now_us, policy)

    requested = ctx.args.bazel_output_bases
    if requested:
        removals, unmatched = _select(bases, root, requested)
        if unmatched:
            return TaskConclusion(
                exit_code = 1,
                message = "no " + output_bases.BASE + " " + ", ".join(unmatched) + " under " + root + "; nothing was deleted.",
            )
    else:
        output_bases.print_census(streaming, bases, {}, policy, hint = True)
        removals = [b for b in bases if output_bases.STATES[b.state].removable]

    sizes = output_bases.measure(ctx, streaming, pluralize(len(removals), output_bases.BASE), [(b.name, b.path) for b in removals])
    cache_entries, stale = 0, []
    if policy.download_cache_max_age_us and not requested:
        say(streaming, "  scanning the Bazel download cache…")
        cache_entries, stale = _scan_download_cache(ctx, root, now_us - policy.download_cache_max_age_us)
    plan = _Plan(bases = bases, removals = removals, sizes = sizes, cache_entries = cache_entries, stale = stale)
    _print_plan(streaming, plan, policy, now_us)
    reclaimable = _removal_kb(plan) + _stale_kb(plan)

    actions = []
    if removals:
        actions.append("delete " + pluralize(len(removals), output_bases.BASE))
    if stale:
        actions.append("prune " + _entries(len(stale)))
    action = " and ".join(actions)
    verdict = confirm.decide(
        has_work = len(actions) > 0,
        dry_run = ctx.args.dry_run,
        force = ctx.args.force,
        is_tty = ctx.std.io.stdin.is_tty,
    )
    if verdict == confirm.NEEDS_FORCE:
        return TaskConclusion(exit_code = 1, message = confirm.needs_force_message(action))
    if verdict == confirm.ASK and not confirm.ask(ctx, _capitalize(action) + ", freeing " + fmt_kb(reclaimable) + "?"):
        return TaskConclusion(exit_code = 0, message = "left alone; nothing was deleted.")

    if verdict == confirm.SKIP:
        outcome = _Outcome(reaped = 0, reaped_kb = 0, pruned = 0, pruned_kb = 0)
        failure = None
    else:
        outcome = _collect(ctx, streaming, plan)
        failure = _failure(plan, outcome)
    freed = outcome.reaped_kb + outcome.pruned_kb

    if ctx.args.output == "json":
        ctx.std.io.stdout.write(json.encode(
            _document(root, ctx.args.dry_run, _policy_entry(policy, requested), plan, outcome),
            indent = 2,
        ) + "\n")
        return failure or 0

    if not actions:
        print("  nothing to reclaim")
    elif ctx.args.dry_run:
        print("  would reclaim " + fmt_kb(reclaimable))
    elif failure == None:
        print("  reclaimed " + fmt_kb(freed))
    else:
        print("  reclaimed %s; %s could not be removed" % (fmt_kb(freed), fmt_kb(reclaimable - freed)))
    return failure or 0

def _period_arg(placeholder: str, description: str):
    return args.int(default = output_bases.PERIODS[placeholder].default, description = description)

gc = task(
    summary = "Reclaim Bazel output bases and download-cache entries nothing is using.",
    description = """Delete Bazel output bases whose workspace is gone or that have gone unused, and prune the download cache.

Deleting a git worktree leaves its Bazel output base behind forever — nothing in Bazel collects it — and so does a workspace nobody builds in any more. Nothing collects the download cache (`cache/repos/v1/content_addressable`) either.

An output base is removed when its workspace is gone (once it has not been used in `--orphan-grace-hours`), or when it has not been used in `--base-max-age-days`. A download-cache entry is removed when it has not been used in `--download-cache-max-age-days`. Everything removed is re-creatable: a cold build, or one re-fetch.

`--bazel-output-base` removes the named bases instead, whatever their state.

Otherwise never touches a running Bazel server whose workspace still exists, a pooled `aspect worktree` slot, or anything beside the output bases that is not named like one (`install/`, `cache/`). `aspect output-bases` lists every base and its state, read-only.""",
    implementation = _impl,
    args = {
        "output_user_root": args.string(
            default = "",
            description = "The Bazel output user root to collect. Defaults to the `--output_user_root` the surrounding workspace's bazelrc sets, falling back to the platform default (`~/Library/Caches/bazel/_bazel_$USER` on macOS, `~/.cache/bazel/_bazel_$USER` elsewhere). Pass this to collect a root other than the one this workspace uses.",
        ),
        "base_max_age_days": _period_arg(
            "{max_age}",
            "Remove an output base no Bazel command has used in this many days, even if its workspace still exists. A base with a running server is kept. 0 turns this off, leaving only bases whose workspace is gone.",
        ),
        "orphan_grace_hours": _period_arg(
            "{grace}",
            "Keep an orphaned output base — one whose workspace no longer exists, such as a deleted worktree — until nothing has used it for this many hours, so a worktree being recreated at the same path keeps its base. 0 removes orphans immediately.",
        ),
        "download_cache_max_age_days": _period_arg(
            "{cache_age}",
            "Remove a download-cache entry no fetch has used in this many days. 0 turns this off.",
        ),
        "bazel_output_bases": args.string_list(
            long = "bazel-output-base",
            default = [],
            description = "Remove this output base, by hash or by path under the output user root, instead of applying the age and missing-workspace rules. Repeatable. The base is removed whatever its state — a running server in it is stopped first — and the download cache is not pruned. Still listed and confirmed like any other removal.",
        ),
        "dry_run": args.boolean(
            default = False,
            description = "Report what would be reclaimed without deleting anything, and without prompting.",
        ),
        "force": args.boolean(
            default = False,
            description = "Delete without asking. Required when stdin is not a terminal, since there is nobody to confirm with — a `gc` running from CI or cron has to say that it deletes.",
        ),
        "output": args.string(
            default = "text",
            values = ["text", "json"],
            description = "stdout format. `text` (default): a human-readable report on stderr, stdout empty. `json`: one document on stdout with the policy, the classification, and what was removed and its sizes.",
        ),
    },
)

# Exposed for gc_test.axl; not part of the task's surface.
testonly_document = _document
testonly_move_to_trash = _move_to_trash
testonly_outcome = _Outcome
testonly_plan = _Plan
testonly_policy_entry = _policy_entry
testonly_policy_from_args = _policy_from_args
testonly_reap = _reap
testonly_remove_tree = _remove_tree
testonly_scan_download_cache = _scan_download_cache
testonly_select = _select
