def _mcp_impl(ctx: TaskContext) -> int:
    # stdout belongs to the MCP protocol from here on: the server owns it, and
    # anything else printed there corrupts the JSON-RPC stream. Diagnostics
    # (including the serve banner) go to stderr inside serve().
    return ctx.aspect.mcp.serve(deployment = ctx.args.deployment)

mcp = task(
    summary = "Serve the CLI's capabilities to AI agents over MCP",
    description = """Run a Model Context Protocol server over stdio. Not interactive: an AI tool launches it and speaks MCP on stdin/stdout.

Register it in the AI tool's MCP config, e.g. `.mcp.json`:
  {"mcpServers": {"aspect": {"command": "aspect", "args": ["mcp"]}}}

That is the whole setup. The server always carries usage guidance pointing the agent at `aspect describe`, which is where the repository's own task surface is enumerated — no deployment, login or network required.

When a Workflows deployment is configured, the server additionally exposes read-only tools over its build-results REST API: invocations, logs, targets, and cross-invocation target statistics. Those need:
  1. `aspect auth configure remote.<deployment-domain>`   (records the deployment; often already done for the remote cache)
  2. `aspect auth login --deployment <name>`              (browser login against the deployment's IdP; `configure` prints the name)

The tools target the default configured deployment; add `--deployment <name>` to the args to pin one. For several deployments, register one entry per deployment (e.g. `aspect-staging`, `aspect-prod`) with distinct `--deployment` args. They require the deployment to run Aspect Workflows 6.0.30+ with `webapp.web.api_enabled = true`; each call authenticates with the stored credential and refreshes it automatically. Without a usable deployment the server still starts and serves guidance, advertising no tools rather than tools that cannot answer.""",
    implementation = _mcp_impl,
    args = {
        "deployment": args.string(
            description = "The configured Workflows deployment to serve build results from (see `aspect auth status`). Defaults to the default deployment. The server starts either way; without one it serves usage guidance only.",
        ),
    },
)
