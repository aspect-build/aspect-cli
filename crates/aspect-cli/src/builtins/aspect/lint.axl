"""Define the 'lint' task

Builds with linting aspects enabled (remotely cacheable), then presents the
data locally on the terminal or in code review via Aspect's Marvin bot.

Install:
    Add rules_lint to MODULE.aspect.
    See examples in https://github.com/bazel-starters

Usage:
    # Lint all targets in the repository
    aspect lint
    # Lint specific targets
    aspect lint -- //path/to:targets -//not:this_one
    # Lint the patterns listed in a file (one per line)
    aspect lint --target-pattern-file=targets.txt
    # Gate ruff on every finding while other linters hold the line
    aspect lint --linter-strategy=ruff=hard
    # Post every finding as a PR review comment instead of annotating
    aspect lint --findings-destination=comments
    # Fix lint violations, where the underlying linter provides fixes
    aspect lint --fix
    # Fix with rules_lint under its new module name (default: @aspect_rules_lint//lint:fix)
    aspect lint --fix --rules-lint-fix-flag=@rules_lint//lint:fix
"""

load("@aspect//bazel/build_events.axl", "announce_bes_sinks", "bes_args", "bes_link_data", "collect_bes_sinks", "summarize_bes_upload")
load("@aspect//bazel/invocation.axl", "resolve_targets")
load("@aspect//bazel.axl", "BazelTrait", "bazel_announce", "bazel_exec_log", "bazel_flags", "bazel_invocation", "bazel_rc", "dispatch_bazel_attempt_end", "dispatch_bazel_build_end", "exit_code_of")
load("@std//time.axl", "sleep", "sleep_iter")
load("./private/lib/ansi.axl", "ansi")
load("./private/lib/artifacts.axl", "artifacts")
load("./private/lib/bazel_results.axl", "BES_DRAIN_TICK_MS", "MIN_HEARTBEAT_INTERVAL_MS", "bb_clientd_root", "bes_get", "local_output_path", "now_ms", "process_event", "usable_bb_clientd_root")
load("./private/lib/change_detection.axl", "BASE_REF_DESCRIPTION_TAIL")
load("./private/lib/environment.axl", "detect_ci", "error", "warn")
load("./private/lib/github.axl", "detect_changed_files", "detect_ci_base_ref", "print_changed_files_listing")
load("./private/lib/lifecycle.axl", "phases")
load("./private/lib/lint_results.axl", "detect_lint_tool", lint_accumulate = "accumulate", lint_conclusion = "conclusion", lint_init_data = "init_data", lint_strategy_label = "strategy_label")
load("./private/lib/repro_commands.axl", "build_aspect_command", "explicit_flags", "flavor_allows", "print_repro_and_fix", "repro_flavor_args", "repro_prefix", "task_cli_path")
load("./private/lib/sarif.axl", "format_location", "get_sarif_summary", "parse_sarif", "sarif_diagnostics", "scope_files")
load("./private/lib/tar.axl", "tar_create")
load("./private/lib/text.axl", "did_you_mean_then", "pluralize")

# Poll budget for pending lint files after build.wait(): remote downloads are
# async and the BES event can arrive before the file lands. 30s is generous.
_POST_BUILD_DOWNLOAD_TIMEOUT_MS = 30000

# Bound for a single lint-file read probe (see _read_lint_file).
_LINT_FILE_PROBE_TIMEOUT_MS = 250

# Blocking budget for one drain/event pass. Each pass may spend at most this
# long waiting on freshly spawned read probes in total; past the budget,
# probes are polled nonblocking (timeout 0) and their results harvested on a
# later pass. Bounds a batch of many distinct stuck files — hundreds of
# unfetchable blobs would otherwise stall one pass for minutes at one probe
# timeout each — so the loop keeps ticking, heartbeating, and checking its
# own deadlines.
_PASS_READ_BUDGET_MS = 1000

# Age at which a still-unreadable lint file gets a one-time warning naming it.
# Surfaces a stuck remote-cache/FUSE read while the task is still running —
# without it, a wedged storage layer is silent until the post-build skip.
_PENDING_READ_WARN_MS = 30000

# Filter functions — (all_diagnostics, changed_files) -> relevant_diagnostics
def filter_all(diagnostics, changed_files):
    return diagnostics

def filter_hunks(diagnostics, changed_files):
    """Keep diagnostics whose line is in a changed file's displayed-hunk window.

    The window is `hunk_lines` (added + ±3 context, matching GitHub's Files
    Changed view) populated by `detect_changed_files`; falls back to `lines`
    (added-only) on older fixtures. SARIF lines are 1-based, `hunk_lines`
    0-based, so compare `(diag.line - 1)`. Line-level (unlike `filter_changeset`)
    so the strategy filter matches what PR comments / annotations can surface.

    A diagnostic without a line is kept when any of its `scope_files` changed.
    """
    if not changed_files:
        return []  # no change context → treat as no relevant diagnostics
    by_file = {}
    for cf in changed_files:
        path = cf.get("file", "")
        if not path:
            continue
        region = cf.get("hunk_lines") or cf.get("lines", []) or []
        by_file[path] = {ln: True for ln in region}
    result = []
    for d in diagnostics:
        path = d.get("file", "")
        line = d.get("line", 0) or 0
        if not line:
            if any([f in by_file for f in scope_files(d)]):
                result.append(d)
            continue
        if not path:
            continue
        region = by_file.get(path)
        if region == None:
            continue
        if (line - 1) not in region:
            continue
        result.append(d)
    return result

def parse_patch_hunks(content):
    """Extract the (file, line) span of every hunk in a unified diff.

    Returns `{file, start_line, end_line}` per hunk; `file` is the post-fix
    `+++ b/<path>` side (leading `b/` stripped), lines 1-based inclusive.
    Empty list when unparseable — callers treat that as "leave the patch alone".

    A hunk's declared line count is clamped to the number of lines in the
    patch, since no hunk can cover more than that. The count comes from the
    `@@` header, and a malformed or truncated patch can declare a span far
    larger than its body; callers expand each hunk to one entry per line, so
    an unclamped count allocates proportional to the declared number.
    """
    hunks = []
    current_file = ""
    lines = content.split("\n")
    max_count = len(lines)
    for line in lines:
        if line.startswith("+++ "):
            rest = line[4:]
            if rest.startswith("b/"):
                rest = rest[2:]
            tab_idx = rest.find("\t")
            current_file = (rest[:tab_idx] if tab_idx >= 0 else rest).strip()
            continue
        if not current_file or not line.startswith("@@"):
            continue

        # Hunk header `@@ -X,Y +A,B @@`: the `+A,B` side is the post-fix range
        # (1-based, B lines). `,B` omitted when B == 1.
        parts = line.split(" ")
        if len(parts) < 3 or not parts[2].startswith("+"):
            continue
        add_spec = parts[2][1:]
        if "," in add_spec:
            a_str, b_str = add_spec.split(",", 1)
        else:
            a_str, b_str = add_spec, "1"
        if not (a_str.isdigit() and b_str.isdigit()):
            continue
        start = int(a_str)
        count = min(int(b_str), max_count)
        if count <= 0:
            continue
        hunks.append({
            "file": current_file,
            "start_line": start,
            "end_line": start + count - 1,
        })
    return hunks

def _filter_patches_by_strategy(ctx, patches, strategy_for, changed_files):
    """Return the paths of `patches` whose hunks land in their linter's scope.

    `patches` holds `{"path", "name"}` entries; the linter comes from the
    rules_lint mnemonic in `name`. Synthesizes a diagnostic at every line of
    each hunk's post-fix range and keeps the patch iff any survives that
    linter's strategy filter. Unparseable patches default-keep (no hunks, so
    nothing to filter); unreadable patches (transient FUSE read failure) drop
    with a warning, since downstream tar/apply would fail on them anyway.
    soft/hard keep all; hold-the-file keeps patches touching a changed file;
    hold-the-line requires hunk overlap.
    """
    if not patches:
        return []
    kept = []
    for patch in patches:
        patch_path = patch["path"]
        content = _read_lint_file(ctx, patch_path)
        if content == None:
            warn(ctx.std, "Failed to read lint patch (skipping): %s" % patch_path)
            continue
        hunks = parse_patch_hunks(content)
        if not hunks:
            kept.append(patch_path)
            continue
        synthetic = []
        for h in hunks:
            for ln in range(h["start_line"], h["end_line"] + 1):
                synthetic.append({"file": h["file"], "line": ln})
        if strategy_for(detect_lint_tool(patch["name"])).filter(synthetic, changed_files):
            kept.append(patch_path)
    return kept

def _filter_suggestions_by_strategy(suggestions, strategy_for, changed_files):
    """Drop suggestions whose anchor `(file, end_line || start_line)` is out of
    their linter's scope, so gating matches diagnostics. Like diagnostics and
    patches, the strategy is looked up by the `linter` name alone; "" takes the
    run strategy.
    """
    by_linter = {}
    for i, s in enumerate(suggestions or []):
        anchor = {
            "file": s.get("file", "") or "",
            "line": s.get("end_line", 0) or s.get("start_line", 0) or 0,
            "_index": i,
        }
        by_linter.setdefault(s.get("linter", ""), []).append(anchor)
    kept_indexes = {}
    for linter, anchors in by_linter.items():
        for a in strategy_for(linter).filter(anchors, changed_files):
            kept_indexes[a["_index"]] = True
    return [s for i, s in enumerate(suggestions or []) if i in kept_indexes]

def report_diagnostics(sarif, linter, strategy_for, changed_files):
    """Diagnostics of one SARIF report, tagged with the rules_lint `linter` that
    wrote it and kept by that linter's strategy."""
    diagnostics = [d | {"linter": linter} for d in sarif_diagnostics(sarif)]
    return strategy_for(linter).filter(diagnostics, changed_files)

def filter_changeset(diagnostics, changed_files):
    """Keep ALL diagnostics from any changed file (file-level), plus line-less
    diagnostics whose related file changed (see `scope_files`).

    Looser than `filter_hunks`: findings on unchanged lines of a changed file
    are kept. Such findings can't post as PR comments (GitHub 422s lines outside
    the displayed hunk) or annotate, so rendered details list them but per-line
    surfaces won't — the accepted trade-off. Returns [] with no change context.
    """
    if not changed_files:
        return []  # no change context → treat as no relevant diagnostics
    changed_paths = {cf["file"]: True for cf in changed_files}
    return [d for d in diagnostics if any([f in changed_paths for f in scope_files(d)])]

Strategy = record(
    filter = field(typing.Callable[[list, list], list]),
    # (all_diagnostics, changed_files) -> relevant_diagnostics
    fail_on_severity = field(str | None, "error"),
    # None = never fail on severity; "error" = fail if any diagnostic has severity "error"
    fail_on_linter_error = field(bool, False),
    # True = also fail if any linter exited non-zero
)

# Built-in strategies
StrategySoft = Strategy(
    filter = filter_all,
    fail_on_severity = None,  # never fails
    fail_on_linter_error = False,
)

StrategyHard = Strategy(
    filter = filter_all,
    fail_on_severity = "error",
    fail_on_linter_error = True,  # also fail if linter exits non-zero
)

# hold-the-line (default): line-level — findings must fall in a displayed hunk
# on a changed file. Right default for PR review: every surface (details,
# annotations, comments) shows the same set.
StrategyHoldTheLine = Strategy(
    filter = filter_hunks,
    fail_on_severity = "error",
    fail_on_linter_error = False,
)

# hold-the-file: file-level — every finding on any touched file counts. Broader
# coverage at the cost of surface symmetry (out-of-hunk findings list in details
# only, can't annotate/comment).
StrategyHoldTheFile = Strategy(
    filter = filter_changeset,
    fail_on_severity = "error",
    fail_on_linter_error = False,
)

_STRATEGIES = {
    "soft": StrategySoft,
    "hard": StrategyHard,
    "hold-the-line": StrategyHoldTheLine,
    "hold-the-file": StrategyHoldTheFile,
}

# Passed to each `lint_start` hook: the change set findings are scoped to.
LintStartInfo = record(
    # [{"file": str, "lines": [int 0-based added line indices]}].
    changed_files = field(list),
    # False when change detection could not determine the set (e.g. a shallow
    # checkout), which also forces `strategy=hard`. An empty `changed_files`
    # then means "no change context", not "nothing changed": surfaces gating
    # per line must not treat the two alike.
    scoped = field(bool),
)

# Optionally returned by a `lint_end` hook; the task merges every hook's
# result into `data["lint"]` for the rendered detail body.
LintEndResult = record(
    # Suggested-fix comment records; the task filters them by strategy. Each:
    #   {tool (SARIF driver name when correlated, else the linter name),
    #    linter (rules_lint linter name, the --linter-strategy key),
    #    file, start_line, end_line (1-based new-side incl),
    #    severity ("error"|"warning"|"info"|"" uncorrelated),
    #    rule_id (SARIF ruleId or ""), correlated (bool: same linter's SARIF
    #    diag on the same (file, line)),
    #    comment_url (Files Changed link; "" when post failed or deduped)}
    suggestions = field(list, default = []),
    # `(file, line) -> comment_url` for posted SARIF-derived comments, so the
    # renderer links a finding row to its comment. Patch comments live on
    # `suggestions`.
    comment_urls = field(dict, default = {}),
)

# Fired by the `lint` task.
LintTrait = trait(
    # Lifecycle hooks. Each is a list of callables; features append to compose.

    # Once before the build, after change detection. (ctx, LintStartInfo) -> None
    lint_start = attr(list[typing.Callable[[TaskContext, LintStartInfo], None]], default = []),

    # Per SARIF file as it streams in. (ctx, sarif_filepath) -> None
    lint_report = attr(list[typing.Callable[[TaskContext, str], None]], default = []),

    # Per `.patch` file (rules_lint `--format=diff`; parse via lib/patch.axl::parse).
    # (ctx, patch_filepath, patch_name) -> None. patch_name retains the
    # `.AspectRulesLint<Tool>` mnemonic; the resolved filepath is content-hashed
    # on CI so use patch_name when the tool name matters.
    lint_patch = attr(list[typing.Callable[[TaskContext, str, str], None]], default = []),

    # Once after all SARIF collected, with strategy-filtered diagnostics.
    # (ctx, relevant_diagnostics) -> LintEndResult | None
    lint_end = attr(list[typing.Callable[[TaskContext, list], LintEndResult | None]], default = []),
)

def merge_lint_end_results(results: list) -> LintEndResult:
    """Merge what the `lint_end` hooks returned, in hook order.

    `None` contributes nothing. Suggestions concatenate; for a `(file, line)`
    two hooks both link, the later hook's URL wins. Any other return value
    fails the task naming it, rather than dropping that hook's suggestions
    without a trace.
    """
    suggestions = []
    comment_urls = {}
    for r in results:
        if r == None:
            continue
        if not isinstance(r, LintEndResult):
            fail("a LintTrait.lint_end hook returned %s (%r); return a LintEndResult or None" % (type(r), r))
        suggestions.extend(r.suggestions)
        comment_urls.update(r.comment_urls)
    return LintEndResult(suggestions = suggestions, comment_urls = comment_urls)

_FINDINGS_DESTINATIONS = ["auto", "both", "comments", "annotations"]

def findings_destination(ctx):
    """The lint task's `--findings-destination`: where findings surface.

    Read from the lint task's `TaskContext` by GithubLintComments /
    GitlabLintComments (SARIF + patch-derived comments, in their lint hooks)
    and GithubStatusChecks (annotations, in its `task_update` handler), so all
    three agree on one value ("auto" for a task without the arg; a custom task
    firing LintTrait hooks declares the arg to choose another):
      "auto"        - (default) annotate every SARIF finding except those whose
                      anchor matches a posted patch auto-fix comment (de-dup);
                      fix-bearing SARIF findings become comments; patches post.
      "both"        - annotate everything (no de-dup), fix-bearing also comment.
      "comments"    - every finding becomes a comment, no annotations.
      "annotations" - every finding becomes an annotation, no PR comments.

    `has_fix` (lib/sarif.axl::_result_has_fix) is False for every rules_lint
    Go-errorformat linter today, so SARIF-derived comments are empty in
    auto/both and only patch comments post; auto still differs from both via
    patch-correlated annotation suppression
    (https://github.com/aspect-build/rules_lint/issues/749). Comment markers
    and cleanup are described in feature/github_lint_comments.axl.
    """
    return getattr(ctx.args, "findings_destination", "auto")

def parse_linter_strategies(entries):
    """Parse `--linter-strategy` entries (`<linter>=<strategy>`) into a
    `{linter: strategy}` dict.

    Fails on an entry without `=` or with an empty side, an unknown strategy
    name, or two entries naming one linter (linter names match
    case-insensitively).
    """
    overrides = {}
    seen = {}
    for entry in entries:
        linter, sep, name = entry.partition("=")
        linter = linter.strip()
        name = name.strip()
        if not sep or not linter or not name:
            fail("lint: invalid --linter-strategy=%r - expected <linter>=<strategy>, e.g. ruff=hard" % entry)
        if name not in _STRATEGIES:
            fail(
                "lint: invalid --linter-strategy=%r%s" %
                (entry, did_you_mean_then(name, list(_STRATEGIES.keys()), " - ", "expected a strategy of " + ", ".join(_STRATEGIES.keys()))),
            )
        if linter.lower() in seen:
            fail(
                "lint: --linter-strategy names one linter twice: %r and %r - linter names match case-insensitively" %
                (seen[linter.lower()], linter),
            )
        seen[linter.lower()] = linter
        overrides[linter] = name
    return overrides

def resolve_strategy_overrides(overrides, unscoped):
    """Return the per-linter overrides in effect. Without change context
    (`unscoped`) the run falls back to `hard`, and so do `hold-the-line` /
    `hold-the-file` overrides, which have nothing to scope against.
    """
    if not unscoped:
        return dict(overrides)
    return {
        linter: "hard" if name in ("hold-the-line", "hold-the-file") else name
        for linter, name in overrides.items()
    }

def strategy_lookup(run_strategy, overrides):
    """Return `linter -> Strategy`: the override for that rules_lint linter name,
    matched case-insensitively, else `run_strategy`."""
    by_linter = {linter.lower(): _STRATEGIES[name] for linter, name in overrides.items()}
    return lambda linter: by_linter.get((linter or "").lower(), run_strategy)

def unmatched_overrides(overrides, tools_run):
    """Overridden linters that name none of the linters in `tools_run`, sorted."""
    ran = {tool.lower(): True for tool in tools_run}
    return sorted([linter for linter in overrides if linter.lower() not in ran])

def _strategy_name(strategy):
    """Kebab-case label for a Strategy record, matching the `--strategy=…` form."""
    if strategy == StrategyHoldTheLine:
        return "hold-the-line"
    if strategy == StrategyHoldTheFile:
        return "hold-the-file"
    if strategy == StrategyHard:
        return "hard"
    if strategy == StrategySoft:
        return "soft"
    return "custom"

def linter_error_message(failed_linters):
    """Message for the fail_on_linter_error path, naming the offending linters
    when known.

    `failed_linters` is a set-like dict of linter names; "" stands for a
    failure whose name didn't parse, and with no named linter the message
    stays unnamed.
    """
    names = sorted([t for t in failed_linters.keys() if t])
    if names:
        head = "Linter process(es) exited non-zero: %s." % ", ".join(names)
    else:
        head = "A linter process exited non-zero."
    return (
        "%s See the linter output under the 🔬 Lint phase above for details. " % head +
        "(Linters under the hard strategy fail on any linter error.)"
    )

def fails_on_severity(d, strategy_for):
    """True when the diagnostic's severity fails its linter's strategy."""
    fail_on = strategy_for(d.get("linter", "")).fail_on_severity
    return fail_on != None and d.get("severity", "") == fail_on

def gating_linter_errors(failed_linters, strategy_for):
    """The subset of `failed_linters` whose strategy fails on a linter error."""
    return {tool: True for tool in failed_linters if strategy_for(tool).fail_on_linter_error}

_SEV_CLI_ICON = {
    "error": "🚨",
    "warning": "⚠️",
    "info": "ℹ️",
}

def _print_linters_run(ctx, tools_run):
    """Print a one-line summary of the linters that fired. No-op when none ran."""
    if not tools_run:
        return
    color = ctx.std.io.stderr.color
    bold = ansi.code(ansi.STRONG, color)
    reset = ansi.RESET if color else ""
    print("")
    print("%s🧹 Linters%s (%d): %s" % (bold, reset, len(tools_run), ", ".join(tools_run)))

def _print_relevant_findings(ctx, relevant, strategy_label):
    """Print the strategy-filtered findings to stderr, one
    `location · tool · rule_id · message` row each, with the location from
    `format_location`. This is the subset that drives the exit code, PR
    comments and annotations, distinct from the raw streamed output. No-op
    when empty.
    """
    if not relevant:
        return
    color = ctx.std.io.stderr.color
    bold = ansi.code(ansi.STRONG, color)
    reset = ansi.RESET if color else ""
    print("")
    label = "%sLint findings%s after %s%s%s (%d)" % (
        bold,
        reset,
        bold,
        strategy_label,
        reset,
        len(relevant),
    )
    print(label)
    for d in relevant:
        icon = _SEV_CLI_ICON.get(d.get("severity", "") or "", "❓")
        tool = d.get("tool", "") or ""
        rule_id = d.get("rule_id", "") or ""
        message = d.get("message", "") or ""
        location = format_location(d.get("file", ""), d.get("line", 0), d.get("related_files"))
        parts = ["%s %s" % (icon, location)]
        if tool:
            parts.append(tool)
        if rule_id:
            parts.append(rule_id)
        head = " · ".join(parts)
        if message:
            print("  " + head + " — " + message)
        else:
            print("  " + head)

def _upload_patches_artifact(ctx, patches):
    """Bundle the `.patch` files into one tar.gz and upload as a CI artifact via
    `artifacts.upload_file`. No-op with no patches or off a recognized CI host.
    Each patch keeps its repo-relative path so a downloader can `tar xf` + `git
    apply` without rewriting paths.
    """
    if not patches:
        return

    tmpdir = ctx.std.env.var("ASPECT_WORKFLOWS_RUNNER_JOB_TMPDIR") or ctx.std.env.temp_dir()
    archive_dir = ctx.std.fs.mkdtemp(prefix = "aspect-lint-patches-", parent = tmpdir)
    archive_path = archive_dir + "/lint-patches.tar.gz"

    # mtree mapping each patch under its repo-relative path; strip the
    # bazel-out/bazel-bin prefix so entries read as `examples/lint/hello...patch`.
    lines = ["#mtree"]
    for patch in patches:
        idx = patch.find("/bazel-out/")
        if idx < 0:
            idx = patch.find("/bazel-bin/")
        if idx >= 0:
            tail = patch[idx + 1:]
            for prefix in ("bazel-out/", "bazel-bin/"):
                if tail.startswith(prefix):
                    rest = tail[len(prefix):]

                    # bazel-out/<config>/bin/... — drop two segments; bazel-bin/ is repo-relative.
                    if prefix == "bazel-out/":
                        slash1 = rest.find("/")
                        if slash1 >= 0:
                            rest = rest[slash1 + 1:]
                            if rest.startswith("bin/"):
                                rest = rest[4:]
                    tail = rest
                    break
            archive_entry = tail
        else:
            archive_entry = patch.rsplit("/", 1)[-1]
        lines.append("./" + archive_entry + " type=file contents=" + patch)
    mtree = "\n".join(lines) + "\n"

    if not tar_create(ctx, archive_path, mtree):
        warn(ctx.std, "Failed to create patch archive.")
        return

    artifacts.upload_file(ctx, kind = "lint_patches", name = "lint-patches.tar.gz", path = archive_path)

    if ctx.std.fs.exists(archive_path):
        ctx.std.fs.remove_file(archive_path)

# Lint task owns its mapping from `data` to lifecycle status (running | warning |
# failing | passed | failed | aborted) and the PR-comment Result-cell string.

def _pick_status(data, had_failure, terminal):
    """Decide lifecycle status from accumulated data.

    `had_failure` — hard-fail signal (build failed, fail_on_severity hit).
    `terminal`    — True iff this is the final `task_update` emit.
    Aborted rides on `data["bazel"]["aborted"]` (shared BES counter shape).
    """
    if data.get("bazel", {}).get("aborted"):
        return "aborted"
    if had_failure:
        return "failed" if terminal else "failing"
    counts = (data.get("lint", {}) or {}).get("counts_by_severity", {}) or {}
    if counts.get("warning", 0) > 0:
        return "warning"
    return "passed" if terminal else "running"

def _compact_text(status, data):
    """Compact Result-cell string for the PR-comment surface.

    Pure (status, data) → str: severity breakdown + suggested-fix count.
    Empty when no data accumulated yet (renderer falls back to phase prefix).
    """
    counts = (data.get("lint", {}) or {}).get("counts_by_severity", {}) or {}
    e = counts.get("error", 0)
    w = counts.get("warning", 0)
    i = counts.get("info", 0)

    # Suggestions are populated post-lint_end; treat absence as 0 mid-flight.
    suggestions = (data.get("lint", {}) or {}).get("suggestions", []) or []
    s = len(suggestions)
    if status == "failed" or status == "failing":
        bits = _sev_bits(e, w, i)
        if s > 0:
            bits.append("%d auto fix%s" % (s, "es" if s != 1 else ""))
        if bits:
            return " · ".join(bits)
        return ""
    if status == "passed":
        if s > 0:
            return "clean · %d auto fix%s" % (s, "es" if s != 1 else "")
        return "clean"
    if status == "warning":
        bits = _sev_bits(e, w, i)
        if s > 0:
            bits.append("%d auto fix%s" % (s, "es" if s != 1 else ""))
        if bits:
            return " · ".join(bits)
        return ""

    # running: severity breakdown only (suggestions don't exist until lint_end).
    bits = _sev_bits(e, w, i)
    if bits:
        return " · ".join(bits)
    return phases.ProgressStyles()

def _sev_bits(e, w, i):
    """Per-severity count bits in display order (error → warning → info), skipping zeros."""
    bits = []
    if e > 0:
        bits.append("%d error%s" % (e, "s" if e != 1 else ""))
    if w > 0:
        bits.append("%d warning%s" % (w, "s" if w != 1 else ""))
    if i > 0:
        bits.append("%d info" % i)
    return bits

def _progress(status, data):
    """Narrative `progress.body` for the PR-comment 💬 line — wraps `_compact_text`
    with a status verb prefix (e.g. `Lint failed · 3 errors`). Terminal emits only.
    """
    compact = _compact_text(status, data)
    if status == "passed":
        return phases.terminal_progress("Lint", "complete", compact)
    if status == "warning":
        return phases.terminal_progress("Lint", "complete", compact)
    if status == "failed":
        return phases.terminal_progress("Lint", "failed", compact)
    if status == "aborted":
        return phases.terminal_progress("Lint", "aborted")
    return ""

def _read_lint_file(ctx, filepath, timeout_ms = _LINT_FILE_PROBE_TIMEOUT_MS, expected_len = -1):
    """Read a lint output file, or None when its contents can't be read yet.

    Paths under the bb_clientd mount (bytestream:// URIs resolved by
    `local_output_path`) go through the bounded `poll_read_to_string`: the
    inode exists as soon as the BES event arrives but reading blocks until
    the blob materializes — and blocks *forever* when the blob can't be
    fetched at all. A plain read would wedge the whole task inside one
    uninterruptible syscall, so the read runs in the background, each call
    returns within `timeout_ms` (0 = poll without blocking), and None keeps
    the file in the pending queue — retried each tick until the post-build
    drain budget warns and skips it.

    `expected_len` is the file's authoritative byte length (BES `File.length`),
    or -1 when unknown. Both read paths compare the bytes they actually read
    against it and report a short read as not-yet-readable: a successful read
    is not proof the contents are whole, because the file can be exposed before
    its download finishes, and every consumer here (SARIF parse, patch hunks,
    exit codes) silently misbehaves on truncated input rather than failing
    loudly.

    Anything else is a plain local path — file:// URIs, or the output-tree
    fallback for bytestream URIs on runners without bb_clientd — read directly
    via `read_to_string_if_complete`: local disk can't stall the way bb_clientd
    reads can, so it needs no background probe, only the same length gate.

    Either way, None always means unreadable, never empty: a clean linter's
    empty `.out` reads as "".
    """
    root = bb_clientd_root(ctx.std.env)
    if root == None or not filepath.startswith(root):
        return ctx.std.fs.read_to_string_if_complete(filepath, expected_len = expected_len)
    return ctx.std.fs.poll_read_to_string(filepath, timeout_ms, expected_len = expected_len)

def _probe_timeout_ms(ctx, pass_deadline_ms):
    """Per-read probe bound for one drain/event pass: the standard probe
    timeout, clamped to what remains of the pass's `_PASS_READ_BUDGET_MS`
    blocking budget. 0 (nonblocking poll) once the budget is spent."""
    remaining = pass_deadline_ms - now_ms(ctx)
    if remaining <= 0:
        return 0
    return min(remaining, _LINT_FILE_PROBE_TIMEOUT_MS)

def _try_process_lint_file(ctx, file, filepath, data, strategy_for, changed_files, lint_trait, github_output, patches, probe_timeout_ms):
    """Read and process one BES lint output file.

    Returns None when the file's contents can't be read yet (see
    `_read_lint_file`; `probe_timeout_ms` bounds the read wait, 0 = poll
    without blocking), else {"interesting": bool, "linter_exit_code": int,
    "failed_tool": str}. A None keeps the file in the pending queue, retried
    each tick until the post-build drain timeout warns and skips it.
    `failed_tool` names the linter when its `.exit_code` was non-zero (else ""),
    so the fail_on_linter_error path can report which tool failed.
    SARIF is filtered per-batch against its linter's (pure) strategy scope
    (`strategy_for`), so per-batch results equal a terminal pass and findings
    don't flicker as batches arrive.

    Every read is gated on the file's BES-declared length so a
    still-materializing blob is retried rather than parsed half-written.
    """
    expected_len = bes_get(file, "length", -1) or -1

    if file.name.endswith(".out"):
        out = _read_lint_file(ctx, filepath, probe_timeout_ms, expected_len)
        if out == None:
            return None
        ctx.std.io.stderr.write(out)
        return {"interesting": False, "linter_exit_code": 0, "failed_tool": ""}

    if file.name.endswith(".report"):
        report = _read_lint_file(ctx, filepath, probe_timeout_ms, expected_len)
        if report == None:
            return None
        if "sarif-" in report:
            sarif = parse_sarif(report)
            if not sarif:
                # The read was complete (length-gated), so a document that
                # still won't decode is malformed rather than in flight —
                # retrying can't help. Name it instead of dropping its
                # findings silently.
                warn(ctx.std, "Ignoring unparseable SARIF report: %s" % filepath)
                return {"interesting": False, "linter_exit_code": 0, "failed_tool": ""}
            lint_accumulate(data, report_diagnostics(sarif, detect_lint_tool(file.name), strategy_for, changed_files))
            for hook in lint_trait.lint_report:
                hook(ctx, filepath)
            return {"interesting": True, "linter_exit_code": 0, "failed_tool": ""}
        ctx.std.io.stdout.write(report)
        if github_output:
            ctx.std.fs.write(github_output, "lint-report=" + filepath)
        return {"interesting": False, "linter_exit_code": 0, "failed_tool": ""}

    if file.name.endswith(".patch"):
        # Readability gate (content discarded): requeues until the blob is
        # whole, since lint_patch hooks buffer the path and re-read it later
        # with a plain read_to_string that has no completeness check.
        if _read_lint_file(ctx, filepath, probe_timeout_ms, expected_len) == None:
            return None
        patches.append({"path": filepath, "name": file.name})
        for hook in lint_trait.lint_patch:
            hook(ctx, filepath, file.name)
        return {"interesting": False, "linter_exit_code": 0, "failed_tool": ""}

    if file.name.endswith(".exit_code"):
        content = _read_lint_file(ctx, filepath, probe_timeout_ms, expected_len)
        if content == None:
            return None
        stripped = content.rstrip()
        if not stripped.isdigit():
            # Empty/garbled content: treat like an in-flight download so it's
            # retried, then warned and skipped by the post-build timeout.
            return None
        exit_code = int(stripped)
        failed_tool = detect_lint_tool(file.name) if exit_code != 0 else ""
        return {"interesting": False, "linter_exit_code": exit_code, "failed_tool": failed_tool}

    return {"interesting": False, "linter_exit_code": 0, "failed_tool": ""}

def _record_lint_result(result, failed_linters):
    """Fold one non-None `_try_process_lint_file` result into `failed_linters`
    (a set-like dict of tool names that exited non-zero; "" when the name
    didn't parse) and return `(interesting, exit_nonzero)`. Shared by the live
    BES loop and the post-build drain so both treat a result identically.
    """
    if result["linter_exit_code"] != 0:
        failed_linters[result["failed_tool"]] = True
    return (result["interesting"], result["linter_exit_code"] != 0)

def _drain_pending_files(ctx, bb_root, pending, pending_meta, data, strategy_for, changed_files, lint_trait, github_output, patches, failed_linters, pass_deadline_ms):
    """One pass over pending files → (still_pending, was_interesting, exit_nonzero).
    still_pending holds files whose remote download hasn't landed or whose
    contents couldn't be read yet. `pass_deadline_ms` caps this pass's total
    blocking time on read probes (see `_probe_timeout_ms`).
    `pending_meta` (path → {"first_ms", "warned"}) tracks how long each file
    has been unreadable across passes; a file pending longer than
    `_PENDING_READ_WARN_MS` gets a one-time warning naming it, so a stuck
    remote-cache read is visible in the log while the task is still running.
    `failed_linters` accumulates linter names whose `.exit_code` was non-zero
    ("" when the name didn't parse).
    """
    still_pending = []
    interesting = False
    exit_nonzero = False
    now = now_ms(ctx)
    for pfile in pending:
        pfilepath = local_output_path(pfile, bb_root)
        result = _try_process_lint_file(ctx, pfile, pfilepath, data, strategy_for, changed_files, lint_trait, github_output, patches, _probe_timeout_ms(ctx, pass_deadline_ms))
        if result == None:
            meta = pending_meta.setdefault(pfilepath, {"first_ms": now, "warned": False})
            if not meta["warned"] and now - meta["first_ms"] >= _PENDING_READ_WARN_MS:
                warn(ctx.std, "Lint file still not readable %ds after its build event arrived (retrying): %s" % ((now - meta["first_ms"]) // 1000, pfilepath))
                meta["warned"] = True
            still_pending.append(pfile)
        else:
            pending_meta.pop(pfilepath, None)
            file_interesting, file_exit_nonzero = _record_lint_result(result, failed_linters)
            interesting = interesting or file_interesting
            exit_nonzero = exit_nonzero or file_exit_nonzero
    return (still_pending, interesting, exit_nonzero)

_DEFAULT_RULES_LINT_FIX_FLAG = "@aspect_rules_lint//lint:fix"

def _rules_lint_fix_flag_error(fix_flag):
    """Explains a fix build that failed because Bazel rejected the `rules_lint_fix_flag` label."""
    suggested = "@rules_lint//lint:fix" if fix_flag == _DEFAULT_RULES_LINT_FIX_FLAG else "<rules_lint's fix flag label>"
    return (
        "Bazel rejected the rules_lint fix flag --%s. " % fix_flag +
        "Set the label for your rules_lint version with " +
        "`ctx.tasks[\"lint\"].args.rules_lint_fix_flag = \"%s\"` in .aspect/config.axl, " % suggested +
        "or pass --rules-lint-fix-flag=%s." % suggested
    )

# buildifier: disable=function-docstring
def _impl(ctx: TaskContext) -> int | TaskConclusion:
    lint_trait = ctx.traits[LintTrait]
    bazel_trait = ctx.traits[BazelTrait]
    strategy = _STRATEGIES[ctx.args.strategy]

    # Validate up front so a typo doesn't fail after the build has run.
    strategy_overrides = parse_linter_strategies(ctx.args.linter_strategies)

    data = lint_init_data()
    ph = phases.new(ctx, data)
    data["start_time_ms"] = now_ms(ctx)

    # Set for early renders; reset after change detection may fall back to hard.
    data["lint"]["strategy"] = _strategy_name(strategy)
    data["lint"]["strategies"] = strategy_overrides

    # Refined once the rc is parsed and a forwarded `--target_pattern_file` can count.
    data["target_pattern"] = " ".join(resolve_targets(ctx, None, "build")[0])

    # Base flags computed before phases.setup, which forwards them to bazel_rc.setup.
    base_flags = ["--remote_download_regex='.*AspectRulesLint.*'"]
    for aspect in ctx.args.aspects:
        base_flags.append("--aspects=" + aspect)

    # Patch production is gated by --fix OR any lint_patch hook. Applying still
    # requires --fix; a hook-only run produces patches without touching the tree.
    fix_apply = ctx.args.fix
    fix_produce = fix_apply or bool(lint_trait.lint_patch)
    if fix_produce:
        base_flags.append("--output_groups=rules_lint_patch")
        base_flags.append("--" + ctx.args.rules_lint_fix_flag)

    # rules_lint_human / rules_lint_machine are separate action sets (requesting
    # both runs each linter twice): human = colored terminal output, machine =
    # exit codes + SARIF. detect_ci() guards CI hosts that allocate a pseudo-TTY.
    is_interactive = ctx.std.io.stdout.is_tty and not detect_ci(ctx.std.env)
    if is_interactive:
        base_flags.append("--output_groups=rules_lint_human")
    if lint_trait.lint_report or not is_interactive:
        base_flags.append("--output_groups=rules_lint_machine")

    # Pre-task setup phase (status surface, rc parse, health checks); returns
    # the rc (a failed health check fails the task inside phases.setup).
    rc = ph.setup(data["target_pattern"], "lint_results", "build", base_flags = base_flags)
    announce_version, announce_command = bazel_announce.resolve(ctx)
    endpoint_auth_flags = bazel_rc.hook_flags(ctx, rc, "build")
    targets, pattern_flags = resolve_targets(ctx, rc, "build")
    endpoint_auth_flags.extend(pattern_flags)
    data["target_pattern"] = " ".join(targets)

    # Detect changed files BEFORE lint_start hooks, which receive them. Prefers
    # the GitHub PR Files API, falls back to local `git diff <base> --unified=0`.
    # Lives in lib/github.axl (format wants it too).
    status = _pick_status(data, had_failure = False, terminal = False)
    ph.update(
        status,
        phases.ProgressStyles(
            body = "Detecting changed files...",
            stream = "Detecting changed files",
        ),
        kind = "lint_results",
        data = data,
        phase = phases.Phase(name = "detect", description = "Detect changed files", emoji = "🔍"),
    )
    detect_result = detect_changed_files(
        ctx,
        line_level = True,
        base_ref = ctx.args.base_ref,
        merge_base = ctx.args.merge_base or None,
    )
    if detect_result.get("unscoped"):
        # Show every finding rather than hide them behind a scope we can't compute.
        warn(ctx.std, "Could not determine the changed-file set (%s). Linting with `strategy=hard` (all findings shown, no hold-the-line scoping). Override with --merge-base=<sha> or set --base-ref to a ref available locally." % detect_result["source"])
        strategy = StrategyHard
        strategy_overrides = resolve_strategy_overrides(strategy_overrides, unscoped = True)
        changed_files = []
    else:
        changed_files = detect_result["files"]
    data["lint"]["strategy"] = _strategy_name(strategy)
    data["lint"]["strategies"] = strategy_overrides
    strategy_for = strategy_lookup(strategy, strategy_overrides)
    data["lint"]["changed_files"] = changed_files

    # Shared changed-file listing (announces source, prints sorted entries).
    # See lib/github.axl::print_changed_files_listing for row format / rename rules.
    print_changed_files_listing(ctx, detect_result)

    start_info = LintStartInfo(changed_files = changed_files, scoped = not detect_result.get("unscoped"))
    for hook in lint_trait.lint_start:
        hook(ctx, start_info)

    bes_sinks = collect_bes_sinks(ctx, bazel_trait, rc)
    data.update(bes_link_data(bazel_trait, rc, bes_sinks))
    events = bazel.build_events.iterator()
    build_events = [events] + bes_sinks

    for hook in bazel_trait.build_start:
        hook(ctx)

    status = _pick_status(data, had_failure = False, terminal = False)
    ph.update(
        status,
        phases.ProgressStyles(
            body = "Running lint aspects...",
            stream = "Running lint aspects",
        ),
        kind = "lint_results",
        data = data,
        phase = phases.Phase(name = "lint", description = "Run lint aspects", emoji = "🔬", expanded = True),
    )

    # After the phase line, so the streams are announced under the spawn they
    # belong to.
    announce_bes_sinks(ctx, bes_sinks)

    # 6. Build + stream events
    xl = bazel_exec_log.open(bazel_trait)

    # TODO: re-introduce --quiet once we can capture (not only inherit-or-not)
    # Bazel's stdout/stderr. Today suppressing both hides build failures.
    build = ctx.bazel.build(
        build_events = build_events,
        execution_log = xl.sinks or False,
        announce_version = announce_version,
        announce_command = announce_command,
        flags = endpoint_auth_flags,
        *targets
    )

    # sink_invocation_id is minted in Build::spawn before it returns, so set it
    # here (before build.wait()) — an early task_update lets the BK annotation /
    # status check surface the Aspect Workflows link as soon as the build spawns.
    data["sink_invocation_id"] = build.sink_invocation_id

    # Re-emit now that sink_invocation_id is known (Web UI link); status surfaces
    # only — empty `stream` suppresses the duplicate CLI line.
    status = _pick_status(data, had_failure = False, terminal = False)
    ph.update(
        status,
        phases.ProgressStyles(
            body = "Running lint aspects...",
        ),
        kind = "lint_results",
        data = data,
    )

    linter_exit_code = 0

    # Tool names whose `.exit_code` was non-zero; reported in the
    # fail_on_linter_error path so the failure names the offending linter.
    failed_linters = {}
    patches = []
    github_output = ctx.std.env.var("GITHUB_OUTPUT")

    # Files whose download hadn't completed when their named_set_of_files BES
    # event arrived; retried each tick. `pending_meta` tracks per-path age so
    # a stuck read warns while the task runs (see _drain_pending_files).
    pending_files = []
    pending_meta = {}

    # rules_lint tool names observed in BES file-name markers.
    lint_tools_run = {}

    # Set when Bazel rejects the `rules_lint_fix_flag` label. Bazel reports each cause
    # (repo, package or target missing, or not a flag) as `ERROR: <label> :: <reason>`.
    fix_flag_load_error = "%s :: " % ctx.args.rules_lint_fix_flag
    fix_flag_rejected = False

    # bytestream:// URIs resolve through bb_clientd only when this runner has
    # a usable mount (declared by env and actually mounted); bb_root None
    # routes them to the output-tree fallback instead (see local_output_path).
    bb_root = usable_bb_clientd_root(ctx.std)
    skipped_remote_files = 0

    # Emit on each interesting tick, and at least every MIN_HEARTBEAT_INTERVAL_MS
    # to keep the elapsed timer live.
    last_emit_ms = now_ms(ctx)
    for _tick in sleep_iter(BES_DRAIN_TICK_MS):
        interesting = False
        bazel_exec_log.pump(ctx, xl)  # exec_log_event hooks
        pass_deadline_ms = now_ms(ctx) + _PASS_READ_BUDGET_MS

        pending_files, pending_interesting, pending_exit_nonzero = _drain_pending_files(
            ctx,
            bb_root,
            pending_files,
            pending_meta,
            data,
            strategy_for,
            changed_files,
            lint_trait,
            github_output,
            patches,
            failed_linters,
            pass_deadline_ms,
        )
        if pending_interesting:
            interesting = True
        if pending_exit_nonzero:
            linter_exit_code = 1

        for _ in range(10000):
            event = events.try_pop()
            if event == None:
                break
            for handler in bazel_trait.build_event:
                handler(ctx, event)
            if process_event(data, event, bb_root, std = ctx.std):
                interesting = True
            if fix_produce and not fix_flag_rejected and event.kind == "progress":
                fix_flag_rejected = fix_flag_load_error in bes_get(event.payload, "stderr", "")
            if event.kind == "named_set_of_files":
                for file in event.payload.files:
                    filepath = local_output_path(file, bb_root)
                    tool = detect_lint_tool(file.name)
                    if tool:
                        lint_tools_run[tool] = True
                    if file.name.endswith(".patch") or file.name.endswith(".out") or file.name.endswith(".report") or file.name.endswith(".exit_code"):
                        if not filepath:
                            skipped_remote_files += 1
                            continue
                        result = _try_process_lint_file(ctx, file, filepath, data, strategy_for, changed_files, lint_trait, github_output, patches, _probe_timeout_ms(ctx, pass_deadline_ms))
                        if result == None:
                            pending_files.append(file)
                        else:
                            file_interesting, file_exit_nonzero = _record_lint_result(result, failed_linters)
                            interesting = interesting or file_interesting
                            if file_exit_nonzero:
                                linter_exit_code = 1
        if interesting or now_ms(ctx) - last_emit_ms >= MIN_HEARTBEAT_INTERVAL_MS:
            # Flip to "failing" on mid-build action failure so the breakdown tags Lint.
            had_action_failure = data["bazel"].get("failed_actions_total", 0) > 0
            heartbeat_status = _pick_status(data, had_failure = had_action_failure, terminal = False)
            ph.dispatch(phases.Update(
                kind = "lint_results",
                status = heartbeat_status,
                data = data,
                progress = phases.ProgressStyles(),
            ))
            last_emit_ms = now_ms(ctx)
        if events.done:
            break

    # 7. Wait for build
    bazel_exec_log.close(ctx, xl)  # must precede wait(); see bazel/exec_log.axl
    build_status = build.wait()
    for sink in bes_sinks:
        sink.wait()
    summarize_bes_upload(ctx, bes_sinks)

    dispatch_bazel_attempt_end(ctx, bazel_trait, exit_code_of(build_status))

    # Final drain: poll until pending downloads land or timeout. --remote_download_regex
    # transfers are async, so files can still be in flight after build.wait().
    if pending_files:
        _POST_BUILD_SLOW_WARN_MS = 3000
        post_build_start_ms = now_ms(ctx)
        post_build_deadline_ms = post_build_start_ms + _POST_BUILD_DOWNLOAD_TIMEOUT_MS
        slow_warned = False
        for _i in range(_POST_BUILD_DOWNLOAD_TIMEOUT_MS // BES_DRAIN_TICK_MS + 1):
            pending_files, _, pending_exit_nonzero = _drain_pending_files(
                ctx,
                bb_root,
                pending_files,
                pending_meta,
                data,
                strategy_for,
                changed_files,
                lint_trait,
                github_output,
                patches,
                failed_linters,
                now_ms(ctx) + _PASS_READ_BUDGET_MS,
            )
            if pending_exit_nonzero:
                linter_exit_code = 1
            if not pending_files:
                break
            elapsed_ms = now_ms(ctx) - post_build_start_ms
            if not slow_warned and elapsed_ms >= _POST_BUILD_SLOW_WARN_MS:
                print("Waiting for lint reports to finish downloading from the remote cache...")
                slow_warned = True
            if now_ms(ctx) >= post_build_deadline_ms:
                for pfile in pending_files:
                    pfilepath = local_output_path(pfile, bb_root)
                    warn(ctx.std, "Lint file not readable %ds after build completed (skipping): %s" % (_POST_BUILD_DOWNLOAD_TIMEOUT_MS // 1000, pfilepath))
                break
            sleep(BES_DRAIN_TICK_MS)

    if skipped_remote_files:
        warn(ctx.std, "Skipped %s: no local path can serve them (no bb_clientd mount and no output-tree path)" % pluralize(skipped_remote_files, "lint output file"))

    build_failed = not build_status.success
    if build_failed and fix_flag_rejected:
        error(ctx.std, _rules_lint_fix_flag_error(ctx.args.rules_lint_fix_flag))
    data["lint"]["build_failed"] = build_failed
    data["lint"]["linter_exit_code"] = linter_exit_code
    if not data.get("finish_time_ms"):
        data["finish_time_ms"] = now_ms(ctx)
    if not data["bazel"].get("wall_time_ms") and data.get("start_time_ms"):
        data["bazel"]["wall_time_ms"] = data["finish_time_ms"] - data["start_time_ms"]

    # 8. BazelTrait.build_end hooks
    dispatch_bazel_build_end(ctx, bazel_trait, exit_code_of(build_status))

    # Scope patches to their linter's strategy so we neither rewrite out-of-scope
    # files locally nor publish an artifact of unrelated fixes. soft/hard keep all.
    scoped_patches = _filter_patches_by_strategy(ctx, patches, strategy_for, changed_files)

    # 8b. Upload patches as one artifact on a CI host that supports it, so users
    # can apply them offline when a feature didn't post them as PR suggestions.
    if scoped_patches and not build_failed:
        _upload_patches_artifact(ctx, scoped_patches)

    # 9. Apply patches — gated on `not build_failed` AND a non-empty scoped
    # subset. Applying auto-fixes against a broken build risks compounding the
    # breakage. Skipping the phase emit also keeps current_phase() on `lint` so
    # the breakdown tags the right phase and no zero-work `Apply` row appears.
    if not build_failed and fix_apply and scoped_patches:
        patches_label = pluralize(len(scoped_patches), "auto-fix patch", plural = "auto-fix patches")
        status = _pick_status(data, had_failure = False, terminal = False)
        ph.update(
            status,
            phases.ProgressStyles(
                body = "Applying %s..." % patches_label,
                stream = "Applying " + patches_label,
            ),
            kind = "lint_results",
            data = data,
            phase = phases.Phase(name = "apply", description = "Apply auto-fix patches", emoji = "📦"),
        )
        for patch in scoped_patches:
            # Never a question (no terminal answers it): a hunk that looks
            # applied already is skipped, not reversed, and leaves no reject
            # file in the tree. BSD and GNU patch both.
            ctx.std.process.command("patch").arg("-p1").arg("--forward").arg("--batch").arg("--reject-file=/dev/null").arg("--input=" + patch) \
                .current_dir(ctx.std.env.current_dir()).spawn().wait()

    # 10. Strategy filter → relevant diagnostics for reporting + exit code.
    # Skip the `filter` phase emit when the build failed or no aspect ran:
    # emitting a filter boundary would make the breakdown tag Filter (failed)
    # instead of Lint; without it the lint phase stays active so Lint is tagged.
    if not build_failed and lint_tools_run:
        status = _pick_status(data, had_failure = False, terminal = False)
        ph.update(
            status,
            phases.ProgressStyles(
                body = "Filtering diagnostics...",
                stream = "Filtering diagnostics",
            ),
            kind = "lint_results",
            data = data,
            phase = phases.Phase(name = "filter", description = "Filter diagnostics", emoji = "🔎"),
        )

    # diagnostics were already filtered per-batch as SARIF streamed in, so the
    # Filter phase emit above is just the UI marker; no separate pass needed.
    relevant = list(data["lint"]["diagnostics"])

    # Thread the linter set so the 🧹 chart and CLI summary share a sorted snapshot.
    data["lint"]["tools_run"] = sorted(lint_tools_run.keys())
    _print_linters_run(ctx, data["lint"]["tools_run"])
    unmatched = unmatched_overrides(strategy_overrides, data["lint"]["tools_run"])
    if unmatched and lint_tools_run and not build_failed:
        # A note, not a warning: a run that lints only some targets leaves
        # correctly spelled linter names unmatched too.
        print("   --linter-strategy: no output this run from %s (linter names match the ones above)" % ", ".join(unmatched))

    # Print the post-filter subset (drives exit code / PR / annotations), distinct
    # from the high-volume raw output streamed during the Lint phase.
    _print_relevant_findings(ctx, relevant, lint_strategy_label(_strategy_name(strategy), strategy_overrides))

    # 11. lint_end hooks receive filtered diagnostics. Suggestions get the same
    # strategy filter, or hold-the-line shows auto-fixes for excluded lines.
    end_result = merge_lint_end_results([hook(ctx, relevant) for hook in lint_trait.lint_end])
    data["lint"]["suggestions"] = _filter_suggestions_by_strategy(end_result.suggestions, strategy_for, changed_files)
    data["lint"]["comment_urls"] = end_result.comment_urls

    # 12. Exit code. `not lint_tools_run` guards the silent zero-aspect case —
    # a green `aspect lint` in CI must mean "passed", not "never ran".
    gating_errors = gating_linter_errors(failed_linters, strategy_for)
    if build_failed:
        exit_code = 1
    elif not lint_tools_run:
        if rc.flag_values("--aspects", command = "build"):
            error(ctx.std, (
                "Lint aspect(s) configured but produced no rules_lint output. " +
                "Verify the configured aspect is from rules_lint and " +
                "that your target pattern includes lintable targets."
            ))
        else:
            error(ctx.std, (
                "No lint aspect configured. Pass --aspect=<label> " +
                "(e.g. --aspect=//tools/lint:linters.bzl%shellcheck) or add " +
                "--aspects=… via a bazelrc --config."
            ))
        exit_code = 1
    elif any([fails_on_severity(d, strategy_for) for d in relevant]):
        exit_code = 1
    elif gating_errors:
        # Without this the path surfaces nothing: a linter that crashed without
        # emitting findings would fail with an unexplained exit 1.
        error(ctx.std, linter_error_message(gating_errors))
        exit_code = 1
    else:
        exit_code = 0

    # Repro reruns the same scope. The fix variant (adds --fix) is gated on the
    # strategy-filtered suggestion set, not the hooks' raw records, so we don't offer
    # a fix command for patches the strategy excluded.
    repro_flags = explicit_flags(ctx, [
        ("strategy", "--strategy"),
        ("linter_strategies", "--linter-strategy"),
        ("aspects", "--aspect"),
        ("merge_base", "--merge-base"),
        ("target_pattern_file", "--target-pattern-file"),
    ])
    surfaced_base_ref = ctx.args.base_ref or detect_ci_base_ref(ctx.std)
    if surfaced_base_ref:
        repro_flags.append(("--base-ref", surfaced_base_ref))
    task_path = task_cli_path(ctx.task)
    prefix = repro_prefix(ctx)
    if flavor_allows(ctx.args.repro_flavors, "lint-repro"):
        data["repro_commands"].append(phases.ReproFixCommand(
            command = prefix + build_aspect_command(task_path, repro_flags, targets),
            slug = "lint-repro",
        ))
    if data["lint"]["suggestions"] and flavor_allows(ctx.args.fix_flavors, "lint-fix"):
        data["fix_commands"].append(phases.ReproFixCommand(
            command = prefix + build_aspect_command(task_path, [("--fix", None)] + repro_flags, targets),
            slug = "lint-fix",
        ))

    # Final task_update — drives the GithubStatusChecks terminal render.
    final_status = _pick_status(data, had_failure = exit_code != 0, terminal = True)
    bookend = lint_conclusion(final_status, data)

    # Pre-hook with rich ReproFixInfo (exit_code/targets/extras) that the
    # ph.dispatch safety-net can't supply; these are skipped on dispatch.
    ph.suggest_fixes(
        "lint_results",
        final_status,
        exit_code = exit_code,
        targets = targets,
        extras = {
            "aspects": list(ctx.args.aspects),
            "suggestion_count": len(data["lint"]["suggestions"] or []),
        },
    )

    # Before the dispatch: the body links this artifact out of the registry.
    artifacts.upload_report(ctx, data, final_status)

    ph.dispatch(phases.Update(
        kind = "lint_results",
        status = final_status,
        final = True,
        conclusion = bookend,
        data = data,
        progress = _progress(final_status, data),
    ))
    print_repro_and_fix(ctx.std, data, final_status)

    return TaskConclusion(
        exit_code = exit_code,
        text = bookend,
        flagged = final_status == "warning",
    )

lint = task(
    show_task_options = True,
    summary = "Lint targets using rules_lint aspects and report findings on the terminal or as code-review comments.",
    args = {
        "aspects": args.string_list(
            long = "aspect",
            description = "Bazel aspect label(s) to apply for linting (e.g. //tools/lint:linters.bzl%eslint). Repeat the flag to run multiple aspects in a single invocation. Aspects may also be supplied via `--aspects=…` (Bazel's own flag, forwarded) or a bazelrc `--config`; at least one rules_lint aspect must reach Bazel one way or another.",
        ),
        "fix": args.boolean(
            description = (
                "Apply auto-fixes from rules_lint to the working tree. " +
                "When omitted, the lint task still produces fix patches " +
                "if a feature consumes them (e.g. GithubLintComments " +
                "turns each hunk into a PR review comment with a " +
                "`suggestion` block) — it just doesn't apply them " +
                "locally. Pass `--fix` to apply on top of producing."
            ),
        ),
        "rules_lint_fix_flag": args.string(
            default = _DEFAULT_RULES_LINT_FIX_FLAG,
            description = (
                "Label of the rules_lint build flag that makes linters produce " +
                "fix patches, passed to Bazel as `--<label>`. Set it to " +
                "`@rules_lint//lint:fix` when depending on rules_lint under its " +
                "new module name, or to match a `repo_name` override or a " +
                "renamed flag."
            ),
        ),
        "strategy": args.string(
            default = "hold-the-line",
            values = ["soft", "hard", "hold-the-line", "hold-the-file"],
            description = (
                "How lint diagnostics drive the exit code. " +
                "'hold-the-line' (default): line-level — fails only on " +
                "error-severity diagnostics inside a displayed hunk on " +
                "a changed file (matches what PR comments and annotations " +
                "can surface). 'hold-the-file': file-level — fails on " +
                "errors anywhere in a changed file, even outside the diff " +
                "window (broader; rendered details list these but per-line " +
                "surfaces can't show them). 'hard': fails on any error and " +
                "on linter-process failure. 'soft': surfaces diagnostics " +
                "without ever failing. `--linter-strategy` overrides " +
                "this per linter."
            ),
        ),
        "linter_strategies": args.string_list(
            long = "linter-strategy",
            description = (
                "Per-linter --strategy override as <linter>=<strategy>, " +
                "e.g. ruff=hard. Repeat for more linters. <linter> is a " +
                "rules_lint linter name as listed under 🧹 Linters " +
                "(ruff for AspectRulesLintRuff), matched case-insensitively; " +
                "the override covers that linter's findings, patches, " +
                "suggestions and process failures."
            ),
        ),
        "findings_destination": args.string(
            default = "auto",
            values = _FINDINGS_DESTINATIONS,
            description = (
                "Where code-review features surface findings. 'auto' " +
                "(default): annotate findings and post fix-bearing ones and " +
                "rules_lint patches as PR comments, without annotating where " +
                "a fix comment lands. 'both': like auto but annotate " +
                "everything. 'comments': every finding as a PR comment, no " +
                "annotations. 'annotations': every finding as an " +
                "annotation, no PR comments."
            ),
        ),
        "base_ref": args.string(
            default = "",
            description = "Base ref for the changed-file set, " + BASE_REF_DESCRIPTION_TAIL,
        ),
        "merge_base": args.string(
            description = "Explicit merge-base SHA for the local-git fallback's diff base. When set, skips the `git merge-base HEAD <base-ref>` resolution and uses this SHA directly. Ignored on the GitHub PR Files API path.",
        ),
        # TODO: Support - (list from stdin)
        "targets": args.positional(
            minimum = 0,
            maximum = 512,
            default = ["..."],
            description = "Bazel target patterns to lint. Defaults to '...' which expands to all rule targets in the package at and beneath the current directory. Pass multiple patterns to combine includes and excludes; when any pattern is hyphen-led, separate them from flags with `--` (e.g. `aspect lint -- //... -//experimental/...`).",
        ),
    } | bazel_flags.args("the lint build") | bazel_announce.args("the lint build") | bes_args() | bazel_invocation.target_pattern_file_arg() | repro_flavor_args(include_fix = True),
    implementation = _impl,
)

testonly_filter_suggestions_by_strategy = _filter_suggestions_by_strategy
