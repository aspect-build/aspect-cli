"""The rc file `aspect setup bazelrc` writes, as a document: where the files go,
how flags render into sections, how the file announces itself, and how it is
placed in the rc Bazel already reads through a commented `try-import` line.

Nothing here decides *which* flags are written — `aspect_flags.axl`,
`rc_groups.axl`, and `deployment_rc.axl` do — only where the output lands, how
startup flags, enabled groups, and `RcConfig` sections become text, and how that
text lands without disturbing what a user or another setup step already put in
their rc.

`rc_paths` is the whole layout: one shape under a base directory the caller
resolves (the workspace root, or the home directory in home mode), plus the
overrides. It is a pure function of that base and the task's arguments, so the
placement rules are testable without a filesystem.

On Bazel >= 6.3.0 flags are emitted under `common` (applies to every command);
older Bazel has no `common` pseudo-command, so they're spelled out under `build`
(inherited by test/run/coverage/cquery/aquery/fetch/…) and `query` (the one
action-relevant command that doesn't inherit `build`). Every flag this file is
handed ungated is accepted by `query` on Bazel < 6.3.0, the only range that
branch runs in; flags later Bazel rejects on `query` are version-gated past it.
"""

load("@aspect//bazel/build_metadata.axl", "version_gte")
load("./aspect_flags.axl", "flag_text")

# Bazel gained the `common` pseudo-command in 6.3.0.
_COMMON_PSEUDO_COMMAND_MIN_VERSION = "6.3.0"
_PRE_COMMON_COMMANDS = ["build", "query"]

# The three paths the layout puts under its base directory: the generated rc,
# the rc that imports it (`<workspace>/.bazelrc` or `~/.bazelrc`, both of which
# Bazel reads on its own), and the directory build-time outputs land in.
GENERATED_RC = ".aspect/bazelrc"
IMPORTING_RC = ".bazelrc"
GENERATED_DIR = ".aspect/generated"
EXEC_LOG_NAME = "exec.log.zstd"

# `%workspace%` is the one variable Bazel expands in an rc value, so a committed
# rc addresses the checkout through it and the path holds in every clone.
_WORKSPACE_PREFIX = "%workspace%/"

# First line of the generated rc. None of them is rewritten over an existing
# file without `--force`: a checkout's is a starting point its repository owns
# and edits, and a machine's may belong to a persistent runner someone set up by
# hand. A Workflows runner reaches this fresh every job anyway, its agent having
# removed `~/.aspect` before the job started.
GENERATED_HEADER = "# Generated by `aspect setup bazelrc` as a starting point: edit as your repository needs. `aspect setup bazelrc --force` regenerates it, discarding those edits."
RUNNER_HEADER = "# Generated by `aspect setup bazelrc` for this runner. `aspect setup bazelrc --force` regenerates it; opt out of a flag with --omit-bazel-flag."
HOME_HEADER = "# Generated by `aspect setup bazelrc` for this machine. `aspect setup bazelrc --force` regenerates it; opt out of a flag with --omit-bazel-flag."

# One `--config` section of the rc. `flags` are `str | (str, constraint)` like
# everywhere else; a plain `--config=<other>` entry chains to another section and
# is written as-is rather than version-resolved. `source` names what claims the
# section, for the collision error in `deployment_rc.axl`.
RcConfig = record(
    name = field(str),
    source = field(str),
    comment = field(str, default = ""),
    flags = field(list),
)

# The comment written above the `try-import` line in the importing rc, so the
# import reads as ours next to whatever else the file holds.
IMPORT_COMMENT = "# Aspect's rc for vanilla `bazel`, maintained by `aspect setup bazelrc`."

# What `ensure_import` did to the user rc.
ImportAction = enum("created", "unchanged", "prepended")

ImportResult = record(
    content = field(str),
    action = field(ImportAction),
)

# Every file `aspect setup bazelrc` touches, as `rc_paths` resolves them.
# `importer` and `generated_dir` are "" where there is nothing to do.
RcPaths = record(
    output = field(str),
    importer = field(str),
    imported = field(str),
    exec_log = field(str),
    generated_dir = field(str),
)

def _dirname(path: str) -> str:
    return path.rsplit("/", 1)[0] if "/" in path else "."

def rc_paths(base: str, output: str = "", import_into: str = "", home_mode: bool = False, exec_log: str = "") -> RcPaths:
    """Where each file goes, given the base directory and the task's overrides.

    The layout is `<base>/.aspect/bazelrc`, imported by `<base>/.bazelrc`, with
    the execution log under `<base>/.aspect/generated/`. `home_mode` says the
    base is the home directory rather than the workspace root, which decides one
    thing here: a home rc is imported by the path it was written to, while a
    checkout's is imported through `%workspace%` so the committed line holds in
    every clone.

    `output` and `import_into` are the task's flags of those names. `exec_log`
    overrides where the log goes — a runner passes its job tmpdir, which is per
    job rather than per machine.

    `importer` is "" when nothing needs importing (the caller pointed
    `--import-into` at the output itself). `generated_dir` is "" when the log
    does not land under the base, so there is no directory of ours to create:
    an explicit `--output` keeps its log beside itself, and an overridden log
    is somewhere the caller already owns. `base` may be "" only when `output`
    and `import_into` together name every path this would otherwise derive."""
    out = output or base + "/" + GENERATED_RC
    importer = import_into or base + "/" + IMPORTING_RC
    generated_dir = "" if output or exec_log else base + "/" + GENERATED_DIR

    if exec_log:
        log = exec_log
    elif output:
        log = _dirname(output) + "/" + EXEC_LOG_NAME
    elif home_mode:
        log = base + "/" + GENERATED_DIR + "/" + EXEC_LOG_NAME
    else:
        log = _WORKSPACE_PREFIX + GENERATED_DIR + "/" + EXEC_LOG_NAME

    return RcPaths(
        output = out,
        importer = "" if importer == out else importer,
        imported = out if home_mode or output else _WORKSPACE_PREFIX + GENERATED_RC,
        exec_log = log,
        generated_dir = generated_dir,
    )

def is_config_chain(flag) -> bool:
    """Whether `flag` chains to another section (`--config=<name>`), which is
    written verbatim rather than version-resolved."""
    return type(flag) == "string" and flag.startswith("--config=")

def startup_flags_for_rc(startup_flags: list) -> list:
    """Drop the rc-suppression startup flags, which are illegal inside an rc file.

    `runner_startup_flags` includes `--nohome_rc` and `--nosystem_rc` because the
    Workflows feature passes them as *command-line* startup flags to
    `aspect <task>`. Bazel rejects any `--no*_rc` option inside a bazelrc with a
    fatal `Can't specify --nosystem_rc in the .bazelrc file` (`--nohome_rc` would
    also be self-defeating — Bazel would be told to ignore the file importing
    this one). They only suppress *other* rc files, a command-line concern the
    generated rc cannot express, so they are dropped here."""
    _RC_SUPPRESSION_FLAGS = ["--nohome_rc", "--nosystem_rc", "--noworkspace_rc"]
    return [f for f in startup_flags if f not in _RC_SUPPRESSION_FLAGS]

def command_sections(bazel_version: str | None) -> list:
    """The rc command sections build flags go under: `common` on Bazel >= 6.3.0 or
    when the version is unknown (assume latest); `build` and `query` on older
    Bazel that has no `common` pseudo-command."""
    if bazel_version == None or version_gte(bazel_version, _COMMON_PSEUDO_COMMAND_MIN_VERSION):
        return ["common"]
    return _PRE_COMMON_COMMANDS

def render_bazelrc(startup_flags: list, enable_lines: list, command_sections: list, configs: list, header: str = GENERATED_HEADER) -> str:
    """Render the rc: `header`, a `startup` line per startup flag, the
    `--config` lines that turn groups on, then each `RcConfig` in `configs` as a
    commented `<section>:<name>` group.

    `enable_lines` pairs each enabled group with the command sections that
    enable it (`rc_groups.enable_lines`), since a group carrying an endpoint is
    turned on for build-like commands rather than for every command. Definitions
    are written once per entry in `command_sections` (`["common"]` on modern
    Bazel, `["build", "query"]` on Bazel < 6.3.0), so a `--config` naming one by
    hand works whatever the command. Flags may be `(flag, condition)` tuples
    (the shape `rc.expand` yields for surviving version-gated options); only the
    flag text is written."""
    lines = [
        header,
        "# Configures vanilla `bazel` calls to use Aspect services and recommended optimizations.",
        "# Flags are grouped by what they presume; the groups that apply here are enabled at the",
        "# top, the rest reached by chaining or by name. A group naming an endpoint is enabled for",
        "# `build`, which Bazel applies to test/run/coverage/cquery/aquery but not to `query`.",
        "# `bazel build --announce_rc` shows which group set what.",
        "",
    ]
    for flag in startup_flags:
        lines.append("startup " + flag_text(flag))
    for (group, sections) in enable_lines:
        for section in sections:
            lines.append(section + " --config=" + group)
    for config in configs:
        lines.append("")
        if config.comment:
            lines.append("# " + config.comment)
        for flag in config.flags:
            for section in command_sections:
                lines.append(section + ":" + config.name + " " + flag_text(flag))
    return "\n".join(lines) + "\n"

def prune_configs(configs: list, enabled: list) -> (list, list):
    """`configs` and `enabled` without the sections left empty by the user's
    omissions, and without the `--config=<name>` chains and enable lines that
    named them: Bazel fails on a `--config` no rc defines. Dropping a section can
    empty one that only chained to it, so this runs to a fixed point."""
    for _ in range(len(configs) + 1):
        dropped = [c.name for c in configs if not c.flags]
        if not dropped:
            break
        configs = [
            RcConfig(name = c.name, source = c.source, comment = c.comment, flags = [f for f in c.flags if not (is_config_chain(f) and f[len("--config="):] in dropped)])
            for c in configs
            if c.flags
        ]
        enabled = [name for name in enabled if name not in dropped]
    return (configs, enabled)

def import_line(generated_rc: str) -> str:
    """The line that pulls `generated_rc` into another rc. `try-import` rather
    than `import` so a generated file that later disappears degrades to no
    Aspect configuration instead of failing every `bazel` call. Bazel resolves
    the path as written except for a leading `%workspace%`, its one rc variable,
    so the caller passes `%workspace%/…` for a file in the checkout and an
    absolute path otherwise; a bare relative path would resolve against Bazel's
    working directory."""
    return "try-import " + generated_rc

def defined_configs(content: str | None) -> list:
    """The `--config` names an rc defines, in the order it defines them.

    Read off the `<command>:<name> <flag>` lines, which is how every `--config`
    section is spelled. Exact rather than assumed: a caller that means to *enable*
    a section someone else defined has to know it is really there, since Bazel
    fails outright on a `--config` no rc defines — it is not a `try-import`, which
    tolerates a file that has gone missing."""
    names = []
    for raw in (content or "").split("\n"):
        head = raw.strip().split(" ")[0]
        if raw.strip().startswith("#") or ":" not in head:
            continue
        name = head.split(":", 1)[1]
        if name and name not in names:
            names.append(name)
    return names

def ensure_import(existing: str | None, line: str) -> ImportResult:
    """The rc content with `line` present exactly once: unchanged when it is
    already there, otherwise placed at the top under `IMPORT_COMMENT`, a blank
    line apart from whatever the file already holds. At the top so the file's
    own lines come after the imported ones and win where they disagree — Bazel
    takes the last value of a flag — which is how a repository overrides a
    recommendation, say `--noremote_upload_local_results` for local work.
    `None`/empty `existing` is a new file."""
    block = IMPORT_COMMENT + "\n" + line + "\n"
    if not existing:
        return ImportResult(content = block, action = ImportAction("created"))
    if line in existing.split("\n"):
        return ImportResult(content = existing, action = ImportAction("unchanged"))
    content = block + ("\n" + existing.lstrip("\n") if existing.strip() else "")
    return ImportResult(content = content, action = ImportAction("prepended"))
