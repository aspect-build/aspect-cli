"""The rc file `aspect ci bazelrc` writes, as a document: how flags render into
sections, how the file announces itself, and how it is placed in a user's
`~/.bazelrc` through a single `try-import` line.

Nothing here decides *which* flags are written — `aspect_flags.axl`,
`rc_groups.axl`, and `deployment_rc.axl` do — only how startup flags, enabled
groups, and `RcConfig` sections become text, and how that text lands without
disturbing what a user or another setup step already put in their rc.

On Bazel >= 6.3.0 flags are emitted under `common` (applies to every command);
older Bazel has no `common` pseudo-command, so they're spelled out under `build`
(inherited by test/run/coverage/cquery/aquery/fetch/…) and `query` (the one
action-relevant command that doesn't inherit `build`). Every flag this file is
handed ungated is accepted by `query` on Bazel < 6.3.0, the only range that
branch runs in; flags later Bazel rejects on `query` are version-gated past it.
"""

load("@aspect//bazel/build_metadata.axl", "version_gte")
load("./aspect_flags.axl", "flag_name", "flag_text")

# Bazel gained the `common` pseudo-command in 6.3.0.
_COMMON_PSEUDO_COMMAND_MIN_VERSION = "6.3.0"
_PRE_COMMON_COMMANDS = ["build", "query"]

# First line of the generated rc. The prefix is also how a `~/.bazelrc` this
# command wrote whole is recognized later, so it must not change.
_GENERATED_HEADER_PREFIX = "# Generated by `aspect ci bazelrc`"
GENERATED_HEADER = _GENERATED_HEADER_PREFIX + " — do not edit; rewritten on every run."

# One `--config` section of the rc. `flags` are `str | (str, constraint)` like
# everywhere else; a plain `--config=<other>` entry chains to another section and
# is written as-is rather than version-resolved. `source` names what claims the
# section, for the collision error in `deployment_rc.axl`.
RcConfig = record(
    name = field(str),
    source = field(str),
    comment = field(str, default = ""),
    flags = field(list),
)

# What `ensure_import` did to the user rc.
ImportAction = enum("created", "unchanged", "appended", "replaced")

ImportResult = record(
    content = field(str),
    action = field(ImportAction),
)

def is_config_chain(flag) -> bool:
    """Whether `flag` chains to another section (`--config=<name>`), which is
    written verbatim rather than version-resolved."""
    return type(flag) == "string" and flag.startswith("--config=")

def startup_flags_for_rc(startup_flags: list) -> list:
    """Drop the rc-suppression startup flags, which are illegal inside an rc file.

    `runner_flags` includes `--nohome_rc` and `--nosystem_rc` because the
    Workflows feature passes them as *command-line* startup flags to
    `aspect <task>`. Bazel rejects any `--no*_rc` option inside a bazelrc with a
    fatal `Can't specify --nosystem_rc in the .bazelrc file` (`--nohome_rc` would
    also be self-defeating — Bazel would be told to ignore the file importing
    this one). They only suppress *other* rc files, a command-line concern the
    generated rc cannot express, so they are dropped here."""
    _RC_SUPPRESSION_FLAGS = ["--nohome_rc", "--nosystem_rc", "--noworkspace_rc"]
    return [f for f in startup_flags if f not in _RC_SUPPRESSION_FLAGS]

def command_sections(bazel_version: str | None) -> list:
    """The rc command sections build flags go under: `common` on Bazel >= 6.3.0 or
    when the version is unknown (assume latest); `build` and `query` on older
    Bazel that has no `common` pseudo-command."""
    if bazel_version == None or version_gte(bazel_version, _COMMON_PSEUDO_COMMAND_MIN_VERSION):
        return ["common"]
    return _PRE_COMMON_COMMANDS

def render_bazelrc(startup_flags: list, enabled: list, command_sections: list, configs: list) -> str:
    """Render the rc: the header, a `startup` line per startup flag, a
    `<section> --config=<group>` line per group in `enabled`, then each
    `RcConfig` in `configs` as a commented `<section>:<name>` group. Every
    section is written once per entry in `command_sections` (`["common"]` on
    modern Bazel, `["build", "query"]` on Bazel < 6.3.0). Flags may be
    `(flag, condition)` tuples (the shape `rc.expand` yields for surviving
    version-gated options); only the flag text is written."""
    lines = [
        GENERATED_HEADER,
        "# Configures vanilla `bazel` calls to use Aspect services and recommended optimizations.",
        "# Flags are grouped by what they presume; the groups on for this host are enabled here,",
        "# the rest are opt-in by name. `bazel build --announce_rc` shows which group set what.",
        "",
    ]
    for flag in startup_flags:
        lines.append("startup " + flag_text(flag))
    for group in enabled:
        for section in command_sections:
            lines.append(section + " --config=" + group)
    for config in configs:
        lines.append("")
        if config.comment:
            lines.append("# " + config.comment)
        for flag in config.flags:
            for section in command_sections:
                lines.append(section + ":" + config.name + " " + flag_text(flag))
    return "\n".join(lines) + "\n"

def prune_configs(configs: list, enabled: list) -> (list, list):
    """`configs` and `enabled` without the sections left empty by the user's
    omissions, and without the `--config=<name>` chains and enable lines that
    named them: Bazel fails on a `--config` no rc defines. Dropping a section can
    empty one that only chained to it, so this runs to a fixed point."""
    for _ in range(len(configs) + 1):
        dropped = [c.name for c in configs if not c.flags]
        if not dropped:
            break
        configs = [
            RcConfig(name = c.name, source = c.source, comment = c.comment, flags = [f for f in c.flags if not (is_config_chain(f) and f[len("--config="):] in dropped)])
            for c in configs
            if c.flags
        ]
        enabled = [name for name in enabled if name not in dropped]
    return (configs, enabled)

def import_line(generated_rc: str) -> str:
    """The line that pulls `generated_rc` into a user rc. `try-import` rather than
    `import` so a generated file that later disappears degrades to no Aspect
    configuration instead of failing every `bazel` call. The path is absolute:
    Bazel resolves an import as written unless it starts with `%workspace%`, so
    a relative one would resolve against Bazel's working directory."""
    return "try-import " + generated_rc

def strip_generated(existing: str, flag_names: list) -> str:
    """`existing` minus what this command wrote into it when it wrote the user rc
    whole: every comment line and every `startup` / `common` / `build` / `query`
    line — plain or `:<config>`-scoped — whose flag is in `flag_names`. Lines it
    cannot account for, another setup step's additions, stay, so only flags
    known to be ours are ever removed."""
    kept = []
    for line in existing.split("\n"):
        if line.startswith("#") or not line.strip():
            continue
        words = line.split(" ", 1)
        section = words[0].split(":")[0]
        if len(words) == 2 and section in ["startup", "common"] + _PRE_COMMON_COMMANDS and flag_name(words[1]) in flag_names:
            continue
        kept.append(line)
    return "\n".join(kept) + ("\n" if kept else "")

def ensure_import(existing: str | None, line: str, flag_names: list) -> ImportResult:
    """The user rc content with `line` present exactly once: unchanged when it is
    already there, appended after the existing content otherwise. A file this
    command once wrote whole (it opens with the generated header) first has that
    output stripped — see `strip_generated`, which takes `flag_names` — since its
    flags would otherwise stay in force beside the import. `None`/empty
    `existing` is a new file."""
    if not existing:
        return ImportResult(content = line + "\n", action = ImportAction("created"))
    if line in existing.split("\n"):
        return ImportResult(content = existing, action = ImportAction("unchanged"))
    action = ImportAction("appended")
    if existing.startswith(_GENERATED_HEADER_PREFIX):
        existing = strip_generated(existing, flag_names)
        action = ImportAction("replaced")
    content = (existing.rstrip("\n") + "\n" if existing.strip() else "") + line + "\n"
    return ImportResult(content = content, action = action)
