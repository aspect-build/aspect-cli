"""A task history record (`ctx.std.history`) in words: how a run ended,
when it started (in local time, `when`; a record's stamps are UTC) and how
long it took, its command line and its parts (`command_parts`), a line of
it for a list (`list_lines`) and the whole of it (`show_lines`), for
`aspect history` and the Dashboard's History screen.
"""

load("@std//time.axl", "local_offset_s")
load("./text.axl", "display_width", "printable")

_MAX_FAILURES_SHOWN = 20

def outcome(record) -> str:
    """How a run ended, in a word or two."""
    status = record.get("status", "")
    if status in ("running", "abandoned"):
        return status
    if record.get("error"):
        return "error"
    if record.get("cancelled"):
        return "cancelled"
    code = record.get("exit_code", 0)
    return "ok" if code == 0 else "exit %d" % code

def stamp_ms(stamp: str) -> int | None:
    """A record's UTC timestamp (`2026-11-21T15:39:39.143Z`) as milliseconds
    since 1970, or None for one it cannot read."""
    date, _, time = stamp.rstrip("Z").partition("T")
    parts = date.split("-")
    clock, _, fraction = time.partition(".")
    hms = clock.split(":")
    if len(parts) != 3 or len(hms) != 3 or not all([p.isdigit() for p in parts + hms]):
        return None
    y, m, d = int(parts[0]), int(parts[1]), int(parts[2])

    # Days from the civil date (Howard Hinnant's days_from_civil).
    y -= 1 if m <= 2 else 0
    era = y // 400
    yoe = y - era * 400
    doy = (153 * (m + (-3 if m > 2 else 9)) + 2) // 5 + d - 1
    days = era * 146097 + yoe * 365 + yoe // 4 - yoe // 100 + doy - 719468
    ms = int((fraction + "000")[:3]) if fraction.isdigit() else 0
    return ((days * 24 + int(hms[0])) * 60 + int(hms[1])) * 60000 + int(hms[2]) * 1000 + ms

def civil(day: int) -> tuple:
    """The `(year, month, day)` of a day counted from 1970-01-01 (Howard
    Hinnant's civil_from_days)."""
    z = day + 719468
    era = z // 146097
    doe = z - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = mp + 3 if mp < 10 else mp - 9
    return yoe + era * 400 + (1 if m <= 2 else 0), m, d

def _two(n: int) -> str:
    return ("0" if n < 10 else "") + str(n)

def local_parts(ms: int, offset: int | None = None) -> tuple:
    """A UTC instant `ms` in local time (`offset` seconds ahead of UTC, the
    machine's zone's then by default): `(day, HH:MM, seconds, offset)`, `day`
    counted from 1970-01-01."""
    offset = local_offset_s(ms) if offset == None else offset
    local = ms + offset * 1000
    day = local // 86400000
    second = (local % 86400000) // 1000
    return day, _two(second // 3600) + ":" + _two(second // 60 % 60), second % 60, offset

def when(stamp: str, offset: int | None = None) -> str:
    """An RFC 3339 UTC time in local time (`offset` seconds ahead of UTC,
    the machine's zone's then by default) with its offset, as `2026-11-27
    21:10:55 -08:00`; a stamp that does not read, as it is."""
    ms = stamp_ms(stamp)
    if ms == None:
        return stamp
    day, clock, seconds, offset = local_parts(ms, offset)
    y, m, d = civil(day)
    sign = "-" if offset < 0 else "+"
    off = abs(offset) // 60
    return "%d-%s-%s %s:%s %s%s:%s" % (y, _two(m), _two(d), clock, _two(seconds), sign, _two(off // 60), _two(off % 60))

def duration(ms: int) -> str:
    """A duration, `850ms`, `12.3s` or `4m05s`."""
    if ms < 1000:
        return "%dms" % ms
    if ms < 60000:
        return "%d.%ds" % (ms // 1000, ms % 1000 // 100)
    s = ms // 1000
    return "%dm%s" % (s // 60, _two(s % 60) + "s")

def took(record) -> str:
    """A run's duration (`duration`); empty while it runs."""
    ms = record.get("duration_ms")
    return duration(ms) if ms != None else ""

def command(record) -> str:
    """A run's command line, redacted, without the program."""
    argv = record.get("argv", [])
    return " ".join(["aspect"] + argv[1:]) if argv else ""

def task_name(record) -> str:
    """`<group> <kind>`, as typed."""
    task = record.get("task", {})
    return " ".join(task.get("group", []) + [task.get("kind", "")])

def command_parts(record) -> tuple:
    """`(label, flags)`, a run's command line as typed after `aspect`,
    redacted, in two: the task as typed and the patterns its builds were
    given (`bazel[].patterns`), each once, in order; then every other word,
    in order (its flags and their values). A run that started no build is
    all label."""
    words = record.get("argv", [])[1:]
    if not record.get("bazel"):
        return (" ".join(words), [])
    path = len([w for w in task_name(record).split(" ") if w])
    patterns = []
    for build in record.get("bazel", []):
        for p in build.get("patterns", []) or []:
            if type(p) == "string" and p not in patterns:
                patterns.append(p)
    label = words[:path]
    flags = []
    left = list(patterns)
    for w in words[path:]:
        if w in left:
            left.remove(w)
            label.append(w)
        else:
            flags.append(w)
    return (" ".join(label), flags)

def _pad(text: str, width: int) -> str:
    return text + " " * max(0, width - display_width(text))

def _printable(line: str) -> str:
    """`line` with every character that could drive a terminal or hide text
    (controls, bidi overrides, zero-width marks) written as its escape, so a
    recorded command line is shown rather than obeyed; a tab kept."""
    return printable(line, keep = "\t")

def list_lines(records: list, offset: int | None = None) -> list:
    """One line per record, in columns padded by what each cell shows (its
    `_printable` text's width), started in local time (`when`, `offset` as
    there)."""
    rows = [[_printable(cell) for cell in (r.get("task", {}).get("id", "")[:8], when(r.get("started", ""), offset), outcome(r), took(r), task_name(r), command(r))] for r in records]
    widths = [0, 0, 0, 0, 0]
    for row in rows:
        for i in range(5):
            widths[i] = max(widths[i], display_width(row[i]))
    return ["  ".join([_pad(row[i], widths[i]) for i in range(5)] + [row[5]]).rstrip() for row in rows]

def _flaky(failure: dict) -> bool:
    return bool(failure.get("flaky"))

def show_lines(record, offset: int | None = None) -> list:
    """One run, whole, its times local (`when`, `offset` as there), each
    line safe to draw (`_printable`). A flaky test's failed attempt is
    marked `~`; a failed test attempt without a kept log says how to keep
    one."""
    task = record.get("task", {})
    lines = [
        "Task      %s (%s)" % (task_name(record), task.get("name", "")),
        "ID        %s" % task.get("id", ""),
        "Command   %s" % command(record),
    ]
    ended = [outcome(record)]
    if took(record):
        ended.append(took(record))
    if record.get("conclusion"):
        ended.append(record["conclusion"])
    if record.get("error"):
        ended.append(record["error"])
    lines.append("Started   %s · %s" % (when(record.get("started", ""), offset), " · ".join(ended)))
    where = record.get("cwd", "")
    git = record.get("git")
    if git:
        where += " · %s%s%s" % (git.get("branch", "") + "@" if git.get("branch") else "", git.get("commit", "")[:12], " (dirty)" if git.get("dirty") else "")
    lines.append("Where     %s" % where)
    for link in record.get("links", []):
        lines.append("Link      %s: %s" % (link.get("label", ""), link.get("url", "")))
    dir = record.get("dir", "")
    for n, build in enumerate(record.get("bazel", [])):
        head = " ".join([build.get("command", "")] + build.get("patterns", []))
        code = build.get("exit_code")
        if code != None:
            head += " · exit %d" % code
        elif build.get("error"):
            head += " · " + build["error"]
        elif build.get("ended"):
            head += " · ended by a signal"
        elif record.get("status") in ("running", "abandoned"):
            head += " · " + record["status"]
        else:
            head += " · not waited for"
        lines.append("Bazel %d   %s" % (n + 1, head))
        summary = build.get("summary")
        if not summary:
            continue
        lines.append("          targets %d built, %d failed, %d skipped · tests %d passed, %d failed" % (
            summary.get("targets_built", 0),
            summary.get("targets_failed", 0),
            summary.get("targets_skipped", 0),
            summary.get("tests_passed", 0),
            summary.get("tests_failed", 0),
        ))
        failures = summary.get("failures", [])
        for f in failures[:_MAX_FAILURES_SHOWN]:
            mark = "~" if _flaky(f) else "✗"
            lines.append("          %s %s%s%s" % (mark, f.get("label", ""), ("  " + f["detail"]) if f.get("detail") else "", "  flaky, passed on a later attempt" if _flaky(f) else ""))
            for log in f.get("logs", []):
                lines.append("              %s/%s" % (dir, log))
            if f.get("kind") == "test" and not f.get("logs"):
                lines.append("              test log not kept (--history:test-logs=failed keeps them)")
        more = len(failures) - _MAX_FAILURES_SHOWN + summary.get("failures_not_listed", 0)
        if more > 0:
            lines.append("          … %d more" % more)
    if record.get("evicted"):
        lines.append("Files     removed %s; only this record is kept" % when(record["evicted"], offset))
    else:
        lines.append("Files     %s" % dir)
    return [_printable(line) for line in lines]
