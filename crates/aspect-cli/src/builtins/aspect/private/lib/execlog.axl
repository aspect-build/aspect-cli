"""Turn compact-execution-log entry ids back into paths, digests and action keys.

A raw entry is not usable on its own. A compact log is a stream of entries that
reference each other by id: a `spawn` says `input_set_id = 42`, an `input_set`
names `file` ids and nested set ids, and only a `file` carries the digest that
actually feeds Bazel's action key. So a hook handed one `spawn` entry knows the
label and the mnemonic and nothing about what went into it.

`resolver()` closes that gap for a consumer reading the log in order — which is
every `BazelTrait.exec_log_event` hook. Feed it every entry; it keeps the four
small id-keyed tables that make resolution possible and answers questions about
the spawns:

    res = execlog.resolver()
    def _on_entry(ctx, entry):
        res.observe(entry)                   # always, for every kind
        if type(entry.type) == "spawn":
            print(res.spawn_key(entry.type), res.inputs(entry.type))

`observe` is cheap: a couple of table writes for a file or an input set. The
kinds that carry their contents *inline* rather than by id — a `directory`
carries a `File` per tree member, a `runfiles_tree` carries its empty files —
render those contents as they are observed, which is work proportional to the
one entry and still nothing like a flatten. Resolution is the expensive half, so
it only happens when asked: flattening every input set in a 20 MB log expands to
gigabytes, and the whole point of keeping the tables is to be able to flatten the
handful of spawns a caller cares about instead. A hook that calls `inputs()` on
every spawn of a large build should expect to pay for it.

Ordering is what makes the streaming form correct: Bazel writes an entry before
anything references it, so by the time a spawn arrives every id it names is
already in the tables. A caller that reads a log out of order (or reads only part
of one) gets partial answers rather than wrong ones — an unresolvable id is
dropped, not guessed at.

Lifted from the two-pass `aspect execlog diff` implementation so the live path
and the offline path share one definition of a spawn's identity. The offline
diff needs more than this (a second pass, per-dimension differs); it keeps those
and loads the resolution from here.
"""

load("@std//hash.axl", "sha256")

# `type(entry.type)` for each `ExecLogEntry.type` variant. The same names
# `bazel.execution_log.iterator(kinds = [...])` accepts.
INVOCATION = "invocation"
FILE = "file"
DIRECTORY = "directory"
UNRESOLVED_SYMLINK = "unresolved_symlink"
INPUT_SET = "input_set"
RUNFILES_TREE = "runfiles_tree"
SPAWN = "spawn"
SYMLINK_ACTION = "symlink_action"
SYMLINK_ENTRY_SET = "symlink_entry_set"

# The kinds a resolver has to see for `inputs`/`tools` to be complete. A hook
# that wants resolution must ask the runtime for at least these, not just
# `["spawn"]` — the spawn alone carries no paths. `symlink_entry_set` is in the
# list because a `runfiles_tree` reaches its symlinks through one; a narrower
# list resolves to fewer inputs, never to wrong ones.
RESOLVER_KINDS = [FILE, DIRECTORY, UNRESOLVED_SYMLINK, INPUT_SET, SYMLINK_ENTRY_SET, RUNFILES_TREE, SPAWN]

Fingerprint = record(
    key = field(str),
    label = field(str),
    mnemonic = field(str),
    runner = field(str),
    cache_hit = field(bool),
    args_hash = field(str),
    env_hash = field(str),
    inputs_hash = field(str),
    tools_hash = field(str),
    platform_hash = field(str),
    overall = field(str),
)

def _hash(parts: list) -> str:
    h = sha256()
    for part in parts:
        h.update(str(part))

        # Length-prefixing would be tidier, but a NUL cannot appear in an
        # argv entry or an env name, so it is already unambiguous here.
        h.update("\x00")
    return h.hexdigest()

def _digest_of(payload) -> str:
    """The content hash a `file` entry carries, or `""` when it has none —
    which Bazel omits for empty files."""
    d = getattr(payload, "digest", None)
    return d.hash if d != None else ""

def _tables() -> struct:
    """The four id-keyed tables resolution reads, all empty.

    - `paths`: every id that names a path — a file, a tree artifact, a symlink,
      a runfiles tree. What makes an id addressable, so a spawn output or a
      `path_of()` can be answered.
    - `digests`: the content digest of a `file` id, and only of a `file` id.
    - `sets`: `id → (direct ids, transitive set ids)` for an id that reaches
      other ids — an `input_set`, a `symlink_entry_set`, a `runfiles_tree`.
    - `inline`: `id → ["path@content", ...]` for an id whose contents live on
      the entry itself rather than behind further ids. Rendered once, when the
      entry is observed, because the alternative is retaining the payload.

    An id can appear in several: a `runfiles_tree` is a path, a set of ids and a
    few inline lines at once.
    """
    return struct(paths = {}, digests = {}, sets = {}, inline = {})

def _queue(tables: struct, seen: dict, stack: list, ids: list) -> None:
    """Queue every id in `ids` that resolves against a table and is not queued.

    Filtering here rather than at pop time is what makes the table sizes a
    sufficient bound on the walk: an id no entry was ever written for — routine
    for a resolver fed a narrow `kinds=` list, which still sees set membership
    for kinds it never receives — costs nothing instead of an iteration.
    """
    for entry_id in ids:
        if entry_id not in seen and (entry_id in tables.sets or entry_id in tables.paths or entry_id in tables.inline):
            seen[entry_id] = True
            stack.append(entry_id)

def _flatten(tables: struct, root_id: int) -> list:
    """Resolve an input set id to a sorted list of `path@content` strings.

    One line per thing that feeds the action key, with the content of each thing
    after the `@`: a file's digest, a symlink's target path, a runfiles tree's
    layout flag, `""` for an empty file. A container contributes its own line
    *and* its contents, so a tree artifact lists both `out/tree@` and
    `out/tree/<member>@<digest>`, and nothing an action depends on is left to be
    inferred from a path alone.

    Iterative rather than recursive: input sets nest arbitrarily deep in a large
    repo, and a blown evaluation stack part-way through a log is a worse failure
    than a slow one.

    Termination and completeness both come from `seen`, which marks an id as
    *queued*: nothing is queued twice, and `_queue` only queues ids a table can
    answer for, so the walk pops at most once per distinct id the tables hold.
    That is what makes the table sizes a bound the walk cannot reach — the loop
    is a `while` in Starlark's clothing, not a cap, and truncating an input list
    is not among the things that can happen here. Cycles terminate for the same
    reason duplicates do.

    `root_id == 0` is Bazel's "no set", not set number zero: it means the spawn
    has no inputs, and resolves to the empty list.
    """
    if root_id == 0:
        return []

    seen = {root_id: True}
    stack = [root_id]
    out = []

    for _ in range(1 + len(tables.sets) + len(tables.paths) + len(tables.inline)):
        if not stack:
            break
        current = stack.pop()

        children = tables.sets.get(current)
        if children != None:
            direct, transitive = children
            _queue(tables, seen, stack, direct)
            _queue(tables, seen, stack, transitive)

        lines = tables.inline.get(current)
        if lines != None:
            out.extend(lines)
            continue

        path = tables.paths.get(current)
        if path != None:
            out.append(path + "@" + tables.digests.get(current, ""))

    if stack:
        fail("execlog: flattening input set %d left %d id(s) unwalked, so the table bound is wrong; this is a bug in execlog.axl" % (root_id, len(stack)))

    return sorted(out)

def _spawn_key(spawn, paths: dict) -> str:
    """The identity of an action across two builds, or across two tasks.

    Bazel gives no stable action id, so the primary output path stands in: it is
    unique within a build and identical between two builds of the same target,
    which is exactly the property a key needs. Outputs are ids into the entry
    table, except when Bazel could not resolve one and recorded the raw path
    instead.
    """
    for output in spawn.outputs:
        value = output.type
        if type(value) == "string":
            return value
        resolved = paths.get(value)
        if resolved != None:
            return resolved

    # A spawn with no usable output is rare (a failed action that produced
    # nothing). Falling back to the label keeps it addressable instead of
    # silently dropping it, at the cost of colliding with its siblings.
    return spawn.target_label + "!" + spawn.mnemonic

def _platform_properties(spawn) -> list:
    platform = spawn.platform
    if platform == None:
        return []
    return sorted([p.name + "=" + p.value for p in platform.properties])

def _fingerprint(spawn, tables: struct) -> Fingerprint:
    """Hash each dimension of the action key separately, then the whole.

    Separately because the per-dimension hashes are what let a reader say *why*
    two runs of an action differ; `overall` alone can only say that they do.
    """
    args_hash = _hash(spawn.args)
    env_hash = _hash(sorted([v.name + "=" + v.value for v in spawn.env_vars]))
    inputs_hash = _hash(_flatten(tables, spawn.input_set_id))
    tools_hash = _hash(_flatten(tables, spawn.tool_set_id))
    platform_hash = _hash(_platform_properties(spawn))

    return Fingerprint(
        key = _spawn_key(spawn, tables.paths),
        label = spawn.target_label,
        mnemonic = spawn.mnemonic,
        runner = spawn.runner,
        cache_hit = spawn.cache_hit,
        args_hash = args_hash,
        env_hash = env_hash,
        inputs_hash = inputs_hash,
        tools_hash = tools_hash,
        platform_hash = platform_hash,
        overall = _hash([args_hash, env_hash, inputs_hash, tools_hash, platform_hash]),
    )

def _as_map(flattened: list) -> dict:
    """`["a@dig", ...]` → `{"a": "dig", ...}`. Splits on the last `@` because a
    path may contain one and the content after it may not."""
    out = {}
    for item in flattened:
        path, _, digest = item.rpartition("@")
        out[path] = digest
    return out

def _resolver() -> struct:
    """A stateful id table fed one entry at a time. See the module docstring.

    The returned struct's methods close over one set of `_tables()` and an entry
    counter, which is reported by `entries()` and is not otherwise load-bearing.
    """
    tables = _tables()
    count = [0]

    def observe(entry) -> None:
        """Record whatever this entry contributes to the id tables. Call for
        every entry, of every kind."""
        count[0] += 1
        payload = entry.type
        if payload == None:
            return
        _record(type(payload), entry.id, payload, tables)

    def flatten(set_id: int) -> list:
        """Resolve one set id to its sorted `path@content` lines.

        A container resolves to its own line plus its contents, so a
        `runfiles_tree` id answers with every runfile it mounts and not just
        with the path it is mounted at. See `_flatten`.
        """
        return _flatten(tables, set_id)

    def inputs(spawn) -> list:
        """This spawn's inputs as sorted `path@content` lines — one per file,
        per tree-artifact member, per runfiles entry and per symlink that feeds
        the action key, each with the content that makes it identifiable after
        the `@`. A tree artifact and a runfiles tree contribute a line for
        themselves as well as one per member. See `_flatten`."""
        return _flatten(tables, spawn.input_set_id)

    def tools(spawn) -> list:
        """This spawn's tool inputs, in the same form as `inputs`."""
        return _flatten(tables, spawn.tool_set_id)

    return struct(
        observe = observe,
        entries = lambda: count[0],
        path_of = lambda entry_id: tables.paths.get(entry_id),
        digest_of = lambda entry_id: tables.digests.get(entry_id),
        spawn_key = lambda spawn: _spawn_key(spawn, tables.paths),
        flatten = flatten,
        inputs = inputs,
        tools = tools,
        outputs = lambda spawn: _outputs(spawn, tables.paths),
        fingerprint = lambda spawn: _fingerprint(spawn, tables),
    )

def _directory_lines(payload) -> list:
    """A tree artifact's own line, then one per member.

    `ExecLogEntry.Directory` carries a `File` per member — path relative to the
    directory, plus the digest — rather than a member id, so these are the only
    place a tree artifact's contents appear in the log. Prefixing each with the
    directory's own path is what Bazel's own reconstruction of the expanded log
    does.
    """
    lines = [payload.path + "@"]
    for member in payload.files:
        lines.append(payload.path + "/" + member.path + "@" + _digest_of(member))
    return lines

def _runfiles_lines(payload) -> list:
    """Everything a `runfiles_tree` carries that is not reachable by id.

    Its own line carries `legacy_external_runfiles`, the one piece of the tree's
    identity that is neither a member nor a path: it decides where external
    repositories are mounted, so two builds that disagree about it have
    different runfiles trees built from identical members.
    """
    lines = [payload.path + "@legacy_external_runfiles=" + str(payload.legacy_external_runfiles)]
    for name in payload.empty_files:
        lines.append(payload.path + "/" + name + "@")
    manifest = payload.repo_mapping_manifest
    if manifest != None:
        lines.append(manifest.path + "@" + _digest_of(manifest))
    return lines

def _symlink_entry_lines(payload, paths: dict) -> list:
    """One `name@target path` line per direct entry of a `symlink_entry_set`.

    The entries are a map from runfiles-relative name to artifact id, and the
    name is half of what the set contributes: the same file mounted under a
    different name is a different runfiles tree. Resolving the id here, rather
    than when the set is flattened, is the one place this module reads a path at
    observe time — safe for the same reason the whole streaming form is, since
    Bazel writes an entry before anything references it, and degrading to `""`
    for an id a partial log never carried.
    """
    return [name + "@" + paths.get(target_id, "") for (name, target_id) in payload.direct_entries.items()]

def _nonzero(ids: list) -> list:
    """`ids` without Bazel's `0`, which is the absence of a set rather than set
    number zero — an unset `symlinks_id` reads as 0."""
    return [entry_id for entry_id in ids if entry_id != 0]

def _record(kind: str, entry_id: int, payload, tables: struct) -> None:
    """Index whatever one entry contributes to the id tables.

    Takes `kind` as a string rather than reading it off `payload`, so it can be
    exercised without a real proto. Kinds absent here contribute no ids —
    `spawn`, `invocation` and `symlink_action` are read by callers rather than
    resolved against."""
    if kind == FILE:
        tables.paths[entry_id] = payload.path
        tables.digests[entry_id] = _digest_of(payload)
    elif kind == DIRECTORY:
        tables.paths[entry_id] = payload.path
        tables.inline[entry_id] = _directory_lines(payload)
    elif kind == UNRESOLVED_SYMLINK:
        tables.paths[entry_id] = payload.path
        tables.inline[entry_id] = [payload.path + "@" + payload.target_path]
    elif kind == INPUT_SET:
        tables.sets[entry_id] = (payload.input_ids, payload.transitive_set_ids)
    elif kind == SYMLINK_ENTRY_SET:
        tables.sets[entry_id] = (sorted(payload.direct_entries.values()), payload.transitive_set_ids)
        tables.inline[entry_id] = sorted(_symlink_entry_lines(payload, tables.paths))
    elif kind == RUNFILES_TREE:
        # A spawn names the tree, not the sets inside it, so the tree has to
        # resolve as if it were a set or every runfile drops out of the key.
        tables.paths[entry_id] = payload.path
        tables.sets[entry_id] = ([], _nonzero([payload.input_set_id, payload.symlinks_id, payload.root_symlinks_id]))
        tables.inline[entry_id] = _runfiles_lines(payload)

def _outputs(spawn, paths: dict) -> list:
    """Every output path this spawn declared, resolved where possible.

    An output is an id into the entry table, or the raw path Bazel recorded when
    it could not resolve one (a declared output that was missing or the wrong
    type). Both are paths to a reader, so both come back."""
    out = []
    for output in spawn.outputs:
        value = output.type
        if type(value) == "string":
            out.append(value)
            continue
        resolved = paths.get(value)
        if resolved != None:
            out.append(resolved)
    return out

execlog = struct(
    resolver = _resolver,
    as_map = _as_map,
    Fingerprint = Fingerprint,
    RESOLVER_KINDS = RESOLVER_KINDS,
    testonly_tables = _tables,
    testonly_flatten = _flatten,
    testonly_record = _record,
    testonly_fingerprint = _fingerprint,
    testonly_hash = _hash,
    testonly_spawn_key = _spawn_key,
    testonly_outputs = _outputs,
)
