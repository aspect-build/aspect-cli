"""Readers and matching for Bazel workspace ignore files."""

load("./path_utils.axl", "path_utils")

def _absolute_ignores(root: str, paths: list[str]) -> list[str]:
    result = []
    for path in paths:
        path = path_utils.normalize_separators(path.strip())
        if not path or path.startswith("#") or path_utils.is_absolute(path):
            continue
        path = path.removeprefix("./").rstrip("/")
        if path and ".." not in path.split("/"):
            result.append(root.rstrip("/") + "/" + path)
    return result

def _read_bazelignore(fs, root: str) -> list[str]:
    """Read `.bazelignore` and return its ignored absolute path prefixes."""
    content = fs.try_read_to_string(root + "/.bazelignore")
    return _absolute_ignores(root, content.splitlines())

def _list_start_in_call(content: str, opening: int) -> int:
    """Find a direct positional or `dirs =` list argument."""
    depth = 1
    comment = False
    prefix = ""
    for i in range(opening + 1, len(content)):
        char = content[i]
        if comment:
            if char == "\n":
                comment = False
            continue
        if char == "#":
            comment = True
        elif char in ["'", '"']:
            return -1
        elif char == "(":
            depth += 1
        elif char == ")":
            depth -= 1
            if depth == 0:
                return -1
        elif char == "[" and depth == 1:
            return i if prefix in ["", "dirs="] else -1
        elif depth == 1 and not char.isspace():
            prefix += char
    return -1

def _list_ends_call(content: str, closing: int) -> bool:
    """Whether only an optional comma follows the list before `)`."""
    comment = False
    comma = False
    for i in range(closing + 1, len(content)):
        char = content[i]
        if comment:
            if char == "\n":
                comment = False
            continue
        if char == "#":
            comment = True
        elif char.isspace():
            continue
        elif char == "," and not comma:
            comma = True
        elif char == ")":
            return True
        else:
            return False
    return False

def _call_list_strings(content: str, name: str) -> list[str]:
    """Return string literals in the list passed to a top-level call."""
    quote = None
    triple = False
    escaped = False
    comment = False
    skip_until = 0
    call = -1
    for i in range(len(content)):
        if i < skip_until:
            continue
        char = content[i]
        if comment:
            if char == "\n":
                comment = False
            continue
        if quote != None:
            if triple and content[i:i + 3] == quote * 3:
                quote = None
                triple = False
                skip_until = i + 3
            elif not triple:
                if escaped:
                    escaped = False
                elif char == "\\":
                    escaped = True
                elif char == quote:
                    quote = None
            continue
        if char == "#":
            comment = True
            continue
        if content[i:i + 3] in ["'''", '"""']:
            quote = char
            triple = True
            skip_until = i + 3
            continue
        if char in ["'", '"']:
            quote = char
            continue
        if content[i:i + len(name)] == name:
            before = content[i - 1] if i > 0 else ""
            after = content[i + len(name)] if i + len(name) < len(content) else ""
            if (not before or not (before.isalnum() or before == "_")) and (not after or not (after.isalnum() or after == "_")):
                call = i + len(name)
                break
    if call < 0:
        return []

    opening = -1
    for i in range(call, len(content)):
        if content[i] == "(":
            opening = i
            break
        if not content[i].isspace():
            return []
    if opening < 0:
        return []

    list_start = _list_start_in_call(content, opening)
    if list_start < 0:
        return []

    result = []
    value = ""
    quote = None
    escaped = False
    comment = False
    expect_value = True
    for i in range(list_start + 1, len(content)):
        char = content[i]
        if comment:
            if char == "\n":
                comment = False
            continue
        if quote != None:
            if escaped:
                if char == "n":
                    value += "\n"
                elif char == "r":
                    value += "\r"
                elif char == "t":
                    value += "\t"
                else:
                    value += char
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == quote:
                result.append(value)
                value = ""
                quote = None
                expect_value = False
            else:
                value += char
            continue
        if char == "#":
            comment = True
        elif char in ["'", '"']:
            if not expect_value:
                return []
            quote = char
        elif char == ",":
            if expect_value:
                return []
            expect_value = True
        elif char == "]":
            return result if _list_ends_call(content, i) else []
        elif not char.isspace():
            return []
    return []

def _read_repo_bazel(fs, root: str) -> list[str]:
    """Read `REPO.bazel` and return absolute `ignore_directories` globs."""
    content = fs.try_read_to_string(root + "/REPO.bazel")
    return _absolute_ignores(root, _call_list_strings(content, "ignore_directories"))

def _is_ignored(path: str, prefixes: list[str], patterns: list[str] = [], is_directory: bool = False) -> bool:
    path = path_utils.normalize_separators(path).rstrip("/")
    for prefix in prefixes:
        prefix = path_utils.normalize_separators(prefix).rstrip("/")
        if path == prefix or path.startswith(prefix + "/"):
            return True
    candidates = path_utils.parents(path, nearest_first = True)
    if is_directory:
        candidates.insert(0, path)
    for pattern in patterns:
        pattern = path_utils.normalize_separators(pattern).rstrip("/")
        for candidate in candidates:
            if path_utils.glob_matches(pattern, candidate):
                return True
    return False

bazel_ignores = namespace(
    is_ignored = _is_ignored,
    read_bazelignore = _read_bazelignore,
    read_repo_bazel = _read_repo_bazel,
)
