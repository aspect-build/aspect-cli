"""Unit tests for `lib/delivery_scheduler.axl`."""

load("@aspect//bazel.axl", "bazel")
load("./delivery_scheduler.axl", "delivery_scheduler")

A = "//a:a"
B = "//b:b"
C = "//c:c"
D = "//d:d"

def _equal(actual, expected) -> None:
    if actual != expected:
        fail("expected %r, got %r" % (expected, actual))

def _entry(label: str) -> tuple:
    return (label, None, False, "digest")

def _labels(entries: list) -> list[str]:
    return [entry[0] for entry in entries]

def _fill(ready, running, selector = None, outcomes = {}, limit = 2, cancelled = lambda: False) -> str:
    return delivery_scheduler.fill(ready, running, limit, selector, outcomes, lambda entry: entry, cancelled)

def _dispatcher(selector, limit = 2):
    return delivery_scheduler.new_dispatcher(limit, selector, lambda entry: entry, lambda: False)

def _policy(prerequisites: dict) -> typing.Callable:
    def select(ready: list[str], outcomes: dict) -> str | None:
        for label in ready:
            if all([outcomes.get(dep) in ["ok", "skip"] for dep in prerequisites.get(label, [])]):
                return label
        return None

    return select

def _fifo(ctx: TaskContext) -> None:
    ready = [_entry(B), _entry(A), _entry(C)]
    running = []
    _equal(_fill(ready, running), "")
    _equal(_labels(running), [B, A])
    _equal(_labels(ready), [C])
    _equal(_fill(ready, running, selector = lambda _r, _o: fail("no free slot")), "")

def _refill_without_batch_barrier(ctx: TaskContext) -> None:
    ready = [_entry(B), _entry(C), _entry(A), _entry(D)]
    running = []
    outcomes = {}
    select = _policy({B: [A], C: [A, B]})
    _equal(_fill(ready, running, select, outcomes), "")
    _equal(_labels(running), [A, D])
    running.pop(0)
    outcomes[A] = "ok"
    _equal(_fill(ready, running, select, outcomes), "")
    _equal(_labels(running), [D, B])
    running.pop(1)
    outcomes[B] = "ok"
    _equal(_fill(ready, running, select, outcomes), "")
    _equal(_labels(running), [D, C])
    _equal(ready, [])

def _temporarily_blocked(ctx: TaskContext) -> None:
    ready = [_entry(B)]
    running = [_entry(A)]
    calls = []

    def wait(ready, outcomes):
        calls.append(True)
        return None

    _equal(_fill(ready, running, wait, limit = 8), "")
    _equal(calls, [True])
    _equal(_labels(ready), [B])
    _equal(_labels(running), [A])

def _empty_ready(ctx: TaskContext) -> None:
    _equal(_fill([], [_entry(A)], lambda _r, _o: fail("empty queue")), "")

def _snapshot_isolation(ctx: TaskContext) -> None:
    ready = [_entry(B), _entry(C)]
    outcomes = {A: "skip"}
    running = []

    def select(labels, results):
        labels.clear()
        labels.append("//outside:outside")
        results[A] = "fail"
        return C

    _equal(_fill(ready, running, select, outcomes, limit = 1), "")
    _equal(_labels(running), [C])
    _equal(_labels(ready), [B])
    _equal(outcomes, {A: "skip"})

def _invalid_selection(ctx: TaskContext) -> None:
    for invalid in ["//outside:outside", 1, [], {}]:
        ready = [_entry(A)]
        running = []
        message = _fill(ready, running, lambda _r, _o: invalid)
        _equal(message.startswith("scheduler_error: expected a ready label"), True)
        _equal(_labels(ready), [A])
        _equal(running, [])

def _no_duplicate_dispatch(ctx: TaskContext) -> None:
    ready = [_entry(A), _entry(B)]
    running = []
    message = _fill(ready, running, lambda _r, _o: A)
    _equal(message.startswith("scheduler_error:"), True)
    _equal(_labels(running), [A])
    _equal(_labels(ready), [B])

def _selector_exception(ctx: TaskContext) -> None:
    ready = [_entry(A)]
    running = []
    message = _fill(ready, running, lambda _r, _o: fail("policy bug"))
    _equal(message.startswith("scheduler_error: choose_next failed:"), True)
    _equal("policy bug" in message, True)
    _equal(_labels(ready), [A])
    _equal(running, [])

def _cancellation(ctx: TaskContext) -> None:
    ready = [_entry(A)]
    running = []
    _equal(_fill(ready, running, lambda _r, _o: fail("cancelled"), cancelled = lambda: True), "")
    _equal(running, [])
    cancelled = [False]

    def select(labels, outcomes):
        cancelled[0] = True
        return labels[0]

    _equal(_fill(ready, running, select, cancelled = lambda: cancelled[0]), "")
    _equal(running, [])
    _equal(_labels(ready), [A])

def _apparent_labels(ctx: TaskContext) -> None:
    seen = []

    def select(labels, outcomes):
        seen.append((list(labels), dict(outcomes)))
        return "//svc:svc" if outcomes.get("//base:base") == "ok" else None

    data = {"delivery": {"deliveries": [], "counts": {}}}
    outcomes = {}
    delivery_scheduler.record(data, outcomes, "//base", "ok")
    ready = [_entry("//svc")]
    running = []
    _equal(_fill(ready, running, select, outcomes), "")
    _equal(seen, [(["//svc:svc"], {"//base:base": "ok"})])
    _equal(_labels(running), ["//svc"])
    _equal(data["delivery"]["deliveries"][0]["label"], "//base")

def _prerequisite_outcomes(ctx: TaskContext) -> None:
    select = _policy({B: [A]})
    for outcome in ["ok", "skip", "warn", "fail", "pending", None]:
        ready = [_entry(B)]
        running = []
        outcomes = {A: outcome} if outcome != None else {}
        _equal(_fill(ready, running, select, outcomes), "")
        _equal(_labels(running), [B] if outcome in ["ok", "skip"] else [])

def _authoritative_outcomes(ctx: TaskContext) -> None:
    data = {"delivery": {"deliveries": [], "counts": {}}}
    outcomes = {}
    delivery_scheduler.record(data, outcomes, A, "fail", message = "exit 1", output_sha = "abc", is_forced = True)
    entry = data["delivery"]["deliveries"][0]
    _equal(entry["message"], "exit 1")
    _equal(entry["output_sha"], "abc")
    _equal(entry["is_forced"], True)
    entry["outcome"] = "ok"
    entry["label"] = "mutated"
    _equal(outcomes, {A: "fail"})
    _equal(data["delivery"]["counts"], {"fail": 1})

def _dispatcher_skips_unchanged_state(ctx: TaskContext) -> None:
    calls = []

    def select(labels, outcomes):
        calls.append(len(outcomes))
        return B if outcomes.get(A) == "ok" else None

    dispatcher = _dispatcher(select)
    ready = [_entry(B)]
    running = [_entry(A)]
    outcomes = {}
    for _ in range(5):
        _equal(dispatcher.fill(ready, running, outcomes), "")
    _equal(calls, [0])
    running.pop()
    outcomes[A] = "ok"
    _equal(dispatcher.fill(ready, running, outcomes), "")
    _equal(calls, [0, 1])
    _equal(_labels(running), [B])

    fifo = _dispatcher(None, limit = 1)
    ready = [_entry(A), _entry(B)]
    running = []
    _equal(fifo.fill(ready, running, {}), "")
    running.pop()
    _equal(fifo.fill(ready, running, {}), "")
    _equal(_labels(running), [B])

def _dispatcher_reports_error_once(ctx: TaskContext) -> None:
    dispatcher = _dispatcher(lambda _r, _o: fail("policy bug"))
    ready = [_entry(A)]
    running = []
    first = dispatcher.fill(ready, running, {})
    _equal(first.startswith("scheduler_error:"), True)
    _equal(dispatcher.error(), first)
    ready.append(_entry(B))
    _equal(dispatcher.fill(ready, running, {A: "ok"}), "")
    _equal(dispatcher.error(), first)
    _equal(running, [])

def _unstarted_reason(ctx: TaskContext) -> None:
    _equal(delivery_scheduler.unstarted_reason("scheduler_error: x", True), "scheduler_error: x")
    _equal(delivery_scheduler.unstarted_reason("", True), "cancelled: delivery did not start")
    _equal(delivery_scheduler.unstarted_reason("", False).startswith("scheduler_blocked:"), True)

def _plan(ctx: TaskContext) -> None:
    rc = ctx.bazel.new_rc()
    plan = delivery_scheduler.new_plan(["//a", "//a:a", B, "@@rules_x+//c:c"], ["//a"], rc, lambda _message: None)
    _equal(plan.candidates, [A, B, "@rules_x//c:c"])
    _equal(plan.selected, [A])
    _equal(plan.normalize_label("//svc"), "//svc:svc")

def _factory_results(ctx: TaskContext) -> None:
    calls = []
    plan = delivery_scheduler.new_plan([A, B], [A], ctx.bazel.new_rc(), lambda _message: None)

    def factory(ctx, received):
        calls.append(received)
        return lambda ready, outcomes: ready[0]

    message, select = delivery_scheduler.create(factory, ctx, plan)
    _equal(message, "")
    _equal(calls, [plan])
    _equal(select([A], {}), A)
    for value in [None, 1, "not a selector"]:
        message, select = delivery_scheduler.create(lambda _c, _p: value, ctx, plan)
        _equal(message.startswith("scheduler_planning_failed:"), True)
        _equal(select, None)
    message, select = delivery_scheduler.create(lambda _c, _p: fail("query failed"), ctx, plan)
    _equal("query failed" in message, True)
    _equal(select, None)

def _child(label, events, stdout_path = None, stderr_path = None):
    return (label, False, "digest", 0, struct(
        cancellation = struct(cancel = lambda: events.append("cancel " + label)),
        wait = lambda: events.append("wait " + label),
    ), stdout_path, stderr_path)

def _runs(events, done = False, wait = None):
    return struct(
        done = done,
        cancellation = struct(cancel = lambda: events.append("cancel build")),
        wait = wait or (lambda: events.append("wait build")),
    )

def _xl(on_entry):
    return struct(entries = [struct(type = "spawn")], hooks = [bazel.exec_log.Hook(on_entry = on_entry)], exact = True)

def _cleanup(ctx: TaskContext) -> None:
    events = []
    root = ctx.std.fs.mkdtemp()
    ctx.defer(lambda: ctx.std.fs.remove_dir_all(root))
    stdout_path = root + "/a.stdout"
    stderr_path = root + "/a.stderr"
    ctx.std.fs.write(stdout_path, "stdout")
    ctx.std.fs.write(stderr_path, "stderr")

    def wait_build():
        events.append("wait build")
        _equal(events, ["cancel build", "cancel A", "cancel B", "exec log", "wait A", "wait B", "wait build"])

    running = [_child("A", events, stdout_path, stderr_path), _child("B", events)]
    delivery_scheduler.cleanup(ctx, _runs(events, wait = wait_build), _xl(lambda _ctx, _entry: events.append("exec log")), running)
    _equal(ctx.std.fs.exists(stdout_path), False)
    _equal(ctx.std.fs.exists(stderr_path), False)

def _cleanup_after_completion(ctx: TaskContext) -> None:
    events = []
    delivery_scheduler.cleanup(ctx, _runs(events, done = True), _xl(lambda _ctx, _entry: events.append("exec log")), [])
    _equal(events, ["exec log", "wait build"])

def _cleanup_exec_log_failure(ctx: TaskContext) -> None:
    events = []
    root = ctx.std.fs.mkdtemp()
    ctx.defer(lambda: ctx.std.fs.remove_dir_all(root))
    stdout_path = root + "/failed.stdout"
    stderr_path = root + "/failed.stderr"
    ctx.std.fs.write(stdout_path, "stdout")
    ctx.std.fs.write(stderr_path, "stderr")

    def fail_hook(_ctx, _entry):
        events.append("exec log")
        fail("exec-log callback failed")

    running = [_child("A", events, stdout_path, stderr_path)]
    err, _ = catch(delivery_scheduler.cleanup, ctx, _runs(events), _xl(fail_hook), running)
    _equal(err != None, True)
    _equal("exec-log callback failed" in err.message, True)
    _equal(events, ["cancel build", "cancel A", "exec log", "wait A", "wait build"])
    _equal(ctx.std.fs.exists(stdout_path), False)
    _equal(ctx.std.fs.exists(stderr_path), False)

_TESTS = [
    _fifo,
    _refill_without_batch_barrier,
    _temporarily_blocked,
    _empty_ready,
    _snapshot_isolation,
    _invalid_selection,
    _no_duplicate_dispatch,
    _selector_exception,
    _cancellation,
    _apparent_labels,
    _prerequisite_outcomes,
    _authoritative_outcomes,
    _dispatcher_skips_unchanged_state,
    _dispatcher_reports_error_once,
    _unstarted_reason,
    _plan,
    _factory_results,
    _cleanup,
    _cleanup_after_completion,
    _cleanup_exec_log_failure,
]

def _test_impl(ctx: TaskContext) -> int:
    for test in _TESTS:
        test(ctx)
    print("delivery scheduler: OK (%d tests)" % len(_TESTS))
    return 0

delivery_scheduler_tests = task(
    summary = "Test delivery scheduler selection, dispatch and cleanup.",
    kind = "test-delivery-scheduler",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
