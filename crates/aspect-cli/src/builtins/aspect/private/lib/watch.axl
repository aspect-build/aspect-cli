"""Workspace file-watch session for `--watch` tasks."""

load("@std//time.axl", "sleep_iter")
load("./bazel_ignores.axl", "bazel_ignores")

# Workspace entries never worth a rebuild: VCS internals and bazel's
# convenience symlinks (bazel-bin, bazel-out,
# bazel-<workspace>, ...) — outputs live in the output base outside the
# workspace, but the symlinks themselves flicker during builds.
_IGNORE_NAMES = [".git", ".jj"]

def _absolute(ctx: TaskContext, path: str) -> str:
    if path.startswith("/") or path.startswith("\\\\") or (len(path) >= 3 and path[1] == ":" and path[2] in ["/", "\\"]):
        return path
    return ctx.std.env.current_dir() + "/" + path

def _ignores(root: str, symlink_prefix: str | None = None) -> list[str]:
    # `fs.watch` ignore prefixes must be absolute. Bazel's default convenience
    # symlink prefix is `bazel-`; `/` disables convenience symlinks entirely.
    prefix = "bazel-" if symlink_prefix == None else symlink_prefix
    paths = [root + "/" + name for name in _IGNORE_NAMES]
    if prefix != "/":
        workspace = root.rstrip("/").rsplit("/", 1)[-1]
        prefix = prefix.replace("%workspace%", workspace)
        prefix = prefix if prefix.startswith("/") else root + "/" + prefix
        paths.extend([prefix + suffix for suffix in ["bin", "out", "testlogs", workspace]])
    return paths

def _filter_batch(batch, root: str, ignored_paths: list[str], ignored_patterns: list[str], is_directory):
    events = []
    for event in batch.events:
        path = root + "/" + event.path
        directory = is_directory(path) if ignored_patterns else False
        if not bazel_ignores.is_ignored(path, ignored_paths, ignored_patterns, is_directory = directory):
            events.append(event)
    return struct(events = events, rescan = batch.rescan) if events or batch.rescan else None

def _new(ctx: TaskContext, rc = None, ignore: list[str] = [], cancellation: cancellation.Token | None = None) -> struct:
    """Start watching the bazel workspace. Returns a session:

      try_pop() → None | fs.WatchBatch — non-blocking; a settled batch of
          workspace changes.
      root — the watched workspace root.
      ignored_paths — absolute path prefixes excluded from the watch.
      ignored_patterns — absolute `REPO.bazel` globs excluded from the watch.
      cancellation — the token that ends the session: `loop` returns once it
          is cancelled, and a task's own tick loop checks it the same way.

    `cancellation` defaults to `ctx.cancellation.root`, so Ctrl+C ends the
    task the default way (exit 130). A task that owns the ending passes the
    token from `ctx.cancellation.notify()`: Ctrl+C then cancels only that
    token, the loop returns 0, and the task closes its surfaces itself.

    Additional ignore paths may be absolute or relative to the invocation
    directory. Bazel ignore files are read once; restart the watch session
    after changing them.
    """
    root = ctx.std.env.bazel_root_dir()
    extra_ignores = [_absolute(ctx, path) for path in ignore]
    symlink_prefix = rc.flag_value("--symlink_prefix", command = "build") if rc != None else None
    ignored_patterns = bazel_ignores.read_repo_bazel(ctx.std.fs, root)
    ignored_paths = (
        _ignores(root, symlink_prefix) +
        bazel_ignores.read_bazelignore(ctx.std.fs, root) +
        extra_ignores
    )
    w = ctx.std.fs.watch(root, ignore = ignored_paths)

    def is_directory(path):
        err, metadata = catch(ctx.std.fs.try_metadata, path, types = [std.io.Error])
        return err == None and metadata != None and metadata.is_dir

    def try_pop():
        batch = w.try_pop()
        if batch == None:
            return None
        return _filter_batch(batch, root, ignored_paths, ignored_patterns, is_directory = is_directory)

    return struct(
        cancellation = cancellation or ctx.cancellation.root,
        ignored_paths = ignored_paths,
        ignored_patterns = ignored_patterns,
        try_pop = try_pop,
        root = root,
    )

_TICK_MS = 100

def _run_pending(ws: struct, run_cycle) -> bool:
    """Run one cycle when a settled batch is ready, coalescing batches that
    were already queued before the cycle starts. Returns whether it ran."""
    if ws.try_pop() == None:
        return False
    for _ in range(1000):
        if ws.try_pop() == None:
            break
    run_cycle()
    return True

def _loop(ws: struct, run_cycle) -> int:
    """Re-run `run_cycle` on each settled batch of workspace changes — the
    simple watch shape for tasks whose cycle is just re-running a bazel
    command. Batches already queued when a cycle starts are coalesced into
    it; a failed cycle waits for the next change like any other.

    Runs until `ws.cancellation` is cancelled, then returns 0 (see `new`)."""
    for _tick in sleep_iter(_TICK_MS):
        if ws.cancellation.cancelled:
            return 0
        _run_pending(ws, run_cycle)
    return 0

watch = namespace(
    filter_batch = _filter_batch,
    ignores = _ignores,
    new = _new,
    loop = _loop,
    run_pending = _run_pending,
)
