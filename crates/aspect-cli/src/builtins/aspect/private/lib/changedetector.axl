"""Runfile restart decisions for `run --watch`."""

load("./path_helpers.axl", "path_helpers")

_MANIFEST_OUTPUT_GROUP = "aspect_watch_manifest"

# Expose the executable's native runfiles manifest as an aspect output group so
# AXL can receive its path through BES.
_WATCH_MANIFEST_BZL = """def _watch_manifest_impl(target, ctx):
    if DefaultInfo not in target:
        return []
    files_to_run = target[DefaultInfo].files_to_run
    if files_to_run == None or files_to_run.executable == None:
        return []
    manifest = getattr(files_to_run, "runfiles_manifest", None)
    if manifest == None:
        return []
    return [OutputGroupInfo(aspect_watch_manifest = depset([manifest]))]

watch_manifest = aspect(implementation = _watch_manifest_impl)
"""

def _aspect(ctx: TaskContext):
    return ctx.bazel.aspect(
        implementation = _WATCH_MANIFEST_BZL,
        symbol = "watch_manifest",
        output_groups = [_MANIFEST_OUTPUT_GROUP],
    )

def _execution_outputs(ctx: TaskContext, path: str) -> list[str]:
    """Return output paths from a complete decoded execution log file.

    Unlike the live iterator, the file sink applies backpressure and cannot
    drop entries. File/directory records are keyed by ID; spawn records refer
    to those IDs. Symlink actions carry their output path directly.
    """
    entries = bazel.build.execution_log.ExecLogEntry().parse_from_delimited(ctx.std.fs.open(path))
    paths_by_id = {}
    output_ids = []
    direct_paths = []
    for entry in entries:
        payload = entry.type
        if payload == None:
            continue
        kind = type(payload)
        if kind in ["file", "directory", "unresolved_symlink"]:
            paths_by_id[entry.id] = payload.path
        elif kind == "spawn":
            for output in payload.outputs:
                output_id = output.type

                # ExecLogEntry.Output's oneof is either an integer output ID or
                # a string invalid-output path.
                if type(output_id) == "int":
                    output_ids.append(output_id)
        elif kind == "symlink_action":
            direct_paths.append(payload.output_path)

    outputs = {path: True for path in direct_paths}
    for output_id in output_ids:
        path = paths_by_id.get(output_id)
        if path != None:
            outputs[path] = True
    return outputs.keys()

def _take_execution_outputs(ctx: TaskContext, path: str, successful: bool) -> list[str] | None:
    """Read and remove one build's execution log when Bazel created it.

    A failed build may exit before its file sink exists. A successful build
    without a log returns None so restart filtering remains conservative.
    """
    if not ctx.std.fs.exists(path):
        return None if successful else []
    outputs = _execution_outputs(ctx, path) if successful else []
    ctx.std.fs.remove_file(path)
    return outputs

def _manifest_unescape(value: str) -> str:
    """Decode Bazel's escaped runfiles-manifest field representation."""
    out = ""
    i = 0
    for _ in range(len(value) + 1):
        if i >= len(value):
            break
        c = value[i]
        i += 1
        if c != "\\" or i >= len(value):
            out += c
            continue
        escaped = value[i]
        i += 1
        if escaped == "s":
            out += " "
        elif escaped == "n":
            out += "\n"
        elif escaped == "b":
            out += "\\"
        else:
            out += "\\" + escaped
    return out

def _manifest_fields(line: str) -> tuple | None:
    if not line:
        return None
    escaped = line.startswith(" ")
    text = line[1:] if escaped else line
    split = text.find(" ")
    if split < 0:
        return (_manifest_unescape(text) if escaped else text, "")
    logical = text[:split]
    origin = text[split + 1:]
    if escaped:
        logical = _manifest_unescape(logical)
        origin = _manifest_unescape(origin)
    return (logical, origin)

def _origin_keys(origin: str, root: str) -> list[str]:
    """Forms by which watcher events or execution-log outputs name origin."""
    if not origin:
        return []
    origin = path_helpers.normalize(origin)
    root = path_helpers.normalize(root).rstrip("/")
    if not path_helpers.is_absolute(origin):
        # Relative manifest origins are runfiles symlink targets, not paths
        # reported by the workspace watcher or execution log.
        return []

    keys = {origin: True}
    if origin.startswith(root + "/"):
        keys[origin[len(root) + 1:]] = True

    # Execution-log paths are execroot-relative (`bazel-out/...` or
    # `external/...`) while manifests contain absolute physical paths.
    execroot_marker = "/execroot/"
    at = origin.find(execroot_marker)
    if at >= 0:
        rest = origin[at + len(execroot_marker):]
        slash = rest.find("/")
        if slash >= 0:
            keys[rest[slash + 1:]] = True
    external_marker = "/external/"
    at = origin.find(external_marker)
    if at >= 0:
        keys["external/" + origin[at + len(external_marker):]] = True
    return keys.keys()

def _parse_manifest(content: str, root: str) -> struct:
    """Parse a native runfiles manifest into logical entries and origin keys."""
    entries = {}
    origins = {}
    for line in content.splitlines():
        fields = _manifest_fields(line)
        if fields == None:
            continue
        logical, origin = fields
        entries[logical] = origin
        for key in _origin_keys(origin, root):
            origins.setdefault(key, []).append(logical)
    return struct(entries = entries, origins = origins)

def _source_info(origin: str, root: str) -> dict:
    """Incremental Build Protocol metadata for one manifest entry."""
    origin = path_helpers.normalize(origin)
    root = path_helpers.normalize(root).rstrip("/")
    info = {}
    if origin and not path_helpers.is_absolute(origin):
        info["is_symlink"] = True
    elif origin == root or origin.startswith(root + "/"):
        info["is_source"] = True
    return info

def _runfiles(manifest, root: str) -> dict | None:
    if manifest == None:
        return None
    return {logical: _source_info(origin, root) for logical, origin in manifest.entries.items()}

def _runfile_info(manifest, logical: str, root: str):
    if manifest == None:
        return None
    origin = manifest.entries.get(logical)
    if origin != None:
        return _source_info(origin, root)

    # Directory runfiles are represented by their root in the manifest, while
    # a change names the child below it. The child has the same source/symlink
    # classification as that root.
    for parent in path_helpers.parents(logical, nearest_first = True):
        origin = manifest.entries.get(parent)
        if origin != None:
            return _source_info(origin, root)
    return None

def _runfile_delta(current, logical_paths: list[str], removed_paths: list[str], root: str) -> dict:
    removed = {path_helpers.normalize(path): True for path in _runfiles_for_paths(removed_paths, current.origins)} if current != None else {}
    return {logical: None if logical in removed else _runfile_info(current, logical, root) for logical in logical_paths}

def _runfile_changes(previous, current, source_paths: list[str], removed_paths: list[str], output_paths: list[str] | None, root: str, rescan: bool = False) -> dict | None:
    changed = _changed_runfiles(previous, current, source_paths, output_paths, rescan = rescan)
    if changed == None:
        return None
    return _runfile_delta(current, changed, removed_paths, root)

def _manifest_path(paths: list[str]) -> str | None:
    for path in paths:
        # Depending on Bazel/platform, FilesToRunProvider surfaces either the
        # sibling `<executable>.runfiles_manifest` or the tree's `MANIFEST`.
        if path.endswith(".runfiles_manifest") or path.endswith("/MANIFEST"):
            return path
    return None

def _read_manifest(ctx: TaskContext, path: str | None, root: str):
    if path == None or not ctx.std.fs.exists(path):
        return None
    return _parse_manifest(ctx.std.fs.read_to_string(path), root)

def _paths_changed(paths: list[str], origins: dict) -> bool:
    """Whether any changed path equals or descends from a tracked origin."""
    for path in paths:
        path = path_helpers.normalize(path)
        if path in origins:
            return True

        # An origin may itself be a directory. Events name the changed child,
        # while manifests and execution logs name its root.
        for parent in path_helpers.parents(path, nearest_first = True):
            if parent in origins:
                return True
    return False

def _runfiles_for_paths(paths: list[str], origins: dict) -> list[str]:
    """Logical runfile paths backed by the changed physical paths."""
    changed = {}
    for path in paths:
        path = path_helpers.normalize(path)
        logicals = origins.get(path)
        if logicals != None:
            for logical in logicals:
                changed[logical] = True
            continue

        # A runfile origin may itself be a directory. Preserve the changed
        # child's suffix so future consumers can receive a precise delta.
        for parent in path_helpers.parents(path, nearest_first = True):
            logicals = origins.get(parent)
            if logicals != None:
                for logical in logicals:
                    changed[logical.rstrip("/") + "/" + path[len(parent) + 1:]] = True
                break
    return sorted(changed.keys())

def _changed_runfiles(previous, current, source_paths: list[str], output_paths: list[str] | None, rescan: bool = False) -> list[str] | None:
    """Changed logical runfile paths, or None when a precise delta is unsafe."""
    if previous == None or current == None:
        # Targets without a usable manifest cannot be filtered safely.
        return None
    if rescan:
        # The watcher lost events, so direct-source paths are unknowable.
        return None
    if output_paths == None:
        # A successful build without its execution log cannot be filtered.
        return None

    changed = {}
    for logical, origin in previous.entries.items():
        if current.entries.get(logical) != origin:
            changed[logical] = True
    for logical, origin in current.entries.items():
        if previous.entries.get(logical) != origin:
            changed[logical] = True
    for logical in _runfiles_for_paths(source_paths + output_paths, current.origins):
        changed[logical] = True
    return sorted(changed.keys())

def _outputs_changed(output_paths: list[str] | None, watched_paths: list[str], root: str) -> bool:
    """Whether executed actions changed a target default output."""
    if output_paths == None:
        return True
    origins = {}
    for watched_path in watched_paths:
        for key in _origin_keys(watched_path, root):
            origins[key] = True
    return _paths_changed(output_paths, origins)

def _entrypoint_state(ep) -> tuple | None:
    """Stable run state that can change without a spawn (the runinfo aspect
    writes args and environment with ctx.actions.write)."""
    if ep == None:
        return None
    return (
        ep.path,
        list(getattr(ep, "args", []) or []),
        dict(getattr(ep, "environment", {}) or {}),
        list(getattr(ep, "inherited_environment", []) or []),
        getattr(ep, "runfiles_dir", None),
        getattr(ep, "runfiles_workspace_dir", None),
    )

def _new(ctx: TaskContext, r: struct, target: str, root: str) -> struct:
    execution_log_dir = ctx.std.fs.mkdtemp(prefix = "aspect-run-watch-")
    ctx.defer(lambda: ctx.std.fs.remove_dir_all(execution_log_dir) if ctx.std.fs.exists(execution_log_dir) else None)

    state = {
        "entrypoint_before_build": None,
        "manifest": None,
        "restart_pending": False,
    }

    def read_current_manifest():
        paths = r.get_output_group_outputs(target, _MANIFEST_OUTPUT_GROUP)
        return _read_manifest(ctx, _manifest_path(paths), root)

    def begin_build():
        state["entrypoint_before_build"] = _entrypoint_state(r.determine_entrypoint(target))
        r.clear_default_outputs(target)
        r.clear_output_group_outputs(target, _MANIFEST_OUTPUT_GROUP)

    def capture_baseline():
        state["manifest"] = read_current_manifest()
        state["restart_pending"] = False

    def current_runfiles():
        return _runfiles(state["manifest"], root)

    def record_build_failure():
        state["restart_pending"] = True

    def changes(source_paths: list[str], removed_paths: list[str], execution_outputs: list[str] | None, rescan: bool = False) -> struct:
        """Return changes relevant to each watch-update strategy."""
        after = _entrypoint_state(r.determine_entrypoint(target))
        previous_manifest = state["manifest"]
        next_manifest = read_current_manifest()
        changes_unknown = state["restart_pending"]
        changed_runfiles = None
        if not changes_unknown:
            changed_runfiles = _runfile_changes(
                previous_manifest,
                next_manifest,
                source_paths,
                removed_paths,
                execution_outputs,
                root,
                rescan = rescan,
            )
        default_outputs_changed = _outputs_changed(
            execution_outputs,
            r.get_default_outputs(target),
            root,
        )
        state["manifest"] = next_manifest
        state["restart_pending"] = False
        return struct(
            changes_unknown = changes_unknown,
            outputs_changed = default_outputs_changed,
            restart_required = state["entrypoint_before_build"] != after,
            runfiles = changed_runfiles,
        )

    return struct(
        aspects = [_aspect(ctx)],
        changes = changes,
        execution_log_path = execution_log_dir + "/execution.binpb",
        begin_build = begin_build,
        capture_baseline = capture_baseline,
        current_runfiles = current_runfiles,
        record_build_failure = record_build_failure,
    )

changedetector = namespace(
    changed_runfiles = _changed_runfiles,
    entrypoint_state = _entrypoint_state,
    manifest_path = _manifest_path,
    new = _new,
    outputs_changed = _outputs_changed,
    parse_manifest = _parse_manifest,
    runfile_changes = _runfile_changes,
    runfiles = _runfiles,
    take_execution_outputs = _take_execution_outputs,
)
