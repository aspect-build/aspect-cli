"""Surface-rendered tips: non-fatal recommendations shown on the surface
the user is already looking at (check-run summary, PR comment) so the
product is self-documenting.

This is the implementation; the public authoring API (`add_tip`, the
`tip_*` built-ins, severities, surfaces, the `tip_suggestion` hook) is
documented on the facade `@aspect//tips.axl`. Functions here leave `ctx`
untyped so tests can pass a stub; the facade re-wraps with the typed
signature.

# Template types

The `type` field selects the engine for `title` / `body`:

  - `TIP_TEMPLATE_RAW`    — no interpolation (default; most bodies are
                            literal markdown with `{}` to keep verbatim).
  - `TIP_TEMPLATE_FORMAT` — `str.format(**vars)`.
  - `TIP_TEMPLATE_JINJA2` — Jinja2 over `vars` (scalars), `accumulate`
                            (each a deduped list, first seen first) and
                            `aggregates` (by name); re-rendered as they
                            grow.

# Feature-disabled behavior

When `Tips` is off, the trait's null-object defaults take over: `add_tip`
is a silent no-op and `collect_tips_sorted` returns []. Emit sites don't
need to probe — the data flow just goes quiet.

# Surface rendering

`collect_tips_sorted(ctx, surface = ...)` returns tips sorted by severity
(most urgent first, stable within a bucket), filtered to those allowed on
`surface`. Renderers pass their own surface id.

# The terminal

A tip prints as `TIP[id] <emoji> severity: title` with its body indented
two spaces (`terminal_tip_lines`), when its id's `show` says (see "When a
tip shows on the terminal"). `TIP[` sets a tip apart from Bazel's and the
CLI's own `INFO:` and `WARNING:` lines, and the severity's lowercase word,
as rustc writes `warning` and `note`, reads without colour. The emoji is
the status surfaces' but for a warning, 🟡 rather than ⚠️. When the task
ends, a line per id counts what was not printed, and a last tip,
`tips-hint` (itself silenceable), says how to silence a tip, on the
command line, in `.aspect/config.axl` or for yourself in
`~/.aspect/config.json`, and links the docs.

# Silencing

A tip is silenced by id, for a task, by the union of: `--tips:silence`, a
`config.axl`'s `ctx.features[Tips].args.silence` (the flag joins it rather
than replacing it, read with `ctx.args.configured`), and `tips.silence` in
the user's `~/.aspect/config.json` and in the repository's
`.aspect/config.json` (`{"tips": {"silence": ["<id>", ...]}}`; a `tips` or
`silence` of the wrong shape is a warning and is ignored whole, an entry
that is no tip id is a warning and dropped alone). The `config.axl` files
assign `silence` in turn, so the last one to (a `~/.aspect/config.axl`)
replaces the others' list; `configured` sees only it. An id that is
empty or holds whitespace or a comma (`checked_silence`) is a warning and
silences nothing. `silence_tip` / `unsilence_tip` write the user's file
only; `silenced_tips` says where each id comes from.

# Severities, most urgent first

GitHub's alerts' (without CAUTION, and TIP as SUGGESTION, since every tip
is a `TIP[id]`), with the status surfaces' emoji:

    TIP_WARNING     ⚠️  this run hit a problem that needs attention now (a
                    full disk, a crashed server). 🟡 on the terminal.
    TIP_IMPORTANT   📌  something the user needs to reach their goal (setup
                    a feature lacks).
    TIP_SUGGESTION  💡  advice for doing something better or more easily.
    TIP_NOTE        💬  worth knowing, even when skimming. `TIP_INFO` is an
                    alias of it.
"""

load("@aspect//bazel/trait.axl", "BazelTrait")
load("./ansi.axl", "ansi")
load("./links.axl", "CI_API_TOKEN_URL", "CLI_TIPS_SILENCE_URL")
load("./text.axl", "did_you_mean_then")

# ── Severity constants ───────────────────────────────────────────────

TIP_WARNING = "warning"
TIP_IMPORTANT = "important"
TIP_SUGGESTION = "suggestion"
TIP_NOTE = "note"
TIP_INFO = TIP_NOTE

_SEVERITY_ORDER = {
    TIP_WARNING: 0,
    TIP_IMPORTANT: 1,
    TIP_SUGGESTION: 2,
    TIP_NOTE: 3,
}

# The status surfaces' emoji, which a browser draws whole.
_SEVERITY_EMOJI = {
    TIP_WARNING: "⚠️",
    TIP_IMPORTANT: "📌",
    TIP_SUGGESTION: "💡",
    TIP_NOTE: "💬",
}

# Label paired with the emoji on each tip header (`💡 **SUGGESTION: title**`),
# so severity is legible even where the emoji doesn't render.
_SEVERITY_LABEL = {
    TIP_WARNING: "Warning",
    TIP_IMPORTANT: "Important",
    TIP_SUGGESTION: "Suggestion",
    TIP_NOTE: "Note",
}

# ── Template type enum ──────────────────────────────────────────────

TIP_TEMPLATE_RAW = "raw"
TIP_TEMPLATE_FORMAT = "format"
TIP_TEMPLATE_JINJA2 = "jinja2"

_VALID_TEMPLATE_TYPES = [TIP_TEMPLATE_RAW, TIP_TEMPLATE_FORMAT, TIP_TEMPLATE_JINJA2]

# ── When a tip shows on the terminal ─────────────────────────────────
#
# Per tip id, as the id's first tip says (`show`, `max_shown`, which a
# `tip_suggestion` hook can rewrite there; a tip rule emits by its own, so a
# hook changes how the rule's tips print, not how many it emits); status
# surfaces always render
# each tip's final state, whatever these say. What an id did not print is
# counted in one line at the end of the task, with the title of the last of
# it when it was emitted (not when it was only counted, like a rule's groups
# past `max_groups`, each of which counts as one tip; under `TIP_SHOW_EACH`
# a rule's dropped matches count instead). A hook that rewrites a rule's
# `show` keeps the rule's own emission, so the line counts what that
# emitted.
#
#   TIP_SHOW_EACH   every emit whose content changed, and every occurrence
#                   (a rule's match) even when it did not, prints, up to
#                   `max_shown` (0: no limit, though a rule keeps at most
#                   10000 of its matches' lines, then each group's last);
#                   the ones past it are counted.
#   TIP_SHOW_FIRST  the first emit prints; the id's other tips (other keys)
#                   are counted, or, when there are none, the line says what
#                   the printed one became.
#   TIP_SHOW_END    nothing prints until the end of the task, then each of
#                   the id's tips in its final state, up to `max_shown`; the
#                   tips past it are counted.
#
# A tip emitted after the end prints at once. A tip the Console's `tip`
# template hides (renders blank) is neither printed nor counted, and takes
# no `max_shown` slot.
TIP_SHOW_EACH = "each"
TIP_SHOW_FIRST = "first"
TIP_SHOW_END = "end"
_VALID_SHOW = [TIP_SHOW_EACH, TIP_SHOW_FIRST, TIP_SHOW_END]

# How many of an id's tips print before the rest are counted instead.
TIP_MAX_SHOWN = 20

# ── Surface allowlist ────────────────────────────────────────────────
#
# Each tip's `surfaces` list names the surfaces it may render on; empty
# means everywhere (`SURFACE_ALL`, the back-compat default). Each surface
# filters by passing its id to `collect_tips_sorted(ctx, surface = ...)`
# (the CLI path checks `SURFACE_CLI` inside `add_tip`). Names are verbose
# + host-qualified because they're customer-facing (`.aspect/config.axl`).
#
#   SURFACE_CLI                    the terminal, as each tip's `show` says
#   SURFACE_GITHUB_STATUS_CHECKS   GitHub check-run summary
#   SURFACE_BUILDKITE_ANNOTATIONS  Buildkite annotation
#   SURFACE_GITHUB_PR_SUMMARY      cross-task PR summary comment — the only
#                                  aggregate surface (same-(id,key) tips from
#                                  sibling tasks combine; see "Cross-task
#                                  accumulation").
#
# (GitLab commit statuses are too short to render a tip — no GitLab surface.)
SURFACE_CLI = "cli"

# The Dashboard's screen (`--dashboard`): a tip listing `SURFACE_CLI` but
# not this is the terminal's alone, kept out of the screen while it is up
# and in the task's output, so the scrollback has it where it happened.
SURFACE_DASHBOARD = "cli-dashboard"
SURFACE_GITHUB_STATUS_CHECKS = "github-status-checks"
SURFACE_BUILDKITE_ANNOTATIONS = "buildkite-annotations"
SURFACE_GITHUB_PR_SUMMARY = "github-pr-summary"

# Per-task screens (excludes the aggregate PR summary). Set
# `surfaces = TASK_SCREENS` for a tip that should never enter the
# cross-task rollup.
TASK_SCREENS = [SURFACE_CLI, SURFACE_DASHBOARD, SURFACE_GITHUB_STATUS_CHECKS, SURFACE_BUILDKITE_ANNOTATIONS]

# Aggregate screen(s) — just the PR summary today; a list so
# `surfaces = AGGREGATE_SCREENS` reads symmetrically for a rollup-only tip.
AGGREGATE_SCREENS = [SURFACE_GITHUB_PR_SUMMARY]

# Every surface; the default for an unrestricted tip.
SURFACE_ALL = TASK_SCREENS + AGGREGATE_SCREENS

_VALID_SURFACES = SURFACE_ALL

def tip_shows_on(tip, surface):
    """True iff `tip` may render on `surface`. Empty `surfaces` → all
    surfaces (back-compat); otherwise an allowlist. `surface = None`
    (unfiltered collect) always passes."""
    if surface == None:
        return True
    allowed = tip.get("surfaces") or []
    if not allowed:
        return True
    return surface in allowed

# ── Tip identity: (id, key) ──────────────────────────────────────────
#
# A tip is identified by `(id, key)`:
#   id  — kind + silence key; `--tips:silence=<id>` matches on `id`, so
#         silencing covers every `key` under it.
#   key — optional discriminator (default ""); same `id`, different `key`
#         are DISTINCT (coexist on a surface, separate PR-summary rows).
#         Use for "same kind, different subject" — e.g. one `flaky-test`
#         tip per failing target, all silenceable via `flaky-test`.
#
# Re-emitting the same `(id, key)` within a task REPLACES the stored tip
# (last content wins); `accumulate` fields union (deduped, first seen first) onto the
# prior. Across tasks, they combine per `combine_across_tasks`.

# ── Cross-task accumulation ──────────────────────────────────────────
#
# `combine_across_tasks` (default False): how same-(id,key) tips from
# different tasks combine in the PR-summary rollup.
#   False — each task stands alone; latest rendered content wins (one row);
#           `accumulate` NOT unioned across tasks.
#   True  — `accumulate` unioned across contributing tasks (deduped)
#           and re-rendered, surfacing the full cross-task set. One row.
# Rollup eligibility is governed by `surfaces` regardless of this flag — a
# tip omitting `SURFACE_GITHUB_PR_SUMMARY` never enters the rollup.

# ── tip_suggestion hook records ──────────────────────────────────────
#
# A `tip_suggestion` hook (on the public `TipsTrait`) fires on every
# `add_tip`, letting `config.axl` accept/reject/rewrite any tip — same
# shape as `repro_fix_suggestion` on `Phases`.

# `accept` keeps, `reject` drops (never stored/surfaced), `replace`
# overrides the set fields on the returned `TipSuggestion`.
TipAction = enum("accept", "reject", "replace")

# Passed to each `tip_suggestion` hook (alongside `ctx`); carries identity
# + content + policy so the hook can scope and rewrite. Fires on every
# `add_tip`, including accumulate re-emits.
TipInfo = record(
    # Task identity for hooks that scope by task. `task_kind` is the task
    # kind (the command); `task_path` is the joined group + kind.
    task_path = field(str),
    task_kind = field(str),
    task_group = field(list[str]),

    # The tip about to be stored. For JINJA2 tips `title`/`body` are EMPTY
    # (rendered after this hook), so scope JINJA2 by `id`/`key`/`type`.
    id = field(str),
    key = field(str),
    severity = field(str),
    title = field(str),
    body = field(str),
    type = field(str),
    surfaces = field(list[str], default = []),
    combine_across_tasks = field(bool),
    show = field(str, default = TIP_SHOW_EACH),
    max_shown = field(int, default = TIP_MAX_SHOWN),
)

# Verdict from a `tip_suggestion` hook. `action` required; other fields
# consulted only on `replace`, each `None` keeping the current value (so
# `replace` with all `None` == accept).
TipSuggestion = record(
    action = field(TipAction),
    severity = field(str | None, default = None),
    title = field(str | None, default = None),
    body = field(str | None, default = None),
    surfaces = field(list[str] | None, default = None),
    combine_across_tasks = field(bool | None, default = None),
    show = field(str | None, default = None),
    max_shown = field(int | None, default = None),
)

# Shared singletons for the no-argument verdicts (`return TIP_ACCEPT`);
# use `tip_replace(...)` for replace.
TIP_ACCEPT = TipSuggestion(action = TipAction("accept"))
TIP_REJECT = TipSuggestion(action = TipAction("reject"))

def tip_replace(
        severity: str | None = None,
        title: str | None = None,
        body: str | None = None,
        surfaces: list[str] | None = None,
        combine_across_tasks: bool | None = None,
        show: str | None = None,
        max_shown: int | None = None) -> TipSuggestion:
    """Build a `replace` `TipSuggestion`. Omitted fields keep the tip's
    current value. See `TipSuggestion` for field semantics."""
    if show != None and show not in _VALID_SHOW:
        fail("tip_replace: unknown show %r%s" % (show, did_you_mean_then(show, _VALID_SHOW, "; ", "valid: " + ", ".join(_VALID_SHOW))))
    if severity != None and severity not in _SEVERITY_ORDER:
        fail("tip_replace: unknown severity %r%s" % (severity, did_you_mean_then(severity, _SEVERITY_ORDER.keys(), "; ", "valid: " + ", ".join(_SEVERITY_ORDER.keys()))))
    return TipSuggestion(
        action = TipAction("replace"),
        severity = severity,
        title = title,
        body = body,
        surfaces = surfaces,
        combine_across_tasks = combine_across_tasks,
        show = show,
        max_shown = max_shown,
    )

# ── Private trait — owner-feature implementation detail ────────────
#
# Every stored tip carries `{id, key, severity, title, body, type,
# surfaces, combine_across_tasks, show, max_shown}`; JINJA2 tips also carry
# `_title_src`, `_body_src`, `vars`, `accumulate` (dict<name, list>) and
# `aggregates`, with `_batch` and `_agg_base` (the aggregates of the batches
# before it) for re-rendering on accumulation. Same-`(id, key)` re-emit
# replaces the stored tip (accumulate unions and aggregates merge onto the
# prior); silenced ids are dropped on `add_tip`.
#
# When `Tips` isn't loaded the callable defaults are null-objects: `add` a
# no-op, `collect` []. Emit sites don't probe — disabled propagates as zero
# output.

_TipsTrait = trait(
    # Add a constructed tip dict. The owner closure handles silence check,
    # the `tip_suggestion` chain, (id,key) replace-with-accumulate dedup, and
    # the terminal print. Takes ctx for jinja2 + the print path.
    add = attr(typing.Callable[[TaskContext, dict], None], default = lambda ctx, t: None),

    # Raw insertion-ordered stored tips; `collect_tips_sorted` filters + sorts.
    collect = attr(typing.Callable[[], list], default = lambda: []),

    # The silenced ids, each with where it is silenced (`silence_sources`).
    silenced = attr(typing.Callable[[], dict], default = lambda: {}),

    # Mark `id` silenced (True) or not (False) from `source` for the rest of
    # the task; silencing drops its stored tips.
    set_silenced = attr(typing.Callable[[str, str, bool], None], default = lambda id, source, on: None),

    # Test seams — owner binds these; production code should not call them.
    _reset = attr(typing.Callable[[], None], default = lambda: None),
    _set_silenced = attr(typing.Callable[[list], None], default = lambda ids: None),
    _set_auto_print = attr(typing.Callable[[bool], None], default = lambda v: None),
    _set_sink = attr(typing.Callable[[typing.Callable], None], default = lambda fn: None),
    _finish = attr(typing.Callable[[TaskContext], None], default = lambda ctx: None),
)

# Public trait carrying the user `tip_suggestion` hook list, separate from
# `_TipsTrait` so users see only the hook surface. Users register from
# `.aspect/config.axl`:
#
#     ctx.traits[TipsTrait].tip_suggestion.append(my_hook)
#
# Each hook is `(ctx: TaskContext, info: TipInfo) -> TipSuggestion`, run on
# every `add_tip` by `apply_tip_suggestion_hooks`, in any task. `rules` apply
# to every Bazel build's console, in any task.
TipsTrait = trait(
    tip_suggestion = attr(list[typing.Callable[[TaskContext, TipInfo], TipSuggestion]], default = []),
    # Rules of a repository's own: `tip_rule(...)` values, appended from
    # config.axl or a feature. They join the built-in rules; an id used twice
    # fails. See "Tip rules" below.
    rules = attr(list, default = []),
)

# ── Tip rules ────────────────────────────────────────────────────────
#
# A tip rule pairs a tip with the condition that emits it. The tip is an
# ordinary `add_tip` one (id, severity, title, body, surfaces, show); `when`
# says what fires it. One kind of condition exists:
#
#   on_console_line(pattern)  a line of Bazel's console matches `pattern`
#                             (a regex, escape sequences stripped), an
#                             action's or a test's output included; never
#                             a row of Bazel's progress UI.
#
# The build/test handles aggregate each console rule's matches over every
# line of each Bazel invocation (`bazel.output.aggregate`), then emit the
# rule's tips once the console ends (`emit_rule_tips`). Matches split into
# groups by the `group_by` named captures, one tip per group (its `key`);
# each group's `aggregate` values, its `count`, and its first match's `line`
# and named captures are Jinja2 variables in the title and body. Under
# `show = TIP_SHOW_EACH` a tip is emitted per match instead, with that
# match's line and captures: the first `max_shown` matches, then each group's
# last; each group stores its last match's tip, which is what status
# surfaces show. A template that does not render is
# shown as written, with a warning.
# Aggregates merge across builds of a task and, with
# `combine_across_tasks`, across tasks in the PR summary.
#
# Silencing (`--tips:silence=<id>`), `--tips:surfaces` and `tip_suggestion`
# hooks apply as for any tip.

TipTrigger = record(
    kind = field(str),
    pattern = field(str, default = ""),
)

def on_console_line(pattern: str) -> TipTrigger:
    """Fire when a line of Bazel's console matches `pattern`."""
    return TipTrigger(kind = "console_line", pattern = pattern)

# How a rule aggregates one capture across a group's matches; made with
# `agg.*`. `capture` is a named group of the rule's pattern, or `line`.
TipAggregation = record(
    kind = field(str),
    capture = field(str, default = ""),
    max = field(int, default = 1000),
)

_AGG_KINDS = ["count", "unique", "all", "count_distinct", "count_by", "first", "last"]

def _agg_count() -> TipAggregation:
    """The group's matches."""
    return TipAggregation(kind = "count")

def _agg_unique(capture: str, max: int = 1000) -> TipAggregation:
    """The capture's distinct values, first seen first, up to `max`."""
    return TipAggregation(kind = "unique", capture = capture, max = max)

def _agg_all(capture: str, max: int = 1000) -> TipAggregation:
    """Every value of the capture, repeats included, up to `max`."""
    return TipAggregation(kind = "all", capture = capture, max = max)

def _agg_count_distinct(capture: str) -> TipAggregation:
    """How many distinct values the capture took."""
    return TipAggregation(kind = "count_distinct", capture = capture)

def _agg_count_by(capture: str, max: int = 1000) -> TipAggregation:
    """`{value: matches}`, most first: the first `max` distinct values seen,
    each counted exactly."""
    return TipAggregation(kind = "count_by", capture = capture, max = max)

def _agg_first(capture: str) -> TipAggregation:
    """The capture's first value."""
    return TipAggregation(kind = "first", capture = capture)

def _agg_last(capture: str) -> TipAggregation:
    """The capture's last value."""
    return TipAggregation(kind = "last", capture = capture)

agg = struct(
    count = _agg_count,
    unique = _agg_unique,
    all = _agg_all,
    count_distinct = _agg_count_distinct,
    count_by = _agg_count_by,
    first = _agg_first,
    last = _agg_last,
)

# Variables every rule tip's template has; an aggregate may not reuse them.
RULE_VARS = ["line", "count", "truncated"]

TipRule = record(
    id = field(str),
    when = field(TipTrigger),
    severity = field(str),
    title = field(str),
    body = field(str),
    # None or empty: the terminal only. A rule is promoted to the status
    # surfaces by naming them.
    surfaces = field(list[str] | None, default = None),
    # A line the rule must fire on; the built-in rules' test checks it.
    example = field(str, default = ""),
    group_by = field(list[str], default = []),
    aggregate = field(dict, default = {}),
    show = field(str, default = TIP_SHOW_EACH),
    max_shown = field(int, default = TIP_MAX_SHOWN),
    emit = field(typing.Callable | None, default = None),
    only_if = field(typing.Callable | None, default = None),
    combine_across_tasks = field(bool, default = False),
)

def tip_rule(
        id: str,
        when: TipTrigger,
        severity: str,
        title: str,
        body: str,
        surfaces: list[str] | None = None,
        example: str = "",
        group_by: list[str] = [],
        aggregate: dict = {},
        show: str = TIP_SHOW_EACH,
        max_shown: int = TIP_MAX_SHOWN,
        emit = None,
        only_if = None,
        combine_across_tasks: bool = False) -> TipRule:
    """A tip and the condition that emits it. `title` and `body` are Jinja2
    templates over `line`, `count`, `truncated`, the pattern's named groups
    (the group's first match's, or under `TIP_SHOW_EACH` each match's own)
    and the `aggregate` values. See "Tip rules" in this file."""
    if severity not in _SEVERITY_ORDER:
        fail("tip rule %r: unknown severity %r%s" % (id, severity, did_you_mean_then(severity, _SEVERITY_ORDER.keys(), "; ", "valid: " + ", ".join(_SEVERITY_ORDER.keys()))))
    for s in surfaces or []:
        if s not in _VALID_SURFACES:
            fail("tip rule %r: unknown surface %r%s" % (id, s, did_you_mean_then(s, _VALID_SURFACES, "; ", "valid: " + ", ".join(_VALID_SURFACES))))
    if show not in _VALID_SHOW:
        fail("tip rule %r: unknown show %r%s" % (id, show, did_you_mean_then(show, _VALID_SHOW, "; ", "valid: " + ", ".join(_VALID_SHOW))))
    if max_shown < 0:
        fail("tip rule %r: max_shown must be >= 0 (0: no limit), got %d" % (id, max_shown))
    for name, a in aggregate.items():
        if not hasattr(a, "kind") or a.kind not in _AGG_KINDS:
            fail("tip rule %r: aggregate %r must be an `agg.*(...)` value, got %r" % (id, name, a))
        if name in RULE_VARS or name in group_by:
            fail("tip rule %r: aggregate %r reuses a name the template already has (%s, or a group_by capture)" % (id, name, ", ".join(RULE_VARS)))
        if a.max < 1:
            fail("tip rule %r: aggregate %r: max must be >= 1, got %d" % (id, name, a.max))
    return TipRule(
        id = id,
        when = when,
        severity = severity,
        title = title,
        body = body,
        surfaces = surfaces,
        example = example,
        group_by = list(group_by),
        aggregate = dict(aggregate),
        show = show,
        max_shown = max_shown,
        emit = emit,
        only_if = only_if,
        combine_across_tasks = combine_across_tasks,
    )

def all_tip_rules(builtin: list, user: list) -> list:
    """`builtin` then `user` rules, failing on an id used twice."""
    seen = {}
    for r in builtin + user:
        if not hasattr(r, "when") or not hasattr(r, "id"):
            fail("TipsTrait.rules takes tip_rule(...) values, got %r" % (r,))
        if r.id in seen:
            fail("tip rule id %r is used twice: %r and %r" % (r.id, seen[r.id].title, r.title))
        seen[r.id] = r
    return builtin + user

# Most matches a `TIP_SHOW_EACH` rule with `max_shown = 0` keeps lines of.
_EACH_SAMPLES_UNLIMITED = 10000

def _aggregation_spec(a: TipAggregation) -> list:
    """`a` as `bazel.output.aggregate` takes it: `[kind, capture, max]`,
    with only the items its kind takes."""
    if a.kind == "count":
        return [a.kind]
    if a.kind in ["unique", "all", "count_by"]:
        return [a.kind, a.capture, a.max]
    return [a.kind, a.capture]

def rule_aggregation(rule: TipRule) -> struct:
    """What the console aggregates for `rule`: the arguments of its
    `bazel.output.aggregate` stage."""
    samples = 0
    if rule.show == TIP_SHOW_EACH:
        samples = rule.max_shown or _EACH_SAMPLES_UNLIMITED
    return struct(
        id = rule.id,
        pattern = rule.when.pattern,
        group_by = list(rule.group_by),
        aggregations = {name: _aggregation_spec(a) for name, a in rule.aggregate.items()},
        samples = samples,
    )

def _group_key(rule, key):
    """A group's tip `key`: its `group_by` values, in order."""
    return "\x1f".join([key.get(g, "") for g in rule.group_by])

def _group_aggregates(rule, group):
    """A group's aggregates for `add_tip`, its `count` included."""
    out = {"count": {"kind": "count", "value": group["count"], "truncated": False, "max": 0}}
    truncated = group.get("truncated") or []
    for name, a in rule.aggregate.items():
        out[name] = {"kind": a.kind, "value": group["values"].get(name), "truncated": name in truncated, "max": a.max}
    return out

def emit_rule_tips(ctx, rule: TipRule, report: dict, build, batch: str):
    """Emit `rule`'s tips from `report`, its `bazel.output.aggregate` stage's
    entry in `build.output_aggregates()`. `batch`, which must be unique
    among the task's builds, names the build, so its aggregates count once
    however many tips it emits. Nothing when the report counted nothing,
    or when `only_if(ctx, build)` says not to.

    `emit(ctx, build, groups)`, when the rule has one, decides the tips
    instead: it gets each group as `{"key", "line", "count", "values",
    "truncated"}` and returns dicts of `title`, `body` (Jinja2 over `vars`,
    by default the first group's `line`), and optionally `severity`, `key`
    and `vars`."""
    if not report or not report.get("count"):
        return
    if rule.only_if != None and not rule.only_if(ctx, build):
        return
    groups = report.get("groups") or []
    dropped_groups = report.get("dropped_groups") or 0
    common = dict(
        id = rule.id,
        type = TIP_TEMPLATE_JINJA2,
        surfaces = rule.surfaces or [SURFACE_CLI, SURFACE_DASHBOARD],
        combine_across_tasks = rule.combine_across_tasks,
        show = rule.show,
        max_shown = rule.max_shown,
        batch = batch,
        occurrence = True,
    )

    def _vars(group):
        v = dict(group.get("captures") or {})
        v.update(group.get("key") or {})
        v["line"] = group.get("line", "")
        return v

    if rule.emit != None:
        made = rule.emit(ctx, build, groups) or []
        for i, t in enumerate(made):
            data = dict(t.get("vars") or {})
            if "line" not in data:
                data["line"] = groups[0].get("line", "") if groups else ""
            add_tip(
                ctx,
                severity = t.get("severity", rule.severity),
                title = t.get("title", rule.title),
                body = t.get("body", rule.body),
                key = t.get("key", ""),
                vars = data,
                unshown_tips = dropped_groups if i == len(made) - 1 else 0,
                **common
            )
        return

    if rule.show == TIP_SHOW_EACH:
        # The first matches, as kept, then each group's last match when it
        # was not one of them, in match order: so every group's stored tip
        # is its last match's, and the last emit is the last match.
        matches = list(report.get("samples") or [])
        kept = {s["seq"]: True for s in matches}
        lasts = [g["last"] for g in groups if g.get("last") and g["last"]["seq"] not in kept]
        matches += sorted(lasts, key = lambda s: s["seq"])

        # Matches past those kept, a dropped group's included.
        unshown = report["count"] - len(matches)
        for i, s in enumerate(matches):
            group = groups[s["group"]]
            v = dict(group.get("key") or {})
            v.update(s.get("captures") or {})
            v["line"] = s.get("line", "")
            add_tip(
                ctx,
                severity = rule.severity,
                title = rule.title,
                body = rule.body,
                key = _group_key(rule, group.get("key") or {}),
                vars = v,
                aggregates = _group_aggregates(rule, group),
                unshown = unshown if i == len(matches) - 1 else 0,
                unshown_tips = dropped_groups if i == len(matches) - 1 else 0,
                **common
            )
        return

    for i, group in enumerate(groups):
        add_tip(
            ctx,
            severity = rule.severity,
            title = rule.title,
            body = rule.body,
            key = _group_key(rule, group.get("key") or {}),
            vars = _vars(group),
            aggregates = _group_aggregates(rule, group),
            unshown_tips = dropped_groups if i == len(groups) - 1 else 0,
            **common
        )

# ── Built-in tips ────────────────────────────────────────────────────
#
# Each built-in `tip_*(ctx, ...)` wraps `add_tip` with content baked in,
# exposing only the varying parts. The wire-up deciding *when* to fire
# (host detection, `ctx.traits`) lives in `lib/github.axl`; these own only
# the content. YAML constants below are at workflow-top-level indent so
# users can paste them above `jobs:` or re-indent per job.

GITHUB_TOKEN_ENV_YAML = """env:
  GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
"""

ID_TOKEN_PERMISSIONS_YAML = """permissions:
  id-token: write    # artifact uploads + PR summary comment aggregation
"""

# CI hosts where `ASPECT_API_TOKEN` is a documented Aspect integration —
# selects the host-specific advice + silence id.
AspectApiTokenHost = enum("github-actions", "buildkite", "circleci")

# Per-host wire-up advice + degraded-feature list (both differ by host;
# PR-summary aggregation is GHA-only). Keyed by each host's enum `.value`.
_ASPECT_API_TOKEN_HOST_DETAIL = {
    AspectApiTokenHost("github-actions").value: struct(
        degraded_features = "PR check-run creation and updates, and PR summary comment aggregation",
        host_advice = (
            "On GitHub Actions, pass the token to the " +
            "[aspect-build/setup-aspect]" +
            "(https://github.com/aspect-build/setup-aspect) action:\n\n" +
            "```yaml\n" +
            "- uses: aspect-build/setup-aspect@<commit-sha>\n" +
            "  with:\n" +
            "    aspect-api-token: ${{ secrets.ASPECT_API_TOKEN }}\n" +
            "```\n\n" +
            "Find the latest release's commit SHA on the " +
            "[setup-aspect releases page](https://github.com/aspect-build/setup-aspect/releases)."
        ),
    ),
    AspectApiTokenHost("buildkite").value: struct(
        degraded_features = "PR check-run creation and updates",
        host_advice = (
            "On Buildkite, provision `ASPECT_API_TOKEN` using any of the approaches in " +
            "[Buildkite's secrets docs](https://buildkite.com/docs/pipelines/security/secrets) " +
            "— aspect-cli reads it from the agent's secret store automatically."
        ),
    ),
    AspectApiTokenHost("circleci").value: struct(
        degraded_features = "PR check-run creation and updates",
        host_advice = (
            "On CircleCI, add `ASPECT_API_TOKEN` as a project environment variable or via a " +
            "[context](https://circleci.com/docs/contexts/); aspect-cli picks it up from the " +
            "job env."
        ),
    ),
}

def tip_add_aspect_api_token(ctx, host: AspectApiTokenHost):
    """Implementation of `tip_add_aspect_api_token`; see the public
    `@aspect//tips.axl` for the contract."""
    detail = _ASPECT_API_TOKEN_HOST_DETAIL[host.value]
    add_tip(
        ctx,
        id = "add-aspect-api-token-" + host.value,
        severity = TIP_IMPORTANT,
        title = "Set ASPECT_API_TOKEN to authenticate the Aspect Workflows GitHub App",
        body = (
            "aspect-cli authenticates GitHub API calls via the Aspect Workflows " +
            "GitHub App, which needs `ASPECT_API_TOKEN` (an API token from your " +
            "Aspect organization) provided to the CI job.\n\n" +
            "Without it, " + detail.degraded_features + " degrade. The task itself " +
            "completes regardless — only the GitHub-side surfaces are affected.\n\n" +
            "Issue an `ASPECT_API_TOKEN` from the Aspect Web UI " +
            "(see [Generate an Aspect API token](" + CI_API_TOKEN_URL + ")). " +
            detail.host_advice
        ),
    )

def tip_add_id_token_permission(ctx):
    """Implementation of `tip_add_id_token_permission`; see the public
    `@aspect//tips.axl` for the contract."""
    add_tip(
        ctx,
        id = "add-id-token-permission",
        severity = TIP_IMPORTANT,
        title = "Grant `id-token: write` to enable GitHub Actions artifact uploads",
        body = "aspect-cli is trying to upload an artifact via GitHub Actions' ArtifactService but the API needs an OIDC token (`ACTIONS_ID_TOKEN_REQUEST_TOKEN`) that GitHub only exposes to the job when `id-token: write` is granted. Without it, the artifact upload fails.\n\nWhich features depend on this varies by configuration. When enabled, the PR summary comment aggregator and test-log / BEP / profile artifact uploads all ride on the ArtifactService — any of those features will be affected until the permission is granted. The task itself completes regardless.\n\nAdd at the top level of the workflow (so every job inherits) or scope it to the specific job(s) that upload artifacts:\n\n```yaml\n" + ID_TOKEN_PERMISSIONS_YAML + "```",
    )

# ── API ──────────────────────────────────────────────────────────────

def _merge_accumulators(existing, incoming):
    """Merge `incoming` (dict<name, value>) into `existing` (dict<name,
    list>). Returns `(merged, changed)`; `changed` is True when a new value
    landed (callers re-render/re-print only then)."""
    merged = {name: list(values) for name, values in (existing or {}).items()}
    changed = False
    for name, value in (incoming or {}).items():
        if value == None or value == "":
            continue
        current = merged.get(name, [])
        if value in current:
            continue
        merged[name] = current + [value]
        changed = True
    return merged, changed

def merge_aggregate(a: dict, b: dict) -> dict:
    """`b`, an aggregate (`{"kind", "value", "truncated", "max"}`), merged
    onto `a` of the same kind: counts sum, `unique` unions, `all`
    concatenates, `count_by` adds per value, `first` keeps `a`'s, `last`
    takes `b`'s. A `count_distinct` sums, so a value seen in both counts
    twice. Lists stop at `max` and say so in `truncated`. Of two kinds
    (a rule changed between tasks), `b` wins."""
    kind = b.get("kind", a.get("kind"))
    if a.get("kind") != kind:
        return dict(b)
    mx = b.get("max") or a.get("max") or 1000
    av, bv = a.get("value"), b.get("value")
    truncated = bool(a.get("truncated") or b.get("truncated"))
    if kind == "count" or kind == "count_distinct":
        value = (av or 0) + (bv or 0)
    elif kind == "unique":
        value = list(av or [])
        for x in bv or []:
            if x in value:
                continue
            if len(value) < mx:
                value.append(x)
            else:
                truncated = True
    elif kind == "all":
        value = list(av or []) + list(bv or [])
        if len(value) > mx:
            value = value[:mx]
            truncated = True
    elif kind == "count_by":
        counts = dict(av or {})
        for k, n in (bv or {}).items():
            counts[k] = counts.get(k, 0) + n
        items = sorted(counts.items(), key = lambda kv: -kv[1])
        if len(items) > mx:
            items = items[:mx]
            truncated = True
        value = {k: n for k, n in items}
    elif kind == "first":
        value = av if av != None else bv
    else:
        value = bv if bv != None else av
    return {"kind": kind, "value": value, "truncated": truncated, "max": mx}

def merge_aggregates(a: dict, b: dict) -> dict:
    """`b`'s aggregates merged onto `a`'s, by name (`merge_aggregate`)."""
    out = dict(a or {})
    for name, x in (b or {}).items():
        out[name] = merge_aggregate(out[name], x) if name in out else dict(x)
    return out

def tip_render_data(vars, accumulate, aggregates) -> dict:
    """What a JINJA2 tip renders against: `vars`, then `accumulate`'s
    lists, then each aggregate's value by name, and `truncated`, the names
    of the aggregates that stopped at their `max`. Any of the three may be
    None."""
    data = dict(vars or {})
    data.update(accumulate or {})
    truncated = []
    for name, a in (aggregates or {}).items():
        data[name] = a.get("value")
        if a.get("truncated"):
            truncated.append(name)
    if aggregates:
        data["truncated"] = truncated
    return data

def add_tip(
        ctx,
        id: str,
        severity: str,
        title: str,
        body: str,
        type: str = TIP_TEMPLATE_RAW,
        key: str = "",
        vars: dict = {},
        accumulate: dict = {},
        surfaces: list = [],
        combine_across_tasks: bool = False,
        show: str = TIP_SHOW_EACH,
        max_shown: int = TIP_MAX_SHOWN,
        aggregates: dict = {},
        batch: str = "",
        unshown: int = 0,
        unshown_tips: int = 0,
        occurrence: bool = False):
    """Implementation of `add_tip`; `ctx` untyped so internal callers and
    tests can pass a stub context. See the public `@aspect//tips.axl`
    `add_tip` for the full contract. For the terminal's end-of-task line:
    `unshown` counts the occurrences this emit stands for that are never
    emitted themselves (a rule's matches past what it kept; summed across
    builds, and counted under `TIP_SHOW_EACH`), `unshown_tips` the tips
    (a rule's groups past `max_groups`; the most any build reports, counted
    in every mode), and `occurrence` says the emit is one occurrence even
    if its content did not change (a rule's match), not a refresh."""
    if severity not in _SEVERITY_ORDER:
        fail("unknown tip severity %r%s" % (severity, did_you_mean_then(severity, _SEVERITY_ORDER.keys(), "; ", "valid: " + ", ".join(_SEVERITY_ORDER.keys()))))
    if type not in _VALID_TEMPLATE_TYPES:
        fail("unknown tip template type %r%s" % (type, did_you_mean_then(type, _VALID_TEMPLATE_TYPES, "; ", "valid: " + ", ".join(_VALID_TEMPLATE_TYPES))))
    if show not in _VALID_SHOW:
        fail("tip %r: unknown show %r%s" % (id, show, did_you_mean_then(show, _VALID_SHOW, "; ", "valid: " + ", ".join(_VALID_SHOW))))
    if max_shown < 0:
        fail("tip %r: max_shown must be >= 0 (0: no limit), got %d" % (id, max_shown))
    for name, a in (aggregates or {}).items():
        if not hasattr(a, "get") or a.get("kind") not in _AGG_KINDS:
            kind = a.get("kind") if hasattr(a, "get") else None
            fail("tip %r: aggregate %r must be a dict with a `kind`%s" % (id, name, did_you_mean_then(kind, _AGG_KINDS, " from ", ", ".join(_AGG_KINDS))))
    if aggregates and type != TIP_TEMPLATE_JINJA2:
        fail("tip %r: aggregates need TIP_TEMPLATE_JINJA2" % id)
    surfaces_list = list(surfaces) if surfaces else []
    for s in surfaces_list:
        if s not in _VALID_SURFACES:
            fail("unknown tip surface %r%s" % (s, did_you_mean_then(s, _VALID_SURFACES, "; ", "valid: " + ", ".join(_VALID_SURFACES))))
    vars = dict(vars or {})
    accumulate = dict(accumulate or {})
    collision = [name for name in accumulate if name in vars]
    if collision:
        fail("tip %r: %r set in both vars and accumulate" % (id, collision))
    is_jinja2 = type == TIP_TEMPLATE_JINJA2
    if is_jinja2 and not ([v for v in accumulate.values() if v] or [v for v in vars.values() if v] or aggregates):
        fail("TIP_TEMPLATE_JINJA2 tip %r requires at least one non-empty `vars`, `accumulate` or `aggregates` value" % id)

    common = {
        "id": id,
        "key": key,
        "severity": severity,
        "type": type,
        "surfaces": surfaces_list,
        "combine_across_tasks": combine_across_tasks,
        "show": show,
        "max_shown": max_shown,
        "_unshown": unshown,
        "_unshown_tips": unshown_tips,
        "_occurrence": occurrence,
    }
    if is_jinja2:
        # Carry the JINJA2 source; the storage layer renders it into
        # `title` / `body` and keeps the source for later re-render.
        tip = dict(
            common,
            _title_src = title,
            _body_src = body,
            vars = vars,
            accumulate = accumulate,
            aggregates = dict(aggregates or {}),
            _batch = batch,
        )
    elif type == TIP_TEMPLATE_FORMAT and vars:
        tip = dict(common, title = title.format(**vars), body = body.format(**vars))
    else:
        tip = dict(common, title = title, body = body)
    ctx.traits[_TipsTrait].add(ctx, tip)

def collect_tips_sorted(ctx, limit = None, surface = None):
    """Return the task's tips filtered by `surface` (against each tip's
    `surfaces` allowlist) then sorted by severity (highest first, stable
    within a bucket).

    `surface` is the caller's id (e.g. `SURFACE_GITHUB_STATUS_CHECKS`);
    `None` (default) skips filtering. See `tip_shows_on`. Pass `limit` to
    cap the result for space-constrained surfaces. None for a task without
    the Tips trait.
    """
    if _TipsTrait not in ctx.traits:
        return []
    filtered = [t for t in ctx.traits[_TipsTrait].collect() if tip_shows_on(t, surface)]
    out = sorted(filtered, key = lambda t: severity_rank(t.get("severity")))
    if limit != None and limit >= 0:
        out = out[:limit]
    return out

def _id_list(id):
    return [id] if type(id) == "string" else list(id)

def silence_tip(ctx, id, path = None):
    """Silence tip `id` (one id, or a list) for this user: add it to
    `tips.silence` in `~/.aspect/config.json` (`path` names another file),
    so later runs drop it, and for the rest of this task, dropping its
    stored tips. One write for every id, locked and atomic, keeping every
    other key, so concurrent CLIs lose nothing; it creates the file when
    missing. Returns `None` when done, an id already silenced included,
    else why not as a string (an id that is empty or holds whitespace, a
    file that is read-only or not a JSON object or whose `tips` is not as
    written here, an I/O error); nothing is then written and the task is
    left as it was."""
    err = ctx.aspect.tips.silence(_id_list(id), path = path)
    if err == None:
        for one in _id_list(id):
            ctx.traits[_TipsTrait].set_silenced(one, SILENCED_BY_USER, True)
    return err

def unsilence_tip(ctx, id, path = None):
    """Undo `silence_tip`: remove `id` (one id, or a list) from
    `tips.silence` in `~/.aspect/config.json` (or `path`), as it writes,
    and from this task's user silences. It stays silenced while another
    source silences it (see `silenced_tips`). Returns `None` when done, an
    id not there included, else why not as a string, nothing written."""
    err = ctx.aspect.tips.unsilence(_id_list(id), path = path)
    if err == None:
        for one in _id_list(id):
            ctx.traits[_TipsTrait].set_silenced(one, SILENCED_BY_USER, False)
    return err

def silenced_tips(ctx):
    """The task's silenced tip ids, a dict of id to where each is silenced
    (`SILENCED_BY_FLAG`, `SILENCED_BY_CONFIG`, `SILENCED_BY_USER`,
    `SILENCED_BY_REPO`), in first-seen order. Empty when `Tips` is off."""
    return ctx.traits[_TipsTrait].silenced()

def severity_emoji(severity):
    """Emoji prefix for a tip's severity. Used by renderers."""
    return _SEVERITY_EMOJI.get(severity, _SEVERITY_EMOJI[TIP_NOTE])

def severity_label(severity):
    """Human-readable severity label (e.g. "Suggestion", "Warning"). Paired with
    `severity_emoji` so the tip reads even where the emoji may not."""
    return _SEVERITY_LABEL.get(severity, _SEVERITY_LABEL[TIP_NOTE])

def severity_rank(severity):
    """Sort rank for a severity — lower = more urgent. For cross-task
    aggregators that order tips without depending on the constant dict.
    Unknown severities sort after `TIP_NOTE`."""
    return _SEVERITY_ORDER.get(severity, 999)

def silence_hint_line(id):
    """Markdown `<sub>` silence-hint footer naming the tip's id and the
    silence knob. Returns `""` for blank ids. Shared by the check-run
    `TIPS_BLOCK` and PR-comment section so both stay aligned. It names the
    repository's knobs only: a CI run reads no developer's
    `~/.aspect/config.json`, so silencing there is the terminal's."""
    if not id:
        return ""
    return '<sub>_Silence by setting `ctx.features[Tips].args.silence = ["%s", ...]` in `.aspect/config.axl` (load `Tips` from `@aspect//feature/tips.axl`), or pass `--tips:silence=%s` on the command line._</sub>' % (id, id)

def tip_to_payload(t):
    """Project a stored tip into the render-only subset crossing the per-task
    artifact boundary (PR-comment aggregation). JINJA2 fields (`vars`,
    `accumulate`, `aggregates`, templates) are preserved so `_collect_tip_rows` can
    re-render against the unioned state. Carries `key` (group by `(id,
    key)`), `combine_across_tasks` (union accumulators across tasks), and
    `surfaces` (defensively re-assert the PR-summary gate)."""
    return {
        "id": t.get("id", ""),
        "key": t.get("key", ""),
        "severity": t.get("severity", ""),
        "title": t.get("title", ""),
        "body": t.get("body", ""),
        "type": t.get("type", ""),
        "_title_src": t.get("_title_src", ""),
        "_body_src": t.get("_body_src", ""),
        "vars": dict(t.get("vars") or {}),
        "accumulate": t.get("accumulate", {}) or {},
        "aggregates": dict(t.get("aggregates") or {}),
        "surfaces": list(t.get("surfaces") or []),
        "combine_across_tasks": t.get("combine_across_tasks", False),
    }

def decorate_tip(t):
    """Project a stored tip into the render-shape consumed by the surface
    templates (`TIPS_BLOCK` in `bazel_results.axl`, the `## Tips` section
    in `feature/github_status_comments.axl`) — single source of truth so both
    stay aligned. The PR-comment aggregator adds a `task_names` list for its
    "Surfaced by:" footer."""
    severity = t.get("severity")
    return {
        "id": t.get("id", ""),
        "severity": severity,
        "severity_emoji": severity_emoji(severity),
        "severity_label": severity_label(severity),
        "title": t.get("title", ""),
        "body_quoted": blockquote_body(t.get("body", "")),
        "silence_hint": silence_hint_line(t.get("id", "")),
    }

def strip_code_fences(body):
    """Drop Markdown code-fence delimiter lines so a tip body renders cleanly
    on the terminal; inner content is preserved. Surface (Markdown) rendering
    uses the unmodified body."""
    if not body:
        return body
    kept = []
    for line in body.split("\n"):
        if not line.strip().startswith("```"):
            kept.append(line)
    return "\n".join(kept)

# The theme's roles for a tip's first line: `TIP` one colour on every tip,
# so it reads as the CLI's, the id quiet, and each severity's lowercase word,
# the two to act on coloured and the two to let pass quieter.
_TERMINAL_TIP_LABEL_ROLE = "tip.label"
_TERMINAL_TIP_ID_ROLE = "tip.id"
_TERMINAL_TIP_ROLE = {
    TIP_WARNING: "tip.warning",
    TIP_IMPORTANT: "tip.important",
    TIP_SUGGESTION: "tip.suggestion",
    TIP_NOTE: "tip.note",
}

# The terminal's emoji, each wide by default (Emoji_Presentation): one made
# an emoji by VS16 (`⚠️`) is drawn one column wide by some terminals and two
# by others, so no width is right for it.
_TERMINAL_EMOJI = {
    TIP_WARNING: "🟡",
    TIP_IMPORTANT: "📌",
    TIP_SUGGESTION: "💡",
    TIP_NOTE: "💬",
}

def _tip_head(id, severity, title, color_on, console = None):
    """`TIP[id] <emoji> severity: title` as `console`'s `tip` slot renders it
    (`emoji` carries the emoji, `full` does not), or, with no console, as
    `emoji` does: `TIP` in `tip.label`, the id in `tip.id`, the severity's
    emoji, then its word lowercase in its role (`_TERMINAL_TIP_ROLE`), the
    title plain. Every style is empty unless `color_on`. An unknown severity
    reads as a note."""
    if severity not in _TERMINAL_TIP_ROLE:
        severity = TIP_NOTE
    style = lambda role: ansi.code(role, color_on)
    context = {
        "id": id,
        "severity": severity_label(severity).lower(),
        "emoji": _TERMINAL_EMOJI[severity],
        "title": title,
        "tip_style": style(_TERMINAL_TIP_LABEL_ROLE),
        "id_style": style(_TERMINAL_TIP_ID_ROLE),
        "highlight_style": style(_TERMINAL_TIP_ROLE[severity]),
        "highlight_reset": ansi.RESET if color_on else "",
    }
    if console != None:
        return console.render("tip", **context)
    c = context
    return "%sTIP%s%s[%s]%s %s %s%s%s: %s" % (
        c["tip_style"],
        c["highlight_reset"],
        c["id_style"],
        id,
        c["highlight_reset"],
        c["emoji"],
        c["highlight_style"],
        c["severity"],
        c["highlight_reset"],
        title,
    )

def terminal_tip_lines(id, severity, title, body, color_on = False, console = None):
    """A tip as the terminal shows it: its head (`_tip_head`), then its body
    indented two spaces, code fences stripped; nothing when the head renders
    blank."""
    head = _tip_head(id, severity, title, color_on, console)
    if not head:
        return []
    lines = [head]
    cleaned = strip_code_fences(body)
    if cleaned:
        for line in cleaned.rstrip("\n").split("\n"):
            lines.append("  " + line if line else "")
    return lines

def terminal_more_line(id, severity, title, more, color_on = False, console = None):
    """The end-of-task line for an id's `more` occurrences or tips not
    printed, and the title of the last of them, when there is one to name."""
    if title == None:
        return _tip_head(id, severity, "%d more" % more, color_on, console)
    return _tip_head(id, severity, "%d more; the last: %s" % (more, title), color_on, console)

def terminal_now_line(id, severity, title, color_on = False, console = None):
    """The end-of-task line for a `TIP_SHOW_FIRST` tip that changed after it
    printed: its title now."""
    return _tip_head(id, severity, "now: " + title, color_on, console)

# The id of the end-of-task tip saying how to open a link the macOS
# Terminal shows written out.
TERMINAL_APP_LINKS_ID = "terminal-app-links"

def terminal_app_links_tip(ctx, written: int):
    """In the macOS Terminal, which shows no clickable link, a note on how
    to open one at the end of the task, once its builds' consoles wrote
    `written` link URLs out (`build.output_links_written`)."""
    if written == 0:
        return
    add_tip(
        ctx,
        id = TERMINAL_APP_LINKS_ID,
        severity = TIP_NOTE,
        title = "Control+click a link and choose Open URL, or Cmd+double-click it, to open it",
        body = "The macOS Terminal doesn't make links clickable, so each one's URL is printed after it.\n" +
               "A file's URL opens in the editor `--console:file-hyperlink-format` names.",
        surfaces = [SURFACE_CLI],
        show = TIP_SHOW_END,
    )

# The id of the end-of-task line saying how to silence a tip.
TIPS_HINT_ID = "tips-hint"

def terminal_hint_lines(color_on = False, console = None):
    """The end-of-task `tips-hint` tip, on one line: how to silence a tip, by
    flag (its own id the example), in `.aspect/config.axl` or for this user
    in `~/.aspect/config.json`, files named to edit and so `unlinked`, and
    the docs."""
    title = "Silence a tip with `--tips:silence=<id>` (e.g. `--tips:silence=%s`) or in `%s`, or just for you in `%s`; see %s" % (
        TIPS_HINT_ID,
        ansi.unlinked(".aspect/config.axl"),
        ansi.unlinked("~/.aspect/config.json"),
        CLI_TIPS_SILENCE_URL,
    )
    return terminal_tip_lines(TIPS_HINT_ID, TIP_NOTE, title, "", color_on, console)

def _console(ctx):
    """`ctx`'s console, through whose `tip` slot a tip renders, or None for a
    context without one."""
    return ctx.console if hasattr(ctx, "console") else None

def blockquote_body(body):
    """Prefix every body line with `> ` (or `>` for blank) so it renders as a
    Markdown blockquote — the closest "box" on GHSC summaries and BK
    annotations. Code fences are preserved (GFM + BK both nest them in
    blockquotes correctly)."""
    if not body:
        return ""
    lines = body.split("\n")
    out = []
    for line in lines:
        if line == "":
            out.append(">")
        else:
            out.append("> " + line)
    return "\n".join(out)

# ── tip_suggestion hook application ──────────────────────────────────

def apply_tip_suggestion_hooks(ctx, tip: dict) -> dict | None:
    """Run `tip` through every `TipsTrait.tip_suggestion` handler.

    Internal (not re-exported). `ctx` is unannotated because `github.axl`'s
    detection tests drive this with a fake `ctx` struct; only `ctx.traits`
    and `ctx.task.{group,name}` are read.

    Returns the post-chain tip (with `replace` overrides), or `None` on
    reject. Handlers run in order, `reject` short-circuits; no-op when no
    handlers. Called on every `add_tip` including accumulate re-emits. For
    JINJA2 tips the hook runs before rendering, so `info.title`/`info.body`
    are empty and replacing them has no effect — scope JINJA2 by `id`/`key`/
    `type` and rewrite policy fields instead.
    """
    handlers = ctx.traits[TipsTrait].tip_suggestion
    if not handlers:
        return tip

    out = dict(tip)
    info_base = {
        "task_path": " ".join(list(ctx.task.group) + [ctx.task.kind]),
        "task_kind": ctx.task.kind,
        "task_group": list(ctx.task.group),
    }
    for handler in handlers:
        info = TipInfo(
            id = out["id"],
            key = out.get("key", ""),
            severity = out["severity"],
            title = out.get("title", ""),
            body = out.get("body", ""),
            type = out.get("type", ""),
            surfaces = list(out.get("surfaces") or []),
            combine_across_tasks = out.get("combine_across_tasks", False),
            show = out.get("show", TIP_SHOW_EACH),
            max_shown = out.get("max_shown", TIP_MAX_SHOWN),
            **info_base
        )
        verdict = handler(ctx, info)
        action = verdict.action.value
        if action == "reject":
            return None
        if action == "replace":
            if verdict.severity != None:
                out["severity"] = verdict.severity
            if verdict.title != None:
                out["title"] = verdict.title
            if verdict.body != None:
                out["body"] = verdict.body
            if verdict.surfaces != None:
                out["surfaces"] = list(verdict.surfaces)
            if verdict.combine_across_tasks != None:
                out["combine_across_tasks"] = verdict.combine_across_tasks
            if verdict.show != None:
                out["show"] = verdict.show
            if verdict.max_shown != None:
                out["max_shown"] = verdict.max_shown
    return out

# ── Owner feature — co-located with the trait so it can bind closures ─

def _surface_overrides(ctx, entries):
    """`{id: surfaces}` from `id=surface[,surface]` entries. A malformed
    entry or an unknown surface is left out with a warning: the feature runs
    for every task."""
    out = {}
    for e in entries:
        id, eq, names = e.partition("=")
        wanted = [n.strip() for n in names.split(",") if n.strip()]
        bad = [n for n in wanted if n not in _VALID_SURFACES]
        if not eq or not id or not wanted or bad:
            hint = did_you_mean_then(bad[0], _VALID_SURFACES, "", "") if bad else ""
            ctx.std.io.stderr.write(ansi.style("WARNING", ansi.WARNING_LABEL, ctx.std.io.stderr.color) + ": --tips:surfaces=%s is ignored: expected <id>=<surface>[,<surface>] with surfaces from %s%s\n" % (e, ", ".join(_VALID_SURFACES), hint))
            continue
        out[id] = wanted
    return out

# Where a tip is silenced: `--tips:silence`, a `config.axl`'s `silence` arg,
# the user's `~/.aspect/config.json` or the repository's `.aspect/config.json`.
SILENCED_BY_FLAG = "flag"
SILENCED_BY_CONFIG = "config"
SILENCED_BY_USER = "user"
SILENCED_BY_REPO = "repo"

def checked_silence(flag_ids, config_ids, is_id):
    """`(flag_ids, config_ids, warnings)`: the ids of each list that
    `is_id` (`ctx.aspect.tips.is_tip_id`) takes, and a warning for each it
    does not, which silences nothing, once per source and id. A comma's
    warning says how to give two ids there: repeat the flag
    (`--tips:silence=a,b` is one id), or split a `config.axl`'s entry into
    list items."""
    warnings = []

    def keep(ids, what, split):
        kept = []
        warned = {}
        for id in ids:
            if is_id(id):
                kept.append(id)
                continue
            if id in warned:
                continue
            warned[id] = True
            hint = "; " + split if "," in id else ""
            warnings.append("%s %r is not a tip id, so it silences nothing%s" % (what, id, hint))
        return kept

    flag = keep(flag_ids, "--tips:silence", "repeat the flag for each id (`--tips:silence=a --tips:silence=b`)")
    config = keep(config_ids, "a config.axl's Tips silence", 'split it into list items (`["a", "b"]`)')
    return flag, config, warnings

def silence_sources(flag_ids, config_ids, found):
    """The silenced ids, the union of every source: a dict of id to the
    sources that silence it, in first-seen order. `flag_ids` is the `silence`
    arg typed on the command line, `config_ids` the one a `config.axl`
    assigned (`ctx.args.configured`), each joining the other rather than
    replacing it; `found` is `ctx.aspect.tips.config_silence()`, the
    `config.json` files'."""
    sources = {}
    for ids, source in [
        (flag_ids, SILENCED_BY_FLAG),
        (config_ids, SILENCED_BY_CONFIG),
        (found.user, SILENCED_BY_USER),
        (found.repo, SILENCED_BY_REPO),
    ]:
        for id in ids:
            if source not in sources.setdefault(id, []):
                sources[id].append(source)
    return sources

def _born(born: dict, births: list, key):
    """Note when `key` was first seen (the next of `births`), if it is new."""
    if key not in born:
        born[key] = births[0]
        births[0] += 1

def _insert_born(items: list, item, born: dict, births: list, key_of):
    """Put `item` back into `items` before the first one first seen after
    it (`born`), at the end when none was."""
    n = born.get(key_of(item), births[0])
    for i, other in enumerate(items):
        if born.get(key_of(other), births[0]) > n:
            items.insert(i, item)
            return
    items.append(item)

def _tips_impl(ctx):
    """Owner feature impl. Holds the per-task tips, the silenced ids and
    what the terminal has shown in closure state. At bind time reads the
    `silence` / `auto_print` feature args, so config / `--tips:*` flags
    propagate, and the `config.json` files' `tips.silence`, warning about an
    invalid one; the silenced ids are the union (`silence_sources`).
    Registers the end of the task's terminal output (see `_finish`) as a
    post-task hook, so it runs however the task ended."""
    state = []

    # What silencing an id set aside: its stored tips, its `shows` entry and
    # whether it was in `order`, given back where they were when it is
    # unsilenced: by when each was first stored (`born`, `born_ids`), so
    # undoing several silences in any order keeps the original order.
    aside = {}
    born = {}
    born_ids = {}

    # The next birth number, apart from any tip's id or key.
    births = [0]

    found = ctx.aspect.tips.config_silence()
    for w in found.warnings:
        ctx.std.io.stderr.write(ansi.style("WARNING", ansi.WARNING_LABEL, ctx.std.io.stderr.color) + ": " + w + "\n")

    # `args.custom(...)` returns None when unset despite `default = []`;
    # coalesce defensively.
    flag_ids = (ctx.args.silence or []) if ctx.args.is_explicit("silence") else []
    flag_ids, config_ids, bad = checked_silence(flag_ids, ctx.args.configured("silence") or [], ctx.aspect.tips.is_tip_id)
    for w in bad:
        ctx.std.io.stderr.write(ansi.style("WARNING", ansi.WARNING_LABEL, ctx.std.io.stderr.color) + ": " + w + "\n")
    sources = silence_sources(flag_ids, config_ids, found)
    silenced = list(sources.keys())
    surfaces_for = _surface_overrides(ctx, ctx.args.surfaces or [])
    auto_print = [ctx.args.auto_print]  # boxed so test seam can mutate

    # The terminal, per id: in first-emit order, how it shows (`show`,
    # `max_shown` of its first tip), how many tips it printed and what (by
    # key), the occurrences `TIP_SHOW_EACH` did not print, the occurrences or
    # tips it was told would never be emitted (`unshown`), and its last emit.
    order = []
    shows = {}
    shown = {}
    printed = {}
    more = {}
    dropped = {}
    dropped_tips = {}
    last = {}
    held_last = {}
    finished = [False]
    warned = {}

    # The link URLs the task's builds' consoles wrote out, for the macOS
    # Terminal's tip.
    links_written = [0]

    def _count_links(_task_ctx, build):
        links_written[0] += build.output_links_written

    ctx.traits[BazelTrait].output_end.append(_count_links)

    sink = [print]  # boxed so the test seam can capture lines

    def _render_jinja2(call_ctx, tip, accumulate, aggregates):
        """Render `tip`'s `_title_src`/`_body_src` against `vars`,
        `accumulate` and `aggregates` (`tip_render_data`) and return the
        stored tip with rendered `title`/`body` and the merged state."""
        data = tip_render_data(tip.get("vars"), accumulate, aggregates)
        stored = dict(tip)
        stored["accumulate"] = accumulate
        stored["aggregates"] = aggregates
        stored["title"] = _jinja2(call_ctx, tip, tip["_title_src"], data)
        stored["body"] = _jinja2(call_ctx, tip, tip["_body_src"], data)
        return stored

    def _jinja2(call_ctx, tip, src, data):
        """`src` rendered, or, when it does not render, `src` itself with a
        warning once per id: a tip's template must not fail the task."""
        ok, text = call_ctx.template.try_jinja2(src, data = data)
        if ok:
            return text
        if tip["id"] not in warned:
            warned[tip["id"]] = True
            call_ctx.std.io.stderr.write(ansi.style("WARNING", ansi.WARNING_LABEL, call_ctx.std.io.stderr.color) + ": tip %r: its template does not render, so it is shown as written: %s\n" % (tip["id"], text))
        return src

    def _store(call_ctx, tip):
        """Materialize a freshly-emitted `tip` into stored form. JINJA2 tips
        seed each `accumulate` value into a single-entry list and render;
        pre-rendered tips store as-is."""
        if tip.get("type") == TIP_TEMPLATE_JINJA2:
            seeded = {name: [value] for name, value in tip["accumulate"].items() if value}
            stored = _render_jinja2(call_ctx, tip, seeded, dict(tip.get("aggregates") or {}))
            stored["_agg_base"] = {}
            return stored
        return dict(tip)

    def _merged_aggregates(existing, tip):
        """`(base, merged)`: the aggregates of the builds before this emit's
        batch, and those merged with this emit's. An emit of the batch the
        stored tip came from replaces that batch's share instead of adding
        to it, so a build counts once however many tips it emits."""
        batch = tip.get("_batch", "")
        if batch and existing.get("_batch") == batch:
            base = existing.get("_agg_base") or {}
        else:
            base = existing.get("aggregates") or {}
        return base, merge_aggregates(base, tip.get("aggregates") or {})

    def _print(lines):
        for line in lines:
            sink[0](line)

    def _on_emit(call_ctx, stored, changed, occurrence):
        """Print `stored` on the terminal, or count it for the end, as its
        id's `show` says. `occurrence`: the emit stands for one occurrence
        even when its content did not change (a rule's match), so it counts
        where a refresh would not. After `_finish`, a tip prints at once."""
        if not auto_print[0] or not tip_shows_on(stored, SURFACE_CLI):
            return
        id = stored["id"]
        if id not in shows:
            order.append(id)
            _born(born_ids, births, id)
            shows[id] = (stored.get("show", TIP_SHOW_EACH), stored.get("max_shown", TIP_MAX_SHOWN))
            shown[id] = 0
            printed[id] = {}
            more[id] = 0
        show, cap = shows[id]
        last[id] = stored
        if finished[0]:
            show = TIP_SHOW_EACH
        if show == TIP_SHOW_END or not (changed or occurrence):
            return
        key = stored.get("key", "")
        if show == TIP_SHOW_FIRST:
            if shown[id] == 0:
                _print_stored(call_ctx, stored, call_ctx.std.io.stderr.color)
            return
        if finished[0] or cap == 0 or shown[id] < cap:
            _print_stored(call_ctx, stored, call_ctx.std.io.stderr.color)
        elif _visible(call_ctx, stored):
            more[id] += 1
            held_last[id] = stored

    def _visible(ctx, stored):
        """Whether `stored` would print: its template does not hide it."""
        return _tip_head(stored["id"], stored["severity"], stored["title"], False, _console(ctx)) != ""

    def _print_stored(call_ctx, stored, color_on):
        id = stored["id"]
        lines = terminal_tip_lines(id, stored["severity"], stored["title"], stored["body"], color_on, _console(call_ctx))
        if call_ctx.std.term.taken and not tip_shows_on(stored, SURFACE_DASHBOARD):
            # The terminal's alone: kept for the scrollback the screen
            # leaves, never drawn on it.
            for line in lines:
                call_ctx.std.term.keep_output(line + "\n")
        else:
            _print(lines)
        if lines:
            shown[id] += 1

        # A tip its template hides is printed as nothing, so never "now:";
        # counted as more only if it is visible at the end.
        printed[id][stored.get("key", "")] = (stored["title"], stored["body"]) if lines else None

    def _finish(task_ctx):
        """The end of the task's terminal output, once: each `TIP_SHOW_END`
        id's tips in their final state, a line per id with what it did not
        print (`terminal_more_line`: for `TIP_SHOW_EACH` the occurrences, for
        the others the tips) or, for `TIP_SHOW_FIRST`, how its printed tip
        changed (`terminal_now_line`), then, when any tip was printed, how to
        silence a tip (`terminal_hint_lines`). A tip emitted after it prints at
        once."""
        if not auto_print[0] or finished[0]:
            return

        # Only on a task with the Tips trait: one without it (`history
        # list`) still ends here, and a tip hook reads the task's context.
        if _TipsTrait in task_ctx.traits:
            # A screen's scrollback writes out the URLs its builds' consoles
            # did not while it held the terminal.
            terminal_app_links_tip(task_ctx, links_written[0] + task_ctx.std.term.links_written)
        finished[0] = True
        color_on = task_ctx.std.io.stderr.color
        for id in order:
            show, cap = shows[id]
            tips_for = [t for t in state if t["id"] == id and tip_shows_on(t, SURFACE_CLI)]
            if not tips_for:
                continue
            if show == TIP_SHOW_END:
                # Up to `cap` shown: a tip its template hides takes no slot.
                for t in tips_for:
                    if cap != 0 and shown[id] >= cap:
                        break
                    _print_stored(task_ctx, t, color_on)

            # Not printed, or hidden when it was and since made visible.
            unprinted = [t for t in tips_for if printed[id].get(t.get("key", "")) == None and _visible(task_ctx, t)]
            occurrences, lost = dropped.get(id, 0), dropped_tips.get(id, 0)

            # What was never emitted counts only for an id something of
            # which its template shows.
            if not [t for t in tips_for if _visible(task_ctx, t)]:
                occurrences, lost = 0, 0
            if show == TIP_SHOW_EACH:
                # Occurrences: a dropped group's matches are among `dropped`
                # when the rule reported them, so its tips count only when
                # it did not. The last held back, as it now stands, when it
                # is still on the terminal.
                held = more[id] + occurrences + (0 if occurrences else lost)
                key = held_last[id].get("key", "") if id in held_last else None
                now = [t for t in tips_for if t.get("key", "") == key and _visible(task_ctx, t)]
                latest = now[0] if now else None
            else:
                held = len(unprinted) + lost
                latest = unprinted[-1] if unprinted else None
            if held:
                # The severity of what is counted: the tip named, else the
                # occurrence held as it was emitted, else the id's last
                # visible tip.
                visible = [t for t in tips_for if _visible(task_ctx, t)]
                counted = latest or (held_last.get(id) if show == TIP_SHOW_EACH else None) or (visible[-1] if visible else last[id])
                line = terminal_more_line(id, counted["severity"], latest["title"] if latest else None, held, color_on, _console(task_ctx))
                if line:
                    _print([line])
            elif show == TIP_SHOW_FIRST:
                now = [t for t in tips_for if printed[id].get(t.get("key", "")) not in [None, (t["title"], t["body"])] and _visible(task_ctx, t)]
                if now:
                    line = terminal_now_line(id, now[-1]["severity"], now[-1]["title"], color_on, _console(task_ctx))
                    if line:
                        _print([line])
        if any([shown[id] for id in order]) and TIPS_HINT_ID not in silenced:
            _print(terminal_hint_lines(color_on, _console(task_ctx)))

    def _add(call_ctx, tip):
        if tip["id"] in silenced:
            return

        # What the emit stands for that is never emitted counts whatever the
        # hooks do to the emit itself. Each build reports the occurrences it
        # did not emit; tips past `max_groups` are reported again by every
        # build that met them.
        id = tip["id"]
        dropped[id] = dropped.get(id, 0) + tip.get("_unshown", 0)
        dropped_tips[id] = max(dropped_tips.get(id, 0), tip.get("_unshown_tips", 0))
        if tip["id"] in surfaces_for:
            tip = dict(tip, surfaces = surfaces_for[tip["id"]])

        # Run the `tip_suggestion` chain: reject drops, replace rewrites.
        tip = apply_tip_suggestion_hooks(call_ctx, tip)
        if tip == None:
            return
        occurrence = tip.get("_occurrence", False)

        identity = (tip["id"], tip.get("key", ""))
        for i, existing in enumerate(state):
            if (existing["id"], existing.get("key", "")) != identity:
                continue

            # Re-emit of same (id, key): replace the stored tip, unioning
            # `accumulate` and merging `aggregates` onto the prior so the
            # running total carries across.
            if tip.get("type") == TIP_TEMPLATE_JINJA2:
                merged, _ = _merge_accumulators(existing.get("accumulate", {}), tip["accumulate"])
                base, aggregates = _merged_aggregates(existing, tip)
                refreshed = _render_jinja2(call_ctx, tip, merged, aggregates)
                refreshed["_agg_base"] = base
            else:
                refreshed = _store(call_ctx, tip)

            # Print only when rendered content changed, so a no-op re-emit
            # (e.g. a streaming loop) stays quiet.
            changed = (refreshed["title"], refreshed["body"]) != (existing.get("title"), existing.get("body"))
            state[i] = refreshed
            _on_emit(call_ctx, refreshed, changed, occurrence)
            return

        stored = _store(call_ctx, tip)
        state.append(stored)
        _born(born, births, (stored["id"], stored.get("key", "")))
        _on_emit(call_ctx, stored, True, occurrence)

    def _collect():
        return list(state)

    def _reset():
        # Clear in place: `state = []` would shadow the outer name; `.clear()`
        # mutates the list the other closures share. Test-only seam, so pin
        # auto_print False.
        state.clear()
        silenced.clear()
        sources.clear()
        order.clear()
        shows.clear()
        shown.clear()
        printed.clear()
        more.clear()
        dropped.clear()
        dropped_tips.clear()
        held_last.clear()
        last.clear()
        warned.clear()
        aside.clear()
        born.clear()
        born_ids.clear()
        births[0] = 0
        finished[0] = False
        sink[0] = print
        auto_print[0] = False

    def _set_silenced(ids):
        silenced.clear()
        sources.clear()
        for id in ids:
            silenced.append(id)
            sources[id] = [SILENCED_BY_FLAG]

    def _silenced():
        return {id: list(s) for id, s in sources.items()}

    def _set_silenced_from(id, source, on):
        """Add `source` to (`on`) or remove it from `id`'s sources. An id
        newly silenced has its stored tips set aside (`aside`), so neither a
        surface nor the end of the task shows them; one with no source left
        has them back, and shows again on every surface and at the end."""
        held = sources.get(id, [])
        if on and source not in held:
            sources[id] = held + [source]
        elif not on and source in held:
            held = [s for s in held if s != source]
            if held:
                sources[id] = held
            else:
                sources.pop(id)
        if id in sources and id not in silenced:
            silenced.append(id)
            aside[id] = ([t for t in state if t["id"] == id], shows.get(id), id in order)
            kept = [t for t in state if t["id"] != id]
            state.clear()
            state.extend(kept)
            if id in order:
                order.remove(id)
                shows.pop(id)
        elif id not in sources and id in silenced:
            silenced.remove(id)
            tips, show, ordered = aside.pop(id, ([], None, False))
            for t in tips:
                if t not in state:
                    _insert_born(state, t, born, births, lambda s: (s["id"], s.get("key", "")))
            if ordered and id not in order:
                _insert_born(order, id, born_ids, births, lambda i: i)
                shows[id] = show

    def _set_auto_print(v):
        auto_print[0] = v

    def _set_sink(fn):
        sink[0] = fn

    ctx.traits[_TipsTrait].add = _add
    ctx.traits[_TipsTrait].collect = _collect
    ctx.traits[_TipsTrait].silenced = _silenced
    ctx.traits[_TipsTrait].set_silenced = _set_silenced_from
    ctx.traits[_TipsTrait]._reset = _reset
    ctx.traits[_TipsTrait]._set_silenced = _set_silenced
    ctx.traits[_TipsTrait]._set_auto_print = _set_auto_print
    ctx.traits[_TipsTrait]._set_sink = _set_sink
    ctx.traits[_TipsTrait]._finish = _finish
    ctx.hooks.post_task(lambda task_ctx, _conclusion: _finish(task_ctx))

Tips = feature(
    display_name = "Tips",
    summary = "Collect and surface non-fatal tips on each task.",
    implementation = _tips_impl,
    enabled = True,
    args = {
        "silence": args.string_list(
            default = [],
            description = "Tip ids to suppress for this task. Set from config: `ctx.features[Tips].args.silence = [\"<id>\", ...]` after `load(\"@aspect//feature/tips.axl\", \"Tips\")`. Pass on CLI: `--tips:silence=<id>` (repeat for multiple; a comma is no separator, and an id holding one is a warning). The command line's ids join a config.axl's rather than replacing them, and both join `tips.silence` in ~/.aspect/config.json and in the repository's .aspect/config.json.",
        ),
        "surfaces": args.string_list(
            default = [],
            description = "Where a tip shows, by id: `<id>=<surface>[,<surface>]`, overriding the tip's own surfaces. Surfaces: " + ", ".join(_VALID_SURFACES) + ". Repeat for several tips.",
        ),
        "auto_print": args.boolean(
            default = True,
            description = "Print tips to the terminal, as each tip's `show` says. Set False to keep them off the terminal (tips still surface on rendered check-runs / PR comments).",
        ),
    },
)

# ── Public wrapper struct ────────────────────────────────────────────
#
# Consumers go through this; internal storage stays hidden (emit sites see
# only `tips.add` / `.collect`). Test seams are underscore-prefixed.

tips = struct(
    add = add_tip,
    collect = collect_tips_sorted,
    # Test seams — production code should not call.
    _reset_for_test = lambda ctx: ctx.traits[_TipsTrait]._reset(),
    _inspect_for_test = lambda ctx: ctx.traits[_TipsTrait].collect(),
    _set_silenced_for_test = lambda ctx, ids: ctx.traits[_TipsTrait]._set_silenced(ids),
    _set_silenced_from_for_test = lambda ctx, id, source, on: ctx.traits[_TipsTrait].set_silenced(id, source, on),
    _set_auto_print_for_test = lambda ctx, v: ctx.traits[_TipsTrait]._set_auto_print(v),
    _set_sink_for_test = lambda ctx, fn: ctx.traits[_TipsTrait]._set_sink(fn),
    _finish_for_test = lambda ctx: ctx.traits[_TipsTrait]._finish(ctx),
)
