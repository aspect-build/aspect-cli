"""Unit tests for lib/log_snippet.axl.

Run with:
  aspect dev test-log-snippet
"""

load("./log_snippet.axl", "SnippetOptions", "extract_action_snippet", "extract_junit_failure_from_text", "extract_snippet", "extract_snippet_from_text")

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _snippet(ctx, xml):
    return extract_junit_failure_from_text(ctx.std, xml, SnippetOptions()).text

def _test_go_junit_char_refs_decode(ctx):
    """rules_go writes the failure body through Go's `encoding/xml`, which escapes
    newlines, tabs and quotes as numeric references. Left encoded, the whole
    failure renders as one line of `&#xA;` noise."""
    xml = ('<testcase name="TestCompare"><failure message="Failed" type="">' +
           "--- FAIL: TestCompare (0.00s)&#xA;    main_test.go:12: diff:&#xA;" +
           "        - &#x9;&#34;this&#34;,&#xA;        + &#x9;&#39;that&#39;," +
           "</failure></testcase>")
    _eq("go body", _snippet(ctx, xml), "\n".join([
        "Failed",
        "--- FAIL: TestCompare (0.00s)",
        "    main_test.go:12: diff:",
        "        - \t\"this\",",
        "        + \t'that',",
    ]))

def _test_named_and_decimal_refs_decode(ctx):
    _eq("attrs", _snippet(ctx, '<failure message="a &lt;b&gt; &amp; &#65;&#x42;"/>'), "a <b> & AB")

def _test_unescape_is_single_pass(ctx):
    """`&amp;lt;` is the text `&lt;`, not `<`: decoding twice would change what
    the test printed."""
    _eq("double", _snippet(ctx, '<failure message="&amp;lt;tag&amp;gt;"/>'), "&lt;tag&gt;")

def _test_malformed_refs_are_kept(ctx):
    _eq("malformed", _snippet(ctx, '<failure message="AT&amp;T &bogus; &#xZZ; &# a & b"/>'), "AT&T &bogus; &#xZZ; &# a & b")

def _test_cdata_body_is_verbatim(ctx):
    """CDATA is how most Java reporters write stack traces. It may contain `</`
    and entity-like text, neither of which ends or decodes it."""
    xml = ('<failure message="boom"><![CDATA[expected </b> but got &amp;\n' +
           "\tat Foo.test(Foo.java:3)]]></failure>")
    _eq("cdata", _snippet(ctx, xml), "boom\nexpected </b> but got &amp;\n\tat Foo.test(Foo.java:3)")

def _test_the_first_error_and_the_end_are_kept(ctx):
    """An action's own error near the top of its output is the snippet's
    anchor, not a generic failure line a wrapper writes last; the end comes
    with it, the lines between counted."""
    log = "\n".join(
        ["building"] +
        ["src/a.cc:3:4: error: no member named 'x'"] +
        ["  note: context %d" % i for i in range(30)] +
        ["ERROR: remote action failed"],
    )
    r = extract_snippet_from_text(ctx.std, log, False, SnippetOptions(max_lines = 8, context_before = 1, context_after = 2, tail = 2))
    _eq("lines", r.text.split("\n"), [
        "building",
        "src/a.cc:3:4: error: no member named 'x'",
        "  note: context 0",
        "  note: context 1",
        "  note: context 2",
        "  note: context 3",
        "… 25 more lines",
        "  note: context 29",
        "ERROR: remote action failed",
    ])
    _eq("ends kept, the middle cut", (r.trunc_head, r.trunc_tail, r.truncated), (False, False, True))

def _test_bazels_sandbox_hint_is_not_the_error(ctx):
    """Bazel's `--sandbox_debug` hint reads as an error but says only how to
    look closer; the tool's own error is the anchor."""
    log = "\n".join(
        ["Use --sandbox_debug to see verbose messages from the sandbox and retain the sandbox build root for debugging"] +
        ["ok %d" % i for i in range(20)] +
        ["panic: the real one"] +
        ["ok after %d" % i for i in range(20)],
    )
    r = extract_snippet_from_text(ctx.std, log, False, SnippetOptions(max_lines = 4, context_before = 0, context_after = 1, tail = 1))
    _eq("anchor", r.text.split("\n")[:2], ["panic: the real one", "ok after 0"])
    _eq("cut head", r.trunc_head, True)

def _test_an_actions_stdout_comes_before_its_stderr(ctx):
    """A tool that writes its errors to stdout (tsc) leaves stderr a wrapper's
    line; the snippet reads both, stdout first, as Bazel's console does."""
    d = ctx.std.env.temp_dir() + "/log_snippet_action_test"
    ctx.std.fs.create_dir_all(d)
    ctx.std.fs.write(d + "/stdout", "src/a.ts(3,4): error TS2322: Type 'x' is not assignable\n")
    ctx.std.fs.write(d + "/stderr", "Target //:a failed to build\n")
    r = extract_action_snippet(ctx.std, d + "/stdout", d + "/stderr", SnippetOptions())
    _eq("both, stdout first", r.text, "src/a.ts(3,4): error TS2322: Type 'x' is not assignable\nTarget //:a failed to build")
    r = extract_action_snippet(ctx.std, "", d + "/stderr", SnippetOptions())
    _eq("stderr alone", r.text, "Target //:a failed to build")
    _eq("neither", extract_action_snippet(ctx.std, "", d + "/missing", SnippetOptions()).source.value, "none")

def _test_a_cut_stdout_is_marked_where_it_was_cut(ctx):
    """A stdout cut by the read bound before a stderr read whole: the cut is
    said between them, and the snippet's end is not marked cut."""
    d = ctx.std.env.temp_dir() + "/log_snippet_cut_test"
    ctx.std.fs.create_dir_all(d)
    ctx.std.fs.write(d + "/stdout", "".join(["progress %d\n" % i for i in range(100)]))
    ctx.std.fs.write(d + "/stderr", "src/x.ts:1:1 - error TS1: bad\nTarget //:a failed to build\n")
    r = extract_action_snippet(ctx.std, d + "/stdout", d + "/stderr", SnippetOptions(max_read_bytes = 200, max_lines = 6))
    lines = r.text.split("\n")
    _eq("the cut said", "… stdout cut at 200 bytes" in lines, True)
    _eq("stderr whole", lines[-2:], ["src/x.ts:1:1 - error TS1: bad", "Target //:a failed to build"])
    _eq("end not cut", r.trunc_tail, False)
    _eq("truncated", r.truncated, True)

def _test_a_stdout_cut_inside_an_escape_keeps_stderr(ctx):
    """A cut that lands inside a hyperlink's escape does not swallow the lines
    after it: the marker and stderr are still shown."""
    d = ctx.std.env.temp_dir() + "/log_snippet_osc_test"
    ctx.std.fs.create_dir_all(d)
    ctx.std.fs.write(d + "/stdout", "x" * 190 + "\x1b]8;;http://example.com/aaaaaaaaaaaaaaa\x1b\\link\x1b]8;;\x1b\\\n")
    ctx.std.fs.write(d + "/stderr", "src/x.ts:1:1 - error TS1: bad\nTarget //:a failed to build\n")
    r = extract_action_snippet(ctx.std, d + "/stdout", d + "/stderr", SnippetOptions(max_read_bytes = 200, max_lines = 6))
    _eq("stderr kept", r.text.split("\n")[-2:], ["src/x.ts:1:1 - error TS1: bad", "Target //:a failed to build"])
    _eq("the cut said", "… stdout cut at 200 bytes" in r.text, True)

def _test_a_cut_is_seen_in_non_ascii_text(ctx):
    """A file bigger than the bound is cut, whatever its text: a character
    can be more than one byte."""
    d = ctx.std.env.temp_dir() + "/log_snippet_utf8_test"
    ctx.std.fs.create_dir_all(d)
    ctx.std.fs.write(d + "/log", "é" * 150 + "\n")
    r = extract_snippet(ctx.std, d + "/log", SnippetOptions(max_read_bytes = 200))
    _eq("cut", (r.truncated, r.trunc_tail), (True, True))

def _test_a_stdout_cut_at_a_line_end_shows_no_blank_line(ctx):
    """A cut on a line boundary, or just after an `ESC (`, adds nothing to the
    lines shown: no blank line, no stray `\\`."""
    d = ctx.std.env.temp_dir() + "/log_snippet_cut_edge_test"
    ctx.std.fs.create_dir_all(d)
    ctx.std.fs.write(d + "/stderr", "error: bad\nend\n")
    ctx.std.fs.write(d + "/lines", "".join(["l%d\n" % (100 + i) for i in range(60)]))
    r = extract_action_snippet(ctx.std, d + "/lines", d + "/stderr", SnippetOptions(max_read_bytes = 200, max_lines = 8))
    _eq("no blank line", "" in r.text.split("\n"), False)
    ctx.std.fs.write(d + "/charset", "x" * 198 + "\x1b(B" + "more\n")
    r = extract_action_snippet(ctx.std, d + "/charset", d + "/stderr", SnippetOptions(max_read_bytes = 200, max_lines = 8))
    _eq("no stray backslash", r.text.split("\n")[0], "x" * 198)

_UNIT_TESTS = [
    _test_a_stdout_cut_at_a_line_end_shows_no_blank_line,
    _test_a_stdout_cut_inside_an_escape_keeps_stderr,
    _test_a_cut_is_seen_in_non_ascii_text,
    _test_an_actions_stdout_comes_before_its_stderr,
    _test_a_cut_stdout_is_marked_where_it_was_cut,
    _test_the_first_error_and_the_end_are_kept,
    _test_bazels_sandbox_hint_is_not_the_error,
    _test_go_junit_char_refs_decode,
    _test_named_and_decimal_refs_decode,
    _test_unescape_is_single_pass,
    _test_malformed_refs_are_kept,
    _test_cdata_body_is_verbatim,
]

def _test_impl(ctx):
    for t in _UNIT_TESTS:
        t(ctx)
    print("log_snippet.axl: OK (%d tests)" % len(_UNIT_TESTS))
    return 0

log_snippet_tests = task(
    summary = "Run the log snippet extraction AXL unit tests.",
    kind = "test-log-snippet",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
