"""How a repo tunes pooled worktree reuse (the `Worktrees` trait), and the
pool's size, take-back and idle limit (the `WorktreePool` feature).

Picking a slot has no correctness consequence: a worse pick costs a colder
build and nothing else. That is what makes it safe to hand to `config.axl`
(either the repo's or a developer's `~/.aspect/config.axl`), where a team that
knows its own repo can score better than a general heuristic — a monorepo where
one directory dominates analysis might weight commit distance far above the
default does, for instance.

The built-in scoring (`default_score` in `private/lib/worktree.axl`) applies when nothing is
registered.

`WorktreePool`'s `max_slots` is the other dial, and the one that costs disk
rather than time. It is advisory: a pool at its limit with every slot in use
still hands out a new one, warning instead of failing, because the fallback to
a refusal is plain `git worktree add` — a cold build and a stranded output
base. See the module docstring in `private/lib/worktree.axl` for how the pool
is actually bounded.

`abandoned_grace_hours` is how long a stopped session's slot is kept for it
before another `add` may take it back.

`max_idle_days` is how long a free slot may go unused before it is deleted
with its output base: by the sweep every `add` runs, and by `prune`. It has
this one place to be set, so a slot the config protects from `prune` is
protected from `add` too. It is the pool's rather than an arg of `prune`
because `add` cannot read another task's args.

All three are options of the `WorktreePool` feature (`--worktree-pool:max-slots`,
`ctx.features[WorktreePool].args.max_slots` in config.axl), which writes them
onto the private `_WorktreePoolSettings` trait the worktree tasks read through
`worktree_pool`. Only the feature writes that trait, so config has one place
to set them. The range checks run in `add`, which refuses with structured
output; the feature only carries the options to the tasks.
"""

load("./worktree.axl", "PRUNE_IDLE_DAYS")

# The `score_slot` hook's limits: how long its calls for one `add` may take in
# all, and the bound a score is clamped to.
HOOK_BUDGET_MS = 2000
HOOK_SCORE_LIMIT = 1000000000

# Fired by `aspect worktree add`, which scores slots.
Worktrees = trait(
    score_slot = attr(
        list[typing.Callable[[TaskContext, dict, dict], int]],
        default = [],
        description = "Hooks scoring a free slot for reuse: `fn(ctx, slot, want) -> int`, higher wins, 0 or less refuses the slot — unless the pool is at `WorktreePool`'s `max_slots` and every free slot is refused, when the best fit by the built-in scoring is reused (`score_hook_refused_all`). `slot` carries its `id`, what its last occupant left behind (`lock_digest`, `last_commit`, `last_branch`, `created_ms`) and whether its output base is there now (`base_present`); `want` carries `name`, `lock_digest` and `commit` for the worktree being created. The first registered hook decides; scores are clamped to ±" + str(HOOK_SCORE_LIMIT) + ". One that fails or returns something other than an int is warned about (`score_hook_failed`) and the built-in scoring used for every slot. So does one whose calls for an `add` take more than " + str(HOOK_BUDGET_MS // 1000) + " seconds in all, since every other `add` waits on the pool lock meanwhile: checked between calls, so one long call runs to its end before the rest are scored by the built-in. A hook must not write to stdout, where `add --output=json` and `--output=path` give their answer. With none registered the built-in scoring applies: a warm slot always beats a cold one (no output base), and among warm slots an identical tree beats the same branch, which beats other work, which beats a different MODULE.bazel.lock.",
    ),
)

_MAX_SLOTS = 8
_ABANDONED_GRACE_HOURS = 24

_WorktreePoolSettings = trait(
    max_idle_days = attr(
        int,
        default = PRUNE_IDLE_DAYS,
        description = "Set from `WorktreePool`'s `max_idle_days` option.",
    ),
    abandoned_grace_hours = attr(
        int,
        default = _ABANDONED_GRACE_HOURS,
        description = "Set from `WorktreePool`'s `abandoned_grace_hours` option.",
    ),
    max_slots = attr(
        int,
        default = _MAX_SLOTS,
        description = "Set from `WorktreePool`'s `max_slots` option.",
    ),
)

def _worktree_pool_impl(ctx: FeatureContext):
    settings = ctx.traits[_WorktreePoolSettings]
    settings.max_idle_days = ctx.args.max_idle_days
    settings.max_slots = ctx.args.max_slots
    settings.abandoned_grace_hours = ctx.args.abandoned_grace_hours

WorktreePool = feature(
    display_name = "Worktree pool",
    summary = "How many pooled worktree slots one clone keeps, how long a stopped session's slot is held for it, and how long a free slot is kept unused.",
    implementation = _worktree_pool_impl,
    args = {
        "max_slots": args.int(
            default = _MAX_SLOTS,
            description = "Advisory ceiling on how many slots one clone keeps in the pool. Each slot costs a checkout plus a Bazel output base — tens of gigabytes on a large repo — so this is a disk budget, not a concurrency limit, and it is a fixed count rather than something derived from core count. Exceeding it warns and proceeds rather than refusing an add. Free slots are reclaimed by idle time instead (`--worktree-pool:max-idle-days`), automatically during `aspect worktree add` and on demand with `aspect worktree prune`, and a lease whose holder has verifiably stopped, past `--worktree-pool:abandoned-grace-hours` and with a clean checkout, is taken back when a slot is needed rather than the pool growing. Below 1, `aspect worktree add` refuses.",
        ),
        "abandoned_grace_hours": args.int(
            default = _ABANDONED_GRACE_HOURS,
            description = "Hours a lease whose session has stopped is kept for that session to come back to — resumed, or restarted on its branch — counted from the slot's last activity: the lease being taken, Bazel using its output base, or a git operation in its checkout. Only after this, and only with nothing in the checkout to lose, is the slot taken back for another `add`. 0 takes such a slot back at once; a negative value makes `aspect worktree add` refuse. `--take-over` and `release --force=all` are not bound by it.",
        ),
        "max_idle_days": args.int(
            default = PRUNE_IDLE_DAYS,
            description = "Days a free slot may go unused before it is deleted with its Bazel output base: by the sweep each `aspect worktree add` runs before it picks a slot, and by `aspect worktree prune` when no slot is named. Unused means no Bazel command in its output base and no lease taken or given back, as the `last used` column of `aspect worktree list` shows. A free slot a live Bazel server holds, or whose checkout holds work, is kept whatever its age, and a leased slot is never deleted for being idle. Below 1, `aspect worktree add` refuses, since every free slot would go before it could hand one out. `aspect worktree prune` takes 0 or less for a one-off that considers every free slot, because it lists them and asks first.",
        ),
    },
)

# The worktree tasks' view of the `WorktreePool` options, read through the
# accessors.
worktree_pool = struct(
    max_idle_days = lambda ctx: ctx.traits[_WorktreePoolSettings].max_idle_days,
    max_slots = lambda ctx: ctx.traits[_WorktreePoolSettings].max_slots,
    abandoned_grace_hours = lambda ctx: ctx.traits[_WorktreePoolSettings].abandoned_grace_hours,
)

def _pool_options_for_test(ctx: TaskContext, **options) -> typing.Callable[[], None]:
    """Replace this run's `_WorktreePoolSettings` with `options` over the
    trait's defaults, bypassing the feature, and return a function that puts
    back the settings they replaced."""
    previous = ctx.traits[_WorktreePoolSettings]
    ctx.traits[_WorktreePoolSettings] = _WorktreePoolSettings(**options)

    def restore():
        ctx.traits[_WorktreePoolSettings] = previous

    return restore

# Exposed for worktree_test.axl; not part of any task's surface.
testonly_pool_options = _pool_options_for_test
