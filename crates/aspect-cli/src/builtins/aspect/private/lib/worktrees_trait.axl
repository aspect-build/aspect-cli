"""The `Worktrees` trait — how a repo tunes pooled worktree reuse and size.

Picking a slot has no correctness consequence: a worse pick costs a colder
build and nothing else. That is what makes it safe to hand to `config.axl`
(either the repo's or a developer's `~/.aspect/config.axl`), where a team that
knows its own repo can score better than a general heuristic — a monorepo where
one directory dominates analysis might weight commit distance far above the
default does, for instance.

The built-in scoring (`default_score` in `private/lib/worktree.axl`) applies when nothing is
registered.

`max_slots` is the other dial, and the one that costs disk rather than time. It
is advisory: a pool at its limit with every slot in use still hands out a new
one, warning instead of failing, because the fallback to a refusal is plain
`git worktree add` — a cold build and a stranded output base. See the module
docstring in `private/lib/worktree.axl` for how the pool is actually bounded.

`abandoned_grace_hours` is how long a stopped session's slot is kept for it
before another `add` may take it back.

`prune_slot` decides when a free slot's disk is worth more than its warmth:
asked about each of this clone's free slots when `add` takes the pool lock
and in a `prune` that names no slot, and about the slot just given back by `release`.
`pool["event"]` says which, and `pool["max_idle_days"]` the threshold the
built-in rule is applying. With `ctx` it can look at the machine
itself, such as free space on the pool's volume:

    def _prune_when_disk_is_short(ctx, slot, pool):
        df = ctx.std.process.command("df").args(["-Pk", pool["dir"]]).stdout("piped").stderr("null").spawn().wait_with_output()
        free_kb = int(df.stdout.strip().splitlines()[-1].split()[3])
        if free_kb < 50 * 1024 * 1024:
            return True    # under 50 GiB free: delete the free slots asked about
        return None        # otherwise the built-in idle rule

    ctx.traits[Worktrees].prune_slot.append(_prune_when_disk_is_short)
"""

load("./worktree.axl", "PRUNE_IDLE_DAYS")

# The hooks' limits: how long each hook's calls for one command may take in
# all, and the bound a `score_slot` score is clamped to.
HOOK_BUDGET_MS = 2000
HOOK_SCORE_LIMIT = 1000000000

Worktrees = trait(
    score_slot = attr(
        list[typing.Callable[[TaskContext, dict, dict], int]],
        default = [],
        description = "Hooks scoring a free slot for reuse: `fn(ctx, slot, want) -> int`, higher wins, 0 or less refuses the slot — unless the pool is at `max_slots` and every free slot is refused, when the best fit by the built-in scoring is reused (`score_hook_refused_all`). `slot` carries its `id`, what its last occupant left behind (`lock_digest`, `last_commit`, `last_branch`, `created_ms`) and whether its output base is there now (`base_present`); `want` carries `name`, `lock_digest` and `commit` for the worktree being created. The first registered hook decides; scores are clamped to ±" + str(HOOK_SCORE_LIMIT) + ". One that fails or returns something other than an int is warned about (`score_hook_failed`) and the built-in scoring used for every slot. So does one whose calls for an `add` take more than " + str(HOOK_BUDGET_MS // 1000) + " seconds in all, since every other `add` waits on the pool lock meanwhile: checked between calls, so one long call runs to its end before the rest are scored by the built-in. A hook must not write to stdout, where `add --output=json` and `--output=path` give their answer. With none registered the built-in scoring applies: a warm slot always beats a cold one (no output base), and among warm slots an identical tree beats the same branch, which beats other work, which beats a different MODULE.bazel.lock.",
    ),
    abandoned_grace_hours = attr(
        int,
        default = 24,
        description = "How long a lease whose session has stopped is kept for that session to come back to — resumed, or restarted on its branch — counted from the slot's last activity: the lease being taken, Bazel using its output base, or a git operation in its checkout. Only after this, and only with nothing in the checkout to lose, is the slot taken back for another `add`. 0 takes such a slot back at once; a negative value is refused. `--take-over` and `release --force=all` are not bound by it.",
    ),
    prune_slot = attr(
        list[typing.Callable[[TaskContext, dict, dict], typing.Any]],
        default = [],
        description = "Hooks deciding whether a free slot is deleted — its checkout directory, its Bazel output base and its pool entry: `fn(ctx, slot, pool) -> True | False | None`. True deletes it, False keeps it however long it has been idle, and None leaves it to the built-in rule, which deletes a free slot idle for `pool[\"max_idle_days\"]` days and never deletes one on `release`. `pool[\"event\"]` says which command is asking: `\"add\"`, once for each of this clone's free slots before a slot is picked, with `max_idle_days` " + str(PRUNE_IDLE_DAYS) + " — the slots it chooses are deleted once `add` has picked its own, or has refused, so the free slot `add` reuses is kept rather than rebuilt cold; `\"prune\"`, the same for an `aspect worktree prune` that names no slot, with the `--max-idle-days` it was given and `dry_run` true for `--dry-run`, when the hook's answer only decides what is listed — so a hook must not act on its own, only answer; or `\"release\"`, once for the slot `release` has just freed, with `max_idle_days` None. A slot of another clone released from here is not asked about, since the hooks are this clone's config.axl's, not its owner's: it stays free for the owner's hook to judge. `slot` carries `id`, `path`, `output_base`, `base_present`, `server_pid` (0 when no Bazel server holds the base), `idle_ms`, `created_ms`, `lease_count`, `last_branch`, `last_commit` and `lock_digest`; `pool` carries `event`, `max_idle_days`, `dry_run`, `id`, `dir`, `clone`, `max_slots`, `owned` (how many slots this clone has, which `max_slots` counts), `slots` (this pool's `total`, `free`, `leased` and `reserved`) and `other_pools`, a list of every other pool on this machine with its `id`, `dir` and `slots`. Deleting is refused, whatever the hook says, while a Bazel server still holds the slot's output base — after a `release` it usually does, until Bazel's idle timeout — or while its checkout holds work; such a slot stays free and is asked about again on the next `add` or `prune`. The first registered hook decides. One that fails or returns something other than True, False or None is warned about (`prune_hook_failed`) and the built-in rule used for every slot — under `release --all`, for every slot after it too; so does one whose calls for one command take more than " + str(HOOK_BUDGET_MS // 1000) + " seconds in all — for each slot, under `release --all` — since the pool lock is held meanwhile — so read free space with `df`, not the size of a base with `du`. Slots of another clone, and pool entries with no recorded age, are not asked about; nor is a slot named to `aspect worktree prune`, where naming it is the decision.",
    ),
    max_slots = attr(
        int,
        default = 8,
        description = "Advisory ceiling on how many slots one clone keeps in the pool. Each slot costs a checkout plus a Bazel output base — tens of gigabytes on a large repo — so this is a disk budget, not a concurrency limit, and it is a fixed count rather than something derived from core count. Exceeding it warns and proceeds; nothing is refused. Free slots are reclaimed by idle time instead, automatically during `aspect worktree add` and on demand with `aspect worktree prune`, and a lease whose holder has verifiably stopped, past `abandoned_grace_hours` and with a clean checkout, is taken back when a slot is needed rather than the pool growing.",
    ),
)
