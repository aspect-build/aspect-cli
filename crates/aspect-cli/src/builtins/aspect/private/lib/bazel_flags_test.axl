"""Tests for the `bazel` flag/rc/auth helpers (in @aspect//bazel.axl).

Run with:
  aspect dev test-bazel-flags
"""

load("@aspect//bazel.axl", "BazelTrait", "bazel", "testonly_config_names", "testonly_flags_delta", "testonly_scope_injected")
load("./aspect_flags.axl", "flag_text")
load("./auth_fakes.axl", "fake_auth")
load("./deployment_flags.axl", "deployment_auth_flags")

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _trait(
        extra_startup = [],
        extra = [],
        extra_build = [],
        extra_test = [],
        extra_query = [],
        extra_info = [],
        task_flags = [],
        base = [],
        flags = None,
        startup_flags = None):
    """A real `BazelTrait` with just the startup/command-flag fields the helpers
    read."""
    return BazelTrait(
        extra_startup_flags = extra_startup,
        extra_flags = extra,
        extra_build_flags = extra_build,
        extra_test_flags = extra_test,
        extra_query_flags = extra_query,
        extra_info_flags = extra_info,
        task_flags = task_flags,
        base_flags = base,
        flags = flags,
        startup_flags = startup_flags,
    )

def _fake_ctx(bazel_startup_flags = [], bazel_flags = [], trait = None):
    """Stand-in for `TaskContext` with the CLI args and trait map the helpers
    read. `ctx.traits[BazelTrait]` resolves against a plain dict — trait types
    are hashable, so a dict keyed by `BazelTrait` mimics the real trait map.
    `hasattr` returns True for declared args, satisfying `_require_arg`.

    Deliberately declares no passthrough buckets: a task may take the flag args
    without them, and the resolve helpers must tolerate that — so `claim` answers
    `[]` the way the real args store does for an arg the task never declared."""
    return struct(
        args = struct(
            bazel_startup_flags = bazel_startup_flags,
            bazel_flags = bazel_flags,
            claim = lambda name: [],
        ),
        traits = {BazelTrait: trait if trait != None else _trait()},
    )

def _passthrough_ctx(startup = [], flags = [], passthrough_startup = [], passthrough = []):
    """`_fake_ctx` plus the two passthrough buckets the CLI parser fills with the
    flags it could not attribute to a declared arg.

    Carries a `claim` that records what was claimed, mirroring the real args
    store: the resolve helpers must claim a bucket they fold in, or the runtime
    fails the invocation for dropping the user's flags. `claimed` is readable so
    a test can assert the claim actually happened."""
    buckets = {
        "bazel_passthrough_startup_flags": passthrough_startup,
        "bazel_passthrough_flags": passthrough,
    }
    claimed = []

    def _claim(name):
        claimed.append(name)
        return buckets.get(name, [])

    return struct(
        args = struct(
            bazel_startup_flags = startup,
            bazel_flags = flags,
            bazel_passthrough_startup_flags = passthrough_startup,
            bazel_passthrough_flags = passthrough,
            claim = _claim,
        ),
        claimed = claimed,
        traits = {BazelTrait: _trait()},
    )

def _announce_ctx(on_ci, version = "auto", command = "auto"):
    """Stand-in `ctx` whose `std.env.var` reports a CI marker (or not) and whose
    args carry the announce flags, so `bazel.announce.resolve` is exercisable
    deterministically."""
    env_vars = {"CI": "1"} if on_ci else {}
    return struct(
        std = struct(env = struct(var = lambda name: env_vars.get(name))),
        args = struct(announce_bazel_version = version, announce_bazel_command = command),
    )

def _test_announce_auto_follows_ci(ctx):
    _eq("auto on CI", bazel.announce.resolve(_announce_ctx(True)), (True, True))
    _eq("auto off CI", bazel.announce.resolve(_announce_ctx(False)), (False, False))

def _test_announce_explicit_overrides_ci(ctx):
    # Explicit true/false ignore the environment; distinct values catch a
    # swapped or copy-pasted (version, command) read.
    _eq(
        "(version, command) order, explicit",
        bazel.announce.resolve(_announce_ctx(True, version = "true", command = "false")),
        (True, False),
    )

def _test_announce_args_shape(ctx):
    """`bazel.announce.args` returns exactly the three flags every
    Bazel-spawning task must declare (the resolve contract)."""
    aa = bazel.announce.args("the build")
    _eq(
        "announce arg keys",
        sorted(aa.keys()),
        ["announce_bazel_command", "announce_bazel_rc", "announce_bazel_version"],
    )

def _test_startup_cli_only(ctx):
    """CLI flags pass through when the trait contributes nothing."""
    _eq(
        "startup cli-only",
        bazel.flags.resolve_startup(_fake_ctx(bazel_startup_flags = ["--client"])),
        ["--client"],
    )

def _test_startup_trait_extra_appended(ctx):
    """`trait.extra_startup_flags` is appended after CLI flags."""
    _eq(
        "startup trait extras after CLI",
        bazel.flags.resolve_startup(_fake_ctx(bazel_startup_flags = ["--client"], trait = _trait(extra_startup = ["--trait"]))),
        ["--client", "--trait"],
    )

def _test_startup_input_list_not_mutated(ctx):
    """`bazel.flags.resolve_startup` must not mutate the caller's CLI flag list
    (`ctx.args.bazel_startup_flags` is a live reference)."""
    cli = ["--client"]
    bazel.flags.resolve_startup(_fake_ctx(bazel_startup_flags = cli, trait = _trait(extra_startup = ["--trait"])))
    _eq("startup cli list untouched", cli, ["--client"])

def _test_flags_full_chain_order(ctx):
    """Slot ordering:
        ctx.args.bazel_flags + trait.extra_flags + trait.extra_build_flags +
        task_flags hooks + extra_test_flags + extra_query_flags +
        extra_info_flags.
    Verify each slot lands where the contract promises.

    The user's flag stays a plain string (the rc's `always` section — it applies
    to every command this invocation runs); each injected slot comes back scoped
    to the rc section its field names, which is what keeps a build-only option
    off a sidecar `query` and a `test`/`info`-only option off `bazel build`.

    The list order is NOT the precedence order — `options_for` regroups by
    section, so the `build` group's three entries are consecutive here only
    because they share a section. `_test_injected_flag_precedence` pins what
    actually wins."""
    task_hook = lambda c: ["--from-hook"]
    _eq(
        "resolve full chain",
        bazel.flags.resolve(
            _fake_ctx(
                bazel_flags = ["--cli"],
                trait = _trait(
                    extra = ["--trait-extra"],
                    extra_build = ["--trait-build"],
                    extra_test = ["--trait-test"],
                    extra_query = ["--trait-query"],
                    extra_info = ["--trait-info"],
                    task_flags = [task_hook],
                ),
            ),
        ),
        [
            "--cli",
            ("--trait-extra", "", "build"),
            ("--trait-build", "", "build"),
            ("--from-hook", "", "build"),
            ("--trait-test", "", "test"),
            ("--trait-query", "", "query"),
            ("--trait-info", "", "info"),
        ],
    )

def _test_injected_flags_carry_their_own_scope(ctx):
    """An injected entry that already names a section keeps it: that is how a
    producer scopes tighter than `build` (a `test`-only option) and how one opts
    a flag back in to every command, `query` included. A version-gated pair
    carries no section, so it gains `build` like a plain string.

    Asserted through a `task_flags` hook because that is the typed way to return
    one: `extra_flags` is an `attr(list[str])`, so a tuple only reaches it by
    mutating the live trait's list, as `runner_diagnostics_flags` does with
    `exec_log_flags`. Both slots pass through the same scoping."""
    always = ("--color=yes", "", "always")
    gated = ("--execution_log_compact_file=/x", ">=7.4.0")
    scoped = ("--test_env=FOO=1", "", "test")
    hook = lambda c: [always, gated, scoped]
    _eq(
        "explicit scopes survive",
        bazel.flags.resolve(_fake_ctx(trait = _trait(task_flags = [hook]))),
        [always, ("--execution_log_compact_file=/x", ">=7.4.0", "build"), scoped],
    )

def _test_injected_config_requests_stay_unscoped(ctx):
    """An injected `--config=NAME` is a reference, not an option: Bazel expands
    it against the sections the running command reads, so it stays unscoped and
    a `common:NAME` section keeps reaching a sidecar `query`. Both spellings,
    with the two-token value travelling with its flag.

    The documented `extra_flags = ["--config=ci"]` recipe (README, and this
    repo's own `.aspect/config.axl`) rests on this."""
    _eq(
        "eq form unscoped",
        bazel.flags.resolve(_fake_ctx(trait = _trait(extra = ["--config=ci", "--jobs=8"]))),
        ["--config=ci", ("--jobs=8", "", "build")],
    )
    _eq(
        "space form keeps its value",
        bazel.flags.resolve(_fake_ctx(trait = _trait(extra = ["--config", "ci", "--jobs=8"]))),
        ["--config", "ci", ("--jobs=8", "", "build")],
    )

    # A bare `--config` with a flag behind it has no value; the follower is an
    # option of its own and is scoped like any other.
    _eq(
        "valueless config does not swallow the next flag",
        bazel.flags.resolve(_fake_ctx(trait = _trait(extra = ["--config", "--jobs=8"]))),
        ["--config", ("--jobs=8", "", "build")],
    )

def _test_flag_transforms(ctx):
    """The optional `trait.flags` / `trait.startup_flags` transforms run last and
    replace the whole list — the exported seam a user `config.axl` rewrites
    flags through. They run after the injected flags were scoped, so a
    transform matching on flag text reads it off the tuple."""
    t = _trait(
        extra = ["--trait-extra"],
        flags = lambda flags: [f for f in flags if flag_text(f) != "--trait-extra"] + ["--rewritten"],
        startup_flags = lambda flags: flags + ["--startup-rewritten"],
    )
    _eq(
        "flags transform replaces the list",
        bazel.flags.resolve(_fake_ctx(bazel_flags = ["--cli"], trait = t)),
        ["--cli", "--rewritten"],
    )
    _eq(
        "startup transform replaces the list",
        bazel.flags.resolve_startup(_fake_ctx(bazel_startup_flags = ["--client"], trait = t)),
        ["--client", "--startup-rewritten"],
    )

def _test_passthrough_flags_follow_explicit_ones(ctx):
    """A flag the parser routed into a passthrough bucket joins the slot it was
    typed for, after the explicit `--bazel-flag` / `--bazel-startup-flag` values
    so the direct spelling wins a collision."""
    post_ctx = _passthrough_ctx(flags = ["--jobs=4"], passthrough = ["--jobs=8"])
    _eq("post-command passthrough", bazel.flags.resolve(post_ctx), ["--jobs=4", "--jobs=8"])

    pre_ctx = _passthrough_ctx(startup = ["--client"], passthrough_startup = ["--output_base=/tmp/o"])
    _eq("pre-command passthrough", bazel.flags.resolve_startup(pre_ctx), ["--client", "--output_base=/tmp/o"])

def _test_resolving_claims_the_bucket(ctx):
    """Folding a bucket into the flag list must also claim it — the runtime fails
    the invocation for flags left unclaimed, so a resolve that forgot to claim
    would turn a working command line into an error."""
    post_ctx = _passthrough_ctx(passthrough = ["--jobs=8"])
    bazel.flags.resolve(post_ctx)
    _eq("resolve claims post-command bucket", post_ctx.claimed, ["bazel_passthrough_flags"])

    pre_ctx = _passthrough_ctx(passthrough_startup = ["--output_base=/tmp/o"])
    bazel.flags.resolve_startup(pre_ctx)
    _eq("resolve_startup claims pre-command bucket", pre_ctx.claimed, ["bazel_passthrough_startup_flags"])

def _test_disclaim_accounts_for_both_buckets(ctx):
    """A path that spawns no Bazel claims both buckets, so a legitimate no-op run
    is not reported as having dropped the user's flags."""
    c = _passthrough_ctx(passthrough = ["--jobs=8"], passthrough_startup = ["--output_base=/tmp/o"])
    bazel.flags.disclaim_passthrough(c)
    _eq(
        "disclaim claims both buckets",
        sorted(c.claimed),
        ["bazel_passthrough_flags", "bazel_passthrough_startup_flags"],
    )

def _test_passthrough_buckets_are_optional(ctx):
    """A task that declares the flag args without the passthrough buckets keeps
    resolving — the buckets are additive, not part of the arg contract."""
    _eq("no buckets, startup", bazel.flags.resolve_startup(_fake_ctx(bazel_startup_flags = ["--client"])), ["--client"])
    _eq("no buckets, flags", bazel.flags.resolve(_fake_ctx(bazel_flags = ["--cli"])), ["--cli"])

def _test_passthrough_args_shape(ctx):
    """`bazel.flags.args` declares both buckets, one per command-line slot, plus
    the value-flag list the post-command bucket reads arities from."""
    fa = bazel.flags.args("the build")
    _eq(
        "flag arg keys",
        sorted(fa.keys()),
        [
            "bazel_flags",
            "bazel_passthrough_flags",
            "bazel_passthrough_startup_flags",
            "bazel_startup_flags",
            "bazel_startup_value_flags",
            "bazel_value_flags",
        ],
    )

def _test_passthrough_args_is_the_opt_in_subset(ctx):
    """`passthrough_args` is what a task with its own `--bazel-flag` wording
    splats (delivery does); `flags.args` is that plus those two flags."""
    pa = bazel.flags.passthrough_args()
    _eq(
        "passthrough arg keys",
        sorted(pa.keys()),
        [
            "bazel_passthrough_flags",
            "bazel_passthrough_startup_flags",
            "bazel_startup_value_flags",
            "bazel_value_flags",
        ],
    )
    fa = bazel.flags.args("the build")
    for key in pa.keys():
        if key not in fa:
            fail("flags.args must include %s" % key)

def _test_startup_value_flags_cover_the_pre_command_slot(ctx):
    """Startup options are their own slot and their own list, so
    `aspect --output_base /tmp/o build` collects the value the way Bazel does."""
    listed = bazel.flags.BAZEL_STARTUP_VALUE_FLAGS
    for flag in ["--output_base", "--output_user_root", "--bazelrc", "--host_jvm_args"]:
        if flag not in listed:
            fail("expected %s in BAZEL_STARTUP_VALUE_FLAGS" % flag)
    if "--batch" in listed:
        fail("--batch takes no value; listing it would eat the task name")

def _test_value_flags_mirror_bazel(ctx):
    """The generated list carries Bazel's value-taking flags and none of its
    booleans — a boolean in here would swallow the following target pattern."""
    listed = bazel.flags.BAZEL_VALUE_FLAGS
    for flag in ["-c", "-j", "--jobs", "--config", "--compilation_mode", "--test_output"]:
        if flag not in listed:
            fail("expected %s in BAZEL_VALUE_FLAGS" % flag)
    for flag in ["-k", "--keep_going", "--remote_download_all", "--nobuild"]:
        if flag in listed:
            fail("%s takes no value; listing it would eat the next argument" % flag)

    # Bazel 10 gave these an optional value (`--[no]disk_cache`), so the
    # space-separated spelling is a target pattern there even though Bazel 6-9
    # accept it. Regenerating from an older Bazel alone would put them back.
    for flag in ["--disk_cache", "--execution_log_binary_file"]:
        if flag in listed:
            fail("%s is boolean on some supported Bazel; it must keep --flag=value only" % flag)

    # Label-shaped flags are excluded on purpose: Bazel requires `=` for them.
    for flag in listed:
        if flag.startswith("--//") or ":" in flag:
            fail("label-shaped flag %s must not be listed" % flag)

def _test_flags_empty_defaults(ctx):
    """No CLI flags, no trait additions → empty result."""
    _eq(
        "resolve empty",
        bazel.flags.resolve(_fake_ctx()),
        [],
    )

def _test_setup_command_applies_to_ctx_bazel(ctx):
    """End-to-end check on a real `ctx`:
      - the returned `RunCommand` is registered as the active rc;
      - the caller's `base_flags` appear in its `build` expansion;
      - the trait's `extra_startup_flags` land on the rc's startup flags;
      - `--ignore_all_rc_files` is present.
    The workspace `.bazelrc` is parsed as a side effect, which is fine
    for a dev test."""
    sentinel = "/tmp/test-setup-command-sentinel"

    # Inject a real trait into the live trait map and let setup_command read it
    # back via ctx.traits[BazelTrait] — exercises the production (no-override) path.
    ctx.traits[BazelTrait] = _trait(extra_startup = ["--output_base=" + sentinel])

    rc = bazel.setup_command(ctx, "build", base_flags = ["--from-base"])

    if rc != ctx.bazel.active_rc():
        fail("setup_command — returned rc not registered as active")
    if "--from-base" not in rc.expand(command = "build"):
        fail("setup_command — base_flag not in build expansion: %r" % rc.expand(command = "build"))

    startup = list(rc.startup_flags())
    if ("--output_base=" + sentinel) not in startup:
        fail("setup_command — trait --output_base not on rc startup flags: %r" % startup)
    if "--ignore_all_rc_files" not in startup:
        fail("setup_command — --ignore_all_rc_files not present: %r" % startup)

def _test_setup_command_trait_base_flags(ctx):
    """`trait.base_flags` (feature-injected defaults) enter setup_command's
    composition ahead of the caller's base flags, so later flags still win
    last-wins."""
    ctx.traits[BazelTrait] = _trait(base = ["--trait-base"])
    rc = bazel.setup_command(ctx, "build", base_flags = ["--from-base"])
    expanded = rc.expand(command = "build")
    if "--trait-base" not in expanded:
        fail("setup_command — trait base_flag not in build expansion: %r" % expanded)
    if expanded.index("--trait-base") > expanded.index("--from-base"):
        fail("setup_command — trait base_flags must precede caller base_flags: %r" % expanded)

def _test_sibling_rc_transforms_startup(ctx):
    """`bazel.sibling_rc` mirrors setup_command's flags but runs the startup
    flags through the transform, and does NOT register itself as active."""
    base = "/tmp/test-sibling-rc-base"
    ctx.traits[BazelTrait] = _trait(extra_startup = ["--output_base=" + base], extra = ["--from-extra"])
    active = bazel.setup_command(ctx, "build")

    sib = bazel.sibling_rc(ctx, lambda flags: [f + "-checksum" if f.startswith("--output_base=") else f for f in flags])

    startup = list(sib.startup_flags())
    if ("--output_base=" + base + "-checksum") not in startup:
        fail("sibling_rc — transform not applied to startup: %r" % startup)
    if ("--output_base=" + base) in startup:
        fail("sibling_rc — untransformed --output_base leaked: %r" % startup)
    if "--from-extra" not in sib.expand(command = "build"):
        fail("sibling_rc — trait extra_flags missing from expansion: %r" % sib.expand(command = "build"))

    # Building the sibling must not disturb the active rc.
    if ctx.bazel.active_rc() != active:
        fail("sibling_rc — must not change the active run command")

# A test option: accepted by `build` and every command that inherits it, and
# rejected outright by `query`, so it is the sharp edge of the scoping contract.
_QUERY_REJECTS = "--flaky_test_attempts=3"

def _test_injected_flags_never_reach_a_query(ctx):
    """Regression: an injected flag `bazel query` does not accept must not reach
    a task's query — neither off the active run command nor off an rc handed to
    `ctx.bazel.query(rc = ...)` explicitly.

    The failure this guards: a repository whose `config.axl` set
    `extra_flags = ["--flaky_test_attempts=3"]` took `aspect delivery` down at
    its target-resolving query with `Unrecognized option`. The flag was
    unscoped, so it landed in the rc's `always` section — which every command
    reads — and the query spawn passes those as literal argv under
    `--ignore_all_rc_files`, where Bazel rejects an inapplicable option instead
    of ignoring it the way it would an rc-file `common` entry.

    Both halves matter: a `query` that silently lost the flags it *should* carry
    would pass the first assertion and resolve against the wrong repo state."""
    ctx.traits[BazelTrait] = _trait(extra = [_QUERY_REJECTS], task_flags = [lambda c: [_QUERY_REJECTS]])
    active = bazel.setup_command(ctx, "build")
    sibling = bazel.sibling_rc(ctx, lambda startup: startup)

    for (label, rc) in [("active rc", active), ("explicit rc=", sibling)]:
        for command in ["build", "test"]:
            if _QUERY_REJECTS not in rc.expand(command = command):
                fail("%s — injected flag missing from the %s expansion: %r" % (label, command, rc.expand(command = command)))
        if _QUERY_REJECTS in rc.expand(command = "query"):
            fail("%s — injected build flag reached query: %r" % (label, rc.expand(command = "query")))

        # What the query spawn actually hands Bazel, overrides included.
        _, query_argv = rc.expand_all(command = "query")
        for flag in query_argv:
            if _QUERY_REJECTS in flag_text(flag):
                fail("%s — injected build flag reached the query argv: %r" % (label, query_argv))

# The four Bazel commands AXL can run (`engine/bazel/mod.rs`), which is why
# `BazelTrait` has one `extra_*_flags` field per command.
_COMMANDS = ["build", "test", "query", "info"]

# Which commands each injected field must reach. `extra_flags` and
# `extra_build_flags` land in the `build` section, which `test` and `info`
# inherit and `query` does not; the other three land in their own command's
# section, which nothing inherits.
_REACH = {
    "extra_flags": ["build", "test", "info"],
    "extra_build_flags": ["build", "test", "info"],
    "extra_test_flags": ["test"],
    "extra_query_flags": ["query"],
    "extra_info_flags": ["info"],
}

def _rc_over(ctx, trait, task_base = [], user = []):
    """A `RunCommand` carrying exactly what `setup_command` would hand
    `parse_rc` for `trait`, built with `new_rc` so no `.bazelrc` on disk can
    perturb the expansions.

    Composed the way `setup_command` composes it — `trait.base_flags`, then the
    task's `base_flags=`, then `bazel.flags.resolve` — over a `_fake_ctx` so the
    user's `--bazel-flag` slot is settable from a test. That mirror is the one
    thing here production also does; `_test_setup_command_trait_base_flags`
    pins the same two base slots through the real `setup_command`."""
    resolved = bazel.flags.resolve(_fake_ctx(bazel_flags = user, trait = trait))
    return ctx.bazel.new_rc(flags = list(trait.base_flags) + list(task_base) + resolved)

def _reaches(rc, command, flag):
    """Whether `flag` reaches `command`, by both of the expansions a spawn can
    read: `expand` (the flat option list) and `expand_all` (what the spawn
    actually hands Bazel, `--default_override` entries included)."""
    in_expand = flag in [flag_text(f) for f in rc.expand(command = command)]
    _, argv = rc.expand_all(command = command)
    in_argv = False
    for entry in argv:
        if flag in flag_text(entry):
            in_argv = True
    if in_expand != in_argv:
        fail("expand/expand_all disagree for %s on %s: %r vs %r" % (flag, command, rc.expand(command = command), argv))
    return in_expand

def _test_per_command_fields_reach_exactly_their_command(ctx):
    """Each injected field reaches exactly the commands its rc section is read
    by, and no others — the whole point of having four of them.

    One field at a time, so a leak names the field that leaked, and over all
    four commands AXL can run rather than just the pair #1578 cared about."""
    one = ["--sentinel"]
    for (field, trait) in [
        ("extra_flags", _trait(extra = one)),
        ("extra_build_flags", _trait(extra_build = one)),
        ("extra_test_flags", _trait(extra_test = one)),
        ("extra_query_flags", _trait(extra_query = one)),
        ("extra_info_flags", _trait(extra_info = one)),
    ]:
        expected = _REACH[field]
        rc = _rc_over(ctx, trait)
        for command in _COMMANDS:
            got = _reaches(rc, command, "--sentinel")
            want = command in expected
            if got != want:
                fail("%s on `bazel %s`: reached=%r, want %r (expansion: %r)" % (field, command, got, want, rc.expand(command = command)))

# The two flags that make the per-command fields necessary rather than nicer.
# Measured with `bazel canonicalize-flags --for_command=…` on Bazel 9.3.0:
#
#                                    build   test    query   info
#   --test_verbose_timeout_warnings  REJECT  ok      REJECT  REJECT
#   --show_make_env                  REJECT  REJECT  REJECT  ok
#
# `--test_verbose_timeout_warnings` is the one Bazel itself recommends, in the
# "There were tests whose specified size is too big" warning, so following
# Bazel's own advice into `config.axl` is what reaches it.
_BUILD_REJECTS_TEST_ONLY = "--test_verbose_timeout_warnings"
_BUILD_REJECTS_INFO_ONLY = "--show_make_env"

def _test_build_rejected_flags_have_a_home(ctx):
    """Regression: a flag `bazel build` rejects must not reach `bazel build`.

    `extra_flags` cannot host either of these — it lands in the `build` section,
    and so does `extra_build_flags`, so `aspect build` dies with
    `Unrecognized option` before and after #1578. `extra_test_flags` and
    `extra_info_flags` are the fix: the flag reaches the command that accepts it
    and nothing else.

    Both halves matter. A field that quietly dropped its flag would pass the
    "not on build" assertion and leave the user's test setting inert."""
    cases = [
        ("extra_test_flags", _trait(extra_test = [_BUILD_REJECTS_TEST_ONLY]), _BUILD_REJECTS_TEST_ONLY, "test"),
        ("extra_info_flags", _trait(extra_info = [_BUILD_REJECTS_INFO_ONLY]), _BUILD_REJECTS_INFO_ONLY, "info"),
    ]
    for (field, trait, flag, accepts) in cases:
        rc = _rc_over(ctx, trait)
        if _reaches(rc, "build", flag):
            fail("%s — %s reached `bazel build`, which rejects it: %r" % (field, flag, rc.expand(command = "build")))
        if not _reaches(rc, accepts, flag):
            fail("%s — %s never reached `bazel %s`, which accepts it: %r" % (field, flag, accepts, rc.expand(command = accepts)))

        # And the same flag in `extra_flags` is the broken configuration this
        # field exists to replace: it does land on `bazel build`.
        broken = _rc_over(ctx, _trait(extra = [flag]))
        if not _reaches(broken, "build", flag):
            fail("extra_flags — %s should still reach `bazel build` (that is the bug the new field routes around): %r" % (flag, broken.expand(command = "build")))

def _test_injected_flag_precedence(ctx):
    """Pin the precedence table in `bazel/flags.axl`'s module docstring for the
    caller-supplied half: `trait.base_flags`, the task's `base_flags=`, the
    user's `--bazel-flag`, then `extra_flags` / `extra_build_flags` /
    `task_flags`, then the field for the running command.

    Precedence is NOT the resolved list's order. `options_for` regroups the
    caller's flags by rc section in Bazel's section order, so the key is section
    specificity first and list position only within a section. #1578 had to fix
    an inversion here (a scoped flag losing to the `.bazelrc`); the rc-file half
    is pinned in Rust by `scoped_caller_flag_still_overrides_the_rc_files`.

    Distinct `--jobs` values make it readable: Bazel takes the last, so the
    rightmost entry is what the command runs with."""
    trait = _trait(
        base = ["--jobs=1"],
        extra = ["--jobs=4"],
        extra_build = ["--jobs=5"],
        task_flags = [lambda c: ["--jobs=6"]],
        extra_test = ["--jobs=7"],
        extra_query = ["--jobs=8"],
        extra_info = ["--jobs=9"],
    )
    rc = _rc_over(ctx, trait, task_base = ["--jobs=2"], user = ["--jobs=3"])

    want = {
        # The unscoped block in list order, then the `build` section's three.
        "build": ["--jobs=1", "--jobs=2", "--jobs=3", "--jobs=4", "--jobs=5", "--jobs=6"],
        # `test` reads `build` and then its own section.
        "test": ["--jobs=1", "--jobs=2", "--jobs=3", "--jobs=4", "--jobs=5", "--jobs=6", "--jobs=7"],
        # `query` reads no other command's section, so only the unscoped block
        # and `extra_query_flags`.
        "query": ["--jobs=1", "--jobs=2", "--jobs=3", "--jobs=8"],
        # `info` inherits `build` and then adds its own.
        "info": ["--jobs=1", "--jobs=2", "--jobs=3", "--jobs=4", "--jobs=5", "--jobs=6", "--jobs=9"],
    }
    for command in _COMMANDS:
        _eq("precedence on `bazel %s`" % command, [flag_text(f) for f in rc.expand(command = command)], want[command])

    # The user's own `--bazel-flag` is unscoped, so an injected flag in a
    # command section outranks it. That is deliberate — `--bazel-flags:omit` is
    # how a user drops an injected flag — and it is what #1578 already shipped
    # for `extra_flags`; asserted here so a reordering cannot flip it silently.
    expanded = [flag_text(f) for f in rc.expand(command = "test")]
    if expanded.index("--jobs=3") > expanded.index("--jobs=4"):
        fail("an unscoped user flag must precede the injected build-section ones: %r" % expanded)

def _test_a_fields_section_is_a_default_not_a_rewrite(ctx):
    """A plain entry takes the section of the field that carried it; an entry
    that names its own section keeps it. Same rule for all four sections — the
    field's section is a default, never a rewrite.

    Decision pinned here: `extra_test_flags = ["--x"]` is forced into `test`
    (nothing else would make the field mean anything), but a per-entry tuple
    still overrides, exactly as in `extra_flags`. That is what lets a producer
    which mutates the live trait's list (the `runner_diagnostics_flags` /
    `exec_log_flags` pattern) get the same answer whichever list it appended to,
    and what lets one flag opt back in to every command via `"always"`.

    Tested against `_scope_injected` directly because the fields are
    `attr(list[str])`: the trait constructor rejects a tuple, so from AXL a
    tuple reaches a field only through the live trait map, and reaches the
    scoper only through a `task_flags` hook — one section's worth of coverage
    for a rule that has to hold for four.
    `_test_injected_flags_carry_their_own_scope` covers the hook route
    end-to-end."""
    always = ("--color=yes", "", "always")
    gated = ("--execution_log_compact_file=/x", ">=7.4.0")
    elsewhere = ("--test_env=FOO=1", "", "test")
    for section in _COMMANDS:
        _eq(
            "plain string takes the field's section (%s)" % section,
            testonly_scope_injected(["--plain"], section),
            [("--plain", "", section)],
        )
        _eq(
            "version-gated pair gains the field's section (%s)" % section,
            testonly_scope_injected([gated], section),
            [(gated[0], gated[1], section)],
        )
        _eq(
            "an explicit section survives the field's (%s)" % section,
            testonly_scope_injected([always, elsewhere], section),
            [always, elsewhere],
        )
        _eq(
            "a config reference stays unscoped in every field (%s)" % section,
            testonly_scope_injected(["--config=ci", "--config", "ci", "--jobs=8"], section),
            ["--config=ci", "--config", "ci", ("--jobs=8", "", section)],
        )

def _test_config_names(ctx):
    """`testonly_config_names` extracts `--config=NAME` names from plain and
    version-gated flags, ignoring everything else."""
    _eq("no configs", testonly_config_names(["--keep_going", "--show_result=20"]), [])
    _eq("plain config", testonly_config_names(["--config=release", "--keep_going"]), ["release"])
    _eq("tuple config", testonly_config_names([("--config=ci", ">=8.0.0")]), ["ci"])
    _eq(
        "mixed",
        testonly_config_names(["--config=a", "--foo", ("--config=b", "<7"), "--config=c"]),
        ["a", "b", "c"],
    )

    # Bazel accepts `--config NAME` too, and a flag forwarded verbatim from the
    # command line arrives in exactly that shape.
    _eq("space form", testonly_config_names(["--config", "ci"]), ["ci"])
    _eq("space form mid-list", testonly_config_names(["--keep_going", "--config", "ci", "--jobs=8"]), ["ci"])
    _eq("space form, no value", testonly_config_names(["--config"]), [])
    _eq("space form, flag follows", testonly_config_names(["--config", "--keep_going"]), [])

def _test_flags_delta(ctx):
    """`testonly_flags_delta` returns the multiset difference full − base in
    full's order.

    The regression case: a `--config` whose section options render as
    `--default_override=0:common=…` sort into the overrides block AHEAD of the
    base's trailing regular flags, so the contribution is not a tail slice."""

    # Plain suffix case: contribution appended after an unchanged base.
    _eq("suffix", testonly_flags_delta(["--a", "--b"], ["--a", "--b", "--c"]), ["--c"])

    # Interleaved override ahead of a trailing base flag.
    base = ["--default_override=0:common=--foo", "--show_result=20"]
    full = [
        "--default_override=0:common=--foo",
        "--default_override=0:common=--stamp",
        "--show_result=20",
    ]
    _eq("interleaved override", testonly_flags_delta(base, full), ["--default_override=0:common=--stamp"])

    # Repeated flag: only the extra occurrence is in the delta.
    _eq("multiset", testonly_flags_delta(["--x"], ["--x", "--x"]), ["--x"])

    # Version-gated tuples compare by value.
    _eq(
        "tuple",
        testonly_flags_delta([("--a", ">=8")], [("--a", ">=8"), ("--b", "<7")]),
        [("--b", "<7")],
    )

    # No extras → empty delta.
    _eq("empty", testonly_flags_delta(["--a", "--b"], ["--a", "--b"]), [])

def _fake_rc(values = {}):
    """Stand-in `RunCommand` over a `{flag: value}` map for single-value flags
    and a `{flag: [values]}` map for repeatable flags. `command`/`version`
    kwargs are accepted and ignored."""
    return struct(
        flag_value = lambda name, command = None, version = None: values.get(name),
        flag_values = lambda name, command = None, version = None: values.get(name, []),
    )

def _fake_auth_ctx(access_token = "", owned_hosts = [], bazel_version = "8.4.2"):
    """Stand-in `ctx` for the auth path: `deployment_for_host` reports a host as
    owned iff it is in `owned_hosts`, `credentials` returns a fake login (or None
    when no token), Bazel reports `bazel_version`, the CLI runs from `_EXE`, and
    `std` reports non-TTY so `warn` stays quiet-but-valid."""
    creds = struct(access_token = access_token) if access_token else None
    owned = {h: h for h in owned_hosts}
    return struct(
        std = struct(
            io = struct(stdout = struct(is_tty = False)),
            env = struct(var = lambda name: None, current_exe = lambda: _EXE),
        ),
        bazel = struct(version = lambda: bazel_version),
        aspect = struct(auth = fake_auth(credentials = creds, owned_hosts = owned)),
    )

_TOK = "fake-access-token"
_EXE = "/opt/aspect/bin/aspect"

def _helper(host):
    return "--credential_helper=" + host + "=" + _EXE

_CACHE = "remote.acme.aspect.build"
_BES = "bes.acme.aspect.build"

def _test_auth_flags(ctx):
    """`deployment_auth_flags` registers the CLI as Bazel's credential helper only
    for an endpoint owned by a configured deployment, lacking a user authorization,
    and only when a credential resolves. The token itself is never a flag value.
    Covers the cache path, the BES path, and their combination through the one
    public entry point."""
    both = _fake_auth_ctx(access_token = _TOK, owned_hosts = [_CACHE, _BES])

    _eq("no endpoints", deployment_auth_flags(both, _fake_rc(), "build"), [])
    _eq(
        "unowned endpoints",
        deployment_auth_flags(both, _fake_rc({"--remote_cache": "grpcs://remote.buildbuddy.io", "--bes_backend": "grpcs://bes.buildbuddy.io"}), "build"),
        [],
    )
    _eq(
        "owned cache only",
        deployment_auth_flags(both, _fake_rc({"--remote_cache": "grpcs://" + _CACHE}), "build"),
        [_helper(_CACHE)],
    )
    _eq(
        "owned bes only",
        deployment_auth_flags(both, _fake_rc({"--bes_backend": "grpcs://" + _BES}), "build"),
        [_helper(_BES)],
    )
    _eq(
        "owned cache + bes together",
        deployment_auth_flags(both, _fake_rc({"--remote_cache": "grpcs://" + _CACHE, "--bes_backend": "grpcs://" + _BES}), "build"),
        [_helper(_CACHE), _helper(_BES)],
    )
    _eq(
        "user authorization header skips",
        deployment_auth_flags(both, _fake_rc({"--remote_cache": "grpcs://" + _CACHE, "--remote_header": ["authorization=Bearer user"]}), "build"),
        [],
    )
    _eq(
        "owned cache + credential helper for host",
        deployment_auth_flags(
            both,
            _fake_rc({"--remote_cache": "grpcs://" + _CACHE, "--credential_helper": ["*.acme.aspect.build=/usr/bin/helper"]}),
            "build",
        ),
        [],
    )
    _eq(
        "not logged in",
        deployment_auth_flags(
            _fake_auth_ctx(owned_hosts = [_CACHE]),
            _fake_rc({"--remote_cache": "grpcs://" + _CACHE}),
            "build",
        ),
        [],
    )

    # A `--credential_helper` registered for the BES host means Bazel will add its
    # own `authorization`, so the CLI must not inject a second one (issue #1325).
    _eq(
        "owned bes + credential helper for host",
        deployment_auth_flags(
            both,
            _fake_rc({"--bes_backend": "grpcs://" + _BES, "--credential_helper": [_BES + "=/usr/bin/helper"]}),
            "build",
        ),
        [],
    )
    _eq(
        "owned bes + unscoped credential helper",
        deployment_auth_flags(
            both,
            _fake_rc({"--bes_backend": "grpcs://" + _BES, "--credential_helper": ["/usr/bin/helper"]}),
            "build",
        ),
        [],
    )

    # The old `--experimental_credential_helper` spelling aliases to the same
    # Bazel option, so it must suppress the injected auth too.
    _eq(
        "owned bes + experimental credential helper for host",
        deployment_auth_flags(
            both,
            _fake_rc({"--bes_backend": "grpcs://" + _BES, "--experimental_credential_helper": [_BES + "=/usr/bin/helper"]}),
            "build",
        ),
        [],
    )

    # A credential helper for a different host does not suppress the injected auth.
    _eq(
        "owned bes + credential helper for other host still injects",
        deployment_auth_flags(
            both,
            _fake_rc({"--bes_backend": "grpcs://" + _BES, "--credential_helper": ["remote.buildbuddy.io=/usr/bin/helper"]}),
            "build",
        ),
        [_helper(_BES)],
    )

    # One host serving both streams needs its helper registered once.
    shared = _fake_auth_ctx(access_token = _TOK, owned_hosts = [_CACHE])
    _eq(
        "cache and bes on one host",
        deployment_auth_flags(shared, _fake_rc({"--remote_cache": "grpcs://" + _CACHE, "--bes_backend": "grpcs://" + _CACHE}), "build"),
        [_helper(_CACHE)],
    )

    # The flag Bazel understands depends on its version; before the helper
    # protocol existed the token can only travel as a header.
    def at(version):
        return deployment_auth_flags(
            _fake_auth_ctx(access_token = _TOK, owned_hosts = [_CACHE], bazel_version = version),
            _fake_rc({"--remote_cache": "grpcs://" + _CACHE}),
            "build",
        )

    _eq("bazel 6.4.0", at("6.4.0"), [_helper(_CACHE)])
    _eq("bazel 6.3.2", at("6.3.2"), ["--experimental_credential_helper=" + _CACHE + "=" + _EXE])
    _eq("bazel 5.4.1", at("5.4.1"), ["--remote_header=authorization=Bearer " + _TOK])
    _eq("non-release bazel", at(None), [_helper(_CACHE)])

# The helpers fail with a clear message when a calling task omits the required
# args. Happy-path coverage is implicit in every other subtest — the test task
# declares them all.

def _test_impl(ctx):
    _test_startup_cli_only(ctx)
    _test_startup_trait_extra_appended(ctx)
    _test_startup_input_list_not_mutated(ctx)
    _test_flags_full_chain_order(ctx)
    _test_injected_flags_carry_their_own_scope(ctx)
    _test_injected_config_requests_stay_unscoped(ctx)
    _test_a_fields_section_is_a_default_not_a_rewrite(ctx)
    _test_flag_transforms(ctx)
    _test_passthrough_flags_follow_explicit_ones(ctx)
    _test_resolving_claims_the_bucket(ctx)
    _test_disclaim_accounts_for_both_buckets(ctx)
    _test_passthrough_buckets_are_optional(ctx)
    _test_passthrough_args_shape(ctx)
    _test_passthrough_args_is_the_opt_in_subset(ctx)
    _test_value_flags_mirror_bazel(ctx)
    _test_startup_value_flags_cover_the_pre_command_slot(ctx)
    _test_flags_empty_defaults(ctx)
    _test_announce_auto_follows_ci(ctx)
    _test_announce_explicit_overrides_ci(ctx)
    _test_announce_args_shape(ctx)
    _test_config_names(ctx)
    _test_flags_delta(ctx)
    _test_auth_flags(ctx)

    # Run last: these register a real active rc on `ctx.bazel`, so keeping them
    # after the pure subtests prevents bleed-through.
    _test_setup_command_applies_to_ctx_bazel(ctx)
    _test_setup_command_trait_base_flags(ctx)
    _test_sibling_rc_transforms_startup(ctx)
    _test_injected_flags_never_reach_a_query(ctx)
    _test_per_command_fields_reach_exactly_their_command(ctx)
    _test_build_rejected_flags_have_a_home(ctx)
    _test_injected_flag_precedence(ctx)

    print("bazel_flags_test.axl: OK (30 sections)")
    return 0

bazel_flags_tests = task(
    summary = "Run the bazel flags AXL unit tests.",
    kind = "test-bazel-flags",
    group = ["dev"],
    implementation = _test_impl,
    # The helpers exercised here read CLI args off `ctx.args`. Declare
    # the standard arg set so the test task satisfies the helper
    # contracts.
    args = {
        "announce_bazel_rc": args.string(default = "auto", values = ["auto", "true", "false"], long = "announce-bazel-rc"),
        "announce_bazel_version": args.string(default = "auto", values = ["auto", "true", "false"], long = "announce-bazel-version"),
        "announce_bazel_command": args.string(default = "auto", values = ["auto", "true", "false"], long = "announce-bazel-command"),
        "bazel_flags": args.string_list(long = "bazel-flag"),
        "bazel_startup_flags": args.string_list(long = "bazel-startup-flag"),
    },
)
