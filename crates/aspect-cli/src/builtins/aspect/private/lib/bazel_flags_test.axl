"""Tests for the `bazel` flag/rc/auth helpers (in @aspect//bazel.axl).

Run with:
  aspect dev test-bazel-flags
"""

load("@aspect//bazel.axl", "BazelTrait", "aspect_endpoint_auth_flags", "bazel", "testonly_config_names", "testonly_flags_delta")

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _trait(extra_startup = [], extra = [], task_flags = []):
    """A real `BazelTrait` with just the startup/command-flag fields the helpers
    read."""
    return BazelTrait(
        extra_startup_flags = extra_startup,
        extra_flags = extra,
        task_flags = task_flags,
    )

def _fake_ctx(bazel_startup_flags = [], bazel_flags = [], trait = None):
    """Stand-in for `TaskContext` with the CLI args and trait map the helpers
    read. `ctx.traits[BazelTrait]` resolves against a plain dict — trait types
    are hashable, so a dict keyed by `BazelTrait` mimics the real trait map.
    `hasattr` returns True for declared args, satisfying `_require_arg`.

    Deliberately declares no passthrough buckets: a task may take the flag args
    without them, and the resolve helpers must tolerate that — so `claim` answers
    `[]` the way the real args store does for an arg the task never declared."""
    return struct(
        args = struct(
            bazel_startup_flags = bazel_startup_flags,
            bazel_flags = bazel_flags,
            claim = lambda name: [],
        ),
        traits = {BazelTrait: trait if trait != None else _trait()},
    )

def _passthrough_ctx(startup = [], flags = [], passthrough_startup = [], passthrough = []):
    """`_fake_ctx` plus the two passthrough buckets the CLI parser fills with the
    flags it could not attribute to a declared arg.

    Carries a `claim` that records what was claimed, mirroring the real args
    store: the resolve helpers must claim a bucket they fold in, or the runtime
    fails the invocation for dropping the user's flags. `claimed` is readable so
    a test can assert the claim actually happened."""
    buckets = {
        "bazel_passthrough_startup_flags": passthrough_startup,
        "bazel_passthrough_flags": passthrough,
    }
    claimed = []

    def _claim(name):
        claimed.append(name)
        return buckets.get(name, [])

    return struct(
        args = struct(
            bazel_startup_flags = startup,
            bazel_flags = flags,
            bazel_passthrough_startup_flags = passthrough_startup,
            bazel_passthrough_flags = passthrough,
            claim = _claim,
        ),
        claimed = claimed,
        traits = {BazelTrait: _trait()},
    )

def _announce_ctx(on_ci, version = "auto", command = "auto"):
    """Stand-in `ctx` whose `std.env.var` reports a CI marker (or not) and whose
    args carry the announce flags, so `bazel.announce.resolve` is exercisable
    deterministically."""
    env_vars = {"CI": "1"} if on_ci else {}
    return struct(
        std = struct(env = struct(var = lambda name: env_vars.get(name))),
        args = struct(announce_bazel_version = version, announce_bazel_command = command),
    )

def _test_announce_auto_follows_ci(ctx):
    _eq("auto on CI", bazel.announce.resolve(_announce_ctx(True)), (True, True))
    _eq("auto off CI", bazel.announce.resolve(_announce_ctx(False)), (False, False))

def _test_announce_explicit_overrides_ci(ctx):
    # Explicit true/false ignore the environment; distinct values catch a
    # swapped or copy-pasted (version, command) read.
    _eq(
        "(version, command) order, explicit",
        bazel.announce.resolve(_announce_ctx(True, version = "true", command = "false")),
        (True, False),
    )

def _test_announce_args_shape(ctx):
    """`bazel.announce.args` returns exactly the three flags every
    Bazel-spawning task must declare (the resolve contract)."""
    aa = bazel.announce.args("the build")
    _eq(
        "announce arg keys",
        sorted(aa.keys()),
        ["announce_bazel_command", "announce_bazel_rc", "announce_bazel_version"],
    )

def _test_startup_cli_only(ctx):
    """CLI flags pass through when the trait contributes nothing."""
    _eq(
        "startup cli-only",
        bazel.flags.resolve_startup(_fake_ctx(bazel_startup_flags = ["--client"])),
        ["--client"],
    )

def _test_startup_trait_extra_appended(ctx):
    """`trait.extra_startup_flags` is appended after CLI flags."""
    _eq(
        "startup trait extras after CLI",
        bazel.flags.resolve_startup(_fake_ctx(bazel_startup_flags = ["--client"], trait = _trait(extra_startup = ["--trait"]))),
        ["--client", "--trait"],
    )

def _test_startup_input_list_not_mutated(ctx):
    """`bazel.flags.resolve_startup` must not mutate the caller's CLI flag list
    (`ctx.args.bazel_startup_flags` is a live reference)."""
    cli = ["--client"]
    bazel.flags.resolve_startup(_fake_ctx(bazel_startup_flags = cli, trait = _trait(extra_startup = ["--trait"])))
    _eq("startup cli list untouched", cli, ["--client"])

def _test_flags_full_chain_order(ctx):
    """Slot ordering:
        ctx.args.bazel_flags + trait.extra_flags + task_flags hooks.
    Verify each slot lands where the contract promises."""
    task_hook = lambda c: ["--from-hook"]
    _eq(
        "resolve full chain",
        bazel.flags.resolve(
            _fake_ctx(bazel_flags = ["--cli"], trait = _trait(extra = ["--trait-extra"], task_flags = [task_hook])),
        ),
        ["--cli", "--trait-extra", "--from-hook"],
    )

def _test_passthrough_flags_follow_explicit_ones(ctx):
    """A flag the parser routed into a passthrough bucket joins the slot it was
    typed for, after the explicit `--bazel-flag` / `--bazel-startup-flag` values
    so the direct spelling wins a collision."""
    post_ctx = _passthrough_ctx(flags = ["--jobs=4"], passthrough = ["--jobs=8"])
    _eq("post-command passthrough", bazel.flags.resolve(post_ctx), ["--jobs=4", "--jobs=8"])

    pre_ctx = _passthrough_ctx(startup = ["--client"], passthrough_startup = ["--output_base=/tmp/o"])
    _eq("pre-command passthrough", bazel.flags.resolve_startup(pre_ctx), ["--client", "--output_base=/tmp/o"])

def _test_resolving_claims_the_bucket(ctx):
    """Folding a bucket into the flag list must also claim it — the runtime fails
    the invocation for flags left unclaimed, so a resolve that forgot to claim
    would turn a working command line into an error."""
    post_ctx = _passthrough_ctx(passthrough = ["--jobs=8"])
    bazel.flags.resolve(post_ctx)
    _eq("resolve claims post-command bucket", post_ctx.claimed, ["bazel_passthrough_flags"])

    pre_ctx = _passthrough_ctx(passthrough_startup = ["--output_base=/tmp/o"])
    bazel.flags.resolve_startup(pre_ctx)
    _eq("resolve_startup claims pre-command bucket", pre_ctx.claimed, ["bazel_passthrough_startup_flags"])

def _test_disclaim_accounts_for_both_buckets(ctx):
    """A path that spawns no Bazel claims both buckets, so a legitimate no-op run
    is not reported as having dropped the user's flags."""
    c = _passthrough_ctx(passthrough = ["--jobs=8"], passthrough_startup = ["--output_base=/tmp/o"])
    bazel.flags.disclaim_passthrough(c)
    _eq(
        "disclaim claims both buckets",
        sorted(c.claimed),
        ["bazel_passthrough_flags", "bazel_passthrough_startup_flags"],
    )

def _test_passthrough_buckets_are_optional(ctx):
    """A task that declares the flag args without the passthrough buckets keeps
    resolving — the buckets are additive, not part of the arg contract."""
    _eq("no buckets, startup", bazel.flags.resolve_startup(_fake_ctx(bazel_startup_flags = ["--client"])), ["--client"])
    _eq("no buckets, flags", bazel.flags.resolve(_fake_ctx(bazel_flags = ["--cli"])), ["--cli"])

def _test_passthrough_args_shape(ctx):
    """`bazel.flags.args` declares both buckets, one per command-line slot, plus
    the value-flag list the post-command bucket reads arities from."""
    fa = bazel.flags.args("the build")
    _eq(
        "flag arg keys",
        sorted(fa.keys()),
        [
            "bazel_flags",
            "bazel_passthrough_flags",
            "bazel_passthrough_startup_flags",
            "bazel_startup_flags",
            "bazel_value_flags",
        ],
    )

def _test_value_flags_mirror_bazel(ctx):
    """The generated list carries Bazel's value-taking flags and none of its
    booleans — a boolean in here would swallow the following target pattern."""
    listed = bazel.flags.BAZEL_VALUE_FLAGS
    for flag in ["-c", "-j", "--jobs", "--config", "--compilation_mode", "--test_output"]:
        if flag not in listed:
            fail("expected %s in BAZEL_VALUE_FLAGS" % flag)
    for flag in ["-k", "--keep_going", "--remote_download_all", "--nobuild"]:
        if flag in listed:
            fail("%s takes no value; listing it would eat the next argument" % flag)
    # Label-shaped flags are excluded on purpose: Bazel requires `=` for them.
    for flag in listed:
        if flag.startswith("--//") or ":" in flag:
            fail("label-shaped flag %s must not be listed" % flag)

def _test_flags_empty_defaults(ctx):
    """No CLI flags, no trait additions → empty result."""
    _eq(
        "resolve empty",
        bazel.flags.resolve(_fake_ctx()),
        [],
    )

def _test_setup_command_applies_to_ctx_bazel(ctx):
    """End-to-end check on a real `ctx`:
      - the returned `RunCommand` is registered as the active rc;
      - the caller's `base_flags` appear in its `build` expansion;
      - the trait's `extra_startup_flags` land on the rc's startup flags;
      - `--ignore_all_rc_files` is present.
    The workspace `.bazelrc` is parsed as a side effect, which is fine
    for a dev test."""
    sentinel = "/tmp/test-setup-command-sentinel"

    # Inject a real trait into the live trait map and let setup_command read it
    # back via ctx.traits[BazelTrait] — exercises the production (no-override) path.
    ctx.traits[BazelTrait] = _trait(extra_startup = ["--output_base=" + sentinel])

    rc = bazel.setup_command(ctx, "build", base_flags = ["--from-base"])

    if rc != ctx.bazel.active_rc():
        fail("setup_command — returned rc not registered as active")
    if "--from-base" not in rc.expand(command = "build"):
        fail("setup_command — base_flag not in build expansion: %r" % rc.expand(command = "build"))

    startup = list(rc.startup_flags())
    if ("--output_base=" + sentinel) not in startup:
        fail("setup_command — trait --output_base not on rc startup flags: %r" % startup)
    if "--ignore_all_rc_files" not in startup:
        fail("setup_command — --ignore_all_rc_files not present: %r" % startup)

def _test_sibling_rc_transforms_startup(ctx):
    """`bazel.sibling_rc` mirrors setup_command's flags but runs the startup
    flags through the transform, and does NOT register itself as active."""
    base = "/tmp/test-sibling-rc-base"
    ctx.traits[BazelTrait] = _trait(extra_startup = ["--output_base=" + base], extra = ["--from-extra"])
    active = bazel.setup_command(ctx, "build")

    sib = bazel.sibling_rc(ctx, lambda flags: [f + "-checksum" if f.startswith("--output_base=") else f for f in flags])

    startup = list(sib.startup_flags())
    if ("--output_base=" + base + "-checksum") not in startup:
        fail("sibling_rc — transform not applied to startup: %r" % startup)
    if ("--output_base=" + base) in startup:
        fail("sibling_rc — untransformed --output_base leaked: %r" % startup)
    if "--from-extra" not in sib.expand(command = "build"):
        fail("sibling_rc — trait extra_flags missing from expansion: %r" % sib.expand(command = "build"))

    # Building the sibling must not disturb the active rc.
    if ctx.bazel.active_rc() != active:
        fail("sibling_rc — must not change the active run command")

def _test_config_names(ctx):
    """`testonly_config_names` extracts `--config=NAME` names from plain and
    version-gated flags, ignoring everything else."""
    _eq("no configs", testonly_config_names(["--keep_going", "--show_result=20"]), [])
    _eq("plain config", testonly_config_names(["--config=release", "--keep_going"]), ["release"])
    _eq("tuple config", testonly_config_names([("--config=ci", ">=8.0.0")]), ["ci"])
    _eq(
        "mixed",
        testonly_config_names(["--config=a", "--foo", ("--config=b", "<7"), "--config=c"]),
        ["a", "b", "c"],
    )

    # Bazel accepts `--config NAME` too, and a flag forwarded verbatim from the
    # command line arrives in exactly that shape.
    _eq("space form", testonly_config_names(["--config", "ci"]), ["ci"])
    _eq("space form mid-list", testonly_config_names(["--keep_going", "--config", "ci", "--jobs=8"]), ["ci"])
    _eq("space form, no value", testonly_config_names(["--config"]), [])
    _eq("space form, flag follows", testonly_config_names(["--config", "--keep_going"]), [])

def _test_flags_delta(ctx):
    """`testonly_flags_delta` returns the multiset difference full − base in
    full's order.

    The regression case: a `--config` whose section options render as
    `--default_override=0:common=…` sort into the overrides block AHEAD of the
    base's trailing regular flags, so the contribution is not a tail slice."""

    # Plain suffix case: contribution appended after an unchanged base.
    _eq("suffix", testonly_flags_delta(["--a", "--b"], ["--a", "--b", "--c"]), ["--c"])

    # Interleaved override ahead of a trailing base flag.
    base = ["--default_override=0:common=--foo", "--show_result=20"]
    full = [
        "--default_override=0:common=--foo",
        "--default_override=0:common=--stamp",
        "--show_result=20",
    ]
    _eq("interleaved override", testonly_flags_delta(base, full), ["--default_override=0:common=--stamp"])

    # Repeated flag: only the extra occurrence is in the delta.
    _eq("multiset", testonly_flags_delta(["--x"], ["--x", "--x"]), ["--x"])

    # Version-gated tuples compare by value.
    _eq(
        "tuple",
        testonly_flags_delta([("--a", ">=8")], [("--a", ">=8"), ("--b", "<7")]),
        [("--b", "<7")],
    )

    # No extras → empty delta.
    _eq("empty", testonly_flags_delta(["--a", "--b"], ["--a", "--b"]), [])

def _fake_rc(values = {}):
    """Stand-in `RunCommand` over a `{flag: value}` map for single-value flags
    and a `{flag: [values]}` map for repeatable flags. `command`/`version`
    kwargs are accepted and ignored."""
    return struct(
        flag_value = lambda name, command = None, version = None: values.get(name),
        flag_values = lambda name, command = None, version = None: values.get(name, []),
    )

def _fake_auth_ctx(access_token = "", owned_hosts = []):
    """Stand-in `ctx` for the auth path: `deployment_for_host` reports a host as
    owned iff it is in `owned_hosts`, `credentials` returns a fake login (or None
    when no token), and `std` reports non-TTY so `warn` stays quiet-but-valid."""
    creds = struct(access_token = access_token) if access_token else None
    owned = {h: h for h in owned_hosts}
    return struct(
        std = struct(
            io = struct(stdout = struct(is_tty = False)),
            env = struct(var = lambda name: None),
        ),
        aspect = struct(auth = struct(
            deployment_for_host = lambda host: owned.get(host),
            credentials = lambda profile = None, required = True: creds,
        )),
    )

_TOK = "fake-access-token"

_CACHE = "remote.acme.aspect.build"
_BES = "bes.acme.aspect.build"

def _test_auth_flags(ctx):
    """`aspect_endpoint_auth_flags` attaches `--remote_header`/`--bes_header` only for an
    endpoint owned by a configured deployment, lacking a user authorization
    header, and only when a credential resolves. Covers the cache path, the BES
    path, and their combination through the one public entry point."""
    both = _fake_auth_ctx(access_token = _TOK, owned_hosts = [_CACHE, _BES])

    _eq("no endpoints", aspect_endpoint_auth_flags(both, _fake_rc(), "build"), [])
    _eq(
        "unowned endpoints",
        aspect_endpoint_auth_flags(both, _fake_rc({"--remote_cache": "grpcs://remote.buildbuddy.io", "--bes_backend": "grpcs://bes.buildbuddy.io"}), "build"),
        [],
    )
    _eq(
        "owned cache only",
        aspect_endpoint_auth_flags(both, _fake_rc({"--remote_cache": "grpcs://" + _CACHE}), "build"),
        ["--remote_header=authorization=Bearer " + _TOK],
    )
    _eq(
        "owned bes only",
        aspect_endpoint_auth_flags(both, _fake_rc({"--bes_backend": "grpcs://" + _BES}), "build"),
        ["--bes_header=authorization=Bearer " + _TOK],
    )
    _eq(
        "owned cache + bes together",
        aspect_endpoint_auth_flags(both, _fake_rc({"--remote_cache": "grpcs://" + _CACHE, "--bes_backend": "grpcs://" + _BES}), "build"),
        ["--remote_header=authorization=Bearer " + _TOK, "--bes_header=authorization=Bearer " + _TOK],
    )
    _eq(
        "user authorization header skips",
        aspect_endpoint_auth_flags(both, _fake_rc({"--remote_cache": "grpcs://" + _CACHE, "--remote_header": ["authorization=Bearer user"]}), "build"),
        [],
    )
    _eq(
        "owned cache + credential helper for host",
        aspect_endpoint_auth_flags(
            both,
            _fake_rc({"--remote_cache": "grpcs://" + _CACHE, "--credential_helper": ["*.acme.aspect.build=/usr/bin/helper"]}),
            "build",
        ),
        [],
    )
    _eq(
        "not logged in",
        aspect_endpoint_auth_flags(
            _fake_auth_ctx(owned_hosts = [_CACHE]),
            _fake_rc({"--remote_cache": "grpcs://" + _CACHE}),
            "build",
        ),
        [],
    )

    # A `--credential_helper` registered for the BES host means Bazel will add its
    # own `authorization`, so the CLI must not inject a second one (issue #1325).
    _eq(
        "owned bes + credential helper for host",
        aspect_endpoint_auth_flags(
            both,
            _fake_rc({"--bes_backend": "grpcs://" + _BES, "--credential_helper": [_BES + "=/usr/bin/helper"]}),
            "build",
        ),
        [],
    )
    _eq(
        "owned bes + unscoped credential helper",
        aspect_endpoint_auth_flags(
            both,
            _fake_rc({"--bes_backend": "grpcs://" + _BES, "--credential_helper": ["/usr/bin/helper"]}),
            "build",
        ),
        [],
    )

    # The old `--experimental_credential_helper` spelling aliases to the same
    # Bazel option, so it must suppress the injected auth too.
    _eq(
        "owned bes + experimental credential helper for host",
        aspect_endpoint_auth_flags(
            both,
            _fake_rc({"--bes_backend": "grpcs://" + _BES, "--experimental_credential_helper": [_BES + "=/usr/bin/helper"]}),
            "build",
        ),
        [],
    )

    # A credential helper for a different host does not suppress the injected auth.
    _eq(
        "owned bes + credential helper for other host still injects",
        aspect_endpoint_auth_flags(
            both,
            _fake_rc({"--bes_backend": "grpcs://" + _BES, "--credential_helper": ["remote.buildbuddy.io=/usr/bin/helper"]}),
            "build",
        ),
        ["--bes_header=authorization=Bearer " + _TOK],
    )

# The helpers fail with a clear message when a calling task omits the required
# args. Happy-path coverage is implicit in every other subtest — the test task
# declares them all.

def _test_impl(ctx):
    _test_startup_cli_only(ctx)
    _test_startup_trait_extra_appended(ctx)
    _test_startup_input_list_not_mutated(ctx)
    _test_flags_full_chain_order(ctx)
    _test_passthrough_flags_follow_explicit_ones(ctx)
    _test_resolving_claims_the_bucket(ctx)
    _test_disclaim_accounts_for_both_buckets(ctx)
    _test_passthrough_buckets_are_optional(ctx)
    _test_passthrough_args_shape(ctx)
    _test_value_flags_mirror_bazel(ctx)
    _test_flags_empty_defaults(ctx)
    _test_announce_auto_follows_ci(ctx)
    _test_announce_explicit_overrides_ci(ctx)
    _test_announce_args_shape(ctx)
    _test_config_names(ctx)
    _test_flags_delta(ctx)
    _test_auth_flags(ctx)

    # Run last: these register a real active rc on `ctx.bazel`, so keeping them
    # after the pure subtests prevents bleed-through.
    _test_setup_command_applies_to_ctx_bazel(ctx)
    _test_sibling_rc_transforms_startup(ctx)
    print("bazel_flags_test.axl: OK (19 sections)")
    return 0

bazel_flags_tests = task(
    summary = "Run the bazel flags AXL unit tests.",
    kind = "test-bazel-flags",
    group = ["dev"],
    implementation = _test_impl,
    # The helpers exercised here read CLI args off `ctx.args`. Declare
    # the standard arg set so the test task satisfies the helper
    # contracts.
    args = {
        "announce_bazel_rc": args.string(default = "auto", values = ["auto", "true", "false"], long = "announce-bazel-rc"),
        "announce_bazel_version": args.string(default = "auto", values = ["auto", "true", "false"], long = "announce-bazel-version"),
        "announce_bazel_command": args.string(default = "auto", values = ["auto", "true", "false"], long = "announce-bazel-command"),
        "bazel_flags": args.string_list(long = "bazel-flag"),
        "bazel_startup_flags": args.string_list(long = "bazel-startup-flag"),
    },
)
