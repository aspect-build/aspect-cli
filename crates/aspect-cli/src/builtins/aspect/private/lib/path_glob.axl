"""Glob matching for filesystem paths.

`match_path(pattern, path)` returns True if PATH matches PATTERN. The
match is case-sensitive (POSIX path semantics) and segment-aware:

  *   matches any sequence of characters except `/`
  ?   matches exactly one character except `/`
  **  matches zero or more path segments (must be a whole segment, i.e.
      `**` between two `/` boundaries: patterns like `a**b` are treated
      as two single-`*` wildcards followed by literal characters). A
      trailing `**` needs at least one: `vendor/**` does not match `vendor`.

A leading `.` is an ordinary character, so `*` matches `.bazelrc`. A
trailing slash is trimmed (`vendor/` ≡ `vendor`). Any other empty segment
(`/a`, `a//b`) matches an empty segment of the path literally.

Examples:
  match_path("*.lock", "Cargo.lock")               → True
  match_path("*.lock", "subdir/Cargo.lock")        → False
  match_path("vendor/*", "vendor/foo")             → True
  match_path("vendor/*", "vendor/foo/bar")         → False
  match_path("vendor/**", "vendor/foo/bar/baz")    → True
  match_path("**/foo", "a/b/foo")                  → True
  match_path("**/foo", "foo")                      → True
  match_path("a/**/b", "a/x/y/b")                  → True

Implementation note: this is a pure-Starlark segment matcher, so the work
per match is kept small: a segment with no wildcard is compared, one that
is `*` and a literal is a suffix check, and a `**` followed by no other
`**` matches only the split that leaves its tail one name segment per
pattern segment. A change of thousands of files against a dozen
`**/<name>` patterns then costs one segment comparison per pattern each.
"""

def _match_chars(pat: str, name: str) -> bool:
    """Match a single segment-level pattern against a name (no `/`).

    Supports `*` (any run of characters, including none) and `?` (exactly
    one character). A pattern with neither is compared as a string, and
    `*` followed by literals is a suffix check. Anything else runs the
    standard one-star-at-a-time backtracking loop, capped because Starlark
    has no `while`.

    Bound rationale: each backtrack increments `star_ni`, and the match
    fails once the last `*` has taken the whole name, since a longer run
    leaves the rest of the pattern even less to match. Between backtracks
    we do at most len(pat) char advances. Worst case is therefore
    O(len(pat) * len(name)), e.g. pattern `*?` against an N-character
    string takes ~2N iterations because each `?` advance is followed by
    a backtrack to `star_ni + 1`. A cap of `len(pat) + len(name) + 8`
    would be too small: `*?` against an 11-character name runs out before
    it reaches the match and reports a false negative.
    """
    if "*" not in pat and "?" not in pat:
        return pat == name
    if pat.startswith("*") and "*" not in pat[1:] and "?" not in pat:
        return name.endswith(pat[1:])
    pi = 0
    ni = 0
    star_pi = -1
    star_ni = 0
    for _ in range(len(pat) * len(name) + len(pat) + len(name) + 8):
        if ni < len(name) and pi < len(pat) and (pat[pi] == "?" or pat[pi] == name[ni]):
            pi += 1
            ni += 1
        elif pi < len(pat) and pat[pi] == "*":
            star_pi = pi
            star_ni = ni
            pi += 1
        elif star_pi >= 0 and star_ni < len(name):
            star_ni += 1
            pi = star_pi + 1
            ni = star_ni
        else:
            return False
        if pi == len(pat) and ni == len(name):
            return True
    return pi == len(pat) and ni == len(name)

def _match_segments(pat_segs: list[str], name_segs: list[str]) -> bool:
    """Match a list of pattern segments against a list of name segments.

    `**` segments match zero or more name segments. All other segments
    match a single name segment via _match_chars (which supports `*` and
    `?` within a segment).

    A `**` with another `**` after it tries every split, recursing on the
    rest; the recursion depth is at most the number of `**` segments in the
    pattern (typically 0-2). The last `**` tries only one split: every
    segment after it takes exactly one name segment, so its tail must line
    up with the path's last segments.
    """
    pi = 0
    ni = 0
    pn = len(pat_segs)
    nn = len(name_segs)

    # Walk in lockstep until we hit a `**` or run out.
    for _ in range(pn + nn + 8):
        if pi == pn:
            return ni == nn
        if pat_segs[pi] == "**":
            tail = pat_segs[pi + 1:]
            if not tail:
                # Trailing `**` needs at least one name segment, so that
                # `vendor/**` does not match the `vendor` directory itself.
                return ni < nn
            if "**" not in tail:
                k = nn - ni - len(tail)
                return k >= 0 and _match_segments(tail, name_segs[ni + k:])
            for k in range(nn - ni + 1):
                if _match_segments(tail, name_segs[ni + k:]):
                    return True
            return False
        if ni == nn:
            return False
        if not _match_chars(pat_segs[pi], name_segs[ni]):
            return False
        pi += 1
        ni += 1
    return pi == pn and ni == nn

def match_path(pattern: str, path: str) -> bool:
    """Match a single path against a glob pattern. Empty pattern → no match."""
    if not pattern:
        return False

    # Trim trailing slash for friendliness: `vendor/` and `vendor` mean
    # the same thing for our use case.
    if pattern.endswith("/"):
        pattern = pattern[:-1]
    if not pattern:
        return False
    return _match_segments(pattern.split("/"), path.split("/"))

def match_any(patterns: list[str], path: str) -> bool:
    """Convenience: True if PATH matches at least one of the given patterns."""
    for p in patterns:
        if match_path(p, path):
            return True
    return False
