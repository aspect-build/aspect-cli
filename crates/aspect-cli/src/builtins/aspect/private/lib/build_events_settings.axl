"""How the CLI streams a build's events to BES backends: the `BuildEvents`
feature and the private `_BuildEventsSettings` trait it writes.

The retry, buffer and timeout options apply to every backend the CLI streams to
itself: a task's `--bes-backend`, the deployment `--remote` wires, and a
Workflows runner's own. A backend Bazel uploads to through its `--bes_backend`
is Bazel's, and these leave it alone.

`max_event_bytes` is the largest message those backends accept. Each gRPC sink
carries it (`bazel.build_events.grpc`'s `max_event_bytes`), and the runtime
holds every event of a build to the smallest among the build's gRPC sinks, for
every consumer: BES backends, a `--build_event_binary_file`, the task history
and AXL event iterators. A build with no gRPC sink is held to the runtime's
4 MiB, whatever the option says. Bazel writes a failed action's whole command line into its event, params
file expanded, so a large action makes an event past a backend's receive limit,
which refuses it and loses the rest of the build. That command line is cut from
the end to fit; any other event over the limit is passed on unchanged. Either
way the CLI warns.

The options are set on the command line (`--build-events:max-retries`) or in
`config.axl` (`ctx.features[BuildEvents].args.max_retries`). The feature checks
them and writes them onto `_BuildEventsSettings`, which `grpc_sink`
(`bazel/build_events.axl`) reads through `build_events_settings` for every gRPC
sink the CLI builds, so a task streams under them by passing those sinks to the
build. Only the feature writes that trait, so config has one place to set them,
and a value the sinks read has been checked. With the feature disabled the
trait keeps its defaults, the runtime's own.

A negative count, a malformed duration, a `max_event_bytes` under 64 KiB, or a
value past what the runtime takes (which only `config.axl` can set) is
refused, without a traceback and naming the option, before the task runs.

`feature/build_events.axl` re-exports `BuildEvents` at its public path.
"""

# The options' bounds: the smallest message a backend can be held to, and the
# largest values the runtime takes. `bazel.build_events.grpc` reads
# `max_retries` as an i32, and the byte sizes are read as i64. A command-line
# flag is held to i32 by its parser; a `config.axl` value is not.
_MIN_MAX_EVENT_BYTES = 64 * 1024
_MAX_INT32 = 2147483647
_MAX_INT64 = 9223372036854775807

_MAX_RETRIES = 4
_RETRY_MIN_DELAY = "1s"
_TIMEOUT = "0s"
_MAX_EVENT_BYTES = 4 * 1024 * 1024

_UsageError = error.type(traceback = False)

def _refuse_outside(name: str, value: int, least: int, most: int, note: str = ""):
    """Fail the task, without a traceback, when `name`'s `value` is under
    `least` or over `most`; `note` follows the lower bound."""
    if value < least:
        fail(_UsageError("%s must be at least %d%s, got %d" % (name, least, note, value)))
    if value > most:
        fail(_UsageError("%s must be at most %d, got %d" % (name, most, value)))

def _refuse_non_duration(name: str, value: str, kwarg: str):
    """Fail the task, without a traceback, when `name`'s `value` is not a
    duration `bazel.build_events.grpc` takes as `kwarg`. The sink built to
    check it is never bound, so nothing is dialed; a buffer budget is given so
    `ASPECT_CLI_BES_RETRY_MAX_BUFFER_BYTES` is not read, and warned about, in a
    task that streams nowhere."""
    err, _ = catch(lambda: bazel.build_events.grpc(uri = "grpc://localhost", retry_max_buffer_bytes = 1, **{kwarg: value}))
    if err != None:
        fail(_UsageError("%s must be a duration such as '500ms', '2s' or '1m', got '%s'" % (name, value)))

_BuildEventsSettings = trait(
    max_retries = attr(int, default = _MAX_RETRIES, description = "Set from `BuildEvents`'s `max_retries` option."),
    retry_min_delay = attr(str, default = _RETRY_MIN_DELAY, description = "Set from `BuildEvents`'s `retry_min_delay` option."),
    retry_max_buffer_bytes = attr(int | None, default = None, description = "Set from `BuildEvents`'s `retry_max_buffer_bytes` option; None (the option's 0) leaves the budget to the runtime."),
    timeout = attr(str, default = _TIMEOUT, description = "Set from `BuildEvents`'s `timeout` option."),
    max_event_bytes = attr(int | None, default = None, description = "Set from `BuildEvents`'s `max_event_bytes` option; None (the option's default) is the runtime's 4 MiB."),
)

def _build_events_impl(ctx: FeatureContext):
    _refuse_outside("--build-events:max-retries", ctx.args.max_retries, 0, _MAX_INT32)
    _refuse_outside("--build-events:retry-max-buffer-bytes", ctx.args.retry_max_buffer_bytes, 0, _MAX_INT64)
    _refuse_outside("--build-events:max-event-bytes", ctx.args.max_event_bytes, _MIN_MAX_EVENT_BYTES, _MAX_INT64, " (64 KiB)")
    _refuse_non_duration("--build-events:retry-min-delay", ctx.args.retry_min_delay, "retry_min_delay")
    _refuse_non_duration("--build-events:timeout", ctx.args.timeout, "timeout")
    settings = ctx.traits[_BuildEventsSettings]
    settings.max_retries = ctx.args.max_retries
    settings.retry_min_delay = ctx.args.retry_min_delay
    settings.retry_max_buffer_bytes = ctx.args.retry_max_buffer_bytes or None
    settings.timeout = ctx.args.timeout
    settings.max_event_bytes = None if ctx.args.max_event_bytes == _MAX_EVENT_BYTES else ctx.args.max_event_bytes

BuildEvents = feature(
    display_name = "Build events",
    summary = "Retries, buffering, timeout and the event size limit for the build events the CLI streams.",
    implementation = _build_events_impl,
    args = {
        "max_retries": args.int(
            default = _MAX_RETRIES,
            description = "Reconnect attempts after a transient BES error before a backend is given up on. 0 disables retry; a backend never fails the build either way.",
        ),
        "retry_min_delay": args.string(
            default = _RETRY_MIN_DELAY,
            description = "Base delay of the full-jitter exponential backoff between reconnects, as a duration ('500ms', '2s', '1m').",
        ),
        "retry_max_buffer_bytes": args.int(
            default = 0,
            description = "Byte budget for the events a backend has not acknowledged yet, kept for replay after a reconnect. Past it the oldest are dropped, so a later reconnect replays an incomplete range; the upload itself goes on. 0 (the default) uses ASPECT_CLI_BES_RETRY_MAX_BUFFER_BYTES, or 256 MiB when that is unset.",
        ),
        "timeout": args.string(
            default = _TIMEOUT,
            description = "Overall deadline for each backend's upload, as a duration; '0s' (the default) sets none. Mirrors Bazel's --bes_timeout.",
        ),
        "max_event_bytes": args.int(
            default = _MAX_EVENT_BYTES,
            description = "The largest message the BES backends accept, at least 64 KiB; 4 MiB (the default) is gRPC's. Every event of a build streamed to one is held to it, less 4 KiB for the request wrapping the event: a failed action's command line is cut from the end to fit, and any other event over it is passed on unchanged, with a warning either way.",
        ),
    },
)

# The `BuildEvents` options as `grpc_sink` reads them, through the accessors.
build_events_settings = struct(
    max_retries = lambda ctx: ctx.traits[_BuildEventsSettings].max_retries,
    retry_min_delay = lambda ctx: ctx.traits[_BuildEventsSettings].retry_min_delay,
    retry_max_buffer_bytes = lambda ctx: ctx.traits[_BuildEventsSettings].retry_max_buffer_bytes,
    timeout = lambda ctx: ctx.traits[_BuildEventsSettings].timeout,
    max_event_bytes = lambda ctx: ctx.traits[_BuildEventsSettings].max_event_bytes,
)
