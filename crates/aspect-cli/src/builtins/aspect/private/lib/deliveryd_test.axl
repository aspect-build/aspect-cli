"""Unit tests for lib/deliveryd.axl.

A struct-based fake `ctx` (like `deployment_flags_test.axl`) serves canned HTTP
responses keyed by `"<METHOD> <path>"` and records every request, so each verb
can be asserted on the wire: which endpoint was called, with which field names.

`fail()` cannot be caught in Starlark, so the error paths (non-2xx, corrupt JSON)
are not exercised here; an unreachable daemon is, since that surfaces through
`.status` instead of failing.
"""

load("./deliveryd.axl", "deliveryd", parse_endpoint = "testonly_parse_endpoint")

_SOCKET = "unix:///run/deliveryd.sock"
_BASE = "http://localhost"

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _res(status, body = ""):
    return struct(status = status, body = body if type(body) == "string" else json.encode(body), headers = [])

def _future(res):
    return struct(catch = lambda: struct(block = lambda: (None, res)), block = lambda: res)

def _error_future(message):
    return struct(catch = lambda: struct(block = lambda: (error(message), None)), block = lambda: fail(message))

def _ctx(responses, calls, endpoint = _SOCKET):
    """Fake ctx whose http serves `responses` ({"<METHOD> <path>": res | None},
    None meaning a transport error) and appends each request to `calls`. A list
    value is served in order, one element per request, repeating the last."""

    def respond(method, url, data):
        path = url[len(_BASE):]
        key = method + " " + path
        calls.append(struct(method = method, path = path, body = json.try_decode(data, None) if data else None))
        if key not in responses:
            fail("unexpected deliveryd request: " + key)
        res = responses[key]
        if type(res) == "list":
            n = len([c for c in calls if c.method == method and c.path == path])
            res = res[min(n, len(res)) - 1]
        if res == None:
            return _error_future("connection refused")
        return _future(res)

    http = struct(
        get = lambda url, headers = {}, unix_socket = None: respond("GET", url, None),
        post = lambda url, headers = {}, data = None, unix_socket = None: respond("POST", url, data),
    )
    return struct(
        http = lambda: http,
        std = struct(env = struct(var = lambda name: endpoint)),
    )

def _client(responses, calls, pauses = None, **kwargs):
    """`pauses` collects the ms of each retry pause instead of sleeping."""
    recorded = pauses if pauses != None else []
    return deliveryd.new(
        _ctx(responses, calls),
        host = kwargs.pop("host", "gh"),
        prefix = kwargs.pop("prefix", "deliver"),
        commit = kwargs.pop("commit", "abc123"),
        signature = kwargs.pop("signature", "https://ci/build/7"),
        pause = lambda ms: recorded.append(ms),
        **kwargs
    )

def _test_parse_endpoint(ctx):
    (base, sock) = parse_endpoint("unix:///run/deliveryd.sock")
    _eq("unix → base", base, "http://localhost")
    _eq("unix → socket", sock, "/run/deliveryd.sock")

    (base, sock) = parse_endpoint("http://deliveryd.local:8080")
    _eq("http → base passthrough", base, "http://deliveryd.local:8080")
    _eq("http → no socket", sock, None)

    (base, sock) = parse_endpoint("https://deliveryd.example.com")
    _eq("https → base passthrough", base, "https://deliveryd.example.com")
    _eq("https → no socket", sock, None)

def _test_probe_fills_status(ctx):
    calls = []
    dd = _client({"GET /health": _res(200, "ok")}, calls)
    _eq("probes /health once", [c.path for c in calls], ["/health"])
    _eq("ok", dd.status.ok, True)
    _eq("version", dd.status.version, 1)
    _eq("status", dd.status.status, "ok")
    _eq("describe", dd.describe, "API v1")
    _eq("endpoint from env", dd.endpoint, _SOCKET)
    _eq("no storage stats from the daemon", dd.status.storage.reachable, False)

def _test_unset_endpoint_reports_status(ctx):
    # No endpoint anywhere: not a crash, a startup status the task reports.
    dd = deliveryd.new(_ctx({}, [], endpoint = None), host = "gh", prefix = "deliver")
    _eq("unset endpoint → not ok", dd.status.ok, False)
    _eq("unset endpoint → names the variable", deliveryd.ENDPOINT_ENV in dd.status.error, True)
    _eq("unset endpoint → no endpoint to print", dd.endpoint, "")
    _eq("unset endpoint → still describes itself", dd.describe, "deliveryd")

def _test_unreachable_reports_status(ctx):
    calls = []
    pauses = []
    dd = _client({"GET /health": None}, calls, pauses)
    _eq("unreachable → not ok", dd.status.ok, False)
    _eq("unreachable → error carries the transport reason", dd.status.error, "connection refused")
    _eq("unreachable → probed three times", [c.path for c in calls], ["/health", "/health", "/health"])
    _eq("unreachable → paused between probes", pauses, [1000, 1000])

def _test_probe_retries_a_503_then_succeeds(ctx):
    calls = []
    pauses = []
    dd = _client({"GET /health": [_res(503, "unhealthy: redis connection failed"), _res(200, "ok")]}, calls, pauses)
    _eq("503 then 200 → ok", dd.status.ok, True)
    _eq("503 then 200 → two probes", len(calls), 2)
    _eq("503 then 200 → one pause", pauses, [1000])

def _test_probe_gives_up_after_persistent_503(ctx):
    calls = []
    pauses = []
    dd = _client({"GET /health": _res(503, "unhealthy: redis connection failed")}, calls, pauses)
    _eq("persistent 503 → not ok", dd.status.ok, False)
    _eq("persistent 503 → error names the last answer", dd.status.error, "HTTP 503: unhealthy: redis connection failed")
    _eq("persistent 503 → three probes", len(calls), 3)
    _eq("persistent 503 → two pauses", pauses, [1000, 1000])

def _test_probe_does_not_retry_other_errors(ctx):
    calls = []
    pauses = []
    dd = _client({"GET /health": _res(500, "boom")}, calls, pauses)
    _eq("500 → not ok", dd.status.ok, False)
    _eq("500 → one probe", len(calls), 1)
    _eq("500 → no pause", pauses, [])

def _test_probe_attempts_is_configurable(ctx):
    calls = []
    dd = _client({"GET /health": None}, calls, probe_attempts = 1)
    _eq("one attempt → one probe", len(calls), 1)
    _eq("one attempt → not ok", dd.status.ok, False)

def _test_record_posts_commit_keyed_fields(ctx):
    calls = []
    dd = _client({"GET /health": _res(200, "ok"), "POST /record": _res(200, "ok")}, calls)
    dd.record("//pkg:a", "digest-a")
    _eq("record → POST /record", (calls[-1].method, calls[-1].path), ("POST", "/record"))
    _eq("record payload", calls[-1].body, {
        "ci_host": "gh",
        "commit_sha": "abc123",
        "workspace": "deliver",
        "label": "//pkg:a",
        "output_sha": "digest-a",
    })

def _test_query_narrows_to_delivered_labels(ctx):
    calls = []
    dd = _client({
        "GET /health": _res(200, "ok"),
        "POST /query": _res(200, {"targets": [
            {"label": "//pkg:a", "output_sha": "digest-a", "delivered": True, "delivered_by": "https://ci/build/1"},
            {"label": "//pkg:b", "output_sha": "digest-b", "delivered": False},
            {"label": "//pkg:gone", "output_sha": "digest-x", "delivered": True, "delivered_by": "https://ci/build/0"},
        ]}),
    }, calls)

    got = dd.query({"//pkg:a": "digest-a", "//pkg:b": "digest-b"})
    _eq("query → POST /query", (calls[-1].method, calls[-1].path), ("POST", "/query"))
    _eq("query payload is commit-keyed", calls[-1].body, {"ci_host": "gh", "commit_sha": "abc123", "workspace": "deliver"})
    _eq("only delivered, only asked-about", got, {"//pkg:a": "https://ci/build/1"})

def _test_deliver_and_delete(ctx):
    calls = []
    dd = _client({
        "GET /health": _res(200, "ok"),
        "POST /deliver": _res(200, "ok"),
        "POST /artifact/delete": _res(200, "ok"),
    }, calls)

    dd.deliver("//pkg:a", "digest-a")
    _eq("deliver → POST /deliver", calls[-1].path, "/deliver")
    _eq("deliver payload", calls[-1].body, {
        "ci_host": "gh",
        "output_sha": "digest-a",
        "workspace": "deliver",
        "signature": "https://ci/build/7",
    })

    # The daemon stores only the signature; meta is accepted and dropped.
    dd.deliver("//pkg:a", "digest-a", meta = {"image": "sha256:beef"})
    _eq("meta is not sent", "meta" in calls[-1].body, False)

    dd.delete("digest-a")
    _eq("delete → POST /artifact/delete", calls[-1].path, "/artifact/delete")
    _eq("delete payload", calls[-1].body, {"ci_host": "gh", "output_sha": "digest-a", "workspace": "deliver"})

def _test_health_reprobes(ctx):
    calls = []
    dd = _client({"GET /health": [_res(200, "ok"), _res(503, "unhealthy: redis connection failed")]}, calls)
    health = dd.health()
    _eq("health re-probes once, no retry", [c.path for c in calls], ["/health", "/health"])
    _eq("health reports the daemon's answer", (health.ok, health.error), (False, "HTTP 503: unhealthy: redis connection failed"))

_UNIT_TESTS = [
    _test_parse_endpoint,
    _test_probe_fills_status,
    _test_unset_endpoint_reports_status,
    _test_unreachable_reports_status,
    _test_probe_retries_a_503_then_succeeds,
    _test_probe_gives_up_after_persistent_503,
    _test_probe_does_not_retry_other_errors,
    _test_probe_attempts_is_configurable,
    _test_record_posts_commit_keyed_fields,
    _test_query_narrows_to_delivered_labels,
    _test_deliver_and_delete,
    _test_health_reprobes,
]

def _test_impl(ctx):
    for t in _UNIT_TESTS:
        t(ctx)
    print("deliveryd.axl: OK (%d tests)" % len(_UNIT_TESTS))
    return 0

deliveryd_tests = task(
    summary = "Run the deliveryd AXL unit tests.",
    kind = "test-deliveryd",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
