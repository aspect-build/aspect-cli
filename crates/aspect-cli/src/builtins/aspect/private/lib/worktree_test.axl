"""Unit tests for lib/worktree.axl — pool keying, reuse scoring, and warmth.

Run with:
  aspect dev test-worktree

The URL cases are taken from a real machine rather than invented: one clone
there carries `ssh://git@github.com/...` with no `.git` suffix, a scp-like
GitLab mirror of the same code, and a fork. A pool key that collapses the first
two spellings but not the two hosts is the behaviour these pin down.
"""

load(
    "@aspect//worktree.axl",
    "testonly_held_by",
    "testonly_list_columns",
    "testonly_list_order",
    "testonly_same_session",
)
load("@std//time.axl", "time")
load(
    "./worktree.axl",
    "FREE",
    "LEASED",
    "RESERVED",
    "SLOT_PREFIX",
    "abandoned_lease",
    "acquire",
    "close_lease",
    "default_score",
    "drop_slot",
    "free_slot",
    "git_out",
    "held_for_ms",
    "holds_reservation",
    "leased_slot",
    "lock_digest",
    "lock_digest_at",
    "normalize_remote",
    "output_base_of",
    "owned_slots",
    "owner_record",
    "pool_of",
    "pools_root_of",
    "prunable_slots",
    "read_registry",
    "reconcile",
    "record_handover",
    "record_lease",
    "release",
    "reservation_abandoned",
    "reserve_slot",
    "reserving_slot",
    "run_git",
    "slot_age_days",
    "slot_age_ms",
    "slot_created_days",
    "slot_path",
    "slug",
    "uncommitted_work",
    "warmth_of",
    "write_registry",
)

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _test_remote_spellings_collapse(ctx):
    """The same repository is written at least three ways; a pool key has to be
    stable across all of them or a clone silently gets its own pool."""
    want = "github.com/aspect-build/site"
    _eq("scp-like", normalize_remote("git@github.com:aspect-build/site.git"), want)
    _eq("ssh scheme", normalize_remote("ssh://git@github.com/aspect-build/site"), want)
    _eq("ssh scheme with suffix", normalize_remote("ssh://git@github.com/aspect-build/site.git"), want)
    _eq("https", normalize_remote("https://github.com/aspect-build/site.git"), want)
    _eq("https no suffix", normalize_remote("https://github.com/aspect-build/site"), want)
    _eq("trailing slash", normalize_remote("https://github.com/aspect-build/site/"), want)
    _eq("uppercase host", normalize_remote("https://GitHub.com/aspect-build/site"), want)

def _test_suffix_behind_a_trailing_slash_is_still_stripped(ctx):
    """A URL copied out of a browser can carry both; stripping them in the wrong
    order leaves `.git` in the key and splits the pool."""
    want = "github.com/aspect-build/site"
    _eq("suffix then slash", normalize_remote("https://github.com/aspect-build/site.git/"), want)
    _eq("several slashes", normalize_remote("https://github.com/aspect-build/site.git///"), want)

def _test_mirrors_on_different_hosts_stay_separate(ctx):
    """Deliberate: guessing that two hosts serve one repository is a worse
    failure than keeping two pools, so a GitLab mirror is its own pool."""
    gh = normalize_remote("ssh://git@github.com/aspect-build/aspect-cli")
    gl = normalize_remote("git@gitlab.com:aspect-build/aspect-cli.git")
    _eq("github", gh, "github.com/aspect-build/aspect-cli")
    _eq("gitlab", gl, "gitlab.com/aspect-build/aspect-cli")
    if gh == gl:
        fail("mirrors on different hosts must not share a pool key")

def _test_fork_is_its_own_pool(ctx):
    """A fork is a different repository: same path, different owner."""
    upstream = normalize_remote("git@github.com:aspect-build/aspect-cli.git")
    fork = normalize_remote("git@github.com:someone-else/aspect-cli.git")
    if upstream == fork:
        fail("a fork must not share the upstream's pool key")

def _test_empty_remote_yields_no_key(ctx):
    _eq("empty", normalize_remote(""), "")
    _eq("whitespace", normalize_remote("   "), "")

def _test_slug_is_a_usable_path_component(ctx):
    """Branch names carry slashes and dots, and the result is appended to a
    clone path — anything that is not a single path component breaks it."""
    _eq("slashes", slug("fix/login"), "fix-login")
    _eq("case and dots", slug("Feature/API.v2"), "feature-api-v2")
    _eq("leading and trailing junk", slug("/wip/"), "wip")
    _eq("nothing usable", slug("///"), "worktree")
    _eq("already clean", slug("main"), "main")

def _test_lock_mismatch_nearly_disqualifies(ctx):
    """A different MODULE.bazel.lock means the repo fetches miss and
    `external/` is rebuilt — the one mismatch worth refusing a warm slot over."""
    want = {"lock_digest": "aaa", "commit": "c1"}
    same = {"lock_digest": "aaa", "last_commit": "c1"}
    other = {"lock_digest": "bbb", "last_commit": "c1"}
    _eq("perfect match", default_score(same, want), 100)
    _eq("lock mismatch", default_score(other, want), 1)

def _test_commit_distance_only_breaks_a_tie(ctx):
    """A different commit costs incremental invalidation, which Bazel handles.
    It must stay far above a lock mismatch or the ordering is inverted."""
    want = {"lock_digest": "aaa", "commit": "c1"}
    wrong_commit = {"lock_digest": "aaa", "last_commit": "c2"}
    wrong_lock = {"lock_digest": "bbb", "last_commit": "c1"}
    if default_score(wrong_commit, want) <= default_score(wrong_lock, want):
        fail("a commit difference must cost far less than a lock difference")

def _test_unknown_lock_does_not_disqualify(ctx):
    """A brand-new slot has no recorded lock digest. Treating that as a mismatch
    would make a fresh pool refuse its own slots forever."""
    want = {"lock_digest": "aaa", "commit": ""}
    fresh = {"lock_digest": "", "last_commit": ""}
    if default_score(fresh, want) <= 1:
        fail("a slot with no recorded lock digest must stay eligible")

def _test_output_base_matches_bazels_own_derivation(ctx):
    """Bazel names a base `md5(workspace_path)` under the output user root. The
    pool computes that rather than asking Bazel, which is what lets it inspect
    a slot's state without starting a server — so it has to agree exactly. The
    vector below was taken from a real Bazel-created base.
    """
    base = output_base_of(ctx.std, "/tmp/aspect-worktree-golden")
    _eq("named by md5 of the path", base.rpartition("/")[2], "5095308adbe80a1457b370244b19f1ee")
    _eq("under the output user root", base.startswith(ctx.std.env.home_dir()), True)

    other = output_base_of(ctx.std, "/tmp/aspect-worktree-other")
    if base == other:
        fail("two slot paths must not share an output base")

def _test_warmth_reads_what_is_really_there(ctx):
    """`add` and `list` tell a developer how much a slot is worth taking. That
    claim has to be checked: a server exits on idle and `aspect gc` can reclaim
    a base, so asserting "warm" without looking would often be wrong.
    """
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-warm")
    slot = tmp + "/aspect-worktree-probe"
    root = ctx.std.fs.mkdtemp(prefix = "aspect-worktree-root")

    cold = warmth_of(ctx.std, slot, root = root)
    _eq("no base yet", cold.base, False)
    _eq("and so no server", cold.server, 0)

    # Fabricate the base where Bazel would put it, with no server record.
    base = output_base_of(ctx.std, slot, root = root)
    _eq("fabricated under the temp root, not the real cache", base.startswith(root + "/"), True)
    ctx.std.fs.create_dir_all(base + "/server")
    partly = warmth_of(ctx.std, slot, root = root)
    _eq("base present", partly.base, True)
    _eq("but nothing holding it", partly.server, 0)

    # A pid that is recorded but dead must not read as warm.
    ctx.std.fs.write(base + "/server/server.pid.txt", "999999\n")
    dead = warmth_of(ctx.std, slot, root = root)
    _eq("a dead pid is not warmth", dead.server, 0)

def _test_registry_round_trips(ctx):
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    registry = {"version": 1, "slots": {"abc": {"state": "free", "last_branch": "x"}}}
    write_registry(ctx.std, tmp, registry)
    _eq("round trip", read_registry(ctx.std, tmp)["slots"]["abc"]["last_branch"], "x")

def _test_unreadable_registry_starts_over(ctx):
    """The registry is a cache rebuildable from git, so a corrupt one warns and
    starts fresh rather than wedging the pool."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    ctx.std.fs.write(tmp + "/registry.json", "{not json")
    _eq("recovers", read_registry(ctx.std, tmp)["slots"], {})

def _test_missing_registry_is_empty(ctx):
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    _eq("no file yet", read_registry(ctx.std, tmp)["slots"], {})

_DAY_MS = 24 * 60 * 60 * 1000

def _slot(owner, state = FREE, age_days = 0):
    """A registry entry whose creation floor is `age_days` old.

    With no output base on disk the floor is what `slot_age_days` reads, so this
    is how a test says "this slot has been idle that long"."""
    return {
        "owner_git_dir": owner,
        "state": state,
        "last_commit": "",
        "last_branch": "",
        "lock_digest": "",
        "created_ms": time.now_ms() - age_days * _DAY_MS,
    }

def _test_age_comes_from_the_base_and_falls_back_to_the_floor(ctx):
    """A slot with no output base has no evidence to read, so its creation time
    stands in. Zero on both counts reads as new rather than ancient: a registry
    that predates the field must not have every slot pruned out from under it.
    """
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    _eq("nothing recorded at all", slot_age_days(ctx.std, pool, "nobase", {"state": "free"}), 0)
    _eq(
        "the creation floor, with no base on disk",
        slot_age_days(ctx.std, pool, "nobase", {"created_ms": time.now_ms() - 3 * _DAY_MS}),
        3,
    )

def _test_a_recently_used_base_outranks_an_old_creation_floor(ctx):
    """The point of reading the base: a slot created long ago but built in
    yesterday is not stale, and the ledger alone would have said it was."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    slot_id = "fresh1"

    # A base at the derived path, touched now, is the freshest evidence there is.
    base = output_base_of(ctx.std, slot_path(pool, slot_id))
    ctx.std.fs.create_dir_all(base)
    ctx.std.fs.write(base + "/command.profile.gz", "x")
    old_floor = {"state": "free", "created_ms": time.now_ms() - 900 * _DAY_MS}
    _eq("fresh despite the floor", slot_age_days(ctx.std, pool, slot_id, old_floor), 0)
    ctx.std.fs.remove_dir_all(base)

def _test_prune_never_takes_a_leased_slot(ctx):
    """A lease means someone may be working in that checkout right now. Age is
    not grounds for deleting it, however stale the pool thinks it is."""
    pool = {"git_common_dir": "/clone/.git", "dir": "/pool"}
    registry = {"slots": {
        "busy": _slot("/clone/.git", state = "leased", age_days = 900),
        "idle": _slot("/clone/.git", age_days = 900),
    }}
    _eq("only the free one", prunable_slots(ctx.std, pool, registry, 30), ["idle"])

def _test_prune_respects_the_age_threshold(ctx):
    pool = {"git_common_dir": "/clone/.git", "dir": "/pool"}
    registry = {"slots": {
        "fresh": _slot("/clone/.git", age_days = 3),
        "stale": _slot("/clone/.git", age_days = 31),
    }}
    _eq("over the line", prunable_slots(ctx.std, pool, registry, 30), ["stale"])
    _eq("everything, at zero", sorted(prunable_slots(ctx.std, pool, registry, 0)), ["fresh", "stale"])

def _test_prune_leaves_a_live_clones_slots_alone(ctx):
    """Two clones of one repository share a pool directory but not slots. A slot
    owned by a clone that still exists is none of this clone's business; only one
    stranded by a clone that is gone can be collected."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    live_owner = tmp + "/live/.git"
    ctx.std.fs.create_dir_all(live_owner)
    pool = {"git_common_dir": tmp + "/mine/.git", "dir": "/pool"}
    registry = {"slots": {
        "theirs": _slot(live_owner, age_days = 900),
        "stranded": _slot(tmp + "/moved-away/.git", age_days = 900),
    }}
    _eq("only the stranded one", prunable_slots(ctx.std, pool, registry, 30), ["stranded"])

def _test_owned_slots_counts_only_this_clone(ctx):
    """`max_slots` budgets what this clone can actually lease, so a sibling
    clone's slots must not spend it."""
    pool = {"git_common_dir": "/clone/.git", "dir": "/pool"}
    registry = {"slots": {
        "mine": _slot("/clone/.git"),
        "theirs": _slot("/other/.git"),
    }}
    _eq("one", owned_slots(pool, registry), ["mine"])

def _test_drop_slot_removes_the_entry_and_the_base(ctx):
    """A dropped slot must leave nothing behind in the registry. A caller that
    persists afterwards would otherwise hand the next allocation a slot whose
    recorded `lock_digest` describes state that has been deleted."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    slot_id = "cafe01"
    path = tmp + "/pool/aspect-worktree-" + slot_id
    root = ctx.std.fs.mkdtemp(prefix = "aspect-worktree-root")
    base = output_base_of(ctx.std, path, root = root)
    ctx.std.fs.create_dir_all(base + "/external")
    ctx.std.fs.create_dir_all(path)
    registry = {"slots": {slot_id: _slot(pool["git_common_dir"], age_days = 900)}}
    registry["slots"][slot_id]["lock_digest"] = "stale"

    outcome = drop_slot(ctx.std, pool, registry, slot_id, root = root)
    _eq("dropped", outcome.dropped, True)
    _eq("gone from the registry", slot_id in registry["slots"], False)
    _eq("slot directory gone", ctx.std.fs.exists(path), False)
    _eq("output base gone", ctx.std.fs.exists(base), False)

def _test_drop_slot_refuses_while_a_server_holds_it(ctx):
    """Unlinking an output base from under a running Bazel server leaves it
    writing into directories that no longer exist. A free slot with a live server
    is also the warmest thing in the pool, so it is kept rather than deleted."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    slot_id = "abc123"
    path = tmp + "/pool/aspect-worktree-" + slot_id
    root = ctx.std.fs.mkdtemp(prefix = "aspect-worktree-root")
    base = output_base_of(ctx.std, path, root = root)
    ctx.std.fs.create_dir_all(base + "/server")
    ctx.std.fs.create_dir_all(path)

    # This process is certainly alive, so its pid stands in for a live server.
    ctx.std.fs.write(base + "/server/server.pid.txt", str(ctx.std.process.id()) + "\n")
    registry = {"slots": {slot_id: _slot(pool["git_common_dir"], age_days = 900)}}
    outcome = drop_slot(ctx.std, pool, registry, slot_id, root = root)
    _eq("refused", outcome.dropped, False)
    _eq("slot kept in the registry", slot_id in registry["slots"], True)
    _eq("base still there", ctx.std.fs.exists(base), True)

def _test_lock_digest_agrees_between_a_file_and_a_ref(ctx):
    """Allocation digests the lock from a git ref; `remove` digests it from the
    checked-out file. The two must agree on identical content or no slot would
    ever score as a match — `git show` cannot preserve trailing bytes, so both
    sides normalize."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    repo = tmp + "/repo"
    ctx.std.fs.create_dir_all(repo)
    for args in [
        ["init", "-q"],
        ["config", "user.email", "t@example.test"],
        ["config", "user.name", "t"],
    ]:
        run_git(ctx.std, args, repo)
    ctx.std.fs.write(repo + "/MODULE.bazel.lock", '{"lockFileVersion": 42}\n')
    run_git(ctx.std, ["add", "-A"], repo)
    run_git(ctx.std, ["commit", "-qm", "lock"], repo)

    from_file = lock_digest(ctx.std, repo)
    from_ref = lock_digest_at(ctx.std, repo, "HEAD")
    if not from_file:
        fail("the checked-out lock file should digest to something")
    _eq("same content, same digest", from_ref, from_file)
    _eq(
        "a ref with no lock file is unknown, not mismatched",
        lock_digest_at(ctx.std, repo, "HEAD:nonexistent"),
        "",
    )

def _leased(owner, name, agent):
    return {
        "owner_git_dir": owner,
        "state": LEASED,
        "last_commit": "",
        "last_branch": "",
        "lock_digest": "",
        "created_ms": time.now_ms(),
        "lease": {"name": name, "since": str(time.now_ms()), "agent": agent},
    }

def _repo_with_worktree(ctx, dirty):
    """A clone with one worktree at a pool slot path, optionally dirty."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    repo = tmp + "/repo"
    ctx.std.fs.create_dir_all(repo)
    for args in [
        ["init", "-q"],
        ["config", "user.email", "t@example.test"],
        ["config", "user.name", "t"],
    ]:
        run_git(ctx.std, args, repo)
    ctx.std.fs.write(repo + "/README", "x\n")
    run_git(ctx.std, ["add", "-A"], repo)
    run_git(ctx.std, ["commit", "-qm", "init"], repo)

    slot_id = "abc123"
    asked = tmp + "/pool/" + SLOT_PREFIX + slot_id
    ctx.std.fs.create_dir_all(tmp + "/pool")
    run_git(ctx.std, ["worktree", "add", "-q", asked, "-b", "wip"], repo + "/.git")

    # Everything below takes git's spelling of these paths, because that is
    # where `pool_of` gets them in production. A hand-built path differs from
    # git's under a symlinked `/var`, and a fixture that mixes the two tests a
    # configuration the product never has — and hides the one it does.
    common = git_out(ctx.std, ["rev-parse", "--path-format=absolute", "--git-common-dir"], repo)
    path = asked
    for line in git_out(ctx.std, ["worktree", "list", "--porcelain"], common).splitlines():
        if line.startswith("worktree ") and SLOT_PREFIX + slot_id in line:
            path = line[len("worktree "):].strip()
    pool = {"git_common_dir": common, "dir": path.rsplit("/", 1)[0]}
    if dirty:
        ctx.std.fs.write(path + "/README", "uncommitted\n")
    return struct(pool = pool, slot_id = slot_id, path = path)

def _with_empty_session_store(ctx):
    """Point `CLAUDE_CONFIG_DIR` at a store that exists but holds no sessions,
    so a claude-code id reads `gone` rather than `unknown`. Returns what was
    there, for `_restore_session_store`.

    Without this these tests depend on whether the machine happens to have a
    `~/.claude/projects`: a developer laptop does, a CI runner does not, and a
    missing store is correctly `unknown`.
    """
    root = ctx.std.fs.mkdtemp(prefix = "aspect-sessions")
    ctx.std.fs.create_dir_all(root + "/projects")
    previous = ctx.std.env.var("CLAUDE_CONFIG_DIR") or ""
    ctx.std.env.set_var("CLAUDE_CONFIG_DIR", root)
    return previous

def _restore_session_store(ctx, previous):
    if previous:
        ctx.std.env.set_var("CLAUDE_CONFIG_DIR", previous)
    else:
        ctx.std.env.remove_var("CLAUDE_CONFIG_DIR")

_MISSING_SESSION = {
    "kind": "claude-code",
    "id": "00000000-dead-dead-dead-000000000000",
    "pid": 0,
    "pid_start": "",
}

def _test_a_lease_with_no_agent_is_never_abandoned(ctx):
    """Only a lease that says who took it can be reasoned about. A worktree a
    person made is not ours to reclaim on any evidence."""
    env = _repo_with_worktree(ctx, dirty = False)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", {})}}
    _eq("no agent", abandoned_lease(ctx.std, env.pool, registry, env.slot_id), False)

def _test_a_gone_session_with_a_clean_checkout_is_abandoned(ctx):
    """Commits live in the branch and survive `worktree remove`, so a clean tree
    whose session cannot be resumed has nothing left to lose."""
    env = _repo_with_worktree(ctx, dirty = False)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", _MISSING_SESSION)}}
    previous = _with_empty_session_store(ctx)
    got = abandoned_lease(ctx.std, env.pool, registry, env.slot_id)
    _restore_session_store(ctx, previous)
    _eq("reclaimable", got, True)

def _test_uncommitted_changes_are_never_discarded(ctx):
    """The case the whole rule exists to protect: a session that cannot be
    resumed may still have left work nobody has committed."""
    env = _repo_with_worktree(ctx, dirty = True)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", _MISSING_SESSION)}}
    previous = _with_empty_session_store(ctx)
    got = abandoned_lease(ctx.std, env.pool, registry, env.slot_id)
    _restore_session_store(ctx, previous)
    _eq("kept", got, False)

def _test_a_running_session_is_never_abandoned(ctx):
    """A live harness is in use, whatever else is true — including a clean tree
    and a session id with no transcript."""
    env = _repo_with_worktree(ctx, dirty = False)
    me = ctx.std.process.id()
    out = ctx.std.process.command("ps").args(["-o", "lstart=", "-p", str(me)]) \
        .stdout("piped").stderr("null").spawn().wait_with_output()
    alive = {
        "kind": "claude-code",
        "id": "00000000-dead-dead-dead-000000000000",
        "pid": me,
        "pid_start": out.stdout.strip(),
    }
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", alive)}}
    _eq("in use", abandoned_lease(ctx.std, env.pool, registry, env.slot_id), False)

def _test_an_unverifiable_harness_is_never_abandoned(ctx):
    """A harness whose session storage we cannot inspect reads as `unknown`, and
    `unknown` must behave exactly like `resumable` — never reclaimed."""
    env = _repo_with_worktree(ctx, dirty = False)
    unknown = {"kind": "codex", "id": "sess-abc", "pid": 0, "pid_start": ""}
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", unknown)}}
    _eq("left alone", abandoned_lease(ctx.std, env.pool, registry, env.slot_id), False)

def _test_a_relocated_output_user_root_is_where_a_slot_looks(ctx):
    """The root a slot derives under is the caller's to choose, because a repo
    whose `.bazelrc` sets `startup --output_user_root=` keeps its bases
    elsewhere. Looking in the platform default there finds nothing: every slot
    would read cold, and pruning would retire warm slots and leave their real
    bases behind.
    """
    relocated = ctx.std.fs.mkdtemp(prefix = "aspect-worktree-root")
    slot = "/pool/aspect-worktree-abc123"

    under_relocated = output_base_of(ctx.std, slot, relocated)
    under_default = output_base_of(ctx.std, slot)
    _eq("derived under the root given", under_relocated.startswith(relocated + "/"), True)
    _eq("same slot, same digest either way", under_relocated.rpartition("/")[2], under_default.rpartition("/")[2])

    # A base in the relocated root is invisible from the default one.
    ctx.std.fs.create_dir_all(under_relocated)
    _eq("found with the root", warmth_of(ctx.std, slot, relocated).base, True)
    _eq("missed without it", warmth_of(ctx.std, slot).base, False)

def _test_the_branchs_own_slot_outranks_an_unrelated_one(ctx):
    """An agent returning to a branch it released should land back on the slot
    holding that branch's outputs. Without this the two score the same and it
    comes down to registry order."""
    want = {"name": "fix/login", "lock_digest": "aaa", "commit": "c9"}
    mine = {"lock_digest": "aaa", "last_commit": "c1", "last_branch": "fix/login"}
    theirs = {"lock_digest": "aaa", "last_commit": "c1", "last_branch": "other/work"}
    if default_score(mine, want) <= default_score(theirs, want):
        fail("the slot that last held this branch must win")

def _test_an_identical_tree_still_wins_over_the_same_branch(ctx):
    """A slot sitting on exactly this commit has outputs for exactly this tree,
    whatever branch produced them — that beats a near relative."""
    want = {"name": "fix/login", "lock_digest": "aaa", "commit": "c1"}
    exact = {"lock_digest": "aaa", "last_commit": "c1", "last_branch": "other/work"}
    near = {"lock_digest": "aaa", "last_commit": "c7", "last_branch": "fix/login"}
    if default_score(exact, want) <= default_score(near, want):
        fail("an identical tree must outrank the same branch at another commit")

def _test_a_lock_mismatch_still_beats_everything_down(ctx):
    """Branch affinity must not rescue a slot whose `external/` would be
    rebuilt — that is the expensive mismatch."""
    want = {"name": "fix/login", "lock_digest": "aaa", "commit": "c1"}
    wrong_lock = {"lock_digest": "bbb", "last_commit": "c1", "last_branch": "fix/login"}
    _eq("still nearly disqualified", default_score(wrong_lock, want), 1)

def _test_the_refusal_names_who_holds_the_slot(ctx):
    """A refusal that reports only the slot path makes the caller go and find
    out who has it. The lease already knows, so it says: who, whether that
    session can be resumed, and that `--take-over` is the other way out."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    agent = {"kind": "claude-code", "id": "abcdef12-3456", "pid": 0, "pid_start": ""}
    registry = {"slots": {"s1": _leased(pool["git_common_dir"], "fix/login", agent)}}

    # No session store, so the state is `unknown`: not resumable, not gone.
    previous = ctx.std.env.var("CLAUDE_CONFIG_DIR") or ""
    ctx.std.env.set_var("CLAUDE_CONFIG_DIR", ctx.std.fs.mkdtemp(prefix = "aspect-nostore"))
    msg = testonly_held_by(ctx, pool, registry, "s1", "fix/login", {})
    if previous:
        ctx.std.env.set_var("CLAUDE_CONFIG_DIR", previous)
    else:
        ctx.std.env.remove_var("CLAUDE_CONFIG_DIR")

    _eq("names the branch", "fix/login" in msg, True)

    # In full, not truncated as the table does it: two sessions whose ids share
    # a prefix have to be told apart by whoever reads a refusal.
    _eq("names the holder", "claude-code session abcdef12-3456" in msg, True)
    _eq("offers the override", "--take-over" in msg, True)

    # The resume line is offered only for a session that can be resumed, so an
    # alternative phrased as "Or ..." would be an alternative to nothing.
    _eq("no dangling alternative", " Or " in msg, False)

def _test_a_slot_you_already_hold_says_so(ctx):
    """Told that a `claude-code` session holds it, in the words used for a
    stranger, an agent reads the skill's rule — a slot another session holds
    needs the user's say-so — and stops to ask a question with nobody to ask.
    Reclaiming your own slot needs nobody's permission, and where it already is
    is the useful answer."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    me = {"kind": "claude-code", "id": "abcdef12-3456", "pid": 0, "pid_start": ""}
    registry = {"slots": {"s1": _leased(pool["git_common_dir"], "fix/login", me)}}

    msg = testonly_held_by(ctx, pool, registry, "s1", "fix/login", me)

    _eq("says it is yours", "already yours" in msg, True)
    _eq("points at the slot", "aspect worktree path fix/login" in msg, True)
    if "check with whoever" in msg:
        fail("asking the user about your own slot is the inversion being fixed")

def _test_a_different_session_is_still_a_refusal(ctx):
    """The identity check must not swallow the case it is next to: another
    session's slot is still not yours, even on the same harness."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    theirs = {"kind": "claude-code", "id": "11111111-1111", "pid": 0, "pid_start": ""}
    me = {"kind": "claude-code", "id": "22222222-2222", "pid": 0, "pid_start": ""}
    registry = {"slots": {"s1": _leased(pool["git_common_dir"], "fix/login", theirs)}}

    msg = testonly_held_by(ctx, pool, registry, "s1", "fix/login", me)
    _eq("not called yours", "already yours" in msg, False)
    _eq("names them", "11111111-1111" in msg, True)

def _test_an_anonymous_lease_is_nobodys(ctx):
    """A worktree somebody took at a terminal records no session. Matching an
    empty id against an empty id would make every such slot everybody's."""
    nobody = {"kind": "", "id": ""}
    me = {"kind": "claude-code", "id": ""}
    _eq("no id, no match", testonly_same_session(me, nobody), False)
    _eq("same id matches", testonly_same_session(
        {"kind": "claude-code", "id": "x"},
        {"kind": "claude-code", "id": "x"},
    ), True)
    _eq("other harness does not", testonly_same_session(
        {"kind": "codex", "id": "x"},
        {"kind": "claude-code", "id": "x"},
    ), False)

def _test_a_lease_with_no_agent_keeps_the_plain_refusal(ctx):
    """A worktree a person took has no session to report, so the message stays
    the short one rather than inventing a holder."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    registry = {"slots": {"s1": _leased(pool["git_common_dir"], "fix/login", {})}}
    msg = testonly_held_by(ctx, pool, registry, "s1", "fix/login", {})
    _eq("no holder claimed", "held by" in msg, False)
    _eq("still says what to do", "aspect worktree remove" in msg, True)

def _test_a_new_branch_does_not_adopt_its_bases_upstream(ctx):
    """Creating a branch from a remote-tracking ref records that ref as the new
    branch's upstream unless `--no-track` is passed. Under
    `push.default=upstream` a later bare `git push` from the worktree then
    targets the base branch, which for `origin/main` is the one outcome this
    whole feature exists to avoid.

    Git auto-tracks only when the start point is named in its short
    remote-tracking form, so reproducing the buggy shape needs a configured
    remote; that half is covered end to end rather than here.
    """
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    repo = tmp + "/repo"
    ctx.std.fs.create_dir_all(repo)
    for args in [
        ["init", "-q", "-b", "main"],
        ["config", "user.email", "t@example.test"],
        ["config", "user.name", "t"],
    ]:
        run_git(ctx.std, args, repo)
    ctx.std.fs.write(repo + "/f", "x\n")
    run_git(ctx.std, ["add", "-A"], repo)
    run_git(ctx.std, ["commit", "-qm", "init"], repo)

    # A remote-tracking ref without needing a remote.
    run_git(ctx.std, ["update-ref", "refs/remotes/origin/main", "HEAD"], repo)

    without = tmp + "/without"
    run_git(ctx.std, ["worktree", "add", "--no-track", "-b", "feat/x", without, "refs/remotes/origin/main"], repo)
    _eq(
        "no upstream, so a bare push has no target",
        run_git(ctx.std, ["rev-parse", "--abbrev-ref", "@{upstream}"], without).ok,
        False,
    )

    # The branch still points where it should; only the upstream is withheld.
    _eq(
        "branched from the base",
        run_git(ctx.std, ["rev-parse", "HEAD"], without).out,
        run_git(ctx.std, ["rev-parse", "refs/remotes/origin/main"], repo).out,
    )

def _test_the_agent_column_is_never_dropped(ctx):
    """A pool with nothing running must still show that it records which session
    holds a slot, so `agent` is the one column kept when empty. The rest of the
    table's behaviour is lib/table.axl's, and tested there."""
    by_key = {c.key: c for c in testonly_list_columns}
    _eq("agent survives an empty column", by_key["agent"].always, True)
    _eq("notes does not, since it only ever carries exceptions", by_key["notes"].always, False)
    _eq("idle is right-aligned", by_key["idle"].right, True)

    # The fixed-width columns come first and the two ragged ones last, so the
    # numbers line up in a block and a long branch name cannot push them around.
    _eq("the slot leads", testonly_list_columns[0].key, "slot")
    keys = [c.key for c in testonly_list_columns]
    if keys.index("branch") < keys.index("leases"):
        fail("branch belongs after the numbers: %r" % keys)
    if keys.index("branch") > keys.index("agent"):
        fail("branch belongs before the agent: %r" % keys)

# A pid high enough that nothing is using it, for a record whose process is
# gone. `kill -0` on it answers ESRCH, which is the whole question.
_DEAD_PID = 2147483000

def _test_the_lock_excludes_a_second_caller(ctx):
    """The point of the whole mechanism. `attempts = 1` so the refusal is
    immediate rather than the production minute of patience."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    first = acquire(ctx.std, tmp)
    if not first:
        fail("an unlocked pool should hand out its lock")
    _eq("a second caller is refused", acquire(ctx.std, tmp, attempts = 1), "")
    release(ctx.std, tmp, first)
    if not acquire(ctx.std, tmp, attempts = 1):
        fail("the lock should be available once released")

def _test_a_stale_release_cannot_drop_someone_elses_lock(ctx):
    """`add` releases the lock for its checkout and takes it again, so a
    deferred release can arrive once the lock has passed to another caller.
    Removing theirs would put two callers in the registry at once.

    The second holder is written by hand because a token identifies a process,
    and this test only has the one. It carries this process's pid so the lock
    reads as live rather than abandoned, which is the case being tested.
    """
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    mine = acquire(ctx.std, tmp)
    release(ctx.std, tmp, mine)

    ctx.std.fs.create_dir_all(tmp + "/.lock")
    ctx.std.fs.write(tmp + "/.lock/owner.json", json.encode(
        owner_record(ctx.std) | {"token": "another-caller"},
    ))

    release(ctx.std, tmp, mine)
    _eq("their lock survives my late release", acquire(ctx.std, tmp, attempts = 1), "")
    release(ctx.std, tmp, "another-caller")
    if not acquire(ctx.std, tmp, attempts = 1):
        fail("the holder's own release should still work")

def _test_a_lock_whose_owner_died_is_reclaimed_at_once(ctx):
    """The owner record answers whether the holder still exists, so the next
    caller takes an abandoned lock rather than waiting out a clock that says
    nothing about it."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    ctx.std.fs.create_dir_all(tmp + "/.lock")
    ctx.std.fs.write(tmp + "/.lock/owner.json", json.encode({
        "token": "%d:Mon Jan  1 00:00:00 2001" % _DEAD_PID,
        "pid": _DEAD_PID,
        "started_at": "Mon Jan  1 00:00:00 2001",
    }))
    if not acquire(ctx.std, tmp, attempts = 1):
        fail("a lock held by a dead process should be reclaimed on the first look")

def _test_a_recycled_pid_does_not_pass_for_the_owner(ctx):
    """Pids are reused, so a live pid is not evidence that the process which
    took the lock is still there. The recorded start time is what settles it."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    ctx.std.fs.create_dir_all(tmp + "/.lock")
    ctx.std.fs.write(tmp + "/.lock/owner.json", json.encode({
        "token": "stale",
        "pid": ctx.std.process.id(),
        "started_at": "Mon Jan  1 00:00:00 2001",
    }))
    if not acquire(ctx.std, tmp, attempts = 1):
        fail("a live pid with a different start time is a different process")

def _test_an_unreadable_owner_still_waits_out_the_clock(ctx):
    """A process that died between creating the lock directory and recording
    itself leaves nothing to check. An age that cannot be established is never
    called abandoned, because reclaiming a live lock is worse than waiting."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    ctx.std.fs.create_dir_all(tmp + "/.lock")
    _eq("no owner record, fresh directory", acquire(ctx.std, tmp, attempts = 1), "")

def _test_a_reservation_holds_the_slot_and_the_branch(ctx):
    """The reservation is what makes releasing the lock for the checkout safe:
    the slot is no longer free, and the branch is answerable by name before any
    lease exists."""
    registry = {"slots": {"s1": _slot("/owner/.git")}}
    token = reserve_slot(ctx.std, registry, "s1", "fix/login")

    _eq("not free any more", registry["slots"]["s1"]["state"], RESERVED)
    _eq("found by branch", reserving_slot(registry, "fix/login"), "s1")
    _eq("another branch is not claimed", reserving_slot(registry, "other"), "")
    _eq("the token proves it is ours", holds_reservation(registry, "s1", token), True)
    _eq("someone else's token does not", holds_reservation(registry, "s1", "nope"), False)
    _eq("a live process is not abandoned", reservation_abandoned(ctx.std, registry, "s1"), False)

def _test_a_reservation_whose_process_died_is_reclaimable(ctx):
    """An `add` killed during its checkout would otherwise hold a slot for
    good. Unlike a lease there is no judgement call: no worktree existed yet, so
    there is no session to resume and nothing uncommitted to lose."""
    registry = {"slots": {"s1": _slot("/owner/.git")}}
    reserve_slot(ctx.std, registry, "s1", "fix/login")
    registry["slots"]["s1"]["reservation"]["pid"] = _DEAD_PID
    _eq("dead owner", reservation_abandoned(ctx.std, registry, "s1"), True)

    registry["slots"]["s1"]["reservation"] = {}
    _eq("nothing recorded is not a hold", reservation_abandoned(ctx.std, registry, "s1"), True)

def _test_prune_never_takes_a_slot_being_set_up(ctx):
    """A reservation means a checkout is being created in that directory.
    Deleting its output base would break a command that is still running, and
    age is no argument: the slot is as old as whatever it held before."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    registry = {"slots": {"s1": _slot(pool["git_common_dir"], age_days = 90)}}
    _eq("free and old", prunable_slots(ctx.std, pool, registry, 30), ["s1"])

    reserve_slot(ctx.std, registry, "s1", "fix/login")
    _eq("reserved and old", prunable_slots(ctx.std, pool, registry, 30), [])

def _test_reconcile_leaves_a_reservation_alone(ctx):
    """Git not knowing about a reserved slot's worktree is expected rather than
    evidence — that is what "not checked out yet" looks like. Freeing on it
    would hand the slot to a second caller mid-checkout."""
    env = _repo_with_worktree(ctx, dirty = False)
    registry = {"slots": {"s2": _slot(env.pool["git_common_dir"])}}
    reserve_slot(ctx.std, registry, "s2", "fix/login")
    reconcile(ctx.std, env.pool, registry)
    _eq("still reserved", registry["slots"]["s2"]["state"], RESERVED)

def _test_freeing_a_slot_keeps_its_output_base(ctx):
    """The Bazel state is the reason the pool exists, so a claim ending takes
    the worktree and nothing else. `drop_slot` is the one that deletes."""
    env = _repo_with_worktree(ctx, dirty = False)
    root = ctx.std.fs.mkdtemp(prefix = "aspect-wt-root")
    base = output_base_of(ctx.std, env.path, root)
    ctx.std.fs.create_dir_all(base)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", {})}}

    free_slot(ctx.std, env.pool, registry, env.slot_id)

    _eq("free now", registry["slots"][env.slot_id]["state"], FREE)
    _eq("no lease", registry["slots"][env.slot_id]["lease"], None)
    _eq("no reservation", registry["slots"][env.slot_id]["reservation"], None)
    _eq("the worktree is gone", ctx.std.fs.exists(env.path), False)
    _eq("the output base is not", ctx.std.fs.exists(base), True)
    if "wip" in git_out(ctx.std, ["worktree", "list"], env.pool["git_common_dir"]):
        fail("git should no longer list a worktree for the branch")

def _test_freeing_a_slot_whose_directory_is_gone_still_frees_the_branch(ctx):
    """Git keeps listing a worktree whose directory was removed behind its back,
    and refuses to check that branch out anywhere else until it is pruned. The
    branch has to come free even though there is nothing left to remove."""
    env = _repo_with_worktree(ctx, dirty = False)
    ctx.std.fs.remove_dir_all(env.path)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", {})}}

    free_slot(ctx.std, env.pool, registry, env.slot_id)

    _eq("free now", registry["slots"][env.slot_id]["state"], FREE)
    if "wip" in git_out(ctx.std, ["worktree", "list"], env.pool["git_common_dir"]):
        fail("a worktree whose directory is gone should have been pruned from git")

_A_SESSION = {"kind": "claude-code", "id": "b22fe20c-aaaa-bbbb-cccc-ddddeeeeffff", "pid": 123, "source": "env"}

def _test_a_slot_counts_the_worktrees_it_has_held(ctx):
    """The count is the pool's claim measured rather than asserted: a slot on
    its seventh lease has saved six cold starts."""
    registry = {"slots": {"s1": _slot("/owner/.git")}}

    record_lease(registry, "s1", "fix/login", _A_SESSION)
    close_lease(registry, "s1")
    record_lease(registry, "s1", "spike/perf", {})

    slot = registry["slots"]["s1"]
    _eq("two leases", slot["lease_count"], 2)
    _eq("both remembered", [h["name"] for h in slot["history"]], ["fix/login", "spike/perf"])
    if not slot["history"][0]["released_ms"]:
        fail("the first lease ended and should say so")
    _eq("the current one is open", slot["history"][1]["released_ms"], 0)

def _test_the_history_is_bounded(ctx):
    """A slot reused for months would otherwise grow its registry entry
    forever to answer a question only the recent past bears on."""
    registry = {"slots": {"s1": _slot("/owner/.git")}}
    for i in range(25):
        record_lease(registry, "s1", "branch-%d" % i, {})
        close_lease(registry, "s1")

    slot = registry["slots"]["s1"]
    _eq("every lease is counted", slot["lease_count"], 25)
    _eq("only the recent ones are kept", len(slot["history"]), 10)
    _eq("and they are the recent ones", slot["history"][-1]["name"], "branch-24")

def _test_closing_without_a_history_is_harmless(ctx):
    """A registry written before slots kept a history has nothing to close, and
    neither has a slot freed twice."""
    registry = {"slots": {"s1": {"state": LEASED}}}
    close_lease(registry, "s1")

    record_lease(registry, "s1", "fix/login", _A_SESSION)
    close_lease(registry, "s1")
    first = registry["slots"]["s1"]["history"][0]["released_ms"]
    close_lease(registry, "s1")
    _eq("the closed entry is not touched again", registry["slots"]["s1"]["history"][0]["released_ms"], first)

def _test_age_and_idleness_answer_in_milliseconds(ctx):
    """A column showing `0d` for a slot used ten minutes ago says nothing. The
    pool reports the elapsed time and the display picks a unit; whole days stay
    available for `prune`, which acts at that resolution."""
    minutes_old = {"created_ms": time.now_ms() - 25 * 60 * 1000}
    age = slot_age_ms(minutes_old)
    if age < 25 * 60 * 1000 or age > 26 * 60 * 1000:
        fail("25 minutes should read as about 25 minutes: got %d ms" % age)
    _eq("and as no whole days", slot_created_days(minutes_old), 0)
    _eq("nothing recorded", slot_age_ms({}), 0)

def _test_creation_age_is_not_idleness(ctx):
    """`slot_created_days` only grows; `slot_age_days` is what `prune` acts on
    and resets whenever Bazel touches the output base. Reporting one as the
    other would tell a reader a slot was new when it had been idle for a month,
    or ancient when it had just been used."""
    _eq("nothing recorded", slot_created_days({}), 0)
    _eq("three days", slot_created_days({"created_ms": time.now_ms() - 3 * _DAY_MS}), 3)

    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    old = _slot(pool["git_common_dir"], age_days = 30)
    base = output_base_of(ctx.std, slot_path(pool, "s1"), tmp + "/root")
    ctx.std.fs.create_dir_all(base)
    _eq("created a month ago", slot_created_days(old), 30)
    _eq("but used just now", slot_age_days(ctx.std, pool, "s1", old, tmp + "/root"), 0)

def _test_freeing_a_slot_closes_its_history_entry(ctx):
    """`free_slot` is one of the two ways a lease ends, so it has to close the
    entry the same way `remove` does — otherwise a slot's history reads as
    though every branch it ever held is still checked out."""
    env = _repo_with_worktree(ctx, dirty = False)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", {})}}
    record_lease(registry, env.slot_id, "wip", _A_SESSION)

    free_slot(ctx.std, env.pool, registry, env.slot_id)

    entry = registry["slots"][env.slot_id]["history"][-1]
    if not entry["released_ms"]:
        fail("freeing the slot should have closed its history entry")

def _test_the_history_says_who_held_each_lease(ctx):
    """On a machine running several agents, which session had a slot is the
    question worth asking of it — a cold build or an unexpected branch is
    usually answered by "that session had it last"."""
    registry = {"slots": {"s1": _slot("/owner/.git")}}

    record_lease(registry, "s1", "fix/login", _A_SESSION)
    entry = registry["slots"]["s1"]["history"][0]

    _eq("the harness", entry["agent"]["kind"], "claude-code")
    _eq("the session", entry["agent"]["id"], _A_SESSION["id"])
    if "pid" in entry["agent"]:
        fail("a finished session's pid is not evidence of anything and should not be kept")

def _test_a_person_leaves_no_session_in_the_history(ctx):
    """Nothing is invented for a worktree somebody took at a terminal."""
    registry = {"slots": {"s1": _slot("/owner/.git")}}
    record_lease(registry, "s1", "fix/login", {})
    _eq("no holder", registry["slots"]["s1"]["history"][0]["agent"], {})

def _test_a_handover_records_a_holder_without_counting_a_lease(ctx):
    """`--take-over` hands an existing checkout to a second session. Nothing is
    rebuilt, so the slot has not turned over and the count must not move — but
    the slot did change hands, which is what the history is for."""
    registry = {"slots": {"s1": _slot("/owner/.git")}}
    record_lease(registry, "s1", "fix/login", _A_SESSION)
    other = {"kind": "claude-code", "id": "7f1e9a02-1111-2222-3333-444455556666"}

    record_handover(registry, "s1", "fix/login", other)

    slot = registry["slots"]["s1"]
    _eq("still one lease", slot["lease_count"], 1)
    _eq("two holders", len(slot["history"]), 2)
    _eq("the new one holds it", slot["history"][1]["agent"]["id"], other["id"])
    if not slot["history"][0]["released_ms"]:
        fail("the handed-over entry should be closed")

def _test_how_long_a_holder_had_it(ctx):
    """An open entry is measured to now, which is what makes "still holding it"
    a duration rather than a blank."""
    closed = {"leased_ms": 1000, "released_ms": 1000 + 90 * 60 * 1000}
    _eq("an hour and a half", held_for_ms(closed), 90 * 60 * 1000)

    open_now = {"leased_ms": time.now_ms() - 5 * 60 * 1000}
    if held_for_ms(open_now) < 5 * 60 * 1000:
        fail("an open entry is measured to now: got %d" % held_for_ms(open_now))
    _eq("nothing recorded", held_for_ms({}), 0)

def _symlink(ctx, target: str, link: str) -> None:
    """`ln -s`: AXL's `std.fs` can write a file but not create a link."""
    ctx.std.process.command("ln").args(["-s", target, link]) \
        .stdout("null").stderr("null").spawn().wait()

def _test_a_built_in_slot_is_not_dirty(ctx):
    """The case three agents hit running the documented workflow: take a slot,
    build in it, release it. Bazel leaves its convenience symlinks and a
    generated lock file behind, and counting those as work made the release step
    refuse — so a slot could never be released after its first build.
    """
    env = _repo_with_worktree(ctx, dirty = False)
    base = ctx.std.fs.mkdtemp(prefix = "aspect-wt-base")
    ctx.std.fs.create_dir_all(base + "/execroot/warmth")

    # What a build leaves: symlinks into the output base, plus the lock file.
    for link in ["bazel-bin", "bazel-out", "bazel-testlogs", "bazel-warmth"]:
        _symlink(ctx, base + "/execroot/warmth", env.path + "/" + link)
    ctx.std.fs.write(env.path + "/MODULE.bazel.lock", '{"lockFileVersion": 42}\n')

    _eq("none of it is work", uncommitted_work(ctx.std, env.path, base), [])

def _test_real_work_in_a_built_in_slot_still_counts(ctx):
    """The filter must not swallow the thing it is next to. A file the caller
    wrote is work even when Bazel's leavings are in the same listing."""
    env = _repo_with_worktree(ctx, dirty = False)
    base = ctx.std.fs.mkdtemp(prefix = "aspect-wt-base")
    ctx.std.fs.create_dir_all(base)
    _symlink(ctx, base, env.path + "/bazel-bin")
    ctx.std.fs.write(env.path + "/MODULE.bazel.lock", "{}\n")
    ctx.std.fs.write(env.path + "/notes.md", "half-finished\n")

    work = uncommitted_work(ctx.std, env.path, base)
    _eq("just the one file", len(work), 1)
    if "notes.md" not in work[0]:
        fail("the caller's own file should be reported: got %r" % work)

def _test_a_tracked_lock_file_that_changed_is_work(ctx):
    """A lock file git already tracks is a diff somebody may want to commit, so
    the exemption covers the generated case only."""
    env = _repo_with_worktree(ctx, dirty = False)
    ctx.std.fs.write(env.path + "/MODULE.bazel.lock", '{"lockFileVersion": 1}\n')
    run_git(ctx.std, ["add", "MODULE.bazel.lock"], env.path)
    run_git(ctx.std, ["commit", "-qm", "lock"], env.path)
    ctx.std.fs.write(env.path + "/MODULE.bazel.lock", '{"lockFileVersion": 2}\n')

    work = uncommitted_work(ctx.std, env.path, "")
    if len(work) != 1 or "MODULE.bazel.lock" not in work[0]:
        fail("a tracked lock file that changed is work: got %r" % work)

def _test_a_symlink_pointing_elsewhere_is_work(ctx):
    """A convenience symlink is recognized by pointing into this slot's output
    base, not by its name — so a symlink someone else made is still reported,
    whatever it is called."""
    env = _repo_with_worktree(ctx, dirty = False)
    base = ctx.std.fs.mkdtemp(prefix = "aspect-wt-base")
    elsewhere = ctx.std.fs.mkdtemp(prefix = "aspect-wt-other")
    _symlink(ctx, elsewhere, env.path + "/bazel-bin")

    work = uncommitted_work(ctx.std, env.path, base)
    if len(work) != 1 or "bazel-bin" not in work[0]:
        fail("a symlink out of the pool's reach is not ours to ignore: got %r" % work)

def _test_a_gone_session_with_only_build_output_is_abandoned(ctx):
    """Reclaiming a crashed agent's slot ran the same check, so a slot that had
    been built in was unreclaimable as well as unreleasable."""
    previous = _with_empty_session_store(ctx)
    env = _repo_with_worktree(ctx, dirty = False)
    root = ctx.std.fs.mkdtemp(prefix = "aspect-wt-root")
    base = output_base_of(ctx.std, env.path, root)
    ctx.std.fs.create_dir_all(base)
    _symlink(ctx, base, env.path + "/bazel-out")
    ctx.std.fs.write(env.path + "/MODULE.bazel.lock", "{}\n")
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", _MISSING_SESSION)}}

    verdict = abandoned_lease(ctx.std, env.pool, registry, env.slot_id, root)
    _restore_session_store(ctx, previous)
    _eq("build output is not work to protect", verdict, True)

def _test_a_filesystem_remote_is_not_a_pool_key(ctx):
    """A path has no host to key on, and a key starting with a separator
    composes into `<pools root>//abs/path` — which git then reports back without
    the doubled slash, so nothing the pool wrote matches what git says."""
    for url in [
        "/srv/repos/thing.git",
        "file:///srv/repos/thing.git",
        "./relative/thing",
        "../sibling/thing.git",
        "~/repos/thing",
    ]:
        _eq("declined: " + url, normalize_remote(url), "")

def _test_a_key_cannot_climb_out_of_the_pools_root(ctx):
    """`..` in a key would put a pool outside the directory that holds pools,
    where nothing collects it and another repository's pool may be sitting."""
    _eq("dot dot", normalize_remote("https://host/a/../../etc"), "")
    _eq("still fine", normalize_remote("https://host/a/b"), "host/a/b")

def _test_a_filesystem_origin_still_gets_one_pool_per_repository(ctx):
    """Declining the key must not leave the clone without a pool. Every clone of
    one local repository shares a slug-keyed pool, and the directory it names
    has no doubled separator for git to disagree with."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    origin = tmp + "/origin.git"
    run_git(ctx.std, ["init", "-q", "--bare", origin], tmp)

    pools = []
    for name in ["one", "two"]:
        clone = tmp + "/" + name
        run_git(ctx.std, ["clone", "-q", origin, clone], tmp)
        pools.append(pool_of(ctx.std, clone))

    if not pools[0]["id"].startswith("local/"):
        fail("a filesystem origin should be keyed locally: got %r" % pools[0]["id"])
    _eq("both clones, one pool", pools[0]["id"], pools[1]["id"])
    _eq("no separator in the key", "/" in pools[0]["id"][len("local/"):], False)
    if "//" in pools[0]["dir"]:
        fail("the pool directory must not contain a doubled slash: %r" % pools[0]["dir"])
    if not pools[0]["dir"].startswith(pools_root_of(ctx.std.env.home_dir())):
        fail("the pool must sit under the pools root: %r" % pools[0]["dir"])

def _git_common_dir(ctx, cwd: str) -> str:
    """The common dir as `pool_of` gets it: from git, in git's own spelling.

    A hand-built path is not the same thing. On macOS a `mkdtemp` directory
    under `/var` comes back from git as `/private/var`, so a test that builds
    the string itself is testing a configuration the product never has.
    """
    return git_out(ctx.std, ["rev-parse", "--path-format=absolute", "--git-common-dir"], cwd)

def _test_a_lease_survives_git_not_naming_its_path(ctx):
    """The class of bug behind the one above: freeing a lease because git did
    not mention the path assumes both sides spell it identically. A symlinked
    home or another mount would differ the same way, and the next `add` would be
    handed an occupied slot to force-remove. Git is asked about the directory
    itself, which settles it without comparing anyone's spelling."""
    env = _repo_with_worktree(ctx, dirty = False)
    common = _git_common_dir(ctx, env.pool["git_common_dir"])
    registry = {"slots": {env.slot_id: _leased(common, "wip", {})}}

    # A pool that names the same slot by a path git will not report back.
    confused = {"git_common_dir": common, "dir": env.pool["dir"] + "/."}
    reconcile(ctx.std, confused, registry)
    _eq("the lease stands", registry["slots"][env.slot_id]["state"], LEASED)

def _test_a_worktree_the_registry_forgot_is_adopted(ctx):
    """An unreadable registry starts over by design, so the pool has to be able
    to find its own worktrees again. Without this, `add` reports one of its own
    slots as a worktree the pool does not manage and offers no way back."""
    env = _repo_with_worktree(ctx, dirty = False)
    common = _git_common_dir(ctx, env.pool["git_common_dir"])

    # Git's spelling of the slot, so the pool directory is the one git reports.
    at = ""
    for line in git_out(ctx.std, ["worktree", "list", "--porcelain"], common).splitlines():
        if line.startswith("worktree ") and SLOT_PREFIX in line:
            at = line[len("worktree "):].strip()
    if not at:
        fail("the fixture should have left a worktree in a slot")
    pool = {"git_common_dir": common, "dir": at.rsplit("/", 1)[0]}
    slot_id = at.rsplit(SLOT_PREFIX, 1)[1]

    registry = reconcile(ctx.std, pool, {"version": 1, "slots": {}})

    if slot_id not in registry["slots"]:
        fail("the slot should have been adopted: %r" % registry["slots"])
    adopted = registry["slots"][slot_id]
    _eq("leased", adopted["state"], LEASED)
    _eq("under the branch git has", adopted["lease"]["name"], "wip")
    _eq("by nobody in particular", adopted["lease"]["agent"], {})

def _test_adoption_does_not_disturb_a_reservation(ctx):
    """A reserved slot is mid-checkout, so git may already list its worktree.
    Adopting it would replace the reservation that another process is still
    working through."""
    env = _repo_with_worktree(ctx, dirty = False)
    common = _git_common_dir(ctx, env.pool["git_common_dir"])
    at = ""
    for line in git_out(ctx.std, ["worktree", "list", "--porcelain"], common).splitlines():
        if line.startswith("worktree ") and SLOT_PREFIX in line:
            at = line[len("worktree "):].strip()
    pool = {"git_common_dir": common, "dir": at.rsplit("/", 1)[0]}
    slot_id = at.rsplit(SLOT_PREFIX, 1)[1]

    registry = {"slots": {slot_id: _slot(common)}}
    token = reserve_slot(ctx.std, registry, slot_id, "being/made")
    reconcile(ctx.std, pool, registry)

    _eq("still reserved", registry["slots"][slot_id]["state"], RESERVED)
    _eq("still ours", holds_reservation(registry, slot_id, token), True)

def _test_a_lease_ends_when_the_checkout_is_deleted(ctx):
    """One of the two recoveries the pool model promises: an agent that deleted
    its worktree without releasing the slot. Git goes on listing that worktree
    until something prunes it, so the list alone would keep the lease standing
    forever — and `abandoned_lease` cannot help, because it needs a positively
    deleted agent session. A directory that is gone holds nobody's work."""
    env = _repo_with_worktree(ctx, dirty = False)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", {})}}
    ctx.std.fs.remove_dir_all(env.path)
    if env.path not in git_out(ctx.std, ["worktree", "list"], env.pool["git_common_dir"]):
        fail("the fixture should leave git still listing the deleted worktree")

    reconcile(ctx.std, env.pool, registry)
    _eq("freed", registry["slots"][env.slot_id]["state"], FREE)
    _eq("and the lease with it", registry["slots"][env.slot_id]["lease"], None)

def _test_a_lease_ends_when_git_drops_the_worktree(ctx):
    """The other one: somebody ran `git worktree remove` by hand. No lease
    protocol, no timeout — git's own registration is the evidence."""
    env = _repo_with_worktree(ctx, dirty = False)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", {})}}
    run_git(ctx.std, ["worktree", "remove", "--force", env.path], env.pool["git_common_dir"])

    reconcile(ctx.std, env.pool, registry)
    _eq("freed", registry["slots"][env.slot_id]["state"], FREE)

def _test_a_lease_stands_while_the_checkout_is_there(ctx):
    """The inverse, which is what makes the two above safe to act on: an
    ordinary lease over a worktree git lists and the filesystem has must survive
    every reconcile, or the next `add` is handed an occupied slot."""
    env = _repo_with_worktree(ctx, dirty = False)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", {})}}

    reconcile(ctx.std, env.pool, registry)
    _eq("untouched", registry["slots"][env.slot_id]["state"], LEASED)
    _eq("lease intact", registry["slots"][env.slot_id]["lease"]["name"], "wip")

def _test_reconcile_closes_the_history_entry_it_ends(ctx):
    """Four paths end a lease and all four have to close its entry, or the slot's
    history says a branch nobody holds is still checked out — and once the slot
    is leased again, two entries claim to hold it at once."""
    env = _repo_with_worktree(ctx, dirty = False)
    registry = {"slots": {env.slot_id: _leased(env.pool["git_common_dir"], "wip", _A_SESSION)}}
    record_lease(registry, env.slot_id, "wip", _A_SESSION)
    ctx.std.fs.remove_dir_all(env.path)

    reconcile(ctx.std, env.pool, registry)

    entry = registry["slots"][env.slot_id]["history"][-1]
    if not entry["released_ms"]:
        fail("freeing a lease has to close its history entry")

def _test_one_clones_lease_is_not_anothers(ctx):
    """Clones share a pool directory but not the slots in it, and each has its
    own refs — so one clone holding `fix/login` says nothing about another's.
    Searching every slot made `add` refuse the second clone over a session that
    holds nothing of theirs, and `remove` report a release it did not do."""
    registry = {"slots": {
        "theirs": _leased("/other/clone/.git", "fix/login", {}),
        "mine": _slot("/my/clone/.git"),
    }}

    _eq("not mine to find", leased_slot(registry, "fix/login", "/my/clone/.git"), "")
    _eq("theirs to find", leased_slot(registry, "fix/login", "/other/clone/.git"), "theirs")
    _eq("unscoped still searches everything", leased_slot(registry, "fix/login"), "theirs")

def _test_the_listing_leads_with_what_is_happening(ctx):
    """Registry order is the order slots were created in, which tells a reader
    nothing. What is in use belongs at the top, and among the slots they could
    take, the one with the most state behind it."""

    def row(slot, state, server = 0, base = False):
        return {"slot": slot, "state": state, "server_pid": server, "output_base_present": base}

    shuffled = [
        row("e-cold-free", FREE),
        row("d-partly-free", FREE, base = True),
        row("c-warm-free", FREE, server = 4242, base = True),
        row("b-reserved", RESERVED),
        row("a-leased", LEASED),
    ]

    order = [r["slot"] for r in sorted(shuffled, key = testonly_list_order)]
    _eq("in use, being set up, then free by warmth", order, [
        "a-leased",
        "b-reserved",
        "c-warm-free",
        "d-partly-free",
        "e-cold-free",
    ])

def _test_the_listing_order_is_stable(ctx):
    """Two slots alike in every way that matters still have to come out in the
    same order every time, or a listing a reader is watching reshuffles itself
    for no reason."""

    def row(slot):
        return {"slot": slot, "state": FREE, "server_pid": 0, "output_base_present": False}

    first = [r["slot"] for r in sorted([row("bbb"), row("aaa")], key = testonly_list_order)]
    second = [r["slot"] for r in sorted([row("aaa"), row("bbb")], key = testonly_list_order)]
    _eq("by slot, either way round", first, second)

def _test_residue_from_an_older_registry_can_be_collected(ctx):
    """An entry written before `created_ms` existed has no age, so a threshold
    can never be met and nothing would ever collect it. With no output base and
    no directory either, there is nothing behind it to protect — which is the
    only reason it is safe to take at any age."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    registry = {"slots": {"old": {
        "owner_git_dir": pool["git_common_dir"],
        "state": FREE,
        "last_branch": "warm-again",
        "last_commit": "deadbeef",
        "lock_digest": "",
        "lease": None,
    }}}

    _eq("collectable at the default threshold", prunable_slots(ctx.std, pool, registry, 30), ["old"])

def _test_residue_with_a_base_is_left_alone(ctx):
    """The exemption is for entries with nothing behind them. An output base is
    something: it is warm state, and deleting it over a missing field would
    throw away the thing the pool exists to keep."""
    tmp = ctx.std.fs.mkdtemp(prefix = "aspect-wt-test")
    root = ctx.std.fs.mkdtemp(prefix = "aspect-wt-root")
    pool = {"git_common_dir": tmp + "/.git", "dir": tmp + "/pool"}
    registry = {"slots": {"old": {
        "owner_git_dir": pool["git_common_dir"],
        "state": FREE,
        "last_branch": "warm-again",
        "lease": None,
    }}}
    ctx.std.fs.create_dir_all(output_base_of(ctx.std, slot_path(pool, "old"), root))

    _eq("kept", prunable_slots(ctx.std, pool, registry, 30, root), [])

def _test_residue_with_a_checkout_is_left_alone(ctx):
    """And a directory is something too, whatever the registry forgot: it may
    hold somebody's work."""
    env = _repo_with_worktree(ctx, dirty = False)
    registry = {"slots": {env.slot_id: {
        "owner_git_dir": env.pool["git_common_dir"],
        "state": FREE,
        "last_branch": "wip",
        "lease": None,
    }}}

    _eq("kept", prunable_slots(ctx.std, env.pool, registry, 30), [])

def _test_an_unrecorded_count_is_not_zero(ctx):
    """`last_branch` proves the slot held a worktree, so a missing
    `lease_count` means unknown rather than none — and the listing has to be
    able to tell the two apart."""
    old = {"state": FREE, "last_branch": "warm-again"}
    fresh = {"state": FREE, "lease_count": 0}
    _eq("not recorded", old.get("lease_count"), None)
    _eq("recorded as none", fresh.get("lease_count"), 0)
    _eq("no creation time either", slot_age_ms(old), 0)

_UNIT_TESTS = [
    _test_remote_spellings_collapse,
    _test_suffix_behind_a_trailing_slash_is_still_stripped,
    _test_mirrors_on_different_hosts_stay_separate,
    _test_fork_is_its_own_pool,
    _test_empty_remote_yields_no_key,
    _test_slug_is_a_usable_path_component,
    _test_lock_mismatch_nearly_disqualifies,
    _test_commit_distance_only_breaks_a_tie,
    _test_the_branchs_own_slot_outranks_an_unrelated_one,
    _test_an_identical_tree_still_wins_over_the_same_branch,
    _test_a_lock_mismatch_still_beats_everything_down,
    _test_unknown_lock_does_not_disqualify,
    _test_output_base_matches_bazels_own_derivation,
    _test_a_relocated_output_user_root_is_where_a_slot_looks,
    _test_warmth_reads_what_is_really_there,
    _test_registry_round_trips,
    _test_unreadable_registry_starts_over,
    _test_missing_registry_is_empty,
    _test_the_agent_column_is_never_dropped,
    _test_the_listing_leads_with_what_is_happening,
    _test_the_listing_order_is_stable,
    _test_the_refusal_names_who_holds_the_slot,
    _test_a_slot_you_already_hold_says_so,
    _test_a_different_session_is_still_a_refusal,
    _test_an_anonymous_lease_is_nobodys,
    _test_reconcile_closes_the_history_entry_it_ends,
    _test_one_clones_lease_is_not_anothers,
    _test_a_lease_with_no_agent_keeps_the_plain_refusal,
    _test_age_comes_from_the_base_and_falls_back_to_the_floor,
    _test_a_recently_used_base_outranks_an_old_creation_floor,
    _test_prune_never_takes_a_leased_slot,
    _test_prune_respects_the_age_threshold,
    _test_prune_leaves_a_live_clones_slots_alone,
    _test_owned_slots_counts_only_this_clone,
    _test_drop_slot_removes_the_entry_and_the_base,
    _test_drop_slot_refuses_while_a_server_holds_it,
    _test_lock_digest_agrees_between_a_file_and_a_ref,
    _test_a_new_branch_does_not_adopt_its_bases_upstream,
    _test_a_lease_with_no_agent_is_never_abandoned,
    _test_a_gone_session_with_a_clean_checkout_is_abandoned,
    _test_uncommitted_changes_are_never_discarded,
    _test_a_running_session_is_never_abandoned,
    _test_an_unverifiable_harness_is_never_abandoned,
    _test_the_lock_excludes_a_second_caller,
    _test_a_stale_release_cannot_drop_someone_elses_lock,
    _test_a_lock_whose_owner_died_is_reclaimed_at_once,
    _test_a_recycled_pid_does_not_pass_for_the_owner,
    _test_an_unreadable_owner_still_waits_out_the_clock,
    _test_a_reservation_holds_the_slot_and_the_branch,
    _test_a_reservation_whose_process_died_is_reclaimable,
    _test_prune_never_takes_a_slot_being_set_up,
    _test_residue_from_an_older_registry_can_be_collected,
    _test_residue_with_a_base_is_left_alone,
    _test_residue_with_a_checkout_is_left_alone,
    _test_an_unrecorded_count_is_not_zero,
    _test_reconcile_leaves_a_reservation_alone,
    _test_freeing_a_slot_keeps_its_output_base,
    _test_freeing_a_slot_whose_directory_is_gone_still_frees_the_branch,
    _test_a_slot_counts_the_worktrees_it_has_held,
    _test_the_history_is_bounded,
    _test_closing_without_a_history_is_harmless,
    _test_age_and_idleness_answer_in_milliseconds,
    _test_creation_age_is_not_idleness,
    _test_freeing_a_slot_closes_its_history_entry,
    _test_the_history_says_who_held_each_lease,
    _test_a_person_leaves_no_session_in_the_history,
    _test_a_handover_records_a_holder_without_counting_a_lease,
    _test_how_long_a_holder_had_it,
    _test_a_built_in_slot_is_not_dirty,
    _test_real_work_in_a_built_in_slot_still_counts,
    _test_a_tracked_lock_file_that_changed_is_work,
    _test_a_symlink_pointing_elsewhere_is_work,
    _test_a_gone_session_with_only_build_output_is_abandoned,
    _test_a_filesystem_remote_is_not_a_pool_key,
    _test_a_key_cannot_climb_out_of_the_pools_root,
    _test_a_filesystem_origin_still_gets_one_pool_per_repository,
    _test_a_lease_survives_git_not_naming_its_path,
    _test_a_worktree_the_registry_forgot_is_adopted,
    _test_adoption_does_not_disturb_a_reservation,
    _test_a_lease_ends_when_the_checkout_is_deleted,
    _test_a_lease_ends_when_git_drops_the_worktree,
    _test_a_lease_stands_while_the_checkout_is_there,
]

def _test_impl(ctx):
    for t in _UNIT_TESTS:
        t(ctx)
    print("worktree.axl: OK (%d tests)" % len(_UNIT_TESTS))
    return 0

worktree_tests = task(
    summary = "Run the worktree pool AXL unit tests.",
    kind = "test-worktree",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
