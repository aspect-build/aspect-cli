"""Unified-diff (`patch`) helpers.

aspect-cli's lint task collects per-target `.patch` files produced by
linters that can suggest fixes (today: rules_lint's shellcheck wrapper
running with `--format=diff`). Those patches are unified diffs in the
same shape `git diff` / `diff -u` emit. `scan` walks them the way
`patch` does, so a line inside a hunk's body is never read as a header,
and both consumers build on it:

  - `fix_patch.axl` applies them to the working tree, one file section
    at a time
  - `parse` turns them into hunks for per-edit-block PR review comments
    with a `suggestion` block, so reviewers can click "Commit suggestion"
    to accept the linter's proposed fix without leaving the PR

Unified diffs only: no rename detection, no binary-patch decoding, no
fuzz/offset handling.

A patch represents one or more *file changes*; each file change has
one or more *hunks*; each hunk has a sequence of *ops* (context, add,
remove). A single hunk can carry multiple non-adjacent edits when the
unified-diff context window groups them — `hunk_edit_blocks(hunk)`
splits each contiguous run of `+`/`-` ops into its own block, so each
distinct edit gets its own focused review-comment suggestion rather
than one big one that swallows the surrounding context lines.

The shape returned by `parse(patch_text)`:

    [
        {
            "file": "examples/lint/hello.sh",      # path on the new side
            "hunks": [
                {
                    "old_start": 11,    # 1-based line on old side
                    "old_count": 1,
                    "new_start": 11,    # 1-based line on new side
                    "new_count": 1,
                    "ops": [
                        {"kind": "context", "text": " ..."},
                        {"kind": "remove",  "text": "if [ $name = ..."},
                        {"kind": "add",     "text": "if [ \\"$name\\" = ..."},
                        ...
                    ],
                },
                ...
            ],
        },
        ...
    ]
"""

# The most of a patch file read. A larger one is skipped, as anything past
# the cap would be missed.
PATCH_CAP = 64 * 1024 * 1024

Hunk = record(
    old_start = int,
    old_count = int,
    new_start = int,
    new_count = int,
    # Index of its `@@` line, and of the line after its body.
    first = int,
    end = int,
)

# One file's diff: the text after `--- ` and `+++ ` on its header lines
# (`start` and the line after it) and its hunks; `end` is the line after
# its last hunk.
Section = record(
    old = str,
    new = str,
    start = int,
    end = int,
    hunks = list,
)

# A walk of a diff's lines: its sections; every other line outside them,
# as `(index, line)`; and why the walk stopped short, or None.
Diff = record(
    sections = list,
    stray = list,
    problem = field(str | None, default = None),
)

def _range(spec: str) -> tuple | None:
    """`(start, count)` of a hunk range `-a,b` or `+c,d` (count 1 when `,b`
    is left out), or None when it isn't numbers."""
    start, _, count = spec[1:].partition(",")
    count = count or "1"
    if not (start.isdigit() and count.isdigit()):
        return None
    return int(start), int(count)

def _section(header: tuple, hunks: list) -> Section:
    """The `Section` for `header`, `(old, new, start)`, and its `hunks`."""
    old, new, start = header
    return Section(old = old, new = new, start = start, end = hunks[-1].end if hunks else start + 2, hunks = hunks)

def scan(lines: list) -> Diff:
    """Walk a diff's `lines` (its text split at newlines) as `patch` reads
    it. A `--- ` line followed by a `+++ ` one starts a file's section; each
    `@@ ` line right after it, or after the previous hunk, starts a hunk
    whose body is as many lines as its ranges count (an empty line counts
    as context, a `\\` line as none). Any other line ends the section and
    is stray. Stops at a hunk range that isn't numbers or a body that ends
    before its count."""
    if lines and lines[-1] == "":
        lines = lines[:-1]
    sections = []
    stray = []
    current = None
    hunks = []
    i = 0
    for _ in range(len(lines) + 1):
        if i >= len(lines):
            break
        line = lines[i]
        if line.startswith("--- ") and i + 1 < len(lines) and lines[i + 1].startswith("+++ "):
            if current != None:
                sections.append(_section(current, hunks))
            current = (line[4:], lines[i + 1][4:], i)
            hunks = []
            i += 2
            continue
        if line.startswith("@@ ") and current != None:
            ranges = line.split(" ")
            old = _range(ranges[1]) if len(ranges) > 2 and ranges[1].startswith("-") else None
            new = _range(ranges[2]) if len(ranges) > 2 and ranges[2].startswith("+") else None
            if old == None or new == None:
                return Diff(sections = sections, stray = stray, problem = "a hunk's line range isn't numbers")
            old_left, new_left = old[1], new[1]
            j = i + 1
            for _ in range(len(lines)):
                if j >= len(lines) or (old_left <= 0 and new_left <= 0 and not lines[j].startswith("\\")):
                    break
                body = lines[j]
                if body.startswith("\\"):
                    pass
                elif body.startswith("-"):
                    old_left -= 1
                elif body.startswith("+"):
                    new_left -= 1
                else:
                    old_left -= 1
                    new_left -= 1
                j += 1
            if old_left > 0 or new_left > 0:
                return Diff(sections = sections, stray = stray, problem = "a hunk ends before its line count")
            hunks.append(Hunk(old_start = old[0], old_count = old[1], new_start = new[0], new_count = new[1], first = i, end = j))
            i = j
            continue
        if current != None:
            sections.append(_section(current, hunks))
            current = None
            hunks = []
        stray.append((i, line))
        i += 1
    if current != None:
        sections.append(_section(current, hunks))
    return Diff(sections = sections, stray = stray)

def section_ranges(section: Section) -> list:
    """The line ranges `[first, end)` holding `section` alone: its header
    lines and each hunk, nothing between them."""
    return [(section.start, section.start + 2)] + [(h.first, h.end) for h in section.hunks]

def parse(patch_text: str) -> list:
    """Parse unified-diff text into [{file, hunks: [...]}], one per
    `scan` section, `file` its new side's name without a `b/` prefix or
    timestamp. Returns an empty list for empty input; a diff `scan` stops
    short on gives the sections before."""
    if not patch_text:
        return []
    lines = patch_text.split("\n")
    files = []
    for section in scan(lines).sections:
        path = section.new.partition("\t")[0].removesuffix("\r")
        hunks = []
        for h in section.hunks:
            ops = []
            for line in lines[h.first + 1:h.end]:
                if line.startswith("\\"):
                    continue
                if line.startswith("+"):
                    ops.append({"kind": "add", "text": line[1:]})
                elif line.startswith("-"):
                    ops.append({"kind": "remove", "text": line[1:]})
                else:
                    ops.append({"kind": "context", "text": line[1:]})
            hunks.append({
                "old_start": h.old_start,
                "old_count": h.old_count,
                "new_start": h.new_start,
                "new_count": h.new_count,
                "ops": ops,
            })
        files.append({"file": path.removeprefix("b/"), "hunks": hunks})
    return files

def hunk_edit_blocks(hunk):
    """Split a hunk into discrete edit blocks for one-suggestion-per-edit posting.

    A unified-diff hunk groups every change within the configured
    context window into a single `@@` region. shellcheck's
    `--format=diff` (and `git diff`'s default `--unified=3`) routinely
    pulls multiple unrelated edits into one hunk because they sit
    within a few lines of each other. Posting one PR-comment
    `suggestion` block for the whole hunk swallows all the
    intervening context lines, so reviewers see a wall of `-`/`+`
    lines that mostly look identical — visually noisy and slow to
    accept.

    `hunk_edit_blocks` walks the per-line ops and yields one block
    per contiguous run of `add` / `remove` ops with no `context`
    interspersed:

        [
            {
                "start_line":  int,    # 1-based new-side line
                "end_line":    int,    # 1-based new-side line, inclusive
                "replacement": str,    # joined `+` lines, "" for pure-delete
                "removes":     int,    # count of `-` lines in block
                "adds":        int,    # count of `+` lines in block
            },
            ...
        ]

    Pure-add and pure-delete blocks are returned with the appropriate
    field as 0; callers can filter on `removes > 0 and adds > 0` if
    they only want straight replacements (the most common case for
    linter fixes).

    For pure-delete blocks the new-side range is the line *before* the
    deletion (so the suggestion replaces a real line with itself,
    effectively removing the deleted span); replacement is the empty
    string.

    Returns `[]` for hunks with only context (no real edits).
    """
    blocks = []
    new_line = hunk["new_start"]

    block_start = None  # 1-based new-side line where current block begins
    block_adds = []
    block_removes = 0

    for op in hunk["ops"]:
        kind = op["kind"]
        if kind == "context":
            # Close any open block on context boundary.
            if block_start != None:
                _close_block(blocks, block_start, block_adds, block_removes, new_line)
                block_start = None
                block_adds = []
                block_removes = 0
            new_line += 1
            continue
        if kind == "add":
            if block_start == None:
                block_start = new_line
            block_adds.append(op["text"])
            new_line += 1
            continue
        if kind == "remove":
            if block_start == None:
                # Provisional anchor at `new_line`: this is the
                # position the `-` line occupied on the new side, and
                # also the position any following `+` in the block
                # will land (since `remove` doesn't advance new_line).
                # Mixed blocks (remove then add) end with the block
                # correctly anchored at the new-side line that ends
                # up holding the replacement.
                #
                # For PURE-delete blocks (no `+` at all), `_close_block`
                # adjusts to `block_start - 1` — the deleted lines
                # leave a gap on the new side, so the suggestion-block
                # range anchors on the line above.
                block_start = new_line
            block_removes += 1

            # `remove` doesn't advance new_line — the line is gone on the new side.
            continue

    # Close any block left open at end of hunk.
    if block_start != None:
        _close_block(blocks, block_start, block_adds, block_removes, new_line)

    return blocks

def _close_block(blocks, block_start, block_adds, block_removes, new_line):
    """Append a block dict to `blocks`. Used by `hunk_edit_blocks` at
    every context boundary and at end-of-hunk.

    For mixed blocks (remove + add), `block_start` is already the
    correct new-side line where the replacement lands — the remove
    op sets it to the position the `-` occupied (which the `+` then
    inherits). For pure-delete blocks, `block_start` points at the
    first removed line's new-side position, which doesn't exist on
    the new side anymore — adjust to the line above the gap.
    """
    adds = len(block_adds)
    if adds > 0:
        end_line = block_start + adds - 1
        replacement = "\n".join(block_adds)
    else:
        # Pure delete — block_start currently points to the position
        # of the first removed line. After the deletion the new side
        # has nothing there, so anchor the suggestion on the line
        # above the gap. (Edge case: if the first remove was at
        # line 1, `block_start - 1` would be 0; clamp to 1 so we
        # produce a valid GitHub anchor.)
        if block_start > 1:
            block_start = block_start - 1
        end_line = block_start
        replacement = ""
    blocks.append({
        "start_line": block_start,
        "end_line": end_line,
        "replacement": replacement,
        "removes": block_removes,
        "adds": adds,
    })
