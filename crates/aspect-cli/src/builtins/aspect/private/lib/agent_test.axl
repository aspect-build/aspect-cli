"""Unit tests for lib/agent.axl — who is running a task, and whether their
session is still there.

Run with:
  aspect dev test-agent

The Claude Code variable names are taken from a live session rather than
invented: `CLAUDECODE=1`, `CLAUDE_CODE_SESSION_ID=<uuid>`, `CLAUDE_PID=<pid>`,
and a transcript at `~/.claude/projects/<slug>/<session-id>.jsonl`.

Every test that touches the environment sets both states explicitly and restores
what was there, because this suite runs inside a Claude Code session often
enough that neither value can be assumed.
"""

load(
    "./agent.axl",
    "GONE",
    "RESUMABLE",
    "RUNNING",
    "UNKNOWN",
    "detect",
    "is_running",
    "label",
    "resume_hint",
    "session_project",
    "session_state",
    "testonly_binaries",
    "testonly_env_detectors",
    "testonly_harnesses",
)

_AGENT_VARS = [
    "CODEX_THREAD_ID",
    "CLAUDE_PROJECT_DIR",
    "CURSOR_AGENT",
    "CURSOR_PROJECT_DIR",
    "GEMINI_PROJECT_DIR",
    "GEMINI_CLI",
    "GEMINI_SESSION_ID",
    "GROK_HOME",
    "GROK_SESSION_ID",
    "ASPECT_AGENT_KIND",
    "ASPECT_AGENT_ID",
    "CLAUDECODE",
    "CLAUDE_CODE_SESSION_ID",
    "CLAUDE_PID",
    "CLAUDE_CONFIG_DIR",
    "AI_AGENT",
]

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _clear(ctx):
    """Drop every variable detection reads, returning what was there."""
    saved = {}
    for v in _AGENT_VARS:
        saved[v] = ctx.std.env.var(v) or ""
        ctx.std.env.remove_var(v)
    return saved

def _restore(ctx, saved):
    for v in saved:
        if saved[v]:
            ctx.std.env.set_var(v, saved[v])
        else:
            ctx.std.env.remove_var(v)

def _test_an_explicit_id_keeps_the_rest_of_the_identity(ctx):
    """The reason to pass `--agent-id` is to tell sibling agents of one session
    apart, and that is exactly where the other fields matter most.

    Replacing the whole record instead of the named field left the kind as the
    literal "unknown", the pid as 0 — so liveness could never be established
    and the slot could never be reclaimed — and no project, so no resume
    command was ever offered. The flag names a field; detection answers the
    others.
    """
    saved = _clear(ctx)
    ctx.std.env.set_var("CLAUDECODE", "1")
    ctx.std.env.set_var("CLAUDE_CODE_SESSION_ID", "parent-session")
    ctx.std.env.set_var("CLAUDE_PID", str(ctx.std.process.id()))
    got = detect(ctx.std, "", "worker-a")
    _restore(ctx, saved)

    _eq("the id the caller gave", got.get("id"), "worker-a")
    _eq("the kind detection found", got.get("kind"), "claude-code")
    _eq("and the pid with it, so liveness still works", got.get("pid"), ctx.std.process.id())
    _eq("reported as caller-supplied", got.get("source"), "flag")
    _eq(
        "with a resume command for the harness",
        resume_hint(got),
        "claude --resume worker-a",
    )

def _test_an_explicit_kind_for_another_harness_drops_the_pid(ctx):
    """A pid identifies the process of the harness that was *detected*. Told
    this is a different harness, carrying it would answer liveness about the
    wrong process — and answering that wrongly is what licenses taking a slot
    away from somebody."""
    saved = _clear(ctx)
    ctx.std.env.set_var("CLAUDECODE", "1")
    ctx.std.env.set_var("CLAUDE_CODE_SESSION_ID", "parent-session")
    ctx.std.env.set_var("CLAUDE_PID", str(ctx.std.process.id()))
    got = detect(ctx.std, "codex", "thread-1")
    _restore(ctx, saved)

    _eq("the kind the caller gave", got.get("kind"), "codex")
    _eq("the id the caller gave", got.get("id"), "thread-1")
    _eq("no pid from the other harness", got.get("pid"), 0)
    _eq("so liveness is not claimed", is_running(ctx.std, got), False)

def _test_flags_beat_everything(ctx):
    """A harness that states what it is must be believed over any inference —
    it is the only source that cannot be wrong about itself."""
    saved = _clear(ctx)
    ctx.std.env.set_var("ASPECT_AGENT_KIND", "from-env")
    ctx.std.env.set_var("CLAUDECODE", "1")
    got = detect(ctx.std, "from-flag", "id-123")
    _restore(ctx, saved)
    _eq("kind", got["kind"], "from-flag")
    _eq("id", got["id"], "id-123")
    _eq("source", got["source"], "flag")

def _test_the_neutral_contract_beats_a_known_harness(ctx):
    """`ASPECT_AGENT_*` is what a harness we have never heard of sets, so it
    outranks our own guess about a harness we have."""
    saved = _clear(ctx)
    ctx.std.env.set_var("CLAUDECODE", "1")
    ctx.std.env.set_var("CLAUDE_CODE_SESSION_ID", "should-be-ignored")
    ctx.std.env.set_var("ASPECT_AGENT_KIND", "codex")
    ctx.std.env.set_var("ASPECT_AGENT_ID", "sess-abc")
    got = detect(ctx.std, "", "")
    _restore(ctx, saved)
    _eq("kind", got["kind"], "codex")
    _eq("id", got["id"], "sess-abc")
    _eq("source", got["source"], "env")

def _test_claude_code_is_detected_from_its_own_variables(ctx):
    saved = _clear(ctx)
    ctx.std.env.set_var("CLAUDECODE", "1")
    ctx.std.env.set_var("CLAUDE_CODE_SESSION_ID", "b22fe20c-1f9f-4476-9097-9f4648158215")
    got = detect(ctx.std, "", "")
    _restore(ctx, saved)
    _eq("kind", got["kind"], "claude-code")
    _eq("id", got["id"], "b22fe20c-1f9f-4476-9097-9f4648158215")

def _test_codex_is_detected_from_the_thread_id_it_exports(ctx):
    """Codex sets `CODEX_THREAD_ID` for shell and tool executions, which is how
    a task it runs arrives here. It sets no "you are inside Codex" marker, so
    the id variable is the whole signal — a detector shape Claude Code's entry
    does not exercise.
    """
    saved = _clear(ctx)
    ctx.std.env.set_var("CODEX_THREAD_ID", "019edfd4-fbf0-7100-a982-2ab5bdf125fb")
    got = detect(ctx.std, "", "")
    _restore(ctx, saved)

    _eq("the harness", got.get("kind"), "codex")
    _eq("the session it named", got.get("id"), "019edfd4-fbf0-7100-a982-2ab5bdf125fb")
    _eq("reported, not inferred", got.get("source"), "env")

def _test_gemini_is_detected_with_a_kind_and_no_session(ctx):
    """The mirror shape: Gemini CLI exports `GEMINI_CLI=1` and documents no
    session id. The kind has to be reported and the id left empty rather than
    filled with the marker's value, which would print as a session that cannot
    be resumed.
    """
    saved = _clear(ctx)
    ctx.std.env.set_var("GEMINI_CLI", "1")
    got = detect(ctx.std, "", "")
    _restore(ctx, saved)

    _eq("the harness", got.get("kind"), "gemini-cli")
    _eq("no session claimed", got.get("id"), "")
    _eq("so nothing to resume", resume_hint(got), "")

def _test_cursor_is_detected_from_a_marker_whose_value_is_unspecified(ctx):
    """Cursor's terminal docs say to test that `CURSOR_AGENT` is *set*, not that
    it equals anything, so any non-empty value counts and an empty one does not.
    No session id reaches a tool — Cursor puts it on a hook's stdin — so the
    kind is the whole answer.
    """
    saved = _clear(ctx)
    ctx.std.env.set_var("CURSOR_AGENT", "1")
    one = detect(ctx.std, "", "")
    ctx.std.env.set_var("CURSOR_AGENT", "anything")
    other = detect(ctx.std, "", "")
    _restore(ctx, saved)

    _eq("the documented value", one.get("kind"), "cursor")
    _eq("any value, since only presence is promised", other.get("kind"), "cursor")
    _eq("no session claimed", one.get("id"), "")

def _test_gemini_names_its_session_when_run_as_a_hook(ctx):
    """`GEMINI_SESSION_ID` is given to hook processes and not to shell tools, and
    a hook may not carry the marker, so the id alone has to be enough to fire."""
    saved = _clear(ctx)
    ctx.std.env.set_var("GEMINI_SESSION_ID", "4e0c1f2a-dead-beef-cafe-000000000000")
    got = detect(ctx.std, "", "")
    _restore(ctx, saved)

    _eq("the harness", got.get("kind"), "gemini-cli")
    _eq("the session", got.get("id"), "4e0c1f2a-dead-beef-cafe-000000000000")
    _eq("and a way back to it", resume_hint(got), "gemini --resume 4e0c1f2a-dead-beef-cafe-000000000000")

def _test_grok_is_named_and_its_sessions_can_be_found(ctx):
    """Grok injects `GROK_SESSION_ID` into tool commands, so a task it runs is
    named. Its store is also searchable — a directory per session under a
    directory per working tree — which is what lets `session_state` separate a
    deleted session from a closed terminal, and so lets an abandoned Grok slot
    be reclaimed rather than only reported.

    The session being a directory rather than a file is the whole difference
    from Claude Code's entry, and an existence check does not care which.
    """
    saved = _clear(ctx)
    home = ctx.std.fs.mkdtemp(prefix = "aspect-grok")
    ctx.std.env.set_var("GROK_HOME", home)
    ctx.std.env.set_var("GROK_SESSION_ID", "01993b7e-0000-7000-8000-000000000001")
    ctx.std.fs.create_dir_all(home + "/sessions/-Users-me-src-web/01993b7e-0000-7000-8000-000000000001")

    got = detect(ctx.std, "", "")
    found = session_state(ctx.std, got | {"pid": 0, "pid_start": ""})
    absent = session_state(ctx.std, {"kind": "grok", "id": "01993b7e-dead", "pid": 0})
    _restore(ctx, saved)

    _eq("the harness", got.get("kind"), "grok")
    _eq("the session it named", got.get("id"), "01993b7e-0000-7000-8000-000000000001")
    _eq("a way back to it", resume_hint(got), "grok --resume 01993b7e-0000-7000-8000-000000000001")
    _eq("stored, so resumable", found, RESUMABLE)
    _eq("and a real miss is gone", absent, GONE)

def _test_an_undescribed_store_is_unknown_for_every_harness(ctx):
    """Codex files sessions by date and Cursor under a hash of the workspace,
    neither of which this reads. They must come back `unknown`: `gone` is the
    only verdict that lets `add` take a slot back, and it may never rest on a
    layout nobody has checked.
    """
    saved = _clear(ctx)
    states = [
        session_state(ctx.std, {"kind": "codex", "id": "abc", "pid": 0}),
        session_state(ctx.std, {"kind": "cursor", "id": "abc", "pid": 0}),
        session_state(ctx.std, {"kind": "gemini-cli", "id": "abc", "pid": 0}),
    ]
    _restore(ctx, saved)

    for state in states:
        _eq("no store described", state, UNKNOWN)

def _test_a_generic_ai_agent_variable_gives_a_kind_but_no_session(ctx):
    """`AI_AGENT` is spelled `<tool>_<version>_<role>`. The tool segment is a
    kind; nothing in it identifies a session, and claiming otherwise would put
    a version string in the id column."""
    saved = _clear(ctx)
    ctx.std.env.set_var("AI_AGENT", "some-harness_1-2-3_agent")
    got = detect(ctx.std, "", "")
    _restore(ctx, saved)

    # The ancestry walk runs first and wins when this suite is itself under a
    # recognized harness, so only assert what holds either way.
    if got.get("source", "") == "env":
        _eq("kind", got["kind"], "some-harness")
        _eq("no session id", got["id"], "")

def _test_a_record_with_no_pid_is_not_claimed_to_be_running(ctx):
    """`is_running` answers only what it can verify. Treating a missing pid as
    alive would stop `session_state` ever reaching the session check, which is
    the signal that actually matters."""
    _eq("no pid", is_running(ctx.std, {"kind": "claude-code", "id": "x"}), False)
    _eq("zero pid", is_running(ctx.std, {"pid": 0}), False)

def _test_a_live_pid_counts_only_with_a_matching_start_time(ctx):
    """Pids are reused and a lease outlives the process that took it, so the
    start time is what makes the pid trustworthy."""
    me = ctx.std.process.id()
    _eq("this process is alive", is_running(ctx.std, {"pid": me, "pid_start": _start_of(ctx, me)}), True)
    _eq(
        "a mismatched start time is a different process",
        is_running(ctx.std, {"pid": me, "pid_start": "Thu  1 Jan 00:00:00 1970"}),
        False,
    )

def _start_of(ctx, pid):
    out = ctx.std.process.command("ps").args(["-o", "lstart=", "-p", str(pid)]) \
        .stdout("piped").stderr("null").spawn().wait_with_output()
    return out.stdout.strip()

def _test_an_unknown_harness_layout_is_never_gone(ctx):
    """`gone` is the only verdict anything acts on. A harness whose session
    storage we cannot inspect must come back `unknown`, or a slot would be taken
    from a session that is sitting there waiting to be resumed."""
    _eq("unknown harness", session_state(ctx.std, {"kind": "codex", "id": "sess-abc"}), UNKNOWN)
    _eq("no id at all", session_state(ctx.std, {"kind": "claude-code", "id": ""}), UNKNOWN)
    _eq("no agent", session_state(ctx.std, {}), UNKNOWN)

def _test_a_claude_session_absent_from_disk_is_gone(ctx):
    """A session id that is not stored anywhere cannot be resumed, which is what
    distinguishes a finished lease from a closed terminal.

    Only meaningful where the sessions directory exists to be searched; where it
    does not, the next test is the one that applies.
    """
    saved = _clear(ctx)
    missing = {"kind": "claude-code", "id": "00000000-dead-dead-dead-000000000000"}
    root = ctx.std.env.home_dir() + "/.claude/projects"
    got = session_state(ctx.std, missing)
    _restore(ctx, saved)
    _eq("absent", got, GONE if ctx.std.fs.exists(root) else UNKNOWN)

def _test_a_missing_sessions_directory_is_unknown_not_gone(ctx):
    """The dangerous case. `gone` is what lets `add` take a slot back, so
    reading "I cannot find the sessions directory" as "the session is deleted"
    would hand a resumable agent's clean checkout to someone else. A relocated
    or absent store has to come back `unknown`.
    """
    saved = _clear(ctx)
    ctx.std.env.set_var("CLAUDE_CONFIG_DIR", ctx.std.fs.mkdtemp(prefix = "aspect-no-sessions"))
    got = session_state(ctx.std, {"kind": "claude-code", "id": "whatever"})
    _restore(ctx, saved)
    _eq("no store to search", got, UNKNOWN)

def _test_claude_config_dir_relocates_the_session_store(ctx):
    """Claude Code honours `CLAUDE_CONFIG_DIR`, so the home directory is a
    fallback rather than the answer."""
    saved = _clear(ctx)
    home = ctx.std.fs.mkdtemp(prefix = "aspect-cfg")
    ctx.std.fs.create_dir_all(home + "/projects/some-project")
    ctx.std.fs.write(home + "/projects/some-project/abc-123.jsonl", "{}\n")
    ctx.std.env.set_var("CLAUDE_CONFIG_DIR", home)
    found = session_state(ctx.std, {"kind": "claude-code", "id": "abc-123"})
    absent = session_state(ctx.std, {"kind": "claude-code", "id": "not-there"})
    _restore(ctx, saved)
    _eq("found under the relocated root", found, RESUMABLE)
    _eq("and a real miss there is still gone", absent, GONE)

def _test_the_project_is_the_cwd_when_the_store_agrees(ctx):
    """The listing shows a project so you can get back to a session, so it has
    to be the directory the harness actually ran in — not a guess.

    The store files a session under the started-in path with `/` and `.`
    flattened to dashes. That is checkable in one direction: flatten the
    recorded `cwd` and see whether the session really is filed there.
    """
    saved = _clear(ctx)
    home = ctx.std.fs.mkdtemp(prefix = "aspect-proj")
    cwd = "/Users/me/src/web/.claude/worktrees/fix-login"
    slug = "-Users-me-src-web--claude-worktrees-fix-login"
    ctx.std.fs.create_dir_all(home + "/projects/" + slug)
    ctx.std.fs.write(home + "/projects/" + slug + "/sess-1.jsonl", "{}\n")
    ctx.std.env.set_var("CLAUDE_CONFIG_DIR", home)

    got = session_project(ctx.std, {"kind": "claude-code", "id": "sess-1", "cwd": cwd})
    _restore(ctx, saved)

    _eq("the real path, not the slug", got, cwd)

def _test_no_project_is_reported_when_the_cwd_disagrees(ctx):
    """An agent that runs `aspect worktree add` from somewhere other than where
    its harness started records a `cwd` that is not the project, and the store's
    layout cannot be decoded to find out what is. So there is no answer.

    Neither candidate may be printed. The `cwd` is wrong, and the store's own
    directory is where a transcript is filed rather than a directory anyone can
    enter — and a reader may try to `cd` to whatever this returns.
    """
    saved = _clear(ctx)
    home = ctx.std.fs.mkdtemp(prefix = "aspect-proj-odd")
    slug = "-Users-me-src-web"
    ctx.std.fs.create_dir_all(home + "/projects/" + slug)
    ctx.std.fs.write(home + "/projects/" + slug + "/sess-2.jsonl", "{}\n")
    ctx.std.env.set_var("CLAUDE_CONFIG_DIR", home)

    got = session_project(ctx.std, {
        "kind": "claude-code",
        "id": "sess-2",
        "cwd": "/somewhere/else/entirely",
    })
    _restore(ctx, saved)

    _eq("nothing, rather than either candidate", got, "")

def _test_a_harness_that_states_its_project_is_believed(ctx):
    """A hook invocation is handed the project directory outright, which beats
    anything worked out from a path — and is the only way a harness whose store
    this does not read can report one at all.

    It is captured at detection because the variable exists only while the
    harness runs, and the lease outlives it.
    """
    saved = _clear(ctx)
    ctx.std.env.set_var("CURSOR_AGENT", "1")
    ctx.std.env.set_var("CURSOR_PROJECT_DIR", "/Users/me/src/web")
    got = detect(ctx.std, "", "")
    project = session_project(ctx.std, got)
    _restore(ctx, saved)

    _eq("recorded at detection", got.get("project"), "/Users/me/src/web")
    _eq("and reported as the project", project, "/Users/me/src/web")

def _test_no_project_is_claimed_without_one(ctx):
    """Every way of not knowing: a harness the store is not described for, a
    record with no session id, and a session that is not filed anywhere."""
    saved = _clear(ctx)
    home = ctx.std.fs.mkdtemp(prefix = "aspect-proj-none")
    ctx.std.fs.create_dir_all(home + "/projects")
    ctx.std.env.set_var("CLAUDE_CONFIG_DIR", home)

    unknown_harness = session_project(ctx.std, {"kind": "codex", "id": "sess-3", "cwd": "/x"})
    no_id = session_project(ctx.std, {"kind": "claude-code", "id": "", "cwd": "/x"})
    not_filed = session_project(ctx.std, {"kind": "claude-code", "id": "sess-4", "cwd": "/x"})
    no_agent = session_project(ctx.std, {})
    _restore(ctx, saved)

    _eq("harness not described", unknown_harness, "")
    _eq("no session id", no_id, "")
    _eq("session not filed", not_filed, "")
    _eq("no agent at all", no_agent, "")

def _test_a_running_process_outranks_the_session_check(ctx):
    """A live harness is in use whatever is on disk, so the cheap, certain
    signal is consulted first."""
    me = ctx.std.process.id()
    live = {
        "kind": "claude-code",
        "id": "00000000-dead-dead-dead-000000000000",
        "pid": me,
        "pid_start": _start_of(ctx, me),
    }
    _eq("alive beats a missing transcript", session_state(ctx.std, live), RUNNING)

def _test_label_is_a_glance_not_a_copy_source(ctx):
    _eq("kind and short id", label({"kind": "claude-code", "id": "b22fe20c-1f9f-4476"}), "claude-code b22fe20c")
    _eq("no id", label({"kind": "codex", "id": ""}), "codex")
    _eq("no kind", label({"kind": "", "id": ""}), "agent")
    _eq("no agent", label({}), "")

def _test_resume_is_offered_only_where_the_command_is_known(ctx):
    """Printing a resume command for a harness whose syntax we have not checked
    would be worse than printing none.

    The spellings come from each vendor's own reference, and a harness only
    recognized by name — `aider` here — gets nothing until one is confirmed.
    """
    _eq("claude code", resume_hint({"kind": "claude-code", "id": "abc"}), "claude --resume abc")
    _eq("codex", resume_hint({"kind": "codex", "id": "abc"}), "codex resume abc")
    _eq("gemini cli", resume_hint({"kind": "gemini-cli", "id": "abc"}), "gemini --resume abc")
    _eq("cursor", resume_hint({"kind": "cursor", "id": "abc"}), "cursor-agent --resume abc")
    _eq("recognized but unconfirmed", resume_hint({"kind": "aider", "id": "abc"}), "")
    _eq("no session id", resume_hint({"kind": "claude-code", "id": ""}), "")

def _test_every_described_harness_is_a_kind_detection_can_report(ctx):
    """The tables are reached from opposite ends: detection produces a kind,
    `_HARNESSES` is looked up by one. A kind described in the second that no
    layer in the first can produce reads as support for a harness while being
    permanently unreachable — `session_state` would answer `unknown` and
    `resume_hint` nothing, with the row sitting there looking correct.
    """
    detectable = {d.kind: True for d in testonly_env_detectors}
    for kind in testonly_binaries.values():
        detectable[kind] = True

    for kind in testonly_harnesses:
        if kind not in detectable:
            fail("_HARNESSES describes " + kind + ", which no detection layer reports; " +
                 "add it to _ENV_DETECTORS or _BINARIES, or correct the spelling")

def _test_a_person_at_a_terminal_is_not_an_agent(ctx):
    """Detection has to come back empty for a human, or every slot would be
    labelled with whatever process happened to be above it."""
    saved = _clear(ctx)
    got = detect(ctx.std, "", "")
    _restore(ctx, saved)

    # Under a recognized harness the ancestry layer answers, and that is correct
    # here; what must never happen is a record with no kind at all.
    if got:
        if not got.get("kind", ""):
            fail("a detected agent must always carry a kind")
        _eq("inferred from the process tree", got["source"], "ancestry")

_UNIT_TESTS = [
    _test_flags_beat_everything,
    _test_an_explicit_id_keeps_the_rest_of_the_identity,
    _test_an_explicit_kind_for_another_harness_drops_the_pid,
    _test_the_neutral_contract_beats_a_known_harness,
    _test_claude_code_is_detected_from_its_own_variables,
    _test_a_generic_ai_agent_variable_gives_a_kind_but_no_session,
    _test_a_record_with_no_pid_is_not_claimed_to_be_running,
    _test_a_live_pid_counts_only_with_a_matching_start_time,
    _test_an_unknown_harness_layout_is_never_gone,
    _test_a_claude_session_absent_from_disk_is_gone,
    _test_a_missing_sessions_directory_is_unknown_not_gone,
    _test_claude_config_dir_relocates_the_session_store,
    _test_a_running_process_outranks_the_session_check,
    _test_label_is_a_glance_not_a_copy_source,
    _test_resume_is_offered_only_where_the_command_is_known,
    _test_every_described_harness_is_a_kind_detection_can_report,
    _test_the_project_is_the_cwd_when_the_store_agrees,
    _test_no_project_is_reported_when_the_cwd_disagrees,
    _test_no_project_is_claimed_without_one,
    _test_a_harness_that_states_its_project_is_believed,
    _test_codex_is_detected_from_the_thread_id_it_exports,
    _test_gemini_is_detected_with_a_kind_and_no_session,
    _test_cursor_is_detected_from_a_marker_whose_value_is_unspecified,
    _test_gemini_names_its_session_when_run_as_a_hook,
    _test_grok_is_named_and_its_sessions_can_be_found,
    _test_an_undescribed_store_is_unknown_for_every_harness,
    _test_a_person_at_a_terminal_is_not_an_agent,
]

def _test_impl(ctx):
    for t in _UNIT_TESTS:
        t(ctx)
    print("agent.axl: OK (%d tests)" % len(_UNIT_TESTS))
    return 0

agent_tests = task(
    summary = "Run the agent-detection AXL unit tests.",
    kind = "test-agent",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
