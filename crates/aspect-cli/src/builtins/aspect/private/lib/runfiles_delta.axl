"""Runfiles-scope change computation for `--watch` IBP cycles.

Joins three inputs into one IBP `sources` map keyed by runfiles path:

  - the target's runfiles manifest (`<runfiles_dir>/MANIFEST`), diffed against
    the previous cycle's snapshot: removed entries become deletions, added or
    origin-swapped entries become changes;
  - the watcher's source-file changes, mapped to runfiles paths via the
    manifest's origin column;
  - the rebuild's compact execution log: spawn / symlink-action outputs whose
    digest changed since the last cycle, mapped to runfiles paths via the
    `bazel-out/...` suffix of the manifest origin. Non-spawn actions (e.g.
    `ctx.actions.write`) don't appear in the compact log; their runfiles are
    caught only via manifest origin changes.

Values follow `IbpServer.cycle`: "source" | "symlink" | "generated" | None
(deleted)."""

def _unescape(s: str) -> str:
    out = ""
    i = 0
    n = len(s)
    for _ in range(n):
        if i >= n:
            break
        c = s[i]
        if c == "\\" and i + 1 < n:
            e = s[i + 1]
            if e == "s":
                out += " "
            elif e == "n":
                out += "\n"
            elif e == "b":
                out += "\\"
            else:
                out += c + e
            i += 2
        else:
            out += c
            i += 1
    return out

def _parse_manifest(content: str) -> dict:
    """`rloc -> origin` from runfiles MANIFEST text. Origin is "" for entries
    with no target (e.g. empty files). A line starting with a space is an
    escaped record (paths containing space/newline/backslash, encoded as
    `\\s` / `\\n` / `\\b`)."""
    entries = {}
    for line in content.splitlines():
        if not line:
            continue
        escaped = line.startswith(" ")
        if escaped:
            line = line[1:]
        parts = line.split(" ", 1)
        rloc = parts[0]
        origin = parts[1] if len(parts) > 1 else ""
        if escaped:
            rloc = _unescape(rloc)
            origin = _unescape(origin)
        entries[rloc] = origin
    return entries

def _classify(origin: str) -> str:
    """The change state for a runfiles entry known only by its origin path:
    generated output (or synthesized empty file), in-tree symlink (relative
    origin), or source file."""
    if not origin or "/bazel-out/" in origin:
        return "generated"
    if not origin.startswith("/"):
        return "symlink"
    return "source"

def _compute(manifest: dict, prev_manifest: dict, source_changes: list, log_entries, digests: dict, entry_kind = type) -> dict:
    """The pure delta join; `digests` is mutated with the latest output hashes.

    `source_changes` are structs with `path` (absolute) and `kind`
    ("created"/"modified"/"removed"); `log_entries` an iterable of
    `ExecLogEntry` (or fakes with the same shape). `entry_kind` resolves an
    entry payload to its variant name — the default `type` works on real
    starbuf entries; tests inject their own to use plain structs."""
    by_origin = {}
    by_execpath = {}
    for rloc, origin in manifest.items():
        if not origin:
            continue
        by_origin.setdefault(origin, []).append(rloc)
        idx = origin.find("/bazel-out/")
        if idx >= 0:
            by_execpath.setdefault(origin[idx + 1:], []).append(rloc)

    changes = {}
    for rloc in prev_manifest:
        if rloc not in manifest:
            changes[rloc] = None
    for rloc, origin in manifest.items():
        prev_origin = prev_manifest.get(rloc)
        if prev_origin == None or prev_origin != origin:
            # Added, or repointed at a different artifact — changed even when
            # the artifact contents themselves didn't rebuild.
            changes[rloc] = _classify(origin)

    for c in source_changes:
        if c.kind == "removed":
            continue
        for rloc in by_origin.get(c.path, []):
            changes[rloc] = "source"

    outputs = {}
    out_ids = []
    for entry in log_entries:
        t = entry.type
        tt = entry_kind(t)
        if tt == "file":
            outputs[entry.id] = [(t.path, t.digest.hash if t.digest != None else "")]
        elif tt == "directory":
            children = [(t.path + "/" + f.path, f.digest.hash if f.digest != None else "") for f in t.files]
            # The manifest can map a runfiles path to the directory artifact
            # itself; give it an aggregate digest so tree changes are seen.
            aggregate = "|".join([p + "=" + d for p, d in children])
            outputs[entry.id] = children + [(t.path, aggregate)]
        elif tt == "unresolved_symlink":
            outputs[entry.id] = [(t.path, t.target_path)]
        elif tt == "spawn":
            for o in t.outputs:
                # The Output oneof surfaces as `o.type` (an int for
                # output_id); older shapes exposed `o.output_id` directly.
                oid = getattr(o, "output_id", None)
                if oid == None:
                    v = getattr(o, "type", None)
                    oid = v if type(v) == "int" else None
                if oid != None:
                    out_ids.append(oid)
        elif tt == "symlink_action":
            for rloc in by_execpath.get(t.output_path, []):
                changes[rloc] = "symlink"

    for oid in out_ids:
        for path, digest in outputs.get(oid, []):
            if digests.get(path) == digest:
                continue
            digests[path] = digest
            for rloc in by_execpath.get(path, []):
                changes[rloc] = "generated"

    return changes

def _new(ctx: TaskContext) -> struct:
    """Per-watch delta tracker.

    Call `baseline(ep)` after every spawn so the first cycle diffs against the
    manifest the running process actually saw. Call
    `compute(ep, execlog_path, source_changes)` after each successful rebuild;
    digest and manifest state carry across cycles so only genuinely changed
    outputs are reported. `compute` returns None when the manifest is missing
    — delta state is lost and the caller must reset or restart."""
    state = {"digests": {}, "manifest": {}}

    def read_manifest(ep: struct):
        if ep == None or ep.runfiles_dir == None:
            return None
        manifest_path = ep.runfiles_dir + "/MANIFEST"
        if not ctx.std.fs.exists(manifest_path):
            return None
        return _parse_manifest(ctx.std.fs.read_to_string(manifest_path))

    def full(ep: struct) -> dict | None:
        """Every runfiles entry, classified — the initial cycle for a pre-v2
        client that populates its state from the first CYCLE's sources list.
        Resets the tracker like `baseline`."""
        manifest = read_manifest(ep)
        if manifest == None:
            return None
        state["manifest"] = manifest
        state["digests"] = {}
        return {rloc: _classify(origin) for rloc, origin in manifest.items()}

    def baseline(ep: struct) -> None:
        manifest = read_manifest(ep)
        if manifest != None:
            state["manifest"] = manifest
        # A fresh process means fresh client state: stale digests from the
        # previous process could suppress an output reverting to an old hash.
        state["digests"] = {}

    def compute(ep: struct, execlog_path: str | None, source_changes: list) -> dict | None:
        manifest = read_manifest(ep)
        if manifest == None:
            return None
        log_entries = []
        if execlog_path != None and ctx.std.fs.exists(execlog_path):
            log_entries = bazel.build.execution_log.ExecLogEntry().parse_from_delimited(ctx.std.fs.open(execlog_path))
        changes = _compute(manifest, state["manifest"], source_changes, log_entries, state["digests"])
        state["manifest"] = manifest
        return changes

    return struct(compute = compute, baseline = baseline, full = full)

runfiles_delta = namespace(
    new = _new,
    testonly_parse_manifest = _parse_manifest,
    testonly_compute = _compute,
)
