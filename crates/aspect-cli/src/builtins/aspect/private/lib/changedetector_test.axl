def _test_impl(ctx):
    for t in _UNIT_TESTS:
        t(ctx)
    print("changedetector.axl: OK (%d tests)" % len(_UNIT_TESTS))
    return 0

changedetector_tests = task(
    summary = "Run the change detector AXL unit tests.",
    kind = "test-changedetector",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
