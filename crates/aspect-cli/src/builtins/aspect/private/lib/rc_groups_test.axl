"""Unit tests for `rc_groups.axl`: what each named `--config` group holds, the CI
host group's naming, the runner's per-endpoint groups, and which groups an rc
enables. Run with: aspect dev test-rc-groups
"""

load("./aspect_flags.axl", "diagnostics_upload_flags", "endpoint_flags", "independent_flags")
load("./environment.axl", "BuildEvents", "CI", "RemoteCache", "RemoteExecutor", "Runner", "WorkflowsEnvironment")
load(
    "./rc_groups.axl",
    "GROUP_BES",
    "GROUP_CACHE",
    "GROUP_COMMON",
    "GROUP_EXEC",
    "GROUP_RUNNER_BES",
    "GROUP_RUNNER_CACHE",
    "GROUP_RUNNER_EXEC",
    "GROUP_RUNNER_STORAGE",
    "HOST_GROUPS",
    "enabled_groups",
    "host_group",
    "runner_groups",
    "tuning_groups",
)

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _texts(flags) -> list:
    return [f[0] if type(f) == "tuple" else f for f in flags]

def _by_name(configs) -> dict:
    return {c.name: c for c in configs}

_RUNNER = Runner(bazel_root_dir = "/mnt/b", output_root_dir = "/mnt/o", repository_cache_dir = "/mnt/r", job_tmpdir = "/wf")
_CACHE = RemoteCache(endpoint = "grpc://cache:8980", bytestream_uri_prefix = "cache:8980/main")
_BES = BuildEvents(backend = "grpc://bes:1985", results_url = "https://ui/i/")

def _test_tuning_groups(_ctx):
    groups = _by_name(tuning_groups("/tmp/x/exec.log.zstd"))
    _eq("names", sorted(groups.keys()), sorted([GROUP_COMMON, GROUP_CACHE, GROUP_BES]))

    # Each group is exactly its catalog share; the BES group carries the
    # diagnostics upload with the given log path.
    _eq("common", groups[GROUP_COMMON].flags, independent_flags())
    _eq("cache", groups[GROUP_CACHE].flags, endpoint_flags(cache = True, bes = False))
    _eq("bes", groups[GROUP_BES].flags, endpoint_flags(cache = False, bes = True) + diagnostics_upload_flags("/tmp/x/exec.log.zstd"))
    _eq("exec log placed", ("--execution_log_compact_file=/tmp/x/exec.log.zstd", ">=7.1.0") in groups[GROUP_BES].flags, True)
    for g in groups.values():
        _eq(g.name + " commented", bool(g.comment), True)
        _eq(g.name + " no endpoint", any([f.startswith("--remote_cache") or f.startswith("--bes_backend") for f in _texts(g.flags)]), False)

def _test_host_group(_ctx):
    # Named for the detected host; exists only where the host needs something.
    gha = host_group(WorkflowsEnvironment(ci = CI(host = "github")), misdetects_color = True)
    _eq("github actions", [(g.name, g.flags) for g in gha], [("aspect-github-actions", ["--color=yes"])])
    _eq("gitlab", [g.name for g in host_group(WorkflowsEnvironment(ci = CI(host = "gitlab")), True)], ["aspect-gitlab"])
    _eq("buildkite needs nothing", host_group(WorkflowsEnvironment(ci = CI(host = "buildkite")), misdetects_color = False), [])
    _eq("no host", host_group(WorkflowsEnvironment(), misdetects_color = True), [])
    _eq("unknown host", host_group(WorkflowsEnvironment(ci = CI(host = "unknown")), misdetects_color = True), [])
    _eq("every detected host has a name", sorted(HOST_GROUPS.keys()), ["buildkite", "circleci", "github", "gitlab"])

def _test_runner_groups_off_runner(_ctx):
    # Endpoint variables set by hand, no runner marker: one group per endpoint,
    # each chaining its tuning group first; nothing tied to a runner's mounts.
    groups = _by_name(runner_groups(WorkflowsEnvironment(remote_cache = _CACHE, build_events = _BES), on_runner = False))
    _eq("names", sorted(groups.keys()), [GROUP_RUNNER_BES, GROUP_RUNNER_CACHE])
    _eq("cache group", groups[GROUP_RUNNER_CACHE].flags, [
        "--config=" + GROUP_CACHE,
        "--remote_cache=grpc://cache:8980",
        "--remote_bytestream_uri_prefix=cache:8980/main",
    ])
    _eq("bes group", groups[GROUP_RUNNER_BES].flags, [
        "--config=" + GROUP_BES,
        "--bes_backend=grpc://bes:1985",
        "--bes_results_url=https://ui/i/",
    ])
    _eq("nothing named → nothing", runner_groups(WorkflowsEnvironment(), on_runner = False), [])

def _test_runner_groups_on_runner(_ctx):
    env = WorkflowsEnvironment(runner = _RUNNER, remote_cache = _CACHE, build_events = _BES, remote_executor = RemoteExecutor(endpoint = "grpc://exec:8980"))
    groups = runner_groups(env, on_runner = True)
    _eq("order", [g.name for g in groups], [GROUP_RUNNER_STORAGE, GROUP_RUNNER_CACHE, GROUP_RUNNER_BES, GROUP_RUNNER_EXEC, GROUP_EXEC])
    by = _by_name(groups)

    # Storage is the repository cache alone; the server paths are startup lines.
    _eq("storage", by[GROUP_RUNNER_STORAGE].flags, ["--repository_cache=/mnt/r"])

    # With the marker the cache group adds the Workflows cache's specifics …
    cache = by[GROUP_RUNNER_CACHE].flags
    _eq("chains cache tuning first", cache[0], "--config=" + GROUP_CACHE)
    for want in ["--remote_cache=grpc://cache:8980", "--disk_cache="]:
        _eq("cache has " + want, want in _texts(cache), True)
    _eq("compression gated", ("--noremote_cache_compression", ">=8.0.0") in cache, True)
    _eq("no bes in cache", any(["bes" in f for f in _texts(cache)]), False)

    # … and the BES group the profile under the job tmpdir.
    bes = by[GROUP_RUNNER_BES].flags
    _eq("bes", bes, ["--config=" + GROUP_BES, "--bes_backend=grpc://bes:1985", "--bes_results_url=https://ui/i/", "--profile=/wf/command.profile.gz"])

    # The executor is its own group behind the `aspect-exec` alias; with a cache
    # already on, it carries the endpoint alone.
    _eq("exec", by[GROUP_RUNNER_EXEC].flags, ["--remote_executor=grpc://exec:8980"])
    _eq("alias", by[GROUP_EXEC].flags, ["--config=" + GROUP_RUNNER_EXEC])
    _eq("alias source is the runner's", by[GROUP_EXEC].source, by[GROUP_RUNNER_EXEC].source)

    # Marker but nothing named: only the storage group.
    _eq("bare runner", [g.name for g in runner_groups(WorkflowsEnvironment(runner = _RUNNER), on_runner = True)], [GROUP_RUNNER_STORAGE])

def _test_exec_without_cache(_ctx):
    # Without a separate cache the executor doubles as one: chain the cache tuning.
    groups = _by_name(runner_groups(WorkflowsEnvironment(remote_executor = RemoteExecutor(endpoint = "grpc://exec:8980")), on_runner = False))
    _eq("names", sorted(groups.keys()), [GROUP_EXEC, GROUP_RUNNER_EXEC])
    _eq("chains cache tuning", groups[GROUP_RUNNER_EXEC].flags, ["--config=" + GROUP_CACHE, "--remote_executor=grpc://exec:8980"])

def _test_enabled_groups(_ctx):
    def groups_for(env, on_runner, misdetects):
        return tuning_groups("/x") + host_group(env, misdetects) + runner_groups(env, on_runner)

    # A full runner on Buildkite: common and every runner group the env fills
    # in; the tuning groups are reached by chaining, the executor by name.
    full = WorkflowsEnvironment(runner = _RUNNER, remote_cache = _CACHE, build_events = _BES, remote_executor = RemoteExecutor(endpoint = "e"), ci = CI(host = "buildkite"))
    _eq("runner", enabled_groups(groups_for(full, True, False)), [GROUP_COMMON, GROUP_RUNNER_STORAGE, GROUP_RUNNER_CACHE, GROUP_RUNNER_BES])

    # GitHub Actions with nothing in the env: the common tuning and the host's color.
    gha = WorkflowsEnvironment(ci = CI(host = "github"))
    _eq("plain gha", enabled_groups(groups_for(gha, False, True)), [GROUP_COMMON, "aspect-github-actions"])

    # A cache set by hand off a runner: its endpoint group, which chains the tuning.
    cache_only = WorkflowsEnvironment(remote_cache = _CACHE)
    _eq("cache only", enabled_groups(groups_for(cache_only, False, False)), [GROUP_COMMON, GROUP_RUNNER_CACHE])

    # Nothing anywhere: just the common tuning.
    _eq("bare", enabled_groups(groups_for(WorkflowsEnvironment(), False, False)), [GROUP_COMMON])

    # Every enabled group is defined, and the opt-in ones never are enabled.
    for env, on_runner, misdetects in [(full, True, False), (gha, False, True), (cache_only, False, False)]:
        groups = groups_for(env, on_runner, misdetects)
        defined = [g.name for g in groups]
        enabled = enabled_groups(groups)
        for name in enabled:
            _eq(name + " defined", name in defined, True)
        for name in [GROUP_CACHE, GROUP_BES, GROUP_RUNNER_EXEC, GROUP_EXEC]:
            _eq(name + " never enabled", name in enabled, False)

_UNIT_TESTS = [
    _test_tuning_groups,
    _test_host_group,
    _test_runner_groups_off_runner,
    _test_runner_groups_on_runner,
    _test_exec_without_cache,
    _test_enabled_groups,
]

def _test_impl(ctx):
    for t in _UNIT_TESTS:
        t(ctx)
    print("rc_groups.axl: OK (%d tests)" % len(_UNIT_TESTS))
    return 0

rc_groups_tests = task(
    summary = "Run the rc_groups AXL unit tests.",
    kind = "test-rc-groups",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
