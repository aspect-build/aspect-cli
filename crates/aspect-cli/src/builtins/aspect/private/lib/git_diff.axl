"""`git diff` whose output doesn't depend on the user's git config.

Porcelain `git diff` honors config that rewrites its output:

  - `diff.external` replaces the patch with an external tool's output.
  - `color.diff` / `color.ui` = `always` add ANSI escapes.
  - `diff.noprefix` / `diff.mnemonicPrefix` change the `a/` / `b/` prefixes.
  - `diff.<driver>.textconv` rewrites file content before diffing.
  - `diff.relative` limits the diff to the cwd and makes paths relative to it.

Any of these breaks a caller that parses the output or treats its paths as
git-root-relative, so every `git diff` whose output is read goes through
here. `diff.relative` is overridden with `-c` because `--no-relative` needs
git 2.28; the other flags are much older.
"""

_CONFIG_OVERRIDES = ["-c", "diff.relative=false"]

_DIFF_FLAGS = [
    "--no-ext-diff",
    "--no-textconv",
    "--no-color",
    "--src-prefix=a/",
    "--dst-prefix=b/",
]

def git_diff_args(*args):
    """argv, without the leading `git`, for `git diff <args>`."""
    return _CONFIG_OVERRIDES + ["diff"] + _DIFF_FLAGS + list(args)

def run_git_diff(ctx, cwd, *args):
    """Run `git diff <args>` in `cwd` → the process output (`.status`,
    `.stdout`, `.stderr`)."""
    return ctx.std.process.command("git").args(git_diff_args(*args)) \
        .current_dir(cwd) \
        .stdout("piped").stderr("piped").spawn().wait_with_output()
