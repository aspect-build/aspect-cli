"""Shared ANSI/SGR sequences and helpers, the single source for terminal styling.

Colours are the theme's roles. The named constants (`ansi.ERROR`,
`ansi.MUTED`, …) are role names, and `style` and `code` resolve them in the
run's theme (`@std//theme.axl`, the same as `ctx.std.theme`) when they are
called, so the colour follows the theme and what is known of the background
even from a module's top level. Callers decide whether to emit colour: they
gate on the `color` of the stream they write to (`std.io.stderr.color` for
`print` and the console lines, `std.io.stdout.color` for stdout).
"""

load("@std//theme.axl", "theme")

_CSI = "\x1b["
_RESET = _CSI + "0m"

def _seq(params: str) -> str:
    """A full SGR escape from raw `params`, e.g. `seq("1;36")`. For an escape
    no role covers; prefer a role."""
    return _CSI + params + "m"

def _code(code: str, enabled: bool = True) -> str:
    """The escape `code` stands for: a role (a constant here, or a name such
    as `"tip.label"`) in the run's theme, or an escape from `seq`; "" when not
    `enabled` or the role has no styling."""
    if not enabled or not code:
        return ""
    if code.startswith("\x1b"):
        return code
    return theme.sgr(code, stream = True)

def _style(text: str, code: str, enabled: bool = True) -> str:
    """`text` in `code` (a role or an escape, as `code` takes) then reset when
    `enabled`, else bare `text`."""
    sgr = _code(code, enabled)
    return sgr + text + _RESET if sgr else text

# Around text `print()` never links (`unlinked`): APC strings, which the
# runtime's linker takes out, and a terminal ignores.
_UNLINKED_START = "\x1b_aspect:unlinked\x1b\\"
_UNLINKED_END = "\x1b_aspect:/unlinked\x1b\\"

def _unlinked(text: str) -> str:
    """`text` that `print()` never links: a path that is a word to type
    (`.aspect/config.axl` in a hint), not a place to open; URLs in it too.
    The markers are invisible and go when printed; `strip` takes them out
    of text bound anywhere else."""
    return _UNLINKED_START + text + _UNLINKED_END

def _strip(text: str) -> str:
    """`text` with ANSI CSI (`\\x1b[`…final-byte) and OSC (`\\x1b]`…BEL) escapes,
    and `unlinked`'s markers, removed. Character walk: the runtime has no
    regex module."""
    text = text.replace(_UNLINKED_START, "").replace(_UNLINKED_END, "")
    if not text or "\x1b" not in text:
        return text
    out = []
    i = 0
    n = len(text)
    for _ in range(n):
        if i >= n:
            break
        c = text[i]
        if c == "\x1b" and i + 1 < n and text[i + 1] == "[":
            # CSI: parameter/intermediate bytes then a single final byte. Any
            # non-parameter byte terminates.
            j = i + 2
            for _ in range(n - j):
                if j >= n:
                    break
                cj = text[j]
                j += 1
                if cj not in "0123456789;:":
                    break
            i = j
        elif c == "\x1b" and i + 1 < n and text[i + 1] == "]":
            # OSC: skip to BEL (0x07).
            j = i + 2
            for _ in range(n - j):
                if j >= n:
                    break
                if text[j] == "\x07":
                    j += 1
                    break
                j += 1
            i = j
        else:
            out.append(c)
            i += 1
    return "".join(out)

ansi = namespace(
    RESET = _RESET,
    ITALIC = _CSI + "3m",
    ITALIC_OFF = _CSI + "23m",
    CLEAR_LINE = _CSI + "2K",
    MOVE_UP = _CSI + "1A",
    # Roles, by name; see the module docs.
    STRONG = "strong",
    MUTED = "muted",
    SUBTLE = "subtle",
    ACCENT = "accent",
    SUCCESS = "success",
    WARNING = "warning",
    ERROR = "error",
    HEADING = "heading",
    TITLE = "title",
    HIGHLIGHT = "highlight",
    PROGRESS = "progress",
    PROMPT = "prompt",
    LINK = "link",
    LINK_QUIET = "link.quiet",
    DEBUG_LABEL = "label.debug",
    INFO_LABEL = "label.info",
    SUCCESS_LABEL = "label.success",
    WARNING_LABEL = "label.warning",
    ERROR_LABEL = "label.error",
    code = _code,
    seq = _seq,
    style = _style,
    strip = _strip,
    unlinked = _unlinked,
)
