"""Client for `deliveryd`, the delivery-state daemon Aspect Workflows runners
expose over a Unix socket. This is the default `DeliveryState.connect` on an
Aspect Workflows runner, which sets `ENDPOINT_ENV` (see `delivery_state.axl`).

The startup probe, `GET /health`, picks the API from its `Deliveryd-Api`
header (the "Runner deliveryd" section of silo's `docs/api/delivery.md`):

  - **v2**, when the header lists `2`: the delivery API contract, driven by
    `delivery_api.axl` over the socket without a credential.
  - **v1**, without the header. Deprecated: it keys state by commit, so each
    digest is `record`ed before `query` can answer for it.
  - A header that lists no version this CLI speaks is a startup error.

    dd = deliveryd.connect(ctx, delivery_state.Params(host = "gh", repo = "org/repo", prefix = ctx.task.name, commit = sha, signature = build_url))
    dd.record(label, digest)                # needed by v1; a no-op on v2
    prior = dd.query(digests)               # {label: digest} -> {label: PriorDeliveries}
    dd.deliver(label, digest, meta)         # after the run succeeded
    dd.record_failure(label, digest, meta)  # after it failed, on v2
    dd.delete(digest)                       # after it failed, on v1
"""

load("@std//time.axl", "sleep")
load("./delivery_api.axl", "delivery_api")
load("./delivery_state.axl", "delivery_state")
load("./http_headers.axl", "header_value")
load("./random.axl", "random_hex")

# Where an Aspect Workflows runner publishes the daemon's Unix socket.
ENDPOINT_ENV = "ASPECT_WORKFLOWS_DELIVERY_API_ENDPOINT"

# The daemon's `record` + commit-keyed `query` + `deliver` + `artifact/delete` API.
API_VERSION = 1

# The delivery API contract over the socket, when `_API_HEADER` on `/health`
# lists it. Not `DeliveryD-Version`: CLIs 2026.37–2026.41 read that header and
# speak an unreleased dialect when it is 2 or more.
_API_V2 = 2
_API_HEADER = "Deliveryd-Api"

_V1_DEPRECATION = (
    "The runner's deliveryd ({}) serves only deliveryd API v1, which is deprecated " +
    "and will be removed from the Aspect CLI. Upgrade Aspect Workflows so the " +
    "runner's deliveryd serves API v2. (`DeliveryState.connect = delivery_api.connect` " +
    "also works, but needs an Aspect Cloud credential, ASPECT_API_TOKEN, in the job.)"
)

_JSON_HEADERS = {"Content-Type": "application/json"}

# The startup probe is the daemon's first request on a fresh runner, and its
# Redis client dials lazily with a 2s timeout. One failed dial must not fail the
# delivery, so a 503 (backing store unreachable) or a transport error is
# re-probed a few times. Any other status is a real answer and is not retried.
_PROBE_ATTEMPTS = 3
_PROBE_RETRY_MS = 1000

_Conn = record(
    http = field(typing.Any),
    base_url = field(str),
    socket = field(str | None),
    endpoint = field(str),
)

# `status = 0` means the request never completed (DNS, a missing socket, a
# refused connection); `body` then holds the transport error.
_Response = record(
    status = field(int),
    body = field(str),
    headers = field(list, default = []),
)

# Everything a delivery run holds constant: the connection, the state key
# (`host`/`prefix`/`commit`) and the signature stored alongside a delivery.
_Client = record(
    conn = field(_Conn),
    host = field(str),
    prefix = field(str),
    commit = field(str),
    signature = field(str),
)

Health = delivery_state.Health

def _parse_endpoint(endpoint: str) -> tuple:
    """`(base_url, socket_path)` for `unix:///path`, `http://host:port` or
    `https://host:port`. `socket_path` is None for the plain-HTTP forms."""
    if endpoint.startswith("unix://"):
        return ("http://localhost", endpoint[len("unix://"):])
    if endpoint.startswith("http://") or endpoint.startswith("https://"):
        return (endpoint, None)
    fail("Invalid deliveryd endpoint '{}': must start with unix://, http://, or https://".format(endpoint))

def _send(conn: _Conn, method: str, path: str, payload) -> _Response:
    """One request, with transport errors flattened into `status = 0` rather
    than raised — every caller wants to name the operation in the message."""
    url = conn.base_url + path
    if method == "GET":
        fut = conn.http.get(url = url, headers = _JSON_HEADERS, unix_socket = conn.socket)
    else:
        fut = conn.http.post(url = url, headers = _JSON_HEADERS, data = json.encode(payload), unix_socket = conn.socket)

    err, res = fut.catch().block()
    if err:
        return _Response(status = 0, body = err.message)
    return _Response(status = res.status, body = res.body, headers = res.headers or [])

def _ok(res: _Response) -> bool:
    return res.status >= 200 and res.status < 300

def _check(conn: _Conn, op: str, res: _Response):
    if _ok(res):
        return
    reason = "transport error: " + res.body if res.status == 0 else "HTTP {}: {}".format(res.status, res.body.strip())
    fail("deliveryd {} failed ({}): {}".format(op, conn.endpoint, reason))

def _decode(conn: _Conn, op: str, res: _Response) -> dict:
    """Decode a 2xx JSON body. The daemon multiplexes state across concurrent
    deliveries, so a truncated body is rare but must not die as a type error."""
    data = json.try_decode(res.body, None)
    if data == None:
        fail("deliveryd {} returned 2xx but body was not valid JSON: {}".format(op, res.body[:200].replace("\n", " ")))
    return data

def _retryable(res: _Response) -> bool:
    return res.status == 0 or res.status == 503

def _probe(conn: _Conn, attempts: int, pause) -> _Response:
    """`GET /health`, re-probing a retryable failure up to `attempts` times with
    `pause(ms)` between tries. Returns the last probe's result."""
    res = _send(conn, "GET", "/health", None)
    for _ in range(attempts - 1):
        if not _retryable(res):
            break
        pause(_PROBE_RETRY_MS)
        res = _send(conn, "GET", "/health", None)
    return res

def _advertised_versions(res: _Response) -> list[int]:
    """The versions a `/health` answer lists in `_API_HEADER`, comma-separated;
    empty without the header."""
    listed = [v.strip() for v in header_value(res.headers, _API_HEADER).split(",")]
    return [int(v) for v in listed if v.isdigit()]

def _to_health(res: _Response) -> Health:
    if res.status == 0:
        return Health(ok = False, version = API_VERSION, error = res.body)
    return Health(
        ok = _ok(res),
        version = API_VERSION,
        status = "ok" if _ok(res) else "",
        error = "" if _ok(res) else "HTTP {}: {}".format(res.status, res.body.strip()),
    )

def _do_health(c: _Client) -> Health:
    return _to_health(_send(c.conn, "GET", "/health", None))

def _do_record(c: _Client, label: str, digest: str) -> None:
    """Register `(label, digest)` under the commit so `query` and `deliver` can
    find it."""
    res = _send(c.conn, "POST", "/record", {
        "ci_host": c.host,
        "commit_sha": c.commit,
        "workspace": c.prefix,
        "label": label,
        "output_sha": digest,
    })
    _check(c.conn, "record", res)

def _do_query(c: _Client, digests: dict) -> dict:
    """Which of `{label: digest}` are already delivered → `{label:
    PriorDeliveries}` with `digest_delivery` alone: the daemon tracks no
    target's latest delivery, and stores only the signature (the build URL
    that delivered it), so each delivery carries `build_url` and `digest`; not
    `label`, since a shared digest's signature may be another target's. It
    answers for the whole commit, keyed by label, and only for targets a prior
    `record` registered; the answer is narrowed to the asked-about labels."""
    res = _send(c.conn, "POST", "/query", {
        "ci_host": c.host,
        "commit_sha": c.commit,
        "workspace": c.prefix,
    })
    _check(c.conn, "query", res)
    delivered = {}
    for target in _decode(c.conn, "query", res).get("targets", []) or []:
        label = target.get("label", "")
        if label in digests and target.get("delivered"):
            delivered[label] = delivery_state.PriorDeliveries(digest_delivery = delivery_state.Delivery(
                build_url = delivery_state.known_or_none(target.get("delivered_by")),
                digest = digests[label],
            ))
    return delivered

def _do_deliver(c: _Client, label: str, digest: str, meta: dict = {}) -> None:
    """Record that `label`'s delivery run succeeded. The daemon stores only the
    signature, so `meta` has nowhere to go and is dropped."""
    res = _send(c.conn, "POST", "/deliver", {
        "ci_host": c.host,
        "output_sha": digest,
        "workspace": c.prefix,
        "signature": c.signature,
    })
    _check(c.conn, "deliver", res)

def _do_delete(c: _Client, digest: str) -> None:
    """Drop a digest's state after a failed delivery, so the next run retries it
    instead of reading the failure as "already delivered"."""
    res = _send(c.conn, "POST", "/artifact/delete", {
        "ci_host": c.host,
        "output_sha": digest,
        "workspace": c.prefix,
    })
    _check(c.conn, "delete", res)

def _unusable(endpoint: str, describe: str, message: str) -> delivery_state.Backend:
    """A backend whose `.status` reports `message` as a startup error."""

    def unavailable(*args, **kwargs):
        fail("deliveryd is unavailable: " + message)

    status = Health(ok = False, version = API_VERSION, error = message)
    return delivery_state.Backend(
        endpoint = endpoint,
        describe = describe,
        status = status,
        health = lambda: status,
        record = unavailable,
        query = unavailable,
        deliver = unavailable,
        delete = unavailable,
    )

def _unconfigured() -> delivery_state.Backend:
    """The backend for a runner without a daemon."""
    return _unusable("", "deliveryd", "{} is not set. The delivery state backend must be running.".format(ENDPOINT_ENV))

def _new(ctx, host: str, prefix: str, commit: str = "", signature: str = "", endpoint: str = "", probe_attempts: int = _PROBE_ATTEMPTS, pause = sleep, repo: str = "", new_id: typing.Callable[[], str] | None = None) -> delivery_state.Backend:
    """Connect to deliveryd at `endpoint` (default `ENDPOINT_ENV`) and probe it.

    `host`, `repo` (`owner/name`, "" when unknown) and `prefix` scope the
    state; v1 also keys it by `commit`. `commit` and `signature` (the build
    URL) are stored with each delivery. A failed probe is a startup error in
    `.status`; a 503 or transport error is re-probed up to `probe_attempts`
    times. `pause` sleeps between tries and between v2's retries; `new_id`
    mints v2 event ids. Both are replaceable in tests.
    """
    endpoint = endpoint or ctx.std.env.var(ENDPOINT_ENV)
    if not endpoint:
        return _unconfigured()

    (base_url, socket) = _parse_endpoint(endpoint)
    conn = _Conn(http = ctx.http(), base_url = base_url, socket = socket, endpoint = endpoint)
    res = _probe(conn, probe_attempts, pause)
    versions = _advertised_versions(res)
    if versions and _API_V2 not in versions:
        listed = ", ".join(["v{}".format(v) for v in versions])
        return _unusable(endpoint, "API " + listed, "the runner's deliveryd serves API {}, none of which this Aspect CLI speaks. Upgrade the Aspect CLI.".format(listed))
    describe = "API v{}".format(_API_V2 if versions else API_VERSION)

    if versions and _ok(res):
        return delivery_api.open(
            conn.http,
            base_url,
            None,
            delivery_state.Params(host = host, repo = repo, prefix = prefix, commit = commit, signature = signature),
            new_id or delivery_api.event_ids(random_hex(ctx)),
            pause,
            server = delivery_api.Server(endpoint = endpoint, describe = describe, version = _API_V2, socket = socket, name = "deliveryd ({})".format(endpoint)),
        )

    c = _Client(
        conn = conn,
        host = host,
        prefix = prefix,
        commit = commit,
        signature = signature,
    )
    return delivery_state.Backend(
        endpoint = endpoint,
        describe = describe,
        status = _to_health(res),
        health = lambda: _do_health(c),
        record = lambda label, digest: _do_record(c, label, digest),
        query = lambda digests: _do_query(c, digests),
        deliver = lambda label, digest, meta = {}: _do_deliver(c, label, digest, meta),
        delete = lambda digest: _do_delete(c, digest),
        deprecation = _V1_DEPRECATION.format(endpoint) if _ok(res) and not versions else "",
    )

def _connect(ctx: TaskContext, params: delivery_state.Params) -> delivery_state.Backend:
    """`DeliveryState.connect` for deliveryd at `ENDPOINT_ENV`."""
    return _new(
        ctx,
        host = params.host,
        repo = params.repo,
        prefix = params.prefix,
        commit = params.commit,
        signature = params.signature,
        pause = delivery_api.pause_with(params.heartbeat),
    )

deliveryd = namespace(
    connect = _connect,
    new = _new,
    ENDPOINT_ENV = ENDPOINT_ENV,
    API_VERSION = API_VERSION,
)

testonly_parse_endpoint = _parse_endpoint
