"""Watched-child supervision with incremental-update and restart modes."""

load("@std//time.axl", "monotonic", "sleep_iter")
load("./environment.axl", "warn")
load("./watch_result.axl", "watch_result")

def _stop_child(child) -> None:
    """Stop the child the way cancellation does: a terminate signal to its
    process group, then a kill three seconds later if it is still running,
    so a dev server gets to release its port and clean up before a restart or
    at the end of the watch."""
    child.cancellation.cancel()
    child.wait()

def _restart_outcome(result: struct) -> struct:
    if not result.success:
        return watch_result.outcome(watch_result.KEEP)
    if result.restart_required or result.outputs_changed or result.changes_unknown or result.runfiles != {}:
        return watch_result.outcome(watch_result.RESTART)
    return watch_result.outcome(watch_result.KEEP, status = "unchanged")

def _new(ctx: TaskContext, spawn, candidate_factory = None, clock = monotonic, on_fatal = None) -> struct:
    """Own a watched child and delegate build results to its update mode.

    A candidate may activate immediately after spawn or connect later. Once
    active it owns update interpretation. Optional candidates remain available
    for the child's lifetime; required candidates fail the watch if their
    connection deadline expires. Attachment, negotiation, initialization, or
    explicit fallback permanently selects process restarts, while an update
    failure retries with a fresh child.
    """
    state = {
        "child": None,
        "pending": [],
        "pending_started_at": None,
        "protocol": None,
        "protocol_disabled": False,
        # Set by build-start or update failures; acted on after a successful build.
        "deferred_restart": False,
    }

    def new_candidates():
        if state["protocol_disabled"]:
            return []
        return candidate_factory() if candidate_factory != None else []

    def close_pending():
        for candidate in state["pending"]:
            candidate.close()
        state["pending"] = []
        state["pending_started_at"] = None

    def close_protocol(description = ""):
        protocol = state["protocol"]
        if protocol != None:
            protocol.close(str(description))
            state["protocol"] = None

    def stop():
        close_protocol("watch process stopped")
        close_pending()
        child = state["child"]
        if child != None:
            _stop_child(child)
            state["child"] = None

    def restart_without_protocol(description):
        state["protocol_disabled"] = True
        close_protocol(description)
        restart()

    def fail_required_candidate(candidate, phase: str, detail) -> None:
        message = "target requires %s, but %s failed: %s" % (candidate.name, phase, detail)
        stop()
        if on_fatal != None:
            on_fatal(message)
        else:
            fail(message)

    def poll_candidates():
        pending_candidates = state["pending"]
        if not pending_candidates or state["protocol"] != None:
            return

        remaining = []
        elapsed_ms = (clock() - state["pending_started_at"]) * 1000
        for index in range(len(pending_candidates)):
            candidate = pending_candidates[index]
            connected, err = candidate.try_connect()
            if not connected:
                timeout_ms = candidate.connection_timeout_ms
                if timeout_ms != None and elapsed_ms >= timeout_ms:
                    fail_required_candidate(candidate, "connection", "timed out after %dms" % timeout_ms)
                    return
                remaining.append(candidate)
                continue

            if err != None and candidate.connection_required:
                fail_required_candidate(candidate, "negotiation", err)
                return
            for other in remaining:
                other.close()
            for other in pending_candidates[index + 1:]:
                other.close()
            state["pending"] = []
            state["pending_started_at"] = None
            if err != None:
                candidate.close()
                warn(ctx.std, "%s negotiation failed; falling back to process restarts: %s" % (candidate.name, err))
                restart_without_protocol(err)
                return

            state["protocol"] = candidate
            init_err = candidate.initialize()
            if init_err != None:
                if candidate.connection_required:
                    fail_required_candidate(candidate, "initialization", init_err)
                    return
                warn(ctx.std, "%s initialization failed; falling back to process restarts: %s" % (candidate.name, init_err))
                restart_without_protocol(init_err)
            return
        state["pending"] = remaining

    def poll():
        child = state["child"]
        if child == None:
            return None
        status = child.try_wait()
        if status != None:
            close_protocol("watch process exited")
            close_pending()
            _stop_child(child)
            state["child"] = None
            return status
        poll_candidates()
        return None

    def restart():
        stop()
        candidates = new_candidates()
        environment = {}
        stdin = None
        for candidate in candidates:
            environment.update(candidate.environment)
            candidate_stdin = getattr(candidate, "stdin", None)
            if candidate_stdin != None:
                stdin = candidate_stdin

        child = spawn(environment, stdin)
        state["child"] = child
        if child == None:
            for candidate in candidates:
                candidate.close()
            return
        state["pending"] = candidates
        state["pending_started_at"] = clock()
        for candidate in candidates:
            attach_err = candidate.attach(child)
            if attach_err != None:
                warn(ctx.std, "%s attachment failed; falling back to process restarts: %s" % (candidate.name, attach_err))
                restart_without_protocol(attach_err)
                return
        poll_candidates()

    def build_started():
        protocol = state["protocol"]
        if protocol == None:
            return
        err = protocol.build_started()
        if err != None:
            warn(ctx.std, "%s build-start notification failed; restarting after the next successful build: %s" % (protocol.name, err))
            state["deferred_restart"] = True
            close_protocol(str(err))

    def build_finished(result):
        """Apply a build result; return its user-facing status when kept."""
        if state["deferred_restart"] and result.success:
            state["deferred_restart"] = False
            restart()
            return None
        if state["child"] == None:
            if result.success:
                restart()
            return None

        protocol = state["protocol"]
        outcome = protocol.build_finished(result) if protocol != None else _restart_outcome(result)
        if outcome.action == watch_result.KEEP:
            return outcome.status
        if outcome.action == watch_result.FALLBACK:
            description = outcome.error or "protocol requested fallback"
            if protocol.connection_required:
                fail_required_candidate(protocol, "update", description)
                return None
            warn(ctx.std, "%s requested process-restart fallback: %s" % (protocol.name, description))
            restart_without_protocol(description)
            return None
        if not result.success:
            state["deferred_restart"] = True
            if outcome.error != None:
                warn(ctx.std, "%s failed; restarting after the next successful build: %s" % (protocol.name, outcome.error))
                close_protocol(str(outcome.error))
            return None
        if outcome.error != None:
            warn(ctx.std, "%s failed; restarting the process: %s" % (protocol.name, outcome.error))

        restart()
        return None

    def run(ws, on_batch, on_exit = None, on_stop = None, tick_ms = 100) -> int:
        """Poll the child and hand each settled batch from `ws` to `on_batch`
        until `ws.cancellation` is cancelled, then stop the child and return 0."""
        for _tick in sleep_iter(tick_ms):
            if ws.cancellation.cancelled:
                if on_stop != None:
                    on_stop()
                stop()
                return 0
            status = poll()
            if status != None and on_exit != None:
                on_exit(status)
            batch = ws.try_pop()
            if batch != None:
                on_batch(batch)
        return 0

    ctx.defer(stop)
    return struct(
        build_finished = build_finished,
        build_started = build_started,
        poll = poll,
        restart = restart,
        run = run,
    )

watch_supervisor = namespace(new = _new)
