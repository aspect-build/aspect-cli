"""Unit tests for lib/repo_mapping.axl."""

load("./repo_mapping.axl", "apparent_repo_name")

_LINT = ("rules_lint", "aspect_rules_lint")

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _test_apparent_repo_name(_ctx):
    _eq("new name", apparent_repo_name({"": "", "rules_lint": "rules_lint+"}, _LINT), "rules_lint")
    _eq("old name", apparent_repo_name({"aspect_rules_lint": "aspect_rules_lint+"}, _LINT), "aspect_rules_lint")
    _eq("Bazel 7 canonical name", apparent_repo_name({"aspect_rules_lint": "aspect_rules_lint~"}, _LINT), "aspect_rules_lint")
    _eq("repo_name override", apparent_repo_name({"lint": "rules_lint+"}, _LINT), "lint")
    _eq("multiple_version_override", apparent_repo_name({"rules_lint": "rules_lint+3.0.0"}, _LINT), "rules_lint")
    _eq("main repository", apparent_repo_name({"": "", "rules_lint": ""}, _LINT), "rules_lint")
    _eq(
        "earlier modules win",
        apparent_repo_name({"old": "aspect_rules_lint+", "new": "rules_lint+"}, _LINT),
        "new",
    )
    _eq(
        "a module named like a prefix is not a match",
        apparent_repo_name({"rules_lint_rust": "rules_lint_rust+", "rules_go": "rules_go+"}, _LINT),
        None,
    )
    _eq("empty mapping", apparent_repo_name({}, _LINT), None)

_UNIT_TESTS = [
    _test_apparent_repo_name,
]

def _test_impl(ctx):
    for t in _UNIT_TESTS:
        t(ctx)
    print("repo_mapping.axl: OK (%d tests)" % len(_UNIT_TESTS))
    return 0

repo_mapping_tests = task(
    summary = "Run the repo mapping AXL unit tests.",
    kind = "test-repo-mapping",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
