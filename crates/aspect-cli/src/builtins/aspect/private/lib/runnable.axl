"""Label normalization, for every task that matches labels, and `--run-in`
resolution, for the tasks that run targets through `ctx.bazel.run` /
`ctx.bazel.run_all`.

`normalize_label` mirrors `normalize_label` in `crates/bazel/src/label.rs`,
which the runtime uses to match requested targets against what Bazel reports.
The two must agree on every label; both test suites run the cases in
`crates/bazel/src/label_cases.json`.
"""

_RUN_IN_NAMED_MODES = ["runfiles", "cwd", "bazel-root", "aspect-root", "git-root"]

# Shared `description=` body for `--run-in`'s task-arg definition. Tasks
# may concatenate task-specific guidance (e.g. which formatter targets
# care about cwd) onto the end. Single source of truth so the named-mode
# set, the path-resolution rules, and `resolve_run_in`'s error message
# can't drift apart.
RUN_IN_DESCRIPTION = (
    "Cwd for the spawned binary. Default (`runfiles` / empty) matches " +
    "`bazel run`: `<runfiles_dir>/<workspace>`. Named modes: `cwd` " +
    "(the user's current working directory), `bazel-root` (the dir " +
    "containing MODULE.bazel), `aspect-root` (the nearest `.aspect/` " +
    "dir), `git-root` (the nearest `.git/` dir). Paths starting with " +
    "`/` are taken as absolute; paths starting with `./` or `../` " +
    "resolve against the user's cwd."
)

def resolve_run_in(ctx, choice: str) -> str | None:
    """Resolve `--run-in=<choice>` to an absolute cwd for the spawn.

    Accepts:
      - "" or "runfiles"  → None (cwd defaults to `<runfiles_dir>/<workspace>`)
      - "cwd"             → user's current working directory
      - "bazel-root"      → workspace root (the dir containing MODULE.bazel)
      - "aspect-root"     → nearest `.aspect/` dir (usually == bazel-root)
      - "git-root"        → nearest `.git/` dir
      - "/abs/path"       → absolute path, passed through verbatim
      - "./rel" or "../rel" → resolved against the user's cwd
      - anything else     → fail() with the full list of valid choices

    Path resolution is intentionally simple (no `..` collapsing, no `~`
    expansion); the OS resolves the spawn cwd, and the shell already
    expands `~` / `$VAR` before the value reaches us.

    Callers should resolve `--run-in` BEFORE opening status surfaces so
    that a bad value fails fast without orphaning a partially-emitted
    task lifecycle.
    """
    if choice == "" or choice == "runfiles":
        return None
    if choice == "cwd":
        return ctx.std.env.current_dir()
    if choice == "bazel-root":
        return ctx.std.env.bazel_root_dir()
    if choice == "aspect-root":
        return ctx.std.env.aspect_root_dir()
    if choice == "git-root":
        path = ctx.std.env.git_root_dir()
        if not path:
            fail("--run-in=git-root: not inside a git repository.")
        return path
    if choice.startswith("/"):
        return choice
    if choice.startswith("./") or choice.startswith("../"):
        return ctx.std.env.current_dir() + "/" + choice
    fail("--run-in: expected one of %s, an absolute path, or a ./relative path; got %r" %
         (_RUN_IN_NAMED_MODES, choice))

def normalize_label(label):
    """Return the standard spelling of a Bazel label.

    That is the label as you'd write it in this workspace, with the target
    name spelled out. Two labels name the same target exactly when their
    normalized forms are equal, so tasks key targets by this form and match
    every label they see (the command line, `--query`, BES events, `bazel
    query` output) through it:

        normalize_label("//svc")                  # "//svc:svc"
        normalize_label("@//svc:svc")             # "//svc:svc"
        normalize_label("@@//svc:svc")            # "//svc:svc"
        normalize_label("@@rules_go+//go:def")    # "@rules_go//go:def"
        normalize_label("@repo")                  # "@repo//:repo"
        normalize_label(":tool")                  # "//:tool"

    Bazel has two ways to name a repository in a label. The *apparent* name is
    the short name a `MODULE.bazel` gives a dependency (`@rules_go`), and it is
    what people write. The *canonical* name is the unique name Bazel assigns
    each repository, written with `@@`, and it can carry a version or an
    extension name (`@@rules_go+`, `@@rules_python++pip+numpy`); BES events and
    `bazel query` output often use it. The normalized form uses apparent names
    for other repositories and writes the main repository as `//`, with no
    name, so `@//svc:svc` and `@@//svc:svc` both become `//svc:svc`. See
    https://bazel.build/external/overview#apparent-repo-name,
    https://bazel.build/external/overview#canonical-repo-name and
    https://bazel.build/concepts/labels.

    A canonical name maps to an apparent one by its shape, not by Bazel's
    repository mapping:
        Module repo:    `@@module+version//pkg:tgt`, `@@module~//pkg:tgt`  → `@module//pkg:tgt`
        Extension repo: `@@module++ext+repo//pkg:tgt`, `@@module~~ext~repo//pkg:tgt` → `@repo//pkg:tgt`
    so a dependency declared with a different `repo_name` comes back under its
    module name.

    A label with no `:` gets its implicit target name: the last package
    segment, or the repository name for a bare repository label.

    A relative label (`:foo`, `foo`, `pkg:foo`) is read as relative to the
    root package, the way a BUILD file there would read it: `foo` is `//:foo`.
    What a relative label means from another working directory depends on
    which directories are packages, which this function cannot see; resolve
    such a label to an absolute one before normalizing it.
    """
    if label.startswith("@") and "//" not in label:
        label += "//"

    if label.startswith("@@"):
        rest = label[2:]
        idx = rest.find("//")
        canonical_repo = rest[:idx]
        if not canonical_repo:
            label = rest[idx:]
        else:
            # `~` (Bazel 7) never appears in a version; `+` can, in semver
            # build metadata.
            sep = "~" if "~" in canonical_repo else "+"
            parts = canonical_repo.split(sep)
            apparent_repo = parts[-1] if len(parts) >= 3 else parts[0]
            label = "@" + apparent_repo + rest[idx:]

    if label.startswith("@//"):
        label = label[1:]

    if not label.startswith("//") and not label.startswith("@"):
        return "//" + label if ":" in label else "//:" + label

    if ":" not in label:
        repo, _, pkg = label.partition("//")
        name = pkg.split("/")[-1] if pkg else repo[1:]
        return label + ":" + name
    return label
