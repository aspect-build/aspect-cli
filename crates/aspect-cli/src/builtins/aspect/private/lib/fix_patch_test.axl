"""Unit tests for lib/fix_patch.axl: what an auto-fix patch may change in
the workspace, and that each patch it refuses leaves every file as it was.

The installed `patch` runs where the case needs it. A stand-in script
records what patch is asked to do, plays BSD's or GNU's part where the two
differ, or checks the environment it runs in (in a nested run, its stdin a
pipe); a stand-in copies' directory plays a disk that takes two names as
one. A few cases need what only some hosts have, and are probed for: a disk
that folds case or Unicode (and, where it doesn't, a case-only rename that
applies), permissions a root user ignores, and the `uchg` flag (set through
`sh`, so a host with no `chflags`, such as Linux, skips the case).

Run with:
  aspect dev test-fix-patch
"""

load("./fix_patch.axl", "apply_fix_patch", "testonly_ignored", "testonly_scan")

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _sh(ctx, cwd, script):
    status = ctx.std.process.command("sh").args(["-c", script]).current_dir(cwd).spawn().wait()
    if not status.success:
        fail("fixture script failed in %s:\n%s" % (cwd, script))

def _names(fs, dir):
    return sorted([e.path.rpartition("/")[2] for e in fs.read_dir(dir)])

def _stand_in(fs, dir, name, script):
    """An executable `sh` script at `dir/name`, to run in place of `patch`."""
    path = dir + "/" + name
    fs.write(path, "#!/bin/sh\n" + script)
    fs.set_permissions(path, 0o755)
    return path

def _noted(said):
    """A `say` that keeps each line's reason (what follows `was not
    applied: `, else the line) in `said`."""
    return lambda label, text: said.append(text.partition(" was not applied: ")[2] or text)

def _restore(env, values):
    """Set each variable in `values` back: to its value, or unset for None."""
    for name, value in values.items():
        if value == None:
            env.remove_var(name)
        else:
            env.set_var(name, value)

def _chflags(ctx: TaskContext, flag: str, path: str) -> bool:
    """Whether `chflags flag path` worked; false where there is no `chflags`."""
    return ctx.std.process.command("sh").args(["-c", 'chflags "$1" "$2" 2>/dev/null', "sh", flag, path]).spawn().wait().success

def _sides(text):
    files, why = testonly_scan(text)
    return [(f.old, f.new) for f in files], why

def _test_scan():
    _eq("both sides named, /dev/null not", _sides("--- a/x.txt\n+++ /dev/null\n@@ -1 +0,0 @@\n-x\n--- /dev/null\n+++ b/y.txt\n@@ -0,0 +1 @@\n+y\n"), ([("x.txt", None), (None, "y.txt")], None))
    _eq("a removed `-- x` line is no header", _sides("--- a/x.txt\n+++ b/x.txt\n@@ -1,2 +1,2 @@\n--- not/a.txt\n+++ not/b.txt\n z\n"), ([("x.txt", "x.txt")], None))
    _eq("a hunk range that isn't numbers", _sides("--- a/x\n+++ b/x\n@@ -1,y +1 @@\n")[1], "a hunk's line range isn't numbers")
    _eq("a name that isn't UTF-8", _sides("--- a/caf\ufffd\n+++ b/caf\ufffd\n@@ -1 +1 @@\n-a\n+b\n")[1], "a name that isn't UTF-8, which the copy-back can't name")
    _eq("a header with no name", _sides("--- a/x\n+++ \t\n@@ -1 +1 @@\n-a\n+b\n")[1], "a header with no name")
    _eq("a name with spaces and no tab runs to the end of the line", _sides("--- a/src/my file.txt\n+++ b/src/my file.txt\n@@ -1 +1 @@\n-a\n+b\n"), ([("src/my file.txt", "src/my file.txt")], None))

    # A name after a leading tab is read; the other header shapes BSD patch
    # takes a file name from are refused.
    _eq("a name after a leading tab", _sides("--- /dev/null\n+++ \tb/../../x\n@@ -0,0 +1 @@\n+x\n"), ([(None, "../../x")], None))
    _eq("a context diff", _sides("*** /dev/null\n--- b/x\n***************\n*** 0 ****\n--- 1 ----\n+ x\n")[1], "a context diff's `***` header, a format this doesn't apply")
    _eq("a line between the header lines", _sides("--- /dev/null\nnote\n+++ b/x\n@@ -0,0 +1 @@\n+x\n")[1], "a lone `---` line, part of no file's header pair")
    _eq("the header lines swapped", _sides("+++ b/x\n--- /dev/null\n@@ -0,0 +1 @@\n+x\n")[1], "a lone `+++` line, part of no file's header pair")
    _eq("an `Index:` line", _sides("Index: x\n--- a/x\n+++ b/x\n@@ -1 +1 @@\n-a\n+b\n")[1], "an `Index:` line, which this doesn't read")
    _eq("a hunk with no header", _sides("--- a/x\n+++ b/x\n@@ -1 +1 @@\n-a\n+b\nnote\n@@ -3 +3 @@\n-c\n+d\n")[1], "a hunk with no header of its own")

    # GNU diff -N marks a side that doesn't exist with the epoch, in any
    # time zone; any other time is a file.
    for stamp in ("1970-01-01 00:00:00.000000000 +0000", "1969-12-31 19:00:00.000000000 -0500", "1970-01-01 01:00:00 +0100"):
        _eq("the epoch, %s" % stamp, _sides("--- a/x\t2026-01-01 00:00:00.000000000 +0000\n+++ b/x\t%s\n@@ -1 +0,0 @@\n-a\n" % stamp), ([("x", None)], None))
    for stamp in ("1970-01-01 00:00:01.000000000 +0000", "1970-01-01 00:00:00.000000001 +0000", "1970-01-01 00:00:00 UTC"):
        _eq("not the epoch, %s" % stamp, _sides("--- a/x\n+++ b/x\t%s\n@@ -1 +0,0 @@\n-a\n" % stamp), ([("x", "x")], None))

def _test_ignored():
    # Apple's BSD patch 2.0-12u11 and GNU patch (its strings in src/patch.c
    # and src/util.c), `--forward --batch`, LC_ALL=C, one file's section.
    _eq("BSD: ignored", testonly_ignored("patching file 'src/a.txt'\nIgnoring previously applied (or reversed) patch.\n1 out of 1 hunks ignored--saving rejects to 'src/a.txt.rej'\n"), True)
    _eq("BSD: failed", testonly_ignored("patching file 'src/b.txt'\n1 out of 1 hunks failed--saving rejects to 'src/b.txt.rej'\n"), False)
    _eq("GNU: ignored", testonly_ignored("patching file src/a.txt\nReversed (or previously applied) patch detected!  Skipping patch.\n1 out of 1 hunk ignored -- saving rejects to file src/a.txt.rej\n"), True)
    _eq("GNU: failed", testonly_ignored("patching file src/b.txt\nHunk #1 FAILED at 1.\n1 out of 1 hunk FAILED -- saving rejects to file src/b.txt.rej\n"), False)

def _test_apply(ctx: TaskContext, root: str):
    fs = ctx.std.fs
    tree = root + "/tree"
    fs.create_dir_all(tree)
    _sh(ctx, root, """
mkdir -p tree/src/pkg
printf 'caf\\351\\n' > tree/src/latin1.txt
printf 'old\\n' > tree/src/a.txt
printf 'bye\\n' > tree/src/gone.txt
printf 'import os\\n' > tree/src/pkg/__init__.py
printf 'keep\\n' > tree/src/b.txt
printf 'user orig\\n' > tree/src/a.txt.orig
printf 'user rej\\n' > tree/src/b.txt.rej
{
  printf -- '--- a/src/latin1.txt\\n+++ b/src/latin1.txt\\n@@ -1 +1 @@\\n-caf\\351\\n+cafe\\n'
  printf -- '--- a/src/a.txt\\n+++ b/src/a.txt\\n@@ -1 +1 @@\\n-old\\n+new\\n'
  printf -- '--- a/src/gone.txt\\n+++ /dev/null\\n@@ -1 +0,0 @@\\n-bye\\n'
  printf -- '--- a/src/b.txt\\n+++ b/src/b.txt\\n@@ -1 +1 @@\\n-nope\\n+never\\n'
} > fix.patch
printf -- '--- a/src/pkg/__init__.py\\n+++ b/src/pkg/__init__.py\\n@@ -1 +0,0 @@\\n-import os\\n' > empty.patch
printf -- '--- a/src/new/made.txt\\n+++ b/src/new/made.txt\\n@@ -0,0 +1 @@\\n+made\\n' > made.patch
printf -- '--- a/src/missing.txt\\n+++ b/src/missing.txt\\n@@ -1 +1 @@\\n-was\\n+is\\n' > missing.patch
printf -- '--- a/src/a.txt\\n+++ b/src/a.txt\\n@@ -x +1 @@\\n-new\\n+bad\\n' > badrange.patch
printf 'keep\\n' > tree/src/d2.txt
printf -- '--- a/src/zz.txt\\n+++ b/src/d2.txt\\n@@ -1 +1 @@\\n-keep\\n+changed\\n' > rename.patch
printf -- '--- a/../escape.txt\\n+++ b/../escape.txt\\n@@ -0,0 +1 @@\\n+out\\n' > escape.patch
""")
    patch = root + "/fix.patch"
    for run in ("first", "again"):
        kept = apply_fix_patch(ctx, patch, cwd = tree)
        _eq("%s: a file not UTF-8 patched" % run, fs.read_to_string(tree + "/src/latin1.txt"), "cafe\n")
        _eq("%s: patched" % run, fs.read_to_string(tree + "/src/a.txt"), "new\n")
        _eq("%s: a removed file removed" % run, fs.exists(tree + "/src/gone.txt"), False)
        _eq("%s: a failed hunk leaves the file" % run, fs.read_to_string(tree + "/src/b.txt"), "keep\n")
        _eq("%s: the user's .orig untouched" % run, fs.read_to_string(tree + "/src/a.txt.orig"), "user orig\n")
        _eq("%s: the user's .rej untouched" % run, fs.read_to_string(tree + "/src/b.txt.rej"), "user rej\n")
        _eq("%s: no new .orig or .rej" % run, _names(fs, tree + "/src"), ["a.txt", "a.txt.orig", "b.txt", "b.txt.rej", "d2.txt", "latin1.txt", "pkg"])
        _eq("%s: only the failed hunk is a reject" % run, kept != None and _names(fs, kept + "/src"), ["b.txt.rej"])
        fs.remove_dir_all(kept)

    apply_fix_patch(ctx, root + "/empty.patch", cwd = tree)
    _eq("an emptied file stays, empty", fs.read_to_string(tree + "/src/pkg/__init__.py"), "")

    seen = []
    _eq("a first patch in a run applies", apply_fix_patch(ctx, root + "/made.patch", cwd = tree, seen = seen), None)
    fs.write(tree + "/src/new/made.txt", "edited\n")
    _eq("the same patch again in a run is skipped", apply_fix_patch(ctx, root + "/made.patch", cwd = tree, seen = seen), None)
    _eq("so the file keeps its edit", fs.read_to_string(tree + "/src/new/made.txt"), "edited\n")

    said = []
    _eq("a fix to a missing file", apply_fix_patch(ctx, root + "/missing.patch", cwd = tree, say = _noted(said)), None)
    _eq("is not made", fs.exists(tree + "/src/missing.txt"), False)
    _eq("and is named", [l.rpartition(" changes ")[2] for l in said], ["src/missing.txt, which isn't there: its hunks for it were not applied"])

    _eq("a patch whose headers name two files", apply_fix_patch(ctx, root + "/rename.patch", cwd = tree), None)
    _eq("patches the side that is there", fs.read_to_string(tree + "/src/d2.txt"), "changed\n")

    _eq("a hunk range that isn't numbers", apply_fix_patch(ctx, root + "/badrange.patch", cwd = tree), None)
    _eq("leaves the file", fs.read_to_string(tree + "/src/a.txt"), "new\n")

    apply_fix_patch(ctx, root + "/escape.patch", cwd = tree)
    _eq("a path outside the tree is not patched", fs.exists(root + "/escape.txt"), False)

    # A lint output's path, relative to the workspace (a remote cache's
    # bytestream file): taken there, not in the copies' directory.
    fs.create_dir_all(tree + "/bazel-out/bin")
    fs.write(tree + "/src/rel.txt", "old\n")
    fs.write(tree + "/bazel-out/bin/fix.patch", "--- a/src/rel.txt\n+++ b/src/rel.txt\n@@ -1 +1 @@\n-old\n+new\n")
    _eq("a relative patch path", apply_fix_patch(ctx, "bazel-out/bin/fix.patch", cwd = tree), None)
    _eq("is applied", fs.read_to_string(tree + "/src/rel.txt"), "new\n")
    _eq("a patch that isn't there", apply_fix_patch(ctx, "bazel-out/bin/none.patch", cwd = tree), None)
    fs.write(tree + "/bazel-out/bin/empty.patch", "")
    said = []
    _eq("an empty patch does nothing", apply_fix_patch(ctx, "bazel-out/bin/empty.patch", cwd = tree, say = _noted(said)), None)
    _eq("and says nothing", said, [])

    # A patch making a file that is there already: other bytes keep its
    # hunk as a reject, the same ones are applied indeed.
    fs.write(tree + "/src/m.txt", "mine\n")
    fs.write(root + "/create.patch", "--- /dev/null\n+++ b/src/m.txt\n@@ -0,0 +1 @@\n+made\n")
    kept = apply_fix_patch(ctx, root + "/create.patch", cwd = tree)
    _eq("a made file there with other bytes stays", fs.read_to_string(tree + "/src/m.txt"), "mine\n")
    _eq("and its hunk is a reject", kept != None and _names(fs, kept + "/src"), ["m.txt.rej"])
    _eq("the reject is its section", fs.read_to_string(kept + "/src/m.txt.rej"), "--- /dev/null\n+++ b/src/m.txt\n@@ -0,0 +1 @@\n+made\n")
    fs.remove_dir_all(kept)
    fs.write(tree + "/src/m.txt", "made\n")
    _eq("the same bytes: applied already", apply_fix_patch(ctx, root + "/create.patch", cwd = tree), None)
    fs.write(tree + "/src/m.txt", "")
    _eq("an empty file: made", (apply_fix_patch(ctx, root + "/create.patch", cwd = tree), fs.read_to_string(tree + "/src/m.txt")), (None, "made\n"))

    # Other bytes that aren't UTF-8 are other bytes still.
    _sh(ctx, root, """
printf -- '--- /dev/null\\n+++ b/src/l1.txt\\n@@ -0,0 +1 @@\\n+caf\\351\\n' > latin1-create.patch
printf 'caf\\352\\n' > tree/src/l1.txt
""")
    kept = apply_fix_patch(ctx, root + "/latin1-create.patch", cwd = tree)
    _eq("other bytes not UTF-8: a reject", kept != None and _names(fs, kept + "/src"), ["l1.txt.rej"])
    fs.remove_dir_all(kept)

    # A header name that isn't UTF-8 reads with its bytes replaced, which
    # the copy-back can't name: refused.
    _sh(ctx, root, "printf -- '--- /dev/null\\n+++ b/src/caf\\351.txt\\n@@ -0,0 +1 @@\\n+made\\n' > latin1-name.patch")
    said = []
    _eq("a name not UTF-8", apply_fix_patch(ctx, root + "/latin1-name.patch", cwd = tree, say = _noted(said)), None)
    _eq("refused as such", said, ["a name that isn't UTF-8, which the copy-back can't name"])

    # A patch patch can't read in full (exit 2): nothing of it applied, the
    # file before the bad hunk neither.
    fs.write(tree + "/src/ok.txt", "a\n")
    fs.write(root + "/malformed.patch", "--- a/src/ok.txt\n+++ b/src/ok.txt\n@@ -1 +1 @@\n-a\n+A\n--- a/src/rel.txt\n+++ b/src/rel.txt\n@@ -1,2 +1,2 @@\n-new\n+x\n-y\n+z\n")
    shim = _stand_in(fs, root, "fail-second", "case \"$*\" in *rel.txt*) exit 2;; esac\nexec patch \"$@\"\n")
    _eq("a section patch can't apply", apply_fix_patch(ctx, root + "/malformed.patch", cwd = tree, program = shim), None)
    _eq("applies nothing", fs.read_to_string(tree + "/src/ok.txt"), "a\n")
    fs.create_dir_all(tree + "/bazel-out/dir.patch")
    _eq("a patch path that is a directory", apply_fix_patch(ctx, "bazel-out/dir.patch", cwd = tree), None)

    # GNU diff -N's deletion, its new side the epoch: removed, whichever
    # patch runs (GNU removes the copy, BSD empties it).
    fs.write(tree + "/src/del.txt", "bye\n")
    fs.write(root + "/epoch.patch", "--- a/src/del.txt\t2026-01-01 00:00:00.000000000 +0000\n+++ b/src/del.txt\t1970-01-01 00:00:00.000000000 +0000\n@@ -1 +0,0 @@\n-bye\n")
    _eq("an epoch deletion", apply_fix_patch(ctx, root + "/epoch.patch", cwd = tree), None)
    _eq("removes the file", fs.exists(tree + "/src/del.txt"), False)

    # Such a patch that leaves the file holding something is a change, as
    # GNU patch keeps it: written back, not dropped.
    fs.write(tree + "/src/kept.txt", "a\nb\n")
    fs.write(root + "/epoch-change.patch", "--- a/src/kept.txt\t2026-01-01 00:00:00.000000000 +0000\n+++ b/src/kept.txt\t1970-01-01 00:00:00.000000000 +0000\n@@ -1,2 +1 @@\n-a\n b\n")
    _eq("an epoch side that keeps a line", apply_fix_patch(ctx, root + "/epoch-change.patch", cwd = tree), None)
    _eq("is written back", fs.read_to_string(tree + "/src/kept.txt"), "b\n")

    # rules_lint's patcher writes `--label` headers: a name with spaces and
    # no tab after it.
    fs.write(tree + "/src/my file.txt", "a\n")
    fs.write(root + "/label.patch", "--- a/src/my file.txt\n+++ b/src/my file.txt\n@@ -1 +1 @@\n-a\n+b\n")
    _eq("a `--label` name with spaces", apply_fix_patch(ctx, root + "/label.patch", cwd = tree), None)
    _eq("applies", fs.read_to_string(tree + "/src/my file.txt"), "b\n")

    # An I/O failure nothing below handles (a path longer than any host
    # takes) refuses the patch, and the run goes on.
    said = []
    fs.write(root + "/deep.patch", "--- /dev/null\n+++ b/src/%sf\n@@ -0,0 +1 @@\n+x\n" % ("d/" * 2100))
    _eq("a path too long", apply_fix_patch(ctx, root + "/deep.patch", cwd = tree, say = _noted(said)), None)
    _eq("refused with the system's reason", [l.startswith("File name too long") for l in said], [True])
    fs.write(root + "/next.patch", "--- a/src/kept.txt\n+++ b/src/kept.txt\n@@ -1 +1 @@\n-b\n+c\n")
    _eq("the next patch", (apply_fix_patch(ctx, root + "/next.patch", cwd = tree), fs.read_to_string(tree + "/src/kept.txt")), (None, "c\n"))

    # A patch with no file sections in it says so; an empty one doesn't.
    said = []
    fs.write(root + "/ed.patch", "1c\nnew\n.\n")
    _eq("an ed script", apply_fix_patch(ctx, root + "/ed.patch", cwd = tree, say = _noted(said)), None)
    _eq("is named", [l.endswith("holds no unified diff of a file: nothing in it was applied") for l in said], [True])

def _test_one_file_per_run(ctx: TaskContext, root: str):
    """patch is run once per file section with hunks, naming the one copy
    to change, never taking a name from the diff."""
    fs = ctx.std.fs
    tree = root + "/runs"
    fs.create_dir_all(tree + "/src")
    fs.write(tree + "/src/a.txt", "a\n")
    fs.write(tree + "/src/gone.txt", "bye\n")
    fs.write(tree + "/src/h.txt", "h\n")
    log = root + "/runs.log"
    shim = _stand_in(fs, root, "recording-patch", """n=0
for a in "$@"; do
  case "$a" in --*) ;; *) n=$((n + 1)); file="$a";; esac
done
echo "$n $file" >> '%s'
[ "$n" -eq 1 ] || exit 3
case "$file" in ./*..*) exit 3;; ./*) ;; *) exit 3;; esac
exec patch "$@"
""" % log)
    fs.write(root + "/three.patch", "--- a/src/a.txt\n+++ b/src/a.txt\n@@ -1 +1 @@\n-a\n+A\n--- /dev/null\n+++ b/src/new.txt\n@@ -0,0 +1 @@\n+n\n--- a/src/gone.txt\n+++ /dev/null\n@@ -1 +0,0 @@\n-bye\n--- a/src/missing.txt\n+++ b/src/missing.txt\n@@ -1 +1 @@\n-x\n+y\n--- a/src/h.txt\n+++ b/src/h.txt\n")
    _eq("three sections", apply_fix_patch(ctx, root + "/three.patch", cwd = tree, program = shim, say = lambda label, text: None), None)
    _eq("each run names one copy, none for a missing file or a header alone", fs.read_to_string(log).split("\n"), ["1 ./src/a.txt", "1 ./src/new.txt", "1 ./src/gone.txt", ""])
    _eq("all applied", (fs.read_to_string(tree + "/src/a.txt"), fs.read_to_string(tree + "/src/new.txt"), fs.exists(tree + "/src/gone.txt")), ("A\n", "n\n", False))

# Set in a nested run that does only `_test_environment`.
_ENVIRONMENT_ONLY = "ASPECT_TEST_FIX_PATCH_ENVIRONMENT"

def _test_environment_nested(ctx: TaskContext):
    """`_test_environment` in a nested run of this suite whose stdin is a
    pipe, so an inherited stdin would reach patch as one, whatever the
    suite's own stdin is."""
    out = ctx.std.process.command(ctx.std.env.current_exe()).args(["dev", "test-fix-patch"]) \
        .env(_ENVIRONMENT_ONLY, "1").stdin("piped").stdout("piped").stderr("piped").spawn().wait_with_output()
    said = out.stdout + out.stderr
    _eq("the environment case, nested:\n" + said, (out.status.code, "fix_patch_test.axl: environment OK" in said), (0, True))

def _test_environment(ctx: TaskContext, root: str):
    """patch runs with no terminal, `--forward --batch`, `LC_ALL=C`, and
    none of what changes its backups, file lookups or quoting, whatever the
    task's own environment says."""
    fs = ctx.std.fs
    env = ctx.std.env
    hostile = {
        "VERSION_CONTROL": "numbered",
        "PATCH_VERSION_CONTROL": "numbered",
        "SIMPLE_BACKUP_SUFFIX": ".bak",
        "PATCH_GET": "1",
        "POSIXLY_CORRECT": "1",
        "QUOTING_STYLE": "c",
        "LANGUAGE": "de",
        "LC_ALL": "de_DE.UTF-8",
    }
    before = {name: env.var(name) for name in hostile}
    ctx.defer(_restore, env, before)
    for name, value in hostile.items():
        env.set_var(name, value)
    tree = root + "/env"
    fs.create_dir_all(tree + "/src")
    fs.write(tree + "/src/a.txt", "a\n")

    # `env`, not the shell's own variables: macOS's sh sets POSIXLY_CORRECT
    # for itself without exporting it.
    shim = _stand_in(fs, root, "env-patch", """for v in VERSION_CONTROL PATCH_VERSION_CONTROL SIMPLE_BACKUP_SUFFIX PATCH_GET POSIXLY_CORRECT QUOTING_STYLE LANGUAGE; do
  if env | grep -q "^$v="; then echo "$v is set" >&2; exit 3; fi
done
[ "$LC_ALL" = C ] || { echo "LC_ALL is $LC_ALL" >&2; exit 3; }
[ -d "$TMPDIR" ] || { echo "no TMPDIR" >&2; exit 3; }
[ /dev/stdin -ef /dev/null ] || { echo "stdin isn't /dev/null" >&2; exit 3; }
case " $* " in *" --forward "*) ;; *) echo "no --forward" >&2; exit 3;; esac
case " $* " in *" --batch "*) ;; *) echo "no --batch" >&2; exit 3;; esac
exec patch "$@"
""")
    fs.write(root + "/env.patch", "--- a/src/a.txt\n+++ b/src/a.txt\n@@ -1 +1 @@\n-a\n+A\n")
    said = []
    got = apply_fix_patch(ctx, root + "/env.patch", cwd = tree, program = shim, say = _noted(said))
    _restore(env, before)
    _eq("under a hostile environment", got, None)
    _eq("nothing refused", said, [])
    _eq("applied", fs.read_to_string(tree + "/src/a.txt"), "A\n")

def _test_bsd_and_gnu(ctx: TaskContext, root: str):
    """Where BSD and GNU patch differ, each played by a stand-in: GNU
    removes a deleted file's copy, BSD empties it."""
    fs = ctx.std.fs
    tree = root + "/both"
    fs.create_dir_all(tree + "/src")
    fs.write(root + "/remove.patch", "--- a/src/gone.txt\n+++ /dev/null\n@@ -1 +0,0 @@\n-bye\n")
    for name, script in [("GNU", "eval \"last=\\${$#}\"\nrm \"$last\"\n"), ("BSD", "eval \"last=\\${$#}\"\n: > \"$last\"\n")]:
        fs.write(tree + "/src/gone.txt", "bye\n")
        shim = _stand_in(fs, root, "remove-" + name, script)
        _eq("%s: a removal applies" % name, apply_fix_patch(ctx, root + "/remove.patch", cwd = tree, program = shim), None)
        _eq("%s: the file is removed" % name, fs.exists(tree + "/src/gone.txt"), False)

def _test_escapes(ctx: TaskContext, root: str):
    """The header shapes that let BSD patch write outside the workspace,
    each riding along with a fix that would apply: refused, nothing written
    there and nothing in the tree."""
    fs = ctx.std.fs
    tree = root + "/escapes"
    away = root + "/away-escapes"
    fs.create_dir_all(tree + "/src")
    fs.create_dir_all(away)
    up = "../" * 40 + away.lstrip("/")
    first = "--- a/src/ok.txt\n+++ b/src/ok.txt\n@@ -1 +1 @@\n-a\n+A\n"
    for reason, body in [
        ("a creation named after a tab", "--- /dev/null\n+++ \tb/%s/made.txt\n@@ -0,0 +1 @@\n+pwned\n" % up),
        ("a context diff", "*** /dev/null\n--- b/%s/made.txt\n***************\n*** 0 ****\n--- 1 ----\n+ pwned\n" % up),
        ("a line between the header lines", "--- /dev/null\nnote\n+++ b/%s/made.txt\n@@ -0,0 +1 @@\n+pwned\n" % up),
        ("the header lines swapped", "+++ b/%s/made.txt\n--- /dev/null\n@@ -0,0 +1 @@\n+pwned\n" % up),
        ("an overwrite named after a tab", "--- \ta/%s/victim.txt\n+++ \tb/%s/victim.txt\n@@ -1 +1 @@\n-orig\n+pwned\n" % (up, up)),
        ("a removal named after a tab", "--- \ta/%s/doomed.txt\n+++ /dev/null\n@@ -1 +0,0 @@\n-doomed\n" % up),
    ]:
        fs.write(tree + "/src/ok.txt", "a\n")
        fs.write(away + "/victim.txt", "orig\n")
        fs.write(away + "/doomed.txt", "doomed\n")
        fs.write(root + "/escape.patch", first + body)
        _eq("refused: " + reason, apply_fix_patch(ctx, root + "/escape.patch", cwd = tree, say = lambda label, text: None), None)
        _eq("%s: nothing outside" % reason, (_names(fs, away), fs.read_to_string(away + "/victim.txt"), fs.read_to_string(away + "/doomed.txt")), (["doomed.txt", "victim.txt"], "orig\n", "doomed\n"))
        _eq("%s: the tree as it was" % reason, (_names(fs, tree + "/src"), fs.read_to_string(tree + "/src/ok.txt")), (["ok.txt"], "a\n"))

def _test_refused(ctx: TaskContext, root: str):
    """Each patch refused whole, every file as it was, the first hunk's file
    too, and nothing made outside: before anything is copied or patched,
    and once patched where patch leaves something the copy-back won't
    take."""
    fs = ctx.std.fs
    refuse = root + "/refuse"
    fs.create_dir_all(refuse + "/src/d")
    _sh(ctx, refuse, """
printf 'a\\n' > src/ok.txt
printf 'f\\n' > src/f
ln -s ../../outside.txt src/dangling.txt
ln -s ok.txt src/link.txt
mkdir real && ln -s ../real src/linked
mkdir ../away && ln -s ../../away src/away
ln src/ok.txt src/hard
ln -s f src/lf
printf 'n\\n' > "$(printf 'src/\\303\\251.txt')"
mkdir src/locked
printf 'a\\n' > 'src/my file'
""")

    # Searchable again before the tree goes, however the test ends (defers
    # run last first).
    fs.set_permissions(refuse + "/src/locked", 0o000)
    ctx.defer(fs.set_permissions, refuse + "/src/locked", 0o755)
    nfc, nfd = "src/\u00e9.txt", "src/e\u0301.txt"

    # What this disk takes as one file, probed: case and Unicode
    # normalization are the filesystem's, not the patch's.
    fs.write(refuse + "/real/Probe", "")
    one_case = fs.try_metadata(refuse + "/real/probe") != None
    fs.remove_file(refuse + "/real/Probe")
    one_nfd = fs.try_metadata(refuse + "/" + nfd) != None
    locked_err, _ = catch(fs.try_metadata, refuse + "/src/locked/x", types = [std.io.Error])
    first = "--- a/src/ok.txt\n+++ b/src/ok.txt\n@@ -1 +1 @@\n-a\n+A\n"
    make = lambda path: "--- /dev/null\n+++ b/%s\n@@ -0,0 +1 @@\n+made\n" % path
    for reason, body in [
        ("a type change: named in two headers", first + "--- a/src/f\n+++ /dev/null\n@@ -1 +0,0 @@\n-f\n" + make("src/f")),
        ("two creations of one path", first + make("src/n.txt") + make("src/n.txt")),
        ("a rename onto a made file", first + "--- a/src/f\n+++ b/src/g\n@@ -1 +1 @@\n-f\n+g\n" + make("src/f")),
        ("a path that is a directory", first + make("src/d")),
        ("a parent that is a file", first + make("src/f/z.txt")),
        ("a dangling symlink", first + make("src/dangling.txt")),
        ("a symlink to a file named beside it", first + "--- a/src/link.txt\n+++ b/src/link.txt\n@@ -1 +1 @@\n-a\n+B\n"),
        ("a symlinked parent out of the tree", first + make("src/away/z.txt")),
        ("a `.` component", first + make("src/./n.txt")),
        ("an empty component", first + make("src//n.txt")),
        ("a hard link to a file named beside it", first + "--- a/src/hard\n+++ b/src/hard\n@@ -1 +1 @@\n-a\n+H\n"),
        ("removing a symlink, not what it names", first + "--- a/src/lf\n+++ /dev/null\n@@ -1 +0,0 @@\n-f\n"),
        ("a git-quoted name", first + "--- \"a/src/f\"\n+++ \"b/src/f\"\n@@ -1 +1 @@\n-f\n+g\n"),
        ("a symlink by git's mode", first + "diff --git a/src/n b/src/n\nnew file mode 120000\n" + make("src/n")),
        ("a git mode change", first + "diff --git a/src/f b/src/f\nold mode 100644\nnew mode 100755\n--- a/src/f\n+++ b/src/f\n@@ -1 +1 @@\n-f\n+g\n"),
        ("a git rename", first + "diff --git a/src/f b/src/g\nsimilarity index 90%\nrename from src/f\nrename to src/g\n"),
        ("a name patch writes its reject to", first + make("src/ok.txt.rej")),
        ("a name patch writes its backup to", first + make("src/ok.txt.orig")),
        ("a name patch writes a numbered backup to", first + make("src/ok.txt.~1~")),
    ] + ([
        ("a case-only rename where the disk takes them as one", first + "--- a/src/f\n+++ /dev/null\n@@ -1 +0,0 @@\n-f\n" + make("src/F")),
    ] if one_case else []) + ([
        ("a normalization-only rename where the disk takes them as one", first + "--- a/%s\n+++ /dev/null\n@@ -1 +0,0 @@\n-n\n" % nfc + make(nfd)),
    ] if one_nfd else []) + ([
        ("a directory it may not look in", first + make("src/locked/x")),
    ] if locked_err != None else []):
        fs.write(refuse + "/p.patch", body)
        _eq("refused: " + reason, apply_fix_patch(ctx, refuse + "/p.patch", cwd = refuse), None)
        _eq("%s: the first file untouched" % reason, fs.read_to_string(refuse + "/src/ok.txt"), "a\n")
        _eq("%s: the rest untouched" % reason, (fs.read_to_string(refuse + "/src/f"), _names(fs, refuse + "/src"), _names(fs, refuse + "/real")), ("f\n", sorted(["away", "d", "dangling.txt", "f", "hard", "lf", "link.txt", "linked", "locked", "my file", "ok.txt", nfc.partition("/")[2]]), []))
        _eq("%s: nothing outside" % reason, (fs.exists(root + "/outside.txt"), _names(fs, root + "/away")), (False, []))

    # A patch past the read cap, its first hunk one patch would apply: the
    # rest of it a hole nobody reads.
    said = []
    fs.write(refuse + "/big.patch", first)
    _sh(ctx, refuse, "dd if=/dev/null of=big.patch bs=1 seek=67108865 2>/dev/null")
    _eq("larger than the read cap", apply_fix_patch(ctx, refuse + "/big.patch", cwd = refuse, say = _noted(said)), None)
    _eq("refused as such", said, ["it is larger than 64 MiB"])
    _eq("its first hunk not applied", fs.read_to_string(refuse + "/src/ok.txt"), "a\n")
    fs.remove_file(refuse + "/big.patch")

    fs.set_permissions(refuse + "/src/locked", 0o755)

    # Two new names the copies' directory folds into one, where this disk
    # does (the copies are on the same disk as this tree): refused once
    # patched, nothing made.
    for alias, (one, two) in [("case", ("src/new.txt", "src/New.txt")), ("normalization", ("src/\u00e9n.txt", "src/e\u0301n.txt"))]:
        if (alias == "case" and one_case) or (alias == "normalization" and one_nfd):
            fs.write(refuse + "/p.patch", make(one) + make(two))
            _eq("two new names folded into one by %s" % alias, apply_fix_patch(ctx, refuse + "/p.patch", cwd = refuse), None)
            _eq("%s: neither made" % alias, (fs.exists(refuse + "/" + one), fs.exists(refuse + "/" + two)), (False, False))

    # Where the disk tells case apart, a case-only rename is two files.
    if not one_case:
        fs.write(refuse + "/p.patch", "--- a/src/f\n+++ /dev/null\n@@ -1 +0,0 @@\n-f\n" + make("src/F"))
        _eq("a case-only rename on a case-sensitive disk", apply_fix_patch(ctx, refuse + "/p.patch", cwd = refuse), None)
        _eq("applies", (fs.exists(refuse + "/src/f"), fs.read_to_string(refuse + "/src/F")), (False, "made\n"))

    # A refused path's warning shows it escaped: a control character and
    # one past ASCII as codes, a backslash doubled.
    said = []
    labelled = lambda label, text: said.append((label, text.partition(" was not applied: ")[2]))
    fs.write(refuse + "/p.patch", make("src/\x1b[31m\u00e9\\x") + make("src/\x1b[31m\u00e9\\x"))
    _eq("an escaped path's refusal", apply_fix_patch(ctx, refuse + "/p.patch", cwd = refuse, say = labelled), None)
    _eq("its warning", said, [("WARNING", "src/\\u001b[31m\\u00e9\\\\x is named in more than one header")])
    fs.write(refuse + "/p.patch", "diff --git a/src/f b/src/g\nrename from src/f \x1b]0;title\x07 x\nrename to src/g\n")
    said.clear()
    apply_fix_patch(ctx, refuse + "/p.patch", cwd = refuse, say = labelled)
    _eq("a git header's warning names its keyword alone", [("\x1b" in t, "`rename from`" in t) for _, t in said], [(False, True)])

    # What patch leaves in the copies is checked before anything is copied
    # back: a symlink it made is refused, never followed.
    shim = _stand_in(fs, root, "symlink-patch", "[ -e src/n ] || ln -s /etc/hosts src/n\nexit 0\n")
    fs.write(refuse + "/p.patch", first + make("src/n"))
    _eq("a symlink patch made", apply_fix_patch(ctx, refuse + "/p.patch", cwd = refuse, program = shim), None)
    _eq("nothing copied back", (fs.read_to_string(refuse + "/src/ok.txt"), fs.try_metadata(refuse + "/src/n")), ("a\n", None))

    # A symlink within the workspace is followed.
    fs.write(refuse + "/real/x.py", "a\n")
    fs.write(refuse + "/p.patch", make("src/linked/z.txt") + "--- a/src/linked/x.py\n+++ b/src/linked/x.py\n@@ -1 +1 @@\n-a\n+A\n")
    _eq("through a link in the tree", apply_fix_patch(ctx, refuse + "/p.patch", cwd = refuse), None)
    _eq("applies there", (fs.read_to_string(refuse + "/real/z.txt"), fs.read_to_string(refuse + "/real/x.py")), ("made\n", "A\n"))

def _test_folded_copies(ctx: TaskContext, root: str):
    """Two files in the workspace that are one in the copies' directory (a
    case-sensitive checkout, a temp dir that folds case), played by a hard
    link there, so it runs on any disk: refused once copied, and once
    patched where patch makes them one, both files as they were."""
    fs = ctx.std.fs
    tree = root + "/fold"
    fs.create_dir_all(tree + "/src")
    fs.write(tree + "/src/one.txt", "1\n")
    fs.write(tree + "/src/two.txt", "2\n")

    def folding():
        work = fs.mkdtemp()
        fs.create_dir_all(work + "/src")
        fs.write(work + "/src/one.txt", "")
        fs.hard_link(work + "/src/one.txt", work + "/src/two.txt")
        return work

    said = []
    fs.write(root + "/fold.patch", "--- a/src/one.txt\n+++ b/src/one.txt\n@@ -1 +1 @@\n-1\n+one\n--- a/src/two.txt\n+++ b/src/two.txt\n@@ -1 +1 @@\n-2\n+two\n")
    _eq("two files one copy", apply_fix_patch(ctx, root + "/fold.patch", cwd = tree, mkdtemp = folding, say = _noted(said)), None)
    _eq("refused once copied", said, ["src/one.txt and src/two.txt are one file where the patch is applied"])
    _eq("both as they were", (fs.read_to_string(tree + "/src/one.txt"), fs.read_to_string(tree + "/src/two.txt")), ("1\n", "2\n"))

    said.clear()
    shim = _stand_in(fs, root, "folding-patch", "printf 'made\\n' > src/n1.txt\n[ -e src/n2.txt ] || ln src/n1.txt src/n2.txt\nexit 0\n")
    fs.write(root + "/fold-new.patch", "--- /dev/null\n+++ b/src/n1.txt\n@@ -0,0 +1 @@\n+made\n--- /dev/null\n+++ b/src/n2.txt\n@@ -0,0 +1 @@\n+made\n")
    _eq("two new names patch makes one", apply_fix_patch(ctx, root + "/fold-new.patch", cwd = tree, program = shim, say = _noted(said)), None)
    _eq("refused once patched", said, ["src/n1.txt and src/n2.txt are one file where the patch is applied"])
    _eq("neither made", _names(fs, tree + "/src"), ["one.txt", "two.txt"])

def _test_write_back(ctx: TaskContext, root: str):
    """Each result is renamed onto the file its path resolves to: a
    read-only file is fixed as patch fixes it, keeping its mode, a hard
    link out of the tree is broken off, a symlink in the tree stays one.
    One that can't be read refuses its patch, one that can't be written is
    named, and the run goes on."""
    fs = ctx.std.fs
    tree = root + "/back"
    fs.create_dir_all(tree + "/src/ro")
    fix = lambda path, old, new: "--- a/%s\n+++ b/%s\n@@ -1 +1 @@\n-%s\n+%s\n" % (path, path, old, new)
    _sh(ctx, root, """
printf 'r\\n' > back/src/readonly.txt && chmod 0444 back/src/readonly.txt
printf 'x\\n' > back/src/tool.sh && chmod 0755 back/src/tool.sh
printf 'h\\n' > outside-hl.txt && ln outside-hl.txt back/src/hl.txt
printf 'l\\n' > back/src/target.txt && ln -s target.txt back/src/lnk.txt
""")
    fs.write(root + "/back.patch", fix("src/readonly.txt", "r", "R") + fix("src/tool.sh", "x", "X") + fix("src/hl.txt", "h", "H") + fix("src/lnk.txt", "l", "L"))
    _eq("applies", apply_fix_patch(ctx, root + "/back.patch", cwd = tree), None)
    ro, tool = fs.metadata(tree + "/src/readonly.txt"), fs.metadata(tree + "/src/tool.sh")
    _eq("a read-only file fixed, still read-only", (fs.read_to_string(tree + "/src/readonly.txt"), ro.readonly), ("R\n", True))
    _eq("an executable fixed, still executable", (fs.read_to_string(tree + "/src/tool.sh"), tool.executable), ("X\n", True))
    _eq("a hard link out of the tree broken off", (fs.read_to_string(tree + "/src/hl.txt"), fs.read_to_string(root + "/outside-hl.txt")), ("H\n", "h\n"))
    _eq("a symlink in the tree stays one", (fs.read_to_string(tree + "/src/target.txt"), fs.try_metadata(tree + "/src/lnk.txt").is_symlink), ("L\n", True))

    # Permissions a root user ignores are probed, not assumed.
    fs.write(tree + "/src/secret.txt", "s\n")
    fs.set_permissions(tree + "/src/secret.txt", 0o000)
    ctx.defer(fs.set_permissions, tree + "/src/secret.txt", 0o644)
    unreadable, _ = catch(lambda: fs.open(tree + "/src/secret.txt").read(), types = [std.io.Error])
    fs.set_permissions(tree + "/src/ro", 0o555)
    ctx.defer(fs.set_permissions, tree + "/src/ro", 0o755)
    unwritable, _ = catch(fs.write, tree + "/src/ro/probe", "", types = [std.io.Error])
    fs.write(tree + "/src/ok.txt", "a\n")
    said = []
    if unreadable != None:
        fs.write(root + "/secret.patch", fix("src/secret.txt", "s", "S"))
        fs.write(root + "/after.patch", fix("src/ok.txt", "a", "A"))
        _eq("an unreadable file", apply_fix_patch(ctx, root + "/secret.patch", cwd = tree, say = _noted(said)), None)
        _eq("refuses its patch, its reason the system's", [l.startswith("src/secret.txt can't be read: ") and "Error(" not in l for l in said], [True])
        _eq("and the run goes on", (apply_fix_patch(ctx, root + "/after.patch", cwd = tree), fs.read_to_string(tree + "/src/ok.txt")), (None, "A\n"))
    if unwritable != None:
        said.clear()
        fs.write(root + "/ro.patch", "--- /dev/null\n+++ b/src/ro/new.txt\n@@ -0,0 +1 @@\n+n\n" + fix("src/ok.txt", "A", "B"))
        _eq("a file in a directory it can't write", apply_fix_patch(ctx, root + "/ro.patch", cwd = tree, say = lambda label, text: said.append((label, text.partition(": ")[2]))), None)
        _eq("is named", [(label, text.startswith("src/ro/new.txt was not written: ") and "Error(" not in text) for label, text in said], [("WARNING", True)])
        _eq("the rest is written", (fs.exists(tree + "/src/ro/new.txt"), fs.read_to_string(tree + "/src/ok.txt")), (False, "B\n"))
    fs.set_permissions(tree + "/src/ro", 0o755)

    # The `uchg` flag: the copy is made without it, so patch changes it and
    # it goes with the rest; the file it stands for can't be replaced, and
    # is named. Set through `sh`, so a host with no `chflags` skips it.
    fs.write(tree + "/src/locked.txt", "u\n")
    if _chflags(ctx, "uchg", tree + "/src/locked.txt"):
        ctx.defer(_chflags, ctx, "nouchg", tree + "/src/locked.txt")
        copies = []

        def kept_copies():
            work = fs.mkdtemp()
            copies.append(work)
            return work

        said.clear()
        fs.write(root + "/locked.patch", fix("src/locked.txt", "u", "U"))
        _eq("a locked file", apply_fix_patch(ctx, root + "/locked.patch", cwd = tree, mkdtemp = kept_copies, say = lambda label, text: said.append((label, text.partition(": ")[2].partition(": ")[0]))), None)
        _eq("is named", said, [("WARNING", "src/locked.txt was not written")])
        _eq("and left as it was", fs.read_to_string(tree + "/src/locked.txt"), "u\n")
        err, _ = catch(fs.remove_file, copies[0] + "/src/locked.txt", types = [std.io.Error])
        _eq("its copy carries no flag", err, None)

def _impl(ctx: TaskContext) -> int:
    fs = ctx.std.fs
    root = fs.mkdtemp()
    ctx.defer(fs.remove_dir_all, root)
    if ctx.std.env.var(_ENVIRONMENT_ONLY) != None:
        _test_environment(ctx, root)
        print("fix_patch_test.axl: environment OK")
        return 0
    _test_scan()
    _test_ignored()
    _test_apply(ctx, root)
    _test_one_file_per_run(ctx, root)
    _test_environment_nested(ctx)
    _test_bsd_and_gnu(ctx, root)
    _test_escapes(ctx, root)
    _test_refused(ctx, root)
    _test_folded_copies(ctx, root)
    _test_write_back(ctx, root)
    print("fix_patch_test.axl: OK")
    return 0

fix_patch_tests = task(
    summary = "Run the lint auto-fix patch (lib/fix_patch.axl) unit tests.",
    kind = "test-fix-patch",
    group = ["dev"],
    implementation = _impl,
    args = {},
)
