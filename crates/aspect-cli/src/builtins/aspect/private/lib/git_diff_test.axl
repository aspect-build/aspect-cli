"""Tests for `lib/git_diff.axl`.

Builds a scratch repo whose local config rewrites porcelain `git diff`
output (`diff.external`, `color.diff`, `diff.noprefix`,
`diff.mnemonicPrefix`, textconv, `diff.relative`) and checks that
`git_diff_args` still yields a plain unified patch and git-root-relative
`--name-only` paths from a subdirectory — the shapes the format task
string-compares, archives, and rebases.

Run with:
  aspect dev test-git-diff
"""

load("./git_diff.axl", "git_diff_args")

_GIT_ENV = {
    "GIT_AUTHOR_NAME": "Test",
    "GIT_AUTHOR_EMAIL": "test@example.com",
    "GIT_COMMITTER_NAME": "Test",
    "GIT_COMMITTER_EMAIL": "test@example.com",
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_SYSTEM": "/dev/null",
}

def _git(ctx, cwd, args):
    cmd = ctx.std.process.command("git").args(args).current_dir(cwd)
    for k, v in _GIT_ENV.items():
        cmd = cmd.env(k, v)
    out = cmd.stdout("piped").stderr("piped").spawn().wait_with_output()
    if not out.status.success:
        fail("git %s failed in %s: %s" % (" ".join(args), cwd, out.stderr.strip()))
    return out.stdout

def _hostile_repo(ctx):
    """Repo with one committed file per directory, both modified in the
    working tree, and config that rewrites every aspect of `git diff`."""
    repo = ctx.std.fs.mkdtemp(prefix = "axl-git-diff-test-")
    _git(ctx, repo, ["init", "-q", "--initial-branch=main"])
    ctx.std.fs.create_dir_all(repo + "/sub")
    ctx.std.fs.write(repo + "/top.txt", "x\n")
    ctx.std.fs.write(repo + "/sub/f.txt", "a\n")
    _git(ctx, repo, ["add", "."])
    _git(ctx, repo, ["commit", "-q", "-m", "init"])
    ctx.std.fs.write(repo + "/top.txt", "x\ny\n")
    ctx.std.fs.write(repo + "/sub/f.txt", "a\nb\n")
    for key, value in [
        ("diff.external", "true"),
        ("color.diff", "always"),
        ("color.ui", "always"),
        ("diff.noprefix", "true"),
        ("diff.mnemonicPrefix", "true"),
        ("diff.relative", "true"),
        ("diff.upper.textconv", "true"),
    ]:
        _git(ctx, repo, ["config", key, value])
    ctx.std.fs.write(repo + "/.git/info/attributes", "*.txt diff=upper\n")
    return repo

def _test_patch(ctx):
    repo = _hostile_repo(ctx)
    out = _git(ctx, repo + "/sub", git_diff_args("HEAD"))
    for want in ["--- a/sub/f.txt\n", "+++ b/sub/f.txt\n", "\n+b\n", "--- a/top.txt\n", "+++ b/top.txt\n", "\n+y\n"]:
        if want not in out:
            fail("patch — missing %r in:\n%s" % (want, out))
    if "\x1b" in out:
        fail("patch — contains ANSI escapes:\n%r" % out)
    ctx.std.fs.remove_dir_all(repo)

def _test_name_only(ctx):
    repo = _hostile_repo(ctx)
    out = _git(ctx, repo + "/sub", git_diff_args("--name-only", "HEAD"))
    got = sorted([f for f in out.strip().split("\n") if f])
    if got != ["sub/f.txt", "top.txt"]:
        fail("name-only — got %r, want git-root-relative [sub/f.txt, top.txt]" % got)
    ctx.std.fs.remove_dir_all(repo)

_TESTS = [
    _test_patch,
    _test_name_only,
]

def _test_impl(ctx):
    for t in _TESTS:
        t(ctx)
    print("git_diff.axl: OK (%d tests)" % len(_TESTS))
    return 0

git_diff_tests = task(
    summary = "Run the git_diff AXL unit tests.",
    kind = "test-git-diff",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
