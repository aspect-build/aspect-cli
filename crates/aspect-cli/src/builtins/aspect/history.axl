"""`aspect history`: the tasks run on this machine, from the task history's
records (`ctx.std.history`), newest first.

    aspect history list [--kind=build] [--outcome=failed] [--branch=main] [--limit=20] [--output=json]
    aspect history show <task-id> [--output=json]
    aspect history browse

`list` gives a run a line: the start of its task ID (enough for `show`),
when it started (UTC), how it ended (`ok`, `exit
<n>`, `error`, `cancelled`, `running`, or `abandoned` for one whose process
is gone without writing its end), how long it took, the task, and its
command line, redacted. `show` gives one run whole: its command line, where
it ran (the directory, and the git branch and commit), each Bazel
invocation with its counts and its failures, each with the logs the history
kept for it, and the folder holding the run's files, or when a prune
removed them. `--output=json` prints the records as `task.json` has them,
redacted, for a script.

`browse` is the Dashboard's History screen on a full screen of its own
(`feature/dashboard.axl`): the runs that started Bazel, in this workspace
when run inside one (`f` and `w` widen it), where Enter opens a run as the
dashboard showed it, read back from the build events and output the
history kept. Ctrl+C leaves it with exit code 130.

`aspect history`'s own runs are not kept in the history.
"""

load("@aspect//feature/dashboard.axl", "new_browser", "new_run", "new_ui", "on_key", "open_history", "page_of", "refusal", "render", "use_context", "workspace_of")
load("./private/lib/history_records.axl", "list_lines", "show_lines")

def _list_impl(ctx: TaskContext) -> int:
    records = [
        r
        for r in ctx.std.history.list(
            limit = ctx.args.limit + 1,
            kind = ctx.args.kind or None,
            outcome = None if ctx.args.outcome == "all" else ctx.args.outcome,
            branch = ctx.args.branch or None,
        )
        if r.get("task", {}).get("id") != ctx.task.id
    ][:ctx.args.limit]
    out = ctx.std.io.stdout
    if ctx.args.output == "json":
        out.write(json.encode(records, indent = 2) + "\n")
        return 0
    if not records:
        out.write("No runs in the history at %s.\n" % ctx.std.history.root())
        return 0
    for line in list_lines(records):
        out.write(line + "\n")
    return 0

def _show_impl(ctx: TaskContext) -> int:
    id = ctx.args.id[0]
    record = ctx.std.history.get(id)
    if record == None:
        print("error: no run %s in the history at %s." % (id, ctx.std.history.root()))
        return 1
    out = ctx.std.io.stdout
    if ctx.args.output == "json":
        out.write(json.encode(record, indent = 2) + "\n")
        return 0
    for line in show_lines(record):
        out.write(line + "\n")
    return 0

def _browse_impl(ctx: TaskContext) -> int:
    # As the dashboard refuses a terminal (CI, a coding agent, a dumb or
    # tiny one), with stdin a terminal too, for the keys.
    if refusal(ctx.std) != "" or not ctx.std.io.stdin.is_tty:
        ctx.std.io.stderr.write("error: aspect history browse needs a terminal; `aspect history list` prints the runs.\n")
        return 1
    screen = ctx.std.term.take()
    screen.interrupts(False)
    state = new_ui()
    state.update(new_run(task = "history browse"))
    state["screen"] = screen
    screen.wheel_keys(True)
    screen.mouse(True)
    use_context(state, ctx)
    state["browser"] = new_browser(ctx.std.history, exclude = ctx.task.id, standalone = True, workspace = workspace_of(ctx.std))
    open_history(state)
    code = 0
    drawn = None
    for _ in range(1 << 30):
        if ctx.cancellation.root.cancelled:
            # Asked to stop (SIGINT, SIGTERM, SIGHUP): the shell's code for it.
            code = ctx.cancellation.exit_code or 130
            break
        if not screen.held:
            break
        cols, rows = screen.size()
        frame = render(state, cols, rows)
        if frame != drawn or state.get("drawn") == None:
            screen.write(frame)
            drawn = frame
            state["drawn"] = frame
        key = screen.key(timeout_ms = 250)
        if key == "ctrl-c":
            code = 130
            break
        if key != None and on_key(state, key, page_of(state, cols, rows)):
            break
    screen.release()
    return code

_OUTPUT = args.string(
    default = "text",
    values = ["text", "json"],
    description = "`text` for people, or `json`: the records as task.json has them, redacted.",
)

history_list = task(
    kind = "list",
    group = ["history"],
    summary = "List the tasks run on this machine, newest first.",
    description = "List the task runs the history keeps, newest first: when each started (UTC), how it ended, how long it took, the task and its command line, redacted. Runs whose files a prune removed are still listed, from the record kept of them.",
    keep_history = False,
    implementation = _list_impl,
    args = {
        "kind": args.string(default = "", description = "Only runs of this task kind (`build`, `test`)."),
        "outcome": args.string(
            default = "all",
            values = ["all", "ok", "failed", "error", "cancelled", "running", "abandoned"],
            description = "Only runs that ended so (`all` by default): `ok`, `failed` (a non-zero exit), `error`, `cancelled`, `running`, or `abandoned` (its process gone without writing its end).",
        ),
        "branch": args.string(default = "", description = "Only runs on this git branch."),
        "limit": args.uint(default = 20, description = "The most runs listed."),
        "output": _OUTPUT,
    },
)

history_show = task(
    kind = "show",
    group = ["history"],
    summary = "Show one task run from the history: its command, builds, failures and logs.",
    description = "Show one task run the history keeps, by its task ID or the start of one (as `aspect history list` shows it): its command line, redacted, where it ran, each Bazel invocation with its counts and failures, the logs kept for each failure, and where the run's files are.",
    keep_history = False,
    implementation = _show_impl,
    args = {
        "id": args.positional(minimum = 1, maximum = 1, description = "The run's task ID, or enough of its start to name only it."),
        "output": _OUTPUT,
    },
)

history_browse = task(
    kind = "browse",
    group = ["history"],
    summary = "Browse the tasks run on this machine in a full-screen view, and open one as the dashboard showed it.",
    description = "Browse the runs the task history keeps, newest first, and open one as the dashboard showed it. Needs a terminal; `aspect history list` prints the runs.",
    keep_history = False,
    implementation = _browse_impl,
)
