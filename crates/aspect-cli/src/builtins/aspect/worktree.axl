def _shown(text: str) -> str:
    """`text` as a terminal is given it: whatever would act on it or hide in
    it escaped (`printable`), line breaks and tabs kept. Branch names, file
    names, registry fields and hook errors all come from outside, and any of
    them can carry an escape sequence or a bidirectional override; escaping
    each where it is built would miss one. JSON values go out raw, escaped by
    its encoder, except a refusal's `message`, which agents echo to a person."""
    return printable(text, keep = "\n\t")

def _print(line: str = "") -> None:
    """`print`, through `_shown`."""
    print(_shown(line))

def _info(std, message: str) -> None:
    """`info`, through `_shown`."""
    _info_shown(std, _shown(message))

def _info_shown(std, shown: str) -> None:
    """An `INFO:` line whose text is already escaped, and may be styled.

    Not `environment.info`, whose prefix follows stdout and ignores `NO_COLOR`:
    this report is written to stderr, and styled as `_color` says."""
    print(_styled(std, "INFO", ansi.seq("1;36")) + ": " + shown)

def _warn(std, message: str) -> None:
    """A `WARNING:` line, through `_shown`, its prefix styled as `_info_shown`'s."""
    print(_styled(std, "WARNING", ansi.seq("0;33")) + ": " + _shown(message))

def _color(std) -> bool:
    """Whether the text report may be styled. It is written to stderr, so that
    is the stream asked — stdout carries `--output=json` and `path` — and never
    under `NO_COLOR`."""
    return std.io.stderr.is_tty and not std.env.var("NO_COLOR")

def _styled(std, text: str, code: str) -> str:
    """`text` escaped as `_print` escapes it, then styled with `code` when
    `std` is given and color is on. Escaped first: `printable` would show the
    style's own escape as text, so a line built from these pieces is printed
    with plain `print`, never `_print`. An empty `code` or `text` leaves it
    plain."""
    shown = _shown(text)
    return ansi.style(shown, code, True) if code and shown and std != None and _color(std) else shown

def _print_styled(std, line: str, code: str) -> None:
    """`line` through `_styled`, printed."""
    print(_styled(std, line, code))

def _field(std, indent: str, label: str, value: str) -> str:
    """A `label: value` line of a report block, the label (with whatever
    padding aligns it) dimmed so the values read as the column that matters.
    The value is escaped line breaks and all: it is one line, and a project
    path or a registry field with a newline in it would otherwise fake more."""
    return indent + _styled(std, label, ansi.DIM) + printable(value)

def _table(std, rows: list[dict], columns: list, indent: str = "") -> list[str]:
    """`rows` rendered as `render` renders them, each line indented, the header
    dimmed. Cells are escaped (`printable`, line breaks and tabs included)
    before the columns are measured, so an escaped name does not throw its row
    out of line, nor fake one; the lines are printed with plain `print`."""
    rows = [{k: (printable(v) if type(v) == "string" else v) for k, v in r.items()} for r in rows]
    lines = render(rows, columns)
    color = std != None and _color(std)
    return [indent + ansi.style(lines[0], ansi.DIM, color)] + [indent + line for line in lines[1:]]

def _command_line(std, indent: str, command: str, comment: str = "") -> str:
    """A command to copy, plain, and the shell comment after it dimmed: the
    command is what a reader acts on."""
    return indent + _shown(command) + (_styled(std, "   # " + comment, ansi.DIM) if comment else "")

_POOL_BUSY = "another `aspect worktree` call is holding this pool's lock; try again"

# Contention is not failure: the caller's request was well-formed and will
# succeed shortly. Agents allocate in parallel and need to tell "retry in a
# moment" from "this is broken", which one exit code for both cannot express.
# 75 is sysexits.h EX_TEMPFAIL, which is what it means.
_EX_TEMPFAIL = 75

_SCHEMA_VERSION = 1

def _runnable(ctx: TaskContext, command: str) -> str:
    """`command`, with `--force` when there is nobody to confirm at.

    A refusal's whole value is the line a reader can paste, and a deletion
    refuses without a terminal — so printing the bare form to a non-interactive
    caller hands them a command that cannot work. The tty is known here, so the
    suggestion accounts for it rather than the caller discovering it.
    """
    return command if ctx.std.io.stdin.is_tty else command + " --force"

def _refuse(
        ctx: TaskContext,
        code: str,
        message: str,
        exit_code: int = 1,
        retryable: bool = False,
        facts: dict = {}) -> TaskConclusion:
    """A refusal in whichever form the caller asked for.

    Every one of these is something an agent has to branch on, and a
    `--output=json` consumer handed prose on stderr and an empty stdout would
    have to parse English to do it. `code` is the stable token to branch on.

    `facts` carries the values the refusal is *about* — a path, a list of files
    — beside the token, so a consumer does not have to recover them from the
    sentence that mentions them. The message says the same things in prose: one
    refusal, rendered for a person and for a program.
    """
    if ctx.args.output == "json":
        ctx.std.io.stdout.write(json.encode({
            "schema_version": _SCHEMA_VERSION,
            "error": code,
            "retryable": retryable,
            "message": _shown(message),
        } | facts, indent = 2) + "\n")
        return TaskConclusion(exit_code = exit_code)
    return TaskConclusion(exit_code = exit_code, message = _shown(message))

# Refs git would accept as a branch but nobody should own: `HEAD` resolves to
# whatever is checked out, so a branch by that name makes every later `rev-parse`
# ambiguous, and git itself warns rather than refusing.
_RESERVED_BRANCHES = [
    "HEAD",
    "@",
    "FETCH_HEAD",
    "ORIG_HEAD",
    "MERGE_HEAD",
    "CHERRY_PICK_HEAD",
    "REVERT_HEAD",
    "REBASE_HEAD",
    "BISECT_HEAD",
    "AUTO_MERGE",
]

# How long a `score_slot` hook may take across all the slots of one `add`, and
# the bound its score is clamped to either way, so it stays a number every JSON
# reader can hold exactly. Defined beside the trait, whose description says them.
_HOOK_BUDGET_MS = HOOK_BUDGET_MS
_HOOK_SCORE_LIMIT = HOOK_SCORE_LIMIT

# The longest one part of a branch name can be: the 255-byte file name limit
# of APFS and ext4, where git stores loose refs, less the `.lock` it writes
# beside a ref while it updates it.
_MAX_REF_COMPONENT = 250

def _utf8_len(s: str) -> int:
    """`s`'s length in UTF-8 bytes, which is what a file name limit counts."""
    n = 0
    for ch in s.elems():
        c = ord(ch)
        n += 1 if c < 0x80 else 2 if c < 0x800 else 3 if c < 0x10000 else 4
    return n

def _bad_branch_name(ctx: TaskContext, name: str, why: str) -> TaskConclusion:
    """A branch git will not create, said before git is asked.

    Asked before git so the answer is a refusal with a token: from inside
    `git worktree add` it would be an error with no `--output=json` document,
    which is the one shape an agent cannot read.
    """
    shown = '"' + name + '"'
    return _refuse(ctx, "invalid_branch", shown + " cannot be a branch name: " + why, facts = {"branch": name})

def _branch_plan(ctx: TaskContext, pool: dict, name: str, cwd: str):
    """What `add` checks out for `name`, or the refusal that says why it will not.

    As `git worktree add` does: a branch this clone has is checked out as it
    is; a branch only a remote has is checked out from there, tracking it; and
    any other name is refused rather than created, so a typo does not quietly
    become a branch. `--create` creates one, and like git's `-b` refuses a name
    that already exists — locally, or on a remote unless `--create` names that
    very remote branch, which is how one is chosen among several.

    Returns `struct(existing, base_ref, base_label)` — `base_label` being what
    a new branch starts from as the caller would recognise it — or a refusal.
    """
    create = ctx.args.create
    existing = _is_branch(ctx, pool, name)
    remotes = [] if existing else _remote_branches(ctx, pool, name)

    # A remote's name resolves, to its default branch, but is no branch name:
    # said as that, rather than as a commit to branch from.
    if not existing and "/" not in name:
        why = _new_branch_problem(ctx, pool, read_registry(ctx.std, pool["dir"]), name)
        if why:
            return _bad_branch_name(ctx, name, why)

    # A name that resolves but is no branch — a tag, a commit — is ambiguous as
    # a branch name either way.
    if not existing and _git_try(ctx, ["rev-parse", "--verify", "--quiet", name + "^{commit}"], pool["git_common_dir"]):
        return _not_a_branch(ctx, pool, name)

    if create != _CREATE_OFF:
        if existing:
            return _branch_exists(ctx, name)
        if remotes and create not in remotes:
            return _remote_branch_exists(ctx, name, remotes)
        if create == _CREATE_FROM_HEAD:
            return struct(
                existing = False,
                base_ref = _git(ctx, ["rev-parse", "HEAD"], cwd),
                base_label = _git_try(ctx, ["rev-parse", "--abbrev-ref", "HEAD"], cwd) or "HEAD",
            )

        # Resolved where the caller stands: `HEAD~1` or `@{-1}` from inside a
        # slot means that slot's history, not the main clone's. The ref keeps
        # its spelling where both agree, since `<remote>/<name>` is what makes
        # the new branch track.
        here = "" if create.startswith("-") else _git_try(ctx, ["rev-parse", "--verify", "--quiet", create + "^{commit}"], cwd)
        if not here:
            return _no_such_ref(ctx, pool, create, "--create=" + create)
        there = _git_try(ctx, ["rev-parse", "--verify", "--quiet", create + "^{commit}"], pool["git_common_dir"])
        return struct(existing = False, base_ref = create if here == there else here, base_label = create)

    if existing:
        return struct(existing = True, base_ref = name, base_label = "")

    # Only a remote has it — a teammate's, a PR's. It starts from there: created
    # from wherever the caller stands it would be unrelated history under their
    # name, aimed at theirs on first push.
    if remotes:
        remote = ("origin/" + name) if ("origin/" + name) in remotes else (remotes[0] if len(remotes) == 1 else "")
        if not remote:
            return _ambiguous_remote_branch(ctx, name, remotes)
        return struct(existing = False, base_ref = remote, base_label = remote)

    return _no_such_branch(ctx, pool, name)

def _new_branch_problem(ctx: TaskContext, pool: dict, registry: dict, name: str) -> str:
    """Why `name` must not become a new branch here, or "" — the rules git's
    own `check-ref-format` does not know: a name that is, or starts with, a
    remote's name or `refs`/`remotes`, reads as something else to every later
    command; and one equal to a slot id would answer to `path` and `release`
    in the slot's place."""
    shadowed = name.partition("/")[0]
    spelled = _git_try(ctx, ["remote"], pool["git_common_dir"]).splitlines()
    remotes = [r.lower() for r in spelled] + ["refs", "remotes"]
    for remote in spelled:
        if remote.lower() == shadowed.lower():
            shadowed = remote
    if "/" not in name and name.lower() in remotes:
        return ("it is the name of " + ("a remote" if name.lower() not in ["refs", "remotes"] else "a ref namespace") +
                ", so `" + name + "` would mean that to every later git command")
    if "/" in name and shadowed.lower() in remotes:
        if shadowed.lower() in ["refs", "remotes"]:
            return ("it starts with `" + shadowed + "/`, which git reads as a path to a ref rather than a " +
                    "branch name — so `" + name + "` would mean something else to every later command")
        return ("it starts with the name of the remote " + shadowed + ", so `" + name + "` would read as " +
                "that remote's branch — to every later command, and to the push that names it. For a branch " +
                "of that name on the remote: `aspect worktree add " + shell_quote(name.partition("/")[2]) +
                " --create=" + shell_quote(shadowed) + "/<base>" + _id_flag(ctx) + "`")
    if name.lower() in [sid.lower() for sid in registry["slots"]]:
        return "it is the id of a slot in this pool, which `path`, `release` and `prune` would then take for the branch"
    return ""

def _no_such_branch(ctx: TaskContext, pool: dict, name: str) -> TaskConclusion:
    """A name no branch has, here or on a remote, without `--create`.

    Refused rather than created, as `git worktree add` refuses it: a typo should
    not quietly become a branch. The closest branch name is offered, and so is
    the flag that creates one. Unless another `add` has meanwhile reserved the
    name to create it: then the branch is about to exist, and that is said.
    """
    early = read_registry(ctx.std, pool["dir"])
    pending = reserving_slot(early, name, pool["git_common_dir"])
    if pending and not reservation_abandoned(ctx.std, early, pending):
        return _branch_pending(ctx, pool, pending, name)

    # Never suggest a `--create` that would be refused.
    why = _new_branch_problem(ctx, pool, early, name)
    if why:
        return _bad_branch_name(ctx, name, why)
    branches = _git_try(
        ctx,
        ["for-each-ref", "--format=%(refname:short)", "refs/heads"],
        pool["git_common_dir"],
    ).splitlines()
    closest = _closest(name, branches)
    held = _leased_holding(ctx, pool, early, closest) if closest else ""
    holder = ((early["slots"][held].get("lease") or {}).get("agent") or {}) if held else {}
    verb = "path" if held and _same_session(_me(ctx), holder) else "add"
    guess = (" Did you mean " + shell_quote(closest) + "? `aspect worktree " + verb + " " + shell_quote(closest) + _id_flag(ctx) + "`.") if closest else ""
    return _refuse(
        ctx,
        "no_such_branch",
        "no branch called " + name + " here or on a remote." + guess + " If somebody else " +
        "pushed it, `git fetch` first: this clone only knows the remote branches it has fetched, " +
        "and creating one by the same name would collide with theirs. To start " + name +
        " as a new branch:\n\n" +
        "  aspect worktree add " + shell_quote(name) + " --create=" + shell_quote(_fresh_base(ctx, pool)) + _id_flag(ctx) + "  # from the remote's default branch\n" +
        "  aspect worktree add " + shell_quote(name) + " --create" + _id_flag(ctx) + "  # from " + _here_said(ctx),
        facts = {"branch": name, "closest": closest},
    )

def _here_said(ctx: TaskContext) -> str:
    """What a bare `--create` would start a branch from, for a comment beside
    the command: the branch checked out where the caller stands, or the commit
    when HEAD is detached there."""
    cwd = ctx.std.env.current_dir()
    branch = _git_try(ctx, ["symbolic-ref", "--quiet", "--short", "HEAD"], cwd)
    if branch:
        return "the current branch, " + branch
    head = _git_try(ctx, ["rev-parse", "--short", "HEAD"], cwd)
    return ("the current commit, " + head + " (detached HEAD)") if head else "the current HEAD"

def _branch_exists(ctx: TaskContext, name: str) -> TaskConclusion:
    """`--create` for a branch this clone already has, which git's `-b` refuses
    too: the existing branch is checked out by leaving the flag off."""
    return _refuse(
        ctx,
        "branch_exists",
        name + " already exists, so there is nothing to create. `aspect worktree add " + shell_quote(name) +
        "` checks it out as it is.",
        facts = {"branch": name},
    )

def _remote_branches(ctx: TaskContext, pool: dict, name: str) -> list[str]:
    """Every remote's branch named `name`, as `<remote>/<name>`."""
    return _git_try(
        ctx,
        ["for-each-ref", "--format=%(refname:short)", "refs/remotes/*/" + name],
        pool["git_common_dir"],
    ).splitlines()

def _ambiguous_remote_branch(ctx: TaskContext, name: str, remotes: list[str]) -> TaskConclusion:
    """A name several remotes have a branch of, none of them `origin`: which
    one is meant is not ours to guess."""
    return _refuse(
        ctx,
        "ambiguous_remote_branch",
        name + " exists on more than one remote (" + ", ".join(remotes) + "), and none is " +
        "`origin`. Create it from the one you mean: " +
        "`aspect worktree add " + shell_quote(name) + " --create=<remote>/" + shell_quote(name) + "`.",
        facts = {"branch": name, "remotes": remotes},
    )

def _remote_branch_exists(ctx: TaskContext, name: str, remotes: list[str]) -> TaskConclusion:
    """`--create` for a name a remote already has a branch of.

    That asks for a different branch under the same name, and the first push
    would collide with the remote's. Without `--create` the name means the
    remote branch, which is almost always what was meant.
    """
    return _refuse(
        ctx,
        "remote_branch_exists",
        name + " already exists on " + ", ".join(remotes) + ", so --create would start a " +
        "different branch under the same name, and the first push would collide with it. " +
        "`aspect worktree add " + shell_quote(name) + "` checks out the remote's; to start new work, choose " +
        "another name.",
        facts = {"branch": name, "remote_branches": remotes},
    )

def _not_a_branch(ctx: TaskContext, pool: dict, name: str) -> TaskConclusion:
    """A name that resolves — a remote branch, a tag, a commit — but is not a
    branch of this clone, or one differing from a branch only in case, which a
    case-insensitive filesystem cannot keep apart from it.

    Checking it out as-is means a detached HEAD, which `--detach` asks for in
    so many words; without it, the two things it can mean are offered: a new
    branch starting there, or a look at it on no branch.
    """
    gcd = pool["git_common_dir"]
    branches = _git_try(ctx, ["for-each-ref", "--format=%(refname:short)", "refs/heads"], gcd).splitlines()
    spelled = [b for b in branches if b.lower() == name.lower()]
    if spelled:
        return _refuse(
            ctx,
            "not_a_branch",
            name + " differs only in case from the branch " + spelled[0] + ", which this " +
            "filesystem cannot tell apart from it: `aspect worktree add " + shell_quote(spelled[0]) + _id_flag(ctx) + "`.",
            facts = {"ref": name, "kind": "branch_case", "branch": spelled[0]},
        )
    if _git_try(ctx, ["rev-parse", "--verify", "--quiet", "refs/remotes/" + name], gcd):
        kind = "remote_branch"
    elif _git_try(ctx, ["rev-parse", "--verify", "--quiet", "refs/tags/" + name], gcd):
        kind = "tag"
    else:
        kind = "commit"
    said = {"remote_branch": "a remote branch", "tag": "a tag", "commit": "a commit"}[kind]
    options = []
    bare = name.partition("/")[2]
    if kind == "remote_branch" and bare == "HEAD":
        # `<remote>/HEAD` is the remote's default branch, by way of a symref.
        bare = _git_try(ctx, ["symbolic-ref", "--quiet", "--short", "refs/remotes/" + name], gcd).partition("/")[2]
    flag = _id_flag(ctx)
    if kind == "remote_branch" and bare and not _worktree_holding_branch(ctx, pool, bare):
        # `origin/x` is usually a way of asking for x, which checks out the
        # remote's branch tracking it — or this clone's, where it has one —
        # unless x is already checked out somewhere, where `add x` is refused.
        options.append("  aspect worktree add " + shell_quote(bare) + flag + "   # the branch itself")
    options.append("  aspect worktree add <new-branch> --create=" + shell_quote(name) + flag + "   # a new branch starting there")
    options.append("  aspect worktree add " + shell_quote(name) + " --detach" + flag + "   # look at it on no branch")
    hint = ""
    create = ctx.args.create
    if create not in (_CREATE_OFF, _CREATE_FROM_HEAD) and not create.startswith("-") and not _git_try(ctx, ["rev-parse", "--verify", "--quiet", create], gcd):
        hint = ("\n\n--create takes where the branch starts, not its name — unlike git's -b: " +
                "`aspect worktree add " + shell_quote(create) + " --create=" + shell_quote(name) + flag + "`.")
    return _refuse(
        ctx,
        "not_a_branch",
        name + " is not a branch of this clone — it is " + said + ":\n\n" + "\n".join(options) + hint,
        facts = {"ref": name, "kind": kind},
    )

def _no_such_ref(ctx: TaskContext, pool: dict, ref: str, asked: str) -> TaskConclusion:
    """A ref this clone cannot resolve — `--create=<ref>`, or what `--detach`
    was to check out, as `asked` spells it — most often a typo of one it can,
    which is named, as a typo'd worktree name is."""
    refs = _git_try(
        ctx,
        ["for-each-ref", "--format=%(refname:short)", "refs/heads", "refs/remotes", "refs/tags"],
        pool["git_common_dir"],
    ).splitlines()
    closest = _closest(ref, refs)
    guess = (" Did you mean " + closest + "?") if closest else ""
    return _refuse(
        ctx,
        "no_such_ref",
        asked + " is not a ref in this clone." + guess + " Pass a branch, tag or " +
        "commit that exists here — `git fetch` first if it is a remote branch this clone has not seen.",
        facts = {"ref": ref, "closest": closest},
    )

def _pool_busy(ctx: TaskContext) -> TaskConclusion:
    """The refusal when another call holds the pool lock."""
    return _refuse(ctx, "pool_busy", _POOL_BUSY, exit_code = _EX_TEMPFAIL, retryable = True)

def _branch_pending(ctx: TaskContext, pool: dict, slot_id: str, name: str) -> TaskConclusion:
    """The refusal when another `add` is checking this branch out right now.

    Retryable, like `pool_busy` and unlike `branch_in_use`: the other call is
    seconds from finishing, and what the caller finds then — a lease it can take
    over, or its own slot — is a different answer from this one. Except under
    `--create`: the branch is about to exist and be the other call's, so a
    retry can only fail, and new work needs another name.
    """
    creating = ctx.args.create != _CREATE_OFF
    reserver = (read_registry(ctx.std, pool["dir"])["slots"].get(slot_id, {}).get("reservation") or {}).get("agent") or {}
    mine = _same_harness_session(_me(ctx), reserver)
    return _refuse(
        ctx,
        "branch_pending",
        ("an `aspect worktree add` of this session — this one run twice, or a sibling subagent — is checking " if mine else "another `aspect worktree add` is checking ") + name + " out at " +
        slot_path(pool, slot_id) + " right now; " + (
            "the branch will be that call's, so choose another name for this new work" if creating else "try again in a moment"
        ),
        exit_code = 1 if creating else _EX_TEMPFAIL,
        retryable = not creating,
        facts = {"slot": slot_id, "path": slot_path(pool, slot_id), "branch": name, "same_session": mine},
    )

def _git(ctx: TaskContext, args: list[str], cwd: str = "") -> str:
    """`git <args>` stdout. Fails the task when git does — for calls whose
    failure means the operation cannot proceed."""
    r = run_git(ctx.std, args, cwd)
    if not r.ok:
        fail(_shown("git " + " ".join(args) + " failed: " + r.err))
    return r.out

def _git_try(ctx: TaskContext, args: list[str], cwd: str = "") -> str:
    """`git_out` for callers holding a `ctx`: stdout, or "" when git exits
    non-zero — for probes where a failure is itself the answer."""
    return git_out(ctx.std, args, cwd)

# What to do about a free slot that still holds work, which the pool will not
# clear itself.
_CLEAR_BY_HAND = "Commit or copy what is needed, then remove the directory."

def _clone_of_slot(ctx: TaskContext, path: str) -> str:
    """The object store of the clone a slot belongs to, for asking git about
    it once its directory is gone: the owner its pool records, while that
    exists, else the clone this command runs in."""
    pool_dir, _, slot = path.rpartition("/" + SLOT_PREFIX)
    record = read_registry(ctx.std, pool_dir)["slots"].get(slot) or {}
    owner = record.get("owner_git_dir", "")
    if owner and ctx.std.fs.exists(owner):
        return owner
    return _pool(ctx).get("git_common_dir", "")

def _work(ctx: TaskContext, path: str, root: str = "") -> list[str]:
    """`work_in` for a slot: everything removing its checkout would lose —
    and, where the checkout's directory is gone, what git still keeps for it
    (`vanished_work`), which removing its registration would lose. So for a
    directory with no `.git` left in it."""
    if is_directory(ctx.std, path) and ctx.std.fs.exists(path + "/.git"):
        return work_in(ctx.std, path, output_base_of(ctx.std, path, root or _output_root(ctx)))
    base = output_base_of(ctx.std, path, root or _output_root(ctx)) if is_directory(ctx.std, path) else ""
    return work_in(ctx.std, path, base, _clone_of_slot(ctx, path))

def _work_said(work: list[str]) -> str:
    """What a non-empty `_work` list is, for the head of a sentence: work that
    was seen, or a checkout git cannot read, where work cannot be ruled out."""
    if work and work[0].startswith(UNREADABLE_CHECKOUT):
        return "a checkout git cannot read, so work in it cannot be ruled out"
    if work and work[0].startswith(VANISHED_CHECKOUT):
        unsure = [w for w in work if w.startswith("?? ") or "could not" in w]
        return "a checkout gone from its directory, with work git still keeps for it" + (
            ", or may" if unsure else ""
        )
    if work and "a file is at the slot's path" in work[0]:
        return "a file where its checkout should be"
    return "a checkout with uncommitted work"

def _holds_work(ctx: TaskContext, path: str, root: str = "") -> bool:
    """Whether `path` has a checkout in it with work to lose. A slot the pool
    thinks is free should hold none, and must not lose it if it does."""
    return len(_work(ctx, path, root)) > 0

def _indented(lines: list[str]) -> str:
    """`lines` one per line under a sentence, indented and capped."""
    return "\n".join(["  " + line for line in _capped(lines)])

def _dirty(ctx: TaskContext, path: str, root: str = "") -> list[str]:
    """`uncommitted_work` for a slot, with Bazel's own leavings told apart by
    the output base under `root` (resolved here when not given). With no
    directory at the path it is `work_in`'s answer: a file there, or what git
    still keeps for a checkout that is gone — as for a directory with no
    `.git` left in it."""
    if not is_directory(ctx.std, path):
        return work_in(ctx.std, path, "", _clone_of_slot(ctx, path))
    if not ctx.std.fs.exists(path + "/.git"):
        return work_in(ctx.std, path, output_base_of(ctx.std, path, root or _output_root(ctx)), _clone_of_slot(ctx, path))
    return uncommitted_work(ctx.std, path, output_base_of(ctx.std, path, root or _output_root(ctx)))

def _fresh_base(ctx: TaskContext, pool: dict) -> str:
    """What new work starts from: the remote's default branch as `origin/HEAD`
    names it, or `origin/main` where the clone has not recorded one."""
    return _git_try(
        ctx,
        ["symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"],
        pool["git_common_dir"],
    ) or "origin/main"

def _output_root(ctx: TaskContext) -> str:
    """The output user root Bazel would use here, resolved as `aspect gc` and
    `aspect output-bases` resolve it: the rc chain, else the platform default.

    Resolved once per command and handed to everything that derives a slot's
    output base. A repo with `startup --output_user_root=` in its `.bazelrc`
    keeps its bases elsewhere, and a pool looking in the platform default finds
    nothing there — every slot reads cold, and prune retires warm slots while
    leaving the real bases behind.
    """
    return output_bases.output_user_root(ctx, "")

def _pool(ctx: TaskContext) -> dict:
    """The pool for the working directory, or an empty dict outside a clone.

    Empty rather than fatal: being in the wrong directory is an ordinary
    mistake for an agent to make, and it deserves the same typed refusal as
    every other, not a traceback.
    """
    return pool_of(ctx.std, ctx.std.env.current_dir())

def _not_a_repository_for_list(ctx: TaskContext) -> TaskConclusion:
    """`list` outside a clone, which `--all` answers from anywhere.

    The refusal is right — a pool is keyed on a repository — and it names the
    one thing a reader can do instead.
    """
    return _refuse(
        ctx,
        "not_a_repository",
        "not inside a git repository, so there is no pool to list — " +
        "`aspect worktree list --all` shows every pool on this machine from anywhere",
    )

def _not_a_repository(ctx: TaskContext) -> TaskConclusion:
    return _refuse(
        ctx,
        "not_a_repository",
        "not inside a git repository — run this from a clone of the repo you want a worktree of",
    )

def _lock_pool(ctx: TaskContext, pool: dict, wait: bool = True) -> dict:
    """Hold the pool's lock for the rest of the task, or {} if another caller
    has it.

    Only the tasks that write the registry take it. The release is deferred
    rather than written out at each exit: `ctx.defer` runs even when the task
    dies on a fatal error, which is the only way to guarantee the lock is
    dropped rather than left for the next caller to reclaim.

    `wait` false tries once, for a reader that would rather answer from the
    registry as it stands than wait out a writer.

    The handle is mutable because `add` gives the lock back for its checkout and
    takes it again afterwards. The deferred release reads it at the end and so
    drops whichever lock is held — or nothing, if the task ended while unlocked.
    """
    token = acquire(ctx.std, pool["dir"]) if wait else acquire(ctx.std, pool["dir"], attempts = 1)
    if not token:
        return {}
    held = {"token": token}
    ctx.defer(lambda: release(ctx.std, pool["dir"], held["token"]))
    return held

def _unlock(ctx: TaskContext, pool: dict, held: dict) -> None:
    """Give the lock back, for work that must not be done holding it."""
    release(ctx.std, pool["dir"], held["token"])
    held["token"] = ""

def _relock(ctx: TaskContext, pool: dict, held: dict) -> bool:
    """Take the lock again. False when another caller has it."""
    held["token"] = acquire(ctx.std, pool["dir"])
    return held["token"] != ""

# What a `score_slot` hook is shown of a slot, besides `id` and `base_present`.
_HOOK_SLOT_FIELDS = ["lock_digest", "last_commit", "last_branch", "created_ms"]

def _hook_view(slot_id: str, slot: dict, base_present: bool) -> dict:
    """A slot as a hook sees it: the documented fields, as a fresh dict, so a
    hook can neither read other sessions' records nor change the registry."""
    view = {key: slot.get(key) or ("" if key != "created_ms" else 0) for key in _HOOK_SLOT_FIELDS}
    view["id"] = slot_id
    view["base_present"] = base_present
    return view

def _score_slot(ctx: TaskContext, slot: dict, want: dict, problems: list, hooks: list | None = None) -> int:
    """The repo's scoring hook if one is registered, else the built-in.

    Allocation has no correctness consequence — a worse pick costs a colder
    build — which is what makes it safe to hand to a config.axl hook, and why a
    hook that fails or returns something other than an int is scored by the
    built-in rather than failing the `add`. The first failure is appended to
    `problems`, and the caller then scores every slot by the built-in, so one
    `add` never ranks some slots by the hook and others not. Only the first hook
    registered runs; it gets its own copy of `slot` and of `want`, so nothing it
    changes reaches the built-in scoring or the next call. `hooks` stands in for
    the registered ones.
    """
    registered = ctx.traits[Worktrees].score_slot if hooks == None else hooks
    if not registered:
        return default_score(slot, want)
    err, score = catch(registered[0], ctx, dict(slot), dict(want))
    if err == None and type(score) == "int":
        return max(-_HOOK_SCORE_LIMIT, min(_HOOK_SCORE_LIMIT, score))
    if not problems:
        got = "None" if score == None else "a " + type(score)
        problems.append("the score_slot hook " + (
            ("failed: " + printable(str(err))) if err != None else ("returned " + got + " rather than an int")
        ) + "; every slot was scored by the built-in instead")
    return default_score(slot, want)

def _worktree_holding_branch(ctx: TaskContext, pool: dict, name: str) -> str:
    """The path of any worktree of this clone that has `name` checked out, or "".

    Covers what the registry cannot see: worktrees created by hand, and the
    clone's own main checkout. Git refuses to put one branch in two worktrees,
    and without this the refusal arrives from inside `_materialize`, after the
    chosen slot's previous occupant has already been force-removed — warm state
    destroyed to no purpose, and an error naming a slot the caller never asked
    about.
    """
    for path, branch in _checked_out_branches(ctx, pool).items():
        if branch == name:
            return path
    return ""

def _leased_holding(ctx: TaskContext, pool: dict, registry: dict, name: str) -> str:
    """The slot this clone has leased that holds branch `name`, or "".

    Git's answer first: `git switch` inside a slot moves it to another branch,
    and the branch checked out is what a caller means. The lease's own name —
    which `reconcile` keeps in step with git — counts where git's list does
    not match the slot's path, as when the two spell it differently, or has
    the slot on no branch, as during a rebase.
    """
    live = _checked_out_branches(ctx, pool)
    by_name = ""
    for slot_id in registry["slots"]:
        slot = registry["slots"][slot_id]
        if slot["state"] != LEASED or slot.get("owner_git_dir", "") != pool["git_common_dir"]:
            continue
        path = slot_path(pool, slot_id)
        if live.get(path, "") == name:
            return slot_id
        if not live.get(path, "") and (slot.get("lease") or {}).get("name", "") == name:
            by_name = slot_id
    return by_name

def _resolve_slot(ctx: TaskContext, pool: dict, registry: dict, asked: str, prefix: bool = True) -> str:
    """The slot `asked` names: a branch, a slot id, a slot's directory, or the
    ref a detached slot was taken at.

    `aspect worktree list` shows the slot id and the branch, a free slot's by
    the branch it last held; `add --output=path` hands a script the directory.
    All resolve here, and the caller decides whether the slot is in a state it
    can act on.
    """
    if not asked:
        return ""
    owner = pool["git_common_dir"]
    found = _leased_holding(ctx, pool, registry, asked)
    if found:
        return found

    # A branch still being checked out names the slot reserved for it, which
    # the caller refuses as being set up — never a free slot that happened to
    # hold the branch before.
    found = reserving_slot(registry, asked, pool["git_common_dir"])
    if found:
        return found

    # A directory, as `--output=path` printed it or by its last segment.
    base = asked.rstrip("/").rpartition("/")[2]
    if base.startswith(SLOT_PREFIX) and base[len(SLOT_PREFIX):] in registry["slots"]:
        return base[len(SLOT_PREFIX):]

    # The ref a detached slot was taken at, while only one is. `reconcile`
    # drops `detached` once git has the slot on a branch.
    detached = [
        slot_id
        for slot_id in registry["slots"]
        if registry["slots"][slot_id]["state"] == LEASED and
           registry["slots"][slot_id].get("owner_git_dir", "") == owner and
           (registry["slots"][slot_id].get("lease") or {}).get("detached", "") == asked
    ]
    if len(detached) == 1:
        return detached[0]

    # A slot id, whichever clone owns it: the listing prints every one, so
    # refusing to resolve one it just showed is a dead end. Whether the caller
    # may act on it is the caller's question.
    if asked in registry["slots"]:
        return asked

    for slot_id in registry["slots"]:
        slot = registry["slots"][slot_id]
        if slot.get("owner_git_dir", "") != owner:
            continue

        # A free slot's last branch is the only label the listing gives it, so
        # it resolves — but only while the slot is still free. On a leased slot
        # the lease name is the handle, and matching an earlier occupant's
        # branch would act on somebody else's worktree. Branches are per clone,
        # unlike ids, so this stays scoped to the one asking.
        if slot["state"] == FREE and slot.get("last_branch", "") == asked:
            return slot_id

    # A unique prefix of an id, tried last so a branch that looks like hex still
    # means the branch. Four characters, as git's abbreviations need. Not for
    # `release`, which ends a lease on the answer, where a mistyped branch would
    # otherwise land on whichever slot it happened to prefix. `prune` takes
    # one: it deletes only free slots, whose loss is Bazel state, not work.
    if prefix and len(asked) >= _MIN_SLOT_PREFIX:
        matches = [slot_id for slot_id in registry["slots"] if slot_id.startswith(asked)]
        if len(matches) == 1:
            return matches[0]
    return ""

def _resolvable_names(pool: dict, registry: dict, me: dict | None = None) -> list[str]:
    """The branch names this clone's leased and free slots answer to — the slot
    id for a detached lease — for an error that would otherwise tell the
    reader to go and look at a listing they just came from.

    A free slot's last branch resolves as well as a lease's name — `release`,
    `path` and `prune` all accept one — so listing only what is currently out
    would omit exactly the candidates a reader mistyping a freed branch needs.
    A lease another agent of the caller's own session holds is left out for
    `me`: it is a slot the caller would only be refused.
    """
    names = []
    for slot_id in registry["slots"]:
        slot = registry["slots"][slot_id]
        if slot.get("owner_git_dir", "") != pool["git_common_dir"]:
            continue
        holder = (slot.get("lease") or {}).get("agent") or {}
        if me and slot["state"] == LEASED and _sibling(me, holder):
            continue
        if slot["state"] == LEASED:
            name = (slot.get("lease") or {}).get("name", "")
        else:
            name = slot.get("last_branch", "") if slot["state"] == FREE else ""
        if name and _is_detached_name(name) and slot["state"] == LEASED:
            name = slot_id
        if name and name not in names and not _is_detached_name(name):
            names.append(name)
    return sorted(names)

def _held_elsewhere(pool: dict, registry: dict, name: str) -> tuple | None:
    """A slot another clone owns that holds or last held branch `name`, as
    (slot id, owner, whether it holds it now); None when there is none. A lease
    outranks a free slot's history.

    Branches are per clone, so these never resolve as the caller's own — but
    "not found" about a slot `list` shows by that name sends the reader looking
    for a typo that is not there.
    """
    held = []
    last = []
    for slot_id in sorted(registry["slots"]):
        slot = registry["slots"][slot_id]
        owner = slot.get("owner_git_dir", "")
        if not owner or owner == pool["git_common_dir"]:
            continue
        if slot["state"] == LEASED and (slot.get("lease") or {}).get("name", "") == name:
            held.append((slot_id, owner, True))
        elif slot["state"] == FREE and slot.get("last_branch", "") == name:
            last.append((slot_id, owner, False))
    found = held + last
    return found[0] if found else None

def _slot_stranded(ctx: TaskContext, slot_id: str, owner: str, branch: str, holds: bool) -> TaskConclusion:
    """A slot of a clone that no longer exists, so no clone can lease or
    release it again — only delete it. `branch` is what it holds, or last
    held when `holds` is false; "" when there is none to name.

    Inside a clone, free slots are adopted rather than stranded, so a held one
    (`holds`) is a lease whose checkout no clone here lists: git cannot read
    it, so the delete named is `--force=all`, the one not refused for that. A
    free one is reached where adoption has not run, on a read that takes no
    lock."""
    what = ((" holds " if holds else " last held ") + branch + " for") if branch else " belongs to"
    return _refuse(
        ctx,
        "slot_stranded",
        "slot " + slot_id + what + " a clone of this repository no longer at " + _clone_of(owner) +
        ", and no clone here can take it. If that clone moved, run this from where it is now, which takes the slot " +
        "back; otherwise copy out anything you need, and `aspect worktree prune " + slot_id +
        (" --force=all" if holds else "") + "` deletes it.",
        facts = {"slot": slot_id, "owner": owner, "branch": branch},
    )

def _not_ours(ctx: TaskContext, pool: dict, registry: dict, slot_id: str) -> TaskConclusion | None:
    """The refusal for a slot this clone does not own, or None for one it does.

    Applied after resolving, however the slot was named: a slot id, a prefix
    and a directory resolve whichever clone owns the slot, since `list` prints
    them all. Another clone's slot is that clone's to enter — `release` and
    `prune` act on it through that clone (`_elsewhere`) — and one whose
    clone is gone is nobody's but `prune`'s — which is where a release
    by id would otherwise discard a checkout git cannot even read. So is a
    lease recorded for this clone's path that this clone's git does not list:
    the checkout of a clone that moved, with this one cloned where it was.
    """
    slot = registry["slots"][slot_id]
    owner = _live_other_owner(ctx, pool, slot)
    if owner:
        return _owned_elsewhere(ctx, slot_id, owner)
    if _stranded(ctx, pool, slot):
        holds = slot["state"] == LEASED
        branch = (slot.get("lease") or {}).get("name", "") if holds else slot.get("last_branch", "")
        return _slot_stranded(ctx, slot_id, slot["owner_git_dir"], branch, holds)
    if _unlisted_lease(ctx, pool, registry, slot_id):
        return _not_this_clones(ctx, pool, registry, slot_id)
    return None

def _unlisted_lease(ctx: TaskContext, pool: dict, registry: dict, slot_id: str, checked_out: dict | None = None) -> bool:
    """Whether `slot_id` is leased for this clone's path, holds a checkout,
    and this clone's git does not list it: the checkout of a clone that was
    here and moved away, with this one cloned in its place. Only that clone,
    which `adopt_stranded` hands it back to, can tell what is in it.

    `checked_out` is `_checked_out_branches`, for a caller asking about every
    slot, which would otherwise list the worktrees once per slot."""
    slot = registry["slots"].get(slot_id) or {}
    if slot.get("state", "") != LEASED or slot.get("owner_git_dir", "") != pool["git_common_dir"]:
        return False
    path = slot_path(pool, slot_id)
    if not is_directory(ctx.std, path) or path in (checked_out if checked_out != None else _checked_out_branches(ctx, pool)):
        return False
    return _git_try(ctx, ["rev-parse", "--path-format=absolute", "--git-common-dir"], path) != pool["git_common_dir"]

def _not_this_clones(ctx: TaskContext, pool: dict, registry: dict, slot_id: str) -> TaskConclusion:
    """The refusal for an `_unlisted_lease`."""
    lease = registry["slots"][slot_id].get("lease") or {}
    return _refuse(
        ctx,
        "slot_stranded",
        "slot " + slot_id + (" (" + lease.get("name", "") + ")" if lease.get("name", "") else "") + " is recorded for " +
        "this clone's path, but this clone's git has no worktree there and cannot read the checkout: either it is " +
        "the checkout of a clone that was at " + _clone_of(pool["git_common_dir"]) + " before this one and moved, " +
        "or it is this clone's own checkout, damaged. If that clone moved, run the command from where it is now, which takes " +
        "the slot back. If it is this clone's, `git worktree repair " + shell_quote(slot_path(pool, slot_id)) +
        "` from here may make it readable. Failing both, copy out anything you need, and `aspect worktree prune " +
        slot_id + " --force=all` deletes it — refused while the session holding it is still running.",
        facts = {"slot": slot_id, "owner": pool["git_common_dir"], "branch": lease.get("name", "")},
    )

def _stranded_in_use(ctx: TaskContext, pool: dict, registry: dict, slot_id: str, holder: dict, running: bool) -> TaskConclusion:
    """A stranded slot named to `prune` whose lease's session is `running`, or
    was never captured: the clone most likely moved, with that session at
    work in it."""
    slot = registry["slots"][slot_id]
    return _refuse(
        ctx,
        "held_by_another_session",
        "slot " + slot_id + " is leased by " + _holder(holder) + (", which is running," if running else ", whose process cannot be checked,") +
        " for a clone no longer at " + _clone_of(slot.get("owner_git_dir", "")) + " — most likely moved, with the " +
        "session working in it. Run the command from where that clone is now, which takes the slot back." +
        ("" if running else " If it is gone, --force=all deletes the slot."),
        facts = {
            "slot": slot_id,
            "path": slot_path(pool, slot_id),
            "branch": (slot.get("lease") or {}).get("name", ""),
            "agent": holder,
            "session_state": session_state(ctx.std, holder),
            "same_session": _same_harness_session(_me(ctx), holder),
        },
    )

def _no_such_worktree(ctx: TaskContext, pool: dict, registry: dict, asked: str) -> TaskConclusion:
    """A name nothing in the pool answers to, which is most often a typo.

    Unless another clone's slot answers to it: then that is what is said, by
    `owned_elsewhere` or `slot_stranded`, since the name is right and the clone
    is not.

    The closest name leads, the names listed are capped — the pool's grow with
    it — and both travel as facts, so a caller reading JSON has them without
    parsing the sentence.
    """
    several = sorted([sid for sid in registry["slots"] if sid.startswith(asked)]) if len(asked) >= _MIN_SLOT_PREFIX else []
    if len(several) == 1:
        # Only `release` gets here with a unique prefix: it acts on whole ids.
        return _refuse(
            ctx,
            "no_such_worktree",
            asked + " is the start of slot " + several[0] + "; `release` takes the whole id, or the branch.",
            facts = {"asked": asked, "closest": several[0], "names": several},
        )
    if len(several) > 1:
        return _refuse(
            ctx,
            "no_such_worktree",
            asked + " is the start of more than one slot id — " + ", ".join(several) + " — so give more of it.",
            facts = {"asked": asked, "closest": "", "names": several},
        )

    elsewhere = _held_elsewhere(pool, registry, asked) if asked else None
    if elsewhere:
        slot_id, owner, holds = elsewhere
        if ctx.std.fs.exists(owner):
            return _owned_elsewhere(ctx, slot_id, owner)
        return _slot_stranded(ctx, slot_id, owner, asked, holds)

    names = _resolvable_names(pool, registry, _me(ctx))
    closest = _closest(asked, names)
    if names:
        shown = names[:_NAMES_SHOWN]
        more = (" and %d more" % (len(names) - len(shown))) if len(names) > len(shown) else ""
        detail = ("This clone's slots answer to " + ", ".join(shown) + more + ", and " +
                  "`aspect worktree list` prints the slot ids.")
    else:
        detail = ("This clone has nothing out; `aspect worktree list` prints the slot ids, and " +
                  "`aspect worktree add <branch>` takes a worktree.")
    guess = (" Did you mean " + closest + "?") if closest else ""

    # The caller's own lease on it, ended while it was away: said, rather than
    # left for it to wonder whether it ever had one.
    me = _me(ctx)
    gone = [e for e in (_ended_of_my_session(ctx, registry, me) if me else []) if e["branch"] == asked]
    if gone:
        guess = (" This session held " + asked + " in slot " + gone[-1]["slot"] + " until " +
                 phrase_ms(time.now_ms() - gone[-1]["ended_ms"]) + " ago; that lease ended — released, taken " +
                 "over, or taken back while its process was not running — and its commits are on the branch: " +
                 "`aspect worktree add " + shell_quote(asked) + _id_flag(ctx) + "` takes it again.") + guess
    return _refuse(
        ctx,
        "no_such_worktree",
        ("no worktree or slot called " + asked + " in this pool." if asked else "an empty name names no worktree or slot.") + guess + " " + detail,
        facts = {"asked": asked, "closest": closest, "names": names, "ended": gone},
    )

def _closest(asked: str, names: list[str]) -> str:
    """The name `asked` was most likely a typo of, or "".

    Close means within a quarter of the name's length in single-character
    edits, and at least two: near enough to be a slip of the keyboard rather
    than a different name.
    """
    best = ""
    best_distance = 0
    for name in names:
        reach = max(2, len(name) // 4)

        # The distance is at least the difference in length, and measuring is
        # quadratic, which tells on a clone with thousands of remote branches.
        if len(name) - len(asked) > reach or len(asked) - len(name) > reach:
            continue
        distance = _edit_distance(asked, name)
        if distance > reach:
            continue
        if not best or distance < best_distance:
            best = name
            best_distance = distance
    return best

def _edit_distance(a: str, b: str) -> int:
    """Levenshtein distance, one row at a time."""
    previous = list(range(len(b) + 1))
    for i in range(1, len(a) + 1):
        current = [i] + [0] * len(b)
        for j in range(1, len(b) + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            current[j] = min(previous[j] + 1, current[j - 1] + 1, previous[j - 1] + cost)
        previous = current
    return previous[len(b)]

def _free_slot_phrase(registry: dict, slot_id: str) -> str:
    """That a slot is free, and what it last held — the part of the answer both
    commands share when a reader asks about one.

    Named for the phrase rather than the act: `free_slot` from the pool library
    is the one that frees a slot, and two names a reader could confuse is how a
    caller ends up calling the wrong one.
    """
    last = registry["slots"][slot_id].get("last_branch", "")
    return "slot " + slot_id + " is free" + ((", last holding " + last) if last else "")

def _nothing_to_release_message(registry: dict, slot_id: str) -> str:
    """What `release` says about a slot that is already free.

    Releasing is the step a task ends with, so asking twice — an agent retrying,
    a script run again — is a success rather than an error. The command that
    *deletes* a free slot is named for whoever came here meaning that, but not
    with `--force`: `prune` asks for its own confirmation, and a ready-to-paste
    destructive line in an answer is how an agent ends up running it.
    """
    return (
        _free_slot_phrase(registry, slot_id) + ", so there is nothing to release. " +
        "It keeps its Bazel output base for the next `add`; " +
        "`aspect worktree prune " + slot_id + "` deletes the slot and that base."
    )

def _nothing_to_release(ctx: TaskContext, pool: dict, registry: dict, slot_id: str) -> int:
    if ctx.args.output == "json":
        ctx.std.io.stdout.write(json.encode(_already_free_doc(pool, slot_id), indent = 2) + "\n")
        return 0
    _info(ctx.std, _nothing_to_release_message(registry, slot_id))
    return 0

def _slot_in_use_message(registry: dict, slot_id: str, mine: dict = {}) -> str:
    """Why a slot that is not free cannot be pruned.

    Deleting one somebody is working in takes their checkout with it,
    uncommitted work included, and the warm output base that is the reason to
    keep the slot at all. Ending the lease is a different, reversible thing and
    almost always what the caller meant — so that is the command offered, with
    the branch already in it.

    A slot being set up is a third case; see `_being_set_up_message`.
    """
    slot = registry["slots"][slot_id]
    if slot["state"] == RESERVED:
        return _being_set_up_message(registry, slot_id, "not there to delete")

    lease = slot.get("lease") or {}
    name = lease.get("name", "")
    held = name or "a worktree this pool does not have a name for"

    # Named in full, as `branch_in_use` names a holder: a refusal is not a
    # table, and the reader may have to tell two sessions apart.
    whose = _holder(lease.get("agent") or {}) if (lease.get("agent") or {}) else ""

    # Whose lease it is, when that is knowable. `release` ends somebody's claim
    # on a checkout they may be working in, so handing it over as though it
    # were the reader's to run is how another agent's work disappears — `add`
    # names the holder for the same reason and gates the destructive path.
    if whose and not _same_session(mine, lease.get("agent") or {}):
        return ("slot " + slot_id + " holds " + held + ", which " + whose + " is working in. " +
                "Pruning it would delete their checkout along with whatever Bazel state the " +
                "slot has built up. If that session is finished with it, ending the lease is " +
                "the reversible step and theirs to run:\n\n" +
                "  aspect worktree release " + shell_quote(name))

    advice = ("  aspect worktree release " + shell_quote(name)) if name else "  aspect worktree list --verbose"
    return ("slot " + slot_id + " holds " + held + ", and pruning it would delete that " +
            "checkout along with whatever Bazel state the slot has built up. To end the " +
            "lease and keep the slot for the next `add`:\n\n" + advice)

def _being_set_up_message(registry: dict, slot_id: str, so: str) -> str:
    """A slot an `aspect worktree add` is checking a worktree out into.

    There is no lease yet — nothing to release, nothing to enter, nothing to
    delete — so whichever command asked, the answer is to wait. `so` is what
    that means for the command asking, e.g. "not there to delete".
    """
    pending = (registry["slots"][slot_id].get("reservation") or {}).get("name", "")
    return ("slot " + slot_id + " is being set up" + ((" for " + pending) if pending else "") +
            " right now, so it is " + so + ". `aspect worktree list` shows when that has " +
            "finished, or whether the `add` doing it has stopped.")

def _being_set_up(ctx: TaskContext, registry: dict, slot_id: str, so: str) -> TaskConclusion:
    """A slot an `add` is checking out. Retryable while that `add` runs; once
    its process has gone, waiting changes nothing, so it says so instead.
    Commands that hold the pool lock reclaim such a slot before getting here."""
    if reservation_abandoned(ctx.std, registry, slot_id):
        pending = (registry["slots"][slot_id].get("reservation") or {}).get("name", "")
        return _refuse(
            ctx,
            "slot_setting_up",
            "slot " + slot_id + " was being set up" + ((" for " + pending) if pending else "") +
            " by an `aspect worktree add` that has stopped" + (
                ". `aspect worktree add " + shell_quote(pending) + "` takes it back and finishes the checkout." if pending else "; the next `aspect worktree add` takes it back."
            ),
            retryable = False,
            facts = {"slot": slot_id, "abandoned": True},
        )
    return _refuse(
        ctx,
        "slot_setting_up",
        _being_set_up_message(registry, slot_id, so),
        # The `add` finishing is what changes the answer.
        retryable = True,
        facts = {"slot": slot_id},
    )

def _released_nothing(ctx: TaskContext, pool: dict, slot_id: str, name: str) -> int:
    """`release` of a branch whose `add` stopped part way: the slot was
    reclaimed, nothing was leased, and the answer is the same as for a slot
    already free."""
    if ctx.args.output == "json":
        ctx.std.io.stdout.write(json.encode(_already_free_doc(pool, slot_id) | {"reclaimed": True}, indent = 2) + "\n")
        return 0
    _info(ctx.std, "nothing to release: the `aspect worktree add` of " + name + " stopped before it " +
                   "leased slot " + slot_id + ", which is free again")
    return 0

def _already_free_doc(pool: dict, slot_id: str) -> dict:
    """`release`'s document for a slot with nothing leased in it."""
    return {
        "schema_version": _SCHEMA_VERSION,
        "released": "",
        "already_free": True,
        "slot": slot_id,
        "path": slot_path(pool, slot_id),
        "head": "",
        # Nothing was checked out, so there is no commit for a remote to have:
        # null, not false, which would read as "push it".
        "head_on_remote": None,
        "discarded": [],
        "cwd_removed": False,
        "clone": pool["git_common_dir"].removesuffix("/.git"),
        "warnings": [],
    }

def _held_by_another_session(ctx: TaskContext, pool: dict, registry: dict, slot_id: str, kept_ms: int = 0, root: str = "") -> TaskConclusion:
    """A lease another session holds that has not verifiably stopped — or has,
    with `kept_ms` of its grace left — which `release` was asked to end.

    Ending it removes a checkout somebody may be working in, so it is theirs to
    do — the same line `add` draws with `--take-over`. A session can be finished
    with a slot without having released it, so `--force=all` remains, named as
    the override it is — apart from plain `--force`, so discarding one's own
    uncommitted work never also evicts somebody.

    Said as what is known: a running process, or one that was never captured —
    an explicit `--agent-kind`, or a script naming a session — and so cannot be
    shown to have stopped. A sibling subagent's lease is the session's to end,
    so for a sibling no override is offered.
    """
    lease = registry["slots"][slot_id].get("lease") or {}
    agent = lease.get("agent") or {}
    name = lease.get("name", "") or slot_id
    me = _me(ctx)
    state = "a running " if agent.get("pid", 0) and kept_ms <= 0 else ""
    unknown = "" if agent.get("pid", 0) or not agent else ", whose process cannot be checked"
    if kept_ms > 0:
        unknown = (", which is not running; its slot is kept for it for another " + phrase_ms(kept_ms) +
                   ", counted from the slot's last activity (`Worktrees.abandoned_grace_hours`), in case it comes back")
    sibling = _sibling(me, agent)
    forced = ("--force covers uncommitted work only, not another session's lease. " if ctx.args.force == _FORCE_DIRTY and not sibling else "")
    path = slot_path(pool, slot_id)
    work = _dirty(ctx, path, root)
    dirty = ("\nIt has uncommitted changes" + ("" if sibling else ", which --force=all would discard with the checkout") +
             ":\n" + _indented(work)) if work else ""
    return _refuse(
        ctx,
        "held_by_another_session",
        (forced + name + " is held by " + _holder(agent) + ", " + _kin(agent) + ". Leave it; " +
         "the session itself can release it or take it over; no flag overrides that from here." + dirty) if sibling else (forced + name + " is held by " + state + _holder(agent) + unknown + ". Releasing it " +
                                                                                                                          "would end that lease and remove its checkout, which is theirs to do — check " +
                                                                                                                          "with whoever is driving it. If it is finished with the slot and the user agrees, pass " +
                                                                                                                          "--force=all." + dirty),
        facts = {
            "slot": slot_id,
            "branch": lease.get("name", ""),
            "agent": agent,
            "process": _process_state(ctx, agent),
            "session_state": session_state(ctx.std, agent),
            "uncommitted": _porcelain_entries(work),
            "same_session": _same_harness_session(me, agent),
            "grace_left_ms": kept_ms if kept_ms > 0 else 0,
        },
    )

def _clone_of(git_dir: str) -> str:
    """The clone an object store belongs to, as a reader names it: the
    directory holding `.git`. Escaped line breaks and all, since it goes into
    sentences: a path from another clone could otherwise fake a line."""
    return printable(git_dir.removesuffix("/.git"))

def _live_other_owner(ctx: TaskContext, pool: dict, slot: dict) -> str:
    """The object store of another clone that owns `slot` and still exists, or
    "" — this clone's slot, an unowned one, or one stranded by a clone that is
    gone."""
    owner = slot.get("owner_git_dir", "")
    if owner and owner != pool["git_common_dir"] and ctx.std.fs.exists(owner):
        return owner
    return ""

def _stranded(ctx: TaskContext, pool: dict, slot: dict) -> bool:
    """Whether `slot` belongs to another clone that no longer exists, so that
    nothing can ever lease or release it again."""
    owner = slot.get("owner_git_dir", "")
    return owner != "" and owner != pool["git_common_dir"] and not ctx.std.fs.exists(owner)

def _owned_elsewhere(ctx: TaskContext, slot_id: str, owner: str) -> TaskConclusion:
    """A slot another clone that still exists owns.

    Its worktree is that clone's to manage, and deleting the slot would take a
    checkout somebody may be working in. A slot whose owning clone is *gone* is
    different: a free one is taken over by the next command in any clone, and a
    leased one no clone lists is deleted by naming it to `prune`.
    """
    return _refuse(
        ctx,
        "owned_elsewhere",
        "slot " + slot_id + " belongs to another clone of this repository, at " + _clone_of(owner) + ", " +
        "which still exists — it is that clone's to manage. Run this there, or let " +
        "`aspect worktree prune` collect the slot once that clone is gone.",
        facts = {"slot": slot_id, "owner": owner},
    )

def _slot_still_warm(ctx: TaskContext, pool: dict, slot_id: str, pid: int, root: str) -> TaskConclusion:
    """Why a named slot with a live Bazel server is not deleted.

    Unlinking an output base from under a running server leaves it writing into
    directories that are gone, so this is refused however it was asked for —
    `--force` covers not having a terminal to confirm at, not overruling that.
    Both ways out are named, because a refusal a caller cannot act on is only
    half an answer: wait for Bazel's own idle timeout, or let `aspect gc` stop
    the server and take the base, which is what it does for one named outright.
    """
    base = output_base_of(ctx.std, slot_path(pool, slot_id), root)
    hash = base.rpartition("/")[2]
    return _refuse(
        ctx,
        "slot_warm",
        "slot " + slot_id + " still has a Bazel server running in it (pid " + str(pid) + "), and " +
        "deleting its output base from under a live server would leave that server writing into " +
        "directories that no longer exist. Wait for Bazel's own idle timeout, or stop it and take " +
        "the base in one step:\n\n" +
        "  " + _runnable(ctx, "aspect gc " + hash),
        # Waiting for the idle timeout is the first remedy offered, and waiting
        # then trying again is what retryable means.
        retryable = True,
        facts = {"slot": slot_id, "server_pid": pid, "output_base": base},
    )

def _slot_in_use(ctx: TaskContext, registry: dict, slot_id: str) -> TaskConclusion:
    lease = (registry["slots"][slot_id].get("lease") or {})
    return _refuse(
        ctx,
        "slot_in_use",
        _slot_in_use_message(registry, slot_id, _me(ctx)),
        facts = {"slot": slot_id, "branch": lease.get("name", ""), "agent": lease.get("agent") or {}},
    )

def _nothing_checked_out(ctx: TaskContext, registry: dict, slot_id: str) -> TaskConclusion:
    """A free slot is a directory with no worktree in it, so there is nowhere to
    go — but taking it back is one command, and it keeps whatever is warm."""
    last = registry["slots"][slot_id].get("last_branch", "")
    take = ("`aspect worktree add " + shell_quote(last) + "`") if last and not _is_detached_name(last) else "`aspect worktree add <branch>`"
    return _refuse(
        ctx,
        "slot_not_leased",
        _free_slot_phrase(registry, slot_id) + ", so nothing is checked out there to enter. " +
        take + " takes the slot again, keeping the Bazel state it still has.",
        facts = {"slot": slot_id, "last_branch": last},
    )

_LINES_SHOWN = 20

# The codes `hidden_work` gives work `git status` does not show, each line a
# path then why it counts.
_HIDDEN_STATUSES = ["SM", "H ", "WR", "IP", "NW"]

# `git worktree add` with a HEAD reflog whatever `core.logAllRefUpdates` says:
# see `_materialize`.
_WORKTREE_ADD = ["-c", "core.logAllRefUpdates=always", "worktree", "add"]

def _capped(lines: list[str]) -> list[str]:
    """`lines` for a sentence, cut to `_LINES_SHOWN` with a count of the rest.
    The facts carry them all."""
    if len(lines) <= _LINES_SHOWN:
        return lines
    return lines[:_LINES_SHOWN] + ["... and %d more" % (len(lines) - _LINES_SHOWN)]

def _porcelain_entries(lines: list[str]) -> list[dict]:
    """`git status --porcelain` lines as `{status, path}`, for JSON: a consumer
    should not have to know that the first two columns are the status. Both
    columns are kept — ` M` is a change not yet staged, `M ` a staged one. A
    rename or copy adds `from`, the name it had.

    `work_in`'s own lines carry a `note` too: `UR` for a checkout git cannot
    read, `DH` for commits only this worktree's HEAD reaches, `VG` for a
    checkout gone from its directory and `IX` for the staged index it left
    behind name no file, so their `path` is ""; `hidden_work`'s name a path,
    then say why it counts after two spaces, in parentheses. A path git quoted
    is unquoted."""
    entries = []
    for line in lines:
        status = line[:2]
        rest = line[3:]
        if status in ["UR", "DH", "VG", "IX"] and rest.startswith("("):
            note = rest.removeprefix("(")
            note = note.replace("): ", ": ", 1) if "): " in note else note.removesuffix(")")
            entries.append({"status": status, "path": "", "note": note})
        elif status in _HIDDEN_STATUSES and "  (" in rest:
            path, _, note = rest.partition("  (")
            entries.append({"status": status, "path": path, "note": note.removesuffix(")")})
        elif status[0] in "RC" and " -> " in rest:
            # A rename or copy: where it went is the path, where it came from
            # beside it. Split on the arrow between the two names, quoted or not.
            old, new = _renamed(rest)
            entries.append({"status": status, "path": new, "from": old})
        else:
            entries.append({"status": status, "path": _unquoted(rest)})
    return entries

def _renamed(rest: str) -> tuple:
    """`(from, to)` for a rename's `old -> new`, each unquoted. Split at the
    arrow that ends the first name: after its closing quote when git quoted it."""
    if rest.startswith("\""):
        i = 1
        for _ in range(len(rest)):
            if i >= len(rest):
                break
            if rest[i] == "\\":
                i += 2
                continue
            if rest[i] == "\"":
                break
            i += 1
        if rest[i + 1:i + 5] == " -> ":
            return (_unquoted(rest[:i + 1]), _unquoted(rest[i + 5:]))
    old, _, new = rest.partition(" -> ")
    return (_unquoted(old), _unquoted(new))

# The escapes git's path quoting writes, other than octal bytes.
_C_ESCAPES = {"\\": "\\", "\"": "\"", "t": "\t", "n": "\n", "r": "\r", "a": "\a", "b": "\b", "f": "\f", "v": "\v"}

def _unquoted(path: str) -> str:
    """A path as `git status` quotes it — in double quotes, with C escapes,
    when it holds a space, a quote or a control character — as the file is
    named, for JSON. A name with bytes git wrote in octal, which a string here
    cannot reassemble into characters, is left quoted rather than mangled."""
    if len(path) < 2 or not path.startswith("\"") or not path.endswith("\""):
        return path
    inner = path[1:-1]
    out = []
    escaped = False
    for ch in inner.elems():
        # A quote inside that nothing escaped: not one quoted name, so it is
        # left as git wrote it.
        if ch == "\"" and not escaped:
            return path
        if escaped:
            if ch not in _C_ESCAPES:
                return path
            out.append(_C_ESCAPES[ch])
            escaped = False
        elif ch == "\\":
            escaped = True
        else:
            out.append(ch)
    return path if escaped else "".join(out)

def _release_grade(me: dict, holder: dict) -> struct:
    """Which `--force` discarding a lease's work takes, for caller `me`.

    `--force` for the caller's own. `--force=all` for somebody else's, even once
    their process has gone — a stopped session is usually a resumable one, and
    its work is not the caller's to throw away — and for work under a lease
    that records neither a session id nor a process, since such leases match
    by kind alone and cannot be told apart from another session of the same
    harness. A person's lease is a person's own when the caller is a person,
    and a subagent's is its parent session's.
    """
    foreign = (not _same_session(me, holder) and not _own_subagent(me, holder)) if holder else bool(me)
    anonymous = bool(holder) and not holder.get("id", "") and not holder.get("pid", 0)
    return struct(
        foreign = foreign,
        anonymous = anonymous,
        needed = _FORCE_ALL if foreign or anonymous else _FORCE_DIRTY,
    )

def _protected_from(std, me: dict, holder: dict) -> bool:
    """Whether `holder`'s lease is protected from `me` releasing it.

    The caller's own lease is never protected. One a person took at a terminal
    — no agent recorded — is protected from agents and not from a person.
    Another session's is protected until its process has verifiably stopped,
    and a holder whose process was never captured cannot be shown to have, so
    it stays protected, as it does from being reclaimed. A sibling subagent's
    is protected whatever its process: subagents share the session's, so a
    stopped one says nothing about whether the sibling is done, and the slot
    is the session's to decide on.
    """
    if not holder:
        return bool(me)
    if _same_session(me, holder) or _own_subagent(me, holder):
        return False
    if _sibling(me, holder):
        return True
    return not holder.get("pid", 0) or session_state(std, holder) == RUNNING

def _on_remote(ctx: TaskContext, pool: dict, commit: str) -> bool:
    """Whether any remote-tracking ref contains `commit` — whether the work it
    ends is recoverable from somewhere other than this clone."""
    return _git_try(
        ctx,
        ["for-each-ref", "--contains", commit, "--format=%(refname)", "refs/remotes"],
        pool["git_common_dir"],
    ) != ""

def _push_command(ctx: TaskContext, pool: dict, branch: str) -> str:
    """The push that gives `branch` an upstream of its own name, or "" in a
    clone with no remote to push to.

    `origin` where there is one, else the clone's only remote; with several
    and no `origin`, which one is the reader's call, so it is left as
    `<remote>`.
    """
    remotes = _git_try(ctx, ["remote"], pool["git_common_dir"]).splitlines()
    if not remotes:
        return ""
    if "origin" in remotes:
        remote = "origin"
    elif len(remotes) == 1:
        remote = shell_quote(remotes[0])
    else:
        remote = "<remote>"
    return "git push -u " + remote + " " + shell_quote(branch)

def _short(sha: str) -> str:
    """A commit as a reader is shown it: eight characters, as `git log --oneline`
    shows more or less."""
    return sha[:8]

def _holder(agent: dict) -> str:
    """A lease's holder, named for a sentence: "claude-code session <id>", or
    with no id, said so rather than leaving the kind standing alone.

    The id is whole, since two sessions whose ids share a prefix have to be told
    apart by whoever reads it. Every message here that names a holder goes
    through this, so they all name one the same way.
    """
    if not agent:
        return "a person at a terminal, with no agent recorded"
    kind = agent.get("kind", "") or "an unidentified harness"
    sid = agent.get("id", "")
    if agent.get("parent_id", ""):
        return kind + " agent " + sid + " in session " + agent["parent_id"]
    return (kind + " session " + sid) if sid else kind + " session, with no id recorded"

def _me(ctx: TaskContext) -> dict:
    """The calling session, from `--agent-kind` / `--agent-id` where the
    command has them, else the environment and detection."""
    return detect(ctx.std, ctx.args.agent_kind, ctx.args.agent_id)

def _own_subagent(mine: dict, theirs: dict) -> bool:
    """Whether `theirs` is a subagent the caller, as the session itself, ran:
    its `parent_id` is the caller's own session id, under the same kind or the
    same `harness_id`. Deciding what happens to
    such a slot is the caller's — releasing it, or taking it over — since the
    work is its own session's. A sibling subagent asking is not the parent."""
    return (bool(theirs.get("parent_id", "")) and not mine.get("parent_id", "") and
            (theirs.get("kind", "") == mine.get("kind", "") or _same_harness_id(mine, theirs)) and
            theirs["parent_id"] == mine.get("id", ""))

def _sibling(mine: dict, theirs: dict) -> bool:
    """Whether `theirs` is another agent of the caller's harness session that
    the caller cannot speak for: one subagent asking about another's slot, or
    about the session's own. Only the session itself decides for its
    subagents."""
    return (_same_harness_session(mine, theirs) and not _same_session(mine, theirs) and
            not _own_subagent(mine, theirs))

def _same_harness_id(mine: dict, theirs: dict) -> bool:
    """Whether both records carry the same session id as their harness
    reported it — the one thing that says two records are one session even
    when they were labelled with different kinds."""
    return theirs.get("harness_id", "") != "" and theirs["harness_id"] == mine.get("harness_id", "")

def _kin(holder: dict) -> str:
    """How a `_sibling` holder relates to the caller, for a sentence: the
    session itself, or another of its subagents."""
    return "another agent of this session" if holder.get("parent_id", "") else "the session itself"

def _same_harness_session(mine: dict, theirs: dict) -> bool:
    """Whether two records belong to one harness session — the same agent, a
    subagent of it, or a sibling subagent — which is what `same_session` in a
    refusal's facts says."""
    if not mine or not theirs:
        return False
    if _same_harness_id(mine, theirs):
        return True
    if theirs.get("kind", "") != mine.get("kind", ""):
        return False
    return (session_id(mine) != "" and session_id(mine) == session_id(theirs)) or _same_session(mine, theirs)

def _id_flag(ctx: TaskContext) -> str:
    """` --agent-id=<id>` when the caller gave one, for the commands a message
    suggests: without it, pasting one takes the lease as the parent session."""
    given = getattr(ctx.args, "agent_id", "")
    return (" --agent-id=" + shell_quote(given)) if given else ""

def _same_session(mine: dict, theirs: dict) -> bool:
    """Whether two agent records are the same session.

    By session id where the harness reports one. Where it does not — Cursor,
    Gemini CLI, a harness found by walking the process tree — by the harness
    process, pid and start time, where one was captured. A harness that
    reports neither, as one detected from an environment marker alone does,
    matches by kind: nothing tells two of its sessions apart, and the
    alternative leaves it unable to release its own lease without
    `--force=all`, which also discards work. A worktree somebody took at a
    terminal, with no harness at all, is nobody else's.

    A session the harness reported (`harness_id`) is one session whatever kind
    it was recorded under, so `--agent-kind` relabelling a session does not
    make its own lease another's: the same harness session and the same id
    match across kinds, and two records naming different harness sessions
    never match, whatever ids their subagents chose. An id with no harness
    session behind it is only unique within its kind.
    """
    sid = theirs.get("id", "")
    if theirs.get("harness_id", "") and mine.get("harness_id", ""):
        # Both say which harness session they are; two different ones are two
        # sessions, however their subagents were named.
        return _same_harness_id(mine, theirs) and sid == mine.get("id", "")
    kind = theirs.get("kind", "")
    if not kind or kind != mine.get("kind", ""):
        return False
    if sid or mine.get("id", ""):
        return sid == mine.get("id", "")
    pid = theirs.get("pid", 0)
    if pid or mine.get("pid", 0):
        return pid == mine.get("pid", 0) and theirs.get("pid_start", "") == mine.get("pid_start", "")
    return True

def _held_by(ctx: TaskContext, pool: dict, registry: dict, slot_id: str, name: str, mine: dict, root: str = "") -> str:
    """Why `name` cannot be taken, and what the caller can do instead.

    The lease knows which session holds it and whether that session is running,
    suspended or deleted. A refusal that reports only the slot path makes the
    caller go and find that out; one that reports it turns a dead end into a
    choice between resuming the other session and taking the slot.

    A holder that has stopped would have had its slot taken back but for what
    is in the checkout, so that is named too.
    """
    lease = registry["slots"][slot_id].get("lease") or {}
    agent = lease.get("agent") or {}
    where = slot_path(pool, slot_id)
    if not agent:
        return (name + " is already checked out at " + where + ", held by " + _holder(agent) +
                ". If that is you, use it, or `aspect worktree release " + shell_quote(name) +
                "` first; if not, it is not yours to take.")

    # One of the caller's own subagents: liveness is the session's, so whether
    # it stopped is the caller's to know, and the caller's to act on.
    if _own_subagent(mine, agent):
        return (name + " is checked out at " + where + ", held by " + _holder(agent) +
                ", a subagent of this session. If that subagent has stopped, `aspect worktree add " +
                shell_quote(name) + " --take-over" + _id_flag(ctx) + "` gives you its slot, uncommitted " +
                "work included; if it is still working, take a branch of your own.")

    # Another agent of this session: not a stranger, and not this caller's
    # either. The session itself decides for its subagents.
    if _sibling(mine, agent):
        return (name + " is checked out in slot " + slot_id + ", held by " + _holder(agent) + ", " + _kin(agent) +
                ". Leave it and take a branch of your own; the session itself can release it or take it over.")

    # Held by this session. Phrased for the caller rather than a stranger, but
    # not as certainly theirs: subagents report their parent's session id, so a
    # sibling's slot reads the same.
    if _same_session(mine, agent):
        return (name + " is already held by this session, checked out at " + where +
                ". If you took it, `aspect worktree path " + shell_quote(name) + _id_flag(ctx) + "` prints that path " +
                "again. Subagents share their parent's session, so if you did not, another " +
                "agent of this session did — use a different branch.")

    state = session_state(ctx.std, agent)
    who = _holder(agent)
    stopped = state != RUNNING and agent.get("pid", 0)
    spot = "in slot " + slot_id
    if state == RUNNING:
        held = name + " is checked out " + spot + ", held by a running " + who + "."
    elif stopped:
        held = name + " is checked out " + spot + ", held by " + who + ", which is not running."
    else:
        held = name + " is checked out " + spot + ", held by " + who + "."
    kept = ""
    if stopped:
        work = _work(ctx, where, root)
        left = _grace_ms(ctx) - (time.now_ms() - lease_last_active_ms(ctx.std, pool, slot_id, registry["slots"][slot_id], root))
        if not work and left > 0:
            kept = ("\n\nIts slot is kept for it for another " + phrase_ms(left) + ", counted from the slot's " +
                    "last activity (`Worktrees.abandoned_grace_hours`), in case it comes back.")
        if work:
            kept = ("\n\nIt was not taken back because the checkout holds work that would be lost:\n" +
                    _indented(work))

    # Each option stands on its own, because which ones apply depends on what
    # can be established about the session.
    lines = [held]
    hint = _resume_line(ctx.std, agent, ctx.std.env.home_dir())
    tail = ""
    if hint and state == RESUMABLE:
        # On its own line: a session id is long, and run into the next sentence
        # a reader cannot see where it ends — nor can a copy-paste.
        tail = "\n\n  " + hint + "\n"
    if state == RUNNING:
        # No command to paste: taking a running session's checkout puts two
        # agents in one tree, and that is for whoever drives both to decide.
        lines.append("That session is still running, so leave the slot to it, or ask whoever is " +
                     "driving it; claiming it anyway is `--take-over`, and the user's decision.")
    else:
        lines.append("Claiming the slot for this session instead is the user's decision, since it " +
                     "inherits whatever that session left uncommitted: `aspect worktree add " + shell_quote(name) +
                     " --take-over" + _id_flag(ctx) + "`.")
    if tail:
        return lines[0] + " Resume that session:" + tail + "\n" + " ".join(lines[1:]) + kept
    return " ".join(lines) + kept

def _process_state(ctx: TaskContext, agent: dict) -> str:
    """Whether a lease holder's recorded process runs: `running`, `stopped`,
    or `unknown` where none was recorded. Apart from `session_state`, which
    asks the harness about the session and often cannot say."""
    if not agent.get("pid", 0):
        return "unknown"
    return "running" if session_state(ctx.std, agent) == RUNNING else "stopped"

def _of_my_session(me: dict, agent: dict) -> bool:
    """Whether a lease's holder is the caller's harness session or one of its
    subagents, by the session id the harness reported: the same `harness_id`,
    or — for a record from before that was kept — the caller's harness session
    as the holder's id or parent. An id a caller chose matches nothing here,
    since two sessions can choose the same one."""
    sid = me.get("harness_id", "")
    if not sid or not agent:
        return False
    if agent.get("harness_id", ""):
        return agent["harness_id"] == sid
    return agent.get("id", "") == sid or agent.get("parent_id", "") == sid

def _follow_session(ctx: TaskContext, pool: dict, registry: dict, locked: bool) -> dict:
    """`registry`, with every lease of the caller's harness session — its own,
    and its subagents' — moved to the caller's process where it records one
    that is no longer running: a session resumed after its first process
    exited.

    Liveness is read from the recorded process, and a subagent's is its
    session's, so without this a resumed session and everything it ran read as
    stopped, and once the grace period is up their slots are taken back from
    under them. Only leases matched by the session's id move, and only off a
    recorded process that is no longer running: two live processes of one
    session leave each where it is, and a holder whose process was never
    captured — never taken to have stopped — keeps it as it is.

    Written under the pool lock: the caller's when `locked`, else one tried
    once and dropped straight after, so a command that only reads never waits
    on, or holds up, an `add`. With the lock busy the leases are left for the
    next call.
    """
    me = _me(ctx)
    if not me.get("pid", 0):
        return registry
    stale = []
    for slot_id in registry["slots"]:
        holder = (registry["slots"][slot_id].get("lease") or {}).get("agent") or {}
        if (holder.get("id", "") and holder.get("pid", 0) and holder["pid"] != me["pid"] and
            _of_my_session(me, holder) and session_state(ctx.std, holder) != RUNNING):
            stale.append(slot_id)
    if not stale:
        return registry
    token = "" if locked else acquire(ctx.std, pool["dir"], attempts = 1)
    if not locked and not token:
        return registry
    fresh = read_registry(ctx.std, pool["dir"])
    moved = False
    for slot_id in stale:
        was = (registry["slots"][slot_id].get("lease") or {}).get("agent") or {}
        slot = fresh["slots"].get(slot_id) or {}
        agent = (slot.get("lease") or {}).get("agent") or {}
        if slot.get("state", "") == LEASED and agent.get("pid", 0) == was.get("pid", 0):
            for key in ["pid", "pid_start", "seen_ms"]:
                if key in me:
                    agent[key] = me[key]
                    was[key] = me[key]
            moved = True
    if moved and not fresh.get("read_only", False):
        write_registry(ctx.std, pool["dir"], fresh)
    if token:
        release(ctx.std, pool["dir"], token)
    return registry

def _ended_of_my_session(ctx: TaskContext, registry: dict, me: dict) -> list[dict]:
    """`{branch, slot, ended_ms, agent_id}` for each lease of the caller's session that
    ended in the last day on a slot somebody else now holds, or nobody does —
    what a resumed session needs told, since its own slots no longer list them."""
    now = time.now_ms()
    ended = []
    seen = {}
    held = {}
    for slot in registry["slots"].values():
        holder = (slot.get("lease") or {}).get("agent") or {}
        if holder and _of_my_session(me, holder):
            held[(slot.get("lease") or {}).get("name", "")] = True
    for slot_id in sorted(registry["slots"].keys()):
        slot = registry["slots"][slot_id]
        holder = (slot.get("lease") or {}).get("agent") or {}
        if holder and _of_my_session(me, holder):
            continue
        for entry in slot.get("history") or []:
            done = entry.get("released_ms", 0)
            name = entry.get("name", "")
            if (done and now - done < 24 * 3600 * 1000 and name not in held and (slot_id, name) not in seen and
                _of_my_session(me, entry.get("agent") or {})):
                seen[(slot_id, name)] = True
                who = entry.get("agent") or {}
                ended.append({
                    "branch": name,
                    "slot": slot_id,
                    "ended_ms": done,
                    "agent_id": who.get("id", "") if who.get("parent_id", "") else "",
                })
    return ended

def _take_over(ctx: TaskContext, pool: dict, registry: dict, slot_id: str, name: str, root: str = "") -> dict:
    """Re-attribute a lease to this caller, leaving the checkout untouched.

    The slot already holds this branch, so nothing is recreated: no
    `worktree remove`, no re-checkout, and whatever the previous session left
    uncommitted is still there afterwards. The only thing that changes is who
    the lease says is responsible for it.

    Returns the `taken_over` warning, naming the previous holder, for the
    caller's `warnings` — in text it is also printed here.
    """
    lease = registry["slots"][slot_id].get("lease") or {}
    previous = lease.get("agent") or {}
    path = slot_path(pool, slot_id)
    work = _dirty(ctx, path, root)
    said = ("taking " + name + " over from " + _holder(previous) + "; the checkout is untouched" +
            ((", and these uncommitted changes in it are now yours:\n" +
              _indented(work)) if work else ", with nothing uncommitted in it"))
    if ctx.args.output != "json":
        _warn(ctx.std, said)
    agent = _me(ctx)
    record_handover(registry, slot_id, name, agent)
    mark_leased(registry, slot_id, name, agent)

    # Facts about the checkout, which is untouched, rather than about who holds it.
    for key in ["detached", "base", "base_sha"]:
        if lease.get(key, ""):
            registry["slots"][slot_id]["lease"][key] = lease[key]
    return {
        "code": "taken_over",
        "message": said,
        "previous_holder": previous,
        "uncommitted": _porcelain_entries(work),
    }

def _prune_reason(ctx: TaskContext, pool: dict, slot_id: str, slot: dict, root: str) -> str:
    """Why this slot is collectable, in the terms that actually apply to it.

    An entry with no recorded age is collectable because there is nothing behind
    it, not because of a threshold it cannot be measured against, and a
    stranded one because its clone is gone, whatever its age.
    """
    if _stranded(ctx, pool, slot):
        return "stranded, clone gone"
    if slot.get("created_ms", 0):
        return "idle " + compact_ms(slot_idle_ms(ctx.std, pool, slot_id, slot, root))
    return "no recorded age, nothing on disk"

def _age_out(ctx: TaskContext, pool: dict, registry: dict, root: str) -> int:
    """Drop free slots nothing has touched in `PRUNE_IDLE_DAYS`. Returns how many
    went, so the caller can persist a registry that no longer matches the disk.

    This is what actually bounds the pool, and it runs inside `add` because
    nobody runs a cleanup command on a schedule. It never touches a leased slot
    or one a live server still holds, so the worst case is reclaiming cache that
    had already stopped paying for itself.
    """
    dropped = 0
    for slot_id in prunable_slots(ctx.std, pool, registry, PRUNE_IDLE_DAYS, root, stranded_at_once = False):
        slot = registry["slots"][slot_id]
        label = slot.get("last_branch", "") or slot_id
        why = _prune_reason(ctx, pool, slot_id, slot, root)
        if drop_slot(ctx.std, pool, registry, slot_id, root).dropped:
            _info(ctx.std, "pruned slot (%s): %s" % (why, label))
            dropped += 1
    return dropped

def _reclaim_reservations(ctx: TaskContext, pool: dict, registry: dict) -> int:
    """Free slots an interrupted `add` was setting up. Returns how many went, so
    the caller can persist a registry that no longer matches the disk.

    A reservation is honoured only while the process behind it is alive, and
    this is the one place that judges it, because acting on the answer means
    writing the registry. Running it before allocation matters twice over: the
    slot is otherwise unallocatable for good, and the half-made worktree left in
    git would make the next request for that branch look as though it were
    checked out somewhere the pool does not manage.

    The checkout goes with it when the interrupted `add` made it, however
    half-finished: a checkout killed part way reads as a tree full of changes,
    and keeping it would leave the branch stranded in a slot nobody holds.
    """
    freed = 0
    for slot_id in registry["slots"]:
        slot = registry["slots"][slot_id]
        if slot["state"] != RESERVED or slot.get("owner_git_dir", "") != pool["git_common_dir"]:
            continue
        if not reservation_abandoned(ctx.std, registry, slot_id):
            continue
        pending = (slot.get("reservation") or {}).get("name", "")
        _info(ctx.std, "reclaimed the slot an interrupted `aspect worktree add` was setting up" +
                       ((" for " + pending) if pending else ""))
        if _reservation_may_clear(ctx, pool, registry, slot_id):
            free_slot(ctx.std, pool, registry, slot_id)
        else:
            # Freed in the registry only; git still lists the checkout, so the
            # next `reconcile` adopts it as a lease with no agent — a person's
            # to release, and nobody's to clear.
            mark_free(registry, slot_id)
        freed += 1
    return freed

def _reservation_may_clear(ctx: TaskContext, pool: dict, registry: dict, slot_id: str) -> bool:
    """Whether the checkout at a reserved slot is the reserving `add`'s to throw
    away: there is no work in it, or the checkout was made after the
    reservation was.

    `_materialize` removes whatever is at the path before `git worktree add`
    writes the `.git` link, and refuses without touching it when it finds work.
    So a link newer than the reservation is that `add`'s own, partial or not,
    and an older one is work that was there first.
    """
    path = slot_path(pool, slot_id)
    if not _holds_work(ctx, path):
        return True
    since_ms = (registry["slots"][slot_id].get("reservation") or {}).get("since", 0)
    err, meta = catch(ctx.std.fs.symlink_metadata, path + "/.git")
    if err != None or meta.modified == None or not since_ms:
        return False
    return meta.modified // 1000 >= since_ms

def _drop_reservation(ctx: TaskContext, pool: dict, registry: dict, slot_id: str, token: str) -> None:
    """Give a reserved slot back after its checkout failed. Mutates `registry`.

    The slot returns to free with whatever it was last built for still recorded:
    that describes its output base, which this attempt never changed, so it is
    still what the next allocation should score it on. A slot made for this
    attempt that never held a worktree goes altogether, rather than sitting in
    the pool counting against `max_slots` with nothing behind it.
    """
    if not holds_reservation(registry, slot_id, token):
        return

    # A failed checkout may have left a partial worktree. It goes with the
    # record, or the slot would hold a worktree no lease accounts for — unless
    # it is work that was there before this `add`, which `_materialize` refused.
    clear = _reservation_may_clear(ctx, pool, registry, slot_id)
    if clear:
        catch(run_git, ctx.std, FORCE_REMOVE + [slot_path(pool, slot_id)], pool["git_common_dir"])
    if clear and not registry["slots"][slot_id].get("lease_count", 0) and remove_checkout(ctx.std, slot_path(pool, slot_id), ""):
        registry["slots"].pop(slot_id)
        return
    registry["slots"][slot_id]["state"] = FREE
    registry["slots"][slot_id]["reservation"] = None

def _pick_slot(ctx: TaskContext, pool: dict, registry: dict, want: dict, root: str) -> struct:
    """The best free slot this clone owns for `want`, creating one if none fits.

    A slot is only a candidate when it belongs to this clone's object store:
    `git worktree add` cannot hand a worktree to a different one.

    Any free slot beats creating one, however badly it scores — except one
    holding work, or whose directory will not go, which is passed over: a bad reuse pays
    the same `external/` refetch a new slot would and skips the new JVM, the
    from-zero analysis and one more output base on disk. A `score_slot` hook may
    still veto with 0 or less, and then a new slot is the only way to serve the caller —
    but a hook that vetoes everything would otherwise grow the pool without
    bound, so at `max_slots` the veto yields to the best available slot.
    """
    views = {}
    for slot_id in registry["slots"]:
        slot = registry["slots"][slot_id]
        if slot["state"] != FREE or slot.get("owner_git_dir", "") != pool["git_common_dir"]:
            continue
        work = _work(ctx, slot_path(pool, slot_id), root)
        if work:
            _warn(ctx.std, "skipping free slot " + slot_id + ": it still holds " + _work_said(work) +
                           ", at " + slot_path(pool, slot_id) + ". " + _CLEAR_BY_HAND)
            continue

        # A free slot holds no checkout, so a directory there is debris from a
        # removal that failed. Cleared now, or passed over while it will not go:
        # `git worktree add` refuses a path that exists.
        if ctx.std.fs.exists(slot_path(pool, slot_id)) and not remove_checkout(ctx.std, slot_path(pool, slot_id), pool["git_common_dir"]):
            _warn(ctx.std, "skipping free slot " + slot_id + ": its directory at " + slot_path(pool, slot_id) +
                           " could not be removed — a file in it is immutable or owned by someone else. " +
                           "Removing it by hand returns the slot to use.")
            continue
        views[slot_id] = _hook_view(slot_id, slot, warmth_of(ctx.std, slot_path(pool, slot_id), root).base)

    problems = []

    # The hook runs under the pool lock, so it is given `_HOOK_BUDGET_MS` in all:
    # past that, however many slots it got through, the built-in ranks every
    # one — the same answer for the same hook whatever the pool's size. A
    # single call cannot be interrupted, only not repeated.
    scores = {}
    started = time.now_ms()
    hooked = len(ctx.traits[Worktrees].score_slot) > 0
    for slot_id, view in views.items():
        scores[slot_id] = _score_slot(ctx, view, want, problems)
        spent = time.now_ms() - started
        if hooked and not problems and spent > _HOOK_BUDGET_MS:
            problems.append(("the score_slot hook took %dms for %d of %d slots, past the %dms it is given " +
                             "while every other `add` waits on the pool lock; every slot was scored by the " +
                             "built-in instead") % (spent, len(scores), len(views), _HOOK_BUDGET_MS))
        if problems:
            break
    if problems:
        scores = {slot_id: default_score(view, want) for slot_id, view in views.items()}
    best = ""
    best_score = 0
    for slot_id in views:
        if scores[slot_id] > best_score:
            best = slot_id
            best_score = scores[slot_id]

    hook_warnings = []
    for said in problems:
        _warn(ctx.std, said)
        hook_warnings.append({"code": "score_hook_failed", "message": said})

    if best:
        return struct(id = best, score = best_score, reused_from = registry["slots"][best].get("last_branch", ""), warnings = hook_warnings)

    # Before growing, look for a lease whose session no longer exists. This is
    # checked here rather than in `reconcile` because it costs a `git status`
    # per candidate, and the only moment the answer changes anything is the one
    # where the alternative is another slot on disk.
    for slot_id in registry["slots"]:
        if registry["slots"][slot_id]["state"] != LEASED:
            continue
        if registry["slots"][slot_id].get("owner_git_dir", "") != pool["git_common_dir"]:
            continue
        if not abandoned_lease(ctx.std, pool, registry, slot_id, root, _grace_ms(ctx)):
            continue
        lease = registry["slots"][slot_id].get("lease") or {}
        said = ("reclaimed the slot held by " + (lease.get("name", "") or "an earlier worktree") +
                ": its " + _holder(lease.get("agent") or {}) + " is not running and the checkout was clean")
        _info(ctx.std, said)
        reclaimed = {
            "code": "lease_reclaimed",
            "message": said,
            "branch": lease.get("name", ""),
            "previous_holder": lease.get("agent") or {},
        }

        # `mark_free` records the branch as `last_branch`, so `reused_from`
        # names the worktree whose Bazel state is actually in the slot rather
        # than whatever held it before that.
        return struct(id = slot_id, score = 0, reused_from = mark_free(registry, slot_id), warnings = hook_warnings + [reclaimed])

    # Nothing scored. Either every owned slot is leased, or a hook refused them
    # all; at the limit the second case has to give way, since the pool is a
    # disk budget and growing it forever is the one outcome worse than a cold
    # build.
    budget = ctx.traits[Worktrees].max_slots
    mine = owned_slots(pool, registry)
    vetoed = sorted(views.keys(), key = lambda sid: -default_score(views[sid], want))
    if len(mine) >= budget and vetoed:
        said = ("every free slot is refused by the score_slot hook, and this clone has %d slots " +
                "against a limit of %d; reusing the best fit of them instead of growing") % (len(mine), budget)
        _warn(ctx.std, said)
        return struct(
            id = vetoed[0],
            score = 0,
            reused_from = registry["slots"][vetoed[0]].get("last_branch", ""),
            warnings = hook_warnings + [{"code": "score_hook_refused_all", "message": said}],
        )

    warnings = hook_warnings
    if len(mine) >= budget:
        # The commands that look and hand back, not one that deletes: the reader
        # is usually an agent, and a ready-to-paste `--force` in a warning is how
        # one ends up deleting slots other sessions are relying on.
        busy = len([sid for sid in mine if registry["slots"][sid]["state"] != FREE])
        stuck = len(mine) - busy
        said = (("all %d of this clone's slots are in use" % busy) if not stuck else ("%d of this clone's %d slots are in use and %d free one%s could not be reused — it holds " % (
            busy,
            len(mine),
            stuck,
            "" if stuck == 1 else "s",
        ) + "work, or a directory that would not go, as warned above")) + (
            ", so it now has %d checkouts and output bases against an advisory limit of %d. " % (len(mine) + 1, budget) +
            "`aspect worktree list` shows who holds each; releasing those you are done with lets later adds " +
            "reuse them instead of growing, and `aspect worktree prune` then deletes free slots left idle. " +
            "`Worktrees.max_slots` in config.axl sets the limit."
        )
        _warn(ctx.std, said)
        warnings.append({"code": "pool_over_limit", "message": said, "slots": len(mine) + 1, "max_slots": budget})

    slot_id = new_slot_id(ctx.std, pool, registry)
    registry["slots"][slot_id] = new_slot_record(pool)
    return struct(id = slot_id, score = 0, reused_from = "", warnings = warnings)

def _is_branch(ctx: TaskContext, pool: dict, name: str) -> bool:
    """Whether `name` is a local branch of this clone — not merely something
    that resolves, as a remote branch, a tag or a commit does too.

    Compared by name rather than resolved: on a case-insensitive filesystem
    `rev-parse refs/heads/Demo` finds the loose ref `demo`, and checking that
    out under the other spelling puts one branch in two worktrees.
    """
    refs = _git_try(ctx, ["for-each-ref", "--format=%(refname)", "refs/heads/" + name], pool["git_common_dir"])
    return ("refs/heads/" + name) in refs.splitlines()

def _materialize(ctx: TaskContext, pool: dict, path: str, name: str, base_ref: str, detach: bool = False) -> None:
    """Put a git worktree for `name` at the slot, checked out on that branch —
    or, with `detach`, at `base_ref` with no branch at all.

    Whatever the previous occupant left is removed first, so recycling never
    has to care what state the slot was in — except work (`work_in`), which
    fails the call instead of going with it.

    The worktree is then locked with git's own lock, so `git worktree remove`
    and `git worktree prune` leave a leased slot alone and say why; `release`
    removes it past the lock.

    A new branch tracks nothing, unless it starts from the remote branch of the
    same name — then it tracks that, so a bare push goes back where the work
    came from rather than nowhere.

    A branch checkout leaves HEAD attached, and git refuses outright if the
    branch is checked out in another worktree, which is the right answer and
    better than silently detaching. Detaching is only ever asked for, and such
    a slot is named by its id, since it has no branch to be named by.

    The checkout is made with a HEAD reflog regardless of what
    `core.logAllRefUpdates` says: that reflog is how commits a detached HEAD
    left behind are found before the checkout goes, and git keeps appending to
    one that exists.
    """

    # The slot is free, so whatever is left in it is debris — unless the pool's
    # bookkeeping is wrong, which is exactly when deleting it would cost
    # somebody their work. Refused then, and the files named.
    left = _work(ctx, path)
    if left:
        fail(_shown("the free slot at " + path + " still holds " + _work_said(left) + ", so it " +
                    "was left alone:\n" + _indented(left) + "\n" + _CLEAR_BY_HAND))
    remove_checkout(ctx.std, path, pool["git_common_dir"])
    ctx.std.fs.create_dir_all(pool["dir"])
    if detach:
        _git(ctx, _WORKTREE_ADD + ["--detach", path, base_ref], pool["git_common_dir"])
    elif _is_branch(ctx, pool, name):
        _git(ctx, _WORKTREE_ADD + [path, name], pool["git_common_dir"])
    elif base_ref.endswith("/" + name) and _git_try(
        ctx,
        ["rev-parse", "--verify", "--quiet", "refs/remotes/" + base_ref],
        pool["git_common_dir"],
    ):
        # The remote's branch of the same name: tracking it is what makes a
        # bare push go back where the work came from.
        _git(ctx, _WORKTREE_ADD + ["--track", "-b", name, path, base_ref], pool["git_common_dir"])
    else:
        # `--no-track` is load-bearing. Without it a branch cut from a
        # remote-tracking ref records that ref as its upstream, and under
        # `push.default=upstream` a later bare `git push` from this worktree
        # targets the base branch — `origin/main` for the common case.
        _git(ctx, _WORKTREE_ADD + ["--no-track", "-b", name, path, base_ref], pool["git_common_dir"])

    # A guard, not a dependency: nothing in the pool reads it, and a git too
    # old to lock still gets a working slot.
    _git_try(ctx, ["worktree", "lock", "--reason", lock_reason(path.rpartition("/" + SLOT_PREFIX)[2]), path], pool["git_common_dir"])

def _checkout_failed(ctx: TaskContext, slot_id: str, path: str, err) -> TaskConclusion:
    """`git worktree add` failed, or the slot was found holding work: a
    refusal like any other, so `--output=json` gets a document to read."""
    return _refuse(
        ctx,
        "checkout_failed",
        "could not create the worktree: " + str(err),
        facts = {"slot": slot_id, "path": path},
    )

def _check_out_and_lease(
        ctx: TaskContext,
        pool: dict,
        lock: dict,
        registry: dict,
        chosen,
        name: str,
        base_ref: str,
        token: str,
        agent: dict,
        created: bool = False,
        base_label: str = "",
        detached: str = "") -> int | TaskConclusion:
    """Check a worktree out into a slot this caller has reserved, then lease it.

    `detached` is the commit-ish a `--detach` checkout is at, as the caller
    spelled it, and is recorded on the lease; "" for a branch.

    The pool lock is given back for the checkout and taken again to record the
    result, because the checkout is the whole cost of `add` on a large clone and
    holding the lock through it puts every other agent behind it. The
    reservation is what makes the gap safe: the slot and the branch are both
    claimed for `token`, so no other caller can take either, and a crash in the
    gap leaves a record the next `add` reclaims instead of a slot nothing frees.

    `registry` is re-read afterwards rather than reused. Another caller may have
    changed other slots while the lock was theirs, and writing the copy from
    before would undo that.

    If the reservation is gone by then, only a caller that judged this process
    dead could have taken it — and it is not dead. The registry is left to
    whoever owns it now rather than leasing one slot twice, and the worktree
    this call created is taken back only while it is still that worktree: the
    new holder may already have checked their own branch out at the path, and
    that is not ours to force-remove.
    """
    path = slot_path(pool, chosen.id)
    _unlock(ctx, pool, lock)
    existed = _is_branch(ctx, pool, name)
    err, _ = catch(_materialize, ctx, pool, path, name, base_ref, detached != "")

    if not _relock(ctx, pool, lock):
        # Nothing can be written safely without the lock, so the reservation
        # stands. This process is about to exit, which is what makes it
        # reclaimable: the next `add` frees the slot and checks the branch out
        # again, onto the same output base.
        if err != None:
            return _checkout_failed(ctx, chosen.id, path, err)
        return _pool_busy(ctx)

    registry = reconcile(ctx.std, pool, read_registry(ctx.std, pool["dir"]))

    if err != None:
        _drop_reservation(ctx, pool, registry, chosen.id, token)
        write_registry(ctx.std, pool["dir"], registry)

        # `git worktree add -b` can make the branch and then fail the checkout.
        # A branch this call created, still at its base and checked out
        # nowhere, is deleted, or retrying the same command says it exists.
        # Not when the branch was there before the checkout began, or git
        # refused `-b` because it had just appeared: then it is somebody else's.
        made = created and not existed and "already exists" not in str(err)
        if made and not detached and _is_branch(ctx, pool, name) and not _worktree_holding_branch(ctx, pool, name):
            tip = _git_try(ctx, ["rev-parse", "refs/heads/" + name], pool["git_common_dir"])
            if tip and tip == _git_try(ctx, ["rev-parse", base_ref + "^{commit}"], pool["git_common_dir"]):
                _git_try(ctx, ["branch", "-D", name], pool["git_common_dir"])
        return _checkout_failed(ctx, chosen.id, path, err)

    if not holds_reservation(registry, chosen.id, token):
        # Only while the checkout at the path is still the one this call put
        # there: not once another caller has leased the slot — a retry of the
        # same branch reads exactly like ours — and never with work in it.
        if detached:
            ours = (not _git_try(ctx, ["symbolic-ref", "--quiet", "HEAD"], path) and
                    _git_try(ctx, ["rev-parse", "HEAD"], path) == _git_try(ctx, ["rev-parse", base_ref + "^{commit}"], pool["git_common_dir"]))
        else:
            ours = _git_try(ctx, ["rev-parse", "--abbrev-ref", "HEAD"], path) == name
        slot_now = registry["slots"].get(chosen.id) or {}
        if ours and slot_now.get("state", "") not in [LEASED, RESERVED] and not _work(ctx, path):
            catch(run_git, ctx.std, FORCE_REMOVE + [path], pool["git_common_dir"])
        return _refuse(
            ctx,
            "reservation_lost",
            "the slot reserved for " + name + " was taken by another `aspect worktree add` while " +
            "the checkout ran — it judged this one stopped. Run the same command again.",
            retryable = True,
            facts = {"slot": chosen.id, "branch": name},
        )

    # Who took it, so `list` can name the session holding each slot rather than
    # only the branch, and so the slot's history says who has had it. Empty for
    # a person at a terminal.
    record_lease(registry, chosen.id, name, agent)
    mark_leased(registry, chosen.id, name, agent)
    lease = registry["slots"][chosen.id]["lease"]
    if detached:
        lease["detached"] = detached
    if created:
        # What the branch started from, as named and as the commit it was then:
        # `origin/main` moves on the next fetch, and a range from it would not.
        lease["base"] = base_label
        lease["base_sha"] = _git_try(ctx, ["rev-parse", base_ref + "^{commit}"], pool["git_common_dir"])
    write_registry(ctx.std, pool["dir"], registry)

    return _report_slot(ctx, pool, registry, chosen.id, name, chosen, created, base_label)

def _checked_out_branches(ctx: TaskContext, pool: dict) -> dict:
    """The branch git has in each of this clone's worktrees, by path.

    Git is the authority on what a worktree holds, and a lease records only what
    `add` was asked for. Someone who runs `git switch` inside a slot leaves the
    two disagreeing, and reporting the registry's answer would be reporting the
    stale one. Empty for a clone that is not there to ask.
    """
    if not ctx.std.fs.exists(pool["git_common_dir"]):
        return {}
    return parse_worktree_list(worktree_porcelain(ctx.std, pool["git_common_dir"]))

def _detached_name(ref: str) -> str:
    """What a detached lease is called in listings and history, as git words a
    detached HEAD. The space keeps it from ever equalling a branch name, so no
    branch lease can be refused, or resolved, on its account."""
    return "(detached at " + ref + ")"

def _is_detached_name(name: str) -> bool:
    """Whether `name` is a `_detached_name` — a label, which nothing resolves."""
    return name.startswith("(detached at ")

# Leads every task's description until the command is no longer new.
_EXPERIMENTAL = "New and experimental. File bugs and suggestions to https://github.com/aspect-build/aspect-cli/issues."

# `--create`: absent, bare (from HEAD), or `=<ref>`.
_CREATE_OFF = ""
_CREATE_FROM_HEAD = "HEAD"

# `--force` on `release` and `prune`, graded as git's `worktree remove -f` and
# `-f -f` are. On `release` bare discards uncommitted work and `all` also ends a
# lease another session holds — and discards another session's work, which bare
# never does; on `prune` bare answers the prompt and `all` also deletes a named
# slot's uncommitted work.
_FORCE_OFF = "false"
_FORCE_DIRTY = "true"
_FORCE_ALL = "all"

# What `prune` would delete, keyed by the slot id `list` shows.
_PRUNE_COLUMNS = [
    Column(key = "slot", header = "slot", always = True),
    Column(key = "why", header = "why", always = True),
    Column(key = "branch", header = "last branch", always = True),
]

# The shortest slot-id prefix that resolves, as git's abbreviations need.
_MIN_SLOT_PREFIX = 4

# How many names a refusal lists before saying how many more there are.
_NAMES_SHOWN = 8

# How a slot's registry state reads in the table. Only `add` ever shows
# `setup`, and only for as long as its checkout takes — or until the next `add`
# reclaims it, if that one was killed.
_STATE_LABELS = {LEASED: "in use", FREE: "free", RESERVED: "setup"}

# Taken slots and free slots are listed separately, because the interesting
# facts differ: a taken slot is held by somebody and the question is who, while
# a free slot is a thing you could take and the question is how warm it is and
# how long it has sat. Each table carries only the columns its kind of slot can
# fill.
#
# Both start with the slot — the row's identity, the string that shows up in
# `git worktree list` and in a path, and the same width every time — then the
# fixed-width facts, so the numbers read as a block, and the columns that vary
# in width go last where a ragged edge costs nothing.
_TAKEN_COLUMNS = [
    Column(key = "slot", header = "slot", always = True),
    # Only two values reach this table, and only one of them is unusual: a slot
    # an `aspect worktree add` is still checking out.
    Column(key = "state", header = "state", always = True),
    Column(key = "warmth", header = "warmth", always = True),
    Column(key = "age", header = "age", right = True, always = True),
    Column(key = "leases", header = "leases", right = True, always = True),
    Column(key = "branch", header = "branch", always = True),
    # Always: a pool with no agents running would otherwise never show that it
    # records which session holds a slot.
    Column(key = "agent", header = "agent", always = True),
    # Its own column rather than part of `agent`, so the ids line up under one
    # another and a glance down the page can tell two sessions apart.
    Column(key = "session", header = "session"),
    Column(key = "notes", header = "notes"),
]

_FREE_COLUMNS = [
    Column(key = "slot", header = "slot", always = True),
    Column(key = "warmth", header = "warmth", always = True),
    # What the table is ordered by, since the slot just used is the one a
    # reader is looking for; and what `prune` acts on, so a reader deciding
    # whether to run it sees the number the decision uses.
    Column(key = "idle", header = "last used", right = True, always = True),
    Column(key = "age", header = "age", right = True, always = True),
    Column(key = "leases", header = "leases", right = True, always = True),
    # Headed for what it is. A free slot has no worktree, so the branch is
    # history — which the header says once rather than a `last ` prefix saying
    # it again on every row.
    Column(key = "branch", header = "last branch", always = True),
    Column(key = "notes", header = "notes"),
]

# A slot's holders: what each lease was first, then who held it. How to get
# back into a session is the sessions section's, said once per session.
_HISTORY_COLUMNS = [
    Column(key = "branch", header = "branch", always = True),
    Column(key = "held", header = "held", always = True),
    # `status` rather than `ended`, which would contradict `still holding it`.
    Column(key = "status", header = "status", always = True),
    Column(key = "agent", header = "agent", always = True),
    Column(key = "session", header = "session"),
    # The directory the harness filed the session under. Drops out when no
    # holder could be placed, the way any empty column does.
    Column(key = "project", header = "project"),
]

# A session's leases. `repo` because a session can take slots in more than one
# pool, and `--all` lists them together; `slot` to find the lease's block above.
_SESSION_LEASE_COLUMNS = [
    Column(key = "repo", header = "repo", always = True),
    Column(key = "slot", header = "slot", always = True),
    Column(key = "branch", header = "branch", always = True),
    Column(key = "agent", header = "subagent"),
    Column(key = "held", header = "held", always = True),
    Column(key = "status", header = "status", always = True),
]

def _resume_command(std, agent: dict) -> str:
    """The harness's own command for returning to `agent`'s session, or "".

    Withheld only where the harness's own store was read and did not have this
    session, since the command would then resolve nothing. Anything less
    certain still gets one: a harness whose store is not described, Codex among
    them, reports `unknown`, and its sessions resume perfectly well.

    Liveness is deliberately not consulted: a live process can hold an id no
    store has heard of.
    """
    if session_filed(std, agent) == ABSENT:
        return ""
    return resume_hint(agent)

def _resume_line(std, agent: dict, home: str = "") -> str:
    """`_resume_command` with the session's project in front, or "".

    For the places where the command is the thing being acted on rather than
    one fact among several. The `cd` is for the harnesses that resolve a session
    within the current directory's project, `claude --resume` among them; it is
    harmless for the rest, and spares a reader having to know which is which.

    Its path is abbreviated like every other path these commands print, which a
    shell expands, so the line is still one to paste.

    Not used where the id is already on the row — the prefix doubles the length
    of a line that a reader can act on without it.
    """
    resume = _resume_command(std, agent)
    if not resume:
        return ""
    project = session_project(std, agent)
    return ("cd " + shell_quote(tilde(project, home)) + " && " + resume) if project else resume

def _duration_cell(ms: int) -> str:
    """A duration for a table cell: `<1m` rather than `0m`, which reads as
    nothing next to "ended under a minute ago"."""
    return "<1m" if ms < 60000 else compact_ms(ms)

def _lease_status(entry: dict) -> str:
    """Whether a history entry's holder still has the slot, or when it let go."""
    released = entry.get("released_ms", 0)
    if not released:
        return "still holding it"
    return "ended %s ago" % phrase_ms(time.now_ms() - released)

def _history_rows(std, history: list, home: str = "", holder: dict = {}) -> list[dict]:
    """A slot's holders newest first, as cells for the table renderer.

    Newest first because the recent past is what bears on a build happening
    now; the oldest entry has usually aged out of the slot's memory anyway.

    Anything the harness does not say reads `-` rather than empty, because a
    reader needs to know the answer is unavailable.

    `holder` is the slot's live lease. A history entry keeps only what is worth
    remembering about a finished holder, so the entry still open is placed from
    the lease instead — the same holder, with everything detection gathered —
    when the two name the same session.
    """
    rows = []
    for entry in reversed(history):
        agent = entry.get("agent") or {}
        placed = agent
        if not entry.get("released_ms", 0) and holder and holder.get("id", "") == agent.get("id", ""):
            placed = holder
        rows.append({
            "branch": entry.get("name", "?"),
            "held": _duration_cell(held_for_ms(entry)),
            "status": _lease_status(entry),
            "agent": agent.get("kind", "") or ("agent" if agent else "-"),
            "session": session_id(agent) or "-",
            "project": tilde(session_project(std, placed), home) if agent else "",
        })

    # `-` on a row only means something next to rows that have a project.
    if [r for r in rows if r["project"]]:
        for r in rows:
            r["project"] = r["project"] or "-"
    return rows

def _session_groups(std, listings: list, home: str = "", me: dict | None = None) -> list:
    """Every session the listed leases name, each with the way back into it and
    the leases it took, most recently active first.

    A session's leases are listed active first, then released, each newest
    first: what it holds now and what it has let go of answer different
    questions, and interleaving them by start time mixes the two.

    Grouped by session rather than said per lease because most leases come from
    subagents, and a subagent runs in its parent's process with its parent's
    environment — it reports the parent's session id, and the parent is the
    conversation that can be resumed. Per lease, that is one command repeated
    down a column; per session it is said once.

    A session's facts come from every record of it the listing holds. A history
    entry keeps only what is worth remembering about a finished holder, while
    the live lease of a slot still held carries everything detection gathered,
    so the two are merged field by field, first answer wins.

    A holder with no session id — a person, or a harness that marks its presence
    without naming a conversation — has no session to list.
    """
    groups = {}
    for pool, rows in listings:
        for r in rows:
            live = r["agent"] or {}
            for entry in r["history"] or []:
                agent = entry.get("agent") or {}
                id = session_id(agent)
                if not id:
                    continue
                key = agent.get("kind", "") + "/" + id
                if key not in groups:
                    groups[key] = {"agent": {}, "leases": [], "latest": 0}
                g = groups[key]
                records = [live, agent] if session_id(live) == id else [agent]
                for record in records:
                    for field, value in record.items():
                        if value and not g["agent"].get(field):
                            g["agent"][field] = value
                at = entry.get("leased_ms", 0)
                released = entry.get("released_ms", 0)
                g["leases"].append({
                    "repo": pool["id"],
                    "slot": r["slot"],
                    "path": r["path"],
                    "branch": entry.get("name", "?"),
                    # The id a subagent was given, under the session it ran in.
                    "agent": agent.get("id", "") if agent.get("parent_id", "") else "",
                    "active": not released,
                    "held": _duration_cell(held_for_ms(entry)),
                    "held_ms": held_for_ms(entry),
                    "ended_ms": released,
                    "status": _lease_status(entry),
                    # Active before released; within each, the newest first.
                    "order": (1, -released) if released else (0, -at),
                })
                if at > g["latest"]:
                    g["latest"] = at

    me = detect(std, "", "") if me == None else me
    out = []
    for g in sorted(groups.values(), key = lambda g: -g["latest"]):
        agent = g["agent"]
        out.append(struct(
            kind = agent.get("kind", ""),
            id = session_id(agent),
            current = bool(me) and me.get("kind", "") == agent.get("kind", "") and session_id(me) == session_id(agent),
            resume = _resume_command(std, agent),
            project = tilde(session_project(std, agent), home),
            leases = sorted(g["leases"], key = lambda lease: lease["order"]),
        ))
    return out

def _render_sessions(groups: list, std = None) -> list[str]:
    """The sessions section: per session, its harness, its project, the command
    that returns to it, and its leases. Ready to print as they are: escaped,
    and styled when `std` is given and color is on — each block headed in bold,
    its labels and column headers dimmed, a blank line between blocks.

    `-` where a fact is unavailable: a harness whose resume syntax is not known,
    a session its own store was read and found not to have, a project the store
    cannot place. A command that resolves nothing is worse than none.
    """
    out = []
    for g in groups:
        if out:
            out.append("")
        out.append(_styled(std, "  session " + g.id, ansi.BOLD))
        out.append(_field(std, "    ", "agent:   ", g.kind or "-"))
        out.append(_field(std, "    ", "project: ", g.project or "-"))
        out.append(_field(std, "    ", "resume:  ", g.resume or "-"))
        out.append(_field(std, "    ", "leases:", ""))
        out += _table(std, g.leases, _SESSION_LEASE_COLUMNS, "    ")
    return out

def _history_note(slot: dict) -> str:
    """How old this slot is and how much use it had before this lease.

    Plain counting, because the pool's whole claim is that a slot gets used
    again: a slot being reused for the seventh time is that claim holding, and a
    pool where every slot reads "new" is one that grew instead of turning over.

    `lease_count` already includes the lease being handed over, so prior use is
    one less — otherwise a slot created a moment ago would report having been
    leased before.

    A slot with no count at all is one nothing here wrote — a registry edited by
    hand, say. Say what little is known rather than reporting zero reuse, which
    would read as a fact.
    """
    if slot.get("lease_count") == None:
        if slot.get("last_branch", ""):
            return "reused slot, last holding " + slot["last_branch"] + "; its use is not recorded"
        return "this slot keeps no record of its use"

    prior = slot["lease_count"] - 1
    if prior <= 0:
        return "new slot: this is the first worktree it has held"

    # "used", not "reused": the slot's first worktree was a use, and calling it
    # a reuse makes a slot on its second lease sound like one on its third.
    times = "once" if prior == 1 else ("twice" if prior == 2 else "%d times" % prior)
    return "created %s ago, used %s before this" % (phrase_ms(slot_age_ms(slot)), times)

def _base_note(present: bool, had_base: bool) -> str:
    """What to say about an output base that is not on disk.

    "Missing" claims something was lost, which is wrong for the common case: a
    slot nobody has built in yet never had a base, and the path printed beside
    this is where one *would* go. A base once seen and now gone is the case
    actually worth reporting — `aspect gc` collected it, or a
    `bazel clean --expunge` did — and `had_base` is what separates the two.
    """
    if present:
        return ""
    return "  (reclaimed)" if had_base else "  (not created yet)"

def _slot_detail(std, r: dict, home: str) -> None:
    """One slot in full: where it is, what Bazel state it has, and who has had
    it. What `--verbose` prints per slot, and what `inspect` prints for one.

    Headed by the slot, which is what the tables above are keyed on and so what
    a reader matches a block back to. The branch is a line inside the block,
    labelled `last branch` for a free slot exactly as the free table heads that
    column — a free slot's branch is history, and the label is where to say so.

    How to get back into a holder's session is not here: it belongs to the
    session, and the sessions section says it once for every lease it took.

    The heading is bold and the labels and column headers dimmed when color is
    on; the caller separates one block from the next.
    """
    _print_styled(std, "  " + r["slot"], ansi.BOLD)
    if r["state"] == FREE:
        print(_field(std, "    ", "last branch: ", r["last_branch"] or "-"))
    else:
        print(_field(std, "    ", "branch:      ", r["branch"] or r["name"] or r["reserved_for"] or "-"))
    print(_field(std, "    ", "path:        ", tilde(r["path"], home)))
    print(_field(std, "    ", "output base: ", tilde(r["output_base"], home) +
                                               _base_note(r["output_base_present"], r["had_base"])))
    if r["server_pid"]:
        print(_field(std, "    ", "server:      ", "pid %d" % r["server_pid"]))

    # A slot keeps only its last holders, so a count larger than the rows
    # below is said rather than left to look like rows went missing.
    kept = len(r["history"] or [])
    shown = (", the last %d shown" % kept) if kept and (r["lease_count"] or 0) > kept else ""
    print(_field(std, "    ", "leases:      ", "%s, slot created %s ago%s" % (
        _unit(str, r["lease_count"]),
        _unit(compact_ms, r["age_ms"]),
        shown,
    )))

    # A header with no rows under it is not a table, so a slot whose history
    # the registry does not carry says nothing instead.
    holders = _history_rows(std, r["history"], home, r["agent"] or {})
    if holders:
        for line in _table(std, holders, _HISTORY_COLUMNS, "    "):
            print(line)

def _unit(fmt, value) -> str:
    """`value` formatted, or a dash where the registry does not say.

    A zero is an answer and "not recorded" is not, so the two cannot share a
    rendering: a slot nothing has built in is idle for zero milliseconds, while
    a slot whose record does not carry the field says nothing at all.
    """
    return fmt(value) if value != None else "-"

def _list_order(row: dict) -> tuple:
    """How slots sort: in use first, warmest first; then the free slots, most
    recently used first; then by slot for stability.

    Registry order is the order slots were created in, which tells a reader
    nothing. What is happening now belongs at the top, and among the free
    slots, the one just given back — which is the one a reader is looking for.
    A slot whose record cannot say goes last.
    """
    state = 0 if row["state"] == LEASED else (1 if row["state"] == RESERVED else 2)
    if state == 2:
        used = row.get("idle_ms")
        return (state, 0 if used != None else 1, used if used != None else 0, row["slot"])
    warmth = 0 if row["server_pid"] else (1 if row["output_base_present"] else 2)
    return (state, 0, warmth, row["slot"])

def _warmth_note(std, path: str, reused_from: str, root: str, had_base: bool = False) -> str:
    """One line on what this slot already holds, checked rather than assumed.

    A slot's value is its Bazel state, and that state can be gone — the server
    exits on idle, and `aspect gc` can reclaim the base — so claiming "warm"
    without looking would be a lie often enough to matter.

    `had_base` separates the two ways of being cold, and is recorded rather
    than inferred: a slot nobody has built in has no state *yet*, while one
    whose base was seen and is now gone had its state taken. A lease count
    cannot tell those apart — a slot leased twice without a build never had a
    base — and the difference is worth telling someone whose next build is
    about to cost full price.
    """
    warmth = warmth_of(std, path, root)

    # The branch that held the slot last, which is as much as the pool knows:
    # nothing records which build populated a cache, and a brief lease that
    # built nothing is still the last holder. "Leased", not "used", so it is
    # not read as the source of the warmth.
    last = (", last leased for " + reused_from) if reused_from else ""
    if warmth.server:
        return ("hot: a Bazel server is still holding this slot's analysis cache (pid %d)" %
                warmth.server) + last
    if warmth.base:
        return "warm: no server, but this slot's Bazel output base is still here" + last
    if had_base:
        return ("cold: this slot's Bazel output base is gone, so the first build pays for it " +
                "again" + last)
    return "cold: this slot has no Bazel state yet, so the first build pays for it"

def _report_slot(
        ctx: TaskContext,
        pool: dict,
        registry: dict,
        slot_id: str,
        name: str,
        chosen,
        created: bool = False,
        base: str = "") -> int:
    """Announce a slot the caller now holds, in whichever form it asked for.

    Shared by a fresh lease and a taken-over one, which have to agree on
    `--output=path` and the JSON document or a caller cannot treat them the
    same. `--output=path` still writes the text report, to stderr where
    `$(...)` leaves it on the terminal, so the one-liner that enters a slot
    keeps the hints; only the ways to enter it are left out, since that is what
    the caller is already doing.

    `created` is whether `name` was made by this call, and `base` what it was
    made from as the caller would recognise it, for the text; the JSON reports
    the lease's own record, which a take-over carries. A created branch has no
    upstream, deliberately — unless it starts from the remote branch of its own
    name — and the report says so, with the ways to set one, before a push
    finds out; so does it for an existing branch that tracks nothing.
    """
    root = _output_root(ctx)
    path = slot_path(pool, slot_id)
    warmth = warmth_of(ctx.std, path, root)
    head = _git_try(ctx, ["rev-parse", "HEAD"], path)
    upstream = _git_try(ctx, ["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"], path)
    warnings = list(chosen.warnings)
    detached = (registry["slots"][slot_id].get("lease") or {}).get("detached", "")

    # A branch that tracks one of a different name is the trap `--no-track`
    # keeps a created branch out of: a bare `git push` can land on the other.
    if upstream and upstream.partition("/")[2] != name:
        said = (name + " tracks " + upstream + ", so a bare `git push` from this worktree can go " +
                "there rather than to a branch of its own name; `" + (_push_command(ctx, pool, name) or
                                                                      ("git push -u <remote> " + shell_quote(name))) + "` points it at its own")
        warnings.append({"code": "upstream_elsewhere", "message": said, "upstream": upstream})
        if ctx.args.output != "json":
            _warn(ctx.std, said)
    if ctx.args.output == "path":
        ctx.std.io.stdout.write(path + "\n")
    if ctx.args.output == "json":
        lease = registry["slots"][slot_id].get("lease") or {}
        slot = registry["slots"][slot_id]
        ctx.std.io.stdout.write(json.encode({
            "schema_version": _SCHEMA_VERSION,
            "path": path,
            "slot": slot_id,
            # "" for a `--detach` checkout, which `detached` names instead.
            "branch": "" if detached else name,
            "detached": detached,
            "created": created,
            # What a created branch started from, as named and as the commit it
            # was; "" for one that existed.
            "base": (registry["slots"][slot_id].get("lease") or {}).get("base", ""),
            "base_sha": (registry["slots"][slot_id].get("lease") or {}).get("base_sha", ""),
            "head": head,
            # "" when the branch tracks nothing, which is how `add` creates one.
            "upstream": upstream,
            "pool": pool["id"],
            # How much of the slot's Bazel state fits: 100 for an identical
            # tree, 0 for none. `reused_from` is the branch it last held.
            "score": chosen.score,
            "reused_from": chosen.reused_from,
            "agent": lease.get("agent") or {},
            "server_pid": warmth.server,
            "output_base_present": warmth.base,
            "lease_count": slot.get("lease_count", 0),
            "created_days": slot_created_days(slot),
            "output_base": output_base_of(ctx.std, path, root),
            "warnings": warnings,
        }, indent = 2) + "\n")
        return 0

    # Abbreviated as `list` abbreviates, so the two commands do not describe one
    # directory two ways. The machine-readable outputs above carry it in full.
    _info_shown(ctx.std, _shown("worktree ready: ") + _styled(ctx.std, tilde(path, ctx.std.env.home_dir()), ansi.BOLD))
    if detached:
        _print("  detached at %s (%s), on no branch: commits made here need one before release — git switch -c <branch>" % (detached, _short(head)))
    elif created:
        _print("  branch: %s, created from %s (%s)" % (name, base, _short(head)))

        _upstream_report(ctx, pool, name, upstream, base, True)
    else:
        _print("  branch: %s at %s" % (name, _short(head)))
        _upstream_report(ctx, pool, name, upstream, "", False)
    _print("  " + _warmth_note(
        ctx.std,
        path,
        chosen.reused_from,
        root,
        had_base = registry["slots"][slot_id].get("had_base", False),
    ))
    taken = [w for w in chosen.warnings if w.get("code", "") == "taken_over"]
    _print("  " + ("taken over: the same checkout and Bazel state it already had" if taken else _history_note(registry["slots"][slot_id])))
    handle = shell_quote(slot_id if detached else name) + _id_flag(ctx)
    entering = [] if ctx.args.output == "path" else [
        "",
        "  # enter it",
        "  slot=$(aspect worktree path " + handle + ") && cd \"$slot\"",
        "",
        "  # or add and enter in one step: --output=path prints only the directory",
        "  slot=$(aspect worktree add <branch> --create" + _id_flag(ctx) + " --output=path) && cd \"$slot\"",
    ]
    for line in entering + [
        "",
        "  # when done, release it: from inside the slot",
        "  aspect worktree release" + _id_flag(ctx),
        "  # or from the clone, or anywhere in it",
        "  aspect worktree release " + handle,
    ]:
        # The comments dimmed, so the commands are what stands out.
        _print_styled(ctx.std, line, ansi.DIM if line.startswith("  #") else "")
    return 0

def _upstream_report(ctx: TaskContext, pool: dict, name: str, upstream: str, base: str, created: bool) -> None:
    """The `upstream:` lines of `add`'s report, and the ways to set one.

    Said up front, because the first push is otherwise where a missing upstream
    shows: as "no upstream branch", which is no hint of what to do. The ways to
    set one, run in the slot: the first push, which tracks the branch of the
    same name it makes, or tracking a branch that exists — for a created
    branch, the one it started from, or that one's own upstream. `created`
    marks the lack as deliberate, which it is only for a branch `add` made.
    """
    if upstream:
        _print("  upstream: " + upstream)
        return
    push = _push_command(ctx, pool, name)
    if push:
        _print("  upstream: none" + (", deliberately" if created else "") + ". To set one, in the slot:")
        print(_command_line(ctx.std, "    ", push, "make " + name + " on the remote and track it"))
    else:
        _print("  upstream: none — this clone has no remote to push to. To track a branch, in the slot:")
    track = base if base and _trackable(ctx, pool, base) else "<branch>"
    print(_command_line(
        ctx.std,
        "    ",
        "git branch --set-upstream-to=" + (shell_quote(track) if track != "<branch>" else track),
        "track " + (track if track != "<branch>" else "an existing branch"),
    ))

    # A local branch it started from may track a remote one of its own:
    # following that instead brings in what others push, with a fetch.
    further = _git_try(ctx, ["rev-parse", "--abbrev-ref", "--symbolic-full-name", track + "@{upstream}"], pool["git_common_dir"]) if track != "<branch>" else ""
    if further and further != track:
        print(_command_line(ctx.std, "    ", "git branch --set-upstream-to=" + shell_quote(further), "track " + track + "'s upstream"))
    elif track != "<branch>" and _is_branch(ctx, pool, track):
        _print_styled(ctx.std, "    (" + track + " has no upstream of its own)", ansi.DIM)

def _trackable(ctx: TaskContext, pool: dict, ref: str) -> bool:
    """Whether `git branch --set-upstream-to=<ref>` would take `ref`: a local
    branch or a remote-tracking one, as written. A tag, a commit or an
    expression like `main~0` resolves, and git refuses to track it."""
    if _is_branch(ctx, pool, ref):
        return True
    refs = _git_try(ctx, ["for-each-ref", "--format=%(refname)", "refs/remotes/" + ref], pool["git_common_dir"])
    return ("refs/remotes/" + ref) in refs.splitlines()

def _newer_registry(ctx: TaskContext, pool: dict) -> TaskConclusion:
    """A pool whose registry a newer aspect CLI wrote, which this one would
    rewrite without what it does not understand."""
    return _refuse(
        ctx,
        "registry_newer",
        "the worktree registry at " + pool["dir"] + " was written by a newer aspect CLI — its version is not one this CLI knows. Run this " +
        "command with that version, or upgrade; reading commands — `list`, `path`, `inspect`, `prune --dry-run` — " +
        "still work here.",
        facts = {"pool": pool["dir"]},
    )

def _grace_left_ms(ctx: TaskContext, pool: dict, registry: dict, slot_id: str, root: str) -> int:
    """How much of `Worktrees.abandoned_grace_hours` a leased slot has left,
    counted from its last activity; 0 once it is over."""
    left = _grace_ms(ctx) - (time.now_ms() - lease_last_active_ms(ctx.std, pool, slot_id, registry["slots"][slot_id], root))
    return left if left > 0 else 0

def _grace_ms(ctx: TaskContext) -> int:
    """`Worktrees.abandoned_grace_hours` in ms: how long a stopped session's
    slot is kept for it before automatic take-back."""
    return ctx.traits[Worktrees].abandoned_grace_hours * 3600 * 1000

def _adopted(ctx: TaskContext, pool: dict, taken: list | None = None) -> dict:
    """The registry with slots of a clone gone from its path adopted by this
    one (`adopt_stranded`), written if any were, then reconciled. For a
    command that holds the pool lock. A registry a newer CLI wrote is returned
    as read, `read_only`, for the caller to refuse. The ids adopted are added
    to `taken`, for a caller that reports them."""
    registry = read_registry(ctx.std, pool["dir"])
    if registry.get("read_only", False):
        return registry
    adopted = adopt_stranded(ctx.std, pool, registry)
    if adopted:
        write_registry(ctx.std, pool["dir"], registry)
    if taken != None:
        taken.extend(adopted)
    return reconcile(ctx.std, pool, registry)

def _adoption_preview(ctx: TaskContext, pool: dict, taken: list | None = None) -> dict:
    """The registry as `_adopted` would leave it, without the lock, without
    changing git and without a write: what a dry run reports on, so that it
    predicts the real run — short of a lease whose `git worktree repair` would
    fail, which the real run leaves where it is. The ids it would adopt are
    added to `taken`."""
    registry = read_registry(ctx.std, pool["dir"])
    if not registry.get("read_only", False):
        adopted = adopt_stranded(ctx.std, pool, registry, repair = False)
        if taken != None:
            taken.extend(adopted)
    return reconcile(ctx.std, pool, registry)

def _settle(ctx: TaskContext, pool: dict, root: str) -> dict:
    """The registry, brought in line with git and tidied, for an `add` holding
    the pool lock: vanished checkouts unregistered, each slot's output base
    observed for `had_base`, stale slots aged out, and
    slots whose `add` was killed mid-checkout recovered — those are
    unallocatable and still hold their branch in git. Steps that delete
    something write the registry at once; the rest is written with the lease
    that follows, or not at all — it is bookkeeping the next `add` observes
    again."""
    registry = _adopted(ctx, pool)
    if registry.get("read_only", False):
        return registry
    unregister_vanished(ctx.std, pool, registry)
    for slot_id in registry["slots"]:
        observe_base(registry, slot_id, warmth_of(ctx.std, slot_path(pool, slot_id), root).base)
    if _age_out(ctx, pool, registry, root):
        write_registry(ctx.std, pool["dir"], registry)
    if _reclaim_reservations(ctx, pool, registry):
        write_registry(ctx.std, pool["dir"], registry)
    return registry

def _allocate(
        ctx: TaskContext,
        pool: dict,
        lock: dict,
        registry: dict,
        want: dict,
        root: str,
        base_ref: str,
        created: bool = False,
        base_label: str = "",
        detached: str = "",
        notes: list | None = None) -> int | TaskConclusion:
    """Pick the slot that best fits `want`, reserve it under `want["name"]`,
    and check the worktree out into it — the end every `add` shares. `notes`
    are warnings from before the pick, reported with its own."""
    name = want["name"]
    agent = _me(ctx)
    chosen = _pick_slot(ctx, pool, registry, want, root)
    if notes:
        chosen = struct(id = chosen.id, score = chosen.score, reused_from = chosen.reused_from, warnings = notes + chosen.warnings)
    token = reserve_slot(ctx.std, registry, chosen.id, name, agent)
    write_registry(ctx.std, pool["dir"], registry)
    return _check_out_and_lease(ctx, pool, lock, registry, chosen, name, base_ref, token, agent, created, base_label, detached)

_KIND_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_."
_MAX_KIND = 64
_MAX_AGENT_ID = 128

def _invalid_agent(ctx: TaskContext) -> TaskConclusion | None:
    """The refusal for an agent kind or id that is not usable, or None.

    Asked by every command that names the caller, not only `add`: a kind is
    half of who holds a lease, so one `add` would refuse must not quietly make
    `release` take the caller for somebody else. ASCII only, starting with a
    letter or digit, so that a kind reads the same in every message and log.

    An id the caller gives may be anything visible, up to `_MAX_AGENT_ID`
    characters: it is printed in tables, messages and suggested commands,
    where a control character, a bidirectional override or a zero-width one
    would rewrite what the reader sees (`has_unsafe_chars`), and one of only
    spaces would read as no id at all.
    """
    given = getattr(ctx.args, "agent_id", "") or ctx.std.env.var("ASPECT_AGENT_ID") or ""
    if given and (len(given) > _MAX_AGENT_ID or has_unsafe_chars(given) or not given.strip()):
        return _refuse(
            ctx,
            "invalid_agent",
            "the agent id \"%s\" is not one: visible characters only, not all spaces, at most %d of them" % (
                printable(given),
                _MAX_AGENT_ID,
            ),
            facts = {"agent_id": given},
        )
    kind = getattr(ctx.args, "agent_kind", "") or ctx.std.env.var("ASPECT_AGENT_KIND") or ""
    if not kind:
        return None
    if (len(kind) <= _MAX_KIND and all([ch in _KIND_CHARS for ch in kind.elems()]) and
        kind[0] not in "-_."):
        return None
    return _refuse(
        ctx,
        "invalid_agent",
        ("the agent kind \"%s\" is not a name: ASCII letters, digits, `-`, `_` and `.`, starting with a letter or " +
         "digit, at most %d characters, such as `claude-code` or `codex`") % (printable(kind), _MAX_KIND),
        facts = {"agent_kind": kind},
    )

def _add_impl(ctx: TaskContext) -> int | TaskConclusion:
    """Take a slot from the pool and check `name` out in it.

    The order below is the design, and it follows one rule: everything that can
    refuse the request is asked before anything is destroyed. Allocation
    force-removes whatever a slot's previous occupant left, so a refusal
    arriving after that point has already cost somebody their checkout. Git
    would still catch the worst case — a branch cannot be in two worktrees at
    once — but only from inside `_materialize`, by which time a slot has been
    picked and emptied. So the pool answers first, and gets to give the better
    message besides.

    Two supporting habits. Reads happen before the lock is taken, because the
    lock serializes the registry rather than the questions leading up to it. And
    each step that mutates the registry writes it before any later step can
    return early: pruning deletes directories and output bases, and a registry
    still listing them would hand the next caller a slot whose recorded state is
    gone.
    """
    name = ctx.args.branch[0].removeprefix("refs/heads/")
    cwd = ctx.std.env.current_dir()
    bad = _invalid_agent(ctx)
    if bad:
        return bad
    if ctx.traits[Worktrees].max_slots < 1:
        return _refuse(
            ctx,
            "invalid_config",
            "Worktrees.max_slots is %d; it takes 1 or more." % ctx.traits[Worktrees].max_slots,
            facts = {"setting": "Worktrees.max_slots", "value": ctx.traits[Worktrees].max_slots},
        )
    if ctx.traits[Worktrees].abandoned_grace_hours < 0:
        # Refused rather than read as 0: a stray minus would otherwise turn off
        # the one protection a stopped session's slot has.
        return _refuse(
            ctx,
            "invalid_config",
            "Worktrees.abandoned_grace_hours is %d; it takes 0 or more hours, 0 taking a stopped session's " % (
                ctx.traits[Worktrees].abandoned_grace_hours
            ) + "clean slot back at once.",
            facts = {"setting": "Worktrees.abandoned_grace_hours", "value": ctx.traits[Worktrees].abandoned_grace_hours},
        )
    pool = _pool(ctx)
    if not pool:
        return _not_a_repository(ctx)
    if ctx.args.detach:
        return _add_detached(ctx, pool, name)

    # Before the lock, a slot, or git: these are answerable from the name and a
    # ref lookup, and a refusal here carries a token where git's error would not.
    if not name.strip():
        return _bad_branch_name(ctx, name, "it is empty")
    if name.upper() in _RESERVED_BRANCHES:
        return _bad_branch_name(ctx, name, "git reserves it, and a branch by that name makes " +
                                           "every later reference to it ambiguous. For the " +
                                           "commit it names: `aspect worktree add " + name +
                                           " --detach`, or `aspect worktree add <new-branch> " +
                                           "--create=" + name + "`")
    if not run_git(ctx.std, ["check-ref-format", "--branch", name], pool["git_common_dir"]).ok:
        return _bad_branch_name(ctx, name, "git rejects it — see `git help check-ref-format`")
    if [part for part in name.split("/") if _utf8_len(part) > _MAX_REF_COMPONENT]:
        return _bad_branch_name(ctx, name, ("a part of it is longer than %d bytes: git stores each branch as a " +
                                            "file, named for that part plus `.lock` while it writes") % _MAX_REF_COMPONENT)

    root = _output_root(ctx)
    early = read_registry(ctx.std, pool["dir"])
    if ctx.args.create != _CREATE_OFF:
        why = _new_branch_problem(ctx, pool, early, name)
        if why:
            return _bad_branch_name(ctx, name, why)

    # Another `add` checking this name out right now: said before the branch is
    # looked up, since a `--create` in flight may not have made it yet and the
    # answer would be `no_such_branch`. Read without the lock, and asked again
    # under it below.
    pending = reserving_slot(early, name, pool["git_common_dir"])
    if pending and not reservation_abandoned(ctx.std, early, pending):
        return _branch_pending(ctx, pool, pending, name)

    # `--create` racing another `add --create` of the same name, run again
    # after losing its output, or after being killed part way: the branch
    # exists because the pool holds it or was making it, and who holds it —
    # answered below — is more use than `branch_exists`.
    if (ctx.args.create != _CREATE_OFF and _is_branch(ctx, pool, name) and
        (pending or _leased_holding(ctx, pool, early, name))):
        plan = struct(existing = True, base_ref = name, base_label = "")
    else:
        plan = _branch_plan(ctx, pool, name, cwd)
    if type(plan) != "struct":
        return plan
    existing = plan.existing
    base_ref = plan.base_ref
    base_label = plan.base_label

    # Score against the tree the slot will hold, not the caller's own: an
    # existing branch is checked out as itself, so reading the working tree
    # here would mislabel it.
    checkout_ref = ("refs/heads/" + name) if existing else base_ref
    want = {
        "name": name,
        "lock_digest": lock_digest_at(ctx.std, pool["git_common_dir"], checkout_ref),
        "commit": _git(ctx, ["rev-parse", checkout_ref + "^{commit}"], pool["git_common_dir"]),
    }

    lock = _lock_pool(ctx, pool)
    if not lock:
        return _pool_busy(ctx)
    registry = _settle(ctx, pool, root)
    if registry.get("read_only", False):
        return _newer_registry(ctx, pool)

    # A branch another `add` is still checking out is taken, even though no
    # lease records it yet.
    pending = reserving_slot(registry, name, pool["git_common_dir"])
    if pending:
        return _branch_pending(ctx, pool, pending, name)

    # The pool's own leases are tested before git's, so the caller gets the
    # better message for the common case.
    held = _leased_holding(ctx, pool, registry, name)

    # Asking for a branch whose own lease is abandoned is an agent restarting
    # the task it died in. Hand the slot back instead of refusing: the tree is
    # clean, so there is nothing to protect, and the warm base is exactly what
    # the caller wants. Whether that session could still be resumed does not
    # come into it — this caller asked for the branch it held.
    if held and _unlisted_lease(ctx, pool, registry, held):
        return _not_this_clones(ctx, pool, registry, held)
    notes = []
    if held and abandoned_lease(ctx.std, pool, registry, held, root, _grace_ms(ctx)):
        previous = (registry["slots"][held].get("lease") or {}).get("agent") or {}
        said = ("taking back " + name + "'s slot from " + _holder(previous) +
                ": the process that held it is not running and the checkout was clean")
        _info(ctx.std, said)

        # In the document too, as the reclaim `_pick_slot` makes is: a caller
        # reading JSON is told the lease it now holds was somebody else's.
        notes.append({"code": "lease_reclaimed", "message": said, "branch": name, "previous_holder": previous})
        free_slot(ctx.std, pool, registry, held)
        write_registry(ctx.std, pool["dir"], registry)
        held = ""

    # Taking over inherits a checkout, so it needs one: a lease whose directory
    # was removed behind git's back is freed for ordinary allocation instead,
    # rather than reporting a path the caller cannot enter.
    if held and ctx.args.take_over:
        holder = (registry["slots"][held].get("lease") or {}).get("agent") or {}
        me = _me(ctx)
        if _sibling(me, holder):
            return _refuse(
                ctx,
                "branch_in_use",
                _held_by(ctx, pool, registry, held, name, me, root),
                facts = {"slot": held, "branch": name, "agent": holder, "same_session": True},
            )
        if is_directory(ctx.std, slot_path(pool, held)) and ctx.std.fs.exists(slot_path(pool, held) + "/.git"):
            took = _take_over(ctx, pool, registry, held, name, root)
            write_registry(ctx.std, pool["dir"], registry)
            return _report_slot(ctx, pool, registry, held, name, struct(score = 0, reused_from = name, warnings = [took]))
        gone = _work(ctx, slot_path(pool, held), root)
        if gone:
            return _refuse(
                ctx,
                "worktree_dirty",
                name + "'s slot, at " + slot_path(pool, held) + ", holds " + _work_said(gone) + ":\n" +
                _indented(gone) + "\n" + (
                    "If it was moved, `git worktree repair <its new path>` from the clone brings it back; " if gone[0].startswith(VANISHED_CHECKOUT) else ""
                ) + "discarding it is the user's decision: `aspect worktree release " + shell_quote(name) + _id_flag(ctx) + " --" + (
                    "force" if _release_grade(_me(ctx), holder).needed == _FORCE_DIRTY and not gone[0].startswith(UNREADABLE_CHECKOUT) else "force=all"
                ) + "`.",
                facts = {"slot": held, "path": slot_path(pool, held), "uncommitted": _porcelain_entries(gone)},
            )
        free_slot(ctx.std, pool, registry, held)
        write_registry(ctx.std, pool["dir"], registry)
        held = ""

    if held:
        mine = _me(ctx)
        registry = _follow_session(ctx, pool, registry, True)
        holder = (registry["slots"][held].get("lease") or {}).get("agent") or {}
        facts = {
            "slot": held,
            "branch": name,
            "agent": holder,
            "process": _process_state(ctx, holder),
            "session_state": session_state(ctx.std, holder) if holder else "",
            "same_session": _same_harness_session(mine, holder),
            # How long a stopped holder's slot is still kept for it, as the
            # message says, and as `release` reports it; 0 once that is over,
            # or while the holder runs.
            "grace_left_ms": _grace_left_ms(ctx, pool, registry, held, root) if _process_state(ctx, holder) == "stopped" else 0,
        }

        # Another session, or a sibling, is told the slot exists, not handed the
        # way into it.
        if not holder or _same_session(mine, holder) or _own_subagent(mine, holder):
            facts["path"] = slot_path(pool, held)
        return _refuse(
            ctx,
            "branch_held_by_this_session" if holder and _same_session(mine, holder) else "branch_in_use",
            _held_by(ctx, pool, registry, held, name, mine, root),
            facts = facts,
        )
    elsewhere = _worktree_holding_branch(ctx, pool, name)
    if elsewhere:
        # A pool slot can hold a branch the registry does not know it holds:
        # a lease recorded by another clone's view of it, or a checkout that
        # `release` could not drop. Telling the caller the pool does not manage
        # that directory would be false, and the advice useless.
        if elsewhere.startswith(pool["dir"] + "/" + SLOT_PREFIX):
            # Another `add` part way through reusing that slot: a moment's
            # wait, not a slot to release from under it.
            busy = elsewhere.rpartition("/" + SLOT_PREFIX)[2]
            reserved = registry["slots"].get(busy) or {}
            if (elsewhere == slot_path(pool, busy) and reserved.get("state", "") == RESERVED and
                (reserved.get("reservation") or {}).get("name", "") == name):
                return _branch_pending(ctx, pool, busy, name)
            return _refuse(
                ctx,
                "branch_elsewhere",
                name + " is checked out in the pool slot at " + elsewhere +
                ", which no lease of this clone accounts for. `aspect worktree list` " +
                "shows the slot; `aspect worktree release " + elsewhere.rpartition("/" + SLOT_PREFIX)[2] +
                "` frees the branch.",
                facts = {"path": elsewhere, "branch": name},
            )
        return _refuse(
            ctx,
            "branch_elsewhere",
            name + " is already checked out at " + elsewhere +
            ", which is not managed by aspect worktree, and a branch can be checked out in only " +
            "one place. Switch that checkout to another branch and try again, or:" +
            "\n\n  aspect worktree add <new-branch> --create=" + shell_quote(name) + _id_flag(ctx) + "   # new work starting there" +
            "\n  aspect worktree add " + shell_quote(name) + " --detach" + _id_flag(ctx) + "   # build or read it on no branch",
            facts = {
                "path": elsewhere,
                "branch": name,
                "is_main_clone": elsewhere == pool["git_common_dir"].removesuffix("/.git"),
            },
        )

    return _allocate(ctx, pool, lock, registry, want, root, base_ref, not existing, base_label, notes = notes)

def _add_detached(ctx: TaskContext, pool: dict, ref: str) -> int | TaskConclusion:
    """`add <commit-ish> --detach`: a slot at that commit with no branch, as
    `git worktree add --detach` makes one.

    None of the branch checks apply — git lets any number of worktrees sit at
    one commit, including one a branch elsewhere is at — so this goes straight
    to allocation. The lease is named for the ref as git names a detached HEAD,
    and is addressed by slot id afterwards. `--create` and `--take-over` are
    both about a branch, and are refused alongside it rather than ignored.
    """
    for flag, given in [("--create", ctx.args.create != _CREATE_OFF), ("--take-over", ctx.args.take_over)]:
        if given:
            return _refuse(
                ctx,
                "conflicting_flags",
                flag + " is about a branch, and --detach checks out no branch. Drop one: " +
                "`--detach` to look at " + ref + " as it is" +
                (", or `aspect worktree add <new-branch> --create=" + shell_quote(ref) +
                 "` to start work from it." if flag == "--create" else ", or `--take-over` to claim the lease on the branch " + ref + "."),
                facts = {"flags": ["--detach", flag]},
            )
    commit = "" if ref.startswith("-") else _git_try(ctx, ["rev-parse", "--verify", "--quiet", ref + "^{commit}"], ctx.std.env.current_dir())
    if not commit:
        return _no_such_ref(ctx, pool, ref, ref)

    root = _output_root(ctx)
    name = _detached_name(ref)
    want = {
        "name": name,
        "lock_digest": lock_digest_at(ctx.std, pool["git_common_dir"], commit),
        "commit": commit,
    }
    lock = _lock_pool(ctx, pool)
    if not lock:
        return _pool_busy(ctx)
    registry = _settle(ctx, pool, root)
    if registry.get("read_only", False):
        return _newer_registry(ctx, pool)
    return _allocate(ctx, pool, lock, registry, want, root, commit, detached = ref)

def _release_impl(ctx: TaskContext) -> int | TaskConclusion:
    name = ctx.args.branch[0].removeprefix("refs/heads/") if ctx.args.branch else ""
    bad = _invalid_agent(ctx)
    if bad:
        return bad
    pool = _pool(ctx)

    # A slot another clone owns, named by id or directory, is released as that
    # clone would release it.
    there = _elsewhere(ctx, pool, name, False) if name else None
    if there:
        pool = there.pool
        if there.clone:
            _info(ctx.std, "slot " + there.slot + " belongs to the clone at " + tilde(there.clone, ctx.std.env.home_dir()) +
                           "; releasing it there")
    if not pool:
        return _refuse(
            ctx,
            "not_a_repository",
            "not inside a git repository, and no slot on this machine answers to " + (name or "nothing named") +
            " — outside a clone, `release` takes a slot id or a slot's directory, as `aspect worktree list --all` shows them",
        )
    lock = _lock_pool(ctx, pool)
    if not lock:
        return _pool_busy(ctx)

    root = there.root if there else _output_root(ctx)

    # Where the commands the messages suggest are run: the owning clone, when
    # this is not it.
    in_clone = (" in " + tilde(there.clone, ctx.std.env.home_dir())) if there and there.clone else ""
    registry = _adopted(ctx, pool)
    if registry.get("read_only", False):
        return _newer_registry(ctx, pool)

    # Nothing named: the slot the caller is standing in, by its id, which names
    # it exactly whatever branch is checked out there. Messages name it as its
    # lease does, as they would had the caller typed it.
    here = ""
    if not name:
        here = _slot_here(ctx, pool, registry)
        name = (registry["slots"][here].get("lease") or {}).get("name", "") or here if here else ""
        if not here:
            return _refuse(
                ctx,
                "no_such_worktree",
                "not inside a pooled worktree, so there is no slot to release here. Name one — a branch, " +
                "a slot id, or a slot's directory — or run this from inside the slot: `aspect worktree " +
                "inspect` lists what this session holds.",
                facts = {"asked": "", "closest": "", "names": []},
            )

    # A stopped `add` for this very branch is what the caller is releasing: once
    # its slot is reclaimed there is nothing left to end, which is a success.
    abandoned = [
        sid
        for sid in registry["slots"]
        if registry["slots"][sid]["state"] == RESERVED and
           registry["slots"][sid].get("owner_git_dir", "") == pool["git_common_dir"] and
           (registry["slots"][sid].get("reservation") or {}).get("name", "") == name and
           reservation_abandoned(ctx.std, registry, sid)
    ]
    if _reclaim_reservations(ctx, pool, registry):
        write_registry(ctx.std, pool["dir"], registry)
    if abandoned:
        return _released_nothing(ctx, pool, abandoned[0], name)
    target = here or _resolve_slot(ctx, pool, registry, name, prefix = False)
    if not target and name == _FORCE_ALL and ctx.args.force == _FORCE_DIRTY:
        return _refuse(
            ctx,
            "no_such_worktree",
            "nothing is named `all`: `--force all` reads as a bare --force and a branch called all. " +
            "The grade is written with an equals sign — `aspect worktree release <branch> --force=all`.",
            facts = {"asked": name, "closest": "", "names": []},
        )
    if not target:
        return _no_such_worktree(ctx, pool, registry, name)

    # Ending a lease is the owning clone's to do: its worktree is registered in
    # that clone's object store, and freeing the slot from here would close the
    # owner's lease without removing its checkout.
    refused = _not_ours(ctx, pool, registry, target)
    if refused:
        return refused
    if registry["slots"][target]["state"] == RESERVED:
        return _being_set_up(ctx, registry, target, "not leased yet, and there is nothing to release")
    if registry["slots"][target]["state"] != LEASED:
        if not is_directory(ctx.std, slot_path(pool, target)):
            unregister_vanished(ctx.std, pool, registry)
            write_registry(ctx.std, pool["dir"], registry)
        return _nothing_to_release(ctx, pool, registry, target)

    # Somebody else's lease is theirs to end unless their process has verifiably
    # stopped. A holder whose process was never captured cannot be shown to
    # have stopped, so it counts as here, as it does for reclaiming. The agent
    # flags name the caller as `add` named it, so a lease taken under an
    # explicit id is recognised as the caller's own.
    holder = (registry["slots"][target].get("lease") or {}).get("agent") or {}
    me = _me(ctx)
    protected = _protected_from(ctx.std, me, holder)

    # Another session that has stopped is given the grace `add` gives it before
    # its slot is anybody else's: within it, ending the lease is the same
    # decision `add --take-over` is, or release-then-add would get round it.
    kept_ms = 0
    if not protected and holder and not _same_session(me, holder) and not _own_subagent(me, holder) and not _sibling(me, holder):
        kept_ms = _grace_ms(ctx) - (time.now_ms() - lease_last_active_ms(ctx.std, pool, target, registry["slots"][target], root))
        protected = kept_ms > 0

    # Another agent of the caller's own session: the session decides, so no
    # flag a subagent can pass overrides it.
    if _sibling(me, holder) or (protected and ctx.args.force != _FORCE_ALL):
        return _held_by_another_session(ctx, pool, registry, target, kept_ms, root)

    # Said in the result rather than done silently: ending somebody else's
    # lease, with `--force=all` or once its holder's grace is over, is what a
    # reader should see recorded.
    overrode = protected or (bool(holder) and not _same_session(me, holder) and not _own_subagent(me, holder))

    slot = registry["slots"][target]
    path = slot_path(pool, target)

    # Releasing drops the worktree, which takes anything uncommitted in it with
    # it. That is the last step of an ordinary task, so it must not be the step
    # that loses work: name the files and let the caller decide.
    # Asked once: the same list is the refusal, its facts, and what `--force`
    # reports discarding. Reported rather than counted, since a caller deciding
    # whether to discard work needs to see which files.
    work = _dirty(ctx, path, root)

    grade = _release_grade(me, holder)
    foreign = grade.foreign
    anonymous = grade.anonymous
    needed = grade.needed

    # Nothing shows a checkout git cannot read is the caller's: its `.git` may
    # point into a clone that moved, with a new one cloned where it was.
    if work and work[0].startswith(UNREADABLE_CHECKOUT):
        needed = _FORCE_ALL
    if foreign:
        whose = " They are " + _holder(holder) + "'s, not this session's."
    elif anonymous:
        whose = (" The lease records no session id or process, so nothing shows they are this " +
                 "session's rather than another " + holder.get("kind", "") + " session's; " +
                 "ASPECT_AGENT_ID or --agent-id tells sessions apart.")
    else:
        whose = ""
    repair = ("\nGit cannot read this checkout; `git worktree repair " + shell_quote(path) +
              "` from the clone may make it readable again.") if work and work[0].startswith(UNREADABLE_CHECKOUT) else ""
    if work and ctx.args.force != needed and ctx.args.force != _FORCE_ALL:
        if repair:
            keep = "Make it readable, or copy what you need"
        elif work[0].startswith(VANISHED_CHECKOUT):
            # Only the ways to keep what is actually listed: a staged index or
            # an operation in progress comes back only with the checkout.
            otherwise = []
            if [line for line in work if line.startswith("DH ")]:
                otherwise.append("keep its commits with the `git branch` the DH line names")
            if [line for line in work if line.startswith("WR ")]:
                otherwise.append("keep its refs from `git for-each-ref refs/worktree` in that worktree's admin directory")
            keep = ("If you moved it, `git worktree repair <its new path>` from the clone" + in_clone + " brings it back, " +
                    "staged changes and any operation in progress with it" +
                    ("; otherwise " + ", and ".join(otherwise) if otherwise else ""))
        elif [line for line in work if line.startswith("IP ")]:
            keep = "Finish what is in progress — resolve any conflicts, then `--continue` it, or `--abort` it — and commit"
        else:
            keep = "Commit them"
        return _refuse(
            ctx,
            "worktree_dirty",
            name + ", at " + path + ", " + ("holds " + _work_said(work) if repair or work[0].startswith(VANISHED_CHECKOUT) else "has uncommitted changes") + ":\n" +
            _indented(work) + "\n" +
            keep + "." + whose + " Discarding " + ("it" if repair or work[0].startswith(VANISHED_CHECKOUT) else "them") + " with the worktree is " +
            ("this session's decision, since the work is its subagent's" if _own_subagent(me, holder) else "the user's decision") +
            ": `aspect worktree release " +
            shell_quote(target if _is_detached_name(name) else name) + _id_flag(ctx) + " --" +
            ("force=all" if needed == _FORCE_ALL else "force") + "`. Not `git stash`: the stash is shared by every worktree of this clone." + repair,
            # The porcelain lines themselves, so a caller that branched on the
            # token does not have to recover them from the sentence.
            facts = {
                "slot": target,
                "path": path,
                "uncommitted": _porcelain_entries(work),
                # Whose work it is, when not the caller's: an agent branching
                # on the token cannot read that from the sentence.
                "holder": holder,
                "same_session": _same_harness_session(me, holder),
            },
        )

    # A detached HEAD keeps nothing alive once its worktree goes: commits only
    # it reached are left dangling. A reflog that exists and cannot be read
    # counts the same, unnamed.
    tips = unreferenced_tips(ctx.std, path)
    orphans = -1 if tips == None else commits_only(ctx.std, path, tips)
    tips = tips or []
    counted = pluralize(orphans, "commit") if orphans > 0 else "commits git could not count"
    tip = tips[0] if tips else ""
    named = ("(%s %s)" % ("tips" if len(tips) > 1 else "tip", ", ".join(_capped(tips))) if tips else "(its HEAD reflog could not be read; `git reflog` in the slot lists them)")
    if orphans and ctx.args.force != needed and ctx.args.force != _FORCE_ALL:
        return _refuse(
            ctx,
            "unreferenced_commits",
            "%s has %s only its HEAD reaches, at %s %s. Releasing " % (
                ("slot " + target) if (registry["slots"][target].get("lease") or {}).get("detached", "") else name,
                counted,
                path,
                named,
            ) + "would leave %s dangling — reachable from no ref, for `git gc` to collect. " % (
                "it" if orphans == 1 else "them"
            ) + "To keep %s, `git branch <branch> " % ("it" if orphans == 1 else "them") + (tip or "<commit>") +
            "` from the clone" + in_clone + (" for each tip" if len(tips) > 1 else "") + ". Discarding %s with the " % (
                "it" if orphans == 1 else "them"
            ) + "worktree is the user's decision: `aspect worktree release " + shell_quote(target if _is_detached_name(name) else name) +
            _id_flag(ctx) + " --" + ("force=all" if needed == _FORCE_ALL else "force") + "`.",
            facts = {"slot": target, "path": path, "commits": orphans, "head": tip, "tips": tips},
        )

    # What the slot is left holding is what the next allocation scores it on, so
    # a slot whose checkout has vanished must record nothing rather than keep an
    # earlier occupant's digest — which would score it 100 for state it does not
    # have and send the next caller to the coldest slot in the pool.
    head = ""
    discarded = work

    # Read before the worktree goes: afterwards a caller standing in it has no
    # current directory to ask about, and every later command from there fails
    # without saying why. The clone is where to go back to.
    cwd = ctx.std.env.current_dir()
    left = cwd == path or cwd.startswith(path + "/")
    server = warmth_of(ctx.std, path, root).server
    if is_directory(ctx.std, path):
        # Tolerant: a slot whose owning clone is gone has a `.git` pointing at
        # a gitdir that no longer exists, and has no HEAD to read.
        head = _git_try(ctx, ["rev-parse", "HEAD"], path)
        branched = _git_try(ctx, ["symbolic-ref", "--quiet", "--short", "HEAD"], path)
        slot["lock_digest"] = lock_digest(ctx.std, path)
        if not remove_checkout(ctx.std, path, pool["git_common_dir"]):
            # Freeing the slot anyway is right, but a silent failure leaves
            # `list` calling the slot empty while its directory is still there.
            _warn(ctx.std, "could not remove the checkout at " + path + "; the slot is free in " +
                           "the pool, but the directory is still on disk. Removing it, then " +
                           "`git worktree prune` from " + (in_clone.removeprefix(" in ") or "this clone") + ", clears it.")
    else:
        branched = ""
        slot["lock_digest"] = ""

        # Discarding what git kept for a checkout that is gone means dropping
        # its registration, or the branch stays checked out nowhere.
        if work:
            catch(run_git, ctx.std, FORCE_REMOVE + [path], pool["git_common_dir"])

    # The branch git has, which `git switch` in the slot can make differ from
    # the lease's name: it is what holds the work, what the push advice below
    # must name, and what a later `add` asks for.
    held = mark_free(registry, target)
    released = branched or held or name
    slot["last_commit"] = head
    slot["last_branch"] = released

    # Observed rather than inferred: this is the moment the slot's Bazel state
    # can be looked at, and remembering that it existed is what lets a later
    # listing tell a reclaimed base from one that was never built.
    slot["had_base"] = slot.get("had_base", False) or warmth_of(ctx.std, path, root).base
    write_registry(ctx.std, pool["dir"], registry)

    # Recorded: what is left only reads, and asking every remote ref whether
    # it contains a commit is no reason to keep other callers waiting.
    _unlock(ctx, pool, lock)

    # The branch and its commits stay in the clone; whether any remote has them
    # is what decides whether releasing leaves work recoverable only from here.
    on_remote = _on_remote(ctx, pool, head) if head else True

    clone = pool["git_common_dir"].removesuffix("/.git")

    # Back to where the lease was taken from — usually the agent's own project,
    # which its harness may require it to stay in — and the main clone only
    # when that is unknown or gone.
    came_from = "" if overrode else holder.get("cwd", "")
    back = came_from if (came_from and ctx.std.fs.exists(came_from) and
                         not came_from.startswith(path + "/") and came_from != path) else clone

    warnings = []
    if head and not on_remote and branched:
        push = _push_command(ctx, pool, released)
        if push and in_clone:
            push = push.replace("git ", "git -C " + shell_quote(there.clone) + " ", 1)
        warnings.append({
            "code": "head_not_on_remote",
            "message": (released + " is kept in the clone at " + _short(head) + ", but no remote has " +
                        ("it: `" + push + "` keeps it safe" if push else "it, and this clone has none: the clone is its only copy")),
            "head": head,
        })
    if orphans:
        warnings.append({
            "code": "unreferenced_commits_discarded",
            "message": ("dropped with the worktree: %s that no branch had, now dangling until " +
                        "`git gc` collects %s; `git branch <branch> %s` recovers %s") % (
                counted,
                "it" if orphans == 1 else "them",
                " / ".join(_capped(tips)) or "<commit>",
                "it" if orphans == 1 else "them",
            ),
            "head": tip,
            "tips": tips,
            "commits": orphans,
        })
    if discarded:
        warnings.append({
            "code": "uncommitted_discarded",
            "message": "discarded with the worktree:\n" + _indented(discarded),
            "files": _porcelain_entries(discarded),
        })
    if overrode:
        warnings.append({
            "code": "overrode_another_session",
            "message": "ended a lease held by " + _holder(holder),
            "previous_holder": holder,
        })
    if server:
        warnings.append({
            "code": "bazel_server_running",
            "message": ("a Bazel server (pid %d) still holds this slot's output base, which keeps " +
                        "the next lease of it hot; it exits after Bazel's idle timeout") % server,
            "server_pid": server,
        })
    if left:
        warnings.append({
            "code": "cwd_removed",
            "message": "this shell is in " + path + ", which no longer exists; `cd " + shell_quote(back) + "`",
            "cd": back,
        })

    if ctx.args.output == "json":
        ctx.std.io.stdout.write(json.encode({
            "schema_version": _SCHEMA_VERSION,
            "released": released,
            "already_free": False,
            "slot": target,
            "path": path,
            "head": head,
            "head_on_remote": on_remote if head else None,
            "discarded": _porcelain_entries(discarded),
            "cwd_removed": left,
            "clone": clone,
            "warnings": warnings,
        }, indent = 2) + "\n")
        return 0
    _info(ctx.std, "released " + released + "; the slot stays in the pool, " +
                   _warmth_note(ctx.std, path, released, root).partition(":")[0])
    for w in warnings:
        _warn(ctx.std, w["message"])
    return 0

def _path_impl(ctx: TaskContext) -> int | TaskConclusion:
    name = ctx.args.branch[0].removeprefix("refs/heads/")
    bad = _invalid_agent(ctx)
    if bad:
        return bad
    pool = _pool(ctx)
    if not pool:
        return _not_a_repository(ctx)
    registry = reconcile(ctx.std, pool, read_registry(ctx.std, pool["dir"]))

    # A moved clone's slots are its own, and asking for one is where a moved
    # clone first notices: adopted here, under the lock, as `add` would. With
    # the lock busy the answer is read as it stands.
    locked = False
    if not registry.get("read_only", False) and adoptable(ctx.std, pool, registry) and _lock_pool(ctx, pool, wait = False):
        locked = True
        registry = _adopted(ctx, pool)
    found = _resolve_slot(ctx, pool, registry, name)
    if not found:
        return _no_such_worktree(ctx, pool, registry, name)
    refused = _not_ours(ctx, pool, registry, found)
    if refused:
        return refused
    if registry["slots"][found]["state"] == RESERVED:
        return _being_set_up(ctx, registry, found, "not ready to enter")
    if registry["slots"][found]["state"] != LEASED:
        return _nothing_checked_out(ctx, registry, found)

    # A person at a terminal may look into any slot, but an agent asking for
    # another session's — or a sibling subagent's — is about to work in
    # somebody else's checkout. The session itself may look into its own
    # subagents'.
    me = _me(ctx)
    holder = (registry["slots"][found].get("lease") or {}).get("agent") or {}
    if me and not _same_session(me, holder) and not _own_subagent(me, holder):
        lease_name = (registry["slots"][found].get("lease") or {}).get("name", "")
        ended = [
            e
            for e in (registry["slots"][found].get("history") or [])
            if e.get("released_ms", 0) and e.get("name", "") == lease_name and _of_my_session(me, e.get("agent") or {})
        ]
        was_ours = (" This session held it here before; that lease ended — released, taken over, or taken back " +
                    "while its process was not running — and its commits are on the branch.") if ended else ""
        whose = "that agent's" if holder else "that person's"
        return _refuse(
            ctx,
            "held_by_another_session",
            name + " is held by " + _holder(holder) + (", " + _kin(holder) if _sibling(me, holder) else ", not this session") +
            " — its checkout is " + whose + " to work in." + was_ours + " Take a branch of your own" + (
                "; if that subagent has stopped, `aspect worktree add " + shell_quote(name) + " --take-over" +
                _id_flag(ctx) + "` gives you its slot" if _own_subagent(me, holder) else ""
            ) + ".",
            facts = {
                "slot": found,
                "agent": holder,
                "process": _process_state(ctx, holder),
                "session_state": session_state(ctx.std, holder) if holder else "",
                "same_session": _same_harness_session(me, holder),
            },
        )
    registry = _follow_session(ctx, pool, registry, locked)

    path = slot_path(pool, found)
    if ctx.args.output == "json":
        ctx.std.io.stdout.write(json.encode({
            "schema_version": _SCHEMA_VERSION,
            "path": path,
            "slot": found,
            "pool": pool["id"],
        }, indent = 2) + "\n")
        return 0
    ctx.std.io.stdout.write(path + "\n")
    return 0

def _inspect_impl(ctx: TaskContext) -> int | TaskConclusion:
    """Report the slot named, or the one the working directory is in.

    Everything `list --verbose` says about a slot, plus its checkout: the
    commit, whether a remote has it, and what is uncommitted. Named, the slot
    resolves as `path` resolves it, a unique id prefix included, free or held
    by anyone, since reading
    one acts on nothing; another clone's slot is refused, because only its own
    clone's git can answer for it.

    With no name, not being in a slot is an answer rather than a refusal: it is
    the expected result in the main clone, and exit 0 keeps a shell one-liner
    that calls this before deciding from treating "no" as breakage.
    `--output=json` says which case it is in `location`, and lists in `held`
    the slots this session holds — which is what a caller that has lost its
    place is asking.
    """
    asked = ctx.args.slot[0].removeprefix("refs/heads/") if ctx.args.slot else ""
    bad = _invalid_agent(ctx)
    if bad:
        return bad
    pool = _pool(ctx)
    if not pool:
        # Not the `list` refusal: outside a clone there is no pool to be in a
        # slot of, which is a different thing from standing in the clone and
        # holding nothing.
        return _refuse(
            ctx,
            "not_a_repository",
            "not inside a git repository, so not inside a pooled worktree either — " +
            "`aspect worktree list --all` shows every pool on this machine from anywhere",
        )

    root = _output_root(ctx)
    registry = reconcile(ctx.std, pool, read_registry(ctx.std, pool["dir"]))
    standing = _slot_here(ctx, pool, registry)
    here = standing
    if asked:
        here = _resolve_slot(ctx, pool, registry, asked)
        if not here:
            return _no_such_worktree(ctx, pool, registry, asked)
        refused = _not_ours(ctx, pool, registry, here)
        if refused:
            return refused
    home = ctx.std.env.home_dir()
    registry = _follow_session(ctx, pool, registry, False)

    if not here:
        # One boolean cannot carry three answers, and the text distinguishes
        # them, so the document says which it is as well.
        linked = _linked_worktree(ctx)
        held = _held_by_caller(ctx, pool, registry)
        ended = _ended_of_my_session(ctx, registry, _me(ctx)) if _me(ctx) else []
        if ctx.args.output == "json":
            ctx.std.io.stdout.write(json.encode({
                "schema_version": _SCHEMA_VERSION,
                "in_worktree": False,
                "location": "unmanaged_worktree" if linked else "clone",
                "pool": pool["id"],
                "held": held,
                # Leases of this session that ended in the last day, which `held`
                # no longer lists: released, taken over, or taken back while its
                # process had stopped. Their commits are on their branches.
                "ended": ended,
            }, indent = 2) + "\n")
            return 0

        # Which of the two "no"s it is, because they lead different places: a
        # linked worktree somebody made by hand is not going to become a pool
        # slot, while the clone itself is where you would take one.
        if linked:
            _info(ctx.std, "this is a git worktree, but not one managed by aspect worktree")
        else:
            _info(ctx.std, "not in a pooled worktree — this is the clone itself")
        if held:
            _print("")
            _print("  this session holds:")
            width = max([display_width(_shown(h["branch"])) for h in held])
            for h in held:
                print("    " + pad_right(_shown(h["branch"]), width) + "  " + _shown(tilde(h["path"], home)) +
                      _styled(ctx.std, ("  (subagent " + h["agent_id"] + ")" if h["agent_id"] else "") +
                                       ("  (checkout gone: `aspect worktree release` says why)" if h["gone"] else ""), ansi.DIM))
        if ended:
            _print("")
            _print("  ended in the last day — released, taken over, or taken back while this session's " +
                   "process had stopped; the commits are on the branch:")
            width = max([display_width(_shown(e["branch"])) for e in ended])
            for e in ended:
                print("    " + pad_right(_shown(e["branch"]), width) + "  " +
                      _shown("slot " + e["slot"] + ", " + phrase_ms(time.now_ms() - e["ended_ms"]) + " ago"))
        _print("")

        # The commands in one column and what each is for in the next, dimmed.
        hints = [
            ("aspect worktree list --all", "every pool on this machine"),
            ("aspect worktree add <branch> --create=origin/main" + _id_flag(ctx), "new work in a pooled worktree"),
        ]
        width = max([display_width(_shown(command)) for command, _ in hints])
        for command, why in hints:
            print("  " + pad_right(_shown(command), width) + "  " + _styled(ctx.std, why, ansi.DIM))
        return 0

    rows = [r for r in _pool_rows(ctx, pool, root, True) if r["slot"] == here]
    if not rows:
        # Gone between the registry read and this one: as good as not in a slot.
        return _refuse(ctx, "no_such_worktree", "this slot was released or pruned while being read; run it again", retryable = True)

    # What deciding whether to release needs, asked before releasing rather
    # than learned from the result: the commit checked out, whether a remote
    # has it, and what is not committed.
    path = slot_path(pool, here)
    leased = registry["slots"][here]["state"] == LEASED
    checkout = leased and is_directory(ctx.std, path)
    head = _git_try(ctx, ["rev-parse", "HEAD"], path) if checkout else ""
    on_remote = head != "" and _on_remote(ctx, pool, head)
    dirty = _dirty(ctx, path, root) if checkout else []

    # Standing in a slot is no claim to it. Subagents that share their parent's
    # session read as that session; one given its own `--agent-id` is told a
    # sibling's slot is not its own.
    holder = (registry["slots"][here].get("lease") or {}).get("agent") or {}
    me = _me(ctx)
    yours = ((_same_session(me, holder) or _own_subagent(me, holder)) if holder else not me) if leased else False

    if ctx.args.output == "json":
        ctx.std.io.stdout.write(json.encode({
            "schema_version": _SCHEMA_VERSION,
            # Whether the working directory is in this slot, which a named one
            # need not be.
            "in_worktree": standing == here,
            "location": "slot",
            "output_user_root": root,
            "pool": pool["id"],
            "remote": pool["remote"],
            "slot": rows[0] if rows else {},
            "held_by_this_session": yours,
            "branch": (rows[0] if rows else {}).get("branch", ""),
            "head": head,
            "head_on_remote": on_remote if head else None,
            "uncommitted": _porcelain_entries(dirty),
            "base": (rows[0] if rows else {}).get("base", ""),
            "base_sha": (rows[0] if rows else {}).get("base_sha", ""),
            "upstream": _git_try(ctx, ["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}"], path) if checkout else "",
        }, indent = 2) + "\n")
        return 0

    _print_styled(ctx.std, tilde(pool["dir"], home) + "/" + SLOT_PREFIX + "<slot>", ansi.BOLD)
    _print("")
    for line in _render_slot_tables(_list_cells(ctx.std, rows, home).cells, ctx.std):
        print(line)
    _print("")
    _slot_detail(ctx.std, rows[0], home)
    if checkout:
        print(_field(ctx.std, "    ", "checkout:    ", "%s, %s" % (
            (_short(head) + (" (on a remote)" if on_remote else " (on no remote)")) if head else "no commit",
            pluralize(len(dirty), "uncommitted change") if dirty else "clean",
        )))
    if leased and not yours:
        print(_field(ctx.std, "    ", "held by:     ", _holder(holder) + " — not this session, so its checkout is " +
                                                       "theirs to work in"))

    # "How do I get back to this" is the other half of "what is this".
    sessions = _render_sessions(_session_groups(ctx.std, [(pool, rows[:1])], home, _me(ctx)), ctx.std)
    if sessions:
        _print("")
        for line in sessions:
            print(line)
    return 0

def _delete_slots(ctx: TaskContext, pool: dict, registry: dict, victims: list[str], root: str, discard: bool = False) -> struct:
    """Delete each slot in `victims`, reporting what went and what stayed.

    The registry is written after *each* one rather than once at the end. An
    entry whose output base has been deleted still scores as warm, so a prune
    interrupted halfway would leave records claiming state that is gone and send
    the next caller to the coldest slot in the pool.

    A slot can still be kept here even though the caller already spared the warm
    ones: `drop_slot` looks for a Bazel server again, which may have started
    while the confirmation was being answered.

    Paths are returned unabbreviated, since they are what `--output=json`
    reports; only the progress line shortens them.
    """
    pruned = []
    kept = []
    home = ctx.std.env.home_dir()
    for i, slot_id in enumerate(victims):
        path = slot_path(pool, slot_id)
        _print("  [%d/%d] removing %s" % (i + 1, len(victims), tilde(path, home)))
        outcome = drop_slot(ctx.std, pool, registry, slot_id, root, discard = discard)
        if outcome.dropped:
            pruned.append(path)
        else:
            kept.append((path, outcome.reason))
        write_registry(ctx.std, pool["dir"], registry)
    return struct(pruned = pruned, kept = kept)

def _nothing_to_prune_message(registry: dict, own_git_dir: str, max_idle_days: int) -> str:
    """Why nothing was collectable, in terms the reader can act on.

    Three different situations, and naming the wrong one sends somebody looking
    in the wrong place: a pool with every slot in use needs a `release`, a pool
    whose free slots belong to another clone needs the command run from that
    clone, and a pool whose slots are simply too recent needs a smaller
    `--max-idle-days`, or nothing at all.

    The third is the only one the age rule explains. `prunable_slots` skips a
    free slot belonging to a clone that still exists, so a pool can have nothing
    to collect and several free slots at once, and reporting that as "none is
    free" or "none is old enough" is false either way.

    At a threshold of zero every free slot this clone owns is eligible, so with
    nothing collected one of the earlier answers always applies.
    """
    free = [sid for sid in registry["slots"] if registry["slots"][sid]["state"] == FREE]

    # A slot with no owner recorded ages out under this clone like its own, so
    # it counts as ours here too.
    mine = [
        sid
        for sid in free
        if registry["slots"][sid].get("owner_git_dir", "") in ("", own_git_dir)
    ]

    if not registry["slots"]:
        return "nothing to prune: this pool has no slots yet"
    if not free:
        # "No free slot has been idle long enough" reads as "they are all too
        # recent", which is the wrong conclusion when none is free.
        return "nothing to prune: every slot in this pool is in use"
    if not mine:
        return ("nothing to prune: the free slots here belong to another clone of this " +
                "repository, and are that clone's to collect")
    return "nothing to prune: no free slot has been idle for %d days" % max_idle_days

def _slot_on_disk(ctx: TaskContext, asked: str) -> list:
    """The pool and slot id `asked` names, searched across every pool on this
    machine, as a list of (pool, slot id, exact): one entry for a match, several
    for a prefix that fits more than one slot, none when nothing does. `exact`
    is false for a match by prefix.

    Only a slot id, a unique prefix of one, or a slot's directory, never a
    branch: those are what `list --all` prints, and outside a clone there is no
    git to resolve a branch with. A path is matched as given and with symlinks
    resolved, since a pool root reached through a symlinked home is spelled
    both ways.
    """
    want = asked.rstrip("/")
    if "/" in want and not want.startswith("/"):
        want = ctx.std.env.current_dir() + "/" + want.removeprefix("./")
    real = real_path(ctx.std, want) if want.startswith("/") else want
    prefixed = []
    for pool in pools_on_disk(ctx.std):
        registry = read_registry(ctx.std, pool["dir"])
        for slot_id in registry["slots"]:
            if want == slot_id or slot_path(pool, slot_id) in (want, real) or (SLOT_PREFIX + slot_id) == want.rpartition("/")[2] and "/" not in asked:
                return [(pool, slot_id, True)]
            if len(want) >= _MIN_SLOT_PREFIX and slot_id.startswith(want):
                prefixed.append((pool, slot_id, False))
    return prefixed

def _elsewhere(ctx: TaskContext, pool: dict, asked: str, prefix: bool) -> struct | None:
    """The slot `asked` names when it is not one of this clone's: another
    clone's, of this repository or another, or one whose clone is gone. None
    when it is this clone's own, or no single slot answers.

    The name is resolved here first, as everywhere: a branch, then a slot id,
    then — where `prefix` — a unique prefix, so a branch that looks like hex
    still means this clone's branch. Only a name nothing of this clone answers
    to is looked for in every pool on disk, by slot id, prefix or directory:
    those are unique on the machine, while branches are per clone.

    For a slot whose clone still exists, `pool` is that clone's view of its
    pool and `root` the output user root its rc files resolve, so the command
    acts as running it there would: every ownership and work check asks the git
    that holds the worktree. `clone` is that clone's directory. For a slot
    whose clone is gone, `pool` is the pool it was found in and `clone` is "",
    and the stranded refusals and `prune` apply as from outside a clone.
    `Worktrees` settings — the grace period, the hooks — are still this
    directory's.
    """
    if pool:
        mine = _resolve_slot(ctx, pool, read_registry(ctx.std, pool["dir"]), asked, prefix)
        if mine and (read_registry(ctx.std, pool["dir"])["slots"].get(mine) or {}).get("owner_git_dir", "") == pool["git_common_dir"]:
            return None
    hits = [h for h in _slot_on_disk(ctx, asked) if prefix or h[2]]
    if len(hits) != 1:
        return None
    found, slot_id, _ = hits[0]
    owner = (read_registry(ctx.std, found["dir"])["slots"].get(slot_id) or {}).get("owner_git_dir", "")
    if pool and owner == pool["git_common_dir"]:
        return None
    if not owner or not ctx.std.fs.exists(owner):
        # This pool's own stranded slots have their refusals where they are.
        if pool and found["dir"] == pool["dir"]:
            return None
        return struct(pool = found, slot = slot_id, clone = "", root = _output_root(ctx))
    if not owner.endswith("/.git"):
        # A clone made with `--separate-git-dir`: its work tree is not named
        # by its git directory, so its own view cannot be had from here.
        return None
    clone = owner.removesuffix("/.git")
    there = pool_of(ctx.std, clone) if is_directory(ctx.std, clone) else {}
    if not there or there["git_common_dir"] != owner or there["dir"] != found["dir"]:
        return None
    return struct(
        pool = there,
        slot = slot_id,
        clone = clone,
        root = output_bases.configured_output_user_root(ctx, clone) or output_user_root(ctx.std),
    )

def _prune_outside_a_clone(ctx: TaskContext) -> TaskConclusion:
    """`prune` outside a clone, with no slot named or one no pool has."""
    if ctx.args.target:
        asked = ctx.args.target[0]
        if not asked.strip():
            said = "an empty name names no slot"
        elif len(asked) < _MIN_SLOT_PREFIX and "/" not in asked:
            said = "%s is too short to match a slot id by: a prefix needs at least %d characters" % (asked, _MIN_SLOT_PREFIX)
        elif not is_hex(asked.lower()) and SLOT_PREFIX not in asked:
            said = ("no pool on this machine has a slot " + asked + ", and a branch name only names a slot " +
                    "inside a clone of its repository")
        else:
            said = "no pool on this machine has a slot " + asked
        return _refuse(
            ctx,
            "no_such_worktree",
            said + " — outside a clone, " +
            "`aspect worktree prune` takes a slot id, a unique prefix of one of at least %d characters, or a slot's " % _MIN_SLOT_PREFIX +
            "directory, as `aspect worktree list --all` shows them",
            facts = {"asked": ctx.args.target[0], "closest": "", "names": []},
        )
    return _refuse(
        ctx,
        "not_a_repository",
        "not inside a git repository — run this from a clone of the repo whose pool you mean. " +
        "Outside a clone, `aspect worktree prune <slot>` deletes one slot by the id or directory " +
        "`aspect worktree list --all` shows, which is how a slot whose clone is gone is removed",
    )

def _prune_impl(ctx: TaskContext) -> int | TaskConclusion:
    bad = _invalid_agent(ctx)
    if bad:
        return bad

    # Outside a clone, only a slot named by id, unique prefix or directory: its pool is found
    # on disk, and the checks below refuse anything a clone that still exists
    # owns.
    pool = _pool(ctx)
    located = ""

    # A slot that is not this clone's, named by id, prefix or directory from
    # anywhere, is pruned as its own clone would prune it — or, its clone gone,
    # as from outside a clone.
    there = _elsewhere(ctx, pool, ctx.args.target[0], True) if ctx.args.target else None
    if there:
        pool = there.pool
        located = there.slot
        if there.clone:
            _info(ctx.std, "slot " + there.slot + " belongs to the clone at " + tilde(there.clone, ctx.std.env.home_dir()) +
                           "; pruning it there")
    elif not pool:
        hits = _slot_on_disk(ctx, ctx.args.target[0]) if ctx.args.target else []
        if len(hits) > 1:
            ids = sorted([slot_id for _, slot_id, _ in hits])
            return _refuse(
                ctx,
                "no_such_worktree",
                ctx.args.target[0] + " is the start of more than one slot id — " + ", ".join(ids) + " — so give more of it.",
                facts = {"asked": ctx.args.target[0], "closest": "", "names": ids},
            )
        if not hits:
            return _prune_outside_a_clone(ctx)
        pool, located, _ = hits[0]

    # `--dry-run` writes nothing, so it reads as `list` does, without the lock,
    # and a long `release` elsewhere does not keep it waiting.
    lock = {} if ctx.args.dry_run else _lock_pool(ctx, pool)
    if not lock and not ctx.args.dry_run:
        return _pool_busy(ctx)

    root = there.root if there else _output_root(ctx)
    taken = []
    registry = _adopted(ctx, pool, taken) if not ctx.args.dry_run else _adoption_preview(ctx, pool, taken)
    if registry.get("read_only", False) and not ctx.args.dry_run:
        return _newer_registry(ctx, pool)
    if taken:
        _info(ctx.std, ("would take over " if ctx.args.dry_run else "took over ") + pluralize(len(taken), "slot") +
                       " recorded for a clone no longer at its path: " + ", ".join(taken))
    if not ctx.args.dry_run and _reclaim_reservations(ctx, pool, registry):
        write_registry(ctx.std, pool["dir"], registry)

    # Named a slot, or working by policy. Naming one says which, so age is not
    # consulted — the argument is the decision.
    eligible = []
    found = ""
    named = len(ctx.args.target) > 0
    if ctx.args.target:
        asked = ctx.args.target[0]
        if located:
            # Gone between the search and the lock.
            if located not in registry["slots"]:
                return _prune_outside_a_clone(ctx)
            found = located
        else:
            found = _resolve_slot(ctx, pool, registry, asked)
        if not found:
            return _no_such_worktree(ctx, pool, registry, asked)
        owner = _live_other_owner(ctx, pool, registry["slots"][found])
        if owner:
            return _owned_elsewhere(ctx, found, owner)

        # A slot whose owning clone is gone is collectable by name whatever its
        # state: no clone can release or lease it again, and a lease nothing can
        # end would otherwise hold it forever.
        stranded = _stranded(ctx, pool, registry["slots"][found]) or _unlisted_lease(ctx, pool, registry, found)
        if registry["slots"][found]["state"] == RESERVED and not stranded:
            return _being_set_up(ctx, registry, found, "not ready to delete")
        if registry["slots"][found]["state"] != FREE and not stranded:
            return _slot_in_use(ctx, registry, found)

        # From another clone, a moved clone and a deleted one look the same; a
        # holder still running says which it is, and that is never this clone's
        # to delete. Asked before the server, whose remedy would stop it. One
        # whose process was never captured cannot be shown to have stopped, so
        # only `--force=all` gets past it, as for `release`.
        holder = (registry["slots"][found].get("lease") or {}).get("agent") or {}
        held = stranded and registry["slots"][found]["state"] == LEASED and holder
        running = held and holder.get("pid", 0) and session_state(ctx.std, holder) == RUNNING
        uncaptured = held and not holder.get("pid", 0) and ctx.args.force != _FORCE_ALL
        if running or uncaptured:
            return _stranded_in_use(ctx, pool, registry, found, holder, bool(running))

        server = warmth_of(ctx.std, slot_path(pool, found), root).server
        if server:
            return _slot_still_warm(ctx, pool, found, server, root)

        # A stranded slot can still hold a checkout, and the work in it is not
        # the pool's to discard: said, with the files, and left to `--force=all`
        # — which still names what it deletes, since nothing will prompt.
        work = _work(ctx, slot_path(pool, found), root)
        if work and ctx.args.force == _FORCE_ALL:
            listed = work
            if work[0].startswith(UNREADABLE_CHECKOUT):
                # Git cannot say what is in it, so the directory does.
                err, entries = catch(ctx.std.fs.read_dir, slot_path(pool, found))
                listed = work + (["   " + e.path + ("/" if e.is_dir else "") for e in entries if e.path != ".git"] if err == None else [])
            _warn(ctx.std, ("would delete" if ctx.args.dry_run else "deleting") + " with slot " + found +
                           ", as --force=all asked:\n" + _indented(listed))
        if work and ctx.args.force != _FORCE_ALL:
            return _refuse(
                ctx,
                "worktree_dirty",
                "slot " + found + ", at " + slot_path(pool, found) + ", still holds " + _work_said(work) +
                ":\n" + _indented(work) +
                "\nCopy what you need from it, then pass --force=all to delete it with the slot." +
                (("\nGit cannot read this checkout; if its clone moved, `git worktree repair " +
                  shell_quote(slot_path(pool, found)) + "` from the clone makes it readable again.") if work[0].startswith(UNREADABLE_CHECKOUT) and not stranded else ""),
                facts = {"slot": found, "path": slot_path(pool, found), "uncommitted": _porcelain_entries(work)},
            )
        eligible = [found]
    else:
        eligible = prunable_slots(ctx.std, pool, registry, ctx.args.max_idle_days, root)

    # A live Bazel server, or a checkout holding work, spares a slot. Applied
    # here rather than only at deletion, so `--dry-run` previews what a real run
    # would do instead of listing slots it would keep. The deletion loop checks
    # again, for a server that started in between.
    victims = []
    spared = []
    for slot_id in eligible:
        warmth = warmth_of(ctx.std, slot_path(pool, slot_id), root)
        if warmth.server:
            # Naming a slot is a decision, so it gets a decision back: a script
            # must not read an exit 0 as the slot having gone.
            if named:
                return _slot_still_warm(ctx, pool, slot_id, warmth.server, root)
            spared.append((
                slot_path(pool, slot_id),
                "a Bazel server (pid %d) still holds it" % warmth.server,
            ))
        elif not named and _holds_work(ctx, slot_path(pool, slot_id), root):
            # `drop_slot` would keep it anyway; said here so a dry run agrees.
            spared.append((slot_path(pool, slot_id), "its checkout holds work that would be lost"))
        else:
            victims.append(slot_id)

    # The whole list goes out before anything is deleted, so the confirmation is
    # answered with the picture rather than a count.
    candidates = []
    rows = []
    for slot_id in victims:
        slot = registry["slots"][slot_id]
        aged = slot.get("created_ms", 0) != 0
        why = "named" if named else _prune_reason(ctx, pool, slot_id, slot, root)
        candidates.append({
            "slot": slot_id,
            "path": slot_path(pool, slot_id),
            "idle_days": slot_idle_days(ctx.std, pool, slot_id, slot, root) if aged else None,
            "last_branch": slot.get("last_branch", ""),
            "leased": (slot.get("lease") or {}).get("name", "") if slot["state"] == LEASED else "",
            "reason": why,
        })

        # A stranded slot can still be leased, and then the lease is what it holds.
        leased = (slot.get("lease") or {}).get("name", "") if slot["state"] == LEASED else ""
        label = (leased + " (leased)") if leased else (slot.get("last_branch", "") or "never used")
        rows.append({"slot": slot_id, "why": why, "branch": label})
    if victims:
        _info(ctx.std, pluralize(len(victims), "slot") + " can be reclaimed, under " +
                       tilde(pool["dir"], ctx.std.env.home_dir()) + ":")
        for line in _table(ctx.std, rows, _PRUNE_COLUMNS, "  "):
            print(line)

    whose = "its Bazel output base" if len(victims) == 1 else "their Bazel output bases"
    doomed = "delete " + pluralize(len(victims), "worktree slot") + " and " + whose
    verdict = confirm.decide(
        has_work = len(victims) > 0,
        dry_run = ctx.args.dry_run,
        force = ctx.args.force != _FORCE_OFF,
        is_tty = ctx.std.io.stdin.is_tty,
    )
    if verdict == confirm.NEEDS_FORCE:
        return _refuse(ctx, "needs_force", confirm.needs_force_message(doomed))
    question = "Delete " + pluralize(len(victims), "worktree slot") + " and " + whose + "?"

    # The question can sit unanswered for as long as a person likes, so it is
    # asked without the pool lock, and what was asked about is checked again
    # once the lock is back: a slot leased meanwhile is no longer a candidate.
    # Declining is an outcome like any other, reported with an `--output=json`
    # document.
    declined = False
    if verdict == confirm.ASK:
        _unlock(ctx, pool, lock)
        declined = not confirm.ask(ctx, question)
        if not declined:
            if not _relock(ctx, pool, lock):
                return _pool_busy(ctx)
            registry = reconcile(ctx.std, pool, read_registry(ctx.std, pool["dir"]))
            still = [found] if named else prunable_slots(ctx.std, pool, registry, ctx.args.max_idle_days, root)
            victims = [
                v
                for v in victims
                if v in still and v in registry["slots"] and
                   (registry["slots"][v]["state"] == FREE or (named and (_stranded(ctx, pool, registry["slots"][v]) or
                                                                         _unlisted_lease(ctx, pool, registry, v)) and
                                                              _process_state(ctx, (registry["slots"][v].get("lease") or {}).get("agent") or {}) != "running"))
            ]

    pruned = []
    kept = [] + spared
    if verdict != confirm.SKIP and not declined:
        # The output root is the one the slot's own clone resolves where it
        # still exists, and this directory's otherwise. For a slot of a clone
        # that is gone, a base not found here may be under a root that clone
        # set, and deleting the slot forgets where it was.
        for slot_id in [v for v in victims if located or registry["slots"][v].get("owner_git_dir", "") != pool["git_common_dir"]]:
            if not warmth_of(ctx.std, slot_path(pool, slot_id), root).base and registry["slots"][slot_id].get("had_base", False):
                _warn(ctx.std, "slot " + slot_id + " had an output base, but none is under " + tilde(root, ctx.std.env.home_dir()) +
                               ": if its clone's .bazelrc moved Bazel's output root, `aspect output-bases` from " +
                               "a directory that reads the same rc finds it, and `aspect gc` collects it")
        done = _delete_slots(ctx, pool, registry, victims, root, discard = named and ctx.args.force == _FORCE_ALL)
        pruned = done.pruned
        kept = kept + done.kept

    # Naming a slot is a decision, and a script must not read exit 0 as the slot
    # having gone when it was kept.
    kept_named = named and verdict != confirm.SKIP and not declined and not pruned

    for path, reason in kept:
        # By slot id, as the table above and `list` name it.
        _warn(ctx.std, "kept " + path.rpartition("/" + SLOT_PREFIX)[2] + ": " + reason)

    if ctx.args.output == "json":
        ctx.std.io.stdout.write(json.encode({
            "schema_version": _SCHEMA_VERSION,
            "pool": pool["id"],
            "dry_run": ctx.args.dry_run,
            "max_idle_days": ctx.args.max_idle_days,
            # Candidates are reported whether or not anything was deleted, so a
            # dry run says what it would do rather than only that it did
            # nothing.
            "candidates": candidates,
            # Slots of a moved or deleted clone this clone took over, or would.
            "taken_over": taken,
            "pruned": pruned,
            "kept": [{"path": p, "reason": r} for p, r in kept],
            # So a caller can tell "you said no" from "there was nothing to do",
            # which an empty `pruned` alone does not.
            "declined": declined,
        }, indent = 2) + "\n")
        return 1 if kept_named else 0

    if not victims and not spared:
        _info(ctx.std, _nothing_to_prune_message(
            registry,
            pool["git_common_dir"],
            ctx.args.max_idle_days,
        ))
    elif not victims:
        idle = (" that has been idle for %d days" % ctx.args.max_idle_days) if ctx.args.max_idle_days else ""
        _info(ctx.std, "nothing to prune: every free slot" + idle + " was kept, for the reasons above")
    elif declined:
        _info(ctx.std, "left alone; nothing was deleted")
    elif verdict == confirm.SKIP:
        _info(ctx.std, "dry run; nothing was deleted")
    else:
        _info(ctx.std, "pruned " + pluralize(len(pruned), "slot"))
    return 1 if kept_named else 0

def _slot_here(ctx: TaskContext, pool: dict, registry: dict) -> str:
    """The slot the working directory is inside, or "".

    Matched on the directory's name, not its path. Git canonicalizes what it
    reports — `/var` becomes `/private/var` on macOS, and symlinks resolve — so
    comparing the path it gives against the one the pool composed would miss,
    while `aspect-worktree-<id>` is one string however the path is spelled.

    The worktree root comes from git rather than the working directory, so this
    answers the same from any subdirectory of a slot.
    """
    top = _git_try(ctx, ["rev-parse", "--show-toplevel"])
    if not top:
        return ""
    name = _rstrip_slash(top).rpartition("/")[2]
    if not name.startswith(SLOT_PREFIX):
        return ""
    slot_id = name[len(SLOT_PREFIX):]
    return slot_id if slot_id in registry["slots"] else ""

def _held_by_caller(ctx: TaskContext, pool: dict, registry: dict) -> list[dict]:
    """`{slot, branch, path, agent_id, gone}` for each slot of this clone the calling
    session holds — its own, and its subagents' when the caller is the session
    itself — or, for a person at a terminal, each lease with no agent.
    `agent_id` names a subagent's lease, and is "" for the caller's own."""
    me = _me(ctx)
    held = []
    for slot_id in sorted(registry["slots"].keys()):
        slot = registry["slots"][slot_id]
        if slot["state"] != LEASED or slot.get("owner_git_dir", "") != pool["git_common_dir"]:
            continue
        agent = (slot.get("lease") or {}).get("agent") or {}
        own = (me and _same_session(me, agent)) or (not me and not agent)
        if own or (me and _own_subagent(me, agent)):
            held.append({
                "slot": slot_id,
                "branch": slot["lease"].get("name", ""),
                "path": slot_path(pool, slot_id),
                "agent_id": "" if own else agent.get("id", ""),
                # Kept for a checkout that is gone; `release` says why and how.
                "gone": not is_directory(ctx.std, slot_path(pool, slot_id)),
            })
    return held

def _rstrip_slash(path: str) -> str:
    """`path` without a trailing slash, which `rpartition` would otherwise read
    as an empty last segment."""
    return path[:-1] if path.endswith("/") and len(path) > 1 else path

def _linked_worktree(ctx: TaskContext) -> bool:
    """Whether the working directory is in a linked worktree rather than the
    clone itself. Git keeps a worktree's own git dir separate from the common
    one, which is the only difference that matters here."""
    own = _git_try(ctx, ["rev-parse", "--absolute-git-dir"])
    common = _git_try(ctx, ["rev-parse", "--path-format=absolute", "--git-common-dir"])
    return bool(own) and bool(common) and own != common

def _pool_rows(ctx: TaskContext, pool: dict, root: str, ask_git: bool) -> list[dict]:
    """One row per slot in `pool`, in display order.

    `ask_git` is false for a pool this clone does not own, where git cannot
    answer: `reconcile` and `git worktree list` are scoped to one object store,
    so running them here would either report nothing or report the wrong
    repository's worktrees. Those rows carry the branch the registry recorded
    rather than the branch git has; a lease whose checkout is gone is ended
    here unless its owning clone, where it exists, says git still keeps work
    for it (`drop_vanished_leases`).

    Everything read from disk — warmth, idleness, whether the output base is
    still there — is current either way, since none of it goes through git.
    """
    registry = read_registry(ctx.std, pool["dir"])
    if ask_git:
        registry = reconcile(ctx.std, pool, registry)
    else:
        # A missing directory ends a lease, unless the owning clone's git still
        # keeps work for it.
        registry = drop_vanished_leases(ctx.std, pool, registry)
    checked_out = _checked_out_branches(ctx, pool) if ask_git else {}
    takes = adoptable(ctx.std, pool, registry) if ask_git else []
    rows = []
    for slot_id in registry["slots"]:
        slot = registry["slots"][slot_id]
        lease = slot.get("lease") or {}
        path = slot_path(pool, slot_id)
        warmth = warmth_of(ctx.std, path, root)

        # A slot being set up has no lease yet; its reservation says who.
        agent = lease.get("agent") or (slot.get("reservation") or {}).get("agent") or {}

        # What the registry can actually answer. Age needs a creation time;
        # idleness needs that or an output base whose freshness can be read.
        knows_age = slot.get("created_ms", 0) != 0
        knows_idle = knows_age or warmth.base

        # For this listing only: a listing does not write the registry. `add`
        # records it for good, in `_settle`.
        observe_base(registry, slot_id, warmth.base)
        rows.append({
            "slot": slot_id,
            "state": slot["state"],
            "name": lease.get("name", ""),
            # The branch an in-flight `add` is checking out here, which has no
            # lease yet.
            "reserved_for": (slot.get("reservation") or {}).get("name", ""),
            # Whether the `add` that claimed this slot is still running. Decided
            # here, where the registry is, since the renderer only has rows.
            "reservation_abandoned": (
                slot["state"] == RESERVED and reservation_abandoned(ctx.std, registry, slot_id)
            ),
            # What git has where it could be asked, and the record otherwise —
            # the same value the table shows, so a consumer reading the obvious
            # field is not told a slot has no branch while a reader can see one.
            # `name` is the lease, which `reconcile` keeps in step with git.
            "branch": checked_out.get(path, "") or ("" if lease.get("detached", "") else lease.get("name", "")),
            "branch_verified": ask_git and path in checked_out,
            # The commit-ish a `--detach` lease is at, which `branch` then
            # leaves empty; `name` carries the label the tables print.
            "detached": lease.get("detached", ""),
            # Where a branch `add --create` made started: the ref as given, and
            # the commit it was, which a later fetch does not move.
            "base": lease.get("base", ""),
            "base_sha": lease.get("base_sha", ""),
            "agent": agent,
            "session_state": session_state(ctx.std, agent) if agent else "",
            "process": _process_state(ctx, agent) if agent else "",
            # The project directory the harness filed the session under, where
            # that can be established. `agent.cwd` is only where the task ran.
            "session_project": session_project(ctx.std, agent) if agent else "",
            # Withheld on the same rule as the table: a session the harness's
            # store was read for and did not have cannot be resumed.
            "resume": _resume_command(ctx.std, agent) if agent else "",
            "path": path,
            "last_branch": slot.get("last_branch", ""),
            "owner": slot.get("owner_git_dir", ""),
            "owned_here": ask_git and slot.get("owner_git_dir", "") == pool["git_common_dir"],
            # Whether the question was asked at all. Without a clone to compare
            # against, `owned_here` is false for want of an answer rather than
            # because the slot belongs to somebody else.
            "ownership_known": ask_git,
            # Recorded for a clone gone from its path, and this clone's for the
            # taking: the next `add`, `release`, `path` or `prune` here adopts it.
            "adoptable": slot_id in takes,
            # Recorded for this clone's path, but the checkout of a clone that
            # was here before it.
            "unlisted": ask_git and _unlisted_lease(ctx, pool, registry, slot_id, checked_out),
            # Recorded for a clone no longer at its path, and nobody's to take.
            "stranded": (slot.get("owner_git_dir", "") != "" and slot_id not in takes and
                         (ask_git or slot["state"] == LEASED) and
                         not ctx.std.fs.exists(slot.get("owner_git_dir", ""))),
            # None where the record cannot answer: a zero here would be an
            # invented measurement rather than a small one.
            "idle_days": slot_idle_days(ctx.std, pool, slot_id, slot, root) if knows_idle else None,
            "idle_ms": slot_idle_ms(ctx.std, pool, slot_id, slot, root) if knows_idle else None,
            "created_days": slot_created_days(slot) if knows_age else None,
            "age_ms": slot_age_ms(slot) if knows_age else None,
            "lease_count": slot.get("lease_count"),
            "history": slot.get("history") or [],
            "had_base": slot.get("had_base", False),
            "output_base": output_base_of(ctx.std, path, root),
            "server_pid": warmth.server,
            "output_base_present": warmth.base,
            "warmth": _warmth_word(warmth.server, warmth.base),
        })

    # Sorted before anything reads it, so the document, the table and
    # `--verbose` all present the pool in the same order.
    return sorted(rows, key = _list_order)

def _warmth_word(server_pid: int, base_present: bool) -> str:
    """`hot`, `warm` or `cold`: three states, three words.

    A live server is the one that skips loading and analysis outright; an
    output base without one is a different thing rather than a lesser version
    of it.
    """
    if server_pid:
        return "hot"
    return "warm" if base_present else "cold"

def _list_cells(std, rows: list, home: str = "") -> struct:
    """`rows` as table cells, plus the few facts that need a sentence.

    One pass, because a note in a cell and the sentence that explains it are the
    same judgement: a slot another clone owns is tagged `other clone`, and one
    whose owning clone is gone `stranded`, and each is collected for its line
    below; a resumable session is tagged and its resume command collected.
    Walking the rows twice would mean keeping the two in step by hand.

    Stranded is a filesystem fact, so it is judged for a pool read only from
    its records too — which is where `list --all` outside a clone finds them.
    """
    foreign = {}
    stranded = []
    adopting = []
    unlisted = []
    resumable = []
    abandoned = []
    cells = []
    for r in rows:
        # A word rather than the pid: the pid is the widest thing in the table
        # and useful only to somebody about to kill the server, so `--verbose`
        # carries it.
        warmth = r["warmth"]

        # Tags, not sentences: a note is read inside an aligned cell, and one
        # long enough to explain itself pushes every row wider. Anything that
        # needs a sentence is said under the table.
        notes = []

        # A lease kept for a checkout that is gone, because git still keeps
        # work for it: `release` says what and how to recover it.
        if r["state"] == LEASED and not is_directory(std, r["path"]):
            notes.append("checkout gone")
        if r.get("adoptable", False):
            adopting.append(r["slot"])
            notes.append("clone moved")
        elif r.get("unlisted", False):
            unlisted.append(r["slot"])
            notes.append("another clone's")
        elif r["owner"] and not std.fs.exists(r["owner"]):
            stranded.append(r["slot"])
            notes.append("stranded")
        elif r["ownership_known"] and r["owner"] and not r["owned_here"]:
            # A dict for the distinct owners: Starlark has no sets.
            foreign[r["owner"]] = foreign.get(r["owner"], 0) + 1
            notes.append("other clone")
        if r["state"] == RESERVED:
            # Only when the branch column is showing something else: the cell
            # falls back to `reserved_for`, so otherwise the note repeats it.
            if r["reserved_for"] and (r["branch"] or r["name"]):
                notes.append("claimed for " + r["reserved_for"])
            if r["reservation_abandoned"]:
                notes.append("add abandoned")
                abandoned.append(r["slot"])

        # Only session states a reader can act on are noted. `unknown` is the
        # normal answer for a harness whose session layout cannot be checked, so
        # printing it would put noise on most rows and say nothing.
        if r["session_state"] == RESUMABLE or r["session_state"] == GONE:
            notes.append("session " + r["session_state"])
        elif r["state"] == LEASED and (r["agent"] or {}).get("pid", 0) and r["session_state"] != RUNNING:
            # Stopped, where the harness's store cannot say more: what kept the
            # slot from being taken back is said when its branch is asked for.
            notes.append("process stopped")
        if r["session_state"] == RESUMABLE:
            hint = _resume_line(std, r["agent"] or {}, home)
            if hint:
                resumable.append((r["name"], hint))

        # A subagent's row carries its session in the `session` column, like
        # every other row, and the id it was given here.
        if (r["agent"] or {}).get("parent_id", ""):
            notes.append("subagent " + r["agent"]["id"])

        # A slot with a history and no output base had its state reclaimed from
        # under the pool — by `aspect gc`, or a `bazel clean --expunge`. The
        # row otherwise looks like any healthy one until a build pays for it.
        # Only where a base was once seen: a slot leased without a build never
        # had one to lose.
        if r["had_base"] and not r["output_base_present"]:
            notes.append("base reclaimed")

        # The column shows what git has. When that is not what the lease was
        # taken under, the lease name is still the handle `path` and `release`
        # answer to, so it has to be said.
        if r["branch"] and r["name"] and r["branch"] != r["name"]:
            notes.append("leased as " + r["name"])

        # A free slot's branch is history, which its column header says.
        if r["state"] == FREE:
            branch = r["last_branch"] or "-"
        else:
            branch = r["branch"] or r["name"] or r["reserved_for"] or r["last_branch"] or "-"

        cells.append({
            "branch": branch,
            "state": _STATE_LABELS.get(r["state"], r["state"]),
            "warmth": warmth,
            "idle": _unit(_duration_cell, r["idle_ms"]),
            "age": _unit(compact_ms, r["age_ms"]),
            "leases": _unit(str, r["lease_count"]),
            "slot": r["slot"],
            "agent": (r["agent"] or {}).get("kind", ""),
            "session": session_id(r["agent"] or {}),
            "notes": ", ".join(notes),
            # Which table the row belongs in. Not a column: it is the heading.
            "_free": r["state"] == FREE,
        })
    return struct(
        cells = cells,
        foreign = foreign,
        stranded = stranded,
        adopting = adopting,
        unlisted = unlisted,
        resumable = resumable,
        abandoned = abandoned,
    )

def _render_slot_tables(cells: list, std = None) -> list[str]:
    """The taken slots and the free slots as two labelled tables, ready to
    print as they are: escaped, and styled when `std` is given and color is on.

    Headed rather than run together, because a reader comes to this listing with
    one of two questions — who has what, or what can I take — and the heading is
    what lets them read only the half they asked about.

    `taken` covers both a slot in use and one still being checked out, which the
    `state` column tells apart. The free table has no `state` column at all: its
    heading is the state. Cells are escaped by `_table` before the columns are
    measured.

    A heading sits left of its table, at the pool path's margin, so it reads as
    a heading and not as one more row even with no color; with color it is
    highlighted and the column headers under it are dimmed. Styling goes on
    whole lines after padding, since `render` measures with `len`.
    """
    color = std != None and _color(std)
    out = []
    for free, header, columns in [
        (False, "taken", _TAKEN_COLUMNS),
        (True, "free", _FREE_COLUMNS),
    ]:
        rows = [c for c in cells if c["_free"] == free]
        if not rows:
            continue
        if out:
            out.append("")
        out.append(ansi.BOLD + ansi.highlight_style(std, True) + header + ansi.RESET if color else header)
        out += _table(std, rows, columns)
    return out

def _render_pool(ctx: TaskContext, pool: dict, rows: list, home: str) -> None:
    """Print one pool: the path its slots live at, how many are taken and
    free, the tables, and the sentences that do not fit a cell."""

    # Where the slots are, as a template a reader can fill in from the first
    # column — which is what makes the table something other than magic.
    _print_styled(ctx.std, tilde(pool["dir"], home) + "/" + SLOT_PREFIX + "<slot>", ansi.BOLD)

    # The answer to "can I get one" before the rows that make it up. A slot
    # being set up is taken, as its table says; a free slot of another clone,
    # or of one that is gone, is free but not this clone's to take, and is
    # counted apart. Where ownership was not asked — another repository's
    # pool under `--all` — free is free.
    free = [r for r in rows if r["state"] == FREE]
    elsewhere = len([
        r
        for r in free
        if r["stranded"] or (r["ownership_known"] and r["owner"] and not r["owned_here"] and not r["adoptable"])
    ])
    _print(pluralize(len(rows), "slot") + ": " + str(len(rows) - len(free)) + " taken, " + str(len(free) - elsewhere) + " free" +
           (", " + str(elsewhere) + " free but not this clone's" if elsewhere else ""))
    _print("")

    shown = _list_cells(ctx.std, rows, home)
    cells = shown.cells
    foreign = shown.foreign
    stranded = shown.stranded
    adopting = shown.adopting
    unlisted = shown.unlisted
    resumable = shown.resumable
    abandoned = shown.abandoned

    for line in _render_slot_tables(cells, ctx.std):
        print(line)

    # Everything the tables gave up, per slot: the paths, the server, the age,
    # and every holder the slot remembers.
    if ctx.args.verbose:
        for r in rows:
            _print("")
            _slot_detail(ctx.std, r, home)

    # Sentences, where there is room for them. A note in the table is a tag.
    for slot_id in abandoned:
        _print("")
        _print("  the `aspect worktree add` that claimed " + slot_id +
               " is no longer running; the next `add` from the clone that owns it reclaims it")

    if foreign:
        count = 0
        for n in foreign.values():
            count += n
        _print("")
        owners = sorted(foreign.keys())
        _print("  %s belong%s to %s of this repository, at %s, and cannot be leased here" % (
            ("1 slot" if count == 1 else "%d slots" % count),
            ("s" if count == 1 else ""),
            ("another clone" if len(owners) == 1 else "other clones"),
            "; ".join([_clone_of(o) for o in owners]),
        ))

    if adopting:
        _print("")
        _print(("  %s recorded for a clone no longer at its path, and %s this clone's to take: " +
                "the next `aspect worktree add`, `release`, `path` or `prune` here takes %s over: %s") % (
            ("1 slot is" if len(adopting) == 1 else "%d slots are" % len(adopting)),
            ("is" if len(adopting) == 1 else "are"),
            ("it" if len(adopting) == 1 else "them"),
            ", ".join(adopting),
        ))

    if unlisted:
        _print("")
        _print(("  %s recorded for this clone's path, but this clone's git has no worktree there: the checkout%s " +
                "of a clone that was here before it, moved most likely, or it is this clone's own checkout, damaged. A command run from where that clone is now " +
                "takes %s back: %s") % (
            ("1 slot is" if len(unlisted) == 1 else "%d slots are" % len(unlisted)),
            ("" if len(unlisted) == 1 else "s"),
            ("it" if len(unlisted) == 1 else "them"),
            ", ".join(unlisted),
        ))

    if stranded:
        _print("")
        _print("  %s stranded: the clone that owned %s is no longer at its path, and no clone here can take %s. " % (
                   ("1 slot is" if len(stranded) == 1 else "%d slots are" % len(stranded)),
                   ("it" if len(stranded) == 1 else "them"),
                   ("it" if len(stranded) == 1 else "them"),
               ) + "If that clone moved, any command run there takes its slots back. If it was deleted, " +
               "`aspect worktree prune <slot>` deletes one, run from a clone of the repository or from outside any clone; " +
               "a leased one takes `--force=all` once you have copied out anything you need: " + ", ".join(stranded))

    # A session whose process has exited is almost always a closed terminal, so
    # the useful offer is how to get back into it, not how to take it away.
    # `--verbose` says it in the sessions section, so not twice.
    for name, hint in ([] if ctx.args.verbose else resumable):
        _print("")
        _print("  the process that took %s is no longer running; resume its session:" % name)
        _print("    " + hint)

def _list_impl(ctx: TaskContext) -> int | TaskConclusion:
    bad = _invalid_agent(ctx)
    if bad:
        return bad

    # No lock: this only reads. `write_registry` renames into place, so a
    # concurrent `add` can never be observed half-written, and reconciling
    # without persisting costs nothing — `add` and `release` reconcile too.
    root = _output_root(ctx)
    here = _pool(ctx)

    if ctx.args.all:
        # Every pool on disk, with the one this clone owns read in full. Outside
        # a repository there is no such pool, and that is not an error: "where
        # are my agents" is a question asked from anywhere.
        pools = pools_on_disk(ctx.std)
        if here and here["id"] not in [p["id"] for p in pools]:
            pools.append(here)
        pools = sorted(pools, key = lambda p: p["id"])
    elif here:
        pools = [here]
    else:
        return _not_a_repository_for_list(ctx)

    mine = here["id"] if here else ""
    listings = []
    for pool in pools:
        # The owning clone is the only one that can ask git about its slots.
        full = pool["id"] == mine
        listings.append((here if full else pool, _pool_rows(ctx, here if full else pool, root, full)))

    if ctx.args.output == "json":
        # `pools` is always a list, of one without `--all`, so a consumer reads
        # `.pools[].slots[]` either way rather than branching on the flag it was
        # called with. `reconciled` says how far each pool's rows can be
        # trusted: git was asked, or the records are all there is.
        ctx.std.io.stdout.write(json.encode({
            "schema_version": _SCHEMA_VERSION,
            "output_user_root": root,
            "pools": [
                {
                    "pool": pool["id"],
                    "remote": pool["remote"],
                    "reconciled": pool["id"] == mine,
                    "slots": rows,
                }
                for pool, rows in listings
            ],
            # The sessions the leases name, as `--verbose` lists them — but
            # always here, since a consumer reading JSON reads all of it.
            "sessions": [
                {
                    "kind": g.kind,
                    "id": g.id,
                    # The session running this command, so a caller finds its
                    # own without knowing which environment variable says so.
                    "current": g.current,
                    "project": g.project,
                    "resume": g.resume,
                    "leases": [{k: v for k, v in lease.items() if k != "order"} for lease in g.leases],
                }
                for g in _session_groups(ctx.std, listings, me = _me(ctx))
            ],
        }, indent = 2) + "\n")
        return 0

    home = ctx.std.env.home_dir()
    if not [rows for _, rows in listings if rows]:
        # The only question an empty pool raises is where its slots would go.
        where = tilde(listings[0][0]["dir"], home) if len(listings) == 1 else tilde(pools_root(ctx.std), home)
        _print("no slots in " + where)
        _print("")
        _print("  aspect worktree add <branch>")
        return 0

    for i, (pool, rows) in enumerate(listings):
        if not rows:
            continue
        if i:
            _print("")
        _render_pool(ctx, pool, rows, home)

    # Warmth is read under this workspace's output user root, so a pool built
    # under a different one reads cold. Naming the root is what makes that
    # visible rather than puzzling.
    others = [pool for pool, rows in listings if rows and pool["id"] != mine]
    if ctx.args.all and others:
        _print("")

        # Outside a clone every pool is one this command cannot ask git about.
        whose = "a pool this clone does not own" if mine else "outside a clone, every pool"
        _print("  " + whose + " is read from its records: a slot still on disk reads as its " +
               "records left it, so a lease there may have ended already")

        # Warmth is derived under the root this workspace resolves, so it is
        # only misread for another pool when this workspace has moved its root
        # off the platform default. Said then, and not otherwise: naming the
        # default root warns nobody about anything.
        if root != output_user_root(ctx.std):
            _print("  warmth above was read under " + tilde(root, home) + ", which this " +
                   "workspace sets — a pool built under Bazel's default root reads cold here")

    # One section for the whole listing, because a session can hold slots in
    # more than one pool and "where are my agents" is one question.
    if ctx.args.verbose:
        sessions = _render_sessions(_session_groups(ctx.std, listings, home, _me(ctx)), ctx.std)
        if sessions:
            _print("")
            for line in sessions:
                print(line)

    _print("")
    if not ctx.args.verbose:
        # Named first, because what a reader of this table usually wants next is
        # the rest of it: the paths, each session's leases, and the command that
        # returns to it.
        _print_styled(ctx.std, "  For more details run: aspect worktree list " + ("--all " if ctx.args.all else "") + "--verbose", ansi.DIM)
    _print_styled(ctx.std, "  For usage instructions run: aspect worktree list --help", ansi.DIM)
    return 0

# Who is asking, for every command but `add`, which records it. `ASPECT_AGENT_KIND`
# and `ASPECT_AGENT_ID` say the same for a whole process tree.
_IDENTITY_ARGS = {
    "agent_kind": args.string(
        default = "",
        description = "The agent harness asking, as given to `add` with the same flag. Needed only when the lease was taken with `--agent-kind`, so this command recognises it as yours; detected automatically otherwise.",
    ),
    "agent_id": args.string(
        default = "",
        description = "The session or subagent asking, as given to `add` with the same flag. Needed only when the lease was taken with `--agent-id`, so this command recognises it as yours; detected automatically otherwise.",
    ),
}

_OUTPUT_ARG = {
    "output": args.string(
        default = "text",
        values = ["text", "json"],
        description = "stdout format. `text` (default) writes a human-readable report to stderr and leaves stdout empty. `json` writes one document to stdout.",
    ),
}

# `add` additionally offers `path`, so one command both creates a worktree and
# tells a shell where to go:
#   slot=$(aspect worktree add fix/login --output=path) && cd "$slot"
_ADD_OUTPUT_ARG = {
    "output": args.string(
        default = "text",
        values = ["text", "json", "path"],
        description = "stdout format. `text` (default) writes a human-readable report to stderr and leaves stdout empty. `json` writes one document to stdout. `path` writes only the worktree directory to stdout, so a shell can step into it: `slot=$(aspect worktree add <branch> --output=path) && cd \"$slot\"`; the text report still goes to stderr, less the ways to enter the slot. Check the status — `cd \"$(...)\"` returns 0 even when the command fails, because `cd \"\"` is a no-op.",
    ),
}

add = task(
    group = ["worktree"],
    summary = "Take a git worktree from a pool of reused paths, so Bazel starts warm.",
    description = _EXPERIMENTAL + "\n\n" + "Create a git worktree at a pooled slot, checked out on the named branch. The slot's path never changes, so the Bazel server bound to it survives being handed from one task to the next — the second and every later worktree in that slot starts with a warm server and an `external/` tree already materialized.\n\nWhich slot you get is chosen for how much of its Bazel state will apply to the branch you asked for: an identical tree first, then the slot that last held this branch — so coming back to a branch lands on the analysis cache built for it — then any other warm slot, then one whose MODULE.bazel.lock differs, then a cold one. Where the slot has Bazel state, the line `add` prints names the branch that held it last, which is as much as the pool knows: what populated an analysis cache is not recorded, and a brief lease that built nothing is still the last holder.\n\nPrefer this over `git worktree add`, which gives Bazel a path it has never seen and therefore a cold server every time.\n\nThe slot path is printed, and `aspect worktree path <branch>` prints it again later; `git worktree list` reports it too, so the worktree stays legible to git and to anyone managing it by hand.",
    implementation = _add_impl,
    traits = [Worktrees],
    args = {
        "branch": args.positional(
            minimum = 1,
            maximum = 1,
            description = "Branch to check out: one this clone has, or one only a remote has, which is checked out tracking it — as `git worktree add` does. A name neither has is refused; `--create` makes it. With `--detach`, any commit-ish.",
        ),
        "create": args.string(
            default = _CREATE_OFF,
            bare = _CREATE_FROM_HEAD,
            description = "Create the branch, refusing if one by that name already exists here or on a remote. Bare, it starts from the current HEAD; `--create=<ref>` starts it from that ref — `--create=origin/main` for fresh work. The new branch has no upstream, so its first push names one: `git push -u origin <branch>`. The exception is `--create=<remote>/<branch>` for a branch several remotes have, which picks that remote's and tracks it.",
        ),
        "agent_kind": args.string(
            default = "",
            description = "Name of the agent harness taking this worktree, recorded on the lease and shown by `aspect worktree list`. Detected automatically for harnesses the CLI recognizes, or set `ASPECT_AGENT_KIND`; pass this when neither applies.",
        ),
        "agent_id": args.string(
            default = "",
            description = "Session identifier of the agent taking this worktree, recorded on the lease so a slot can be traced back to the session holding it. Detected automatically where the harness exports one, or set `ASPECT_AGENT_ID`.",
        ),
        "detach": args.boolean(
            default = False,
            description = "Check out <branch> — or any commit, tag or remote branch — at a detached HEAD, on no branch, as `git worktree add --detach` does. For building or reading something without working on it: any number of slots can sit at one commit, including one a branch elsewhere is at. The slot has no branch to be named by, so `path` and `release` take its slot id, which `add` prints. Commits made there need a branch before `release`, which refuses to drop them.",
        ),
        "take_over": args.boolean(
            default = False,
            description = "Claim a slot this pool already leases for the branch, re-assigning it to this session. The checkout is left exactly as it is, so anything the previous session had uncommitted is still there. Without this flag a held branch is refused, because the other session may only be suspended and resumable — except a lease whose session has verifiably stopped, more than `Worktrees.abandoned_grace_hours` since the slot's last activity, with nothing in its checkout to lose, which `add` takes back on its own, removing that checkout and checking the branch out fresh in the same slot.",
        ),
    } | _ADD_OUTPUT_ARG,
)

# `release` and `list` would both shadow a name this module already uses — the
# pool lock's `release`, and the builtin type — so these two symbols are named
# for their command and `kind` carries the command name. A shadowed `release`
# fails only when the deferred lock release runs, which no unit test reaches.
worktree_release = task(
    kind = "release",
    group = ["worktree"],
    summary = "End the lease on <branch>, or the slot you are in: remove the worktree, keep the slot warm.",
    description = _EXPERIMENTAL + "\n\n" + "End the lease on a branch: the worktree goes, the slot stays.\n\nRefused while the worktree holds work: modified tracked files and untracked files you wrote; a populated submodule, an edit hidden by `--assume-unchanged` or `--skip-worktree`, a ref only this worktree has, or a merge, rebase, cherry-pick, revert or bisect in progress; and commits only its HEAD reaches — made at a detached HEAD, or left behind by one — which removing the worktree would leave dangling. A checkout git cannot read is refused too, until `--force=all`. Files git ignores go with it, as `git worktree remove` takes them: what a repository ignores is disposable. Bazel's own leavings do not count — the convenience symlinks pointing into the slot's output base, and a generated lock file — because a slot that had been built in could otherwise never be released, which is every slot the pool is for. The slot's path is what Bazel keys its server and output base on, so leaving that path in place is what makes the next lease of this slot fast.\n\nSkipping this never breaks anything: git is the authority on whether a worktree exists, so a slot whose worktree git has forgotten is free regardless of what the pool recorded. A slot whose checkout is still on disk stays leased, though, until its holder has verifiably stopped, `Worktrees.abandoned_grace_hours` have passed and the checkout is clean — so call this when you can.",
    implementation = _release_impl,
    traits = [Worktrees],
    args = {
        "branch": args.positional(
            minimum = 0,
            maximum = 1,
            description = "The branch checked out in the slot, the slot id `aspect worktree list` shows in its first column, or the slot's directory. A detached slot also answers to the ref it was taken at, while no other slot is at it. A slot id or directory names a slot of any clone of any repository, as `aspect worktree list --all` shows it, and the slot is released as its own clone would release it. Omitted, the slot the working directory is in.",
        ),
        "force": args.string(
            default = _FORCE_OFF,
            values = [_FORCE_OFF, _FORCE_DIRTY, _FORCE_ALL],
            bare = _FORCE_DIRTY,
            description = "Override a refusal, in two grades as `git worktree remove` has `-f` and `-f -f`. `true` — which bare --force means — releases your own worktree with uncommitted changes, or with commits only its HEAD reaches, discarding them. `all` also ends a lease another session holds that has not verifiably stopped, or has stopped within `Worktrees.abandoned_grace_hours`, removing a checkout somebody may be working in, and discards another session's work even once its process has gone — as well as work under a lease that records no session id or process, which cannot be shown to be yours. Without it, a dirty worktree is refused with the changed files listed, and another session's lease is refused with its holder named.",
        ),
    } | _IDENTITY_ARGS | _OUTPUT_ARG,
)

path = task(
    kind = "path",
    group = ["worktree"],
    summary = "Print a leased worktree's directory, for `cd`.",
    description = _EXPERIMENTAL + "\n\n" + "Print the slot directory a leased worktree lives in, and nothing else, so a shell can step into it:\n\n    slot=$(aspect worktree path fix/login) && cd \"$slot\"\n\nThe two steps matter: `cd \"$(...)\"` returns 0 even when this fails, because the substitution is empty and `cd \"\"` is a no-op, so a script would carry on where it already was.\n\nA task cannot change its caller's directory, so this prints rather than moves. Define a shell function if you want one word:\n\n    aspect-cd() { local d; d=$(aspect worktree path \"$1\") && cd \"$d\"; }",
    implementation = _path_impl,
    traits = [Worktrees],
    args = {
        "branch": args.positional(
            minimum = 1,
            maximum = 1,
            description = "The branch checked out in the slot, the slot id `aspect worktree list` shows in its first column or a unique prefix of it, or the slot's directory. A detached slot also answers to the ref it was taken at, while no other slot is at it.",
        ),
        # Not the shared `_OUTPUT_ARG`: that one describes text output as a
        # report on stderr with stdout left empty, and writing the directory to
        # stdout is the whole point of this command.
        "output": args.string(
            default = "text",
            values = ["text", "json"],
            description = "`text` (default) writes the slot directory to stdout and nothing else, so a shell can step into it. `json` writes one document to stdout, which is how a refusal arrives as a token rather than prose.",
        ),
    } | _IDENTITY_ARGS,
)

prune = task(
    group = ["worktree"],
    summary = "Delete free slots and their Bazel output bases: one named, or all that have gone stale.",
    description = _EXPERIMENTAL + "\n\n" + "Reclaim the disk held by free slots. Name a branch, a slot id, a unique prefix of one or a slot's directory to delete that one however recently it was used; name nothing and every free slot nothing has used for a while goes. Each slot costs a checkout plus a Bazel output base, so a pool that grew during a busy week keeps paying for it afterwards.\n\nOnly free slots — and, by name, stranded ones — are considered: a slot someone is working in is never deleted, however long it has been idle. A free slot whose Bazel server is still running, or whose checkout holds work, is reported and kept, since unlinking an output base from under a live server is how a build starts writing into directories that no longer exist.\n\nA clone that was moved or deleted leaves its slots for the next clone to take over: a free one by any clone, which then ages like its own, and a leased one by the clone whose git still lists its checkout. What no clone can take — a leased slot whose clone was deleted — is stranded, and goes only by being named, whatever its age, with `--force=all` where its checkout holds work; one whose lease's session is still running is refused, since its clone most likely moved.\n\nThis also runs automatically during `aspect worktree add`, so the pool stays bounded without anyone remembering to clean up.",
    implementation = _prune_impl,
    traits = [Worktrees],
    args = {
        "target": args.positional(
            minimum = 0,
            maximum = 1,
            description = "A branch, a slot id or a unique prefix of one, or a slot's directory to delete, as `aspect worktree list` shows them. How long it has been idle is not consulted — naming it is the decision. Leave it out to work by idle time across every free slot. A slot id, prefix or directory names a slot of any clone of any repository, as `aspect worktree list --all` shows it, and the slot is pruned as its own clone would prune it; outside a clone, that is how a slot whose clone is gone is deleted.",
        ),
        "max_idle_days": args.int(
            default = PRUNE_IDLE_DAYS,
            description = "Delete free slots untouched for at least this many days, when no slot is named. `0` considers every free slot.",
        ),
        "dry_run": args.boolean(
            default = False,
            description = "Report what would be deleted and delete nothing.",
        ),
        "force": args.string(
            default = _FORCE_OFF,
            values = [_FORCE_OFF, _FORCE_DIRTY, _FORCE_ALL],
            bare = _FORCE_DIRTY,
            description = "Delete without asking. `true` — which bare --force means — is required when stdin is not a terminal, so a script or an agent has to opt in rather than have a prompt answered for it. `all` also deletes a named slot whose checkout holds work — uncommitted changes, commits only its HEAD reaches, a checkout git cannot read — which is otherwise refused with it listed, and a named stranded slot whose lease's process was never captured.",
        ),
    } | _IDENTITY_ARGS | _OUTPUT_ARG,
)

inspect = task(
    kind = "inspect",
    group = ["worktree"],
    summary = "Show everything about a pooled worktree: the one named, or the one this directory is in.",
    description = _EXPERIMENTAL + "\n\n" + "Report a slot: its path, the Bazel output base it keys, whether a server is holding that base, how many worktrees it has held and who has had them, and for a checked-out slot its commit, whether a remote has it, and what is uncommitted. The same detail `aspect worktree list --verbose` prints, for one slot — which otherwise means listing the pool and matching a path by eye.\n\nNamed, any slot of this clone answers, free or held by anyone, since reading one acts on nothing. Unnamed, it is the slot the working directory is in, from any subdirectory of it, since the worktree root comes from git rather than from the working directory.\n\nUnnamed outside a slot is an answer rather than an error and exits 0, since that is the expected result in the clone itself, and it lists the slots this session holds, so an agent that lost its place finds them; the two shapes of it are distinguished — the clone, or a git worktree `aspect worktree` does not manage — because they lead different places. Being outside a repository altogether is a refusal, because then there is no pool to have a slot in. `--output=json` reports which of the three in `location`.",
    implementation = _inspect_impl,
    traits = [Worktrees],
    args = {
        "slot": args.positional(
            minimum = 0,
            maximum = 1,
            description = "The branch checked out in the slot, the branch a free slot last held, the slot id `aspect worktree list` shows in its first column or a unique prefix of it, or the slot's directory. Omitted, the slot the working directory is in.",
        ),
    } | _IDENTITY_ARGS | _OUTPUT_ARG,
)

worktree_list = task(
    kind = "list",
    group = ["worktree"],
    summary = "List this repository's worktree slots, what holds them, and how warm each is.",
    description = _EXPERIMENTAL + "\n\n" + "Show every slot in this repository's pool: which are leased and to what, and which are free along with the branch each last held.\n\nA pool belongs to one repository: slots are keyed by the repository the clone you are in points at, so a slot never holds a worktree of anything else and this listing never shows one. `aspect output-bases` is the machine-wide view — every pool's slots, whatever repository they belong to, beside every other Bazel output base on this machine, with what each slot holds or last held. A pool whose builds went to a different output user root has state neither command can see; this command reads warmth under the root this workspace resolves, given as `output_user_root` in its JSON and named under `--all` when it is not Bazel's default.\n\nSlots are listed in two tables, under a line counting how many are taken and free, because what is worth knowing about a slot somebody holds and one you could take are different things.\n\n`taken` — a worktree is checked out here:\n\n    slot           the directory under the pool that holds the worktree; the pool's own path is printed above the table, with this as its last segment\n    state          `in use`, or `setup` while an `aspect worktree add` is still checking a worktree out here\n    warmth         how much of Bazel's state this slot has behind it\n      hot          a live Bazel server still holds the analysis cache, so a build with the same flags skips loading and analysis\n      warm         no server, but the output base is there\n      cold         no output base yet; the first build pays loading, analysis and fetches\n    age            how long the slot has existed\n    leases         worktrees the slot has held\n    branch         what is checked out\n    agent          the kind of agent holding the slot — `claude-code`, `codex` — where one can be identified\n    session        its session id, in full, so it can be handed straight to that harness\n    notes          anything exceptional about the row\n\n`free` — no worktree here, and the slot is keeping its Bazel state for the next one:\n\n    slot           as above\n    warmth         as above. Which free slot the next `add` takes is decided by how well its last tree fits the branch asked for, not by warmth\n    last used      how long since the slot was last used: Bazel's last activity in it, or a worktree taken or given back there, whichever is newer; what `prune` acts on\n    age            how long the slot has existed\n    leases         worktrees the slot has held\n    last branch    what it held last, which is the signal for how warm it will be for the next thing you put in it\n    notes          anything exceptional about the row\n\n`session` and `notes` are left out when no slot fills them.\n\n`--verbose` adds a block per slot — its path, its output base and why one is absent (`not created yet`, or `reclaimed`), whether a Bazel server holds it, and every holder the slot remembers — then a section per agent session those holders name: its harness, its project, the command that returns to it, and every lease it took, active first. Most leases come from subagents, which report their parent's session, so that section is where the way back into each conversation is said once. A session gets no command where the harness does not publish one, or where the harness's own store no longer has it. Durations in the tables are written in the coarsest unit that still distinguishes: minutes under an hour, hours under two days, then days; how long ago a lease ended is written in full.\n\nRows are ordered by what is happening: in use first, warmest down to cold, then the slots you could take, most recently used first.\n\n`--output=json` reports the same state as one document, with the elapsed times in milliseconds beside the rounded days. One ordering differs: a slot's `history` is oldest first there, since that is the order it was written in, while the table shows it newest first.\n\nWorking with a slot:\n\n    aspect worktree add <branch>\n        Take a free slot and check <branch> out in it, preferring the slot whose Bazel state best fits that branch — the one that last held it, where there is one. Checks out a branch this clone or a remote has; `--create` makes a new one, from HEAD or `--create=<ref>`, and `--detach` checks out any commit on no branch. With --output=path it prints only the directory, for `slot=$(aspect worktree add <branch> --output=path) && cd \"$slot\"`.\n\n    aspect worktree path <branch>\n        Print the directory of a slot you already hold, for the same idiom. Takes a slot id as well as a branch.\n\n    aspect worktree release <branch>\n        End the lease: the worktree goes, the slot keeps its Bazel state for whatever comes next. Refuses a worktree that holds work — uncommitted changes, commits only a detached HEAD has — and names it.\n\n    aspect worktree prune <branch-or-slot>\n        Delete one slot and its Bazel output base, however recently it was used. Refuses a slot somebody is working in.\n\n    aspect worktree prune --dry-run\n        Show which free slots have gone stale, and how long each has been idle. Without --dry-run it asks before deleting anything. For what the disk would actually give back, `aspect output-bases --measure-sizes` reports per-base sizes and `aspect gc` acts on them.",
    implementation = _list_impl,
    traits = [Worktrees],
    args = {
        "all": args.boolean(
            default = False,
            description = "List every pool on this machine rather than this repository's, so one command answers where all your agent sessions are and what each is working on. Works outside a repository too. Only the pool belonging to the clone you run from can be checked against git, so the others report the branch their own records hold; warmth is read from disk for every pool, under the output user root this workspace resolves — named under the listing when this workspace has moved it off Bazel's default.",
        ),
        "verbose": args.boolean(
            default = False,
            description = "Also print, for each slot, its directory, the Bazel output base its path derives to and why one is absent, the pid of any Bazel server holding it, and every holder the slot remembers; then each agent session those holders name, with its project, the command that returns to it, and its leases.",
        ),
    } | _IDENTITY_ARGS | _OUTPUT_ARG,
)

