"""Public entrypoint for the Bazel library. The implementation lives in
`./bazel/*.axl`, one namespace per concern:

- `bazel_flags`: the `--bazel-flag` / `--bazel-startup-flag` args, the
  passthrough buckets, flag resolution and `--config` expansion.
- `bazel_announce`: the `announce_bazel_*` args and their resolution.
- `bazel_rc`: the `Bazelrc` a task's Bazel calls run under — `setup`,
  `sibling`, the post-rc `hook_flags`, and `with_flags`.
- `bazel_invocation`: the `build` / `test` invocation handles and the task arg
  bundles (`args`, `targets_arg`).
- `bazel_exec_log`: the execution-log handle (`open` / `pump` / `close`) and
  its `Hook` type.

Each is a set of stateless functions taking `ctx` and deriving the active
`BazelTrait` from `ctx.traits` themselves. None is named `bazel`, so a file can
load them beside the builtin `bazel` global (`bazel.execution_log`, …) without
an alias.

`BazelTrait`, `ExecLogHook`, `exit_codes`, the retry constants, the
`dispatch_bazel_*` hook dispatchers and `normalize_label` stay top-level: tasks
index `ctx.traits[BazelTrait]`, features construct `ExecLogHook`, tasks driving
their own attempts fire the trait's hooks through `dispatch_bazel_*`, and any AXL
matching labels against the ones tasks report calls `normalize_label`.

A `load` binds privately, so each re-export is an explicit assignment from a
`_`-aliased load.
"""

load("@aspect//bazel/announce.axl", _bazel_announce = "bazel_announce")
load("@aspect//bazel/exec_log.axl", _bazel_exec_log = "bazel_exec_log")
load("@aspect//bazel/flags.axl", _bazel_flags = "bazel_flags")
load("@aspect//bazel/invocation.axl", _bazel_invocation = "bazel_invocation")
load("@aspect//bazel/rc.axl", _bazel_rc = "bazel_rc")
load(
    "@aspect//bazel/trait.axl",
    _BAZEL_RETRY_ATTEMPTS_DESCRIPTION = "BAZEL_RETRY_ATTEMPTS_DESCRIPTION",
    _BazelTrait = "BazelTrait",
    _DEFAULT_BAZEL_RETRY_ATTEMPTS = "DEFAULT_BAZEL_RETRY_ATTEMPTS",
    _ExecLogHook = "ExecLogHook",
    _default_retry = "default_retry",
    _dispatch_bazel_attempt_end = "dispatch_bazel_attempt_end",
    _dispatch_bazel_build_end = "dispatch_bazel_build_end",
    _exit_codes = "exit_codes",
)
load("./private/lib/runnable.axl", _normalize_label = "normalize_label")

bazel_announce = _bazel_announce
bazel_exec_log = _bazel_exec_log
bazel_flags = _bazel_flags
bazel_invocation = _bazel_invocation
bazel_rc = _bazel_rc

BAZEL_RETRY_ATTEMPTS_DESCRIPTION = _BAZEL_RETRY_ATTEMPTS_DESCRIPTION
BazelTrait = _BazelTrait
DEFAULT_BAZEL_RETRY_ATTEMPTS = _DEFAULT_BAZEL_RETRY_ATTEMPTS
ExecLogHook = _ExecLogHook
default_retry = _default_retry
dispatch_bazel_attempt_end = _dispatch_bazel_attempt_end
dispatch_bazel_build_end = _dispatch_bazel_build_end
exit_codes = _exit_codes
normalize_label = _normalize_label
