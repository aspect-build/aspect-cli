"""Console feature: the lines Aspect prints around a task in the terminal.

The terminal is a status surface like the CI ones and takes the same four
args. `template_preset` picks a built-in layout and `templates` overrides
single slots on top of it for every task; `task_presets` and `task_templates`
do the same for one task, keyed by task kind ("lint") or command path
("worktree add"):

    load("@aspect//feature/console.axl", "Console")

    def config(ctx):
        ctx.features[Console].args.template_preset = "compact"
        ctx.features[Console].args.templates = {"header": "▶ {{ label }}"}
        ctx.features[Console].args.task_presets = {"worktree add": "silent"}
        ctx.features[Console].args.task_templates = {
            "lint": {"verdict": "{{ glyph }} lint {{ verb }}{{ timing }}"},
        }

A task with its own preset starts from it alone, without `templates`;
`task_templates` beat everything else, a command path's over its kind's. A
`template_preset` typed on the command line applies to every task, over
`task_presets`.

Or for one run: `aspect test --console:template-preset=compact //...`.

Under a coding agent (any of the environment variables `lib/agent.axl` reads,
such as `CLAUDECODE`, `CODEX_THREAD_ID` or `AI_AGENT`) the default is `agent`
rather than `full`. Setting `template_preset` on the command line or in any
`config.axl`, even to `full`, keeps that default out of it.

The preset also decides whether `INFO:` lines print: `full` and `plain` show
them, `compact`, `agent` and `silent` hide them. `info_lines` forces them on
or off whatever the preset. `WARNING:` and `ERROR:` lines always print.

The runtime does the rendering, so this feature's implementation is empty: the
runtime reads these args after `config.axl` runs and before the header prints.
Disabling the feature leaves the `full` layout in place. Bazel's own output,
warnings and errors, and stdout are never templated.
"""

load("../private/lib/task_template_args.axl", "TASK_PRESET_PRECEDENCE", "task_template_args")

def _console_impl(ctx: FeatureContext):
    pass

Console = feature(
    display_name = "Console",
    summary = "Choose and customize the lines Aspect prints around a task.",
    implementation = _console_impl,
    args = {
        "template_preset": args.string(
            default = "full",
            values = ["full", "plain", "compact", "agent", "silent"],
            description = "Built-in terminal layout: 'full' (the banner, the header, every phase and " +
                          "progress line, and the verdict with its phase breakdown; default), " +
                          "'plain' (the same lines without emojis), 'compact' (the verdict alone, " +
                          "on one line with no phase breakdown), 'agent' (compact without " +
                          "emojis; the default under a coding agent unless this is set on the " +
                          "command line or in config.axl), or 'silent' (nothing; the exit " +
                          "code and the task's own output carry the result). 'compact', " +
                          "'agent' and 'silent' also hide INFO lines; see `info_lines`. On Buildkite the " +
                          "header, phase and verdict lines, and sections a task opens itself, " +
                          "start log sections, so they print under every preset. " + TASK_PRESET_PRECEDENCE,
        ),
        "templates": args.custom(
            dict,
            default = {},
            description = "Jinja2 overrides on top of `template_preset`, keyed by slot: \"banner\" " +
                          "(`line`, `version`, `debug_build`, `docs_url`), \"header\" (`label`), " +
                          "\"phase\" and \"progress\" (`text`, `title`, `emoji`), \"verdict\" " +
                          "(`verdict`, `glyph`, `shortcode`, `verb`, `label`, `exit_code`, `exit`, " +
                          "`elapsed`, `elapsed_ms`, `timing`, `conclusion`, `breakdown`, " +
                          "`plain_breakdown`, `phases`; `timing` and both breakdowns follow " +
                          "--task:timing-summary), and \"section\" (`icon`, `title`), the title of " +
                          "a Buildkite section a task opens itself, such as the Workflows runner " +
                          "metadata. Every slot also gets `buildkite` and `task` (`kind`, `group`, " +
                          "`name`, `path`); all but \"section\", and a \"progress\" update that " +
                          "names no phase, get `highlight_style` and `highlight_reset`, the ANSI " +
                          "codes around the line's highlight (empty when color is off). They apply to every task that renders with " +
                          "`template_preset` (not one with its own `task_presets` entry); one task's own go in " +
                          "`task_templates`. An empty template prints nothing, except on Buildkite, " +
                          "where a line that opens a log section takes the preset's text (or " +
                          "`full`'s). A template that " +
                          "fails to render falls back to the preset's template for that slot.",
        ),
        "info_lines": args.string(
            default = "auto",
            values = ["auto", "true", "false"],
            bare = "true",
            description = "Whether INFO lines print. 'auto' (default) leaves it to the task's preset: " +
                          "shown under 'full' and 'plain', hidden under 'compact', 'agent' and " +
                          "'silent'. 'true' (or a bare --console:info-lines) and 'false' force them " +
                          "on or off; config.axl may also assign True or False. WARNING and ERROR " +
                          "lines always print.",
        ),
    } | task_template_args("silent", "verdict"),
)
