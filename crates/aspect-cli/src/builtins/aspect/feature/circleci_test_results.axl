"""CircleCI test-results upload feature.

Collects Bazel JUnit `test.xml` from BES `test_result` events and uploads
them to CircleCI's runner output test-results API (Tests tab + Insights) via
`circleci.store_test_results`. Separate from `ArtifactUpload` so it toggles
independently. Opt-in (`upload_test_results = "none"` by default); only acts
on CircleCI.
"""

load("@aspect//bazel.axl", "BazelTrait")
load("@aspect//helpers.axl", "file_uri_to_path")
load("../private/lib/artifacts.axl", "should_collect_test", "testlog_dest_dir")
load("../private/lib/bazel_results.axl", "bes_get", "test_result_cached")
load("../private/lib/circleci.axl", "circleci")
load("../private/lib/environment.axl", "detail", "detect_ci", "warn")
load("../private/lib/tar.axl", "tar_create")

def collect_test_xml(ctx, event, strategy: str, entries: dict, upload_failed_attempts: bool) -> None:
    """Record `{dest: {"src", "cached"}}` for each test.xml in a test_result event.

    BEP names every run's, shard's and attempt's file `test.xml`, so dest is
    keyed by `testlog_dest_dir`. Without `upload_failed_attempts` every attempt
    shares one key, so the last collected attempt wins. `cached` covers local
    and remote cache hits. `bes_get` everywhere so an `aborted` payload variant
    no-ops instead of raising.
    """
    if event.kind != "test_result":
        return

    run = bes_get(event.id, "run", 1) or 1
    shard = bes_get(event.id, "shard", 1) or 1
    attempt = bes_get(event.id, "attempt", 1) or 1
    dest_dir = testlog_dest_dir(event.id.label, run, shard, attempt if upload_failed_attempts else 1)

    payload = event.payload
    status = bes_get(payload, "status", "") or ""
    cached = test_result_cached(payload)
    if not should_collect_test(strategy, status, cached):
        return

    for file in (bes_get(payload, "test_action_output", None) or []):
        name = bes_get(file, "name", "") or ""
        if not name.endswith(".xml"):
            continue
        src = file_uri_to_path(ctx.std.env, bes_get(file, "file", "") or "")
        if not src or not ctx.std.fs.exists(src):
            continue
        entries[dest_dir + "/" + name] = {"src": src, "cached": cached}

def _staged_archive_sources(ctx, entries: dict, staging: str, cached_as_skipped: bool) -> dict:
    """`{dest: src}` for the archive; cached XML is rewritten to skipped under
    `staging` when `cached_as_skipped`, leaving the bazel-out originals alone."""
    sources = {}
    for dest, info in entries.items():
        src = info["src"]
        if cached_as_skipped and info["cached"]:
            xml = ctx.std.fs.try_read_to_string(src)
            if xml:
                staged = staging + "/" + dest
                ctx.std.fs.create_dir_all(staged.rsplit("/", 1)[0])
                ctx.std.fs.write(staged, circleci.mark_testcases_skipped(xml, "cached"))
                src = staged
        sources[dest] = src
    return sources

def _build_mtree(sources: dict) -> str:
    """Mtree spec for `tar_create`: one file per entry, dest <- src."""
    lines = ["#mtree"]
    for dest, src in sources.items():
        lines.append("./" + dest + " type=file contents=" + src)
    return "\n".join(lines) + "\n"

def _circleci_test_results_impl(ctx: FeatureContext) -> None:
    """Collect test.xml on build_event; tar.gz + upload on build_end."""
    strategy = ctx.args.upload_test_results
    if strategy == "none" or detect_ci(ctx.std.env) != "circleci":
        return

    cached_as_skipped = ctx.args.cached_as_skipped
    upload_failed_attempts = ctx.args.upload_failed_attempts
    bazel_trait = ctx.traits[BazelTrait]
    entries = {}

    def _on_build_event(ctx, event):
        collect_test_xml(ctx, event, strategy, entries, upload_failed_attempts)

    def _on_build_end(ctx, exit_code):
        if not entries:
            return

        tmpdir = ctx.std.env.var("ASPECT_WORKFLOWS_RUNNER_JOB_TMPDIR") or ctx.std.env.temp_dir()
        staging = ctx.std.fs.mkdtemp(prefix = "aspect-circleci-tr-", parent = tmpdir)
        sources = _staged_archive_sources(ctx, entries, staging, cached_as_skipped)

        archive = tmpdir + "/" + ctx.task.name + "-circleci-test-results.tar.gz"
        if not tar_create(ctx, archive, _build_mtree(sources)):
            warn(ctx.std, "CircleCI test results: failed to build the JUnit archive; skipping upload.")
            ctx.std.fs.remove_dir_all(staging)
            return

        override = ctx.std.env.var("CIRCLECI_TEST_RESULTS_STEP_ID")
        step_id = int(override) if override else None

        result = circleci.store_test_results(ctx, archive, step_id = step_id)
        if ctx.std.fs.exists(archive):
            ctx.std.fs.remove_file(archive)
        ctx.std.fs.remove_dir_all(staging)

        if result.success:
            detail(ctx.std, "Uploaded %d JUnit file(s) to CircleCI test results (step_id=%s, %d bytes)." % (
                result.file_count,
                str(result.step_id),
                result.total_bytes,
            ))
            for problem in result.problems:
                warn(ctx.std, "CircleCI test results parse problem: " + problem)
        else:
            for err in result.errors:
                warn(ctx.std, "CircleCI test results upload failed: " + err)

    bazel_trait.build_event.append(_on_build_event)
    bazel_trait.build_end.append(_on_build_end)

CircleCITestResults = feature(
    display_name = "CircleCI Test Results",
    summary = "Upload Bazel JUnit results to CircleCI's Tests tab.",
    implementation = _circleci_test_results_impl,
    args = {
        "upload_test_results": args.string(
            default = "none",
            values = ["none", "failed", "executed", "all"],
            description = "Which tests' JUnit results to upload to CircleCI: " +
                          "'none' (default), 'failed' (non-passing/flaky only), " +
                          "'executed' (skips cached results), or 'all'.",
        ),
        "cached_as_skipped": args.boolean(
            default = False,
            description = "Report cached tests under 'Skipped' instead of 'Passed' by " +
                          "rewriting each cached testcase with a <skipped> element. Off by " +
                          "default; only meaningful when upload_test_results is 'all'.",
        ),
        "upload_failed_attempts": args.boolean(
            default = False,
            description = "Upload each --flaky_test_attempts attempt as its own file, so an " +
                          "attempt that failed before a passing retry shows as a failure. " +
                          "Off by default: each run and shard uploads its last collected " +
                          "attempt. A cached result carries only its final attempt, so " +
                          "earlier attempts are uploaded only when the test ran.",
        ),
    },
)
