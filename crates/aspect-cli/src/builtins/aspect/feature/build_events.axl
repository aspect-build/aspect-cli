"""Public entry point for the build-events feature.

`BuildEvents` is implemented with the settings trait it writes in the internal
`private/lib/build_events_settings.axl`; this file re-exports it at the stable
public path so user `config.axl` files load it as
`load("@aspect//feature/build_events.axl", "BuildEvents")`.
"""

load("../private/lib/build_events_settings.axl", _BuildEvents = "BuildEvents")

BuildEvents = _BuildEvents
