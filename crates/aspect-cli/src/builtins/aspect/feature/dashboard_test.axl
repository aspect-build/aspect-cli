    _eq("a broken package asked for: one entry", [l for l in got if l.startswith("✗") or l.startswith("──") or l.startswith("  │")], ["── Failures (1) ──", "✗ //le2  analysis · le2/BUILD.bazel:2:1", "  │ syntax error at 'newline': expected ,"])

    # ws/mf (Bazel 9.3.3): a `fail()` in a macro, `Traceback` its header and
    # its BUILD line in the first frame: one entry at that line, with the
    # traceback, the `no such target` errors and the dependent blocked.
    tb = ["Traceback (most recent call last):"]
    frames = ["\tFile \"mf/BUILD.bazel\", line 2, column 10, in <toplevel>", "\t\tbad_macro(name = \"m\")", "\tFile \"mf/defs.bzl\", line 2, column 9, in bad_macro", "\t\tfail(\"bad_macro refuses \" + name)", "Error in fail: bad_macro refuses m"]
    mf_errs = [
