    _eq("the build-aborted line with its root", "Analysis of target '//p2:e' failed; build aborted: Analysis failed" in "\n".join(got), True)

    # ws/an again, as Bazel 9.3.3 streams it: the missing source's own
    # Aborted `unconfigured_label` (`//an:nope.txt`) is no root; the target
