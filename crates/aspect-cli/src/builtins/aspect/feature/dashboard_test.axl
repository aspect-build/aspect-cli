"""Tests for the `Dashboard` feature: its layout helpers, keys and
`render`, and the results pages it links (`results_pages.axl`).

Run with:
  aspect dev test-dashboard

Golden frames of `render` are in crates/aspect-cli/tests/testdata/dashboard;
`aspect dev test-dashboard --update` writes them anew.
"""

load("@aspect//feature/dashboard.axl", "ANSI", "CONTROLS", "KEYS", "action_bar", "action_counts", "action_parts", "action_results", "action_row", "action_rows", "action_seconds", "action_split", "actions_text", "add_lines", "aged_time", "analysing", "attempt_state", "bazel_line", "bep_progress", "blocked_targets", "blocked_text", "bounded_log", "build_progress", "build_row", "built", "cache_hits", "classify", "console_height", "console_lines", "copy_text", "count_aborted", "count_aborted_test", "count_event", "count_spawn", "crumbs", "cut_text", "elapsed", "end_build", "failure_detail", "failure_of", "failure_rows", "failure_summary", "first_unlogged", "fit", "fit_logs", "fold_build", "has_capital", "help_rows", "highlightable", "invocation_lines", "keys_line", "keys_row", "link", "link_at", "link_marks", "link_span_at", "link_spans", "links_row", "local_test_logs", "log_view", "mark_cells", "metrics_lines", "new_build", "new_counts", "new_search", "note_blocked", "note_event", "note_phase", "note_progress", "note_spawn_time", "on_key", "open_in_editor", "open_link", "open_peek", "opens", "output_of", "own_execution_log", "panes_shown", "paste_text", "phase_status", "picked_build", "progress_counts", "refusal", "render", "replay_lines", "report_lines", "reset_attempt", "results_capacity", "reused", "running_actions", "say_note", "scrollbar", "scrolled_rows", "severity", "shares", "short_count", "shown_by", "shown_lines", "shown_tips", "slowest_rows", "slowest_title", "status_row", "step_match", "text_width", "tips_count", "tips_lines", "tips_role", "wrap_line")
load("@std//theme.axl", "theme")
load("../private/lib/results_pages.axl", "ASPECT_PAGE", "BES_PAGE", "bes_results_url", "results_page", "results_pages")

# The style the console's state is drawn in, muted, at the border's end.
ANSI_MUTED = theme.sgr("muted", stream = True)
ANSI_HEADING = theme.sgr("heading", stream = True)

# The roles a running action's time and the header's time are drawn in.
ANSI_ROLES = {role: theme.sgr(role) for role in ("muted", "warning", "error", "strong", "heading", "status_bar")}

def _visible(row):
    """`row` without its escape sequences (`ESC [ … letter`)."""
    out = []
    skipping = False
    for c in row.elems():
        if c == "\x1b":
            skipping = True
        elif skipping:
            if c.isalpha():
                skipping = False
        else:
            out.append(c)
    return "".join(out)

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _screen(ctx, log, **kw):
    """A dashboard's whole state, as the feature keeps it, over `log`."""
    state = {
        "task": "build",
        "phase": "",
        "start_ms": 0,
        "now_ms": 0,
        "frames": 0,
        "progress": [],
        "log": log,
        "errors": [],
        "error_count": 0,
        "scroll": 0,
        "filter": "all",
        "search": new_search(),
        "fails": [],
        "outputs": [],
        "list": "failures",
        "selected": 0,
        "picked": 0,
        "focus": "console",
        "view": None,
        "help": False,
        "zoom": False,
        "mouse": False,
        "unseen": 0,
        "cache": None,
        "countdown_ms": None,
        "re": ctx.std.re,
        "cancelling": False,
        "ended": False,
        "counts": new_counts(),
        "building": True,
        "pages": [],
        "test_counts": {},
        "spread": {},
        "logged_index": None,
    }

    # What the feature's own state starts each attempt with, so a field
    # the tests do not set is still there, as in a real run.
    for key, value in attempt_state(0).items():
        if key not in state:
            state[key] = value
    state.update(kw)
    return state

def _fake_process(have, ran, exit = 0):
    """A `ctx.std.process` with only `have` on PATH, recording each command
    it runs in `ran` as `[argv, what its stdin was given, in writes]`, each
    child exiting with `exit` at once (None: still running)."""

    def command(name):
        run = [[name], []]

        def spawn(cancellation = None):
            ran.append(run)
            pipe = struct(write = lambda t: run[1].append(t), close = lambda: None)
            status = None if exit == None else struct(success = exit == 0, code = exit)
            return struct(
                stdin = lambda: pipe,
                wait = lambda: None,
                try_wait = lambda timeout_ms = 0: status,
            )

        builder = struct(
            args = lambda a: (run[0].extend(a), builder)[1],
            process_group = lambda _: builder,
            stdin = lambda _: builder,
            stdout = lambda _: builder,
            stderr = lambda _: builder,
            spawn = spawn,
        )
        return builder

    return struct(which = lambda n: "/bin/" + n if n in have else None, command = command)

def _role(name):
    return theme.sgr(name, stream = True)

def _fake_env(values):
    return struct(var = lambda k: values.get(k))

_GOLDEN_DIR = "crates/aspect-cli/tests/testdata/dashboard"

def _frame_text(drawn: str) -> str:
    """A rendered frame as its visible rows, one per line, ends trimmed."""
    body = drawn[drawn.find("\x1b[H") + 3:] if "\x1b[H" in drawn else drawn
    return "\n".join([_visible(r).rstrip() for r in body.split("\r\n")]) + "\n"

def _goldens(ctx, view_state, act, update):
    """Golden frames: what `render` draws for the screens a change to the
    layout, keys or output paths must not move by accident. `--update`
    writes them anew; review the diff."""
    fs = ctx.std.fs
    root = ctx.std.env.aspect_root_dir() + "/" + _GOLDEN_DIR
    running = dict(
        progress = ["[3 / 9] 2 actions running", "    Compiling src/a.cc; 3s", "    Linking //app:bin; 1s"],
        now_ms = 12000,
    )
    log = ["INFO: Analyzed 3 targets (12 packages loaded).", "INFO: Found 3 targets...", "src/a.cc:3:1: warning: unused variable", "Building..."]
    tipped = _screen(ctx, ["x"], tips = [
        {"id": "remote-miss", "severity": "suggestion", "title": "41% of actions missed the cache", "body": "Use a remote cache."},
        {"id": "disk-full", "severity": "warning", "title": "the disk is 98% full", "body": ""},
    ], tab = "tips", ended = True, building = False)
    viewed = dict(_screen(ctx, ["console line"], fails = [act], ended = True, building = False, verdict = False), **{k: view_state[k] for k in ["read", "ansi", "controls", "env"] if k in view_state})
    for k in view_state:
        if k not in viewed:
            viewed[k] = view_state[k]
    on_key(viewed, "tab", 10)
    on_key(viewed, "enter", 10)
    analysing = _screen(ctx, log, progress = ["Analyzing: 8000 targets (1 packages loaded, 3879 targets configured)", "[3,830 / 8,563] 16 actions, 15 running", "    Compiling src/a.cc; 3s", "    Linking //app:bin; 1s"], now_ms = 12000)
    analysing["counts"].update(spawns = 1300, spawn_hits = 1100, configured = 3)
    finished = _screen(ctx, log + ["INFO: Build completed successfully, 8563 total actions"], ended = True, verdict = True, building = False, critical = "Linking //app:bin 4.1s", done_total = (8563, 8563, False), inv = {"build_finished": _SUCCESS, "build_metrics": _REUSED})
    finished["counts"].update(configured = 3, built = 3, test_runs = 15, test_cached = 9, tests_passed = 15)
    fold_build(finished, 9000)
    states = [
        ("running", _screen(ctx, log, **running), 100, 30),
        ("analysing-140", analysing, 140, 30),
        ("analysing-80", analysing, 80, 30),
        ("final-140", finished, 140, 30),
        ("final-80", finished, 80, 30),
        ("success", _screen(ctx, log + ["INFO: Build completed successfully, 9 total actions"], ended = True, verdict = True, building = False), 100, 30),
        ("failure", _screen(ctx, log + ["ERROR: Build did NOT complete successfully"], fails = [act], ended = True, verdict = False, building = False), 100, 30),
        ("failures-log", viewed, 100, 30),
        ("tips", tipped, 100, 30),
        ("narrow", _screen(ctx, log, **running), 40, 12),
        ("short", _screen(ctx, log, **running), 100, 10),
        ("keys", _screen(ctx, log, help = True, **running), 100, 30),
    ]
    stale = []
    for name, state, cols, rows in states:
        got = _frame_text(render(state, cols, rows))
        path = "%s/%s.golden" % (root, name)
        if update:
            fs.create_dir_all(root)
            fs.write(path, got)
            continue
        want = fs.read_to_string(path) if fs.exists(path) else None
        if got != want:
            stale.append((name, got, want))
    for name, got, want in stale:
        print("golden frame %s differs (aspect dev test-dashboard --update rewrites it):" % name)
        g, w = got.split("\n"), (want or "").split("\n")
        for i in range(max(len(g), len(w))):
            a = g[i] if i < len(g) else "<none>"
            b = w[i] if i < len(w) else "<none>"
            if a != b:
                print("  row %d\n    got:  %r\n    want: %r" % (i, a, b))
                break
    if stale:
        fail("%d golden frame(s) differ: %s" % (len(stale), ", ".join([s[0] for s in stale])))

# BuildMetrics' action summaries of real Bazel 9.3.3 builds, from their BEP:
# `big` a --keep_going test of 9,301 actions with failures and blocked
# targets, `kg` a small one with a broken genrule, `ok` a successful one.
# Bazel 9's DIGEST_MISMATCH (7), newer than the CLI's protos, reads as its
# number.
_BIG = struct(action_summary = struct(
    actions_executed = 6990,
    runner_count = [struct(name = "total", count = 6990), struct(name = "internal", count = 4390), struct(name = "darwin-sandbox", count = 3200, exec_kind = "Local")],
    action_cache_statistics = struct(hits = 611, misses = 6990, miss_details = [struct(reason = "DIFFERENT_DEPS"), struct(reason = "NOT_CACHED", count = 4107), struct(reason = "UNCONDITIONAL_EXECUTION", count = 447), struct(reason = "7", count = 2436)]),
    action_data = [struct(mnemonic = "Genrule", actions_executed = 4000), struct(mnemonic = "SourceSymlinkManifest", actions_executed = 683), struct(mnemonic = "ExecutableSymlink", actions_executed = 620), struct(mnemonic = "RepoMappingManifest", actions_executed = 602), struct(mnemonic = "TestRunner", actions_executed = 600), struct(mnemonic = "RunfilesTree", actions_executed = 484), struct(mnemonic = "BazelWorkspaceStatusAction", actions_executed = 1), struct(mnemonic = "FileWrite", actions_executed = None)],
    actions_created = 9500,
))
_KG = struct(action_summary = struct(
    actions_executed = 6,
    runner_count = [struct(name = "total", count = 6), struct(name = "internal", count = 5), struct(name = "darwin-sandbox", count = 2, exec_kind = "Local")],
    action_cache_statistics = struct(hits = 4, misses = 6),
    action_data = [struct(mnemonic = "RepoMappingManifest", actions_executed = 1), struct(mnemonic = "SourceSymlinkManifest", actions_executed = 1), struct(mnemonic = "TestRunner", actions_executed = 1), struct(mnemonic = "BazelWorkspaceStatusAction", actions_executed = 1), struct(mnemonic = "ExecutableSymlink", actions_executed = 1), struct(mnemonic = "Genrule", actions_executed = 1), struct(mnemonic = "FileWrite", actions_executed = None), struct(mnemonic = "RunfilesTree", actions_executed = None)],
))
_OK = struct(action_summary = struct(
    actions_executed = 2,
    runner_count = [struct(name = "total", count = 2), struct(name = "internal", count = 1), struct(name = "darwin-sandbox", count = 1, exec_kind = "Local")],
    action_cache_statistics = struct(misses = 2),
))

# A cached build's, as a remote cache leaves one: most of it unchanged.
_REUSED = struct(action_summary = struct(
    actions_executed = 1204,
    runner_count = [struct(name = "total", count = 1204), struct(name = "internal", count = 459), struct(name = "remote cache hit", count = 600), struct(name = "disk cache hit", count = 40), struct(name = "linux-sandbox", count = 105, exec_kind = "Local")],
    action_cache_statistics = struct(hits = 7359, misses = 1204, miss_details = [struct(reason = "NOT_CACHED", count = 1204)]),
))

_SUCCESS = struct(exit_code = struct(name = "SUCCESS", code = 0))
_FAILURE = struct(exit_code = struct(name = "BUILD_FAILURE", code = 1))

# action_data of the cc builds (`build --keep_going //cc:all`).
_CC_DATA = [("CppModuleMap", 6), ("CppCompile", 3), ("RepoMappingManifest", 1), ("CppArchive", 1), ("SymlinkTree", 1), ("CppLink", 1), ("SourceSymlinkManifest", 1), ("BazelWorkspaceStatusAction", 1), ("RunfilesTree", 1)]

# Real Bazel 9.3.3 runs on a pty, from their BEP (build_events.binpb in the
# task history, decoded with protoc): exit, the last `[done / total]` Bazel
# drew (None: never), BuildMetrics' action_summary (actions executed and
# created, runner_count, action cache hits and misses, action_data's
# executed mnemonics), and the type of each action_completed event saying
# an action failed, as the stream posted them.
_REAL = {
    # test //t:all, one sh_test failing: "13 processes: 11 internal, 4 darwin-sandbox".
    "failing test": ("TESTS_FAILED", (13, 13), 13, 17, [("internal", 11), ("darwin-sandbox", 4)], 0, 13, [("SymlinkTree", 2), ("RepoMappingManifest", 2), ("SourceSymlinkManifest", 2), ("TestRunner", 2), ("ExecutableSymlink", 2), ("RunfilesTree", 2), ("BazelWorkspaceStatusAction", 1)], []),
    # build --keep_going //:all, three genrules failing.
    "keep_going": ("BUILD_FAILURE", (45, 45), 45, 45, [("internal", 4), ("darwin-sandbox", 41)], 0, 45, [("Genrule", 44), ("BazelWorkspaceStatusAction", 1)], ["Genrule:spawn", "Genrule:spawn", "Genrule:spawn"]),
    # build --nokeep_going //:all after it: the rest built before, nothing new analysed.
    "nokeep_going incremental": ("BUILD_FAILURE", (45, 45), 4, 0, [("internal", 4)], 0, 4, [("Genrule", 3), ("BazelWorkspaceStatusAction", 1)], ["Genrule:spawn", "Genrule:spawn"]),
    # build --nokeep_going //big:all: the rest of 2,001 cancelled.
    "nokeep_going big": ("BUILD_FAILURE", (1831, 2001), 4, 2001, [("internal", 4)], 1827, 4, [("Genrule", 3), ("BazelWorkspaceStatusAction", 1)], ["Genrule:spawn", "Genrule:spawn", "Genrule:spawn"]),
    # build //anal:all //:ok1, an analysis failure.
    "analysis failure": ("BUILD_FAILURE", (3, 3), 1, 1, [("internal", 1)], 0, 1, [("BazelWorkspaceStatusAction", 1)], []),
    # build --keep_going //infos:all, a BUILD file that does not parse.
    "loading failure, no count": ("BUILD_FAILURE", None, 1, 0, [("internal", 1)], 0, 1, [("BazelWorkspaceStatusAction", 1)], []),
    # test --keep_going //t:all //:all, cached but for a test and a disk hit.
    "tests and genrules, a disk hit": ("BUILD_FAILURE", (52, 52), 5, 50, [("disk cache hit", 1), ("internal", 4), ("darwin-sandbox", 1)], 47, 5, [("Genrule", 3), ("TestRunner", 1), ("BazelWorkspaceStatusAction", 1)], ["Genrule:spawn", "Genrule:spawn", "Genrule:spawn"]),
    # build //infos:all with a new --action_env.
    "success": ("SUCCESS", (14, 14), 14, 13, [("internal", 1), ("darwin-sandbox", 13)], 0, 14, [("Genrule", 13), ("BazelWorkspaceStatusAction", 1)], []),
    # build --keep_going //cc:all, a cc_library failing to compile:
    # "16 processes: 12 internal, 4 darwin-sandbox" (CppModuleMap among them).
    "cc failure": ("BUILD_FAILURE", (17, 17), 16, 23, [("internal", 12), ("darwin-sandbox", 4)], 0, 16, _CC_DATA, ["CppCompile:spawn"]),
    # The same after bazel clean, cold: one done past the summary, all new.
    "cold cc failure": ("BUILD_FAILURE", (17, 17), 16, 24, [("internal", 12), ("darwin-sandbox", 4)], 0, 16, _CC_DATA, ["CppCompile:spawn"]),
    # build --keep_going //mn:all //:ok4: 25 mnemonics, action_data's top 20 only.
    "25 mnemonics": ("BUILD_FAILURE", (53, 53), 53, 52, [("internal", 2), ("darwin-sandbox", 51)], 0, 53, [("Mn%d" % i, 2) for i in range(20)], ["MnBad:spawn"]),
    # build --nokeep_going //:bad //:slow and three more: one failed, the slow one cancelled.
    "nokeep_going cancelled": ("BUILD_FAILURE", (6, 6), 6, 5, [("internal", 3), ("darwin-sandbox", 3)], 0, 6, [("Genrule", 5), ("BazelWorkspaceStatusAction", 1)], ["Genrule:spawn"]),
    # build --keep_going //noout:all: a genrule's spawn succeeds, its output
    # never made: "7 processes: 1 internal, 6 darwin-sandbox".
    "missing output": ("BUILD_FAILURE", (7, 7), 7, 7, [("internal", 1), ("darwin-sandbox", 6)], 0, 7, [("Genrule", 6), ("BazelWorkspaceStatusAction", 1)], ["Genrule:execution"]),
    # Two of them: more failed than internal.
    "two missing outputs": ("BUILD_FAILURE", (8, 8), 8, 8, [("internal", 1), ("darwin-sandbox", 7)], 0, 8, [("Genrule", 7), ("BazelWorkspaceStatusAction", 1)], ["Genrule:execution", "Genrule:execution"]),
    # build --keep_going //two:all //silent:all: three spawns failing.
    "three failing spawns": ("BUILD_FAILURE", (4, 4), 4, 0, [("internal", 4)], 0, 4, [("Genrule", 3), ("BazelWorkspaceStatusAction", 1)], ["Genrule:spawn", "Genrule:spawn", "Genrule:spawn"]),
    # build --keep_going //tool:all: a failing tool and its user, one done past the summary.
    "failing tool": ("BUILD_FAILURE", (9, 9), 8, 9, [("internal", 3), ("darwin-sandbox", 5)], 0, 8, [("Genrule", 7), ("BazelWorkspaceStatusAction", 1)], ["Genrule:spawn", "Genrule:spawn"]),
    # build --keep_going //dc:all with a warm disk cache, one failing.
    "disk cache, one failing": ("BUILD_FAILURE", (8, 8), 8, 8, [("disk cache hit", 6), ("internal", 2)], 0, 8, [("Genrule", 7), ("BazelWorkspaceStatusAction", 1)], ["Genrule:spawn"]),
    # build --keep_going //kinds:all: internal kinds action_data does not
    # name (UnresolvedSymlink), and one genrule's output never made.
    "unnamed kinds, missing output": ("BUILD_FAILURE", (10, 10), 10, 10, [("internal", 6), ("darwin-sandbox", 4)], 0, 10, [("Genrule", 4), ("UnresolvedSymlink", 3), ("FileWrite", 2), ("BazelWorkspaceStatusAction", 1)], ["Genrule:execution"]),
    # build --keep_going //trunc:all: action_data cut to the top 20.
    "truncated kinds, missing output": ("BUILD_FAILURE", (45, 45), 45, 45, [("internal", 2), ("darwin-sandbox", 43)], 0, 45, [("Mn%d" % i, 2) for i in range(20)], ["Genrule:execution"]),
    # build --nokeep_going //nk:all: a missing output, the rest cancelled.
    "nokeep_going, missing output": ("BUILD_FAILURE", (7, 7), 7, 7, [("internal", 3), ("darwin-sandbox", 4)], 0, 7, [("Genrule", 6), ("BazelWorkspaceStatusAction", 1)], ["Genrule:execution"]),
    # build --keep_going --spawn_strategy=standalone //ui:all: a C++ file
    # including an undeclared header: "6 processes: 3 internal, 3 local".
    "undeclared inclusion": ("BUILD_FAILURE", (7, 7), 6, 10, [("internal", 3), ("local", 3)], 0, 6, [("Genrule", 3), ("CppModuleMap", 1), ("BazelWorkspaceStatusAction", 1), ("CppCompile", 1)], ["CppCompile:cpp_compile:UNDECLARED_INCLUSIONS"]),
    # build --keep_going //sym:all: a symlink to a file not executable:
    # "5 processes: 2 internal, 3 darwin-sandbox" (Bazel 7.7.1 to 9.3.3).
    "symlink input": ("BUILD_FAILURE", (5, 5), 5, 5, [("internal", 2), ("darwin-sandbox", 3)], 0, 5, [("Genrule", 3), ("BazelWorkspaceStatusAction", 1), ("ExecutableSymlink", 1)], ["ExecutableSymlink:symlink_action:EXECUTABLE_INPUT_IS_NOT"]),
    # test --keep_going //tb:all, a test's dependency failing: the last
    # frame caught [2 / 2]; Bazel went on to [13 / 13].
    "test build failure, early frame": ("BUILD_FAILURE", (2, 2), 11, 19, [("internal", 10), ("darwin-sandbox", 2)], 0, 11, [("RepoMappingManifest", 2), ("SymlinkTree", 2), ("SourceSymlinkManifest", 2), ("ExecutableSymlink", 1), ("Genrule", 1), ("TestRunner", 1), ("BazelWorkspaceStatusAction", 1), ("RunfilesTree", 1)], ["Genrule:spawn"]),
}

def _real(ctx, name):
    """A finished build's screen state from `_REAL[name]`, its failed
    actions taken in from their events as the feature takes them."""
    exit, done_total, executed, created, runners, hits, misses, data, failed = _REAL[name]
    st = _screen(ctx, ["x"], building = False, ended = True, done_total = (done_total[0], done_total[1], False) if done_total else None, inv = {
        "build_finished": struct(exit_code = struct(name = exit, code = 0 if exit == "SUCCESS" else 1)),
        "build_metrics": struct(action_summary = struct(
            actions_executed = executed,
            actions_created = created,
            runner_count = [struct(name = "total", count = executed)] + [struct(name = n, count = k) for n, k in runners],
            action_cache_statistics = struct(hits = hits, misses = misses),
            action_data = [struct(mnemonic = m, actions_executed = k) for m, k in data],
        )),
    })
    for i, kind in enumerate(failed):
        _fail_event(st, kind, i)
    return st

def _progress_event(st, stderr):
    """A `progress` event whose stderr is `stderr`, as Bazel's console wrote it."""
    note_event(st, "progress", struct(opaque_count = 1), struct(stderr = stderr, stdout = ""), False)

def _failed_records(n):
    """`n` failed genrules as the Failures list has them."""
    return [{"kind": "action", "label": "//x:f%d" % i, "detail": "Genrule", "files": [], "output": "", "success": False} for i in range(n)]

# The code a decoded failure's category had, where a fixture names only it.
_CODES = {"spawn": "NON_ZERO_EXIT", "execution": "ACTION_OUTPUTS_NOT_CREATED"}

def _fail_event(st, kind, i):
    """An `action_completed` event saying action `i` failed, `kind` its
    mnemonic, its failure_detail's category and that's code
    (`CppCompile:cpp_compile:UNDECLARED_INCLUSIONS`; a `spawn` one's
    `NON_ZERO_EXIT`, an `execution` one's `ACTION_OUTPUTS_NOT_CREATED`
    unless named), as the decoded events have them."""
    parts = kind.split(":")
    mnemonic = parts[0]
    how = parts[1] if len(parts) > 1 else ""
    code = parts[2] if len(parts) > 2 else _CODES.get(how, "")
    category = struct(code = code, spawn_exit_code = 1) if how == "spawn" else struct(code = code)
    detail = struct(message = "failed", category = category) if how else None
    note_event(st, "action_completed", struct(label = "//x:f%d" % i, primary_output = "bazel-out/f%d" % i, configuration = None), struct(success = False, type = mnemonic, stderr = None, stdout = None, failure_detail = detail), False)

def _split_of(split):
    return {k: split[k] for k in ("done", "total", "ran", "cached", "unchanged", "internal", "rest", "failed")}

def _actions_tests(ctx):
    """The build's actions in one unit: the bar, Results and Metrics."""

    # Cells shared out in proportion, every part there is any of seen.
    _eq("shares sum to the width", shares([1, 2, 3, 4], 20), [2, 4, 6, 8])
    _eq("largest remainders", shares([1, 1, 1], 10), [4, 3, 3])
    _eq("a part there is any of gets a cell", shares([1, 9998, 1], 10), [1, 8, 1])
    _eq("nothing", shares([0, 0], 5), [0, 0])

    # Mid-build: ran and cached from the execution log's spawns, the rest of
    # the done count other (unchanged, internal, or not yet logged);
    # clamped, as spawns (a test's retried attempts) can outnumber actions.
    mid = _screen(ctx, ["x"], progress = ["[3,830 / 8,563] 16 actions running"])
    mid["counts"].update(spawns = 1300, spawn_hits = 1100)
    split = action_split(mid)
    _eq("mid-build split", _split_of(split), dict(done = 3830, total = 8563, ran = 200, cached = 1100, unchanged = 0, internal = 0, rest = 2530, failed = 0))
    _eq("mid-build sums to the done count", split["ran"] + split["cached"] + split["rest"], 3830)
    _eq("no reuse while it runs", reused(split), None)
    mid["counts"].update(spawns = 5000, spawn_hits = 4000)
    _eq("clamped to the done count", _split_of(action_split(mid)), dict(done = 3830, total = 8563, ran = 0, cached = 3830, unchanged = 0, internal = 0, rest = 0, failed = 0))
    mid["counts"].update(spawns = 5000, spawn_hits = 100)
    _eq("ran clamped too", [action_split(mid)[k] for k in ("ran", "cached", "rest")], [3730, 100, 0])

    # Final: BuildMetrics' exact split, as real builds gave it.
    # r30's big3: 2,000 genrules failed (Failures lists each), 611 action
    # cache hits.
    big = _screen(ctx, ["x"], building = False, ended = True, fails = _failed_records(2000), done_total = (9301, 9301, False), inv = {"build_finished": _FAILURE, "build_metrics": _BIG})
    _eq("a real failed build's split", _split_of(action_split(big)), dict(done = 9301, total = 9301, ran = 2600, cached = 0, unchanged = 2311, internal = 2390, rest = 0, failed = 2000))

    # Real Bazel 9.3.3 builds (`_REAL`): failed are the actions the event
    # stream says failed (a test is none: Tests counts it), taken out of
    # the internal ones Bazel counts them among; what else is there
    # (cancelled) stays internal; what the done count has past the summary
    # is unchanged only where the action cache had hits, else internal.
    for name, want in [
        ("failing test", dict(done = 13, total = 13, ran = 2, cached = 0, unchanged = 0, internal = 11, rest = 0, failed = 0)),
        ("keep_going", dict(done = 45, total = 45, ran = 41, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 3)),
        ("nokeep_going incremental", dict(done = 45, total = 45, ran = 0, cached = 0, unchanged = 41, internal = 2, rest = 0, failed = 2)),
        ("nokeep_going big", dict(done = 1831, total = 2001, ran = 0, cached = 0, unchanged = 1827, internal = 1, rest = 0, failed = 3)),
        ("analysis failure", dict(done = 3, total = 3, ran = 0, cached = 0, unchanged = 2, internal = 1, rest = 0, failed = 0)),
        ("loading failure, no count", dict(done = 1, total = 1, ran = 0, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 0)),
        ("tests and genrules, a disk hit", dict(done = 52, total = 52, ran = 1, cached = 0, unchanged = 47, internal = 1, rest = 0, failed = 3)),
        ("success", dict(done = 14, total = 14, ran = 13, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 0)),
        ("cc failure", dict(done = 17, total = 17, ran = 4, cached = 0, unchanged = 0, internal = 12, rest = 0, failed = 1)),
        ("cold cc failure", dict(done = 17, total = 17, ran = 4, cached = 0, unchanged = 0, internal = 12, rest = 0, failed = 1)),
        ("25 mnemonics", dict(done = 53, total = 53, ran = 51, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 1)),
        ("nokeep_going cancelled", dict(done = 6, total = 6, ran = 3, cached = 0, unchanged = 0, internal = 2, rest = 0, failed = 1)),
        ("missing output", dict(done = 7, total = 7, ran = 5, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 1)),
        ("two missing outputs", dict(done = 8, total = 8, ran = 5, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 2)),
        ("three failing spawns", dict(done = 4, total = 4, ran = 0, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 3)),
        ("failing tool", dict(done = 9, total = 9, ran = 5, cached = 0, unchanged = 0, internal = 2, rest = 0, failed = 2)),
        ("disk cache, one failing", dict(done = 8, total = 8, ran = 0, cached = 6, unchanged = 0, internal = 1, rest = 0, failed = 1)),
        ("unnamed kinds, missing output", dict(done = 10, total = 10, ran = 3, cached = 0, unchanged = 0, internal = 6, rest = 0, failed = 1)),
        ("truncated kinds, missing output", dict(done = 45, total = 45, ran = 42, cached = 0, unchanged = 0, internal = 2, rest = 0, failed = 1)),
        ("nokeep_going, missing output", dict(done = 7, total = 7, ran = 3, cached = 0, unchanged = 0, internal = 3, rest = 0, failed = 1)),
        ("test build failure, early frame", dict(done = 11, total = 11, ran = 1, cached = 0, unchanged = 0, internal = 9, rest = 0, failed = 1)),
        ("undeclared inclusion", dict(done = 7, total = 7, ran = 3, cached = 0, unchanged = 0, internal = 3, rest = 0, failed = 1)),
        ("symlink input", dict(done = 5, total = 5, ran = 3, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 1)),
    ]:
        _eq("real: " + name, _split_of(action_split(_real(ctx, name))), want)

    # Results' ╳ is the stream's failed actions, as decoded, a test's aside;
    # the sum never past the done count Bazel drew.
    for name in _REAL:
        st = _real(ctx, name)
        split = action_split(st)
        decoded = [k for k in _REAL[name][8] if not k.startswith("TestRunner")]
        _eq("╳ is the stream's failed actions: " + name, split["failed"], len(decoded))
        _eq("the parts sum to the done count: " + name, split["ran"] + split["cached"] + split["unchanged"] + split["internal"] + split["failed"], split["done"])

    # Bazel's last count from the event stream's progress, not a frame's.
    late = _real(ctx, "test build failure, early frame")
    for text in ["\x1b[32m[1 / 2]\x1b[0m 1 action running\n", "\r\x1b[1A\x1b[K\x1b[32m[2 / 2]\x1b[0m no actions running\n", "(10:00:00) \x1b[32m[5 / 7]\x1b[0m 2 actions running\n\r\x1b[1A\x1b[K\x1b[32m[13 / 13]\x1b[0m no actions running\n"]:
        _progress_event(late, text)
    _eq("the stream's last count", build_progress(late), (13, 13, False))
    _eq("its split", _split_of(action_split(late)), dict(done = 13, total = 13, ran = 1, cached = 0, unchanged = 0, internal = 11, rest = 0, failed = 1))
    _eq("a frame's while the build runs", build_progress(dict(late, building = True, progress = ["[3 / 9] 1 action running"])), (3, 9, False))
    _eq("no count in it", bep_progress("Analyzing: 3 targets\n"), None)

    # The stream cut short (a remote cache unreachable: "Unable to write
    # all BEP events", exit 34), no BuildMetrics, as r42's run had it:
    # "4 processes: 4 internal", three genrules failed, no spawn logged.
    cut = _screen(ctx, ["x"], building = False, ended = True, done_total = (4, 4, False), inv = {"build_finished": struct(exit_code = struct(name = "REMOTE_ERROR", code = 34))})
    for i in range(3):
        _fail_event(cut, "Genrule:remote_execution:CAPABILITIES_QUERY_FAILURE", i)
    split = action_split(cut)
    _eq("cut short: the known failures", [split[k] for k in ("final", "ran", "rest", "failed", "done")], [False, 0, 1, 3, 4])
    _eq("drawn as failed", [_visible(r) for r in action_results(split, 40)], ["▒ 1 other · ╳ 3 failed"])
    _eq("and on the bar", "╳" in _visible(action_bar(split, 40)), True)
    _eq("not while it runs", action_split(dict(cut, building = True, progress = ["[4 / 4] no actions running"]))["failed"], 0)

    # Every action published (the default), live: r39's run of //dc:all
    # //two:all with --build_event_publish_all_actions posted 14 executed
    # actions: the workspace status with no command line (internal), ten
    # genrules a disk cache served (with one), three that failed. Live, the
    # events and the execution log's hits tell them apart; what the done
    # count has past them is unchanged; the split converges on BuildMetrics'.
    live = _screen(ctx, ["x"], progress = ["[14 / 14] no actions running"])

    def _action(st, i, mnemonic, ok, command):
        payload = struct(success = ok, type = mnemonic, command_line = ["/bin/bash", "-c", "x"] if command else [], stderr = None, stdout = None, failure_detail = None if ok else struct(message = "x", category = struct(code = "NON_ZERO_EXIT", spawn_exit_code = 1)))
        event_id = struct(label = "//dc:a%d" % i, primary_output = "bazel-out/a%d" % i, configuration = None)
        count_event(st["counts"], "action_completed", event_id, payload)
        note_event(st, "action_completed", event_id, payload, False)

    _action(live, 0, "BazelWorkspaceStatusAction", True, False)
    for i in range(1, 11):
        _action(live, i, "Genrule", True, True)
        count_spawn(live["counts"], struct(cache_hit = True, runner = "disk cache hit"))
    half = action_split(dict(live, progress = ["[20 / 30] 3 actions running"]))
    _eq("part told: the rest unchanged so far", [half[k] for k in ("ran", "cached", "internal", "failed", "unchanged", "done")], [0, 10, 1, 0, 9, 20])

    # The execution log late: an action that spawned is ran until its entry
    # says a cache served it; unchanged only what has no event at all.
    late_log = _screen(ctx, ["x"], progress = ["[11 / 14] 3 actions running"])
    _action(late_log, 0, "BazelWorkspaceStatusAction", True, False)
    for i in range(1, 11):
        _action(late_log, i, "Genrule", True, True)
    early = action_split(late_log)
    _eq("before the log: ran", [early[k] for k in ("ran", "cached", "internal", "unchanged")], [10, 0, 1, 0])
    for i in range(6):
        count_spawn(late_log["counts"], struct(cache_hit = True, runner = "disk cache hit"))
    _eq("as entries arrive: cached", [action_split(late_log)[k] for k in ("ran", "cached", "internal", "unchanged")], [4, 6, 1, 0])
    ahead = action_split(dict(late_log, progress = ["[8 / 14] 3 actions running"]))
    _eq("events ahead of the count take from ran", [ahead[k] for k in ("ran", "cached", "internal", "unchanged", "done")], [1, 6, 1, 0, 8])

    for i in range(11, 14):
        _action(live, i, "Genrule", False, True)
    mid_split = action_split(live)
    _eq("live, every action published", [mid_split[k] for k in ("ran", "cached", "internal", "failed", "unchanged", "done")], [0, 10, 1, 3, 0, 14])
    _eq("its parts sum to the bar's total", mid_split["ran"] + mid_split["cached"] + mid_split["internal"] + mid_split["failed"] + mid_split["unchanged"], mid_split["total"])
    _eq("Results name them, no other", [p[2] for p in action_parts(mid_split) if p[1]], ["cached", "internal", "failed"])
    live.update(building = False, ended = True, done_total = (14, 14, False), inv = {"build_finished": _FAILURE, "build_metrics": struct(action_summary = struct(
        actions_executed = 14,
        actions_created = 13,
        runner_count = [struct(name = "total", count = 14), struct(name = "disk cache hit", count = 10), struct(name = "internal", count = 4)],
        action_cache_statistics = struct(hits = 0, misses = 14),
    ))})
    end = action_split(live)
    _eq("converges on BuildMetrics' split", [end[k] for k in ("ran", "cached", "internal", "failed", "unchanged", "done")], [mid_split[k] for k in ("ran", "cached", "internal", "failed", "unchanged", "done")])
    _eq("the ? key: unchanged with every action published", any(["▒ unchanged ·" in r or r.endswith("▒ unchanged") for r in help_rows(dict(live, all_actions = True), 100)]), True)
    _eq("and what other is without", any(["▒ unchanged (while it runs, other: unchanged, internal, or not logged yet)" in r for r in help_rows(dict(live, all_actions = False), 200)]), True)

    tested = _real(ctx, "failing test")
    _fail_event(tested, "TestRunner:spawn", 9)
    _eq("a test's failed action is no ╳", action_split(tested)["failed"], 0)
    _eq("a cold build reuses nothing", reused(action_split(_real(ctx, "cold cc failure"))), 0)

    # Reused counts failed actions as work attempted: (unchanged + cached)
    # of (ran + cached + unchanged + failed), internal ones aside.
    _eq("a disk cache and one failure", reused(action_split(_real(ctx, "disk cache, one failing"))), 6 * 100 // 7)
    _eq("85%", reused(action_split(_real(ctx, "disk cache, one failing"))), 85)
    _eq("four cached, one failed (a cold cc build, its disk cache warm)", reused(dict(action_split(_real(ctx, "cold cc failure")), ran = 0, cached = 4, internal = 11)), 80)
    _eq("the big failed build", reused(action_split(big)), 2311 * 100 // (2600 + 2311 + 2000))

    # A failed build with no action failed never draws a full bar.
    for name in ["failing test", "analysis failure", "loading failure, no count"]:
        st = _real(ctx, name)
        _eq("a cell not done: " + name, "─" in _visible(action_bar(action_split(st), 40)), True)
    _eq("a success's bar is full", "─" in _visible(action_bar(action_split(_real(ctx, "success")), 40)), False)

    # Dynamic execution keeps a ran action; a cached spawn of a test with
    # retried attempts is no reason to halve the cache's.
    def _runners(executed, runners, stats = True):
        st = _screen(ctx, ["x"], building = False, done_total = (executed, executed, False), inv = {"build_finished": _SUCCESS, "build_metrics": struct(action_summary = struct(
            actions_executed = executed,
            runner_count = [struct(name = "total", count = executed)] + [struct(name = n, count = k) for n, k in runners],
            action_cache_statistics = struct(hits = 0, misses = executed) if stats else None,
        ))})
        return action_split(st)

    _eq("dynamic: one ran", [_runners(10, [("remote cache hit", 10), ("linux-sandbox", 10)])[k] for k in ("ran", "cached")], [1, 9])
    _eq("retried test attempts beside cache hits", [_runners(10, [("disk cache hit", 3), ("darwin-sandbox", 12)])[k] for k in ("ran", "cached")], [7, 3])
    _eq("an action cache hit runner without the statistics", _runners(9, [("action cache hit", 7), ("linux-sandbox", 9)], stats = False)["unchanged"], 7)
    kg = _screen(ctx, ["x"], building = False, fails = _failed_records(1), done_total = (11, 11, False), inv = {"build_finished": _FAILURE, "build_metrics": _KG})
    _eq("a real small one", _split_of(action_split(kg)), dict(done = 11, total = 11, ran = 1, cached = 0, unchanged = 5, internal = 4, rest = 0, failed = 1))
    ok = _screen(ctx, ["x"], building = False, done_total = (2, 2, False), inv = {"build_finished": _SUCCESS, "build_metrics": _OK})
    _eq("a real successful one", _split_of(action_split(ok)), dict(done = 2, total = 2, ran = 1, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 0))
    _eq("its done count is the split's sum", _split_of(action_split(dict(ok, done_total = (1, 3, True)))), dict(done = 2, total = 2, ran = 1, cached = 0, unchanged = 0, internal = 1, rest = 0, failed = 0))
    cached = _screen(ctx, ["x"], building = False, ended = True, done_total = (8563, 8563, False), inv = {"build_finished": _SUCCESS, "build_metrics": _REUSED})
    final = action_split(cached)

    # Built something, so the finished screen keeps its panes.
    for st in (big, cached):
        st["counts"]["configured"] = 3
    _eq("a cached build's split", _split_of(final), dict(done = 8563, total = 8563, ran = 105, cached = 640, unchanged = 7359, internal = 459, rest = 0, failed = 0))

    # Reused: cached or unchanged, of what was not internal.
    _eq("reused", reused(final), (7359 + 640) * 100 // (105 + 640 + 7359))
    _eq("reused, 98%", reused(final), 98)
    _eq("nothing to reuse", reused(dict(final, ran = 0, cached = 0, unchanged = 0)), None)
    _eq("one action", actions_text(dict(final, ran = 0, cached = 0, unchanged = 0, internal = 1, done = 1)), ["1 action", "1"])
    _eq("the final label", actions_text(final)[0], "8,563 actions · 98% reused")

    # The bar: a segment of each kind, its own glyph, then what is not done.
    bar = _visible(action_bar(final, 40))
    _eq("final bar glyphs", [bar.count(g) for g in ("█", "▓", "▒", "░", "─")], [1, 3, 34, 2, 0])
    _eq("as wide as asked", text_width(bar), 40)
    mid["counts"].update(spawns = 1300, spawn_hits = 1100)
    bar = _visible(action_bar(action_split(mid), 50))
    _eq("mid-build bar", [bar.count(g) for g in ("█", "▓", "▒", "░", "─")], [1, 6, 15, 0, 28])
    failed_bar = _visible(action_bar(action_split(big), 60))
    _eq("a failed build's", ("╳" in failed_bar, text_width(failed_bar)), (True, 60))

    # Analysing: Bazel's status line under its `Analyzing:` line, a `+`
    # after the total; the status line is no running action.
    both = ["Analyzing: 8000 targets (1 packages loaded, 3879 targets configured)", "[12 / 28] 16 actions, 15 running", "    Executing genrule //x:g0; 0s darwin-sandbox"]
    _eq("the status line under Analyzing", status_row(both), 1)
    _eq("still analysing", analysing(both), True)
    _eq("its running actions", running_actions(both), ["Executing genrule //x:g0; 0s darwin-sandbox"])
    _eq("its counts", action_counts(both), (15, 16))
    meld = _screen(ctx, ["x"], progress = both)
    _eq("analysing: more to come", build_progress(meld), (12, 28, True))
    rows = _visible(render(meld, 140, 30)).split("\n")
    _eq("the bar's +", rows[1].rstrip(" \r").endswith("42% · 12 of 28+"), True)
    _eq("the header has Bazel's status", rows[0].rstrip(" \r").endswith("Analyzing: 8000 targets (1 packages loaded, 3879 targets configured) · 16 actions, 15 running"), True)
    _eq("narrower, shortened", _visible(render(meld, 100, 30)).split("\n")[0].rstrip(" \r").endswith("analyzing · 16 actions, 15 running"), True)
    _eq("zoomed, the count's +", _visible(render(dict(meld, zoom = True), 100, 30)).split("\n")[0].rstrip(" \r").endswith("12 of 28+ actions done"), True)
    note_progress(meld, both)
    meld.update(building = False, progress = [])
    _eq("never analysing once it ended", build_progress(meld), (12, 28, False))

    # No execution log to read (the caller's own): only the done count,
    # nothing called other; at the end BuildMetrics' split.
    own_inv = {"options_parsed": struct(cmd_line = ["--execution_log_binary_file=/tmp/x.binlog"], explicit_cmd_line = [])}
    blind = _screen(ctx, ["x"], progress = ["[3,830 / 8,563] 16 actions running"], inv = own_inv)
    blind["counts"].update(spawns = 0)
    _eq("no log: the done count alone, what runs and what is pending", action_parts(action_split(blind)), [("━", 3830, "done", ""), ("─", 16, "running", "border"), ("", 4717, "pending", "")])

    # While it runs, Results' parts sum to the bar's total: what is not
    # done yet too, the actions running now (the Running pane's count)
    # under the bar's glyph and the rest pending; at the end both are gone.
    def _sums(st):
        sp = action_split(dict(st, building = True))
        total = 0
        for _, n, _, _ in action_parts(sp):
            total += n
        return (total, sp["total"])

    for st in (mid, blind, meld):
        got, want = _sums(st)
        _eq("Results sum to the bar's total", got, want)
    over = dict(mid, progress = ["[8,560 / 8,590] 200 actions running"])
    _eq("more running than not done: clamped, still the total", _sums(over)[0], _sums(over)[1])
    _eq("all of it running", [p[1:3] for p in action_parts(action_split(dict(over, building = True))) if p[2] in ("running", "pending")], [(30, "running"), (0, "pending")])
    lag = dict(mid, progress = ["[8,560 / 8,590] no actions running"])
    _eq("none running: all pending, under the bar's glyph", [p for p in action_parts(action_split(dict(lag, building = True))) if p[2] in ("running", "pending")], [("─", 0, "running", "border"), ("─", 30, "pending", "border")])
    _eq("its sum", _sums(lag)[0], _sums(lag)[1])
    drawn = _visible(render(dict(mid, building = True), 140, 30))
    _eq("drawn, running and pending on one row", "─ 16 running · 4,717 pending" in drawn, True)
    _eq("none at the end", [p for p in action_parts(action_split(cached)) if p[2] in ("running", "pending")], [])
    progress_split = dict(action_split(dict(mid, building = True)), ran = 5691, rest = 2869, cached = 0, done = 8560, total = 8590)
    _eq("Greg's numbers", [_visible(r) for r in action_results(progress_split, 33)], ["█ 5,691 ran · ▒ 2,869 other", "─ 16 running · 14 pending"])
    _eq("at 80 columns, wrapped, words whole", [_visible(r) for r in action_results(progress_split, 26)], ["█ 5,691 ran", "▒ 2,869 other", "─ 16 running · 14 pending"])
    _eq("shorter words only where three rows hold nothing else", [_visible(r) for r in action_results(progress_split, 19)], ["█ 5.6k ran", "▒ 2.8k other", "─ 16 run. · 14 pend."])
    _eq("the ? key names it", any(["─ running · pending" in r for r in help_rows(mid, 100)]), True)
    shown = _visible(render(blind, 140, 30))
    _eq("no log: drawn as done", ("Actions  ━ 3,830 done" in shown, "unchanged" in shown, "━" * 10 in shown), (True, False, True))
    blind.update(building = False, ended = True, inv = dict(own_inv, build_finished = _SUCCESS, build_metrics = _REUSED), done_total = (8563, 8563, False))
    _eq("no log, at the end: BuildMetrics' split", [p[2] for p in action_parts(action_split(blind))], ["ran", "cached", "unchanged", "internal"])

    # Results: each kind in words, its glyph a key before its count; none of
    # a kind there is none of; whole counts where they fit, `k` counts where
    # not, shorter words narrower still, onto a third row rather than
    # dropping any.
    greg = dict(final, ran = 5612, cached = 0, unchanged = 2834, internal = 33, failed = 4, done = 8483, total = 8483)
    _eq("wide", [_visible(r) for r in action_results(greg, 33)], ["█ 5,612 ran · ▒ 2,834 unchanged", "░ 33 internal · ╳ 4 failed"])
    _eq("whole counts in three rows before thousands in two", [_visible(r) for r in action_results(greg, 29)], ["█ 5,612 ran", "▒ 2,834 unchanged", "░ 33 internal · ╳ 4 failed"])
    _eq("in thousands where whole ones fit no three rows", [_visible(r) for r in action_results(dict(greg, internal = 0, failed = 0), 16)], ["█ 5.6k ran", "▒ 2.8k unchanged"])
    _eq("a third row", [_visible(r) for r in action_results(greg, 26)], ["█ 5,612 ran", "▒ 2,834 unchanged", "░ 33 internal · ╳ 4 failed"])
    _eq("shorter words", [_visible(r) for r in action_results(greg, 22)], ["█ 5.6k ran", "▒ 2.8k unch.", "░ 33 int. · ╳ 4 failed"])
    _eq("never a word dropped", "╳ 4 failed" in _visible(action_results(greg, 12)[-1]), True)
    _eq("no kind there is none of", "▓" in "".join([_visible(r) for r in action_results(greg, 80)]), False)
    _eq("nothing at all", action_results(dict(greg, ran = 0, unchanged = 0, internal = 0, failed = 0), 40), [])
    _eq("the glyph alone coloured", action_results(greg, 33)[0].startswith(_role("accent") + "█" + theme.reset + " 5,612 ran"), True)
    _eq("k", [short_count(n) for n in (526, 1999, 48123, 1250000)], ["526", "1.9k", "48k", "1.2M"])
    greg_screen = dict(cached, fails = _failed_records(4), done_total = (8483, 8483, False), inv = {"build_finished": _FAILURE, "build_metrics": struct(action_summary = struct(
        actions_executed = 5649,
        runner_count = [struct(name = "total", count = 5649), struct(name = "internal", count = 37), struct(name = "linux-sandbox", count = 5612)],
        action_cache_statistics = struct(hits = 2834, misses = 5649),
        action_data = [struct(mnemonic = "Genrule", actions_executed = 5616), struct(mnemonic = "SourceSymlinkManifest", actions_executed = 33)],
    ))})
    _eq("the same numbers", _split_of(action_split(greg_screen)), dict(done = 8483, total = 8483, ran = 5612, cached = 0, unchanged = 2834, internal = 33, rest = 0, failed = 4))
    for cols, want in [(140, ["Actions  █ 5,612 ran · ▒ 2,834 unchanged", "         ░ 33 internal · ╳ 4 failed"]), (80, ["Actions  █ 5,612 ran", "         ▒ 2,834 unchanged", "         ░ 33 internal · ╳ 4 failed"])]:
        drawn = _visible(render(greg_screen, cols, 30)).split("\n")
        rows = [r.partition("││ ")[2].rstrip(" │\r") for r in drawn if "││ " in r]
        at = [i for i, r in enumerate(rows) if r.startswith("Actions")][0]
        _eq("Results at %d columns" % cols, rows[at:at + len(want)], want)
    wide_meld = dict(meld, building = True, progress = [both[0], "[3,830 / 8,563] 16 actions, 15 running"])
    _eq("the bar's label at 140 columns", _visible(render(wide_meld, 140, 30)).split("\n")[1].rstrip(" \r").endswith(" 44% · 3,830 of 8,563+"), True)
    _eq("and at 80", _visible(render(wide_meld, 80, 30)).split("\n")[1].rstrip(" \r").endswith(" 3,830/8,563+"), True)

    # Without colour, the glyphs keep the segments apart.
    _eq("one glyph a kind", len({g: 1 for g in ("█", "▓", "▒", "░", "╳", "━", "─")}), 7)

    # Metrics: the done count and what was reused, each kind with what
    # makes it up, the action cache's misses by reason.
    lines = [" ".join(_visible(l).split()) for l in metrics_lines(big)]
    for want in ["done 9,301 · 33% reused", "█ ran 2,600", "darwin-sandbox 3,200 spawns", "▒ unchanged 2,311", "░ internal 2,390", "SourceSymlinkManifest 683", "╳ failed 2,000", "action cache 611 hits · 6,990 misses", "not cached 4,107", "digest mismatch 2,436", "actions created 9,500"]:
        _eq("Metrics has %r" % want, any([l.startswith(want) for l in lines]), True)
    _eq("Genrule is no internal kind", any(["Genrule" in l for l in lines]), False)
    lines = [" ".join(_visible(l).split()) for l in metrics_lines(cached)]
    _eq("a newer miss reason by its name", "digest mismatch 2,436" in [" ".join(_visible(l).split()) for l in metrics_lines(big)], True)
    _eq("no note under a kind there is none of", [l for l in metrics_lines(ok) if "own action cache" in _visible(l)], [])
    _eq("reused in Metrics", "done 8,563 · 98% reused (cached or unchanged, of the work attempted: ran, cached, unchanged or failed)" in lines, True)
    _eq("remote and disk hits apart", ["remote cache hit 600 spawns" in lines, "disk cache hit 40 spawns" in lines], [True, True])
    mid["counts"]["runners"] = {"darwin-sandbox": 200, "remote cache hit": 1100}
    lines = [" ".join(_visible(l).split()) for l in metrics_lines(mid)]
    _eq("mid-build Metrics", ["done 3,830 of 8,563" in lines, "darwin-sandbox 200 spawns" in lines, "▒ other 2,530" in lines, "unchanged, internal, or not yet in the execution log" in lines], [True, True, True, True])

    # Metrics: one spawn, long mnemonics in the column, no kind there is
    # none of, and the internal kinds said to be some where they don't sum.
    lone = _screen(ctx, ["x"], building = False, done_total = (2, 2, False), inv = {"build_finished": _SUCCESS, "build_metrics": struct(action_summary = struct(
        actions_executed = 2,
        runner_count = [struct(name = "total", count = 2), struct(name = "internal", count = 1), struct(name = "a-remarkably-long-runner-name-here", count = 1)],
        action_cache_statistics = struct(misses = 2),
        action_data = [struct(mnemonic = "Symlink", actions_executed = 0)],
    ))})
    lines = [_visible(l) for l in metrics_lines(lone)]
    _eq("one spawn", any(["a-remarkably-long-runner-name-here 1 spawn" == " ".join(l.split()) for l in lines]), True)
    counts_at = [l.rfind(" ") for l in lines if l.startswith("  █ ran") or "a-remarkably-long" in l]
    _eq("in one column", len(counts_at) == 2 and lines[[i for i, l in enumerate(lines) if "a-remarkably-long" in l][0]].index("1 spawn") == [l for l in lines if l.startswith("  █ ran")][0].rindex("1"), True)
    _eq("no cached or unchanged row", [l for l in lines if l.startswith("  ▓") or l.startswith("  ▒")], [])
    _eq("internal kinds partial", any(["and 1 more of kinds this list does not name" in l for l in lines]), True)

    # Results on a short terminal: the tests' cache row, the critical path
    # and then the actions' third row go before the failures' row does.
    short = dict(greg_screen, critical = "Linking //app:bin 4.1s", counts = dict(greg_screen["counts"], test_runs = 15, test_cached = 9, tests_passed = 1400, tests_failed = 100, tests_flaky = 3), fails = _failed_records(4))
    for height in [20, 24, 26, 30]:
        rows = [r.partition("││ ")[2].rstrip(" │\r") for r in _visible(render(short, 80, height)).split("\n") if "││ " in r]
        _eq("Failed kept at %d rows" % height, any([r.startswith("Failed") or r.startswith("✗4 ") for r in rows]), True)
        if height == 30:
            _eq("all there at 30 rows", [any([r.strip().startswith(w) for r in rows]) for w in ("9/15 cached", "Crit", "░ 33 internal")], [True, True, True])

    # The `?` overlay's key to the glyphs, wrapped to the width.
    for width in range(36, 101, 4):
        key = help_rows(greg_screen, width)[-3:]
        _eq("the glyphs' key at %d" % width, [text_width(r) <= width for r in key if r != "Actions"], [True for r in key if r != "Actions"])
    _eq("every glyph keyed", all([g in "".join(help_rows(greg_screen, 40)) for g in ["█", "▓", "▒", "░", "╳"]]), True)

    # Before Bazel counts, the bar says what it is doing; the header no
    # word of its own.
    early = _visible(render(_screen(ctx, ["x"], progress = []), 100, 30)).split("\n")
    _eq("starting once", (early[0].count("starting"), early[1].rstrip(" \r").endswith("starting")), (0, True))

    # A folded build picked with `<`/`>` has its own bar.
    two = _screen(ctx, ["x"], task = "lint", building = False, ended = True, done_total = (2, 2, False), inv = {"build_finished": _SUCCESS, "build_metrics": _OK})
    fold_build(two, 0)
    two.update(done_total = (8563, 8563, False), inv = {"build_finished": _SUCCESS, "build_metrics": _REUSED})
    fold_build(two, 0)
    two.update(panes = True, tab = "metrics")
    bar_of = lambda st: [r for r in _visible(render(st, 140, 30)).split("\n") if len(r) > 1 and list(r.elems())[1] in "█▓▒░╳━─"][0].rstrip(" \r")
    _eq("the newest build's bar", bar_of(two).endswith("8,563 actions · 98% reused"), True)
    two["picked_build"] = 0
    _eq("the picked build's", bar_of(two).endswith("2 actions · 0% reused"), True)

    # Every row of the screen as wide as it, from 40 to 200 columns, while
    # the build runs and at its end.
    for name, st in [("analysing", dict(meld, building = True, progress = both)), ("final", cached), ("failed", big), ("four kinds", greg_screen), ("tests cached", dict(greg_screen, counts = dict(greg_screen["counts"], test_runs = 1500, test_cached = 1200, tests_passed = 1400, tests_failed = 100, tests_flaky = 3))), ("no log", dict(blind, building = True, ended = False, progress = ["[3,830 / 8,563] 16 actions running"]))]:
        for cols in list(range(40, 201, 7)) + [80, 140, 200]:
            frame = render(st, cols, 30)
            body = frame[frame.find("\x1b[H") + 3:]
            drawn = [_visible(r) for r in body.split("\r\n")]
            bad = [(i, text_width(r)) for i, r in enumerate(drawn) if text_width(r) != cols]
            if bad:
                fail("%s at %d columns: rows not as wide as the frame: %r\n%s" % (name, cols, bad, "\n".join(drawn)))

def _impl(ctx: TaskContext) -> int:
    sink = {"aspect_results_url": "https://app.example.com/", "sink_invocation_id": "sink-1"}
    _eq("cli-streamed", results_page("", "", sink), "https://app.example.com/sink-1")
    _eq("cli-streamed wins", results_page("https://bes.example.com", "uuid-1", sink), "https://app.example.com/sink-1")
    _eq("bazel-uploaded", results_page("https://bes.example.com/invocation/", "uuid-1", {}), "https://bes.example.com/invocation/uuid-1")
    _eq("sink without a viewer", results_page("https://bes.example.com", "uuid-1", {"sink_invocation_id": "sink-1"}), "https://bes.example.com/uuid-1")
    _eq("nothing", results_page("", "uuid-1", {}), "")
    _eq("both pages", results_pages("https://bes.example.com/invocation", "uuid-1", sink), [
        (ASPECT_PAGE, "https://app.example.com/sink-1"),
        (BES_PAGE, "https://bes.example.com/invocation/uuid-1"),
    ])
    parsed = struct(payload = struct(cmd_line = ["--bes_results_url=https://old.example.com", "--keep_going", "--bes_results_url=https://new.example.com"]))
    _eq("the last --bes_results_url wins", bes_results_url(parsed), "https://new.example.com")
    _eq("no --bes_results_url", bes_results_url(struct(payload = struct(cmd_line = ["--keep_going"]))), "")
    _eq("bazel streams to aspect", results_pages("https://app.example.com", "uuid-1", {"bes_streamed_by_bazel": True}), [
        (ASPECT_PAGE, "https://app.example.com/uuid-1"),
    ])

    _eq("rows under the status", running_actions(["[1 / 9] 2 actions running", "    a.cc; 1s", "    b.cc; 2s"]), ["a.cc; 1s", "b.cc; 2s"])
    _eq("one action in the status", running_actions(["[18,401 / 18,434] Compiling Rust rlib axl-proto (2 files); 11s darwin-sandbox"]), ["Compiling Rust rlib axl-proto (2 files); 11s darwin-sandbox"])
    _eq("a count, no rows", running_actions(["[5 / 9] 3 actions, 1 running"]), [])
    _eq("none running", running_actions(["[9 / 9] no actions running"]), [])
    _eq("analysis", running_actions(["Analyzing: 3 targets"]), [])
    _eq("nothing", running_actions([]), [])
    _eq("fit pads", fit("ab", 4), "ab  ")
    _eq("fit cuts", fit("abcdef", 4), "abc…")
    _eq("fit nothing", fit("ab", 0), "")
    _eq("fit tabs", fit("a\tb", 5), "a  b ")
    _eq("wide characters are two cells", text_width("→ ✅ ok ✨📋"), 12)
    _eq("a combining mark is none", text_width("e\u0301✔"), 2)
    _eq("fit pads by cells", fit("✅ a", 6), "✅ a  ")
    _eq("fit cuts by cells", fit("ab✅✅✅", 6), "ab✅… ")
    _eq("a wide character never straddles the edge", fit("a✅b", 2), "a…")
    _eq("an emoji selector widens the character before it", text_width("⚠️ x"), 4)
    _eq("a long line is cut by cells", fit("✅" * 5000, 7), "✅✅✅…")
    _eq("zero-width marks past the measured head", fit("a" + "\u0301" * 50 + "b", 3), "a" + "\u0301" * 50 + "b ")
    _eq("everything fits: no scrollbar", scrollbar(10, 10, 0), None)
    bar_rows = scrollbar(100, 10, 0)
    _eq("following: the thumb at the bottom", [r.find("┃") >= 0 for r in bar_rows], [False] * 9 + [True])
    _eq("at the oldest line: at the top", [r.find("┃") >= 0 for r in scrollbar(100, 10, 90)], [True] + [False] * 9)
    _eq("half shown: half the height", len([r for r in scrollbar(20, 10, 5) if r.find("┃") >= 0]), 5)
    _eq("status counts", progress_counts("[5,619 / 13,381] 15 actions running"), (5619, 13381))
    _eq("no status", progress_counts("Analyzing: 3 targets"), None)
    _eq("error", severity("ERROR: x failed"), "error")
    _eq("warning", severity("WARNING: y"), "warning")
    _eq("plain", severity("INFO: z"), "")
    _eq("seconds", elapsed(12500), "12s")
    _eq("minutes", elapsed(62000), "1m02s")
    state = {
        "task": "build",
        "phase": "",
        "start_ms": 0,
        "now_ms": 3000,
        "frames": 1,
        "progress": ["[1 / 2] 1 action running", "    Compiling a.cc; 1s"],
        "log": ["INFO: one", "ERROR: two"],
        "errors": [],
        "scroll": 0,
        "filter": "all",
        "search": new_search(),
        "fails": [],
        "selected": 0,
        "focus": "console",
        "view": None,
        "re": ctx.std.re,
        "cancelling": False,
        "ended": False,
        "counts": new_counts(),
        "building": True,
        "pages": [],
    }
    screen = render(state, 100, 30)
    _eq("drawn from home", screen.startswith("\x1b[H\x1b[K"), True)
    _eq("no row is cleared after it is written", "\x1b[K\r\n" in screen, False)
    _eq("one row per terminal row", screen.count("\r\n"), 29)
    for want in ["aspect build", "Compiling a.cc", "Running (1)", "ERROR: two", "q cancel"]:
        if want not in _visible(screen):
            fail("render: %r missing" % want)
    state["filter"] = "errors"
    if "INFO: one" in render(state, 100, 30) or "errors only" not in render(state, 100, 30):
        fail("render: errors only still shows INFO, or its title is missing")
    for filter, want in [("all", [True, True, True]), ("warnings", [False, True, True]), ("errors", [False, False, True])]:
        _eq("shown_by " + filter, [shown_by(filter, l) for l in ["INFO: x", "WARNING: y", "ERROR: z"]], want)
    aspect_url = "https://app.example.com/i/sink-1"
    bes_url = "https://bes.example.com/invocation/uuid-1"
    state["pages"] = [(ASPECT_PAGE, aspect_url), (BES_PAGE, bes_url)]
    linked = render(state, 100, 30)
    for url in [aspect_url, bes_url]:
        if link(url, "").replace("\x1b]8;;\x1b\\", "") not in linked:
            fail("render: no link to %s" % url)
    _eq("links row", links_row([], 80), "")
    if link(bes_url, "").replace("\x1b]8;;\x1b\\", "") not in links_row(state["pages"], 40):
        fail("links_row: a shortened url still links whole")
    _eq("a tiny terminal still renders", render(state, 20, 8).count("\r\n") <= 7, True)
    state["scroll"] = 0
    state["progress"] = ["[18,401 / 18,434] 3 actions running"]
    for cols in [16, 24, 30, 40, 60]:
        for row in render(state, cols, 20)[len("\x1b[H"):].split("\r\n"):
            visible = row
            for url in [aspect_url, bes_url]:
                visible = visible.replace("\x1b]8;;" + url + "\x1b\\", "")
            visible = visible.replace("\x1b]8;;\x1b\\", "")
            visible = _visible(visible.replace("\x1b[K", "").replace("\x1b[J", ""))
            if len(visible) > cols:
                fail("render at %d columns: a row is %d wide: %r" % (cols, len(visible), visible))
    state["filter"] = "all"
    state["scroll"] = 1000
    render(state, 100, 30)
    _eq("scrolling stops at the top", state["scroll"], 0)
    state["log"] = ["line %d" % i for i in range(200)]
    render(state, 100, 30)
    page = console_height(state, 100, 30)
    shown = [l for l in render(state, 100, 30).split("\r\n") if l.find("line ") >= 0]
    _eq("a page is the lines the console shows", page, len(shown))
    _eq("a scrolled console has a scrollbar", len([l for l in shown if l.find("┃") >= 0]) > 0, True)
    state["log"] = ["→ ✅ Passed ✨ step %d " % i + "x" * 95 for i in range(200)]
    for row in render(state, 100, 30).split("\r\n"):
        if row.find("step ") >= 0:
            _eq("a row of wide characters is the screen's width", text_width(_visible(row)), 100)
    state["search"] = new_search()
    state["search"]["open"] = True
    state["search"]["query"] = "日本語" * 30
    bar_row = render(state, 100, 30).split("\r\n")[-1]
    _eq("a wide query keeps the search bar within the screen", text_width(_visible(bar_row)) <= 100, True)
    state["search"] = new_search()
    state["log"] = ["line %d" % i for i in range(200)]
    state["scroll"] = 0
    state["search"] = new_search()
    on_key(state, "b", page)
    _eq("b scrolls up one console height", state["scroll"], page)
    _eq("a smaller terminal, a smaller page", console_height(state, 100, 20) < page, True)
    state["progress"] = ["[1 / 9] 8 actions running"] + ["    a%d; 1s" % i for i in range(8)]
    crowded = render(state, 100, 18)
    if "Running (8)" not in crowded or "more" not in crowded:
        fail("render: a crowded pane should count every action and say how many more")

    for status, want in [
        ("[1 / 9] 300 actions running", (300, 300)),
        ("[1,204 / 9,000] 400 actions, 300 running", (300, 400)),
        ("[1 / 9] 16 actions, 8 running", (8, 16)),
        ("[10,797 / 18,453] 14 / 39 tests; 16 actions, 15 running; last test: //a:b", (15, 16)),
        ("[5 / 9] 3 / 9 tests; 4 actions running; last test: //a:b", (4, 4)),
        ("[1 / 9,000] 2,400 actions, 1,200 running", (1200, 2400)),
        ("[5 / 9] 1 action running", (1, 1)),
        ("[5 / 9] Compiling a.cc; 3s remote", (-1, -1)),
        ("[9 / 9] no actions running", (-1, -1)),
    ]:
        _eq("action_counts %r" % status, action_counts([status]), want)
    state["progress"] = ["[1,204 / 9,000] 400 actions, 300 running"] + ["    a%d; 1s remote" % i for i in range(8)]
    remote = render(state, 100, 30)
    if "Running (300 of 400 started)" not in remote or "and 292 more" not in remote:
        fail("render: a remote build's pane should count all 300, the 400 started, and the 292 it has no room for")

    counts = new_counts()
    target = struct(label = "//a:a")
    count_event(counts, "target_configured", target, struct())
    count_event(counts, "target_configured", struct(label = "//a:a", aspect = "//x:x.bzl%y"), struct())
    count_event(counts, "target_completed", target, struct(success = True))
    count_event(counts, "target_completed", struct(label = "//b:b"), struct(success = False))
    count_aborted(counts, "//c:c", "skipped")
    count_aborted(counts, "//d:d", "analysis_failure")
    count_aborted(counts, "//d:d", "analysis_failure")
    count_aborted(counts, "", "loading_failure")
    count_event(counts, "target_completed", struct(label = "//a:a", aspect = "//x:x.bzl%y"), struct(success = False))
    count_event(counts, "test_summary", struct(label = "//t:pass"), struct(overall_status = "passed"))
    count_event(counts, "test_summary", struct(label = "//t:flaky"), struct(overall_status = "flaky"))
    count_event(counts, "test_summary", struct(label = "//t:fail"), struct(overall_status = "failed"))
    count_event(counts, "test_summary", struct(label = "//t:none"), struct(overall_status = "no_status"))
    count_event(counts, "progress", None, None)
    _eq("counts", (counts["configured"], counts["built"], counts["failed"], counts["skipped"], counts["tests_passed"], counts["tests_failed"], counts["tests_flaky"]), (1, 1, 2, 1, 1, 1, 1))
    _eq("a flaky test noted", counts["flaky"], {"//t:flaky": True})
    _eq("failures", counts["failures"], ["//b:b", "//d:d", "//t:fail"])
    count_event(counts, "target_completed", struct(label = "//t:fail"), struct(success = False))
    _eq("a label is listed once", len([l for l in counts["failures"] if l == "//t:fail"]), 1)
    interrupted = []
    keys = {"scroll": 0, "log": ["x"] * 40, "filter": "all", "search": new_search(), "fails": [], "selected": 0, "focus": "console", "view": None, "re": ctx.std.re, "cancelling": False, "ended": False, "screen": struct(interrupt = lambda: interrupted.append(1))}
    steps = [("up", 1), ("shift-up", 6), ("ctrl-u", 11), ("b", 21), ("down", 20), ("ctrl-d", 15), (" ", 5), ("shift-down", 0), ("j", 0), ("k", 1), ("J", 0), ("K", 1 << 30), ("J", 0), ("home", 1 << 30), ("end", 0), ("pageup", 10), ("end", 0)]
    for key, want in steps:
        on_key(keys, key, 10)
        _eq("scroll after %r" % key, keys["scroll"], want)
    keys["scroll"] = 3
    for want in ["warnings", "errors", "all"]:
        on_key(keys, "e", 10)
        _eq("e: the next filter, at the newest", (keys["filter"], keys["scroll"]), (want, 0))
    on_key(keys, "q", 10)
    on_key(keys, "q", 10)
    _eq("q interrupts once", (keys["cancelling"], len(interrupted)), (True, 1))
    keys["cancelling"] = False
    keys["ended"] = True
    on_key(keys, "q", 10)
    _eq("q after the end does nothing", len(interrupted), 1)
    cancelled = []
    rooted = dict(keys, ended = False, cancelling = False, cancellation = struct(root = struct(cancel = lambda: cancelled.append(1))))
    on_key(rooted, "q", 10)
    on_key(rooted, "q", 10)
    _eq("q cancels the run's root once, no SIGINT", (len(cancelled), len(interrupted)), (1, 1))

    # The search bar: typed into live, a regex, toggles, Enter keeps, Esc clears.
    find = {"scroll": 4, "filter": "all", "search": new_search(), "fails": [], "selected": 0, "focus": "console", "view": None, "re": ctx.std.re, "cancelling": False, "ended": False, "log": [
        "INFO: Build ok",
        "ERROR: //a:b failed",
        "WARNING: //a:c deprecated",
        "ERROR: //a:d FAILED to build",
    ]}
    on_key(find, "ctrl-f", 10)
    _eq("ctrl-f opens the bar, finding", (find["search"]["open"], find["search"]["mode"]), (True, "jump"))
    on_key(find, "tab", 10)
    _eq("tab in the bar filters instead", find["search"]["mode"], "filter")
    for c in "fail".elems():
        on_key(find, c, 10)
    _eq("typed live, any case", console_lines(find, find["log"]), ["ERROR: //a:b failed", "ERROR: //a:d FAILED to build"])
    _eq("typing goes back to the newest line", find["scroll"], 0)
    on_key(find, "q", 10)
    _eq("q types while the bar is open", (find["search"]["query"], find["cancelling"]), ("failq", False))
    on_key(find, "backspace", 10)
    on_key(find, "ctrl-t", 10)
    _eq("case-sensitive", console_lines(find, find["log"]), ["ERROR: //a:b failed"])
    on_key(find, "alt-c", 10)
    on_key(find, "ctrl-b", 10)
    _eq("whole words: 'fail' is not 'failed'", console_lines(find, find["log"]), [])
    on_key(find, "alt-w", 10)
    saved = find["search"]["query"]
    for c in " more words".elems():
        on_key(find, c, 10)
    on_key(find, "ctrl-w", 10)
    _eq("Ctrl+W deletes a word", find["search"]["query"], saved + " more ")
    on_key(find, "alt-backspace", 10)
    _eq("as does Alt+Backspace, in the bar", (find["search"]["query"], find["search"]["open"]), (saved + " ", True))
    on_key(find, "ctrl-u", 10)
    for c in "a:(b|c".elems():
        on_key(find, c, 10)
    _eq("an unclosed group: the error, the last good pattern kept", (find["search"]["error"] != "", find["search"]["pattern"].pattern), (True, "a:"))
    on_key(find, ")", 10)
    _eq("a regex", console_lines(find, find["log"]), ["ERROR: //a:b failed", "WARNING: //a:c deprecated"])
    find["filter"] = "errors"
    _eq("with the e filter too", console_lines(find, find["log"]), ["ERROR: //a:b failed"])
    find["filter"] = "all"
    on_key(find, "up", 10)
    _eq("the arrows still scroll", (find["scroll"], find["search"]["query"]), (1, "a:(b|c)"))
    on_key(find, "enter", 10)
    _eq("enter closes the bar and keeps the filter", (find["search"]["open"], len(console_lines(find, find["log"]))), (False, 2))
    on_key(find, "/", 10)
    on_key(find, "esc", 10)
    _eq("esc clears it", (find["search"]["open"], console_lines(find, find["log"])), (False, find["log"]))

    # Drawn: matches highlighted, the bar fits, at any width.
    state["log"] = find["log"]
    state["search"] = new_search()
    state["search"]["open"] = True
    state["search"]["query"] = "fail"
    state["search"]["pattern"] = ctx.std.re.compile("fail", case_sensitive = False)
    drawn = render(state, 100, 30)
    if theme.sgr("search.match", stream = True) + "fail" + theme.reset not in drawn or "/fail/ 2" not in _visible(drawn) or "2 matches" not in _visible(drawn):
        fail("render: search matches, title or bar missing")
    state["search"]["query"] = "fail(x"
    if "/fail/ 2" not in render(state, 100, 30):
        fail("render: the title shows a query that does not compile, not the pattern filtering")
    state["search"]["query"] = "a very long query that will not fit in a narrow terminal at all"
    for cols in [12, 20, 40, 80]:
        last = render(state, cols, 20).split("\r\n")[-1]
        last = _visible(last)
        if len(last) > cols:
            fail("search bar at %d columns is %d wide: %r" % (cols, len(last), last))
    _eq("re.check", (ctx.std.re.check("ok"), ctx.std.re.check("(") != None), (None, True))
    _eq("re.check takes compile's options", ctx.std.re.check("(?x)a # c", whole_word = True) != None, True)

    # Esc then a key, read together as Alt: the two keys. A paste types into
    # the bar on one line, never as Enter or commands.
    keyed = {"scroll": 0, "filter": "all", "search": new_search(), "fails": [], "selected": 0, "focus": "console", "view": None, "re": ctx.std.re, "cancelling": False, "ended": False, "log": []}
    on_key(keyed, "/", 10)
    on_key(keyed, "alt-j", 10)
    _eq("esc+j: the bar closed, then j scrolls", (keyed["search"]["open"], keyed["scroll"]), (False, 0))
    on_key(keyed, "/", 10)
    on_key(keyed, "alt-c", 10)
    _eq("alt-c in the bar toggles case", (keyed["search"]["open"], keyed["search"]["case"]), (True, True))
    on_key(keyed, "paste:a\nq", 10)
    _eq("a paste on one line", (keyed["search"]["query"], keyed["search"]["open"], keyed["cancelling"]), ("a q", True, False))
    _eq("a paste's control characters are dropped", paste_text("paste:a\x1b[2J\x08b\r\nc"), "a[2Jb  c")
    _eq("and C1 controls, but not other text", paste_text("paste:x\u009by\u0085é"), "xyé")
    closed = {"scroll": 0, "filter": "all", "search": new_search(), "fails": [], "selected": 0, "focus": "console", "view": None, "re": ctx.std.re, "cancelling": False, "ended": False, "log": []}
    on_key(closed, "paste:q", 10)
    _eq("a paste with the bar closed does nothing", (closed["cancelling"], closed["search"]["query"]), (False, ""))

    # The finished screen: q, Enter or Esc leave; with the bar open they are
    # its keys, and an Esc read with q (Alt) closes the bar, then q leaves.
    done = {"scroll": 0, "filter": "all", "search": new_search(), "fails": [], "selected": 0, "focus": "console", "view": None, "re": ctx.std.re, "cancelling": False, "ended": True, "log": []}
    for key, want in [("q", True), ("enter", True), ("esc", True), ("alt-j", True), ("j", False)]:
        _eq("finished, bar closed: %s" % key, on_key(done, key, 10), want)
    for key, want in [("q", False), ("enter", False), ("esc", False), ("alt-c", False)]:
        done["search"] = new_search()
        done["search"]["open"] = True
        _eq("finished, bar open: %s" % key, on_key(done, key, 10), want)
    done["search"] = new_search()
    done["search"]["open"] = True
    _eq("finished, bar open: alt-q", on_key(done, "alt-q", 10), True)
    done["search"] = new_search()
    done["search"]["open"] = True
    _eq("finished, bar open: alt-j closes the bar, stays", (on_key(done, "alt-j", 10), done["search"]["open"]), (False, False))

    # The bar shows a query that fits whole, and highlighting never lights
    # the padding.
    state["search"] = new_search()
    state["search"]["open"] = True
    state["search"]["query"] = "abcdefghijklmnop"
    if "abcdefghijklmnop" not in render(state, 60, 20).split("\r\n")[-1]:
        fail("search bar: a query that fits was cut")
    state["search"] = new_search()
    state["search"]["query"] = " "
    state["search"]["pattern"] = ctx.std.re.compile(" ")
    state["log"] = ["a b"]
    if _role("search.match") + " " + theme.reset + _role("search.match") + " " + theme.reset in render(state, 60, 20):
        fail("render: a highlight lit a row's padding")
    _eq("re.highlight", ctx.std.re.compile("b+").highlight("abbcb", "<", ">"), "a<bb>c<b>")

    # Failures: records from events, their logs found and shown.
    _eq("a passing action is no failure", failure_of("action_completed", struct(label = "//a:a"), struct(success = True)), None)
    act = failure_of("action_completed", struct(label = "//pkg:broken"), struct(
        success = False,
        type = "Genrule",
        stderr = struct(file = "file:///tmp/err"),
        stdout = struct(file = "file:///tmp/out"),
    ))
    _eq("a failed action", (act["label"], act["detail"], [n for n, _ in act["files"]]), ("//pkg:broken", "Genrule", ["stderr", "stdout"]))
    for status in ["passed", "incomplete", "no_status"]:
        _eq("a %s attempt is no failure" % status, failure_of("test_result", struct(label = "//t:t"), struct(status = status)), None)
    for status in ["failed", "timeout", "tool_halted_before_testing"]:
        _eq("a %s attempt is a failure" % status, failure_of("test_result", struct(label = "//t:t"), struct(status = status)) != None, True)
    cfg = struct(id = "c1")
    flaky = failure_of("test_result", struct(label = "//t:t", run = 1, shard = 2, attempt = 1, configuration = cfg), struct(
        status = "failed",
        test_action_output = [struct(name = "test.xml", file = "x"), struct(name = "test.log", file = "bytestream://cache/blobs/abc/1")],
    ))
    _eq("a failed attempt keeps its test.log", (flaky["detail"], flaky["shard"], [n for n, _ in flaky["files"]]), ("attempt 1", 2, ["test.log"]))

    fs = {
        "spread": {},
        "exec_root": "/x",
        "output_dirs": {"c1": "k8-opt"},
        "test_counts": {("//t:t", "c1"): (1, 2)},
        "last_attempts": {("//t:t", "c1", 1, 2): 2},
    }
    _eq("an earlier attempt's log", local_test_logs(fs, flaky), ["/x/bazel-out/k8-opt/testlogs/t/t/shard_2_of_2/test_attempts/attempt_1.log"])
    fs["last_attempts"] = {}
    _eq("the last attempt's, once summarised", local_test_logs(fs, flaky), ["/x/bazel-out/k8-opt/testlogs/t/t/shard_2_of_2/test.log"])
    fs["test_counts"] = {}
    shard_state = {"test_counts": {("//t:t", "c1"): (1, 4)}, "spread": {}}
    _eq("a sharded test's attempt names its shard", failure_detail(shard_state, flaky), "shard 2 · attempt 1")
    _eq("an unsharded one, its attempt alone", failure_detail({"test_counts": {("//t:t", "c1"): (1, 0)}, "spread": {}}, dict(flaky, shard = 1)), "attempt 1")
    before = {"test_counts": {}, "spread": {("//t:t", "c1"): (3, 2)}}
    _eq("before the summary, from what was seen: shard and run", failure_detail(before, dict(flaky, shard = 1, run = 3)), "shard 1 · run 3 · attempt 1")
    _eq("runs alone", failure_detail({"test_counts": {}, "spread": {("//t:t", "c1"): (2, 1)}}, dict(flaky, shard = 1, run = 2)), "run 2 · attempt 1")
    _eq("an action, its mnemonic", failure_detail(shard_state, act), "Genrule")
    _eq("before the summary, no guess", (local_test_logs(fs, flaky), local_test_logs(fs, dict(flaky, shard = 1))), ([], []))
    early = log_view(dict(fs, read = lambda p, c: None, ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), env = ctx.std.env), flaky)
    _eq("and the view says when it will be", early["lines"], ["(test.log is found once the test has finished: a remote cache names it)"])

    # The bookkeeping: an aborted summary has no counts; a real one shows an
    # open log anew.
    noted = dict(fs, read = lambda p, c: ("attempt one\n", 0) if p.endswith("test_attempts/attempt_1.log") else None, ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), env = ctx.std.env, fails = [], outputs = [], view = None, search = new_search(), scroll = 0)
    noted["test_counts"] = {}
    noted["last_attempts"] = {}
    noted["spread"] = {}
    tid = struct(label = "//t:t", run = 1, shard = 1, attempt = 1, configuration = cfg)
    remote_log = [struct(name = "test.log", file = "bytestream://cache/blobs/abc/1")]
    note_event(noted, "test_result", tid, struct(status = "failed", test_action_output = remote_log), False)
    note_event(noted, "test_result", struct(label = "//t:t", run = 1, shard = 1, attempt = 2, configuration = cfg), struct(status = "passed"), False)
    noted["view"] = log_view(noted, noted["fails"][0])
    note_event(noted, "test_summary", struct(label = "//t:t", configuration = cfg), struct(), True)
    _eq("an aborted summary counts nothing", noted["test_counts"], {})
    noted["scroll"] = 5
    noted["search"]["back"] = 0
    note_event(noted, "test_summary", struct(label = "//t:t", configuration = cfg), struct(run_count = 1, shard_count = 1), False)
    _eq("a real one shows the open log anew", noted["view"]["lines"], ["attempt one"])
    _eq("from its end, no current match", (noted["scroll"], noted["search"]["back"]), (0, -1))
    note_event(noted, "test_result", struct(label = "//t:t", run = 3, shard = 2, attempt = 1, configuration = cfg), struct(status = "passed"), False)
    _eq("note_event keeps the most runs and shards seen", noted["spread"][("//t:t", "c1")], (3, 2))
    retried = dict(noted, fresh = True, scroll = 7, focus = "failures", log = ["x"], errors = ["y"], error_count = 1, search = new_search())
    reset_attempt(retried, 42)
    retried["selected"] = 3
    retried["bazel_uuid"] = "old"
    retried["search"] = dict(new_search(), query = "kept")
    retried["filter"] = "errors"
    reset_attempt(retried, 42)
    _eq("a retry starts afresh", (retried["fails"], retried["view"], retried["focus"], retried["scroll"], retried["log"], retried["test_counts"], retried["start_ms"], retried["fresh"]), ([], None, "console", 0, [], {}, 42, False))
    _eq("its counts and the rest too", (retried["counts"], retried["errors"], retried["error_count"], retried["last_attempts"], retried["selected"], retried["bazel_uuid"], retried["spread"]), (new_counts(), [], 0, {}, 0, "", {}))
    _eq("the logged index is cleared", retried["logged_index"], None)
    _eq("but not what is the run's", (retried["exec_root"], retried["output_dirs"], retried["search"]["query"], retried["filter"], retried["read"] != None), ("/x", {"c1": "k8-opt"}, "kept", "errors", True))
    other = log_view(noted, act)
    noted["view"] = other
    note_event(noted, "test_summary", struct(label = "//t:t", configuration = cfg), struct(run_count = 1, shard_count = 1), False)
    _eq("another failure's open view is left alone", noted["view"] == other, True)
    fails_before = len(noted["fails"])
    note_event(noted, "test_result", struct(label = "//t:t", run = 1, shard = 1, attempt = 9, configuration = cfg), struct(), True)
    _eq("an aborted attempt adds nothing", (len(noted["fails"]), noted["last_attempts"].get(("//t:t", "c1", 1, 1))), (fails_before, 2))
    _eq("two-byte escapes go whole", ctx.std.re.compile(ANSI).replace("a\x1b7b\x1b8c\x1b=d", ""), "abcd")
    _eq("and C1 controls", ctx.std.re.compile(CONTROLS).replace("a\u009bb\u0085c", ""), "abc")
    _eq("a lone ESC before other text, as the view cleans a line", ctx.std.re.compile(CONTROLS).replace(ctx.std.re.compile(ANSI).replace("\x1bé", ""), ""), "é")
    _eq("printable Latin-1 stays", ctx.std.re.compile(CONTROLS).replace(" é ñ", ""), " é ñ")

    files = {
        "/x/bazel-out/k8-opt/testlogs/t/t/test.log": ("\x1b[31mFAIL\x1b(B\x1b[m: boom\r\n10%\r50%\r100%\x07\nlast line\n", 0),
        "/tmp/err": ("ERROR: broken\n", 2048),
        "/tmp/out": ("some out\n", 0),
    }
    view_state = dict(fs, read = lambda path, cap: files.get(path), ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), env = ctx.std.env)
    view_state["test_counts"] = {("//t:t", "c1"): (1, 1)}
    one_shard = dict(flaky, shard = 1)
    _eq(
        "a remote cache's test.log, from the output tree; escapes, CRs and controls gone",
        log_view(view_state, one_shard)["lines"],
        ["FAIL: boom", "100%", "last line"],
    )
    _eq("a cut log from its next line", cut_text("xtail of one\nnext\nlast\n"), "next\nlast\n")
    _eq("a cut at a line's start keeps that line", cut_text("\nnext\nlast\n"), "next\nlast\n")
    _eq("its only newline its end: from a character", cut_text("x\ufffdone long line\n"), "one long line\n")
    _eq("no newline at all", cut_text("x\ufffdabc"), "abc")

    # Inline contents: bounded at once, shown from a line's start.
    big = bounded_log(bytes("first\nsecond\nthird\n"), cap = 9)
    _eq("inline bytes over the cap: the end and the byte before", (str(big[0]), big[1]), ("ond\nthird\n", True))
    _eq("under it, whole", str(bounded_log(bytes("ok\n"), cap = 9)[0]), "ok\n")
    inline_rec = {"kind": "action", "label": "//i:i", "detail": "Genrule", "files": [("stderr", big)]}
    v_inline = log_view(dict(fs, read = lambda p, c: None, ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), env = ctx.std.env), inline_rec)
    _eq("an inline log in the view", (v_inline["lines"], v_inline["cut"]), (["third"], True))
    _eq("an action's mnemonic defaults", failure_of("action_completed", struct(label = "//a:a"), struct(success = False))["detail"], "Action")
    v = log_view(view_state, act)
    _eq("an action's stderr and stdout, divided; a cut file says so", (v["lines"], v["cut"]), (["── stderr ──", "ERROR: broken", "── stdout ──", "some out"], True))
    _eq("logs that fit are whole", fit_logs([["a"] * 3, ["b"] * 2], 10), [3, 2])
    _eq("a short log's share goes to a long one", fit_logs([["a"] * 6000, ["b"]], 5000), [4999, 1])
    _eq("no logs", fit_logs([], 5000), [])
    _eq("ties, an odd remainder, in order", fit_logs([["a"] * 3000, ["b"] * 3000, ["c"] * 3000], 5000), [1666, 1667, 1667])
    _eq("two long ones split it", fit_logs([["a"] * 4000, ["b"] * 4000], 5000), [2500, 2500])
    _eq("one, over", fit_logs([["a"] * 6000], 5000), [5000])
    files["/tmp/big"] = ("\n".join(["e%d" % i for i in range(6000)]) + "\n", 0)
    big_view = log_view(view_state, dict(act, files = [("stderr", "file:///tmp/big"), ("stdout", "file:///tmp/out")]))
    _eq("a long stderr keeps its divider and its end", (big_view["lines"][0], big_view["lines"][1], big_view["lines"][-3:], big_view["cut"]), ("── stderr ──", "e1001", ["e5999", "── stdout ──", "some out"], True))
    gone = dict(act, files = [("stderr", "file:///nowhere")], output = "bazel-out/x")
    _eq("a log Bazel removed, nothing kept", log_view(view_state, gone)["lines"], ["(stderr is gone: Bazel removed it, and the history keeps no action logs; --history:action-logs=failed keeps a copy)"])
    _eq("a log only in the remote cache", log_view(view_state, dict(gone, files = [("stderr", "bytestream://cache/blobs/1")]))["lines"], ["(stderr is not on this machine: only in the remote cache)"])
    files["/history/kept.stderr"] = ("ERROR: kept\n", 0)
    keeping = dict(view_state, build = struct(kept_action_log = lambda output: {"stderr": "/history/kept.stderr"} if output == "bazel-out/x" else {}))
    _eq("the history's copy, though Bazel removed its own", log_view(keeping, gone)["lines"], ["ERROR: kept"])
    keeping["build"] = struct(kept_action_log = lambda output: {})
    _eq("a log gone with no copy", log_view(keeping, gone)["lines"], ["(stderr is gone: Bazel removed it, and the history has no copy)"])
    _eq("a successful action's, kept only under all", log_view(keeping, dict(gone, success = True))["lines"], ["(stderr is gone: Bazel removed it; the history keeps a successful action's only with --history:action-logs=all)"])
    listed = output_of("action_completed", struct(label = "//a:b", primary_output = "bazel-out/bin/a"), struct(success = True, type = "Genrule", stdout = struct(file = "file:///gone"), stderr = None))
    _eq("an actions-list record names its output", (listed["output"], listed["success"]), ("bazel-out/bin/a", True))

    # Keys: Tab to the list, ↑↓ choose, Enter shows; ] and [ step; Esc closes
    # the innermost thing open.
    browse = dict(view_state, scroll = 0, filter = "all", search = new_search(), fails = [act, one_shard], selected = 0, focus = "console", view = None, re = ctx.std.re, cancelling = False, ended = True, log = ["console line"], counts = new_counts())
    on_key(browse, "tab", 10)
    on_key(browse, "down", 10)
    _eq("tab focuses the list, down chooses", (browse["focus"], browse["selected"]), ("failures", 1))
    _eq("enter shows its log", (on_key(browse, "enter", 10), browse["view"]["title"], browse["focus"]), (False, "//t:t · attempt 1", "console"))
    _eq("the log is what the console shows", console_lines(browse, browse["view"]["lines"]), ["FAIL: boom", "100%", "last line"])
    _eq("enter in a log stays", (on_key(browse, "enter", 10), browse["view"] != None), (False, True))
    on_key(browse, "]", 10)
    _eq("] steps on, around", browse["selected"], 0)
    browse["view"] = None
    on_key(browse, "[", 10)
    _eq("[ with no log open shows the chosen one", (browse["selected"], browse["view"] != None), (0, True))
    on_key(browse, "[", 10)
    _eq("[ then steps back, around", browse["selected"], 1)
    on_key(browse, "]", 10)
    on_key(browse, "]", 10)
    _eq("] once more", browse["selected"], 1)
    browse["focus"] = "failures"
    on_key(browse, "up", 10)
    browse["focus"] = "console"
    on_key(browse, "]", 10)
    _eq("] after choosing another shows the chosen one", (browse["selected"], browse["view"]["record"]["label"]), (0, "//pkg:broken"))
    on_key(browse, "]", 10)
    _eq("] on the one shown steps", browse["selected"], 1)
    browse["scroll"] = 3
    browse["search"]["open"] = True
    _eq("esc closes the bar first", (on_key(browse, "esc", 10), browse["search"]["open"], browse["view"] != None), (False, False, True))
    _eq("] shows the log in the Failures tab", (browse["tab"], len(crumbs(browse))), ("failures", 1))
    browse["scroll"] = 2
    on_key(browse, "tab", 10)
    _eq("Tab to Metrics: its own pane", (browse["tab"], browse["view"]), ("metrics", None))
    on_key(browse, "shift-tab", 10)
    _eq("and back: the log still open, as it was scrolled", (browse["tab"], browse["view"] != None, browse["scroll"]), ("failures", True, 2))
    _eq("Esc: back to the list", (on_key(browse, "esc", 10), browse["tab"], browse["view"], browse["focus"]), (False, "failures", None, "failures"))
    _eq("then the console", (on_key(browse, "esc", 10), browse["tab"]), (False, "console"))
    _eq("then leaves the finished screen", on_key(browse, "esc", 10), True)
    _eq("shift-up pages half the console", (on_key(browse, "shift-up", 10), browse["scroll"]), (False, 5))

    # Drawn: the rows fit the pane, the chosen one lit while focused, the
    # failed targets without a log after them, and the log view's title.
    browse["counts"]["failures"] = ["//t:t", "//pkg:lost"]
    browse["counts"]["failed_labels"] = {"//t:t": True, "//pkg:lost": True}
    browse["focus"] = "failures"
    rows = failure_rows(browse, 10, 30)
    _eq("rows: both logs, then the target without one", len(rows), 3)
    _eq("the chosen one is lit", rows[browse["selected"]].startswith(_role("active")), True)
    for row in rows:
        row = _visible(row)
        _eq("a row fits: %r" % row, len(row) <= 30, True)
    many = dict(browse, fails = [dict(act, label = "//m:%d" % i) for i in range(10)], counts = new_counts(), logged_index = None)
    plain_rows = lambda st, room: [_visible(r) for r in failure_rows(st, room, 30)]
    many["selected"] = 0
    _eq("the first chosen: the rest below", plain_rows(many, 4)[-1], "… 7 more")
    many["selected"] = 9
    shown_last = plain_rows(many, 4)
    _eq("the last chosen: what is above, nothing below", (shown_last[0], shown_last[-1].startswith("✗ //m:9")), ("… 7 earlier", True))
    tiny = dict(many, logged_index = None, selected = 0, task = "t", phase = "", start_ms = 0, now_ms = 0, frames = 0, progress = [], pages = [], ended = False)
    if "✗ //m:0" not in render(dict(tiny, tab = "failures", focus = "failures"), 80, 12):
        fail("render: a short terminal still shows a failure in the list")
    render(tiny, 80, 24)
    at = tiny["failed_at"]
    on_key(tiny, "mouse-press:%d:%d" % (at[1] + 3, at[0]), 10)
    on_key(tiny, "mouse-release:%d:%d" % (at[1] + 3, at[0]), 10)
    _eq("a click on the failures' count shows their tab", tiny["tab"], "failures")
    mixed = dict(many, selected = 9)
    mixed["counts"] = new_counts()
    for label in ["//m:9", "//x:1", "//x:2", "//x:3"]:
        mixed["counts"]["failed_labels"][label] = True
        mixed["counts"]["failures"].append(label)
    mixed["logged_index"] = None
    mixed_rows = plain_rows(mixed, 5)
    _eq(
        "unlogged rows follow the logged ones in the window, counted",
        (mixed_rows[0], mixed_rows[2].startswith("✗ //m:9"), mixed_rows[3], mixed_rows[4], len(mixed_rows)),
        ("… 8 earlier", True, "✗ //x:1  no log", "… 2 more", 5),
    )
    doubled = dict(mixed, fails = many["fails"] + [dict(act, label = "//m:9")], logged_index = None, selected = 10)
    doubled_rows = plain_rows(doubled, 5)
    _eq("a label failing twice counts once against the unlogged", (len(doubled_rows), doubled_rows[-1]), (5, "… 2 more"))
    grown = dict(mixed, logged_index = None)
    plain_rows(grown, 5)
    grown["counts"]["failed_labels"]["//x:4"] = True
    grown["counts"]["failures"].append("//x:4")
    _eq("the index catches up with what is new", plain_rows(grown, 5)[-1], "… 3 more")
    grown["fails"] = grown["fails"] + [dict(act, label = "//x:1")]
    _eq("a log arriving for a listed label leaves the unlogged", plain_rows(grown, 5)[-1], "… 3 more")
    _eq("and is counted in both", grown["logged_index"]["both"], 2)

    # Compaction: dropped labels go once half the list is them, or once a
    # walk for the first few skips more than a few.
    small = {"logged": {"//v:%d" % i: True for i in range(30)}, "unlogged": ["//v:%d" % i for i in range(200)], "dropped": 30}
    _eq("a short leading skip moves the head", (first_unlogged(small, 1), small["head"]), (["//v:30"], 30))
    small["logged"]["//v:30"] = True
    _eq("and on from there, never back", (first_unlogged(small, 1), small["head"]), (["//v:31"], 31))
    middle = {"logged": {"//w:%d" % i: True for i in range(1, 100)}, "unlogged": ["//w:%d" % i for i in range(200)], "dropped": 99}
    _eq("a long skip past the head compacts", (first_unlogged(middle, 2), len(middle["unlogged"]), middle["head"]), (["//w:0", "//w:100"], 101, 0))
    idx = {"logged": {}, "unlogged": ["//u:%d" % i for i in range(200)], "dropped": 0}
    for i in range(100):
        idx["logged"]["//u:%d" % i] = True
    _eq("the first unlogged, past the dropped", first_unlogged(idx, 2), ["//u:100", "//u:101"])
    _eq("a leading run moves the head, no compaction needed", (len(idx["unlogged"]), idx["head"]), (200, 100))
    _eq("and the walk after is short", first_unlogged(idx, 1), ["//u:100"])
    halved = dict(grown, logged_index = None)
    for i in range(4):
        halved["fails"] = halved["fails"] + [dict(act, label = "//x:%d" % (i + 1))]
    plain_rows(halved, 5)
    _eq("more than half dropped compacts in the index", (halved["logged_index"]["unlogged"], halved["logged_index"]["dropped"]), ([], 0))
    moved = dict(mixed, logged_index = None, selected = 9)
    moved["counts"] = new_counts()
    for i in range(6):
        moved["counts"]["failed_labels"]["//y:%d" % i] = True
        moved["counts"]["failures"].append("//y:%d" % i)
    moved["fails"] = many["fails"]
    plain_rows(moved, 6)
    moved["fails"] = moved["fails"] + [dict(act, label = "//y:0")]
    moved["selected"] = len(moved["fails"]) - 1
    plain_rows(moved, 6)
    _eq("the head moved past a lead that gained a log", moved["logged_index"]["head"], 1)
    moved["fails"] = moved["fails"] + [dict(act, label = "//y:%d" % i) for i in [2, 3, 4]]
    moved["selected"] = len(moved["fails"]) - 1
    after = plain_rows(moved, 6)
    _eq(
        "a half-full compaction resets the head, the rest still drawn",
        (moved["logged_index"]["head"], len(moved["logged_index"]["unlogged"]), [r.split("  ")[0] for r in after if r.startswith("✗ //y:") and r.rstrip().endswith("no log")], after[-1]),
        (0, 2, ["✗ //y:1"], "… 1 more"),
    )
    for room in [1, 2, 3]:
        for sel in [0, 5, 9]:
            many["selected"] = sel
            got = plain_rows(many, room)
            _eq("room %d, row %d: fits" % (room, sel), len(got), room)
            _eq("room %d, row %d: in sight" % (room, sel), len([r for r in got if r.startswith("✗ //m:%d " % sel)]), 1)
    many["selected"] = 5
    middle = plain_rows(many, 4)
    _eq("in the middle: both", (middle[0], middle[-1], len(middle)), ("… 4 earlier", "… 4 more", 4))
    browse.update(task = "test", phase = "", start_ms = 0, now_ms = 0, frames = 0, progress = [], pages = [], errors = [])
    _open_view = on_key(browse, "enter", 10)
    drawn = render(browse, 100, 30)
    for want in ["▹ //t:t ", "Esc back", "FAIL: boom"]:
        if want not in _visible(drawn):
            fail("render: %r missing from the log view:\n%s" % (want, drawn))

    # Smart case: a capital of the query's own matches case.
    for query, want in [("fail", False), ("Fail", True), ("a\\Wb", False), ("\\pL", False), ("\\p{Lu}x", False), ("(?P<Name>a)", False), ("(?<N>a)", False), ("\\w C", True), ("é", False), ("É", True), ("\\x4A", False), ("\\x{1F}", False), ("\\u{00C9}x", False), ("\\U0001F600", False), ("(?U)a", False), ("(?iR:a)", False), ("\\x4AB", True), ("(?i)A", True), ("\\(?User", True)]:
        _eq("has_capital %r" % query, has_capital(query), want)
    smart = _screen(ctx, ["ERROR: a FAILED", "ERROR: b failed"])
    on_key(smart, "/", 10)
    on_key(smart, "tab", 10)
    for c in "FAILED".elems():
        on_key(smart, c, 10)
    _eq("a capital matches case", console_lines(smart, smart["log"]), ["ERROR: a FAILED"])
    if _role("active") + "Aa" not in render(smart, 100, 30):
        fail("render: the case toggle should be lit while a capital matches case")

    # Finding: the newest match at or above where the bar opened, centred;
    # n older, N newer, nothing past either end; Esc goes back.
    lines = ["line %d%s" % (i, " hit" if i in (5, 40, 90) else "") for i in range(100)]
    jump = _screen(ctx, lines, scroll = 30)
    on_key(jump, "/", 10)
    for c in "hit".elems():
        on_key(jump, c, 10)
    _eq("typing finds the newest match above the view", (jump["search"]["back"], jump["scroll"]), (99 - 40, 100 - 40 - 1 - 4))
    _eq("every line still shown", len(console_lines(jump, lines)), 100)
    drawn = render(jump, 100, 30)
    if "/hit/ 2 of 3" not in drawn or "┃ line 40 hit" not in _visible(drawn):
        fail("render: the current match should be counted and marked:\n%s" % _visible(drawn))
    on_key(jump, "enter", 10)
    on_key(jump, "N", 10)
    _eq("N: the previous (older) match", jump["search"]["back"], 99 - 5)
    on_key(jump, "N", 10)
    _eq("N past the oldest wraps round to the newest", (jump["search"]["back"], jump["note"]), (99 - 90, "wrapped round to the newest match"))
    on_key(jump, "n", 10)
    _eq("n past the newest wraps round to the oldest", jump["search"]["back"], 99 - 5)
    on_key(jump, "n", 10)
    on_key(jump, "n", 10)
    _eq("n: the next (newer), twice", jump["search"]["back"], 99 - 90)
    on_key(jump, "/", 10)
    origin = jump["scroll"]
    on_key(jump, "x", 10)
    _eq("no match: back where the bar opened", (jump["search"]["back"], jump["scroll"]), (-1, origin))
    on_key(jump, "backspace", 10)
    on_key(jump, "esc", 10)
    _eq("esc: cleared, back where the bar opened", (jump["search"]["pattern"], jump["scroll"]), (None, origin))
    wrap = _screen(ctx, lines, scroll = 0)
    wrap["log"] = lines[:95]
    wrap["scroll"] = 60
    on_key(wrap, "/", 10)
    on_key(wrap, "9", 10)
    on_key(wrap, "0", 10)
    _eq("none above the view: the newest of all", wrap["search"]["back"], 94 - 90)

    # New lines: the current match and the scroll stay on their lines, and
    # are counted while scrolled up.
    add_lines(jump, ["new 1", "new 2"])
    _eq("scrolled up, new lines are counted", (jump["unseen"], jump["scroll"]), (2, origin + 2))
    if "2 new, J to follow" not in render(jump, 100, 30):
        fail("render: scrolled up, the new lines should be counted")
    on_key(jump, "J", 10)
    render(jump, 100, 30)
    _eq("following again forgets them", jump["unseen"], 0)
    kept = _screen(ctx, list(lines))
    on_key(kept, "/", 10)
    for c in "hit".elems():
        on_key(kept, c, 10)
    before = kept["log"][len(kept["log"]) - 1 - kept["search"]["back"]]
    add_lines(kept, ["more"] * 3)
    _eq("the current match is the same line", kept["log"][len(kept["log"]) - 1 - kept["search"]["back"]], before)
    add_lines(kept, ["INFO: 1,204 processes: 1,000 remote cache hit, 3 disk cache hit, 200 internal, 1 darwin-sandbox."])
    _eq("the cache tally is read", kept["cache"], (1003, 1004))

    # The Results pane counts actions, one unit with the bar's: what ran
    # and what a cache served from the execution log's spawns while the
    # build runs, the rest of the done count other; tests'
    # cache hits from their results.
    count_spawn(kept["counts"], struct(cache_hit = True, runner = "remote cache hit"))
    count_spawn(kept["counts"], struct(cache_hit = False, runner = "darwin-sandbox"))
    count_event(kept["counts"], "test_result", struct(label = "//t:a"), struct(cached_locally = True, execution_info = None))
    count_event(kept["counts"], "test_result", struct(label = "//t:b"), struct(cached_locally = False, execution_info = struct(cached_remotely = False)))
    kept["progress"] = ["[5 / 9] 2 actions running"]
    drawn = _visible(render(kept, 140, 30))
    for want in ["Actions  █ 1 ran · ▓ 1 cached", "▒ 3 other", "0 failed · 1/2 cached", "55% · 5 of 9"]:
        if want not in drawn:
            fail("render: %r should be drawn:\n%s" % (want, drawn))
    _eq("no spawns row in Results", ("spawns" in drawn, "test runs" in drawn, "Cached " in drawn), (False, False, False))
    many = _screen(ctx, ["x"], progress = ["[3,830 / 8,563] 16 actions running"])
    many["counts"].update(spawns = 1452, spawn_hits = 58, test_runs = 1500, test_cached = 1200, configured = 12345, built = 12000)
    shown = _visible(render(many, 140, 30))
    _eq("counts with thousands separators", ["12,345 configured" in shown, "12,000 built" in shown], [True, True])
    _eq("whole counts in three rows, what runs and is pending too", ["█ 1,394 ran · ▓ 58 cached" in shown, "▒ 2,378 other" in shown, "▒ 2,378 other" in shown, "─ 16 running · 4,717 pending" in shown], [True, True, True, True])
    many["counts"].update(test_runs = 15, test_cached = 9, tests_passed = 9, tests_failed = 6)
    _eq("the Tests row's cache hits", "Tests    9 passed, 6 failed · 9/15 cached" in _visible(render(many, 140, 30)), True)
    _eq("narrow, the same", "Tests   ✗6 ✓9 · 9/15 cached" in _visible(render(many, 76, 30)), True)
    many["counts"].update(tests_passed = 14, tests_failed = 1)
    rows = [r.partition("││ ")[2].rstrip(" │\r") for r in _visible(render(many, 100, 30)).split("\n") if "││ " in r]
    at = [i for i, r in enumerate(rows) if r.startswith("Tests")][0]
    _eq("on a row of its own where the Tests row has no room", rows[at:at + 2], ["Tests    14 passed, 1 failed", "         9/15 cached"])
    many["counts"].update(test_runs = 1500, test_cached = 1200)
    rows = [r.partition("││ ")[2].rstrip(" │\r") for r in _visible(render(many, 140, 30)).split("\n") if "││ " in r]
    at = [i for i, r in enumerate(rows) if r.startswith("Tests")][0]
    _eq("never left out", rows[at + 1], "         1,200/1,500 cached")
    metrics = "\n".join([_visible(l) for l in metrics_lines(kept)])
    if "2 · 1 from a cache (50%) · 1 run" not in metrics or "remote cache hit" not in metrics:
        fail("metrics: actions by the execution log:\n" + metrics)
    for line, want in [
        ("INFO: 1 process: 1 internal.", (0, 0)),
        ("INFO: 7 processes: 4 action cache hit, 3 linux-sandbox.", (4, 7)),
        ("INFO: Build completed successfully, 7 total actions", None),
        ("INFO: 3 processes: lots.", None),
    ]:
        _eq("cache_hits %r" % line, cache_hits(line), want)

    # The keys overlay: any key but the wheel closes it, doing nothing else;
    # the console's scroll is left alone.
    helped = _screen(ctx, lines, scroll = 12)
    on_key(helped, "?", 10)
    drawn = render(helped, 100, 30)
    if "Keys · ↑↓ scroll · any other key closes" not in drawn or "these keys" not in drawn:
        fail("render: ? should show the keys")
    on_key(helped, "wheel-up", 10)
    _eq("the wheel keeps the keys shown", (helped["help"], helped["scroll"]), (True, 12))
    small = _visible(render(dict(helped, progress = ["[1 / 9] 8 actions running"] + ["    a%d; 1s" % i for i in range(8)]), 80, 16))
    if "Running" in small or " more: ↓" not in small:
        fail("render: the keys take the screen, counting what does not fit:\n%s" % small)
    for _ in range(30):
        on_key(helped, "down", 10)
    if "cancel the build" not in render(helped, 80, 16):
        fail("render: ↓ should reach the last key")
    on_key(helped, "q", 10)
    _eq("a key closes them and does nothing else", (helped["help"], helped["scroll"], helped["cancelling"]), (False, 12, False))
    on_key(helped, "?", 10)
    _eq("reopened from the top", helped["help_top"], 0)
    on_key(helped, "esc", 10)

    # The keys row fits, ending with `? keys` where it can.
    for focus, ended in [("console", False), ("console", True), ("failures", False)]:
        for cols in [10, 40, 80, 200]:
            row = keys_row(_screen(ctx, [], focus = focus, ended = ended, fails = [act]), cols)
            if len(row) > cols:
                fail("keys_row at %d columns is %d wide: %r" % (cols, len(row), row))
            if cols >= 40 and "? keys" not in row:
                fail("keys_row at %d: no ? keys: %r" % (cols, row))
    near = _screen(ctx, ["a hit", "b", "c"])
    on_key(near, "/", 10)
    for c in "hit".elems():
        on_key(near, c, 10)
    on_key(near, "enter", 10)
    add_lines(near, ["d"] * 20)
    held = _visible(render(near, 100, 30))
    if "┃ a hit" not in held:
        fail("render: a match near the newest line should stay in view:\n%s" % held)
    near["scroll"] = 0
    if "on the match, J to follow" not in render(near, 100, 30):
        fail("render: a view held on a match should not say following")
    on_key(near, "J", 10)
    add_lines(near, ["e"])
    _eq("G follows again", (near["scroll"], near["search"]["back"]), (0, -1))
    held_bar = _screen(ctx, ["x hit", "y"])
    on_key(held_bar, "/", 10)
    for c in "hit".elems():
        on_key(held_bar, c, 10)
    on_key(held_bar, "enter", 10)
    on_key(held_bar, "/", 10)
    add_lines(held_bar, ["z"] * 5)
    on_key(held_bar, "esc", 10)
    _eq("a bar opened on a held view goes back to it", held_bar["scroll"], 5)
    following = _screen(ctx, ["x hit", "y"])
    on_key(following, "/", 10)
    for c in "hit".elems():
        on_key(following, c, 10)
    add_lines(following, ["z"] * 50)
    on_key(following, "esc", 10)
    _eq("opened following, esc follows again", following["scroll"], 0)
    top = _screen(ctx, lines[:100])
    on_key(top, "K", 10)
    on_key(top, "/", 10)
    _eq("g then /: from the top page", top["search"]["origin"], 90)
    for c in "hit".elems():
        on_key(top, c, 10)
    _eq("finds the match on it", top["search"]["back"], 99 - 5)
    top2 = _screen(ctx, lines[:100], search = dict(new_search(), query = "hit", pattern = ctx.std.re.compile("hit")))
    on_key(top2, "K", 10)
    on_key(top2, "N", 10)
    _eq("K then N: the match above the top page's bottom", top2["search"]["back"], 99 - 5)
    tabbed = _screen(ctx, lines, scroll = 30)
    on_key(tabbed, "/", 10)
    on_key(tabbed, "tab", 10)
    _eq("tab with no query keeps the view", tabbed["scroll"], 30)
    empty = _screen(ctx, ["a", "b"])
    on_key(empty, "/", 10)
    if "matches" in render(empty, 100, 30).split("\r\n")[-1]:
        fail("render: an empty query counts no matches")
    _eq("the countdown", keys_row(_screen(ctx, [], ended = True, countdown_ms = 2100), 80).rstrip(), " Done ✔ · leaving in 3s · q, Enter or Esc leave now · any other key stays")

    # Scrolling by the wheel and plain keys; z and m.
    wheel = _screen(ctx, lines)
    for key, want in [("wheel-up", 3), ("u", 8), ("d", 3), ("wheel-down", 0)]:
        on_key(wheel, key, 10)
        _eq("scroll after %s" % key, wheel["scroll"], want)
    on_key(wheel, "/", 10)
    on_key(wheel, "wheel-up", 10)
    _eq("the wheel scrolls with the bar open", (wheel["scroll"], wheel["search"]["query"]), (3, ""))
    on_key(wheel, "esc", 10)
    tall = console_height(wheel, 100, 30)
    on_key(wheel, "z", 10)
    _eq("z gives the console the screen", console_height(wheel, 100, 30) > tall, True)
    if "Running" in render(wheel, 100, 30):
        fail("render: zoomed, the panes should be gone")
    mice = []
    wheel["screen"] = struct(mouse = lambda on: mice.append(on))
    on_key(wheel, "m", 10)
    on_key(wheel, "m", 10)
    _eq("m turns the mouse on and off", mice, [True, False])

    # Running actions: oldest first, coloured by age.
    for row, want in [("Compiling a.cc; 12s remote", 12), ("GoLink x; 1m 30s local", 90), ("T //a; 2.5s", 2), ("T //a; 500ms", 0), ("Analyzing", 0), ("x; 1h darwin-sandbox", 3600)]:
        _eq("action_seconds %r" % row, action_seconds(row), want)
    aged = _screen(ctx, [], progress = ["[1 / 9] 3 actions running", "    young; 2s", "    stuck; 400s", "    slow; 70s"])
    drawn = _visible(render(aged, 100, 30))
    if not (drawn.find("stuck; 400s") < drawn.find("slow; 70s") and drawn.find("slow; 70s") < drawn.find("young; 2s")):
        fail("render: running actions should be oldest first")

    # Under a theme, each running action's time alone is coloured by its age
    # (BuildBuddy's theme does so in Bazel's progress area), the header's
    # time strong.
    painted = _screen(ctx, [], progress = ["[1 / 9] 3 actions running", "    young; 2s", "    stuck; 400s", "    slow; 1m 10s"], now_ms = 65000)
    rows = render(painted, 100, 30).split("\n")
    for label, took, role in [("young", "2s", "muted"), ("stuck", "400s", "error"), ("slow", "1m 10s", "warning")]:
        _eq("%s's time and its role" % label, aged_time("%s; %s darwin-sandbox" % (label, took)), (took, role))
        row = [r for r in rows if label + ";" in _visible(r)][0]
        if ANSI_ROLES[role]:
            _eq("%s's time in %s" % (label, role), (ANSI_ROLES[role] + took) in row, True)
            _eq("%s's label plain" % label, (ANSI_ROLES[role] + label) in row, False)
    _eq("no time, no colour", aged_time("Analyzing"), None)
    _eq("the slowest pane's minutes", aged_time("CppCompile //a:long; 1m05s"), ("1m05s", "warning"))
    _eq("and its seconds", aged_time("CppCompile //a:short; 12.4s"), ("12.4s", "muted"))

    # The header's time is in its bar, as the rest of it: one style from
    # the row's start to its end, no reset nor other role inside.
    head = rows[0].rstrip("\r")
    _eq("the header's time inside the bar", "1m05s" in _visible(head), True)
    if ANSI_ROLES["status_bar"]:
        inner = head[head.find("\x1b[H") + 3:] if "\x1b[H" in head else head
        inner = inner[inner.find(ANSI_ROLES["status_bar"]) + len(ANSI_ROLES["status_bar"]):]
        _eq("one style the whole bar", ("\x1b[" in inner.rpartition(theme.reset)[0]), False)

    # The actions that wrote output: their own list, under `a`.
    wrote = output_of("action_completed", struct(label = "//w:w"), struct(success = True, type = "Javac", stderr = struct(file = "file:///tmp/err")))
    _eq("an action that wrote output", (wrote["label"], wrote["detail"], wrote["files"]), ("//w:w", "Javac", [("stderr", "file:///tmp/err")]))
    _eq("one that wrote nothing", output_of("action_completed", struct(label = "//w:q"), struct(success = True)), None)
    _eq("a failed one is a failure", output_of("action_completed", struct(label = "//w:f"), struct(success = False, stderr = struct(file = "file:///tmp/err"))), None)
    listed = dict(view_state, **_screen(ctx, ["console"], fails = [act]))
    listed["read"] = view_state["read"]
    note_event(listed, "action_completed", struct(label = "//w:w"), struct(success = True, type = "Javac", stderr = struct(file = "file:///tmp/err")), False)
    note_event(listed, "action_completed", struct(label = "//w:v"), struct(success = True, type = "Genrule", stdout = struct(file = "file:///tmp/out")), False)
    _eq("note_event lists them", [r["label"] for r in listed["outputs"]], ["//w:w", "//w:v"])
    on_key(listed, "a", 10)
    on_key(listed, "tab", 10)
    on_key(listed, "down", 10)
    _eq("a: the actions list, its own choice", (listed["list"], listed["picked"], listed["selected"]), ("actions", 1, 0))
    rows = [_visible(r).rstrip(" ") for r in action_rows(listed, 5, 30)]
    _eq("its rows", rows, ["• //w:w  Javac", "• //w:v  Genrule"])
    on_key(listed, "enter", 10)
    _eq("enter shows the action's log", (listed["view"]["title"], listed["view"]["lines"]), ("//w:v · Genrule", ["some out"]))
    on_key(listed, "]", 10)
    _eq("] steps through the actions", listed["view"]["title"], "//w:w · Javac")
    if "Actions with output" not in render(dict(listed, tab = "failures", focus = "failures", view = None), 100, 30):
        fail("render: the list's tab should name the actions list")
    on_key(listed, "a", 10)
    _eq("a again: the failures", (listed["list"], listed["selected"]), ("failures", 0))

    # Filtering, the bar's origin still counts every line the `e` filter
    # shows, so Esc goes back to the same line.
    drift = _screen(ctx, ["l%d" % i for i in range(300)], scroll = 100)
    on_key(drift, "/", 10)
    on_key(drift, "f", 10)
    on_key(drift, "tab", 10)
    add_lines(drift, ["x%d%s" % (i, " f" if i % 100 == 0 else "") for i in range(250)])
    on_key(drift, "esc", 10)
    _eq("esc after filtering: where the bar opened", drift["scroll"], 350)
    kept_filter = _screen(ctx, ["a", "b f", "c"], scroll = 1)
    kept_filter["search"].update(mode = "filter", query = "f", pattern = ctx.std.re.compile("f"))
    on_key(kept_filter, "/", 10)
    _eq("reopened over a kept filter: the newest", kept_filter["search"]["origin"], 0)

    # The list is its own tab: Tab to it keeps the zoom.
    zoomed = _screen(ctx, [], fails = [act], zoom = True)
    on_key(zoomed, "tab", 10)
    _eq("tab keeps the zoom", (zoomed["focus"], zoomed["zoom"]), ("failures", True))

    # A short terminal still shows a failure, in its tab.
    short = _screen(ctx, [], fails = [act], tab = "failures", focus = "failures")
    if "//pkg:broken" not in render(short, 100, 14):
        fail("render: a 14-row terminal should still show a failure")

    # z on the Failures tab keeps its list's focus (the list is the tab,
    # not a pane zoom hides); the countdown shows over an open bar; a retry
    # forgets where the bar opened.
    zfocus = _screen(ctx, [], fails = [act], focus = "failures", tab = "failures")
    on_key(zfocus, "z", 10)
    _eq("z keeps the list", (zfocus["zoom"], zfocus["focus"]), (True, "failures"))
    counting = _screen(ctx, ["a"], ended = True, countdown_ms = 2000)
    counting["search"]["open"] = True
    if "leaving in 2s" not in render(counting, 100, 30):
        fail("render: the countdown should show over an open bar")
    opened = _screen(ctx, [], fresh = True, last_attempts = {})
    opened["search"].update(origin = 200, anchored = True)
    reset_attempt(opened, 0)
    _eq("a retry forgets where the bar opened", opened["search"]["origin"], 0)
    opened.update(view = None, errors = [], error_count = 0)
    opened["search"].update(open = True)
    add_lines(opened, ["new"] * 4)
    _eq("and follows after it", (opened["search"]["origin"], opened["scroll"]), (0, 0))

    # Links and selection: marks wrap cells, not escapes, and survive a
    # colour reset inside them.
    _eq("a mark across a colour", mark_cells("a\x1b[31mbc\x1b[0md", [(1, 3, "<", ">", "!")]), "a\x1b[31m<bc\x1b[0m!>d")
    _eq("a wide character is two cells", mark_cells("✅x", [(2, 3, "<", ">", "")]), "✅<x>")
    _eq("no marks", mark_cells("abc", []), "abc")
    row = "see " + link("https://x.test", "here") + " now"
    _eq("a link's cells", [link_at(row, c) for c in (3, 4, 7, 8)], [None, "https://x.test", "https://x.test", None])
    _eq("a link after a tab", [m[:2] for m in link_marks("\ta.rs:3", [[1, 7, "file:///a.rs"]], 20)], [(2, 8)])
    _eq("a link past the room is cut to it", [m[:2] for m in link_marks("abcdef", [[2, 6, "u"]], 4)], [(2, 4)])
    web_on = link_marks("see https://e.com", [[4, 17, "https://e.com"]], 40)[0][2]
    file_on = link_marks("a.rs:3", [[0, 6, "file:///a.rs"]], 40)[0][2]
    _eq("a web link in the theme's link colour, a file's underlined alone", (web_on.endswith(_role("link")), file_on.endswith("\x1b[4m")), (True, True))

    # The console's links drawn, so a click finds them.
    linked = _screen(ctx, ["ERROR: src/a.rs:3 bad"], ansi = ctx.std.re.compile(ANSI), line_links = {"ERROR: src/a.rs:3 bad": [[7, 17, "cursor://file/w/src/a.rs:3"]]})
    render(linked, 80, 12)
    top = linked["pane"][0]
    pane_row = [i for i, r in enumerate(linked["frame"]) if "src/a.rs:3" in r][-1]
    col = _visible(ctx.std.re.compile(ANSI).replace(linked["frame"][pane_row], "")).find("src/a.rs")
    _eq("the console row's link", link_at(linked["frame"][pane_row], col), "cursor://file/w/src/a.rs:3")
    _eq("the pane's rows", top <= pane_row and pane_row <= linked["pane"][1], True)

    # A real child as the clipboard: `stdin()` is a method, and one that
    # exits before reading it all (`true`) is no error.
    real = struct(which = lambda n: "/usr/bin/true" if n == "pbcopy" else None, command = lambda _n: ctx.std.process.command("true"))
    _eq("a real copy", copy_text({"process": real, "env": _fake_env({}), "cancellation": ctx.cancellation}, "x" * 200000), "copied")

    # Only web and editor links open; anything output wrote could make is
    # copied instead.
    _eq("opened", [opens(u) for u in ("https://x.test/a", "cursor://file/w/a.rs:3:1", "idea://open?file=/a&line=1")], [True, True, True])
    _eq("not opened", [opens(u) for u in ("-aCalculator", "file:///tmp/x.command", "/Applications/X.app", "javascript:alert(1)", "https://x.test/a b", "smb://h/s", "vscode://vscode.git/clone?url=x", "https://x.test/\u009b2J", "https://")], [False] * 9)

    # A click opens it; in an SSH session it is copied instead.
    ran = []
    linked.update(process = _fake_process(["open"], ran), env = _fake_env({}))
    on_key(linked, "mouse-press:%d:%d" % (col, pane_row), 10)
    on_key(linked, "mouse-release:%d:%d" % (col, pane_row), 10)
    _eq("opened", (ran, linked["note"]), ([[["open", "cursor://file/w/src/a.rs:3"], []]], "opened cursor://file/w/src/a.rs:3"))
    _eq("said in the keys row", _visible(keys_row(linked, 80)).strip(), "opened cursor://file/w/src/a.rs:3")
    on_key(linked, "K", 10)
    _eq("any other key clears it", linked["note"], "")
    ran.clear()
    linked["env"] = _fake_env({"SSH_CONNECTION": "1 2 3 4"})
    linked["last_press"] = None
    on_key(linked, "mouse-press:%d:%d" % (col, pane_row), 10)
    on_key(linked, "mouse-release:%d:%d" % (col, pane_row), 10)
    _eq("copied over SSH", (ran, linked["note"], linked["osc"].startswith("\x1b]52;c;")), ([], "link copied: cursor://file/w/src/a.rs:3", True))

    # A drag selects within the pane's text, reversed, and its release
    # copies it, to the clipboard of this machine and by OSC 52.
    ran.clear()
    linked.update(env = _fake_env({}), process = _fake_process(["pbcopy"], ran))
    on_key(linked, "mouse-press:0:%d" % pane_row, 10)
    on_key(linked, "mouse-drag:12:%d" % pane_row, 10)
    if theme.bg("selection", stream = True) not in render(linked, 80, 12):
        fail("render: a selection shows in its colour")
    on_key(linked, "mouse-drag:12:%d" % pane_row, 10)
    on_key(linked, "mouse-release:12:%d" % pane_row, 10)
    _eq("copied with pbcopy, the border left out", (ran[-1], linked["note"]), ([["pbcopy"], ["ERROR: src/"]], "copied 11 characters"))
    _eq("and by OSC 52 with the next frame", render(linked, 80, 12).startswith("\x1b]52;c;"), True)
    _eq("once", render(linked, 80, 12).startswith("\x1b]52"), False)
    ran.clear()
    on_key(linked, "mouse-release:20:0", 10)
    _eq("a release with no press since copies nothing", ran, [])
    on_key(linked, "mouse-press:5:%d" % pane_row, 10)
    on_key(linked, "mouse-drag:5:0", 10)
    on_key(linked, "mouse-release:5:0", 10)
    _eq("a selection begun in the pane stays in its rows", [r[1] for r in ran], [["ERRO"]])

    # Bazel's lines as they come: indented, timestamped, a test summary's,
    # and a tool's under its action's ERROR.
    _eq("indented", severity("  ERROR: //a:b failed"), "error")
    _eq("timed out", severity("TIMEOUT: //t:x (Summary)"), "error")
    _eq("a test summary's timeout", severity("//t:x    TIMEOUT in 4.0s"), "error")
    _eq("timestamped", severity("(23:04:25) ERROR: //a:b failed"), "error")
    _eq("the timestamp gone", bazel_line("(23:04:25.123) INFO: x"), "INFO: x")
    _eq("not a timestamp", bazel_line("(see a.cc) x"), "(see a.cc) x")
    kinds, block = classify(["ERROR: a.cc:1: compile failed", "a.cc:1:2: error: no x", "  1 | x", "INFO: From y:", "y said", "WARNING: z", "z more"])
    _eq("a diagnostic is its ERROR's", (kinds, block), (["error", "error", "error", "", "", "warning", ""], ""))
    _eq("carried to the next lines", classify(["more"], "error")[0], ["error"])
    _eq("timestamped progress", (progress_counts("(23:04:25) [5 / 10] x"), cache_hits("(23:04:25) INFO: 4 processes: 3 remote cache hit, 1 internal.")), ((5, 10), (3, 3)))
    diag = _screen(ctx, [], filter = "errors")
    add_lines(diag, ["INFO: x", "ERROR: a.cc failed", "a.cc:1: error: no x", "INFO: done"])
    _eq("e shows the diagnostic", console_lines(diag, diag["log"], diag["kinds"]), ["ERROR: a.cc failed", "a.cc:1: error: no x"])
    _eq("an error block kept for the scrollback", diag["errors"], [["ERROR: a.cc failed", "a.cc:1: error: no x"]])

    # The newest `_MAX_LOG` kept, the rest counted, errors kept for `e`.
    flood = _screen(ctx, [])
    add_lines(flood, ["ERROR: first", "INFO: next"] + ["line %d" % i for i in range(20005)])
    _eq("trimmed a tenth past the cap, and counted", (len(flood["log"]), flood["dropped"], flood["early"]), (18000, 2007, [("ERROR: first", "error")]))
    for i in range(19):
        add_lines(flood, ["more %d" % i] * 100)
    _eq("then not again for a while (refolding once per trim)", flood["trims"], 1)
    flood["filter"] = "errors"
    _eq("e still finds it", _visible(render(flood, 80, 24)).count("ERROR: first"), 1)
    flood["filter"] = "all"
    _eq("the title says what is gone", "2,007 older not kept" in render(flood, 120, 24), True)

    # What the scrollback keeps: Bazel's closing block as it wrote it, then
    # the failure summary the plain console prints too: each failure with
    # Bazel's errors that name it (the console's kept errors) and the
    # history's copy of its log, the counts, the raw log, where the rest is.
    done = _screen(ctx, [], log_path = "/out/console.log", bes_base = "", bazel_uuid = "", update = {}, read = lambda p, n: None, exec_root = "", output_dirs = {}, last_attempts = {})
    add_lines(done, ["ERROR: //a:b failed", "a.cc:1: error: no x", "INFO: Elapsed time: 3.1s, Critical Path: 2.9s", "ERROR: Build did NOT complete successfully"])
    done["fails"] = [{"kind": "action", "label": "//a:b", "detail": "CppCompile", "files": [("stderr", "file:///gone")], "output": "bazel-out/a.o", "success": False}]
    done["build"] = struct(kept_action_log = lambda output: {"stderr": "/history/CppCompile-1.stderr"} if output == "bazel-out/a.o" else {})
    done["kept_errors"] = {"errors": [{"header": "ERROR: a/BUILD:1:1: Compiling a.cc failed: (Exit 1)", "lines": ["ERROR: a/BUILD:1:1: Compiling a.cc failed: (Exit 1)", "a.cc:1: error: no x", "full stderr: /history/CppCompile-1.stderr"], "label": "//a:b"}], "distinct": 1}
    report = report_lines(done, "t-1", False)
    _eq("Bazel's closing block", report[:2], ["INFO: Elapsed time: 3.1s, Critical Path: 2.9s", "ERROR: Build did NOT complete successfully"])
    _eq("the summary", report[2:], [
        "── Failures (1) ──",
        "  ✗ //a:b  CppCompile",
        "    ERROR: a/BUILD:1:1: Compiling a.cc failed: (Exit 1)",
        "    a.cc:1: error: no x",
        "    full stderr: /history/CppCompile-1.stderr",
        "0 built, 0 failed · 0 tests passed, 0 failed · Bazel's raw log: /out/console.log",
        "All of it: aspect history show t-1",
    ])
    _eq("no Failed list of its own", [l for l in report if l.startswith("Failed") or l.startswith("Bazel's errors")], [])
    without = dict(done, kept_errors = None)
    _eq("without the console's errors: its log", report_lines(without, "t-1", False)[3:5], ["  ✗ //a:b  CppCompile", "    /history/CppCompile-1.stderr"])

    # Every kind of failure, as real Bazel 9.3.3 runs reported them (w44's
    # workspace: `test --keep_going //:all //anal:all //tc:all //t:all`,
    # `build //syntax:all //:ok`, `//nope:all`, `//:nosuch`): Bazel's errors
    # as the console kept them, the failures as the stream gave them.
    def _kept(*errors):
        return {"errors": [{"header": e[0], "lines": list(e), "label": None} for e in errors], "distinct": len(errors)}

    kinds = _screen(ctx, [], log_path = "/h/console.log", bes_base = "", bazel_uuid = "", update = {}, read = lambda p, n: None, exec_root = "", output_dirs = {}, last_attempts = {}, build = None)
    kinds["fails"] = [
        {"kind": "action", "label": "//:bad", "detail": "Genrule", "files": [], "output": "bazel-out/bad.txt", "success": False},
        {"kind": "test", "label": "//t:fails", "detail": "attempt 1", "run": 1, "shard": 1, "attempt": 1, "config": "", "status": "failed", "duration_ms": 0, "files": []},
    ]
    kinds["counts"]["failures"] = ["//:bad", "//:uses_bad", "//tc:tc", "//anal:anal"]
    kinds["root_causes"] = {"//:uses_bad": ["//:bad"]}
    kinds["counts"]["failed_labels"] = {"//:uses_bad": True, "//tc:tc": True, "//anal:anal": True}
    kinds["counts"]["failed"] = 4
    kinds["kept_errors"] = {"errors": [
        {"header": "ERROR: BUILD.bazel:1:8: Executing genrule //:bad failed: (Exit 1)", "lines": ["ERROR: BUILD.bazel:1:8: Executing genrule //:bad failed: (Exit 1)", "compile error: x.cc:3: expected ;", "full stderr: /h/bad/Genrule-1.stderr"], "label": "//:bad"},
        {"header": "ERROR: tc/BUILD.bazel:3:9: While resolving toolchains for target //tc:tc (2d89340): No matching toolchains found for types:", "lines": ["ERROR: tc/BUILD.bazel:3:9: While resolving toolchains for target //tc:tc (2d89340): No matching toolchains found for types:", "  //tc:toolchain_type", "To debug, rerun with --toolchain_resolution_debug='//tc:toolchain_type'"], "label": None},
        {"header": "ERROR: anal/BUILD.bazel:1:8: Executing genrule //anal:anal failed: missing input file '//anal:nonexistent'", "lines": ["ERROR: anal/BUILD.bazel:1:8: Executing genrule //anal:anal failed: missing input file '//anal:nonexistent'"], "label": None},
        {"header": "ERROR: syntax/BUILD.bazel:2:1: syntax error at 'newline': expected ,", "lines": ["ERROR: syntax/BUILD.bazel:2:1: syntax error at 'newline': expected ,"], "label": None},
        {"header": "ERROR: Skipping '//nope:all': while parsing '//nope:all': no such package 'nope': BUILD file not found in any of the following directories.", "lines": ["ERROR: Skipping '//nope:all': while parsing '//nope:all': no such package 'nope': BUILD file not found in any of the following directories.", " - nope"], "label": None},
        {"header": "ERROR: Skipping '//:nosuch': no such target '//:nosuch': target 'nosuch' not declared in package ''", "lines": ["ERROR: Skipping '//:nosuch': no such target '//:nosuch': target 'nosuch' not declared in package ''"], "label": None},
    ], "distinct": 6}
    summary = [_visible(l) for l in failure_summary(kinds, kinds["kept_errors"], "t-9", False, "/h/console.log")]
    _eq("every kind, once", summary, [
        "── Failures (7) ──",
        "  ✗ //:bad  Genrule",
        "    ERROR: BUILD.bazel:1:8: Executing genrule //:bad failed: (Exit 1)",
        "    compile error: x.cc:3: expected ;",
        "    full stderr: /h/bad/Genrule-1.stderr",
        "    ○ 1 blocked: //:uses_bad",
        "  ✗ //t:fails  attempt 1",
        "  ✗ //tc:tc",
        "    ERROR: tc/BUILD.bazel:3:9: While resolving toolchains for target //tc:tc (2d89340): No matching toolchains found for types:",
        "      //tc:toolchain_type",
        "    To debug, rerun with --toolchain_resolution_debug='//tc:toolchain_type'",
        "  ✗ //anal:anal",
        "    ERROR: anal/BUILD.bazel:1:8: Executing genrule //anal:anal failed: missing input file '//anal:nonexistent'",
        "  ✗ ERROR: syntax/BUILD.bazel:2:1: syntax error at 'newline': expected ,",
        "  ✗ ERROR: Skipping '//nope:all': while parsing '//nope:all': no such package 'nope': BUILD file not found in any of the following directories.",
        "     - nope",
        "  ✗ ERROR: Skipping '//:nosuch': no such target '//:nosuch': target 'nosuch' not declared in package ''",
        "0 built, 3 failed, 1 blocked · 0 tests passed, 0 failed · Bazel's raw log: /h/console.log",
        "All of it: aspect history show t-9",
    ])

    # An analysis failure Bazel reports as its own (an Aborted
    # configured_label): what Bazel gave, when no error names it.
    analysed = dict(kinds, fails = [{"kind": "action", "label": "//anal:broken", "detail": "analysis failed", "files": [("error", ("in genrule rule //anal:broken: missing srcs", False))], "output": "", "success": False}], kept_errors = None, counts = new_counts(), root_causes = {})
    _eq("analysis failed", [_visible(l) for l in failure_summary(analysed, None, "t-9", False)][:3], ["── Failures (1) ──", "  ✗ //anal:broken  analysis failed", "    in genrule rule //anal:broken: missing srcs"])

    # A passing run: the counts line alone, no rule.
    passing = dict(kinds, fails = [], kept_errors = None, counts = dict(new_counts(), built = 3), root_causes = {})
    _eq("a passing run", [_visible(l) for l in failure_summary(passing, {"errors": [], "distinct": 0}, "t-9", False, "/h/console.log")], ["3 built, 0 failed · 0 tests passed, 0 failed · Bazel's raw log: /h/console.log", "All of it: aspect history show t-9"])

    many = dict(done, fails = [dict(done["fails"][0], label = "//a:b%d" % i) for i in range(14)], kept_errors = None)
    _eq("capped, counted", [l for l in report_lines(many, "t-1", False) if l.startswith("──")], ["── Failures (first 10 of 14) ──"])
    stopped = dict(done, inv = {"build_finished": struct(exit_code = struct(name = "INTERRUPTED", code = 8))}, cancelling = False)
    _eq("an interrupted build's counts say so", [l for l in report_lines(stopped, "t-3", False) if " built, " in l][0].startswith("interrupted · "), True)
    late = dict(done, cancelling = True, inv = {"build_finished": struct(exit_code = struct(name = "SUCCESS", code = 0))})
    _eq("a task cancelled before it returned, its build done", [l for l in report_lines(late, "t-5", False) if " built, " in l][0].startswith("interrupted · "), True)
    _eq("q or Enter on the finished screen is no interruption", [l for l in report_lines(dict(late, cancelling = False, ended = True), "t-8", False) if " built, " in l][0].startswith("interrupted"), False)
    _eq("a Ctrl+C between a build task's builds is", [l for l in report_lines(dict(late, task = "build", builds = [{}]), "t-7", False) if " built, " in l][0].startswith("interrupted · "), True)
    _eq("one before it finished is", [l for l in report_lines(dict(done, cancelling = True, inv = {}), "t-6", False) if " built, " in l][0].startswith("interrupted · "), True)
    _eq("a finished one's do not", [l for l in report_lines(dict(done, cancelling = False, inv = {"build_finished": struct(exit_code = struct(name = "BUILD_FAILURE", code = 1))}), "t-4", False) if " built, " in l][0].startswith("interrupted"), False)

    # Small terminals: counts whole, the title kept, an action's age kept,
    # the keys row always there.
    small = _screen(ctx, ["INFO: x"], task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False, progress = ["[3 / 9] 2 actions running", "    Executing genrule //examples/full_screen:broken; 2s darwin-sandbox"])
    small["counts"] = dict(new_counts(), configured = 3, built = 2, failed = 1)
    at80 = _visible(render(small, 80, 24))
    _eq("the counts whole at 80", "2 built, 1 failed" in at80, True)
    _eq("the title kept", "aspect build" in _visible(render(small, 40, 12)).split("\n")[0], True)
    _eq("the bar's counts not repeated in the header", "[3 / 9]" in _visible(render(small, 80, 24)).split("\n")[0], False)
    _eq("an action's age kept", action_row("Executing genrule //examples/full_screen:broken; 2s darwin-sandbox", 30).endswith("2s darwin-sandbox"), True)
    _eq("cut in the middle", "…" in action_row("Executing genrule //examples/full_screen:broken; 2s darwin-sandbox", 30), True)
    for cols, rows in [(40, 10), (40, 12), (60, 14), (80, 24)]:
        drawn = _visible(render(small, cols, rows)).split("\n")
        _eq("the keys row at %dx%d" % (cols, rows), "? keys" in drawn[-1] or "keys" in drawn[-1], True)
        _eq("the console at %dx%d" % (cols, rows), len([r for r in drawn if "INFO: x" in r]), 1)

    redraw = _screen(ctx, [], drawn = "frame")
    on_key(redraw, "ctrl-l", 10)
    _eq("Ctrl+L redraws", redraw["drawn"], None)

    # Long lines wrap (the default), `w` cuts them; a log too.
    _eq("wrapped by cells", wrap_line("abcdefgh", 3), [("abc", 0), ("def", 3), ("gh", 6)])
    _eq("a wide character kept whole", wrap_line("ab✅c", 3), [("ab", 0), ("✅c", 2)])
    _eq("an empty line is a row", wrap_line("", 5), [("", 0)])
    long = "src/a.cc:1:2: error: " + "x" * 100 + " THE_END"
    wide = _screen(ctx, ["INFO: before", long], task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False, zoom = True)
    drawn = _visible(render(wide, 40, 12))
    _eq("its end shows", "THE_END" in drawn, True)
    on_key(wide, "w", 10)
    _eq("w cuts it", ("THE_END" in _visible(render(wide, 40, 12)), wide["wrap"]), (False, False))
    on_key(wide, "w", 10)
    many_long = _screen(ctx, ["line %d " % i + "y" * 60 for i in range(20)], task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False, zoom = True)
    on_key(many_long, "K", 10)
    top = _visible(render(many_long, 40, 12)).split("\n")
    _eq("at the top, the oldest line from its first row", len([r for r in top if "line 0 " in r]), 1)
    linked_long = _screen(ctx, ["see https://x.test/" + "a" * 60], task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False, zoom = True, line_links = {"see https://x.test/" + "a" * 60: [[4, 79, "https://x.test/" + "a" * 60]]})
    linked_rows = render(linked_long, 40, 12)
    _eq("a link carried onto each of its rows", linked_rows.count("\x1b]8;;https://x.test/"), 3)
    linked_long.update(ansi = ctx.std.re.compile(ANSI), env = _fake_env({}), process = _fake_process(["pbcopy"], ran))
    ran.clear()
    first = linked_long["pane"][0]
    on_key(linked_long, "mouse-press:0:%d" % first, 10)
    on_key(linked_long, "mouse-drag:39:%d" % (first + 2), 10)
    on_key(linked_long, "mouse-release:39:%d" % (first + 2), 10)
    _eq("a wrapped line copies as one", ran[-1][1], ["see https://x.test/" + "a" * 60])

    # A flaky test's failed attempt is not a red ✗; a timeout says so.
    tests = _screen(ctx, [], test_counts = {}, spread = {})
    flaky_attempt = failure_of("test_result", struct(label = "//t:flaky", attempt = 1, run = 1, shard = 1, configuration = struct(id = "c")), struct(status = "FAILED", test_attempt_duration_millis = 120, test_action_output = []))
    timed_out = failure_of("test_result", struct(label = "//t:slow", attempt = 1, run = 1, shard = 1, configuration = struct(id = "c")), struct(status = "TIMEOUT", test_attempt_duration_millis = 4012, test_action_output = []))
    tests["fails"] = [flaky_attempt, timed_out]
    tests["counts"]["flaky"] = {"//t:flaky": True}
    rows = failure_rows(tests, 4, 70)
    _eq("flaky drawn as such", (rows[0].startswith(_role("warning") + "~"), "flaky, passed on a later attempt" in rows[0]), (True, True))
    _eq("a timeout says how long", "attempt 1 · timeout after 4.0s" in rows[1], True)

    # The finished screen's slowest actions and critical path.
    timed = _screen(ctx, [], task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False)
    note_progress(timed, ["[1 / 3] 2 actions running", "    Compiling a.cc; 3s local", "    Linking b; 1s local"])
    note_progress(timed, ["[2 / 3] 1 action running", "    Compiling a.cc; 9s local"])
    add_lines(timed, ["INFO: Elapsed time: 12.0s, Critical Path: 9.2s"])
    _eq("the slowest, not the critical path", slowest_rows(timed), ["Compiling a.cc; 9s", "Linking b; 1s"])
    _eq("the critical path in the Results pane", "Critical path 9.2s" in _visible(render(dict(timed, ended = True, task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, progress = [], pages = []), 120, 30)), True)
    timed.update(ended = True, progress = [])
    _eq("shown once the build is done", "Slowest" in _visible(render(timed, 100, 30)), True)
    for i in range(8):
        note_progress(timed, ["[2 / 3] 1 action running", "    Step %d; %ds local" % (i, i + 1)])
    _eq("its overflow counted from what it lists", [r for r in _visible(render(timed, 60, 14)).split("\n") if "more" in r and "-" in r], [])

    # A successful action's output folds under its INFO: From; Ctrl+O shows it.
    fold = _screen(ctx, [], task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False, zoom = True)
    add_lines(fold, ["INFO: From Compiling a.cc:", "a.cc:1: warning: x", "a.cc:2: note: y", "INFO: Build completed", "ERROR: b failed", "b.cc:1: error: z"])
    drawn = _visible(render(fold, 80, 14))
    _eq("folded to a count", ("+2 lines (Ctrl+O shows them)" in drawn, "warning: x" in drawn, "b.cc:1: error: z" in drawn), (True, False, True))
    on_key(fold, "ctrl-o", 10)
    _eq("Ctrl+O shows them", "a.cc:1: warning: x" in _visible(render(fold, 80, 14)), True)
    on_key(fold, "ctrl-o", 10)

    # A click on a fold's count, or its INFO: From, shows just its lines,
    # that line kept where it was; again folds them. What clicks opened
    # holds as lines come and the view scrolls; Ctrl+O shows every one and
    # forgets them, so folding again folds all.
    def _click(st, text):
        rows = _visible(render(st, 80, 20)).split("\n")
        at = [i for i, r in enumerate(rows) if text in r]
        on_key(st, "mouse-press:10:%d" % at[0], 10)
        on_key(st, "mouse-release:10:%d" % at[0], 10)
        return at[0]

    def _row_of_text(st, text):
        rows = _visible(render(st, 80, 20)).split("\n")
        return [i for i, r in enumerate(rows) if text in r]

    blocks = _screen(ctx, [], task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False, zoom = True, mouse = True)
    add_lines(blocks, ["INFO: From Compiling a.cc:", "a.cc:1: warning: x", "a.cc:2: note: y", "INFO: From Compiling b.cc:", "b.cc:1: warning: w", "INFO: Build completed"])
    _eq("a click says so", _row_of_text(blocks, "+2 lines (click or Ctrl+O shows them)") != [], True)
    before = _row_of_text(blocks, "INFO: From Compiling a.cc:")
    _click(blocks, "+2 lines (click")
    shown = _visible(render(blocks, 80, 20))
    _eq("just that block shown", ("a.cc:2: note: y" in shown, "b.cc:1: warning: w" in shown, "+1 line (click" in shown), (True, False, True))
    _eq("its line kept where it was", _row_of_text(blocks, "INFO: From Compiling a.cc:"), before)
    _eq("the toggle's note", "expanded · click again to fold" in _visible(keys_row(blocks, 120)), True)
    add_lines(blocks, ["more %d" % i for i in range(30)])
    blocks["scroll"] = 0
    _eq("kept open as lines come and the view scrolls", "a.cc:2: note: y" in "\n".join(shown_lines(blocks)), True)
    blocks["scroll"] = len(shown_lines(blocks)) - 10
    _click(blocks, "+1 line (click")
    _eq("two open", ("a.cc:1: warning: x" in "\n".join(shown_lines(blocks)), "b.cc:1: warning: w" in "\n".join(shown_lines(blocks))), (True, True))
    _click(blocks, "INFO: From Compiling a.cc:")
    _eq("a click on its INFO: From folds it again", ("a.cc:1: warning: x" in "\n".join(shown_lines(blocks)), "b.cc:1: warning: w" in "\n".join(shown_lines(blocks))), (False, True))
    on_key(blocks, "ctrl-o", 10)
    on_key(blocks, "ctrl-o", 10)
    _eq("Ctrl+O twice folds every one again", ("a.cc:1: warning: x" in "\n".join(shown_lines(blocks)), "b.cc:1: warning: w" in "\n".join(shown_lines(blocks))), (False, False))

    # Only in the console: a click on a row of another tab is no fold's.
    tabbed = _screen(ctx, [], zoom = True, mouse = True)
    add_lines(tabbed, ["INFO: From x:", "y1", "y2", "INFO: Build completed"])
    fold_row = _row_of_text(tabbed, "+2 lines")[0]
    tabbed["tab"] = "metrics"
    render(tabbed, 80, 20)
    on_key(tabbed, "mouse-press:10:%d" % fold_row, 10)
    on_key(tabbed, "mouse-release:10:%d" % fold_row, 10)
    _eq("no fold toggled from Metrics", tabbed.get("fold_open"), {})

    # With long lines wrapped, scrolled up: the clicked line keeps its row.
    wrapped = _screen(ctx, [], zoom = True, mouse = True)
    add_lines(wrapped, ["a%d" % i for i in range(10)] + ["INFO: From w:"] + ["w" * 150 + " %d" % i for i in range(3)] + ["INFO: Build completed"] + ["v" * 150 + " %d" % i for i in range(30)])
    wrapped["scroll"] = 26
    before = _row_of_text(wrapped, "INFO: From w:")
    _click(wrapped, "+3 lines")
    after = _row_of_text(wrapped, "INFO: From w:")[0]
    _eq("its row kept with lines wrapped (a row off at most)", abs(after - before[0]) <= 1, True)
    _click(wrapped, "INFO: From w:")
    _eq("and folding again", abs(_row_of_text(wrapped, "INFO: From w:")[0] - after) <= 1, True)
    unwrapped = dict(wrapped, wrap = False)
    before = _row_of_text(unwrapped, "INFO: From w:")
    _click(unwrapped, "+3 lines")
    _eq("exactly, with lines cut", _row_of_text(unwrapped, "INFO: From w:"), before)

    # Following, it goes on following.
    tail = _screen(ctx, [], zoom = True, mouse = True)
    add_lines(tail, ["INFO: From t:", "t1", "t2"])
    _click(tail, "+2 lines")
    _eq("still following", tail["scroll"], 0)

    # An INFO: From with nothing under it yet: no claim, nothing opened.
    bare = _screen(ctx, [], zoom = True, mouse = True)
    add_lines(bare, ["INFO: From b:"])
    _click(bare, "INFO: From b:")
    _eq("nothing to expand", (bare.get("note"), bare.get("fold_open")), (None, {}))
    add_lines(bare, ["b1", "b2"])
    _eq("its lines come folded", "  … +2 lines (click or Ctrl+O shows them)" in shown_lines(bare), True)

    plain_rows = _screen(ctx, [], zoom = True, mouse = False)
    add_lines(plain_rows, ["INFO: From x:", "y"])
    _eq("without the mouse, only Ctrl+O named", "  … +1 line (Ctrl+O shows them)" in shown_lines(plain_rows), True)
    _eq("the overlay names the click", any(["show or fold its lines" in r for r in help_rows(blocks)]), True)

    fold["filter"] = "warnings"
    _eq("a tool's warning under INFO: From is no warning of Bazel's", "a.cc:1: warning: x" in _visible(render(fold, 80, 14)), False)

    # A jump to a match lands on it with long lines wrapped.
    wrapped = _screen(ctx, ["short %d" % i for i in range(40)] + ["needle here"] + ["x" * 300] * 59, task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False, zoom = True)
    page = console_height(wrapped, 80, 30)
    on_key(wrapped, "/", page)
    for c in "needle".elems():
        on_key(wrapped, c, page)
    _eq("the wrapped jump shows its match", "needle here" in _visible(render(wrapped, 80, 30)), True)
    on_key(wrapped, "enter", page)
    jumped_scroll = wrapped["scroll"]
    for _ in range(30):
        on_key(wrapped, "down", page)
        render(wrapped, 80, 30)
    _eq("then the keys scroll away from it", wrapped["scroll"] < jumped_scroll, True)
    on_key(wrapped, "K", page)
    render(wrapped, 80, 30)
    _eq("and g reaches the top", "short 0" in _visible(render(wrapped, 80, 30)), True)

    # The match stays drawn on the frames after its jump, and a resize
    # centres it again.
    def _held(log, query, steps, label):
        st = _screen(ctx, log, task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False)
        page = console_height(st, 80, 30)
        render(st, 80, 30)
        on_key(st, "/", page)
        for c in query.elems():
            on_key(st, c, page)
            render(st, 80, 30)
        on_key(st, "enter", page)
        for key in [None] + steps:
            if key:
                on_key(st, key, page)
            current = st["log"][len(st["log"]) - 1 - st["search"]["back"]]
            for frame in range(3):
                _eq("%s: %s on frame %d after %s" % (label, current, frame + 1, key or "the jump"), current[:20] in _visible(render(st, 80, 30)), True)
        return st

    _held(["x" * 800] * 20 + ["needle here"] + ["y" * 800] * 20, "needle", [], "long lines")
    stepped = _held([("hit %d " % i) + "z" * 290 if i % 7 == 0 else "w" * 300 for i in range(120)], "hit", ["N"] * 6, "stepping")
    current = stepped["log"][len(stepped["log"]) - 1 - stepped["search"]["back"]]

    # A match taller than the pane: each ↓ after the jump shows a newer line.
    tall = _held(["short %d" % i for i in range(30)] + ["needle " + "t" * 3000] + ["s%d" % i for i in range(60)], "needle", [], "a tall match")
    page = console_height(tall, 80, 30)
    seen = []
    for _ in range(25):
        on_key(tall, "down", page)
        drawn = _visible(render(tall, 80, 30))
        newest = -1
        for i in range(60):
            if ("│ s%d " % i) in drawn:
                newest = i
        seen.append(newest)
    _eq("↓ moves the view every press", [seen[i] > seen[i - 1] for i in range(1, len(seen)) if seen[i - 1] < 59], [True] * len([1 for i in range(1, len(seen)) if seen[i - 1] < 59]))
    _eq("resized, still shown", current[:20] in _visible(render(stepped, 60, 20)), True)
    _eq("and after", current[:20] in _visible(render(stepped, 60, 20)), True)

    # A search from a folded view starts where the view was, in lines.
    origin = _screen(ctx, [], task = "build", phase = "", start_ms = 0, now_ms = 0, frames = 0, pages = [], ended = False, zoom = True)
    lines = ["A match"]
    for b in range(50):
        lines += ["INFO: From Step %d:" % b] + [("C match" if b == 30 and i == 4 else "out %d %d" % (b, i)) for i in range(8)]
    add_lines(origin, lines)
    origin["scroll"] = 60
    page = console_height(origin, 80, 30)
    on_key(origin, "/", page)
    _eq("the origin in lines", origin["search"]["origin"] > 60, True)
    for c in "match".elems():
        on_key(origin, c, page)
    _eq("jumps to the match above the view, not the one below it", origin["log"][len(origin["log"]) - 1 - origin["search"]["back"]], "A match")
    on_key(origin, "esc", page)
    _eq("Esc goes back to the folded view's own scroll", origin["scroll"], 60)

    # Many tests: Bazel's closing block keeps its head and its tail, the
    # `Executed` line among them; a flaky test is no failure.
    many_tests = _screen(ctx, [], log_path = "", bes_base = "", bazel_uuid = "", update = {}, read = lambda p, n: None, exec_root = "", output_dirs = {}, last_attempts = {})
    add_lines(many_tests, ["INFO: Elapsed time: 9.0s, Critical Path: 8.0s"] + ["//t:t%d   PASSED in 0.1s" % i for i in range(300)] + ["Executed 300 out of 300 tests: 300 tests pass."])
    report = report_lines(many_tests, "t-2", False)
    _eq("the Executed line kept", "Executed 300 out of 300 tests: 300 tests pass." in report, True)
    _eq("the rest counted", [l for l in report if l.startswith("… ") and "more of Bazel's lines" in l] != [], True)
    flaky_report = _screen(ctx, [], log_path = "", bes_base = "", bazel_uuid = "", update = {}, read = lambda p, n: None, exec_root = "", output_dirs = {}, last_attempts = {})
    flaky_report["fails"] = [failure_of("test_result", struct(label = "//t:f", attempt = 1, run = 1, shard = 1, configuration = struct(id = "c")), struct(status = "FAILED", test_action_output = []))]
    flaky_report["counts"]["flaky"] = {"//t:f": True}
    lines = report_lines(flaky_report, "t-3", False)
    _eq("flaky, not failed", ("Failed:" in lines, "Flaky (passed on a later attempt):" in lines, "  ~ //t:f  attempt 1" in lines), (False, True, True))

    # When the screen refuses the terminal, and says why.
    def _std(env = {}, size = (100, 30), tty = True):
        return struct(
            io = struct(stdout = struct(is_tty = tty), stderr = struct(is_tty = tty)),
            env = _fake_env(env),
            term = struct(size = lambda: size),
        )

    human = {"TERM": "xterm-256color"}
    _eq("a person's terminal", refusal(_std(human)), "")
    _eq("not a terminal", refusal(_std(human, tty = False)), None)
    _eq("CI", refusal(_std(dict(human, CI = "true"))), None)
    _eq("an agent's pty", "coding agent" in refusal(_std(dict(human, CURSOR_AGENT = "1"))), True)
    _eq("Claude Code's", "coding agent" in refusal(_std(dict(human, CLAUDECODE = "1"))), True)
    _eq("a dumb terminal", refusal(_std({"TERM": "dumb"})), "dashboard off: TERM is dumb; Bazel's console is shown instead")
    _eq("no TERM", "TERM is not set" in refusal(_std({})), True)
    _eq("too small", "39x30, under 40x12" in refusal(_std(human, size = (39, 30))), True)

    # A target Bazel did not build because a dependency failed: named as
    # blocked, chosen like a failure, its root cause's log on Enter.
    _eq("blocked by a name in its package", blocked_text("//a:demo", ["//a:broken"]), "blocked by :broken")
    _eq("by a label in another, and more", blocked_text("//a:demo", ["//b:x", "//c:y"]), "blocked by //b:x and 1 more")
    rec = {"kind": "action", "label": "//a:broken", "detail": "Genrule", "files": [], "output": "", "success": False}
    blocked = _screen(ctx, [], fails = [rec], root_causes = {"//a:demo": ["//a:broken"]}, focus = "failures")
    blocked["counts"]["failures"] = ["//a:broken", "//a:demo"]

    # Bazel's target_completed for it (not success) counted it failed.
    blocked["counts"]["failed"] = 1
    blocked["counts"]["failed_labels"] = {"//a:demo": True}
    rows = [_visible(r) for r in failure_rows(blocked, 5, 60)]
    _eq("the blocked row", "○ //a:demo  blocked by :broken" in rows[1], True)
    on_key(blocked, "down", 10)
    _eq("chosen like a failure", blocked["selected"], 1)
    on_key(blocked, "enter", 10)
    _eq("Enter shows what blocks it", (blocked["selected"], blocked["view"]["record"]["label"]), (0, "//a:broken"))
    report = [_visible(l) for l in report_lines(dict(blocked, read = lambda p, n: None, build = None, bes_base = "", bazel_uuid = "", update = {}, log_path = ""), "id1", False)]
    _eq("under its root cause in the summary", [l for l in report if "blocked" in l and "○" in l], ["    ○ 1 blocked: //a:demo"])
    _eq("not counted as a root cause", [l for l in report if l.startswith("──")], ["── Failures (1) ──"])
    _eq("its summary counts it blocked, not failed", [l for l in report if l.startswith("0 built")], ["0 built, 0 failed, 1 blocked · 0 tests passed, 0 failed"])
    targets = [_visible(l) for l in metrics_lines(blocked) if "built" in _visible(l) or "listed" in _visible(l)]
    _eq("Metrics' targets by the same counts", [" ".join(l.split()) for l in targets], ["built 0 · 0 failed · 1 blocked by a dependency", "failures listed 1 (failed actions and test attempts, in Failures)"])

    # A test whose summary is Aborted with no reason: failed where one of
    # its attempts failed (it failed to build), skipped where none ran (a
    # build without --keep_going stopped first); an interrupt is no verdict.
    aborted_tests = new_counts()
    count_event(aborted_tests, "test_result", struct(label = "//t:built_badly", configuration = struct(id = "c")), struct(status = "failed_to_build"))
    count_aborted_test(aborted_tests, "//t:built_badly", "unknown", "c")
    count_aborted_test(aborted_tests, "//t:never_ran", "unknown", "c")
    count_aborted_test(aborted_tests, "//t:stopped", "user_interrupted", "c")
    _eq("an aborted test summary", (aborted_tests["tests_failed"], aborted_tests["failures"], aborted_tests["tests_skipped"]), (1, ["//t:built_badly"], 1))

    # One attempt Bazel posts twice is one row, the one with a log; a failed
    # TestRunner action is the attempt after the last whose result came, as
    # Bazel 9 sends them (this order is r29's shard.json, oldshard_flaky, run 1
    # shard 2 and run 1 shard 1), dropped once that attempt's result comes
    # with its log, else kept as the only log of an attempt Bazel cut off.
    out = "bazel-out/darwin_arm64-fastbuild/testlogs/examples/r29tmp/oldshard_flaky/"
    lab = "//examples/r29tmp:oldshard_flaky"
    log = [struct(name = "test.log", file = struct(uri = "file:///x/test.log"))]
    runner = struct(success = False, type = "TestRunner", stderr = struct(file = struct(contents = "boom")))

    def _result(run, shard, attempt, status, files):
        return (struct(label = lab, run = run, shard = shard, attempt = attempt, configuration = struct(id = "c")), struct(status = status, test_action_output = files))

    def _runner(folder):
        return (struct(label = lab, primary_output = out + folder + "/test.log", configuration = struct(id = "c")), runner)

    real = _screen(ctx, ["x"])
    for kind, (eid, payload) in [
        ("test_result", _result(1, 2, 1, "FAILED", log)),
        ("test_result", _result(1, 1, 1, "FAILED", log)),
        ("action_completed", _runner("shard_1_of_2_run_1_of_2")),
        ("test_result", _result(1, 2, 2, "FAILED", log)),
        ("action_completed", _runner("shard_2_of_2_run_1_of_2")),
        ("test_result", _result(1, 1, 1, "FAILED_TO_BUILD", [])),
        ("test_result", _result(1, 2, 1, "FAILED_TO_BUILD", [])),
        ("test_result", _result(1, 2, 3, "NO_STATUS", [])),
        ("test_result", _result(1, 1, 2, "NO_STATUS", [])),
    ]:
        note_event(real, kind, eid, payload, False)
    rows = [(r["kind"], r.get("run"), r.get("shard"), r.get("attempt"), r.get("attempt_key")) for r in real["fails"]]
    _eq("each attempt once; the actions of cut-off attempts kept", rows, [
        ("test", 1, 2, 1, None),
        ("test", 1, 1, 1, None),
        ("action", None, None, None, (lab, "c", 1, 1, 2)),
        ("test", 1, 2, 2, None),
        ("action", None, None, None, (lab, "c", 1, 2, 3)),
    ])
    first = _screen(ctx, ["x"])
    note_event(first, "action_completed", _runner("shard_2_of_2_run_1_of_2")[0], runner, False)
    note_event(first, "test_result", _result(1, 2, 1, "FAILED", log)[0], _result(1, 2, 1, "FAILED", log)[1], False)
    _eq("an action folded once its attempt comes with its log", [r["kind"] for r in first["fails"]], ["test"])

    # r29's shard.json, combo: a shard that failed to build, its action (the
    # only log) before its result, which has none: one row, the action's.
    combo = _screen(ctx, ["x"])
    combo_out = "bazel-out/darwin_arm64-fastbuild/testlogs/examples/r29tmp/combo/shard_1_of_2_run_1_of_2/test.log"
    note_event(combo, "action_completed", struct(label = "//examples/r29tmp:combo", primary_output = combo_out, configuration = struct(id = "c")), runner, False)
    note_event(combo, "test_result", struct(label = "//examples/r29tmp:combo", run = 1, shard = 1, attempt = 1, configuration = struct(id = "c")), struct(status = "FAILED_TO_BUILD", test_action_output = []), False)
    _eq("a shard that failed to build: the action's row alone", [r["kind"] for r in combo["fails"]], ["action"])

    # The folder after testlogs/<package>/<name>/ alone names the run and
    # shard: not a test named like one, nor a package folder.
    def _place(label, path):
        st = _screen(ctx, ["x"])
        note_event(st, "action_completed", struct(label = label, primary_output = path), runner, False)
        return st["fails"][0]["attempt_key"]

    _eq("a test named shard_9_x", _place("//p:shard_9_x", "bazel-out/k8/testlogs/p/shard_9_x/test.log"), ("//p:shard_9_x", "", 1, 1, 1))
    _eq("a package folder run_2", _place("//run_2/p:t", "bazel-out/k8/testlogs/run_2/p/t/shard_2_of_3/test.log"), ("//run_2/p:t", "", 1, 2, 1))

    # Metrics' spawns: after the build until its execution log is read, then
    # what it held, none included.
    reading = _screen(ctx, ["x"])
    spawns = lambda st: [" ".join(_visible(l).split()) for l in metrics_lines(st) if "spawns" in _visible(l)]
    _eq("spawns before the log is read", spawns(reading), ["spawns after the build, from its execution log"])
    reading["exec_log_read"] = True
    _eq("a log with none", spawns(reading), ["spawns 0 run: the execution log has none"])

    # The caller's own binary or JSON log: Bazel writes no compact one, so
    # the Dashboard read none; Results shows no cache row.
    own = _screen(ctx, ["x"], exec_log_read = True, inv = {"options_parsed": struct(cmd_line = ["--keep_going", "--execution_log_binary_file=/tmp/x.binlog"], explicit_cmd_line = [])})
    _eq("spawns beside the caller's log", spawns(own), ["spawns not read: this build writes its own execution log (--execution_log_binary_file)"])
    _eq("no cache row in Results", "Cached" in _visible(render(own, 120, 30)), False)
    for flags, want in [
        (["--execution_log_binary_file="], None),
        (["--execution_log_binary_file=/tmp/rc.binlog", "--execution_log_binary_file="], None),
        (["--execution_log_json_file=", "--execution_log_json_file=/tmp/x.json"], "--execution_log_json_file"),

        # As the CLI's `other_format` reads them: false words and `--no` are
        # none, the bare flag and true words one.
        (["--execution_log_binary_file=false"], None),
        (["--execution_log_binary_file=/tmp/rc.binlog", "--noexecution_log_binary_file"], None),
        (["--execution_log_json_file=0"], None),
        (["--execution_log_binary_file"], "--execution_log_binary_file"),
        (["--execution_log_binary_file=true"], "--execution_log_binary_file"),
        (["--noexecution_log_json_file", "--execution_log_json_file=/tmp/x.json"], "--execution_log_json_file"),
    ]:
        _eq("the caller's own log from %r" % flags, own_execution_log({"options_parsed": struct(cmd_line = flags, explicit_cmd_line = [])}), want)

    # A cached build's slowest pane: that nothing ran, not an empty box, only
    # where the build succeeded and its metrics say so: not mid-build, nor
    # after a failed one.
    def _metrics(executed, misses):
        return struct(action_summary = struct(actions_executed = executed, action_cache_statistics = struct(hits = 0, misses = misses)))

    # r29's cached5.json: a fully cached rebuild still runs the workspace
    # status action, which Bazel runs on every build.
    cached5 = struct(action_summary = struct(
        actions_executed = 1,
        action_data = [
            struct(mnemonic = "BazelWorkspaceStatusAction", actions_executed = 1, actions_created = 1),
            struct(mnemonic = "TestRunner", actions_created = 17),
            struct(mnemonic = "Genrule", actions_created = 4),
        ],
        runner_count = [struct(name = "total", count = 1), struct(name = "internal", count = 1)],
        action_cache_statistics = struct(misses = 1),
    ))

    success = struct(exit_code = struct(name = "SUCCESS", code = 0))
    failure = struct(exit_code = struct(name = "BUILD_FAILURE", code = 1))
    cases = [
        ("a cached build", dict(building = False, inv = {"build_finished": success, "build_metrics": cached5}), ["nothing ran: every action was cached"]),
        ("a build that ran a Genrule", dict(building = False, inv = {"build_finished": success, "build_metrics": struct(action_summary = struct(actions_executed = 2, action_data = [struct(mnemonic = "BazelWorkspaceStatusAction", actions_executed = 1), struct(mnemonic = "Genrule", actions_executed = 1)]))}), []),
        ("mid-build", dict(building = True, inv = {}), []),
        ("a failed build", dict(building = False, inv = {"build_finished": failure, "build_metrics": _metrics(1, 1)}), []),
    ]
    for what, kw, want in cases:
        _eq("slowest: " + what, [_visible(r) for r in slowest_rows(_screen(ctx, [], critical = "a.cc 1s", **kw))], want)

    # Drawn in the finished pane, the row is as wide as the others.
    cached_screen = _screen(ctx, [], critical = "a.cc 1s", ended = True, building = False, inv = {"build_finished": success, "build_metrics": cached5})
    end_build(cached_screen, 1000)
    framed = [r for r in render(cached_screen, 100, 30).split("\n") if "nothing ran" in _visible(r)]
    _eq("the nothing-ran row's width", [text_width(_visible(r).rstrip("\r")) for r in framed], [100])
    mid = _screen(ctx, ["x"], building = True)
    _eq("Metrics keeps no Slowest mid-build", any(["Slowest" in _visible(l) for l in metrics_lines(mid)]), False)

    # Blocked only by a dependency that failed; a missing source file (an
    # unconfigured root) is the target's own failure.
    def _completed(label, roots):
        return struct(kind = "target_completed", id = struct(label = label), payload = struct(success = False), children = [struct(id = struct(label = r)) for r in roots])

    own = _screen(ctx, ["x"])
    note_blocked(own, _completed("//p:gen", ["//p:missing.txt"]))
    dep = _screen(ctx, ["x"])
    dep["counts"]["failed_labels"] = {"//p:broken": True}
    note_blocked(dep, _completed("//p:demo", ["//p:broken"]))
    _eq("blocked by what failed, not a missing source", (blocked_targets(own), blocked_targets(dep)), ({}, {"//p:demo": ["//p:broken"]}))

    # r29's nokg.json, without --keep_going: fastfail failed; a flaky test's
    # second attempt was cut off and three never ran, all Aborted with no
    # reason: Bazel's "1 fails locally and 4 were skipped".
    nokg = new_counts()
    tid = lambda label: struct(label = "//examples/r29tmp:" + label, configuration = struct(id = "c"))
    count_event(nokg, "test_result", tid("flaky_then_skip"), struct(status = "failed"))
    count_event(nokg, "test_result", tid("fastfail"), struct(status = "failed"))
    count_event(nokg, "test_summary", tid("fastfail"), struct(overall_status = "failed"))
    for label in ["flaky_then_skip", "sleepy1", "sleepy0", "sleepy2"]:
        count_aborted_test(nokg, "//examples/r29tmp:" + label, "unknown", "c")
    _eq("Bazel's count without --keep_going", (nokg["tests_failed"], nokg["tests_skipped"]), (1, 4))

    # A test target that failed to build, or was blocked, gets no summary:
    # failed, as Bazel counts it ("fails to build"), once.
    # Under `aspect build` no test runs: none failed.
    for command, want in [("test", 1), ("build", 0)]:
        unbuilt = new_counts()
        count_event(unbuilt, "build_started", struct(), struct(command = command))
        count_event(unbuilt, "target_configured", tid("needs_bad"), struct(target_kind = "sh_test rule"))
        count_event(unbuilt, "target_configured", tid("bad"), struct(target_kind = "genrule rule"))
        count_event(unbuilt, "target_completed", tid("needs_bad"), struct(success = False))
        count_event(unbuilt, "target_completed", tid("bad"), struct(success = False))
        count_aborted_test(unbuilt, "//examples/r29tmp:needs_bad", "unknown", "c")
        _eq("a test that failed to build, under %s" % command, unbuilt["tests_failed"], want)

    # r29's anal.json: a0 to a4 fail in analysis for zz_broken, Bazel
    # posting three before it. Blocked whatever came first.
    anal = _screen(ctx, ["x"])
    root = "//examples/r29tmp:zz_broken"
    configured = lambda label: struct(kind = "target_configured", id = struct(label = label), payload = struct(), children = [struct(id = struct(label = root))])
    for label in ["a0", "a3", "a4", "zz_broken", "a2", "a1"]:
        note_blocked(anal, configured("//examples/r29tmp:" + label))
        count_aborted(anal["counts"], "//examples/r29tmp:" + label, "analysis_failure")
    _eq("blocked by a root posted after them", sorted(blocked_targets(anal)), ["//examples/r29tmp:a%d" % i for i in range(5)])

    # r31's load.json: t_nopkg is blocked by a target in a package that is
    # not there, which it was not asked for and which Bazel reports only as
    # an Aborted configured_label, once per configuration. That root is a
    # failure of its own, once, its log Bazel's error; the build shows it
    # failed. An Aborted payload's type can't be made here: `aborted` says
    # what a real one's type would.
    mix = _screen(ctx, ["x"], fs = ctx.std.fs, syntax = None, page_h = 10, env = ctx.std.env, read = lambda p, c: None, ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), test_counts = {}, spread = {}, last_attempts = {})
    root = "//examples/r31_nonexistent:x"
    error = "no such package 'examples/r31_nonexistent': BUILD file not found in any of the following directories."
    for config in ("ddf13d99", "6eed62c4"):
        rid = struct(label = root, configuration = struct(id = config))
        aborted = struct(reason = "ANALYSIS_FAILURE", description = error)
        count_event(mix["counts"], "configured_label", rid, aborted, aborted = True)
        note_event(mix, "configured_label", rid, aborted, True)
    note_blocked(mix, struct(kind = "target_configured", id = struct(label = "//examples/r30tmp:t_nopkg"), payload = struct(), children = [struct(id = struct(label = root))]))
    count_aborted(mix["counts"], "//examples/r30tmp:t_nopkg", "analysis_failure")
    _eq("blocked by a dependency that failed analysis, unasked", sorted(blocked_targets(mix)), ["//examples/r30tmp:t_nopkg"])
    _eq("the root counted once", mix["counts"]["failed_labels"].get(root), True)
    rows = [(r["label"], r["detail"]) for r in mix["fails"]]
    _eq("the root's row", rows, [(root, "analysis failed")])
    results = _visible(render(mix, 140, 40))
    _eq("Results says it failed", "1 failed, 1 blocked" in results, True)
    on_key(mix, "2", 10)
    on_key(mix, "enter", 10)
    _eq("Enter shows Bazel's error", "no such package" in _visible(render(mix, 140, 40)), True)

    # A target asked for that fails analysis is its own root cause, Bazel 9
    # posting an Aborted configured_label for it before its Aborted
    # target_configured: one failure, not two.
    solo = _screen(ctx, ["x"], fs = ctx.std.fs, syntax = None, page_h = 10, env = ctx.std.env, read = lambda p, c: None, ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), test_counts = {}, spread = {}, last_attempts = {})
    own = "//p:req_broken"
    rid = struct(label = own, configuration = struct(id = "6e1e0d0f"))
    aborted = struct(reason = "ANALYSIS_FAILURE", description = "in broken rule " + own)
    count_event(solo["counts"], "configured_label", rid, aborted, aborted = True)
    note_event(solo, "configured_label", rid, aborted, True)
    note_blocked(solo, struct(kind = "target_configured", id = struct(label = own), payload = struct(), children = [struct(id = rid)]))
    count_event(solo["counts"], "target_configured", struct(label = own), struct(reason = "ANALYSIS_FAILURE"), aborted = True)
    _eq("a target asked for, its own root, failed once", solo["counts"]["failed"], 1)
    _eq("Results says it failed once", "0 built, 1 failed" in _visible(render(solo, 140, 40)), True)

    ok = _screen(ctx, ["x"])
    note_blocked(ok, struct(kind = "target_configured", id = struct(label = "//p:ok"), payload = struct(), children = [struct(id = struct(label = "//p:ok"))]))
    _eq("a configured target's own completion is no root cause", blocked_targets(ok), {})

    # A build picked with < while the next runs: its own Slowest, not
    # hidden as if it were running.
    picked = _screen(ctx, ["x"], building = True, tab = "metrics", spawn_slowest = [(5000, "Genrule", "//a:slow")], inv = {"build_finished": success})
    end_build(picked, 1000)
    new_build(picked, 2000)
    picked["building"] = True
    on_key(picked, "<", 10)
    _eq("an earlier build's Slowest while the next runs", "Genrule //a:slow" in _visible(render(picked, 110, 60)), True)

    # Skipped tests in the scrollback's summary and the narrow header.
    skips = _screen(ctx, ["x"], read = lambda p, n: None, build = None, bes_base = "", bazel_uuid = "", update = {}, log_path = "")
    skips["counts"]["tests_skipped"] = 3
    _eq("skipped in the summary", [l for l in report_lines(skips, "s1", False) if "3 skipped" in l] != [], True)
    _eq("skipped in the narrow header", "⊘3" in _visible(render(skips, 64, 30)), True)

    # A build folded at its end keeps that its execution log was read.
    ended = _screen(ctx, ["x"], building = True)
    end_build(ended, 1000)
    _eq("a folded build's log read", ended["builds"][-1]["snapshot"]["exec_log_read"], True)

    # Page Up and Option/Alt+↑ scroll, not an Esc and the arrow.
    paged = _screen(ctx, ["l%d" % i for i in range(200)])
    on_key(paged, "pageup", 20)
    on_key(paged, "alt-up", 20)
    _eq("a page, then half", paged["scroll"], 30)

    # The link under the pointer.
    _eq("a link's cells", link_span_at("see " + link("https://x.test", "here") + " now", 5), (4, 8))
    _eq("none off it", link_span_at("see " + link("https://x.test", "here") + " now", 9), None)

    # A line too long is cut, its rest on disk; long lines keep the
    # console's text under its budget, the oldest going first.
    big = _screen(ctx, [])
    add_lines(big, ["x" * 20000])
    _eq("a long line cut", (len(big["log"][0]) < 9000, big["log"][0].endswith("characters in the console log)")), (True, True))
    many = _screen(ctx, [])
    for _ in range(3):
        add_lines(many, ["y" * 8000] * 1000)
    _eq("under its size budget", many["log_size"] <= 16 * 1024 * 1024 and len(many["log"]) < 3000, True)
    _eq("its size counted", many["log_size"], len("".join(many["log"])))

    # A peek: the file around a line, numbered, the line marked and in the
    # middle, highlighted by its language; `o` opens it in the editor.
    tmp = ctx.std.fs.mkdtemp()
    src = tmp + "/main.rs"
    ctx.std.fs.write(src, "\n".join(["fn f%d() { let x = %d; }" % (i, i) for i in range(1, 301)]) + "\n")
    peek = _screen(ctx, [], fs = ctx.std.fs, syntax = ctx.std.syntax, env = struct(var = lambda k: None), page_h = 10)
    _eq("read", open_peek(peek, src, 100), True)
    view = peek["view"]
    _eq("its title, and the line marked", (view["title"], [l for l in view["lines"] if l.startswith("▸")]), ("main.rs:100", ["▸  100  fn f100() { let x = 100; }"]))
    drawn = render(peek, 100, 24)
    _eq("in the middle, titled", ("▸  100" in ctx.std.re.compile(ANSI).replace(drawn, ""), "Console ▹ main.rs:100" in _visible(drawn)), (True, True))
    _eq("highlighted", "\x1b[38;5;" in drawn, True)

    # The keys over a peek: the key list, every row the screen's width, and
    # the peek as it was once they close.
    peek_scroll = peek["scroll"]
    on_key(peek, "?", 10)
    keyed = [r.rstrip("\r") for r in _visible(render(peek, 100, 24)).split("\n") if r.rstrip("\r")]
    _eq("the keys, not the file", ("these keys" in "\n".join(keyed) or "… " in keyed[-3], "fn f100" in "\n".join(keyed)), (True, False))
    _eq("every row the screen's width", [text_width(r) for r in keyed if text_width(r) != 100], [])
    on_key(peek, "x", 10)
    _eq("back to the peek where it was", (peek["view"]["title"], peek["scroll"]), ("main.rs:100", peek_scroll))
    _eq("a file not there is no peek", open_peek(peek, tmp + "/gone.rs", 1), False)
    raw = tmp + "/raw.log"
    ctx.std.fs.write(raw, "a\tb\n\x1b[31mred\x1b[0m\nspin 10%\rspin 99%\n")
    peek["ansi"] = ctx.std.re.compile(ANSI)
    peek["controls"] = ctx.std.re.compile(CONTROLS)
    open_peek(peek, raw, 2)
    _eq("a log's lines made drawable", [l[8:] for l in peek["view"]["lines"]], ["a  b", "red", "spin 99%"])
    open_peek(peek, src, 100)
    _eq("the whole file, at the line", (len(peek["view"]["lines"]), peek["view"]["cut"], peek["view"]["line"]), (300, False, 100))
    opened = []
    peek["io"] = struct(editor = lambda: ("cursor", "Cursor"), editors = lambda: [("cursor", "Cursor"), ("zed", "Zed")], editor_url = lambda path, line = 1, format = "": "cursor://file%s:%d:1" % (path, line))
    peek["process"] = _fake_process(["open"], opened)
    on_key(peek, "o", 10)
    _eq("o opens it in the editor, at the line", (opened[0][0], peek["note"]), (["open", "cursor://file%s:100:1" % src], "opened in Cursor"))
    on_key(peek, "O", 10)
    _eq("O picks the next editor and says how to keep it", (peek["editor_choice"], "file_hyperlink_format = \"zed\"" in peek["note"]), ("zed", True))

    # A tool's own WARNING: line in its output is its line alone; the lines
    # under an action's ERROR: are errors.
    kinds, _ = classify(["INFO: From Executing genrule //a:s:", "WARNING: step 0 is slow", "working 1", "ERROR: a/BUILD:1:1: Executing genrule //a:b failed: (Exit 1)", "src/a.cc:3: error: nope", "INFO: Found 1 target..."])
    _eq("kinds", kinds, ["", "warning", "", "error", "error", ""])

    # A wrapped link lights whole: every row of it.
    _eq("a row's spans of a link", link_spans("a " + link("u", "bc") + " d " + link("u", "e") + link("v", "f"), "u"), [(2, 4), (7, 8)])
    lit = _screen(ctx, ["https://x.test/" + "a" * 150 + " end"], line_links = {"https://x.test/" + "a" * 150 + " end": [[0, 165, "https://x.test/" + "a" * 150]]}, hover = None)
    render(lit, 80, 14)
    rows = [i for i, r in enumerate(lit["frame"]) if link_spans(r, "https://x.test/" + "a" * 150)]
    lit["hover"] = (10, rows[-1])
    drawn = render(lit, 80, 14)
    _eq("every row of the link lit", drawn.count(theme.fg("link.hover", stream = True)) >= len(rows) and len(rows) >= 2, True)

    # A double click selects the word under it, a path whole, and copies it.
    ran = []
    words = _screen(ctx, ["see src/a.cc:12 (here)"], ansi = ctx.std.re.compile(ANSI), env = _fake_env({}), process = _fake_process(["pbcopy"], ran))
    render(words, 80, 12)
    at = [i for i, r in enumerate(words["frame"]) if "src/a.cc:12" in r][-1]
    col = ctx.std.re.compile(ANSI).replace(words["frame"][at], "").find("a.cc")
    on_key(words, "mouse-press:%d:%d" % (col, at), 10)
    on_key(words, "mouse-release:%d:%d" % (col, at), 10)
    on_key(words, "mouse-press:%d:%d" % (col, at), 10)
    on_key(words, "mouse-release:%d:%d" % (col, at), 10)
    _eq("the word, copied", (ran[-1][1] if ran else None, words["note"]), (["src/a.cc:12"], "copied 11 characters"))
    _eq("and shown selected", theme.bg("selection", stream = True) in render(words, 80, 12), True)

    # Esc goes back the way views were opened: a peek to the log it was
    # opened from, where it was scrolled, then the console.
    rec = {"kind": "action", "label": "//a:b", "detail": "Genrule", "files": [], "output": "", "success": False}
    back = _screen(ctx, [], fails = [rec], fs = ctx.std.fs, syntax = ctx.std.syntax, env = struct(var = lambda k: None), read = lambda p, n: None)
    on_key(back, "]", 10)
    _eq("] shows a failure's log", back["view"]["record"]["label"], "//a:b")
    back["scroll"] = 3
    open_peek(back, src, 10)
    on_key(back, "esc", 10)
    _eq("back to the log, as it was scrolled", (back["view"]["record"]["label"], back["scroll"]), ("//a:b", 3))
    on_key(back, "esc", 10)
    _eq("then the console", back["view"], None)

    # The tabs: 1 to 5 show each, Esc goes back to the console; the
    # Invocation tab redacts what may be a secret.
    tabs = _screen(ctx, ["x"], inv = {"options_parsed": struct(explicit_cmd_line = ["--remote_header=Authorization=Bearer abc", "--action_env=TOKEN=zzz", "--remote_cache=grpcs://u:p@host", "--define=API_TOKEN=d1", "--test_arg=--password=t1", "--copt=-DKEY=c1", "--define=mode=fast", "--test_arg=--password", "--test_arg=hunter2", "--test_arg=--token x9", "--google_default_credentials", "//keep:me", "--test_arg=--token", "--copt=-Ikept", "--test_arg=after", "--bes_header=Cookie=sess1", "//..."], explicit_startup_options = [])})
    on_key(tabs, "4", 10)
    shown = _visible(render(tabs, 100, 40))
    _eq("the invocation tab, its secrets hidden", ("Flags given" in shown, "abc" in shown, "zzz" in shown, "u:p@" in shown, "--action_env=TOKEN=<REDACTED>" in shown), (True, False, False, False, True))
    _eq("a secret's setting inside a flag's value hidden", [w in shown for w in ("d1", "t1", "c1", "--define=API_TOKEN=<REDACTED>", "--define=mode=fast")], [False, False, False, True, True])
    _eq("a secret's value in the next argument hidden", [w in shown for w in ("hunter2", "x9", "sess1", "--test_arg=<REDACTED>", "//keep:me", "--copt=-Ikept", "--test_arg=after")], [False, False, False, True, True, True, True])
    on_key(tabs, "3", 10)
    _eq("metrics", "Actions" in _visible(render(tabs, 100, 40)), True)
    for tab in ("metrics", "invocation", "failures"):
        on_key(tabs, str(1 + ["console", "failures", "metrics", "invocation", "tips"].index(tab)), 10)
        render(tabs, 100, 40)
        widths = [text_width(_visible(r)) for r in tabs["frame"]]
        _eq("every row of %s as wide as the screen" % tab, [_visible(r) for r in tabs["frame"][1:] if r and text_width(_visible(r)) != 100], [])
    on_key(tabs, "esc", 10)
    _eq("Esc to the console", tabs["tab"], "console")
    on_key(tabs, "tab", 10)
    on_key(tabs, "tab", 10)
    _eq("Tab cycles every tab", tabs["tab"], "metrics")
    on_key(tabs, "shift-tab", 10)
    _eq("Shift+Tab goes back", tabs["tab"], "failures")
    render(tabs, 100, 40)
    spans = tabs["tab_spans"]
    _eq("the tabs stay in order", [t for _, _, t in spans], ["console", "failures", "metrics", "invocation", "tips"])
    on_key(tabs, "mouse-move:%d:%d" % (spans[3][0] + 1, tabs["tab_row"]), 10)
    if _role("hover") not in render(tabs, 100, 40):
        fail("render: the tab under the pointer is lit")
    on_key(tabs, "mouse-press:%d:%d" % (spans[3][0] + 1, tabs["tab_row"]), 10)
    on_key(tabs, "mouse-release:%d:%d" % (spans[3][0] + 1, tabs["tab_row"]), 10)
    _eq("a click takes a tab", tabs["tab"], "invocation")

    # Review fixes: a peek open as a test's summary arrives; a status
    # value under a secret's name; a pointer moving keeps nothing from
    # opening; huge lines left plain; a file the system would run.
    peeked = _screen(ctx, ["x"])
    peeked["view"] = {"title": "a.py:1", "lines": ["x"], "cut": False, "record": None, "peek": True}
    note_event(peeked, "test_summary", struct(label = "//t:a", configuration = None), struct(run_count = 1, shard_count = 0), False)
    status = _screen(ctx, ["x"], inv = {"workspace_status": struct(item = [struct(key = "STABLE_API_TOKEN", value = "tok-123")])})
    _eq("a status value under a secret's name", "tok-123" in "\n".join([_visible(l) for l in invocation_lines(status)]), False)
    _eq("a minified line is left plain", highlightable(["x" * 5000]), False)
    _eq("ordinary lines are highlighted", highlightable(["x = 1"] * 100), True)
    _eq("never a file:// link", open_in_editor(dict(_screen(ctx, ["x"]), io = struct(editor_url = lambda p, line, format: "file://" + p, editors = lambda: [], editor = lambda: ("vscode", "VS Code"))), "/tmp/x.command").startswith("no editor"), True)

    # An empty Failures tab: ↓ and Enter do nothing; `a` there keeps the
    # tab's keys.
    empty = _screen(ctx, ["x"])
    for k in ("tab", "down", "enter"):
        on_key(empty, k, 10)
    _eq("an empty list: nothing chosen, nothing open", (empty["tab"], empty["selected"], empty["view"]), ("failures", 0, None))

    # Each tab owns what is opened in it, named by crumbs in the tab bar: a
    # failure's log in Failures (its attempt where there are several), a
    # file peeked from it one deeper; a crumb's click goes back to it; ]
    # steps sideways and drops a peek; } { step a target's attempts.
    def _attempt(label, attempt):
        return failure_of("test_result", struct(label = label, run = 1, shard = 1, attempt = attempt, configuration = struct(id = "c")), struct(status = "failed", test_action_output = [struct(name = "test.log", file = "x")]))

    tri = _screen(ctx, ["ERROR: x"], fails = [_attempt("//t:a", 1), _attempt("//t:a", 2), _attempt("//t:b", 1)], fs = ctx.std.fs, syntax = None, page_h = 10, env = ctx.std.env, read = lambda p, c: None, ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), test_counts = {}, spread = {}, last_attempts = {("//t:a", "c", 1, 1): 2, ("//t:b", "c", 1, 1): 1})
    on_key(tri, "]", 10)
    _eq("] opens the log in Failures, its attempt named", (tri["tab"], crumbs(tri)), ("failures", ["//t:a ▹ attempt 1/2"]))
    on_key(tri, "}", 10)
    _eq("} its next attempt", crumbs(tri), ["//t:a ▹ attempt 2/2"])
    on_key(tri, "{", 10)
    _eq("{ back", crumbs(tri), ["//t:a ▹ attempt 1/2"])
    src = ctx.std.fs.mkdtemp() + "/a.py"
    ctx.std.fs.write(src, "x = 1\n" * 20)
    open_peek(tri, src, 12)
    _eq("a peek from the log, one deeper, in the same tab", (tri["tab"], crumbs(tri)), ("failures", ["//t:a ▹ attempt 1/2", "a.py:12"]))
    tab_bar = _visible(render(tri, 120, 30))
    if "Failures ✗" not in tab_bar or "▹ //t:a ▹ attempt 1/2 ▹ a.py:12" not in tab_bar:
        fail("render: the tab bar names the open view:\n" + tab_bar)
    crumb = [(a, b) for a, b, t in tri["tab_spans"] if t == ("crumb", 1)]
    _eq("the log's crumb can be clicked", len(crumb), 1)
    on_key(tri, "mouse-press:%d:%d" % (crumb[0][0], tri["tab_row"]), 10)
    on_key(tri, "mouse-release:%d:%d" % (crumb[0][0], tri["tab_row"]), 10)
    _eq("a crumb's click goes back to it", crumbs(tri), ["//t:a ▹ attempt 1/2"])
    open_peek(tri, src, 3)
    on_key(tri, "]", 10)
    _eq("] steps sideways, through each attempt, the peek gone", crumbs(tri), ["//t:a ▹ attempt 2/2"])
    on_key(tri, "]", 10)
    _eq("] to the next target", crumbs(tri), ["//t:b"])
    narrow = _visible(render(tri, 30, 20)).split("\n")
    top = [r for r in narrow if "//t:b" in r]
    _eq("narrow: the deepest crumb kept", len(top) >= 1, True)
    console_peek = _screen(ctx, ["x"], fs = ctx.std.fs, syntax = None, page_h = 10)
    open_peek(console_peek, src, 2)
    _eq("a peek from the console is the console's", (console_peek.get("tab", "console"), crumbs(console_peek)), ("console", ["a.py:2"]))
    on_key(console_peek, "esc", 10)
    _eq("Esc: back to the console", (console_peek.get("tab", "console"), console_peek["view"]), ("console", None))

    # g and G in every pane: the Failures list's first and last, Metrics'
    # top and bottom; zoom kept as the tabs change.
    gg = _screen(ctx, ["x"], fails = [dict(act, label = "//g:%d" % i) for i in range(5)], zoom = True)
    on_key(gg, "tab", 10)
    on_key(gg, "J", 10)
    _eq("J: the list's last", (gg["tab"], gg["selected"], gg["zoom"]), ("failures", 4, True))
    on_key(gg, "K", 10)
    _eq("K: its first", gg["selected"], 0)
    on_key(gg, "tab", 10)
    on_key(gg, "J", 10)
    render(gg, 100, 10)
    _eq("Metrics: J to the bottom, K to the top, still zoomed", (gg["tab"], gg["tab_scroll"] > 0, gg["zoom"]), ("metrics", True, True))
    on_key(gg, "K", 10)
    _eq("K to the top", gg["tab_scroll"], 0)

    # --runs_per_test: each failed run is a failure of its own, named by
    # its run, and } steps through them.
    def _run(n):
        return failure_of("test_result", struct(label = "//t:r", run = n, shard = 1, attempt = 1, configuration = struct(id = "c")), struct(status = "failed", test_action_output = [struct(name = "test.log", file = "x")]))

    runs = _screen(ctx, ["x"], fails = [_run(1), _run(2), _run(3)], fs = ctx.std.fs, syntax = None, page_h = 10, env = ctx.std.env, read = lambda p, c: None, ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), test_counts = {("//t:r", "c"): (3, 1)}, spread = {}, last_attempts = {})
    seen = []
    for _ in range(4):
        on_key(runs, "}", 10)
        seen.append(crumbs(runs)[-1])
    _eq("} steps each run, round to the first", seen, ["//t:r ▹ run 2/3", "//t:r ▹ run 3/3", "//t:r ▹ run 1/3", "//t:r ▹ run 2/3"])

    # ] [ } { with the pick on a target without a log (past the logged
    # records): the last logged one stands in. } with the open log's target
    # no longer listed (a newer build's failures): the chosen one's.
    unlogged = _screen(ctx, ["x"], fails = [_attempt("//t:a", 1)], fs = ctx.std.fs, syntax = None, page_h = 10, env = ctx.std.env, read = lambda p, c: None, ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), test_counts = {}, spread = {}, last_attempts = {})
    count_aborted(unlogged["counts"], "//b:b", "analysis_failure")
    for key in ["]", "[", "}", "{"]:
        unlogged["view"] = None
        on_key(unlogged, "2", 10)
        on_key(unlogged, "J", 10)
        _eq("%s: the pick past the logged records" % key, unlogged["selected"], 1)
        on_key(unlogged, key, 10)
        _eq("%s on a target without a log" % key, crumbs(unlogged), ["//t:a"])

    # } { step from the record shown, not the one chosen; one shown from a
    # list it is no longer in opens its target's first record here, unstepped.
    a1, a2, a3, c1, z1 = _attempt("//t:a", 1), _attempt("//t:a", 2), _attempt("//t:a", 3), _attempt("//t:c", 1), _attempt("//t:z", 1)
    steps = _screen(ctx, ["x"], fails = [a1, a2, a3, c1], fs = ctx.std.fs, syntax = None, page_h = 10, env = ctx.std.env, read = lambda p, c: None, ansi = ctx.std.re.compile(ANSI), controls = ctx.std.re.compile(CONTROLS), test_counts = {}, spread = {}, last_attempts = {})

    def _open_one():
        return steps["view"]["record"] if steps["view"] != None else None

    seen = []
    for key in ["}", "}", "}", "{"]:
        on_key(steps, key, 10)
        seen.append(steps["fails"].index(_open_one()))
    _eq("} { from the one shown", seen, [1, 2, 0, 2])
    steps["selected"] = 3
    on_key(steps, "}", 10)
    _eq("} from the shown one, not the chosen", _open_one(), a1)
    on_key(steps, "}", 10)
    on_key(steps, "}", 10)
    steps["fails"] = [z1, a1, a2]
    steps["selected"] = 0
    on_key(steps, "}", 10)
    _eq("the shown one gone: its target's first here, unstepped", _open_one(), a1)
    on_key(steps, "}", 10)
    _eq("then } steps on", _open_one(), a2)
    steps["fails"] = [z1]
    on_key(steps, "{", 10)
    _eq("its target gone too: the chosen one", _open_one(), z1)

    # The CLI's version at the keys row's right end, with room for the keys.
    versioned = _screen(ctx, ["x"], cli_version = "2026.47.3")
    bottom = _visible(render(versioned, 100, 20)).split("\n")[-1]
    _eq("the version at the right end", (bottom.endswith(" aspect 2026.47.3 "), text_width(bottom)), (True, 100))
    narrow_bottom = _visible(render(versioned, 50, 20)).split("\n")[-1]
    _eq("too narrow: the keys alone", "2026.47.3" in narrow_bottom, False)

    # Lines drawn in the colour they were written in; a search's matches
    # laid over it; the CLI's own lines as written, no mark of their own.
    painted = _screen(ctx, [])
    add_lines(painted, ["INFO: done here"], None, ["\x1b[1;90mINFO:\x1b[0m done here"])
    add_lines(painted, ["→ Build"], None, ["\x1b[1mBuild\x1b[0m"], cli = True)
    drawn = render(painted, 100, 20)
    _eq("the line's own colour drawn", "\x1b[1;90mINFO:\x1b[0m done here" in drawn, True)
    _eq("the CLI's line unmarked", "» " in _visible(drawn), False)
    painted["search"]["pattern"] = ctx.std.re.compile("done")
    _eq("a match over the colour", _role("search.match") + "done" in render(painted, 100, 20), True)

    # At the top, the oldest line shows from its first row even when a
    # later line is taller than the pane.
    tall = _screen(ctx, [], ended = True)
    add_lines(tall, ["the oldest", "", "second"], None, None, cli = True)
    add_lines(tall, ["INFO: " + "--flag " * 600] + ["line %d" % i for i in range(90)])
    on_key(tall, "K", 10)
    tall_rows = _visible(render(tall, 120, 40)).split("\n")
    tab_row = [i for i, r in enumerate(tall_rows) if "Console" in r and "Invocation" in r][0]
    _eq("the oldest line first at the top", tall_rows[tab_row + 1][:14], "│ the oldest  ")

    # Coloured rows as wide as the plain ones: a tab as two spaces, U+FE0F
    # widening the character before it.
    for plain, coloured in [("x\tERROR: tab here", "\x1b[31mx\tERROR: tab here\x1b[0m"), ("done ⚠️ " * 20, "\x1b[33m" + "done ⚠️ " * 20 + "\x1b[0m")]:
        wide = _screen(ctx, [], wrap = False)
        add_lines(wide, [plain], None, [coloured])
        rows = [r.rstrip("\r") for r in _visible(render(wide, 80, 24)).split("\n") if r.rstrip("\r")]
        _eq("a coloured row fits: %r" % plain[:12], [text_width(r) for r in rows if text_width(r) != 80], [])
        _eq("no raw tab drawn", any(["\t" in r for r in rows]), False)

    # A zero-width mark between a character and its U+FE0F: still as wide
    # as the plain row.
    marked = _screen(ctx, [], wrap = False)
    add_lines(marked, ["á️ b " * 20], None, ["\x1b[33m" + "á️ b " * 20 + "\x1b[0m"])
    marked_rows = [r.rstrip("\r") for r in _visible(render(marked, 80, 24)).split("\n") if r.rstrip("\r")]
    _eq("a mark before U+FE0F fits", [text_width(r) for r in marked_rows if text_width(r) != 80], [])

    # What the task wrote before the screen was taken is not replayed.
    seeded = _screen(ctx, [], seeded = 2)
    add_lines(seeded, ["banner", "▸ Running build task"], None, None, cli = True)
    add_lines(seeded, ["INFO: from bazel"])
    _eq("the replay starts after the seed", replay_lines(seeded, False), ["INFO: from bazel"])

    # Before any build: the header names the task's phase, no progress row
    # and no build panes, the build tabs muted and saying so.
    early = _screen(ctx, [], building = False, task = "lint")
    add_lines(early, ["▸ Running lint task", "", "▸ Setup", "▹ Running setup"], None, None, cli = True)
    _eq("the phase from the CLI's lines", phase_status(early), ["Setup · Running setup"])
    _eq("nothing built yet", built(early), False)
    rows = _visible(render(early, 100, 24)).split("\n")
    _eq("the header names the phase", "Setup · Running setup" in rows[0], True)
    _eq("then the tabs, no progress row nor panes", rows[1].startswith("┌─ Console"), True)
    _eq("no Results pane", "Results" in _visible(render(early, 100, 24)), False)
    early["tab"] = "metrics"
    _eq("a build tab says so", "No build yet" in _visible(render(early, 100, 24)), True)
    early["tab"] = "console"
    _eq("the build tabs muted", _role("muted") + " Failures " in render(early, 100, 24), True)

    # A build running: its panes in one frame; ended, folded to a row; the
    # next build's panes under it.
    many_builds = _screen(ctx, ["one"], building = True, task = "lint")
    new_build(many_builds, 1000)
    many_builds["building"] = True
    many_builds["progress"] = ["[3 / 9] 1 action running", "    a.cc; 1s"]
    _eq("panes while a build runs", panes_shown(many_builds), True)
    many_builds["counts"]["failures"] = ["//a:b"]
    many_builds["counts"]["failed_labels"] = {"//a:b": True}
    many_builds["now_ms"] = 13000
    fold_build(many_builds, 13000)
    many_builds["building"] = False
    many_builds["progress"] = []
    _eq("folded: its failures, outcome and time, no progress count", _visible(build_row(many_builds["builds"][0], 100)), " ✗ bazel · ✗1 · ended without a result · 12s")
    _eq("between builds, folded", panes_shown(many_builds), False)
    _eq("the console is the task's, kept", many_builds["log"], ["one"])
    folded_rows = _visible(render(many_builds, 100, 24)).split("\n")
    _eq("the folded row above the tabs", folded_rows[1].startswith(" ✗ bazel"), True)
    on_key(many_builds, "p", 10)
    _eq("p opens the panes", panes_shown(many_builds), True)
    on_key(many_builds, "p", 10)
    _eq("p folds them again", panes_shown(many_builds), False)
    new_build(many_builds, 14000)
    many_builds["building"] = True
    _eq("the next build starts with its own counts", many_builds["counts"]["failures"], [])
    _eq("picked: the running one", picked_build(many_builds), 1)
    many_builds["tab"] = "metrics"
    _eq("its crumb", crumbs(many_builds), ["2 of 2"])
    on_key(many_builds, "<", 10)
    _eq("< the build before", (picked_build(many_builds), crumbs(many_builds)), (0, ["1 of 2"]))
    on_key(many_builds, "<", 10)
    _eq("never before the first", picked_build(many_builds), 0)
    on_key(many_builds, ">", 10)
    _eq("> the next", picked_build(many_builds), 1)

    # A build folded before any frame noted what it blocked, picked again
    # with <: its Metrics draw, timed by its own run, not the task's.
    unframed = _screen(ctx, ["x"], building = True, build_start_ms = 1000)
    unframed.pop("blocked", None)
    fold_build(unframed, 13000)
    new_build(unframed, 14000)
    unframed["building"] = True
    unframed["now_ms"] = 99000
    unframed["tab"] = "metrics"
    on_key(unframed, "<", 10)
    took = [r for r in _visible(render(unframed, 100, 60)).split("\n") if "elapsed" in r]
    _eq("a folded build's own time", len(took) == 1 and took[0].split()[2] == "12s", True)
    unframed["picked_build"] = None
    took = [r for r in _visible(render(unframed, 100, 60)).split("\n") if "elapsed" in r]
    _eq("the running build's own time", len(took) == 1 and took[0].split()[2], "1m25s")
    never = _screen(ctx, ["x"], building = False, ended = True, tab = "metrics", fails = [act])
    _eq("Metrics with no build at all", "elapsed" in _visible(render(never, 100, 60)), True)

    # Finished: one build's panes stay open for build and test, every other
    # task's builds stay folded.
    for kind, want in [("build", True), ("test", True), ("lint", False), ("gazelle", False), ("format", False)]:
        done = _screen(ctx, [], building = False, task = kind, ended = True)
        fold_build(done, 0)
        _eq("%s finished, its panes open" % kind, panes_shown(done), want)
    nothing = _screen(ctx, [], building = False, task = "format", ended = True)
    _eq("a task that never built shows no panes", (panes_shown(nothing), built(nothing)), (False, False))
    _eq("a task's own ▸ Running line is no phase", note_phase(dict(phase_title = "x"), "▸ Running format task"), None)

    # A click's opener: one that fails at once has the link copied instead,
    # one that exits 0 or is still running (a browser) has opened it.
    for exit, want in [(1, "couldn't open cursor://file/x, copied it"), (0, "opened cursor://file/x"), (None, "opened cursor://file/x")]:
        opened_by = []
        clicked = _screen(ctx, [], process = _fake_process(["open", "pbcopy"], opened_by, exit = exit), env = _fake_env({}))
        _eq("opener exiting %r" % exit, open_link(clicked, "cursor://file/x", trusted = True), want)
        _eq("copied only when it failed: %r" % exit, len(opened_by), 2 if exit == 1 else 1)

    # The panes are one height for the whole build, however many actions run.
    heights = []
    for n in [0, 1, 3, 12]:
        sized = _screen(ctx, ["x"], progress = ["[1 / 99] %d actions running" % n] + ["    a%d; %ds" % (i, i) for i in range(n)])
        rows = _visible(render(sized, 100, 30)).split("\n")
        heights.append([i for i, r in enumerate(rows) if r.startswith("┌─ Console")][0])
    _eq("one height across running counts", heights, [heights[0]] * 4)
    _eq("as tall as the most Results rows", results_capacity(True), 9)

    # The list scrolls in it: unscrolled the rest counted, scrolled a window
    # and a scrollbar.
    long = ["a%d" % i for i in range(10)]
    shown, edge = scrolled_rows(long, 4, 0)
    _eq("unscrolled, the rest counted", shown, ["a0", "a1", "a2", "… and 7 more"])
    _eq("a scrollbar when they do not fit", len(edge), 4)
    _eq("scrolled, a window", scrolled_rows(long, 4, 3)[0], ["a3", "a4", "a5", "a6"])
    _eq("never past the end", scrolled_rows(long, 4, 99)[0], ["a6", "a7", "a8", "a9"])
    _eq("all fit: no scrollbar", scrolled_rows(long[:2], 4, 0), (["a0", "a1"], None))
    wheeled = _screen(ctx, ["x"], progress = ["[1 / 99] 12 actions running"] + ["    a%d; %ds" % (i, i) for i in range(12)])
    render(wheeled, 100, 30)
    top, _, width = wheeled["actions_at"]
    wheeled["hover"] = (3, top + 1)
    on_key(wheeled, "wheel-down", 10)
    _eq("the wheel over the list scrolls it, not the console", (wheeled["actions_scroll"] > 0, wheeled["scroll"]), (True, 0))

    # Slowest from the execution log: every spawn that ran, longest first,
    # to a tenth of a second; a cache hit's fetch is no work and is left out.
    spawned = _screen(ctx, [])
    spawn = lambda ms, label, hit = False, runner = "darwin-sandbox": struct(mnemonic = "CppCompile", target_label = label, cache_hit = hit, runner = runner, metrics = struct(execution_wall_time_ms = ms, total_time_ms = ms))
    note_spawn_time(spawned, spawn(1200, "//a:short"))
    note_spawn_time(spawned, spawn(98000, "//a:cached", hit = True))
    note_spawn_time(spawned, spawn(87000, "//a:disk", runner = "disk cache hit"))
    note_spawn_time(spawned, spawn(12450, "//a:long"))
    _eq("ran spawns, longest first", slowest_rows(spawned), ["CppCompile //a:long; 12.4s", "CppCompile //a:short; 1.2s"])
    _eq("titled from the log", slowest_title(spawned), "Slowest")
    _eq("without it, what Bazel showed", slowest_title(_screen(ctx, [])), "Slowest seen")

    # The Tips tab: its count in the tab, the most urgent first, `s`
    # silencing on this machine and back, a failed save said on its row.
    calls = []
    tipped = _screen(ctx, ["x"], tips = [
        {"id": "remote-miss", "severity": "suggestion", "title": "41% missed", "body": "Use a cache."},
        {"id": "disk-full", "severity": "warning", "title": "98% full", "body": ""},
    ], silencer = lambda id, on: (calls.append((id, on)), None)[1])
    _eq("counted", tips_count(tipped), 2)
    _eq("in the most urgent's colour", tips_role(tipped), "tip.warning")
    _eq("the most urgent first", [t["id"] for t, _ in shown_tips(tipped)], ["disk-full", "remote-miss"])
    tipped["tab"] = "tips"
    _eq("Tips N in the tab bar", " Tips " in _visible(render(tipped, 100, 30)), True)
    on_key(tipped, "s", 10)
    _eq("s silences the chosen one", (calls, tips_count(tipped)), ([("disk-full", True)], 1))
    _eq("it stays, saying so", "silenced on this machine · s to undo" in "\n".join([_visible(l) for l in tips_lines(tipped, 96)]), True)
    tipped["tip_selected"] = [i for i, (t, _) in enumerate(shown_tips(tipped)) if t["id"] == "disk-full"][0]
    on_key(tipped, "s", 10)
    _eq("s again undoes it", (calls[-1], tips_count(tipped)), (("disk-full", False), 2))

    # The Tips feature dropped the silenced tip: undone, it stays shown.
    tipped["tips"] = [t for t in tipped["tips"] if t["id"] != "disk-full"]
    _eq("undone, it stays though no longer stored", [t["id"] for t, _ in shown_tips(tipped)], ["disk-full", "remote-miss"])
    tipped["silencer"] = lambda id, on: "read-only file"
    on_key(tipped, "s", 10)
    _eq("a failed save says why and changes nothing", ("couldn't save to ~/.aspect/config.json: read-only file" in "\n".join([_visible(l) for l in tips_lines(tipped, 96)]), tips_count(tipped)), (True, 2))
    _eq("no tips", _visible(tips_lines(_screen(ctx, []), 96)[0]), "No tips")

    # No progress row: the panes sit under the header whether or not Bazel
    # has counted, and the header says how far it is.
    def _running_row(progress):
        rows = [_visible(r) for r in render(_screen(ctx, ["x"], progress = progress), 100, 30).split("\r\n")]
        return [i for i, r in enumerate(rows) if "Running (" in r]

    analyzing = _running_row(["Analyzing: 3 targets (2 packages loaded)", "    Compiling a.cc; 1s local"])
    counted = _running_row(["[1 / 14] 1 action running", "    Compiling a.cc; 1s local"])
    _eq("the panes stay put when the counts come", (len(analyzing), analyzing), (1, counted))
    _eq("under the bar, right under the header", analyzing, [2])

    # With the bar drawn the count is on it, and the header has Bazel's
    # status; without it (zoomed), the header has the count.
    top = lambda progress, **kw: _visible(render(_screen(ctx, ["x"], progress = progress, **kw), 100, 30)).split("\n")[:2]
    _eq("before it counts, what it is doing", [r.rstrip(" \r").endswith(e) for r, e in zip(top(["Analyzing: 3 targets"]), ["Analyzing: 3 targets", "analyzing"])], [True, True])
    _eq("then Bazel's status, and the count on the bar", [r.rstrip(" \r").endswith(e) for r, e in zip(top(["[4 / 14] 1 action running"]), ["1 action running", "28% · 4 of 14"])], [True, True])
    _eq("zoomed, the count in the header", top(["[4 / 14] 1 action running"], zoom = True)[0].rstrip(" \r").endswith("4 of 14 actions done"), True)

    # Once a build ends nothing it last counted stays: not in the header,
    # not in its folded row; only what ✔/✗ cannot say, from BuildFinished.
    stale = _screen(ctx, ["x"], progress = ["[4 / 14] 1 action running"], task = "lint")
    fold_build(stale, 0)
    stale.update(building = False, ended = True, progress = [])
    shown = _visible(render(stale, 100, 30))
    _eq("no stale count after the end", ("4 of 14" in shown, "4/14" in shown), (False, False))
    _eq("no BuildFinished: said", "ended without a result" in shown.split("\n")[0], True)
    stale["builds"][-1]["snapshot"]["inv"] = {"build_finished": struct(exit_code = struct(name = "INTERRUPTED", code = 8))}
    _eq("interrupted, from BuildFinished", "interrupted" in _visible(render(stale, 100, 30)).split("\n")[0], True)
    stale["builds"][-1]["snapshot"]["inv"] = {"build_finished": struct(exit_code = struct(name = "SUCCESS", code = 0))}
    _eq("a success says nothing more", _visible(render(stale, 100, 30)).split("\n")[0].rstrip(" \r").endswith("0s"), True)
    ran = _screen(ctx, ["x"], inv = {"build_finished": struct(exit_code = struct(name = "SUCCESS", code = 0)), "build_metrics": struct(action_summary = struct(
        actions_executed = 1204,
        runner_count = [struct(name = "total", count = 1204), struct(name = "internal", count = 4), struct(name = "remote cache hit", count = 1000), struct(name = "linux-sandbox", count = 200)],
        action_cache_statistics = struct(hits = 7000, misses = 1204),
    ))})
    fold_build(ran, 0)
    _eq("a folded build: its actions as the bar says them", "8,204 actions · 97% reused" in _visible(build_row(ran["builds"][0], 100)), True)
    ran.update(building = False, ended = True, progress = [])
    rows = _visible(render(ran, 140, 30)).split("\n")
    _eq("on the bar only, not in the finished header", (rows[0].rstrip(" \r").endswith("0s"), rows[1].rstrip(" \r").endswith("8,204 actions · 97% reused")), (True, True))

    # The finished screen stays, saying how to leave, its verdict first.
    finished = _screen(ctx, ["x"], ended = True, verdict = False)
    row = _visible(keys_row(finished, 120))
    _eq("how to leave the finished screen", (row.startswith(" Done ✗"), "q, Enter or Esc to leave" in row), (True, True))

    # A build that crashed without a result, or was interrupted, folds as
    # not ok, saying so; only BuildFinished's SUCCESS folds as ✓.
    for name, mark, said in [(None, "✗", "ended without a result"), ("INTERRUPTED", "✗", "interrupted"), ("SUCCESS", "✓", "")]:
        inv = {} if name == None else {"build_finished": struct(exit_code = struct(name = name, code = 0))}
        crashed = _screen(ctx, ["x"], inv = inv)
        fold_build(crashed, 0)
        row = _visible(build_row(crashed["builds"][0], 100))
        _eq("folded %s" % name, (row.startswith(" " + mark), (said in row) if said else True), (True, True))

    # A header too narrow for the status leaves it out, never cut to a number.
    narrow = _screen(ctx, ["x"], progress = ["[1,204 / 9,000] 1 action running"])
    head = _visible(render(narrow, 40, 24)).split("\n")[0]
    zoomed = _visible(render(dict(narrow, zoom = True), 40, 24)).split("\n")[0]
    _eq("no cut count", ("actions done" in zoomed) or not any([c.isdigit() for c in zoomed.partition("·")[2].strip(" \r").partition(" ")[2].elems()]), True)
    _eq("no cut status", head.rstrip(" \r").endswith("1 action running") or not any([c.isdigit() for c in head.partition("·")[2].strip(" \r").partition(" ")[2].elems()]), True)

    # The console's state (following, lines up) at the tab border's right
    # end, a dash apart from the tabs, muted (never the accent, nor bold),
    # at every width; cut, then gone, rather than the tabs collapse for it.
    lines = ["line %d" % i for i in range(200)]
    for scroll, said in [(0, "following"), (12, "12 lines up")]:
        for cols in range(24, 161, 7):
            st = _screen(ctx, lines, scroll = scroll)
            top = [r for r in render(st, cols, 30).split("\n") if "Console" in _visible(r) and "┌" in _visible(r)][0]
            plain = _visible(top).rstrip("\r")
            _eq("the border's width at %d" % cols, text_width(plain), cols)
            tabs, _, tail = plain.partition(" ─")
            if said in plain:
                _eq("%s apart from the tabs at %d" % (said, cols), said in tabs, False)
                _eq("%s at the right end at %d" % (said, cols), plain.endswith(said + " ─┐") or tail.endswith("… ─┐"), True)
                _eq("%s muted at %d" % (said, cols), (ANSI_MUTED + " " + said) in top or (ANSI_MUTED + " ") in top, True)
                if ANSI_HEADING and ANSI_HEADING != ANSI_MUTED:
                    _eq("%s not in the accent at %d" % (said, cols), ANSI_HEADING + " " in top, False)
            long = _screen(ctx, lines, scroll = 12, unseen = 999, unseen_errors = 99, dropped = 9999)
            long_top = _visible([r for r in render(long, cols, 30).split("\n") if "Console" in _visible(r) and "┌" in _visible(r)][0])
            _eq("the tabs whatever the state's length at %d" % cols, "Failures" in plain, "Failures" in long_top)

    # A tool's line coloured as Bazel colours a message's label, inside an
    # action's output, stays in the fold: only Bazel's own starts a block.
    shaped = _screen(ctx, [])
    lines = ["INFO: From Executing genrule //:g:", "one", "INFO: two", "three", "INFO: Build completed"]
    colours = ["\x1b[32mINFO: \x1b[0mFrom Executing genrule //:g:", "one", "\x1b[32mINFO:\x1b[0m two", "three", "\x1b[32mINFO: \x1b[0mBuild completed"]
    add_lines(shaped, lines, colours = colours)
    _eq("one fold, then Bazel's next line", [l for l in shaped["folded"] if not l.startswith("INFO: From")][-1:], ["INFO: Build completed"])
    _eq("the tool's lines folded together", len(shaped["folded"]), 3)

    # At every width the shown tab's name is drawn whole: the other tabs go
    # first, never a cut of it.
    for cols in range(30, 81):
        top = [_visible(r) for r in render(_screen(ctx, ["x"]), cols, 30).split("\n") if "┌" in _visible(r) and "onsole" in _visible(r)][0]
        _eq("the shown tab whole at %d" % cols, " Console " in top, True)

    # A toggle says, for a moment, the state it left and how to undo it;
    # then the keys row is its own again, and Ctrl+C's warning wins.
    for key, first, second in [
        ("w", "long lines cut · w wraps them", "long lines wrapped · w cuts them"),
        ("z", "console zoomed · z unzooms it", "console unzoomed · z zooms it"),
        ("p", "build panes folded · p opens them", "build panes open · p folds them"),
        ("ctrl-o", "lines under each INFO: From shown · ^O folds them", "lines under each INFO: From folded · ^O shows them"),
        ("e", "errors and warnings only · e errors only", "errors only · e every line"),
        ("m", "mouse on: the wheel scrolls, a click picks · m gives it to the terminal", "mouse off: the terminal selects text · m takes it back"),
    ]:
        toggled = _screen(ctx, ["x"], now_ms = 10000, screen = struct(mouse = lambda on: None), panes = True)
        for want in (first, second):
            on_key(toggled, key, 10)
            row = _visible(keys_row(toggled, 120))
            _eq("%s says %r" % (key, want), row.strip(), want)
            _eq("%s's row the frame's width" % key, text_width(row), 120)
        toggled["now_ms"] += 2000
        _eq("%s's note gone after a moment" % key, second in _visible(keys_row(toggled, 120)), False)

    # Before any build, p says there are no panes yet.
    unbuilt = _screen(ctx, ["x"], now_ms = 0, building = False)
    on_key(unbuilt, "p", 10)
    _eq("p before any build", _visible(keys_row(unbuilt, 120)).strip(), "no build panes yet: p opens them once a build runs")

    # A later note keeps no earlier note's deadline: w twice, the moment
    # past, then a copy's note shows.
    later = _screen(ctx, ["x"], now_ms = 0)
    on_key(later, "w", 10)
    on_key(later, "w", 10)
    later["now_ms"] = 2500
    say_note(later, "copied 3 characters")
    _eq("a note after an expired one shows", "copied 3 characters" in _visible(keys_row(later, 120)), True)

    # On the finished screen the frame's time stays, but notes go by the
    # screen's own clock.
    ticks = [10000]
    still = _screen(ctx, ["x"], now_ms = 10000, ended = True, building = False, clock = lambda: ticks[0])
    on_key(still, "w", 10)
    ticks[0] += 2500
    _eq("a note expires on the finished screen", "long lines" in _visible(keys_row(still, 120)), False)

    urgent = _screen(ctx, ["x"], now_ms = 0)
    on_key(urgent, "w", 10)
    urgent["cancelling"] = True
    _eq("Ctrl+C's warning wins over a toggle's note", "Ctrl+C again" in _visible(keys_row(urgent, 120)), True)
    lists = _screen(ctx, ["x"], now_ms = 0, outputs = [{"kind": "action", "label": "//o:o", "detail": "Genrule", "files": [("stdout", "x")], "output": "", "success": True}], fails = [act])
    on_key(lists, "a", 10)
    _eq("a says which list", _visible(keys_row(lists, 120)).strip(), "actions that wrote output listed · a lists the failures")

    # Keys as data: an entry either takes keys and does something, or only
    # documents keys another layer reads; the overlay shows only what
    # applies, grouped; no key is shown twice.
    for k in KEYS:
        _eq("bound or documented: %s" % (k.help,), (len(k.keys) > 0) == (k.do != None), True)
    calm = _screen(ctx, ["x"])
    failed = _screen(ctx, ["x"], fails = [act])
    _eq("no Failures keys without failures", "Failures" in help_rows(calm), False)
    _eq("Failures keys with them", "Failures" in help_rows(failed), True)
    shown = [k.help[0] for k in KEYS if k.help != None and k.shown(failed)]
    _eq("no key row twice", len(shown), len({r: 1 for r in shown}))

    _actions_tests(ctx)

    # A row cut in its middle is never wider than asked, a wide character
    # (CJK, emoji) the cut would split left out, at every width.
    for text in ["编译" * 40 + " //pkg:目标; 3s", "🚀 " * 40 + "Compiling a.cc; 3s"]:
        for width in range(8, 201):
            cut = action_row(text, width)
            if text_width(cut) > width:
                fail("action_row(%r, %d) is %d cells" % (text[:6], width, text_width(cut)))
    _goldens(ctx, view_state, act, ctx.args.update)
    print("dashboard_test.axl: OK")
    return 0

dashboard_tests = task(
    summary = "Run the dashboard's tests.",
    kind = "test-dashboard",
    group = ["dev"],
    implementation = _impl,
    args = {
        "update": args.boolean(default = False),
    },
)
