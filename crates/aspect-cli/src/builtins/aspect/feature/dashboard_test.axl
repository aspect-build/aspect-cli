        ("✗ //xn:b  Check · exit 3 · xn/BUILD.bazel:3:4", ["error: BBB mismatch in b"]),
        ("✗ //xn:c  Check · exit 5 · xn/BUILD.bazel:4:4", ["error: CCC alone"]),
        ("✗ //xn:d  Check · xn/BUILD.bazel:5:4", ["output 'xn/d.out' was not created", "not all outputs were created or valid"]),
