        "ERROR: mc/BUILD.bazel:3:4: Checking e failed: not all outputs were created or valid",
        "ERROR: mc/BUILD.bazel:2:5: Checking d0 failed: not all outputs were created or valid",
        "ERROR: mc/BUILD.bazel:2:5: output 'mc/d1.out' was not created",
        "ERROR: mc/BUILD.bazel:2:5: Checking d1 failed: not all outputs were created or valid",
    ]]
    for flip in [False, True]:
        mc_recs = [_act("//mc:%s" % n, "Check", "bazel-out/darwin_arm64-fastbuild/bin/mc/%s.out" % n, 0) for n in ("e", "d0", "d1")]
