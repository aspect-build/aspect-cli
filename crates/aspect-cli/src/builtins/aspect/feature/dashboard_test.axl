    # entry though nothing depends on it.
    le2_errs = [{"header": h, "body": [], "log": None, "label": None, "target": None} for h in [
        "ERROR: le2/BUILD.bazel:2:1: syntax error at 'newline': expected ,",
        "ERROR: package contains errors: le2: syntax error at 'newline': expected ,",
