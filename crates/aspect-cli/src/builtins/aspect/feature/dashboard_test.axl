    nk_errs = [{"header": h, "body": [], "log": None, "label": None, "target": None} for h in [
        "ERROR: le/BUILD.bazel:2:1: syntax error at 'newline': expected ,",
        "ERROR: mt/BUILD.bazel: no such target '//mt:gone': target 'gone' not declared in package 'mt' defined by mt/BUILD.bazel",
        "ERROR: le/BUILD.bazel: no such target '//le:x': target 'x' not declared in package 'le' defined by le/BUILD.bazel",
        "ERROR: le/BUILD.bazel: no such target '//le:y': target 'y' not declared in package 'le' defined by le/BUILD.bazel",
        "ERROR: p2/BUILD.bazel:3:8: no such target '//mt:gone': target 'gone' not declared in package 'mt' defined by mt/BUILD.bazel and referenced by '//p2:e'",
        "ERROR: Analysis of target '//p2:e' failed; build aborted: Analysis failed",
