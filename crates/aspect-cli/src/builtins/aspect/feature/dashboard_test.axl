    _eq("and the tab alike", tab, [e[0] for e in got])

    # ws/an (Bazel 9.3.3, --keep_going): //an:missing's source is missing,
    # and //an:dep, which Bazel gives the same root (`//an:nope.txt`), is
    # blocked by it; //an:badlabel's dependency `//nowhere:x` fails
