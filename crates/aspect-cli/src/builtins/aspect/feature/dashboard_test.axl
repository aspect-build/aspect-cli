    ]]
    roots = {"//p1:a": ["//le:x"], "//p2:a": ["//le:x"], "//p2:d": ["//le:x"], "//p1:b": ["//le:y"], "//p1:c": ["//mt:gone"], "//p2:e": ["//mt:gone"]}
    uc = dict(kinds, counts = dict(new_counts(), failures = sorted(roots.keys()), failed_labels = {l: True for l in roots}, failed = len(roots)), root_causes = roots, logged_index = None, blocked_cache = None, listed_cache = None, fails = [], kept_errors = {"errors": uc_errs, "distinct": len(uc_errs)}, read = None, build = None)
