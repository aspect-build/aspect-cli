    an_errs = [
        {"header": "ERROR: an/BUILD.bazel:1:8: Executing genrule //an:missing failed: missing input file '//an:nope.txt'", "body": [], "log": None, "label": None, "target": None},
        {"header": "ERROR: an/BUILD.bazel:1:8: Executing genrule //an:missing failed: 1 input file(s) do not exist", "body": [], "log": None, "label": None, "target": None},
        {"header": "ERROR: no such package 'nowhere': BUILD file not found in any of the following directories. Add a BUILD file to a directory to mark it as a package.", "body": ["- nowhere"], "log": None, "label": None, "target": None},
