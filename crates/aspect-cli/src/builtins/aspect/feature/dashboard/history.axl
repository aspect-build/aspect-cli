"""The Dashboard's History screen (`h`, and `aspect history browse`): the
runs the task history keeps (`new_browser`, `history_records`), laid out in
columns (`table_rows`), and a past one read back from the history
(`past_run`) and shown in the live run's place (`show_past`), as the
dashboard showed it: its builds replayed from the events the history kept,
its failures' logs the history's own copies inside its entry
(`use_kept_logs`, `_within`), the Console its output as shown, under a
header of its own (`past_header`). dashboard/render.axl draws the screen
(`render_history`); dashboard/keys.axl reads its keys.

While a past run is shown, the live one waits aside (`live`), and every
hook changes it there (`on_live`, dashboard/state.axl). While browsing,
Ctrl+C is a key (`set_interrupts`): a first says what a second does
(`ctrl_c_note`).
"""

load("@aspect//feature/dashboard/actions.axl", "dashboard_actions")
load("@aspect//feature/dashboard/log.axl", "dashboard_log")
load("@aspect//feature/dashboard/state.axl", "dashboard_state")
load("@std//time.axl", "monotonic", "now_ms")
load("../../private/lib/failure_records.axl", "failure_records")
load("../../private/lib/history_records.axl", "civil", "command_parts", "duration", "local_parts", "outcome", "show_lines", "stamp_ms", "task_name", "took")
load("../../private/lib/results_pages.axl", "results_pages")
load("../../private/lib/term_text.axl", "term_text")
load("../../private/lib/text.axl", "printable")
load("../../private/lib/worktree_layout.axl", "slot_name")

_c = term_text.c
_fit = term_text.fit
_tail = term_text.tail
_RESET = term_text.RESET
_text_width = term_text.text_width
_thousands = term_text.thousands
_bazel_line = failure_records.bazel_line
_progress_counts = failure_records.progress_counts
_SPINNER = dashboard_actions.SPINNER
_add_lines = dashboard_log.add_lines
_MAX_LOG = dashboard_log.MAX_LOG
_new_search = dashboard_log.new_search
_NOTE_MS = dashboard_log.NOTE_MS
_refold = dashboard_log.refold
_say_note = dashboard_log.say_note
_end_build = dashboard_state.end_build
_live_of = dashboard_state.live_of
_new_build = dashboard_state.new_build
_new_run = dashboard_state.new_run
_new_state = dashboard_state.new_state
_on_run = dashboard_state.on_run
_run_of = dashboard_state.run_of
_show_run = dashboard_state.show_run
_take_event = dashboard_state.take_event
_use_context = dashboard_state.use_context

# How many runs the screen lists, and the filters `f` cycles through.
_LIMIT = 500

_FILTERS = ["builds", "failed builds", "all runs"]

# How long a first Ctrl+C while browsing waits for a second.
_CTRL_C_MS = 2000

def new_browser(history, exclude: str = "", standalone: bool = False, workspace: str = "") -> dict:
    """What the History screen keeps: `history` (`ctx.std.history`), the
    run it leaves out (`exclude`, the live task's ID, listed first as the
    live build), whether it is the whole screen (`standalone`, no live run
    to go back to), and the workspace it was opened in (`workspace`, its
    root, "" outside one), whose runs it lists first."""
    return {
        "history": history,
        "exclude": exclude,
        "standalone": standalone,
        "workspace": workspace,
        "here": workspace != "",
        "filter": _FILTERS[0],
        "records": None,
        "selected": 0,
        "chosen": None,
        "top": 0,
        "reading": "",
        "census": None,
        "live_record": None,
        "now_ms": 0,
    }

def standalone_state(ctx, screen) -> dict:
    """The state of `aspect history browse` on `screen`, from its task's
    `ctx`: a run of its own that never builds, the task's context taken
    (`use_context`), the screen's own clock for its notes, and a History
    screen of its own, the whole screen (`standalone`), opened in the
    workspace the task runs in."""
    state = _new_state(task = "history browse", screen = screen, mouse = True, excerpt = ctx.std.excerpt, clock = lambda: int(monotonic() * 1000))
    _use_context(state, ctx)
    state["browser"] = new_browser(ctx.std.history, exclude = ctx.task.id, standalone = True, workspace = workspace_of(ctx.std))
    return state

def history_records(state: dict) -> list:
    """The runs the History screen lists, by its filter and workspace, read
    once each time it opens or they change, the chosen one kept chosen when
    it is still listed, though newer runs came above it. The history is read
    whole once (`census()`), and the counts and the filters answer from
    that read; read with them, the time now and the live run's own record,
    which has a row of its own."""
    b = state["browser"]
    if b["records"] == None:
        b["now_ms"] = now_ms()
        b["census"] = b["history"].census()
        if not b["standalone"] and b["exclude"]:
            b["live_record"] = b["history"].get(b["exclude"])
        listed = b["history"].list(
            limit = _LIMIT + 1,
            outcome = "failed" if b["filter"] == "failed builds" else None,
            builds = b["filter"] != "all runs",
            workspace = b["workspace"] if b["here"] and b["workspace"] else None,
        )
        b["records"] = [r for r in listed if r.get("task", {}).get("id") != b["exclude"]][:_LIMIT]
        ids = [row_id(r) for r in history_rows(state)]
        b["selected"] = ids.index(b["chosen"]) if b["chosen"] in ids else min(b["selected"], max(0, len(ids) - 1))
    rows = history_rows(state)
    b["chosen"] = row_id(rows[b["selected"]]) if rows else None
    return b["records"]

def history_rows(state: dict) -> list:
    """The History screen's rows: the live build first (None) when there is
    one to go back to, then the runs listed."""
    b = state["browser"]
    return ([None] if not b["standalone"] else []) + (b["records"] or [])

def row_id(row: dict | None) -> str:
    """A row's ID: `live` for the live build's, else its run's task ID."""
    return "live" if row == None else row.get("task", {}).get("id", "")

def _set_filter(state: dict, shown: str) -> None:
    b = state["browser"]
    b["filter"] = shown
    b["records"] = None
    b["selected"] = 0
    b["chosen"] = None

def cycle_filter(state: dict) -> None:
    """`f`: the next filter (builds, failed builds, all runs), from the top."""
    shown = state["browser"]["filter"]
    _set_filter(state, _FILTERS[(_FILTERS.index(shown) + 1) % len(_FILTERS)])

def toggle_failed(state: dict) -> None:
    """`e`: failed builds only, as the Dashboard's `e` shows errors, and
    back to builds."""
    _set_filter(state, "builds" if state["browser"]["filter"] == "failed builds" else "failed builds")

def toggle_workspace(state: dict) -> bool:
    """`w`: this workspace's runs, or every workspace's; whether there is a
    workspace to toggle (none outside one)."""
    b = state["browser"]
    if not b["workspace"]:
        return False
    b["here"] = not b["here"]
    b["records"] = None
    return True

def filter_note(state: dict) -> str:
    """What `f` says it did, and what it shows next: `failed builds · f: all
    runs`, the note pattern of the History screen's keys."""
    shown = state["browser"]["filter"]
    return "%s · f: %s" % (shown, _FILTERS[(_FILTERS.index(shown) + 1) % len(_FILTERS)])

def failed_note(state: dict) -> str:
    """What `e` says it did, and how to go back."""
    return "failed builds · e: all builds" if state["browser"]["filter"] == "failed builds" else "builds · e: failed builds only"

def workspace_note(state: dict) -> str:
    """What `w` says it did, and how to go back."""
    return "this workspace · w: every workspace" if state["browser"]["here"] else "every workspace · w: this one"

def open_history(state: dict, back: bool = False) -> None:
    """Show the History screen, the history read anew and the first row
    chosen; `back` from a past run, the run it showed still chosen and the
    list from the same read. While the live build runs, Ctrl+C is a key
    here (`set_interrupts`), so it never cancels the build unseen."""
    if state.get("browser") == None:
        return
    state["browser"]["records"] = None
    if not back:
        state["browser"]["census"] = None
        state["browser"]["chosen"] = None
        state["browser"]["selected"] = 0
    state["mode"] = "history"
    state["help"] = False
    state["select"] = None
    set_interrupts(state)

def history_open(state: dict) -> bool:
    """Whether the History screen is shown."""
    return state.get("mode") == "history"

def browsing(state: dict) -> bool:
    """Whether the History screen or a past run is shown."""
    return history_open(state) or state.get("past") != None

def set_interrupts(state: dict) -> None:
    """Ctrl+C a key while browsing, a signal again on the live screen of a
    build still running (not on the finished screen, `holding`, which reads
    it as a key itself)."""
    screen = state.get("screen")
    if screen != None and not state.get("holding") and not state["browser"]["standalone"]:
        screen.interrupts(not browsing(state))

def ctrl_c_note(state: dict) -> str:
    """While a first Ctrl+C on a browsing screen waits for a second, what
    the keys row says (`warned` draws it); else ""."""
    at = state.get("ctrl_c_ms")
    if at == None or int(monotonic() * 1000) - at > _CTRL_C_MS:
        return ""
    if _live_of(state)["cancelling"]:
        return "cancelling the live build · Ctrl+C again forces it"
    return "Ctrl+C again cancels the live build · Esc back to it"

def warned(row: str, again: str = "Ctrl+C again") -> str:
    """A keys row saying what a second press does, in the warning colour,
    the press (`again`) bold."""
    bold = _c("strong") + again + _RESET + _c("warning")
    return _c("warning") + row.replace(again, bold) + _RESET

def keys_labels(state: dict) -> list:
    """The History screen's keys row's labels in reading order, each with
    how likely it is wanted (`(label, rank)`, 0 the most), for the row to
    drop the least likely first (`fit_ranked`); with no runs at all, only
    how to leave. The box title says what is shown, so `f` and `w` say only
    what they do."""
    b = state["browser"]
    leave = ("q quit", 1) if b["standalone"] else ("Esc live", 1)
    if not b["records"] and not (b["census"] or {}).get("runs"):
        return [leave]
    parts = [("↑↓ choose", 4), ("Enter open", 0), ("f show", 2)]
    if b["workspace"]:
        parts.append(("w where", 3))
    return parts + [leave]

def page_rows(rows: int) -> int:
    """How many runs the History screen lists at once, `rows` tall."""
    return max(1, rows - 4)

def header_text(state: dict) -> str:
    """The History screen's header: how many runs the history keeps, and,
    with a live run to go back to, how it is doing (`live_words`)."""
    b = state["browser"]
    runs = (b["census"] or {}).get("runs", len(b["records"] or []))
    head = " aspect history · %s run%s kept" % (_thousands(runs), "" if runs == 1 else "s")
    if not b["standalone"]:
        head += " · " + live_words(state)
    return head

def box_title(state: dict, width: int = 1 << 30) -> str:
    """The list's box title in `width` cells: what it shows, where, and how
    many (`(500 newest)` at the limit, `(23 + live)` with the live build's
    row); `Runs · ` the first to go where it does not fit."""
    b = state["browser"]
    n = len(b["records"] or [])
    where = (" · this workspace" if b["here"] else " · every workspace") if b["workspace"] else ""
    count = ("%s newest" % _thousands(n)) if n >= _LIMIT else _thousands(n)
    if not b["standalone"]:
        count += " + live"
    title = "%s%s (%s)" % (b["filter"], where, count)
    if b["reading"]:
        title += " · reading " + b["reading"] + "…"
    return title if _text_width("Runs · " + title) > width else "Runs · " + title

def empty_text(state: dict) -> str:
    """What the list says with no run to show: none of its filter here, or,
    under the live build's row, no earlier one."""
    b = state["browser"]
    noun = b["filter"].replace("all runs", "runs")
    where = " in this workspace" if b["here"] and b["workspace"] else ""
    return "No %s%s%s." % ("" if b["standalone"] else "earlier ", noun, where)

def damaged_text(state: dict) -> str:
    """What of the history the list leaves out, and why, for under it:
    records a newer CLI wrote, folders without a record (a run starting,
    or one stopped before it wrote one) and records that do not read; ""
    for none."""
    census = state["browser"]["census"] or {}
    parts = []
    n = census.get("newer", 0)
    if n:
        parts.append("%s run%s from a newer aspect, not listed (upgrade to read %s)" % (_thousands(n), "" if n == 1 else "s", "it" if n == 1 else "them"))
    n = census.get("without_record", 0)
    if n:
        parts.append("%s folder%s without a record (a run starting, or stopped before writing one)" % (_thousands(n), "" if n == 1 else "s"))
    n = census.get("unreadable", 0)
    if n:
        parts.append("%s record%s unreadable" % (_thousands(n), "" if n == 1 else "s"))
    return " · ".join(parts)

def _live_status(state: dict) -> tuple:
    """The live run's state, `(text, role)`, the one form for its row's
    status and the headers: `⠹ 4/14` while it builds (`⠹ running` before
    Bazel counts), `■ cancelling`, and once it ended `✓ passed` or `✗ exit
    1`."""
    live = _live_of(state)
    if live["cancelling"] and not live["ended"]:
        return ("■ cancelling", "warning")
    if live["ended"]:
        if live.get("verdict", True):
            return ("✓ passed", "success")
        code = live.get("exit_code")
        return ("✗ exit %d" % code if code != None else "✗ failed", "error")
    line = _bazel_line(live["progress"][0]) if live.get("progress") else ""
    counts = _progress_counts(line) if line else None
    spin = _SPINNER[state["frames"] % len(_SPINNER)]
    return (spin + " " + ("%s/%s" % (_thousands(counts[0]), _thousands(counts[1])) if counts else "running"), "accent")

def live_words(state: dict) -> str:
    """The live run in a header: `live ⠹ 4/14`, `live ✗ exit 1`, `live ✓
    passed` (`_live_status`)."""
    return "live " + _live_status(state)[0]

def history_bar() -> str:
    """The status bar's style over the history: the theme's `status_bar`,
    in its `accent` colour, so a past run never passes for the live one,
    though a theme restyles either."""
    return _c("status_bar") + _c("accent")

_WEEKDAYS = ["Thu", "Fri", "Sat", "Sun", "Mon", "Tue", "Wed"]

_MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]

def ago(stamp: str, now: int, short: bool = False) -> str:
    """When a run started, `stamp` (UTC), as the local clock tells it from
    `now` (ms since 1970): `just now`, `8m ago`, `16:36` earlier today,
    `yesterday 16:36`, `Mon 16:36` this week, `Nov 3 16:36` this year, else
    `2025-11-03`; `short`, as few cells as say it (`now`, `8m`, `3h`, `2d`,
    then the date)."""
    ms = stamp_ms(stamp)
    if ms == None:
        return stamp
    since = now - ms
    if short and since >= 0 and since < 100 * 86400000:
        for unit, word in ((86400000, "d"), (3600000, "h"), (60000, "m")):
            if since >= unit:
                return "%d%s" % (since // unit, word)
        return "now"
    if since >= 0 and since < 60000:
        return "just now"
    if since >= 0 and since < 3600000:
        return "%dm ago" % (since // 60000)
    day, clock, _, _ = local_parts(ms)
    today = local_parts(now)[0]
    if day == today:
        return clock
    if day == today - 1:
        return "yesterday " + clock
    if today - 7 < day and day < today:
        return _WEEKDAYS[day % 7] + " " + clock
    y, m, d = civil(day)
    if y == civil(today)[0]:
        return "%s %d %s" % (_MONTHS[m - 1], d, clock)
    return "%d-%s%d-%s%d" % (y, "0" if m < 10 else "", m, "0" if d < 10 else "", d)

def _span_ms(started, ended) -> int | None:
    """The milliseconds from one record timestamp to another, or None
    without both."""
    a = stamp_ms(started or "")
    b = stamp_ms(ended or "")
    return b - a if a != None and b != None and b >= a else None

def _status_text(record: dict) -> tuple:
    """A run's status column and its role: `✔ ok`, `✗ exit 1`, `✗ error`,
    `■ cancelled`, `◌ running`."""
    ended = outcome(record)
    if ended == "ok":
        return "✔ ok", "success"
    if ended in ("cancelled", "abandoned"):
        return "■ " + ended, "warning"
    if ended == "running":
        return "◌ running", "accent"
    return "✗ " + ended, "error"

def _shortened(label: str, level: int) -> str:
    """`label` with each target's package shortened in the middle: at
    `level` 1 its last folder kept (`//examples/dashboard:demo` →
    `//…/dashboard:demo`), at 2 none (`//…:demo`); a target's name is never
    cut here."""
    words = []
    for w in label.split(" "):
        package, colon, name = w.partition(":")
        folders = package.removeprefix("//").split("/")
        if w.startswith("//") and (len(folders) > 1 or (level == 2 and folders[0] and colon)):
            w = "//…" + ("/" + folders[-1] if level == 1 else "") + colon + name
        words.append(w)
    return " ".join(words)

def command_cell(label: str, flags: list, width: int) -> str:
    """A run's command in `width` cells, the label (the task and its
    targets, `command_parts`) the last to be cut: as many of its flags as
    fit after it, a `<REDACTED>` one dropped first and the others from the
    end, ` …` for those dropped where it fits beside the whole label; then
    its packages shortened in the middle, the last folder kept, then none
    (`_shortened`), never a target's name while a package can still shrink;
    then the label cut."""
    kept = list(flags)
    if _text_width(" ".join([label] + kept)) <= width:
        return " ".join([label] + kept)
    for _ in range(len(flags)):
        redacted = [i for i, f in enumerate(kept) if "<REDACTED>" in f]
        kept.pop(redacted[-1] if redacted else len(kept) - 1)
        if kept and _text_width(" ".join([label] + kept + ["…"])) <= width:
            return " ".join([label] + kept + ["…"])
    if flags and _text_width(label + " …") <= width:
        return label + " …"
    for text in (label, _shortened(label, 1), _shortened(label, 2)):
        if _text_width(text) <= width:
            return text
    return _fit(_shortened(label, 2), width).rstrip(" ")

def _ending(path: str, paths: list) -> str:
    """The shortest ending of `path` (folders from the right) that tells it
    apart from `paths`."""
    parts = path.rstrip("/").split("/")
    name = path
    for k in range(1, len(parts) + 1):
        name = "/".join(parts[-k:])
        if not [q for q in paths if q != path and (q.rstrip("/") == name or q.rstrip("/").endswith("/" + name))]:
            break
    return name

def workspace_names(paths: list) -> dict:
    """Each workspace path's name for the list: a worktree slot's as the
    pool's layout names it (`aspect-cli·9c1239a4`, `slot_name`) where no
    other listed has the same, else the shortest ending of it that tells it
    apart from the others (`_ending`)."""
    distinct = [p for i, p in enumerate(paths) if p and p not in paths[:i]]
    names = {}
    for p in distinct:
        slot = slot_name(p)
        names[p] = slot if slot != None and [q for q in distinct if slot_name(q) == slot] == [p] else _ending(p, distinct)
    return names

# The columns' least widths: the widest each comes to hold as its rows age
# (`just now`, `now`, `4m05s`, an ID), so a column never comes and goes as
# the clock moves. The workspace column at most `_WORKSPACE_CAP` (more where
# the row has room to spare), at least `_WORKSPACE_LEAST` before it goes.
_WHEN_LEAST = 8

_SHORT_WHEN_LEAST = 3

_TOOK_LEAST = 5

_ID_WIDTH = 8

_WORKSPACE_CAP = 20

_WORKSPACE_LEAST = 10

def _row_cells(state: dict, row, now: int) -> dict:
    """A list row's cells, unpadded: the live build's (`row` None) or a
    run's: its status, its glyph alone and role, when it started (and in
    short, `when_short`), how long it took (so far, `8.1s…`, for one still
    going elsewhere), its workspace, its command's label and flags (each
    safe to draw), its ID (`pruned` for one whose files a prune removed,
    `live`), whether it is dimmed (pruned)."""
    if row == None:
        rec = state["browser"].get("live_record")
        live = _live_of(state)
        status, role = _live_status(state)
        label, flags = command_parts(rec) if rec != None else (live.get("task", ""), [])
        started = rec.get("started", "") if rec != None else ""
        return dict(
            status = status,
            role = role,
            when = ago(started, now) if started else "just now",
            when_short = ago(started, now, short = True) if started else "now",
            took = duration(max(0, live["now_ms"] - live.get("task_start_ms", live["start_ms"]))),
            workspace = (rec or {}).get("workspace", "") or "",
            label = printable(label, keep = "\t"),
            flags = [printable(f, keep = "\t") for f in flags],
            id = "live",
            dim = False,
        )
    status, role = _status_text(row)
    label, flags = command_parts(row)
    took_text = took(row)
    start = stamp_ms(row.get("started", ""))
    if outcome(row) == "running" and start != None and now >= start:
        took_text = duration(now - start) + "…"
    return dict(
        status = status,
        role = role,
        when = ago(row.get("started", ""), now),
        when_short = ago(row.get("started", ""), now, short = True),
        took = took_text,
        workspace = row.get("workspace", "") or "",
        label = printable(label, keep = "\t"),
        flags = [printable(f, keep = "\t") for f in flags],
        id = "pruned" if row.get("evicted") else row.get("task", {}).get("id", "")[:8],
        dim = bool(row.get("evicted")),
    )

def table_rows(state: dict, rows: list, width: int, chosen: int) -> list:
    """`rows` (`history_rows`' visible ones) drawn in columns `width` wide,
    the `chosen`th in reverse video alone. Status and when always; the
    workspace (muted) while the list is not this workspace's alone; the
    command; the duration and the ID (muted, `live` on the live build's
    row). A column is as wide as the widest it comes to hold
    (`_WHEN_LEAST`...), so none comes and goes as rows age. The command's
    label is the last thing cut: a row's flags go first (`command_cell`),
    then the ID column, then the duration, then the workspace shortened to
    `_WORKSPACE_LEAST`, then status and when as short as they say it (a
    glyph, `5m`) to keep it, then it gone; only then is the label
    shortened. The command column is as wide as its widest command, the
    ID beside it."""
    now = state["browser"]["now_ms"]
    cells = [_row_cells(state, r, now) for r in rows]
    if not cells:
        return []
    b = state["browser"]
    names = workspace_names([c["workspace"] for c in cells]) if not (b["here"] and b["workspace"]) else {}
    for c in cells:
        c["workspace"] = names.get(c["workspace"], "")
    widest = lambda key: max([_text_width(c[key]) for c in cells])
    ws_full = widest("workspace") if names else 0
    took_w = max(_TOOK_LEAST, widest("took")) if widest("took") else 0
    label_w = widest("label")
    full_w = max([_text_width(" ".join([c["label"]] + c["flags"])) for c in cells])
    ws_cap = min(ws_full, _WORKSPACE_CAP)
    plans = [
        dict(id = True, took = True, ws = ws_cap, short = False),
        dict(id = False, took = True, ws = ws_cap, short = False),
        dict(id = False, took = False, ws = ws_cap, short = False),
        dict(id = False, took = False, ws = min(ws_full, _WORKSPACE_LEAST), short = False),
        dict(id = False, took = False, ws = min(ws_full, _WORKSPACE_LEAST), short = True),
        dict(id = False, took = False, ws = 0, short = False),
        dict(id = False, took = False, ws = 0, short = True),
    ]

    def others(plan):
        # The cells beside the command, each with its separator.
        status_w = 1 if plan["short"] else widest("status")
        when_w = max(_SHORT_WHEN_LEAST, widest("when_short")) if plan["short"] else max(_WHEN_LEAST, widest("when"))
        ws = [plan["ws"]] if plan["ws"] else []
        return [status_w, when_w] + ([took_w] if plan["took"] and took_w else []) + ws + ([_ID_WIDTH] if plan["id"] else [])

    def room(plan):
        widths = others(plan)
        used = 0
        for w in widths:
            used += w + 2
        return width - used

    plan = plans[-1]
    for p in plans:
        if room(p) >= label_w:
            plan = p
            break
    if plan["ws"] and plan["ws"] < ws_full and room(plan) > full_w:
        # Room to spare: the workspace's name longer.
        plan = dict(plan, ws = min(ws_full, plan["ws"] + room(plan) - full_w))
    status_w, when_w = others(plan)[0], others(plan)[1]
    command_w = max(1, min(room(plan), full_w))
    out = []
    for i, c in enumerate(cells):
        status = c["status"].partition(" ")[0] if plan["short"] else c["status"]
        when = c["when_short"] if plan["short"] else c["when"]
        pieces = [(_fit(status, status_w), c["role"]), (_fit(when, when_w), "")]
        if plan["took"] and took_w:
            pieces.append((_fit(c["took"], took_w), ""))
        if plan["ws"]:
            name = c["workspace"]
            cut = name if _text_width(name) <= plan["ws"] else "…" + _tail(name, plan["ws"] - 1)
            pieces.append((_fit(cut, plan["ws"]), "muted"))
        pieces.append((_fit(command_cell(c["label"], c["flags"], command_w), command_w), ""))
        if plan["id"]:
            pieces.append((_fit(c["id"], _ID_WIDTH), "accent" if c["id"] == "live" else "muted"))
        joined = "  ".join([p for p, _ in pieces])
        plain = _fit(joined, width)
        if i == chosen:
            out.append(_c("active") + plain + _RESET)
        elif c["dim"]:
            out.append(_c("muted") + plain + _RESET)
        elif _text_width(joined) > width:
            out.append(plain)
        else:
            drawn = "  ".join([(_c(role) + p + _RESET) if role else p for p, role in pieces])
            out.append(drawn + " " * (width - _text_width(joined)))
    return out

def workspace_of(std) -> str:
    """The Bazel workspace the task runs in (`std.env.bazel_root_dir()`, as
    its history record names it), or "" outside one."""
    return std.env.bazel_root_dir() if std.env.in_bazel_workspace() else ""

def _fresh_view(state: dict) -> None:
    """The UI as a newly shown run starts: its console, following it,
    nothing open, its folds drawn for the mouse as it is; the filter, zoom,
    wrap, the mouse and what Ctrl+O shows kept."""
    state.update(
        scroll = 0,
        view = None,
        views = [],
        parked = {},
        tab = "console",
        tab_scroll = 0,
        focus = "console",
        search = _new_search(),
        selected = 0,
        picked = 0,
        picked_build = None,
        panes = None,
        unseen = 0,
        unseen_errors = 0,
        help = False,
        list = "failures",
        select = None,
        stepped = None,
        actions_scroll = 0,
        tip_selected = 0,
    )
    _refold(state)

def show_past(state: dict, record: dict) -> None:
    """Read `record` back and show it, the live run (when it is the one
    shown) kept aside in `live`; the list drawn first saying what is being
    read (`state["draw"]`, where a screen is held), as a big build takes a
    moment. One that cannot be read (a file of it gone strange) leaves the
    list up, saying why, and the live task going on."""
    b = state["browser"]
    id = record.get("task", {}).get("id", "")[:8]
    if state.get("draw") != None:
        b["reading"] = id
        state["draw"]()
    err, run = catch(past_run, state, record)
    b["reading"] = ""
    if err:
        _say_note(state, "cannot open %s: %s" % (id, err.message), _NOTE_MS)
        return
    if state.get("live") == None and state.get("past") == None:
        state["live"] = _run_of(state)
    _show_run(state, run)
    _fresh_view(state)
    state["mode"] = "run"
    set_interrupts(state)

def show_live(state: dict) -> None:
    """Show the live run again, if a past one is shown in its place."""
    if state.get("live") != None:
        _show_run(state, state["live"])
        state["live"] = None
        _fresh_view(state)
    state["mode"] = "run"
    state["ctrl_c_ms"] = None
    set_interrupts(state)

def ctrl_c(state: dict) -> bool:
    """Ctrl+C while browsing: standalone, it leaves (whether it does).
    During a live build, the first says what a second does (`ctrl_c_note`),
    and a second within `_CTRL_C_MS` interrupts the live build as a Ctrl+C
    on its own screen would (`screen.interrupt()`) and shows it; while it
    is already cancelling, that second one is the repeat that forces it to
    stop, and shows it too. Once the live task has ended (or its finished
    screen is held), it goes back to the live screen, where Ctrl+C
    leaves."""
    if state["browser"]["standalone"]:
        return True
    live = _live_of(state)
    if live["ended"] or state.get("holding"):
        show_live(state)
        return False
    if not ctrl_c_note(state):
        state["ctrl_c_ms"] = int(monotonic() * 1000)
        return False
    live["cancelling"] = True
    show_live(state)
    if state.get("screen") != None:
        state["screen"].interrupt()
    return False

def _within(dir: str, rel) -> str | None:
    """`dir` + `/` + `rel`, a path a record names inside its entry (`dir`):
    None for one that is not a string, is empty or absolute, or climbs out
    (a `..`), so a record cannot show a file outside its run's."""
    if type(rel) != "string" or not rel or rel.startswith("/") or ".." in rel.split("/"):
        return None
    return dir + "/" + rel

def _is_test_log(name: str) -> bool:
    """Whether a kept file `name` is a `test.log`: as kept, or numbered
    (`test.2.log`) where another test's took the name."""
    if name == "test.log":
        return True
    middle = name.removeprefix("test.").removesuffix(".log")
    return name.startswith("test.") and name.endswith(".log") and middle.isdigit()

# The most of a build's `actions.json` read; a longer one is not used.
_MAX_INDEX_BYTES = 8 << 20

def _summary_failures(build: dict) -> list:
    """The failures a build's record summed up, each a dict; none for a
    summary that is not one."""
    summary = build.get("summary")
    failures = summary.get("failures") if type(summary) == "dict" else None
    return [f for f in failures if type(f) == "dict"] if type(failures) == "list" else []

def _kept_files(dir: str, logs, kind: str) -> list:
    """A summary failure's `logs` as `(name, "kept:<path>")` files inside its
    entry `dir` (`_within`; any other left out), a test's `test.log` alone,
    as the live record has."""
    files = []
    for log in (logs if type(logs) == "list" else []):
        path = _within(dir, log)
        if path == None:
            continue
        name = path.rpartition("/")[2]
        if kind != "test" or _is_test_log(name):
            files.append((name, "kept:" + path))
    return files

def _summary_records(dir: str, build: dict) -> list:
    """Failure records from a build's summary in its record, for a build
    whose event stream was cut short before them: each a past run's, its
    logs the history's copies inside its entry `dir` (`_kept_files`)."""
    out = []
    for f in _summary_failures(build):
        kind = "test" if f.get("kind") == "test" else "action"
        attempt = f.get("attempt") if type(f.get("attempt")) == "list" and len(f["attempt"]) == 3 else [1, 1, 1]
        record = {
            "kind": kind,
            "label": str(f.get("label", "")),
            "detail": str(f.get("detail", "") or ("attempt %d" % attempt[2] if kind == "test" else "Action")),
            "files": _kept_files(dir, f.get("logs"), kind),
            "output": "",
            "config": "",
            "success": False,
            "past": True,
            "indexed": True,
        }
        if kind == "test":
            record.update(run = attempt[0], shard = attempt[1], attempt = attempt[2])
        out.append(record)
    return out

def _attempt_of(entry: dict) -> int:
    """An `actions.json` entry's `build_attempt`, 0 for one it has not or
    gives as anything but a whole number."""
    n = entry.get("build_attempt", 0)
    if type(n) == "string" and n.isdigit():
        return int(n)
    return n if type(n) == "int" else 0

def use_kept_logs(state: dict, dir: str, build: dict, actions: list = [], folder: str = "", attempts: int | None = None, indexed: dict = {}) -> None:
    """Point each failure of a past run's `build` at the logs the history
    kept for it (its summary's, inside its entry `dir`, `_kept_files`),
    matched by label and the action's mnemonic or the test attempt, in
    order, a failure that kept none holding its place. Point each action
    that wrote output at the logs its build's `actions.json` lists
    (`actions`, its entries; `folder`, where it is, each log inside it,
    `_within`), those that succeeded, matched by label and mnemonic in
    order, among the build's last attempt's entries (`build_attempt`, when
    Bazel restarted it; the last is `attempts`, the index's
    `build_attempts`, when it says). Mark every record as the past's
    (`past`), and whether the history kept an index of its kind's logs
    (`indexed`, by kind)."""
    kept = {}
    for f in _summary_failures(build):
        attempt = f.get("attempt")
        key = (f.get("kind", ""), f.get("label", ""), tuple(attempt) if type(attempt) == "list" and attempt else f.get("detail", ""))
        kept.setdefault(key, []).append(_kept_files(dir, f.get("logs"), f.get("kind", "")))
    for record in state["fails"]:
        record["past"] = True
        record["indexed"] = indexed.get(record["kind"], False)
        what = (record["run"], record["shard"], record["attempt"]) if record["kind"] == "test" else record["detail"]
        logs = kept.get((record["kind"], record["label"], what))
        mine = logs.pop(0) if logs else []
        if mine:
            record["files"] = mine

    # The index lists every attempt of a build Bazel restarted in place,
    # and the run shows its last.
    actions = [a for a in actions if type(a) == "dict"]
    last = attempts if attempts != None else max([_attempt_of(a) for a in actions] or [0])
    listed = {}
    for a in actions:
        # Outputs are of actions that succeeded; a failure's log is its own.
        if a.get("success") == False or _attempt_of(a) != last:
            continue
        key = (str(a.get("label", "")), str(a.get("mnemonic", "") or "Action"))
        listed.setdefault(key, []).append(a)
    for record in state["outputs"]:
        record["past"] = True
        entries = listed.get((record["label"], record["detail"]))
        a = entries.pop(0) if entries else None
        if a:
            files = [(name, "kept:" + _within(folder, a[name])) for name in ("stderr", "stdout") if _within(folder, a.get(name)) != None]
            if files:
                record["files"] = files

# What a past run's build whose kept event stream was cut short says.
CUT_STREAM = "event stream ended early"

def _replay_build(s: dict, record: dict, build: dict, events: str) -> None:
    """One of a past run's Bazel invocations into `s`, as the live screen
    took it: its kept `events` (`take_event`), its failures pointed at the
    history's copies of their logs (`use_kept_logs`), Bazel's raw log the
    history's copy beside them (`console.log`), its profile there
    (`profile_path`) and its exit code (`bazel_exit`), then folded to a row
    (`end_build`), timed by its record; one whose stream was cut short says
    so on its row, and one still being written is in progress."""
    _new_build(s, 0)
    s["building"] = True
    s["stream_cut"] = False
    s["in_progress"] = False
    s["build_command"] = build.get("command", "")
    stream = bazel.build_events.read(events)
    for event in stream:
        _take_event(s, event)
    folder = events.rpartition("/")[0]
    got = s["read"](folder + "/actions.json", _MAX_INDEX_BYTES)
    index = json.try_decode(got[0], None) if got != None and got[1] == 0 else None
    index = index if type(index) == "dict" else {}
    actions = index.get("actions") if type(index.get("actions")) == "list" else []
    attempts = index.get("build_attempts") if type(index.get("build_attempts")) == "int" else None

    # Which kinds the history was keeping logs of, so a failure without one
    # does not name a flag that was already on.
    indexed = {
        "action": s["read"](folder + "/actions.json", 0) != None,
        "test": s["read"](folder + "/testlogs.json", 0) != None,
    }
    use_kept_logs(s, record.get("dir", ""), build, actions = actions, folder = folder, attempts = attempts, indexed = indexed)
    if not stream.complete and outcome(record) == "running" and build.get("ended") == None:
        # Still being written: what it has so far.
        s["in_progress"] = True
    elif not stream.complete:
        # Cut short before its failures came, the record's summary of them.
        s["stream_cut"] = True
        if not s["fails"]:
            s["fails"] = _summary_records(record.get("dir", ""), build)
    code = build.get("exit_code")
    s["build_failed"] = code not in (None, 0)
    s["bazel_exit"] = code if type(code) == "int" else None
    console = folder + "/console.log"
    s["log_path"] = console if s["read"](console, 0) != None else ""
    profile = folder + "/command.profile.gz"
    s["profile_path"] = profile if s["read"](profile, 0) != None else ""
    s["pages"] = results_pages(s["bes_base"], s["bazel_uuid"], {})
    span = _span_ms(build.get("started"), build.get("ended"))
    _end_build(s, span if span != None else 0)
    if s.get("stream_cut"):
        s["builds"][-1]["outcome"] = CUT_STREAM
    elif s.get("in_progress"):
        s["builds"][-1]["outcome"] = "in progress"
        s["builds"][-1]["running"] = True

def _size_text(n: int) -> str:
    """A size in bytes as `12.3 MiB`, `40 KiB` or `512 bytes`."""
    if n >= 1 << 20:
        tenths = n * 10 // (1 << 20)
        return "%d.%d MiB" % (tenths // 10, tenths % 10)
    if n >= 1 << 10:
        return "%d KiB" % (n // (1 << 10))
    return "%d bytes" % n

# The most of a past run's output read back: what the console keeps without
# trimming it (`add_lines`), with the line naming the older ones.
_REPLAY_LINES = _MAX_LOG - _MAX_LOG // 10 - 1

def past_run(state: dict, record: dict) -> dict:
    """The run of a history `record` (`ctx.std.history`), read back as the
    dashboard showed it: each Bazel invocation that kept its build events
    (`bazel.build_events.read`) folded to a row as the live screen folds a
    build that ended (`_replay_build`), its failures' logs the history's own
    copies (a log it did not keep is not looked for in the output tree,
    which may hold a later build's); and the Console the task's whole output
    as it was shown (its `output.ansi`, through `ctx.std.history.read_output`,
    the newest `_REPLAY_LINES`, a line first naming what older output was
    left out; `replayed`). A run that started no build has a line of its
    record first; one whose files a prune removed, or that went since the
    list was read, shows its record in words (`show_lines`, as `aspect
    history show` does). Ended, its time from its start to its last build's
    end (else its duration), its results pages those it linked as well as
    the ones its last build named."""
    id = record.get("task", {}).get("id", "")
    show = "aspect history show " + id[:8]
    gone = bool(record.get("dir")) and state["read"](record["dir"] + "/task.json", 0) == None

    def kept(path):
        return path if path and state["read"](path, 0) != None else None

    builds = [(b, kept(b.get("build_events"))) for b in record.get("bazel", [])]
    builds = [(b, events) for b, events in builds if events]
    output = state["browser"]["history"].read_output(record, limit = _REPLAY_LINES) if not gone and not record.get("evicted") else None

    def read(s):
        s["files_gone"] = gone
        if record.get("evicted"):
            _add_lines(s, ["This run's files were removed (pruned %s) · %s" % (ago(record["evicted"], now_ms()), show), ""] + show_lines(record), cli = True)
            return
        if gone:
            _add_lines(s, ["This run's files were removed since the list was read · " + show, ""] + show_lines(record), cli = True)
            return
        if not record.get("bazel"):
            _add_lines(s, [" · ".join([p for p in [command_parts(record)[0], outcome(record), took(record), show] if p])], cli = True)
        for build, events in builds:
            _replay_build(s, record, build, events)
        if output == None:
            _add_lines(s, ["console not kept for this run · " + show], cli = True)
            return
        older = []
        if output["dropped_bytes"]:
            older.append(_size_text(output["dropped_bytes"]) + " of older output")
        if output["dropped"]:
            older.append("%s older lines" % _thousands(output["dropped"]))
        if older:
            _add_lines(s, [" and ".join(older) + ": " + show], cli = True)
        lines = output["lines"]
        _add_lines(s, [l["text"] for l in lines], [l["links"] for l in lines], [l["colour"] for l in lines])
        s["replayed"] = True

    run = _on_run(state, _new_run(task = task_name(record), phase = "History"), read)
    pages = list(run["pages"])
    for link in record.get("links", []):
        page = (link.get("label", ""), link.get("url", ""))
        if page[1] and page[1] not in [url for _, url in pages]:
            pages.append(page)
    recorded = record.get("bazel") or [{}]
    span = _span_ms(record.get("started"), recorded[-1].get("ended"))
    run.update(
        ended = True,
        progress = [],
        start_ms = 0,
        task_start_ms = 0,
        now_ms = span if span != None else (record.get("duration_ms") or 0),
        pages = pages,
        past = record,
        verdict = outcome(record) == "ok",
    )
    return run

def past_note(state: dict) -> str:
    """What a past run's build tabs say when it has nothing for them: one
    whose files a prune removed or that went since the list was read, one
    still running elsewhere, one that started no build; "" for a run with
    builds, or no past run."""
    rec = state.get("past")
    if rec == None:
        return ""
    now = (state.get("browser") or {}).get("now_ms") or now_ms()
    if rec.get("evicted"):
        return "Files removed (pruned %s)" % ago(rec["evicted"], now)
    if state.get("files_gone"):
        return "Files removed since the list was read"
    if outcome(rec) == "running":
        return "Still running (as of %s); counts and failures appear when it ends" % local_parts(now)[1]
    if not rec.get("bazel"):
        return "This run started no build"
    return ""

def past_running(state: dict) -> str:
    """`Still running (as of HH:MM)` for a past run still going elsewhere,
    for the panes whose counts and profile it has not got yet; else ""."""
    rec = state.get("past")
    if rec == None or outcome(rec) != "running":
        return ""
    now = (state.get("browser") or {}).get("now_ms") or now_ms()
    return "Still running (as of %s)" % local_parts(now)[1]

def past_header(state: dict, cols: int = 1 << 30) -> str:
    """A past run's header, `cols` wide at most, the mode first so it never
    passes for the live one, then the run's glyph: `History · ✗ build
    //examples/dashboard:demo · exit 1 · 3.3s · 7m ago`, a run recorded
    while it ran saying as of when the list was read, a cut event stream
    saying so. Too narrow, its command's flags go first (`command_cell`),
    then the age, the cut stream's note and the duration, in that order,
    before the command's label is shortened as the list shortens one."""
    rec = state["past"]
    b = state.get("browser") or {}
    now = b.get("now_ms") or now_ms()
    status, _ = _status_text(rec)
    mark, _, ended = status.partition(" ")
    kept = ["running, as of " + local_parts(now)[1] if ended == "running" else ended]
    optional = []
    if took(rec):
        optional.append(("took", took(rec)))
    if [b for b in state.get("builds", []) if b.get("outcome") == CUT_STREAM]:
        optional.append(("cut", CUT_STREAM))
    optional.append(("age", ago(rec.get("started", ""), now)))
    label, flags = command_parts(rec)
    label = printable(label, keep = "\t")
    flags = [printable(f, keep = "\t") for f in flags]

    def text(cmd, parts):
        return " History · %s %s · %s" % (mark, cmd, " · ".join(kept + [p for _, p in parts]))

    # The age first, then the cut stream's note, then the duration, until
    # the label fits whole; else none of them, the label shortened.
    order = ["age", "cut", "took"]
    for drop in range(len(order) + 1):
        parts = [p for p in optional if p[0] not in order[:drop]]
        room = cols - _text_width(text("", parts))
        if room >= _text_width(label) or drop == len(order):
            return text(command_cell(label, flags, max(1, room)), parts)
    return text(label, [])

dashboard_history = namespace(
    ago = ago,
    box_title = box_title,
    browsing = browsing,
    command_cell = command_cell,
    ctrl_c = ctrl_c,
    ctrl_c_note = ctrl_c_note,
    CUT_STREAM = CUT_STREAM,
    cycle_filter = cycle_filter,
    damaged_text = damaged_text,
    empty_text = empty_text,
    failed_note = failed_note,
    filter_note = filter_note,
    header_text = header_text,
    history_bar = history_bar,
    history_open = history_open,
    history_records = history_records,
    history_rows = history_rows,
    keys_labels = keys_labels,
    live_words = live_words,
    new_browser = new_browser,
    open_history = open_history,
    page_rows = page_rows,
    past_header = past_header,
    past_note = past_note,
    past_running = past_running,
    past_run = past_run,
    row_id = row_id,
    show_live = show_live,
    show_past = show_past,
    standalone_state = standalone_state,
    table_rows = table_rows,
    toggle_failed = toggle_failed,
    toggle_workspace = toggle_workspace,
    testonly_use_kept_logs = use_kept_logs,
    testonly_within = _within,
    warned = warned,
    workspace_names = workspace_names,
    workspace_note = workspace_note,
    workspace_of = workspace_of,
)
