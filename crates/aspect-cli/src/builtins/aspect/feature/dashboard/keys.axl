"""The Dashboard's keys: `KEYS`, the one table `on_key`, the keys row and
the `?` overlay read, the History screen's (dashboard/history.axl) among
them."""

load("@aspect//feature/dashboard/actions.axl", "dashboard_actions")
load("@aspect//feature/dashboard/history.axl", "dashboard_history")
load("@aspect//feature/dashboard/log.axl", "dashboard_log")
load("@aspect//feature/dashboard/pointer.axl", "dashboard_pointer")
load("@aspect//feature/dashboard/view.axl", "dashboard_view")
load("../../private/lib/failures.axl", "failures")
load("../../private/lib/term_text.axl", "term_text")

_fit = term_text.fit
_text_width = term_text.text_width
_tab_extras = failures.tab_extras
_REMAINDER_LEGEND = dashboard_actions.REMAINDER_LEGEND
_REMAINDER_NOTE = dashboard_actions.REMAINDER_NOTE
_built = dashboard_actions.built
_clock = dashboard_log.clock
_FILTERS = dashboard_log.FILTERS
_NOTE_MS = dashboard_log.NOTE_MS
_search_key = dashboard_log.search_key
_folded_to_lines = dashboard_log.folded_to_lines
_folding = dashboard_log.folding
_refold = dashboard_log.refold
_say_note = dashboard_log.say_note
_shown_lines = dashboard_log.shown_lines
_step_match = dashboard_log.step_match
_failure_total = dashboard_view.failure_total
_items = dashboard_view.items
_listed_position = dashboard_view.listed_position
_open_failure = dashboard_view.open_failure
_open_unlogged = dashboard_view.open_unlogged
_pick = dashboard_view.pick
_PICKED_TABS = dashboard_view.PICKED_TABS
_shown_record = dashboard_view.shown_record
_TABS = dashboard_view.TABS
_back_to = dashboard_view.back_to
_listed_failures = dashboard_view.listed_failures
_panes_shown = dashboard_view.panes_shown
_picked_build = dashboard_view.picked_build
_show_tab = dashboard_view.show_tab
_shown_tips = dashboard_view.shown_tips
_tips_count = dashboard_view.tips_count
_toggle_silence = dashboard_view.toggle_silence
_editor = dashboard_pointer.editor
_view_file = dashboard_pointer.view_file
_mouse_key = dashboard_pointer.mouse_key
_next_editor = dashboard_pointer.next_editor
_open_in_editor = dashboard_pointer.open_in_editor
_browsing = dashboard_history.browsing
_ctrl_c = dashboard_history.ctrl_c
_ctrl_c_note = dashboard_history.ctrl_c_note
_cycle_filter = dashboard_history.cycle_filter
_history_failed_note = dashboard_history.failed_note
_history_filter_note = dashboard_history.filter_note
_history_open = dashboard_history.history_open
_history_records = dashboard_history.history_records
_history_rows = dashboard_history.history_rows
_open_history = dashboard_history.open_history
_show_live = dashboard_history.show_live
_show_past = dashboard_history.show_past
_toggle_failed = dashboard_history.toggle_failed
_toggle_workspace = dashboard_history.toggle_workspace
_warned = dashboard_history.warned
_history_workspace_note = dashboard_history.workspace_note

# Alt (Option) with an arrow scrolls half a page, not an Esc and the arrow.
_ALT_SCROLL = ["alt-up", "alt-down"]

# The most keys a frame applies before it draws, so the screen keeps up
# with a burst of wheel or drag reports.
_MAX_KEYS = 512

# How many lines a turn of the mouse wheel scrolls.
_WHEEL = 3

# The keys that leave the finished screen, and leave at once during its
# countdown.
_LEAVE_KEYS = ["q", "enter", "esc"]

# The phase between the console's end and post-task, while the task does
# what follows its build.
_FINISHING = "Finishing…"

def keys_row(state: dict, cols: int) -> str:
    """The keys row, `cols` wide: what is going on when that is all there is
    to say (cancelling, the live build too while a past run is shown, the
    countdown, the keys overlay open, the task finishing after its build,
    when no key is read, a first Ctrl+C while browsing), else the keys for
    what has focus, the likeliest first, as many as fit before `? keys`; a
    past run's, the way back to the History list."""
    if state["ended"] and state["cancelling"]:
        return _fit(" Cancelled", cols)
    live = state.get("live")
    if state["cancelling"] or (live != None and live["cancelling"] and not live["ended"]):
        return _fit(" cancelling… (Ctrl+C again to stop now)", cols)
    if not state["ended"] and state["phase"] == _FINISHING:
        return _fit(" " + _FINISHING + " · Ctrl+C cancels", cols)
    if state.get("countdown_ms") != None:
        return _fit(" Done ✔ · leaving in %ds · q, Enter or Esc leave now · any other key stays" % ((state["countdown_ms"] + 999) // 1000), cols)
    if state.get("help"):
        return _fit(" ↑↓ scroll · any other key closes", cols)
    if _ctrl_c_note(state):
        return _warned(_fit(" " + _ctrl_c_note(state), cols))
    if state.get("note") and (state.get("note_until") == None or _clock(state) < state["note_until"]):
        return _fit(" " + state["note"], cols)
    if state.get("past") != None:
        back = ["Esc back"] if state["view"] != None or state.get("tab", "console") != "console" else []
        return _fit(" " + " · ".join(back + ["q history", "? keys"]), cols)
    if state.get("tab") in ("metrics", "invocation"):
        return _fit(" ↑↓ scroll · Tab next tab · Esc back · q " + ("leave" if state["ended"] else "cancel") + " · ? keys", cols)
    if state.get("tab") == "tips" and state["view"] == None:
        tips = _shown_tips(state)
        chosen = tips[max(0, min(state.get("tip_selected", 0), len(tips) - 1))] if tips else None
        choose = ("↑↓ choose · s %s · " % ("undo" if chosen[1] else "silence")) if tips else ""
        return _fit(" " + choose + "Tab next tab · Esc back · q " + ("leave" if state["ended"] else "cancel") + " · ? keys", cols)
    done = state["ended"]
    parts = [("Done ✔" if state.get("verdict", True) else "Done ✗")] if done else []
    return fit_labels(parts + row_labels(state), cols)

def fit_labels(parts: list, cols: int) -> str:
    """A keys row of `parts`, the likeliest first, `cols` wide: the first,
    then as many whole ones as fit before `? keys`, which is always
    there."""
    text = " " + parts[0] if parts else ""
    for part in parts[1:]:
        if _text_width(text) + 3 + _text_width(part) + len(" · ? keys") > cols:
            break
        text += " · " + part
    return _fit((text + " · ? keys") if text else " ? keys", cols)

def on_key(state: dict, key: str, page: int) -> bool:
    """Apply a key to the dashboard's state; whether it leaves the finished
    screen. The mouse (`mouse_key`) first, then an `early` entry of `KEYS`
    (Ctrl+L; while browsing the history, Ctrl+C and the History screen's
    own keys); then the modes that take the keys: an Esc typed before a key
    as Alt with it, the `?` overlay open (↑↓, `k`/`j` and the wheel scroll
    it, any other key closes it), the search bar open (`_search_key`, every
    key but the arrows and the wheel). Else the first entry of `KEYS` that
    takes the key and applies now; a toggle's entry (`note`) has the keys
    row say, for `_NOTE_MS`, the state it left and how to undo it. Any key
    clears the last one's note. The History screen takes only its own keys
    (and the overlay's)."""

    if _mouse_key(state, key):
        return False
    _say_note(state, "")
    for k in KEYS:
        if k.early and key in k.keys and k.when(state):
            return k.do(state, key, page)
    if _history_open(state) and not state.get("help"):
        return False

    # An Esc typed just before a key reads as Alt with it: apart from the
    # bar's own Alt toggles, it is the two keys.
    if key.startswith("alt-") and key not in _ALT_SCROLL and not (state["search"]["open"] and key in ("alt-c", "alt-w", "alt-backspace")):
        if on_key(state, "esc", page):
            return True
        return on_key(state, key[len("alt-"):], page)
    if state.get("help"):
        if key in ("up", "k", "wheel-up"):
            state["help_top"] = max(0, state.get("help_top", 0) - 1)
        elif key in ("down", "j", "wheel-down"):
            state["help_top"] = state.get("help_top", 0) + 1
        else:
            state["help"] = False
        return False
    if state["search"]["open"] and _search_key(state, key, page):
        return False
    for k in KEYS:
        if key in k.keys and k.when(state):
            leaves = k.do(state, key, page)
            if k.note != None:
                # What the toggle did and how to undo it, for a moment.
                _say_note(state, k.note(state), _NOTE_MS)
            return leaves
    return False

# Key bindings, as data: one table (`KEYS`) drives `on_key`, the keys row
# (`keys_row`) and the `?` overlay (`help_rows`), so none of them can name a
# key another does not. An entry: the keys it takes (`keys`, none for one
# only documented, as the mouse's), whether it applies now (`when`), what
# it does (`do(state, key, page)`, whether it leaves the finished screen),
# its overlay row (`help`: the keys as shown, and what they do) in a
# `group`, shown when `shown` says (else when it applies), and its labels
# in the keys row (`row(state)`, a list). `on_key` runs the first entry
# that takes the key and applies; the order is the precedence (a tab's own
# keys before the console's), and an `early` one goes before the overlay
# and the search bar take the keys.

def _always(state: dict) -> bool:
    return True

def _bar_closed(state: dict) -> bool:
    return not state["search"]["open"]

def _in_list_tab(state: dict) -> bool:
    return state.get("tab") in ("metrics", "invocation") and state["view"] == None

def _over_actions(state: dict) -> bool:
    at = state.get("actions_at")
    hover = state.get("hover")
    return at != None and hover != None and at[0] <= hover[1] and hover[1] <= at[1] and hover[0] < at[2]

def _has_items(state: dict) -> bool:
    return bool(_items(state))

def _has_rows(state: dict) -> bool:
    return bool(_items(state)) or (state.get("list") != "actions" and _failure_total(state) > 0)

def _has_other_list(state: dict) -> bool:
    return bool(state.get("outputs")) or state.get("list") == "actions"

def _tips_listed(state: dict) -> bool:
    return state.get("tab") == "tips" and state["view"] == None

def _failures_focused(state: dict) -> bool:
    return state["focus"] == "failures"

def _k_tab_number(state: dict, key: str, page: int) -> bool:
    _show_tab(state, _TABS[int(key) - 1][0])
    return False

def _k_tab_cycle(state: dict, key: str, page: int) -> bool:
    names = [tab for tab, _ in _TABS]
    i = names.index(state.get("tab", "console")) if state.get("tab", "console") in names else 0
    _show_tab(state, names[(i + (1 if key == "tab" else -1)) % len(names)])
    return False

def _k_panes(state: dict, key: str, page: int) -> bool:
    state["panes"] = not _panes_shown(state)
    return False

def _k_tips(state: dict, key: str, page: int) -> bool:
    rows = _shown_tips(state)
    if not rows:
        return False
    at = max(0, min(state.get("tip_selected", 0), len(rows) - 1))
    if key == "s":
        _toggle_silence(state, rows[at])
    else:
        at = max(0, min(len(rows) - 1, at + (-1 if key in ("up", "k") else 1)))
    state["tip_selected"] = at
    return False

def _k_actions_wheel(state: dict, key: str, page: int) -> bool:
    # The wheel over the running actions scrolls them, not the console.
    state["actions_scroll"] = max(0, state.get("actions_scroll", 0) + (_WHEEL if key == "wheel-down" else -_WHEEL))
    return False

def _k_pick_build(state: dict, key: str, page: int) -> bool:
    newest = len(state.get("builds", [])) - (0 if state.get("building") else 1)
    state["picked_build"] = max(0, min(newest, _picked_build(state) + (1 if key == ">" else -1)))
    state["tab_scroll"] = 0
    return False

def _k_tab_scroll(state: dict, key: str, page: int) -> bool:
    if key in ("K", "home", "J", "end"):
        state["tab_scroll"] = 0 if key in ("K", "home") else 1 << 30
        return False
    step = {"up": -1, "k": -1, "wheel-up": -_WHEEL, "down": 1, "j": 1, "wheel-down": _WHEEL, "pageup": -page, "pagedown": page, "b": -page, " ": page, "u": -page // 2, "d": page // 2}
    state["tab_scroll"] = max(0, state.get("tab_scroll", 0) + step[key])
    return False

def _k_esc(state: dict, key: str, page: int) -> bool:
    if state["view"] != None:
        # Back a crumb: to the view it was opened from, else the tab's own.
        _back_to(state, len(state.get("views", [])))
    elif state.get("tab", "console") != "console":
        _show_tab(state, "console")
    else:
        return _leave(state)
    return False

def _leave(state: dict) -> bool:
    """Whether a leave key leaves the finished screen: from a past run, it
    goes back to the History list instead."""
    if not state["ended"]:
        return False
    if state.get("past") != None:
        _open_history(state, back = True)
        return False
    return True

def _k_other_list(state: dict, key: str, page: int) -> bool:
    state["list"] = "failures" if state.get("list") == "actions" else "actions"
    if not _items(state) and state.get("tab") != "failures":
        state["focus"] = "console"
    return False

def _k_list(state: dict, key: str, page: int) -> bool:
    # The Failures list's rows (`listed_failures`, then the failed targets
    # without a log of their own: a blocked one opens what blocks it); a
    # row's record is the one its heading and excerpt tell.
    items = _items(state)
    pick = _pick(state)
    chosen = state.get(pick, 0)
    if state.get("list") == "actions":
        order = list(range(len(items)))
        at = min(chosen, len(order) - 1)
    else:
        listed = _listed_failures(state)
        order = listed + [len(items) + k for k in range(_failure_total(state) - len(items))]
        at = min(_listed_position(state, listed, chosen), len(order) - 1)
    if not order:
        return False
    if key in ("up", "k", "wheel-up"):
        state[pick] = order[max(0, at - 1)]
    elif key in ("down", "j", "wheel-down"):
        state[pick] = order[min(len(order) - 1, at + 1)]
    elif key in ("K", "home", "J", "end"):
        state[pick] = order[0] if key in ("K", "home") else order[-1]
    elif order[at] >= len(items):
        _open_unlogged(state, order[at])
    else:
        _open_failure(state, order[at])
    return False

def _k_step_record(state: dict, key: str, page: int) -> bool:
    # The chosen record's log first (or the chosen row's), unless the
    # Failures tab shows it already: then a step. Over the failures, the Failures list's rows in its order
    # (`listed_failures`, then `_tab_extras`: a blocked target, Bazel's
    # other errors), so a step from any row goes to its neighbour.
    items = _items(state)
    if state.get("list") == "actions":
        if not items:
            return False
        chosen = min(state.get(_pick(state), 0), len(items) - 1)
        _show_tab(state, "failures")
        step = 1 if key == "]" else -1
        shown = _shown_record(state) == items[chosen]
        _open_failure(state, (chosen + step) % len(items) if shown else chosen)
        return False
    listed = _listed_failures(state)
    order = listed + [len(items) + k for k in range(len(_tab_extras(state)))]
    if not order:
        return False
    chosen = state.get("selected", 0)
    at = min(_listed_position(state, listed, chosen), len(order) - 1)
    if chosen < len(items):
        shown = _shown_record(state) == items[chosen]
    else:
        shown = state.get("stepped") == chosen and state["view"] != None
    _show_tab(state, "failures")
    target = order[(at + (1 if key == "]" else -1)) % len(order)] if shown else chosen
    state["stepped"] = target
    if target >= len(items):
        _open_unlogged(state, target)
    else:
        _open_failure(state, target)
    return False

def _k_step_attempt(state: dict, key: str, page: int) -> bool:
    # Another attempt, shard or run of the target shown, stepped from the
    # one shown (else the chosen one). One shown from a list it is no
    # longer in (another list, a newer build's) opens its target's first
    # record here, or the chosen one where it has none, without a step.
    items = _items(state)
    if not items:
        return False
    chosen = min(state.get(_pick(state), 0), len(items) - 1)
    _show_tab(state, "failures")
    shown = _shown_record(state)
    if shown != None and shown not in items:
        same = [i for i, r in enumerate(items) if r["label"] == shown["label"]]
        _open_failure(state, same[0] if same else chosen)
        return False
    at = items.index(shown) if shown != None else chosen
    same = sorted([i for i, r in enumerate(items) if r["label"] == items[at]["label"]], key = lambda i: (items[i].get("shard", 1), items[i].get("run", 1), items[i].get("attempt", 1), i))
    _open_failure(state, same[(same.index(at) + (1 if key == "}" else -1)) % len(same)])
    return False

def _k_find(state: dict, key: str, page: int) -> bool:
    # Where the bar opened, in the lines a search that jumps lists (a kept
    # filter's scroll counts only its matches, so the newest), no higher
    # than the top page, as `render` draws it.
    search = state["search"]
    held = search["back"] >= 0 and search["mode"] == "jump" and search["pattern"] != None and state["view"] == None
    search["open"] = True
    if search["mode"] == "filter" and search["pattern"] != None:
        search["origin"] = 0
    else:
        search["origin"] = min(state["scroll"], max(0, len(_shown_lines(state)) - page))

    # Folded, the view's rows; the search reads every line, so the origin
    # is kept in lines too, `origin_rows` to go back to.
    search["origin_rows"] = search["origin"]
    if _folding(state):
        search["origin"] = _folded_to_lines(state, search["origin"])
    search["anchored"] = search["origin"] > 0 or held
    return False

def _scroll_by(page: int) -> dict:
    """How far each scrolling key moves the console, up as positive."""
    half = max(1, page // 2)
    return {
        "up": 1,
        "k": 1,
        "wheel-up": _WHEEL,
        "shift-up": half,
        "alt-up": half,
        "u": half,
        "ctrl-u": half,
        "b": page,
        "pageup": page,
        "down": -1,
        "j": -1,
        "wheel-down": -_WHEEL,
        "shift-down": -half,
        "alt-down": -half,
        "d": -half,
        "ctrl-d": -half,
        " ": -page,
        "pagedown": -page,
    }

def _k_scroll(state: dict, key: str, page: int) -> bool:
    state["scroll"] = max(0, state["scroll"] + _scroll_by(page)[key])
    state["search"]["anchored_view"] = False
    return False

def _k_match(state: dict, key: str, page: int) -> bool:
    _step_match(state, 1 if key == "n" else -1, page)
    return False

def _k_ends(state: dict, key: str, page: int) -> bool:
    if key in ("K", "home"):
        # The top, as far as `render` lets it (the oldest lines that fill
        # the pane, wrapped).
        state["scroll"] = 1 << 30
    else:
        state["scroll"] = 0
        state["search"]["back"] = -1
    state["search"]["anchored_view"] = False
    return False

def _k_filter(state: dict, key: str, page: int) -> bool:
    state["filter"] = _FILTERS[(_FILTERS.index(state["filter"]) + 1) % len(_FILTERS)]
    state["scroll"] = 0
    state["search"]["back"] = -1
    state["search"]["anchored_view"] = False
    return False

def _k_help(state: dict, key: str, page: int) -> bool:
    state["help"] = True
    state["help_top"] = 0
    return False

def _k_open(state: dict, key: str, page: int) -> bool:
    if key == "o":
        path, line = _view_file(state)
        _say_note(state, _open_in_editor(state, path, line))
    else:
        _say_note(state, _next_editor(state))
    return False

def _k_wrap(state: dict, key: str, page: int) -> bool:
    state["wrap"] = not state.get("wrap", True)
    state["search"]["anchored_view"] = False
    return False

def _failures_listed(state: dict) -> bool:
    return state.get("tab") == "failures" and state.get("list") != "actions" and state["view"] == None

def _k_expand_failures(state: dict, key: str, page: int) -> bool:
    state["expand_failures"] = not state.get("expand_failures", False)
    return False

def _k_unfold(state: dict, key: str, page: int) -> bool:
    # The lines folded under each `INFO: From`, shown or folded again, from
    # the newest line, as the rows change under the view; what clicks
    # opened forgotten, so folding again folds every one.
    state["unfolded"] = not state.get("unfolded", False)
    if state.get("fold_open"):
        state["fold_open"] = {}
        _refold(state)
    state["scroll"] = 0
    state["search"]["anchored_view"] = False
    return False

def _k_zoom(state: dict, key: str, page: int) -> bool:
    state["zoom"] = not state.get("zoom", False)
    return False

def _mouse_note(state: dict) -> str:
    """What `m` says it did, and how to undo it."""
    return "mouse on: the wheel scrolls, a click picks · m gives it to the terminal" if state.get("mouse") else "mouse off: the terminal selects text · m takes it back"

def _k_mouse(state: dict, key: str, page: int) -> bool:
    if state.get("screen") != None:
        state["mouse"] = not state.get("mouse", False)
        state["screen"].mouse(state["mouse"])

        # The folds' rows say whether a click shows them.
        _refold(state)
    return False

def _k_redraw(state: dict, key: str, page: int) -> bool:
    # The next frame is written though unchanged: the terminal was cleared
    # behind it.
    state["drawn"] = None
    return False

def _k_leave(state: dict, key: str, page: int) -> bool:
    if key == "enter" and state["view"] != None:
        return False
    if state["ended"]:
        return _leave(state)
    if key == "q" and not state["cancelling"]:
        # The run's root token, cancelled once: Bazel gets its own interrupt
        # sequence from it, as for Ctrl+C. A SIGINT to the process group
        # would reach the Bazel client directly too, and count twice.
        state["cancelling"] = True
        if state.get("cancellation") != None:
            state["cancellation"].root.cancel()
        else:
            state["screen"].interrupt()
    return False

def _row_page(state: dict) -> list:
    # The macOS Terminal sends Shift+↑↓ as plain arrows, unless its
    # profile's keyboard settings say otherwise.
    apple = state.get("env") != None and state["env"].var("TERM_PROGRAM") == "Apple_Terminal"
    return ["Fn+↑↓ ⌥↑↓ u d page" if apple else "PgUp PgDn ⇧↑↓ u d page"]

def _row_leave(state: dict) -> list:
    if not state["ended"]:
        return ["q cancel"]
    if state["focus"] == "failures" or state["view"] != None:
        return ["q leave"]
    return ["q, Enter or Esc to leave"]

def _row_step(state: dict) -> list:
    if not _has_rows(state):
        return []
    if state["view"] == None:
        return ["Tab next tab"]
    return ["] [ next/prev action" if state.get("list") == "actions" else "] [ next/prev failure"]

def _row_open(state: dict) -> list:
    name = _editor(state)[1]
    return ["o open in " + name] if name and _view_file(state)[0] else []

def _row_other_list(state: dict) -> list:
    if not _has_other_list(state):
        return []
    return ["a failures" if state.get("list") == "actions" else "a actions"]

# What each key moves the History screen's choice by: rows, half a page
# (`half`), a page, or to the newest or the oldest (`end`).
_HISTORY_MOVES = {
    "up": (-1, "row"),
    "k": (-1, "row"),
    "wheel-up": (-_WHEEL, "row"),
    "down": (1, "row"),
    "j": (1, "row"),
    "wheel-down": (_WHEEL, "row"),
    "u": (-1, "half"),
    "shift-up": (-1, "half"),
    "ctrl-u": (-1, "half"),
    "d": (1, "half"),
    "shift-down": (1, "half"),
    "ctrl-d": (1, "half"),
    "b": (-1, "page"),
    " ": (1, "page"),
    "pageup": (-1, "page"),
    "pagedown": (1, "page"),
    "K": (-1, "end"),
    "home": (-1, "end"),
    "J": (1, "end"),
    "end": (1, "end"),
}

# The keys the History screen reads: its moves, `_history_key`'s others, `m`
# and `?`.
_HISTORY_KEYS = list(_HISTORY_MOVES.keys()) + ["f", "e", "w", "enter", "esc", "q", "h", "m", "?"]

def _history_key(state: dict, key: str, page: int) -> str | None:
    """A key on the History screen: `open` (Enter, a row chosen), `close`
    (Esc, `q`, `h`), or None, having moved the choice (`_HISTORY_MOVES`,
    half a `page` or a page of it), or changed what it shows, which the
    keys row says it did: `f` cycles builds, failed builds and all runs,
    `e` failed builds only and back, `w` this workspace or every one."""
    b = state["browser"]
    _history_records(state)
    n = len(_history_rows(state))
    if key in _HISTORY_MOVES:
        step, unit = _HISTORY_MOVES[key]
        step *= {"row": 1, "half": max(1, page // 2), "page": page, "end": 1 << 30}[unit]
        b["selected"] = max(0, min(n - 1, b["selected"] + step))
        b["chosen"] = None
    elif key == "f":
        _cycle_filter(state)
        _say_note(state, _history_filter_note(state), _NOTE_MS)
    elif key == "e":
        _toggle_failed(state)
        _say_note(state, _history_failed_note(state), _NOTE_MS)
    elif key == "w":
        if _toggle_workspace(state):
            _say_note(state, _history_workspace_note(state), _NOTE_MS)
    elif key == "enter" and n:
        return "open"
    elif key in ("esc", "q", "h"):
        return "close"
    return None

def _k_history(state: dict, key: str, page: int) -> bool:
    # Enter opens the chosen run (the live build's row goes back to it);
    # closing goes back to the live run, or, standalone, leaves.
    if key == "m":
        _k_mouse(state, key, page)
        _say_note(state, _mouse_note(state), _NOTE_MS)
        return False
    if key == "?":
        return _k_help(state, key, page)
    what = _history_key(state, key, page)
    b = state["browser"]
    if what == "open":
        row = _history_rows(state)[b["selected"]]
        if row == None:
            _show_live(state)
        else:
            _show_past(state, row)
    elif what == "close":
        if b["standalone"]:
            return True
        _show_live(state)
    return False

def _k_open_history(state: dict, key: str, page: int) -> bool:
    # From a past run, the list as `q` and Esc go back to it, its run chosen.
    _open_history(state, back = state.get("past") != None)
    return False

def _k_ctrl_c(state: dict, key: str, page: int) -> bool:
    return _ctrl_c(state)

# A key binding (`_key`): see `_key` for its fields.
_Key = record(
    keys = field(list[str]),
    when = field(typing.Callable),
    do = field(typing.Callable | None),
    help = field(tuple | None, default = None),
    group = field(str | None, default = None),
    row = field(typing.Callable | None, default = None),
    shown = field(typing.Callable),
    early = field(bool, default = False),
    note = field(typing.Callable | None, default = None),
)

def _key(keys: list[str], when, do, help: tuple | None = None, group: str | None = None, row = None, shown = None, early: bool = False, note = None) -> _Key:
    """A binding: its `keys`, `when` it applies, what it does (`do`), its
    overlay row (`help`, `(keys, text)`) under `group`, and keys-row labels
    (`row`); `shown`, when the overlay lists it (`when` unless given);
    `early`, whether it applies before the `?` overlay and the search bar
    take the key; `note`, for a toggle, the state it left and how to undo
    it, which the keys row says a moment after the key (`on_key`)."""
    return _Key(keys = keys, when = when, do = do, help = help, group = group, row = row, shown = shown or when, early = early, note = note)

def _filter_note(state: dict) -> str:
    return {
        "all": "every line · e errors and warnings only",
        "warnings": "errors and warnings only · e errors only",
        "errors": "errors only · e every line",
    }[state["filter"]]

def _documented(keys: str, text: str, group: str, shown = _always) -> _Key:
    """An overlay row for keys another layer reads (the mouse, the bar)."""
    return _key([], shown, None, help = (keys, text), group = group, shown = shown)

KEYS = [
    _key(["ctrl-l"], _always, _k_redraw, help = ("^L", "redraw the screen"), group = "Screen", early = True),
    _key(["ctrl-c"], lambda s: s.get("browser") != None and _browsing(s), _k_ctrl_c, early = True),
    _key(_HISTORY_KEYS, lambda s: _history_open(s) and not s.get("help"), _k_history, early = True),
    _documented("↑ ↓  k j", "choose a run", "History", shown = _history_open),
    _documented("Enter", "open it", "History", shown = lambda s: _history_open(s) and s["browser"]["standalone"]),
    _documented("Enter", "open it; on the live build's row, back to it", "History", shown = lambda s: _history_open(s) and not s["browser"]["standalone"]),
    _documented("K J  Home End", "the newest; the oldest", "History", shown = _history_open),
    _documented("u d  PgUp PgDn", "half a page; a page (b and Space too)", "History", shown = _history_open),
    _documented("f", "show builds, failed builds or all runs", "History", shown = _history_open),
    _documented("e", "failed builds only, and back", "History", shown = _history_open),
    _documented("w", "this workspace's runs, or every workspace's", "History", shown = lambda s: _history_open(s) and bool(s["browser"]["workspace"])),
    _documented("q  Esc", "quit", "History", shown = lambda s: _history_open(s) and s["browser"]["standalone"]),
    _documented("q  Esc  h", "back to the live build", "History", shown = lambda s: _history_open(s) and not s["browser"]["standalone"]),
    _documented("^C", "twice: cancel the live build", "History", shown = lambda s: _history_open(s) and not s["browser"]["standalone"]),
    _documented("m", "the mouse to the terminal and back", "History", shown = _history_open),
    _key(["1", "2", "3", "4", "5"], _bar_closed, _k_tab_number, help = ("1-5", "a tab: console, failures, metrics, invocation, tips"), group = "Screen"),
    _key(["tab", "shift-tab"], _bar_closed, _k_tab_cycle, help = ("Tab  ⇧Tab", "the next or previous tab: console, failures, metrics, invocation, tips (or click one)"), group = "Screen"),
    _key(["p"], _always, _k_panes, help = ("p", "the build panes open or folded, and back"), group = "Screen", note = lambda s: ("build panes open · p folds them" if _panes_shown(s) else "build panes folded · p opens them") if _built(s) else "no build panes yet: p opens them once a build runs"),
    _key(["up", "k", "down", "j", "s"], _tips_listed, _k_tips, help = ("s", "in Tips, ↑↓ choose a tip and s silences it on this machine, or undoes it"), group = "Failures", shown = lambda s: s.get("tab") == "tips" or _tips_count(s) > 0),
    _key(["wheel-up", "wheel-down"], _over_actions, _k_actions_wheel),
    _key(["<", ">"], lambda s: s.get("tab") in _PICKED_TABS and s["view"] == None, _k_pick_build, help = ("<  >", "in Metrics and Invocation, the previous or next build"), group = "Screen", shown = lambda s: len(s.get("builds", [])) > 0),
    _key(["K", "home", "J", "end", "up", "k", "wheel-up", "down", "j", "wheel-down", "pageup", "pagedown", "b", " ", "u", "d"], _in_list_tab, _k_tab_scroll),
    _key(["esc"], _always, _k_esc, help = ("Esc", "back a crumb: a file to the log it was opened from, a log to its tab; a tab to the console"), group = "Leave", row = lambda s: ["Esc back"] if s["view"] != None else []),
    _key(["a"], _has_other_list, _k_other_list, help = ("a", "the list: failures, or actions that wrote output"), group = "Failures", row = _row_other_list, note = lambda s: "actions that wrote output listed · a lists the failures" if s.get("list") == "actions" else "failures listed · a lists the actions that wrote output"),
    _key(["up", "k", "wheel-up", "down", "j", "wheel-down", "K", "home", "J", "end", "enter"], _failures_focused, _k_list, help = ("Enter", "in the list: show the chosen log"), group = "Failures", row = lambda s: ["↑↓ choose", "Enter show its log", "Tab next tab", "Esc back"], shown = lambda s: _failure_total(s) > 0 or bool(_items(s))),
    _key(["]", "["], _has_rows, _k_step_record, help = ("]  [  }  {", "the next or previous failure, its log in Failures; } { its next attempt or shard"), group = "Failures", row = _row_step),
    _key(["}", "{"], _has_items, _k_step_attempt),
    _key(["ctrl-f", "/"], _always, _k_find, help = ("/  ^F", "find: jumps to the newest match; n the next one down, N the previous, round the ends"), group = "Search", row = lambda s: ["/ find"]),
    _documented("  Tab", "in the bar: filter to the matches instead, and back", "Search"),
    _documented("  ^T  ^B", "in the bar: match case (else a capital does), whole words", "Search"),
    _documented("  ^W", "in the bar: delete a word", "Search"),
    _documented("  ^U  Enter  Esc", "in the bar: clear; keep and close; clear and go back", "Search"),
    _key(["up", "k", "down", "j"], _always, _k_scroll, help = ("↑ ↓  k j", "scroll a line; in a list, choose"), group = "Scroll"),
    _key(["shift-up", "alt-up", "u", "ctrl-u", "shift-down", "alt-down", "d", "ctrl-d"], _always, _k_scroll, help = ("⇧↑↓ ⌥↑↓  u d  ^U ^D", "scroll half a page (macOS Terminal sends ⇧↑↓ as ↑↓)"), group = "Scroll"),
    _key(["pageup", "pagedown", " ", "b"], _always, _k_scroll, help = ("PgUp PgDn  Space b", "scroll a page (PgUp/PgDn are Fn+↑↓ on a Mac)"), group = "Scroll", row = _row_page),
    _key(["wheel-up", "wheel-down"], _always, _k_scroll, help = ("wheel", "scroll"), group = "Scroll"),
    _key(["n", "N"], _always, _k_match, row = lambda s: ["n N next/prev match"] if s["search"]["pattern"] != None and s["search"]["mode"] == "jump" else []),
    _key(["K", "home", "J", "end"], _always, _k_ends, help = ("K  J", "the top; the end, following the newest (Home, End too)"), group = "Scroll", row = lambda s: ["K J top/end"]),
    _key(["e"], _always, _k_filter, help = ("e", "every line, errors and warnings, errors only"), group = "Search", row = lambda s: ["e filter"], note = _filter_note),
    _documented("drag", "select, and copy on release", "Screen"),
    _documented("click", "a file's link shows the file here (o: in your editor); a web link opens; any other is copied", "Screen"),
    _documented("click a fold", "an INFO: From or its +N count: show or fold its lines (^O all)", "Screen"),
    _key(["?"], _always, _k_help, help = ("?", "these keys"), group = "Screen"),
    _key(["o", "O"], _always, _k_open, help = ("o  O", "open the log (or the task's output) in your editor; pick the editor"), group = "Screen", row = _row_open),
    _key(["w"], _always, _k_wrap, help = ("w", "wrap long lines (the default), or cut them at the edge"), group = "Screen", row = lambda s: ["w " + ("cut" if s.get("wrap", True) else "wrap")], note = lambda s: "long lines wrapped · w cuts them" if s.get("wrap", True) else "long lines cut · w wraps them"),
    _key(["ctrl-o"], _failures_listed, _k_expand_failures, help = ("^O", "in Failures: every failure's excerpt under it, and only the chosen one's again"), group = "Failures", note = lambda s: "every excerpt shown · ^O only the chosen one's" if s.get("expand_failures") else "the chosen failure's excerpt shown · ^O every one's"),
    _key(["ctrl-o"], _always, _k_unfold, help = ("^O", "show the lines under each INFO: From (a successful action's output, folded to a count), and fold every one again"), group = "Screen", note = lambda s: "lines under each INFO: From shown · ^O folds them" if s.get("unfolded") else "lines under each INFO: From folded · ^O shows them"),
    _key(["z"], _always, _k_zoom, help = ("z", "the console fills the screen, and back"), group = "Screen", row = lambda s: ["z " + ("unzoom" if s.get("zoom") else "zoom")], note = lambda s: "console zoomed · z unzooms it" if s.get("zoom") else "console unzoomed · z zooms it"),
    _key(["m"], _always, _k_mouse, help = ("m", "the mouse to the terminal and back"), group = "Screen", note = _mouse_note),
    _key(["q", "enter"], _always, _k_leave, help = ("q", "cancel the build; once it is done, leave"), group = "Leave", row = _row_leave, shown = lambda s: s.get("past") == None),
    _documented("q  Esc", "on a past run: back to the History list", "Leave", shown = lambda s: s.get("past") != None),
    _key(["h"], lambda s: s.get("browser") != None, _k_open_history, help = ("h", "the History list of earlier runs: Enter opens one, f filters them, Esc back"), group = "Leave", row = lambda s: ["h history"] if s.get("browser") != None else []),
]

# The overlay's groups, in order.
_KEY_GROUPS = ["Scroll", "Search", "Failures", "Screen", "Leave", "History"]

# The keys row's labels, in the order they are shown, the likeliest first,
# by what has focus: each names an entry of `KEYS` by its first key.
_ROW_FAILURES = ["up", "q", "a"]

_ROW_CONSOLE = ["esc", "o", "q", "h", "]", "ctrl-f", "n", "e", "pageup", "K", "a", "z", "w"]

def help_rows(state: dict, width: int = 0) -> list:
    """The `?` overlay's rows, grouped (`_KEY_GROUPS`), the keys that do not
    apply now left out, then what the actions' glyphs are (`_actions_key`,
    in rows of `width` cells); on the History screen, its own group alone."""
    rows = []
    for group in (["History"] if _history_open(state) else _KEY_GROUPS):
        entries = [k for k in KEYS if k.group == group and k.help != None and k.shown(state)]
        if not entries:
            continue
        rows.append(group)
        rows += ["  " + _fit(k.help[0], 20) + " " + k.help[1] for k in entries]
    if _history_open(state):
        return rows
    return rows + _actions_key(width) + _key_rows("Tests", _TESTS_KEY, width)

# What the bar's and the Actions rows' glyphs and words are, for the `?`
# overlay, a line each: the remainder's both words, whichever the build's
# outcome draws, since `skipped` says what it holds beyond `up to date`.
_ACTIONS_KEY = [
    "  ran: ok + failed: actions executed this build",
    "█ ok: executed this build and succeeded, locally, sandboxed, in a worker or remotely",
    "╳ failed: executed this build and failed (test failures are under Tests)",
    "  cache hits: local + disk + remote: actions whose results were reused",
    "▒ local: outputs Bazel's action cache on this machine said were still valid. Live, local is estimated (~)",
    "▓ disk / remote: outputs from the --disk_cache directory, or from the remote cache (including a remote executor's cached result)",
] + ["○ %s: %s" % (words, holds) for words, holds in _REMAINDER_LEGEND] + ["  " + _REMAINDER_NOTE] + [
    "░ internal: Bazel bookkeeping with no command (runfiles trees, file writes, workspace status)",
    "▌ other: what Bazel's own counts leave out of every kind, at the end (no execution log to tell them apart); rare",
    "? unreported: Bazel counted these done but hasn't said how; live they settle into a kind, and without every action's events (a remote cache, a --bes_backend, --dashboard:actions=failed) some stay (┈ on the bar)",
    "─ not done: running or pending",
    "actions: what Bazel checked this build. Targets whose inputs didn't change are left out of this count, so it isn't the whole graph",
    "%: cache hits ÷ actions; up to date and skipped ones are no hits, so a warm and a fresh server aren't comparable",
    "The groups and parts don't overlap: they add up to the total actions.",
]

def _actions_key(width: int) -> list:
    """The `?` overlay's rows saying what the actions' glyphs and words
    are: a heading, then a line each, wrapped to `width` cells (whole
    without a width)."""
    rows = ["Actions"]
    for part in _ACTIONS_KEY:
        lines = [""]
        for word in part.split(" "):
            if width and lines[-1] and _text_width(lines[-1] + " " + word) > width - (2 if len(lines) == 1 else 4):
                lines.append("")
            lines[-1] += (" " if lines[-1] else "") + word
        rows += ["  " + lines[0]] + ["    " + l for l in lines[1:]]
    return rows

# What the Tests row says past its counts (`test_progress`, `tests_cached_text`).
_TESTS_KEY = ["─ running · pending: test targets", "(N cached): every run from a cache"]

def _key_rows(title: str, parts: list, width: int) -> list:
    """`title`, then `parts` as many to a row of `width` cells as fit (all
    on one without a width), indented under it."""
    rows = [[]]
    for part in parts:
        if width and rows[-1] and 2 + _text_width(" · ".join(rows[-1] + [part])) > width:
            rows.append([])
        rows[-1].append(part)
    return [title] + ["  " + " · ".join(row) for row in rows]

def row_labels(state: dict) -> list:
    """The keys row's labels for what has focus (`_ROW_FAILURES`,
    `_ROW_CONSOLE`), each from its entry in `KEYS`."""
    order = _ROW_FAILURES if state["focus"] == "failures" else _ROW_CONSOLE
    out = []
    for name in order:
        for k in KEYS:
            if k.row != None and k.keys and (k.keys[0] == name):
                out += k.row(state)
                break
    return out

dashboard_keys = namespace(
    fit_labels = fit_labels,
    help_rows = help_rows,
    testonly_KEYS = KEYS,
    keys_row = keys_row,
    LEAVE_KEYS = _LEAVE_KEYS,
    MAX_KEYS = _MAX_KEYS,
    on_key = on_key,
)
