"""Public facade for the delivery state backend: the trait that selects it and
the implementations that ship with the CLI.

    load("@aspect//delivery_state.axl", "DeliveryState", "delivery_api")

    def config(ctx: ConfigContext):
        if DeliveryState in ctx.traits:
            ctx.traits[DeliveryState].connect = delivery_api.connect

`DeliveryState.connect` is `(ctx, delivery_state.Params) -> delivery_state.Backend`.
Unset, the delivery task uses `deliveryd.connect` on an Aspect Workflows runner
that exposes its deliveryd (`ASPECT_WORKFLOWS_DELIVERY_API_ENDPOINT`), keeping
state in the daemon over its Unix socket, and `delivery_api.connect` elsewhere:
Aspect's delivery API with the Aspect Cloud credential. Both store delivery
metadata and keep every attempt in the target's history, deliveryd once it
serves API v2. Setting either picks it everywhere.

Deprecated, and to be removed: deliveryd's API v1, which the CLI still speaks
to a deliveryd that does not advertise v2, and `redis_state.connect`, which
talks to Redis directly and reads `ASPECT_WORKFLOWS_DELIVERY_REDIS_ENDPOINT`
(plus `_REDIS_CA_FILE`, `_REDIS_AUTH`, `_REDIS_LEGACY_TTL_SECONDS`). The task
warns when it uses either.
Any function returning a `delivery_state.Backend` works as well.
Internal modules load from `private/lib/` directly.
"""

load("./private/lib/delivery_api.axl", _delivery_api = "delivery_api")
load("./private/lib/delivery_state.axl", _DeliveryState = "DeliveryState", _delivery_state = "delivery_state")
load("./private/lib/deliveryd.axl", _deliveryd = "deliveryd")
load("./private/lib/redis_state.axl", _redis_state = "redis_state")

DeliveryState = _DeliveryState
delivery_api = _delivery_api
delivery_state = _delivery_state
deliveryd = _deliveryd
redis_state = _redis_state
