"""`bazel_invocation`: the high-level `build(ctx)` / `test(ctx)` invocation
handles, and the `args` / `targets_arg` / `target_pattern_file_arg` bundles a
Bazel-spawning task declares. `resolve_targets` turns the latter two into the
patterns and flags for a spawn, for tasks such as `lint` that drive
`ctx.bazel.build` without a handle.

The constructor resolves EVERYTHING once — targets, the flag→rc pipeline
(`use_rc`), CLI-streamed BES sinks, the trait's `rc_flags` hooks, announce flags,
the console processor and the retry budget (with the flag that leaves cache
eviction retries to it) — into one immutable `_Invocation` record. The returned
handle exposes the flow as verbs the task drives in a visible loop (see
`build.axl`): the verbs are thin forwarders over that single record, and the
top-level `_do_*` functions thread it — no closure tower, no mutable state
dict. The live invocation and the attempt index are threaded as values (the
`_spawned` struct and the callsite's loop counter), never stored. A task drives
every attempt through `attempts` and `should_retry`: a handle that leaves cache
eviction retries to its loop turns Bazel's own off, so a task that spawns once
gets no eviction retries at all.

The one thing the constructor cannot resolve is per-build wiring: an
`exec_log_event` handle binds to a single build, so each attempt opens its own
(`@aspect//bazel/exec_log.axl`) and threads it through the `_spawned` struct the
same way; its `on_event` and `wait` answer the attempt's own held console
lines, while one processor, resolved once, serves every attempt. `on_event`
hangs off that struct rather than the handle for the same reason — it
dispatches both BES events and execution log entries, and only the attempt
knows which log it is reading."""

load("@aspect//bazel/announce.axl", "bazel_announce")
load(
    "@aspect//bazel/build_events.axl",
    "advertised_results_url",
    "announce_bes_results_url",
    "announce_bes_sinks",
    "announce_dropped_bes_sinks",
    "bes_args",
    "bes_results_url_flag",
    "bes_streamed_by_bazel",
    "build_events_iterator",
    "collect_bes_sinks",
    "dropped_bes_backends",
    "summarize_bes_upload",
)
load("@aspect//bazel/console.axl", "bazel_console")
load("@aspect//bazel/exec_log.axl", "bazel_exec_log")
load("@aspect//bazel/flags.axl", "bazel_flags")
load("@aspect//bazel/rc.axl", "bazel_rc")
load("@aspect//bazel/trait.axl", "BAZEL_RETRY_ATTEMPTS_DESCRIPTION", "BazelTrait", "DEFAULT_BAZEL_RETRY_ATTEMPTS", "exit_code_of", "may_retry", "retry_attempts")
load("../private/lib/text.axl", "join_url")

# BES drain cadence. Passed as `tick_ms` to the event iterator so
# `for event in sp.events` yields `None` after this many ms of quiet, giving a
# results heartbeat without a separate sleep loop.
_TICK_MS = 250

# The cadence instead when the trait has `output_frame` hooks: half the
# runtime's frame interval (`FRAME_EVERY` in `engine/bazel/build.rs`), so a
# frame is never more than one tick late.
_FRAME_TICK_MS = 50

# Immutable, resolved-once config for one high-level bazel run: nothing here is
# reassigned, and the live invocation + attempt index are threaded as values
# rather than stored. `ctx` is carried so the `_do_*` verbs need neither a
# per-call `ctx` (§7) nor a closure over one. `trait`/`rc`/`sinks` are runtime
# handles with no `@aspect`-nameable type, so they are typed `Any`/`list`.
_Invocation = record(
    ctx = field(typing.Any),
    command = field(str),
    trait = field(typing.Any),
    rc = field(typing.Any),
    patterns = field(list[str]),
    sinks = field(list),
    dropped = field(list[str]),
    # A flag, or a `(flag, version constraint)` pair the spawn resolves.
    rc_flags = field(list[str | (str, str)]),
    results_url = field(str),
    bazel_streams_bes = field(bool),
    announce_version = field(bool),
    announce_command = field(bool),
    output_processor = field(typing.Any),
    max_attempts = field(int),
    # Where Bazel's own stdout goes. Always a `Writable`, never None: the
    # builtin reads None as "discard", and `_do_spawn` should not need a
    # conditional. See `_build()`.
    stdout = field(typing.Any),
)

def target_patterns(explicit: bool, cli_targets: list[str], own_pattern_file: str, rc, command: str) -> list[str]:
    """The target patterns to place on Bazel's command line.

    Bazel rejects an invocation carrying both command-line patterns and
    `--target_pattern_file` — that pair has no last-wins rule — so the single
    decision here is whether to materialize the `targets` arg's declared
    default (`["..."]`), a pattern the user never typed. Explicit patterns
    always pass through: when they conflict with a pattern file, Bazel reports
    it, and this handle does not grow a second spelling of that error.

    A pattern file counts no matter which spelling delivered it: aspect's own
    `--target-pattern-file` arrives as `own_pattern_file`, while Bazel's
    `--target_pattern_file` reaches `rc` — from `--bazel-flag`, `.bazelrc`, or
    a `--config` expansion alike, resolved with Bazel's own last-wins parsing.

    Args:
        explicit:         whether the user actually passed target patterns
                          (`ctx.args.is_explicit("targets")`) rather than
                          inheriting the arg's default.
        cli_targets:      `ctx.args.targets`, which defaults to `["..."]`.
        own_pattern_file: value of aspect's `--target-pattern-file`, or `""`.
        rc:               the active `Bazelrc`; only `flag_value` is used.
                          `None` before the rc is resolved, which ignores the
                          forwarded spelling.
        command:          Bazel subcommand whose options `rc` resolves.
    """
    if explicit:
        return cli_targets
    if own_pattern_file:
        return []
    if rc != None and rc.flag_value("--target_pattern_file", command = command):
        return []
    return cli_targets

def resolve_targets(ctx, rc, command: str) -> tuple:
    """The `(patterns, flags)` a task places on its Bazel command line.

    `patterns` is `target_patterns` over the task's `targets` arg. `flags`
    carries aspect's own `--target-pattern-file` as Bazel's
    `--target_pattern_file`, forwarded rather than expanded into argv since the
    flag exists to bypass OS command-line length limits. It is per-invocation,
    not rc material, which is what lets `target_patterns` ask `rc` about the
    forwarded spelling alone.

    Fails when the named file does not exist, so a typo surfaces as aspect's
    own error rather than a Bazel loading failure. A task that does not declare
    `target_pattern_file` gets no flags.

    Args:
        ctx:     the task context; reads `targets` and `target_pattern_file`.
        rc:      the active `Bazelrc`, or `None` to resolve before it exists
                 (e.g. a status subject), ignoring the forwarded spelling.
        command: Bazel subcommand whose options `rc` resolves.
    """
    pattern_file = ctx.args.target_pattern_file if hasattr(ctx.args, "target_pattern_file") else ""
    flags = []
    if pattern_file:
        if not ctx.std.fs.exists(pattern_file):
            fail("--target-pattern-file: file not found: " + pattern_file)
        flags.append("--target_pattern_file=" + pattern_file)
    patterns = target_patterns(
        ctx.args.is_explicit("targets"),
        list(ctx.args.targets),
        pattern_file,
        rc,
        command,
    )
    return patterns, flags

def tty_flags(capturing: bool, stdout_is_tty: bool) -> list[str]:
    """The base flags telling Bazel whether it writes to a terminal.

    A captured console carries its own (`_capture_flags`), which go on the
    spawn instead, after the user's, so they win. Without one, Bazel inherits
    the task's streams and is told whether stdout is a terminal."""
    if capturing:
        return []
    return ["--isatty=" + str(int(stdout_is_tty))]

def _resolve(ctx, command: str, stdout = None) -> _Invocation:
    """Shared constructor for `build` / `test`. Reads everything a feature injected
    on the trait (BES backends, the `rc_flags` hooks); the bazel core knows
    nothing about deployments or Aspect auth."""
    trait = ctx.traits[BazelTrait]

    # Base (default) flags, prepended so user --bazel-flag overrides win.
    # Feature-injected `trait.base_flags` (e.g. a deployment's --remote_cache)
    # are prepended by `bazel_rc.setup` itself.
    extra = bazel_console.start_stages(ctx, trait)
    capturing = bool(trait.output_stages or extra)
    base_flags = tty_flags(capturing, ctx.std.io.stdout.is_tty)

    # Resolve flags → parse_rc → use_rc → announce-rc disclosure. The rc set by
    # use_rc drives the health check (in results.setup) and every spawn below.
    rc = bazel_rc.setup(ctx, command, base_flags = base_flags)

    # The capture asks Bazel for curses, colour and progress, after the
    # user's flags; the user's own `--curses`, `--color` and
    # `--show_progress` decide what is shown.
    processor = bazel_console.processor_for(
        trait,
        ctx.std.io.stdout.is_tty,
        ctx.std.io.stderr.is_tty,
        extra = extra,
        curses = rc.bool_flag("--curses", command = command),
        color = rc.bool_flag("--color", command = command),
        show_progress = rc.bool_flag("--show_progress", command = command),
    )

    (announce_version, announce_command) = bazel_announce.resolve(ctx)

    # `dropped` names the endpoints Bazel uploads to itself, which
    # `collect_bes_sinks` has already left out, for the spawn-time disclosure.
    sinks = collect_bes_sinks(ctx, trait, rc, command)
    dropped = dropped_bes_backends(ctx, trait, rc, command)

    # Post-rc flag hooks: features (e.g. deployment auth) inject flags computed
    # from the resolved rc; appended to each spawn after rc expansion.
    rc_flags = bazel_rc.hook_flags(ctx, rc, command)

    patterns, pattern_flags = resolve_targets(ctx, rc, command)
    rc_flags.extend(pattern_flags)

    # The advertised build-result viewer; reaches the CI surfaces through the
    # results handle. Only Bazel's own BES module reads `--bes_results_url` (to
    # print "Streaming build results to: …" and key the link on its invocation
    # id), so the flag rides only that path — the CLI-streamed path announces
    # the URL itself. A value the user already set is never overridden.
    results_url = advertised_results_url(trait.bes_results_sources, rc, sinks, command)
    rc_flags.extend(bes_results_url_flag(trait.bes_results_sources, rc, command))

    max_attempts = retry_attempts(ctx)
    rc_flags.extend(bazel_flags.eviction_retries(ctx, rc, command, max_attempts))

    return _Invocation(
        ctx = ctx,
        command = command,
        trait = trait,
        rc = rc,
        patterns = patterns,
        sinks = sinks,
        dropped = dropped,
        rc_flags = rc_flags,
        results_url = results_url,
        bazel_streams_bes = bes_streamed_by_bazel(trait.bes_results_sources, rc, command),
        announce_version = announce_version,
        announce_command = announce_command,
        output_processor = processor,
        max_attempts = max_attempts,
        stdout = stdout if stdout != None else ctx.std.io.stdout,
    )

def _capture_flags(processor) -> list[str]:
    """The flags a capture asks for (`--isatty`, `--curses=yes`,
    `--color=yes`); spawn flags, so they follow the rc and win."""
    if not processor:
        return []
    return list(processor.flags)

def _do_start(inv: _Invocation) -> None:
    """`--cancel`. Once, before the loop; the spawn-time disclosures ride the first
    attempt instead (see `_do_spawn`)."""
    if hasattr(inv.ctx.args, "cancel") and inv.ctx.args.cancel:
        trace.event("build.cancel", fields = {"cancelling": True})
        inv.ctx.bazel.cancel_invocation().wait()

def _do_spawn(inv: _Invocation, index: int, extra_flags: list, aspects: list, events):
    """Spawn attempt `index` and RETURN a `_spawned` struct — the live handle is
    threaded via that return value, never stored on `inv`."""

    # Disclose what this bazel call was wired with, after the spawn phase line so
    # both land under the phase they describe: the `build_start` hooks (the
    # deployment's injected `--remote_cache` / `--remote_executor` announcement),
    # then the CLI-streamed BES backends and the ones skipped because Bazel
    # uploads to them itself. First attempt only — a retry reuses the same flags
    # and sinks, so re-announcing would imply new ones.
    if index == 0:
        for handler in inv.trait.build_start:
            handler(inv.ctx)
        announce_bes_sinks(inv.ctx, inv.sinks)
        announce_dropped_bes_sinks(inv.ctx, inv.dropped, inv.rc, inv.command)

    # One iterator per invocation, fanned out in AXL — an extra runtime iterator
    # would deep-clone the whole stream. `events`: False → none; True → all kinds;
    # a list → those kinds (send-side filtered). A trait build_event hook may want
    # any kind, so its presence forces all kinds. `output_frame` hooks need no
    # iterator: without one, `_do_wait` draws them until the console ends.
    framed = bool(inv.trait.output_frame) and inv.output_processor != None
    trait_wants = bool(inv.trait.build_event)
    if events == False and not trait_wants:
        iterator = None
    else:
        kinds = None if (trait_wants or events == True) else events
        iterator = build_events_iterator(kinds = kinds, tick_ms = _FRAME_TICK_MS if framed else _TICK_MS)

    # `[]` would ENABLE BES with no consumer (the runtime treats an empty list as
    # "stream on"); collapse to False so a local build with no sinks/iterator runs
    # with no BEP file at all.
    be = ([iterator] if iterator else []) + list(inv.sinks)
    build_events = be if be else False

    # Read the trait after `build_start`, which is a hook that may register an
    # `exec_log_event` subscription of its own, and freshly per attempt, since a
    # handle binds to exactly one build.
    xl = bazel_exec_log.open(inv.trait)

    if inv.command == "test":
        handle = inv.ctx.bazel.test(
            build_events = build_events,
            max_event_bytes = inv.trait.max_build_event_bytes,
            execution_log = xl.sinks or False,
            keep_action_logs = inv.trait.keep_action_logs,
            keep_test_logs = inv.trait.keep_test_logs,
            announce_version = inv.announce_version,
            announce_command = inv.announce_command,
            output = inv.output_processor,
            flags = inv.rc_flags + _capture_flags(inv.output_processor) + extra_flags,
            stdout = inv.stdout,
            *inv.patterns
        )
    else:
        handle = inv.ctx.bazel.build(
            build_events = build_events,
            max_event_bytes = inv.trait.max_build_event_bytes,
            execution_log = xl.sinks or False,
            keep_action_logs = inv.trait.keep_action_logs,
            keep_test_logs = inv.trait.keep_test_logs,
            announce_version = inv.announce_version,
            announce_command = inv.announce_command,
            output = inv.output_processor,
            flags = inv.rc_flags + _capture_flags(inv.output_processor) + extra_flags,
            aspects = aspects,
            stdout = inv.stdout,
            *inv.patterns
        )

    # Bazel prints "Streaming build results to: …" only when it uploads the BES
    # itself, so say it here for the sinks the CLI streams. First attempt only,
    # matching the other spawn-time disclosures above.
    if index == 0:
        announce_bes_results_url(inv.ctx, inv.results_url, handle.sink_invocation_id)

    # Whether the console has hooks to run while it is open: lines held for
    # the `output_intercept` hooks, or `output_frame` hooks.
    console = bool(inv.output_processor and (inv.output_processor.intercepts or framed))

    # The run's record in the task history keeps each attempt's page.
    if inv.results_url and handle.sink_invocation_id:
        inv.ctx.std.history.link(
            "Build Results" + (" (attempt %d)" % (index + 1) if index else ""),
            join_url(inv.results_url, handle.sink_invocation_id),
        )

    return struct(
        index = index,
        events = iterator if iterator else [],
        sink_invocation_id = handle.sink_invocation_id,
        on_event = lambda event: _do_on_event(inv, handle, xl, console, event),
        wait = lambda: _do_wait(inv, handle, xl, console),
    )

def _do_wait(inv: _Invocation, handle, xl: struct, console: bool):
    """Answer the console's remaining held lines (drawing `output_frame` frames
    meanwhile), drain the execution log, block on
    the attempt (whose `output_end` hooks emit the console's tips), flush BES
    sinks (rebinding a still-Live gRPC sink on the next spawn errors; wait()
    resets it to Idle), then fire `bazel_attempt_end` before the retry decision.

    Both drains precede the wait, and that order is load-bearing: a bound
    `exec_log_event` handle is a subscriber the log reader blocks for, and
    `handle.wait()` joins that reader. Waiting first would join a thread that is
    waiting on us. The console goes first of the two: the execution log's close
    blocks until the client exits, and a line held meanwhile would stall Bazel
    behind it."""
    if console:
        handle.run_output_hooks(until_ended = True)
    bazel_exec_log.close(inv.ctx, xl)
    status = handle.wait()
    for sink in inv.sinks:
        sink.wait()
    for handler in inv.trait.bazel_attempt_end:
        handler(inv.ctx, exit_code_of(status))
    return status

def _do_on_event(inv: _Invocation, handle, xl: struct, console: bool, event) -> None:
    """Dispatch one BES event to the trait's `build_event` hooks, and have the
    runtime run the `output_intercept` hooks on held console lines, the
    `output_frame` hooks when a frame is due, and the `exec_log_event` hooks on
    whatever the execution log has written so far.

    All three live here so a task's drain loop stays one call per event. The
    console and the log are pumped before the `event == None` early return,
    because a quiet BES tick says nothing about either: Bazel can be busy
    writing actions or console lines while the event stream has nothing to
    report.

    The `console` and `xl.entries` guards keep that free for a run with no
    hook — a field read, not a dispatch, on a path that runs once per BES
    event.
    """
    if console:
        handle.run_output_hooks()
    if xl.entries != None:
        bazel_exec_log.pump(inv.ctx, xl)
    if event == None:
        return
    for handler in inv.trait.build_event:
        handler(inv.ctx, event)

def _do_should_retry(inv: _Invocation, sp, w) -> bool:
    """Retry the attempt `sp` produced? Explicit at the callsite, never folded
    into wait(). The index is read straight off the spawned struct; the rest
    is `may_retry`'s."""
    return may_retry(inv.trait, w) and sp.index < inv.max_attempts - 1

def _do_finish(inv: _Invocation, w) -> None:
    """Conclude: summarize the BES upload, then fire `build_end` with the final
    exit code. Merges the old `summary()` + `end()` and owns the code coercion."""
    summarize_bes_upload(inv.ctx, inv.sinks)
    code = 0 if w.success else exit_code_of(w)
    for handler in inv.trait.build_end:
        handler(inv.ctx, code)

def _handle(ctx, command: str, stdout = None):
    """Build the immutable config, then a handle of thin forwarders over it."""
    inv = _resolve(ctx, command, stdout = stdout)
    return struct(
        rc = inv.rc,
        targets = inv.patterns,
        attempts = list(range(inv.max_attempts)),
        # Properties of the resolved flags, so they hold for every attempt and are
        # restored onto each retry's fresh results `data`.
        results_url = inv.results_url,
        bazel_streams_bes = inv.bazel_streams_bes,
        start = lambda: _do_start(inv),
        spawn = lambda index, extra_flags = [], aspects = [], events = False: _do_spawn(inv, index, extra_flags, aspects, events),
        should_retry = lambda sp, w: _do_should_retry(inv, sp, w),
        finish = lambda w: _do_finish(inv, w),
    )

def _build(ctx, stdout = None):
    """High-level `bazel build` invocation handle. See module docstring.

    `stdout` redirects Bazel's own stdout; the default inherits ours. Bazel
    writes its result summary and test output there — only progress goes to
    stderr — so a task whose stdout carries a machine payload must redirect it.
    """
    return _handle(ctx, "build", stdout = stdout)

def _test(ctx, stdout = None):
    """High-level `bazel test` invocation handle. See module docstring.

    `stdout` redirects Bazel's own stdout; see `_build()`."""
    return _handle(ctx, "test", stdout = stdout)

def _args(phrase: str) -> dict:
    """The command-agnostic CLI args every Bazel-spawning task registers (splat
    into `task(args)`): the flag/startup/announce args, the BES args, and the
    target-pattern-file / retry / cancel controls."""
    return bazel_flags.args(phrase) | bazel_announce.args(phrase) | bes_args() | _target_pattern_file_arg() | {
        "bazel_retry_attempts": args.int(
            default = DEFAULT_BAZEL_RETRY_ATTEMPTS,
            description = BAZEL_RETRY_ATTEMPTS_DESCRIPTION,
        ),
        "cancel": args.boolean(
            default = False,
            description = "Cancel any running Bazel invocation before starting.",
        ),
    }

def _target_pattern_file_arg() -> dict:
    """aspect's `--target-pattern-file` arg, read back by `resolve_targets`. Part
    of `bazel_invocation.args`; splat it alone into a task that declares its
    own Bazel args."""
    return {
        "target_pattern_file": args.string(
            default = "",
            description = "Read newline-separated target patterns from this file instead of the command line (mirrors Bazel's --target_pattern_file). Blank lines and `#` comments are ignored. Cannot be combined with command-line target patterns.",
        ),
    }

def _targets_arg(verb: str) -> dict:
    """The positional target-pattern arg, with command-specific help. Splat into
    a task's `args = {...}` alongside `bazel_invocation.args`."""
    return {
        "targets": args.positional(
            default = ["..."],
            minimum = 1,
            maximum = 512,
            description = "Bazel target patterns to %s. Defaults to '...' which expands to all rule targets in the package at and beneath the current directory. When any pattern is hyphen-led (e.g. excludes like `-//experimental/...`), separate them from flags with `--`: `aspect %s -- //... -//experimental/...`." % (verb, verb),
        ),
    }

bazel_invocation = namespace(
    build = _build,
    test = _test,
    args = _args,
    targets_arg = _targets_arg,
    target_pattern_file_arg = _target_pattern_file_arg,
)
