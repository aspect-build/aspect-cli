"""Tests for the `bazel_invocation.build(ctx)` invocation-handle seams.

Exercises the public dispatch helpers, which are the seam every
task that drives its own spawn loop calls after `build.wait()` /
`test.wait()` to fire
`bazel_trait.bazel_attempt_end` and `bazel_trait.build_end` hooks. The
helpers are short, but they're the contract every task depends on —
silent breakage here would skip every Workflows-feature recovery hook.

Also covers `target_patterns`, which decides whether the `targets` arg's
default reaches Bazel — get that wrong and a caller-forwarded
`--target_pattern_file` collides with an invented pattern, which Bazel
rejects outright — and `resolve_targets`, which turns a task's args into the
patterns and flags it spawns with.

Every section but the last is pure logic. The last one spawns a real Bazel,
because the thing it guards — an invocation that Bazel rejects outright —
only exists once there is a real process to reject it.

Run with:
  aspect dev test-bazel-invocation
"""

load("@aspect//bazel/flags.axl", "testonly_eviction_retry_flag")
load("@aspect//bazel/invocation.axl", "resolve_targets", "target_patterns")
load("@aspect//bazel.axl", "BazelTrait", "default_retry", "dispatch_bazel_attempt_end", "dispatch_bazel_build_end", "exit_code_of", "exit_codes", "may_retry", "server_error")

def _eq(label, got, want):
    if got != want:
        fail("%s: got %r, want %r" % (label, got, want))

def _record_into(recorder, key, name):
    """Build a hook callable that appends `(name, exit_code)` into
    `recorder[key]`. The name lets a test pin both order and per-hook
    invocation."""

    def _hook(_ctx, exit_code):
        recorder[key].append((name, exit_code))

    return _hook

def _trait(attempt_hooks = [], build_end_hooks = []) -> BazelTrait:
    """A real `BazelTrait` carrying only the two hook lists the
    dispatchers read; every other field takes its declared default."""
    return BazelTrait(
        bazel_attempt_end = attempt_hooks,
        build_end = build_end_hooks,
    )

def _test_attempt_dispatch_empty_is_noop(ctx: TaskContext) -> None:
    """No hooks registered → dispatcher must not error."""
    dispatch_bazel_attempt_end(ctx, _trait(), 0)

def _test_build_end_dispatch_empty_is_noop(ctx: TaskContext) -> None:
    """No hooks registered → dispatcher must not error."""
    dispatch_bazel_build_end(ctx, _trait(), 0)

def _test_attempt_dispatch_invokes_in_order(ctx: TaskContext) -> None:
    """Multiple attempt_end hooks fire in registration order, each
    receiving the exit_code passed to the dispatcher."""
    recorder = {"attempt": []}
    trait = _trait(attempt_hooks = [
        _record_into(recorder, "attempt", "first"),
        _record_into(recorder, "attempt", "second"),
        _record_into(recorder, "attempt", "third"),
    ])
    dispatch_bazel_attempt_end(ctx, trait, 37)
    _eq(
        "ordered invocation with exit_code passthrough",
        recorder["attempt"],
        [("first", 37), ("second", 37), ("third", 37)],
    )

def _test_build_end_dispatch_invokes_in_order(ctx: TaskContext) -> None:
    """Same contract as attempt_end."""
    recorder = {"build_end": []}
    trait = _trait(build_end_hooks = [
        _record_into(recorder, "build_end", "a"),
        _record_into(recorder, "build_end", "b"),
    ])
    dispatch_bazel_build_end(ctx, trait, 0)
    _eq(
        "ordered invocation with exit_code passthrough",
        recorder["build_end"],
        [("a", 0), ("b", 0)],
    )

def _test_attempt_dispatch_does_not_fire_build_end(ctx: TaskContext) -> None:
    """Dispatchers are separately addressable; calling attempt_end must
    not also fire the build_end list."""
    recorder = {"attempt": [], "build_end": []}
    trait = _trait(
        attempt_hooks = [_record_into(recorder, "attempt", "a")],
        build_end_hooks = [_record_into(recorder, "build_end", "b")],
    )
    dispatch_bazel_attempt_end(ctx, trait, 0)
    _eq("attempt fired", recorder["attempt"], [("a", 0)])
    _eq("build_end not fired", recorder["build_end"], [])

def _fake_rc(values = {}):
    """Stand-in for a `Bazelrc`: `target_patterns` calls only `flag_value`.
    Same shape as the fakes in `bazel_flags_test.axl` /
    `deployment_flags_test.axl`, keyed `{command: {flag: value}}` so a test can
    pin that the lookup is command-scoped. The real last-wins / `=`-form /
    two-token matching lives in `crates/bazelrc` and is tested there."""
    return struct(flag_value = lambda name, command: values.get(command, {}).get(name))

def _test_default_reaches_bazel_when_nothing_else_supplies_patterns(_):
    """No pattern file anywhere → the arg default is the target list."""
    _eq(
        "default pattern forwarded",
        target_patterns(False, ["..."], "", _fake_rc(), "build"),
        ["..."],
    )

def _test_forwarded_flag_suppresses_the_default(_):
    """`--bazel-flag=--target_pattern_file=…` with no positionals: Bazel must
    see the flag and no residue, or it fails the invocation outright."""
    rc = _fake_rc({"build": {"--target_pattern_file": "/tmp/p"}})
    _eq("default suppressed", target_patterns(False, ["..."], "", rc, "build"), [])

def _test_explicit_patterns_always_reach_bazel(_):
    """Explicit patterns alongside a forwarded pattern file are forwarded as-is
    so Bazel reports the conflict — the handle owns no second spelling of it."""
    rc = _fake_rc({"build": {"--target_pattern_file": "/tmp/p"}})
    _eq(
        "explicit patterns preserved",
        target_patterns(True, ["//foo:bar"], "", rc, "build"),
        ["//foo:bar"],
    )

def _test_aspect_own_flag_suppresses_the_default(_):
    """aspect's own `--target-pattern-file` is resolved before the rc exists, so
    it is passed in directly rather than read back off `rc`."""
    _eq(
        "default suppressed",
        target_patterns(False, ["..."], "/tmp/p", _fake_rc(), "build"),
        [],
    )

def _test_lookup_is_command_scoped(_):
    """A pattern file set for `build` must not suppress the default for a
    `test` run — `flag_value` is asked about the running subcommand."""
    rc = _fake_rc({"build": {"--target_pattern_file": "/tmp/p"}})
    _eq("test unaffected", target_patterns(False, ["..."], "", rc, "test"), ["..."])

def _test_no_rc_yet_keeps_the_default(_):
    """`rc = None` (a preview before the rc is parsed) reads only aspect's own flag."""
    _eq("default kept", target_patterns(False, ["..."], "", None, "build"), ["..."])
    _eq("own flag still counts", target_patterns(False, ["..."], "/tmp/p", None, "build"), [])

def _fake_ctx(targets = ["..."], explicit = False, pattern_file = None):
    """Stand-in for the `ctx` `resolve_targets` reads. `pattern_file = None`
    models a task that does not declare `target_pattern_file`; every named
    file exists."""
    fields = {"targets": targets, "is_explicit": lambda name: explicit and name == "targets"}
    if pattern_file != None:
        fields["target_pattern_file"] = pattern_file
    return struct(args = struct(**fields), std = struct(fs = struct(exists = lambda _path: True)))

def _test_resolve_targets_forwards_aspect_own_flag(_):
    """aspect's `--target-pattern-file` becomes Bazel's flag and drops the default."""
    _eq(
        "own flag",
        resolve_targets(_fake_ctx(pattern_file = "/tmp/p"), _fake_rc(), "build"),
        ([], ["--target_pattern_file=/tmp/p"]),
    )

def _test_resolve_targets_reads_the_forwarded_spelling(_):
    """Bazel's spelling arrives through the rc, so it adds no flag of its own."""
    rc = _fake_rc({"build": {"--target_pattern_file": "/tmp/p"}})
    _eq("forwarded", resolve_targets(_fake_ctx(pattern_file = ""), rc, "build"), ([], []))

def _test_resolve_targets_without_the_arg(_):
    """A task that does not declare `target_pattern_file` keeps its patterns."""
    _eq("no arg", resolve_targets(_fake_ctx(), _fake_rc(), "build"), (["..."], []))

def _test_resolve_targets_keeps_explicit_patterns(_):
    """Explicit patterns pass through beside the flag, for Bazel to reject."""
    _eq(
        "explicit",
        resolve_targets(_fake_ctx(targets = ["//a"], explicit = True, pattern_file = "/tmp/p"), _fake_rc(), "build"),
        (["//a"], ["--target_pattern_file=/tmp/p"]),
    )

def _test_rejected_command_line_does_not_hang(ctx: TaskContext) -> None:
    """Regression for aspect-build/aspect-cli#1400: a flag Bazel rejects makes
    it exit without ever creating the build event file, and the invocation has
    to surface that exit rather than wait for a file that can never appear.

    Requires `build_events`, since that is what gives the reader a file to wait
    for.
    A regression stalls this task until the CI job's own timeout — loud
    enough to spot, which is the point of running it here against a real
    Bazel rather than a fake."""
    events = bazel.build_events.iterator()
    build = ctx.bazel.build(
        "//crates/bazel:bazel",
        build_events = [events],
        flags = ["--definitely_not_a_flag"],
        stderr = None,
    )
    seen = 0
    for _ in events:
        seen += 1
    status = build.wait()
    if status.success:
        fail("expected Bazel to reject --definitely_not_a_flag")
    _eq("rejected command line yields no events", seen, 0)

def _test_exit_codes_and_retries_for_a_signal_ended_client(_):
    """A client a signal ended has no `code`: it stands for 128 + the signal,
    and is never retried, nor is a success or an interrupt, whatever the
    policy says; any other code is the policy's to decide."""
    status = lambda code = None, signal = None: struct(code = code, signal = signal)
    _eq("own code", exit_code_of(status(3)), 3)
    _eq("SIGKILL", exit_code_of(status(signal = 9)), 137)
    _eq("neither", exit_code_of(status()), 1)
    always = BazelTrait(build_retry = lambda code: True)
    never = BazelTrait(build_retry = lambda code: False)
    _eq("a signal kill", may_retry(always, status(signal = 9)), False)
    _eq("a success", may_retry(always, status(0)), False)
    _eq("an interrupt", may_retry(always, status(8)), False)
    _eq("the policy says yes", may_retry(always, status(37)), True)
    _eq("the policy says no", may_retry(never, status(37)), False)

def _test_a_cache_eviction_is_retried_and_is_no_server_error(_):
    for code, retried, server in [
        (exit_codes.BLAZE_INTERNAL_ERROR, True, True),
        (exit_codes.LOCAL_ENVIRONMENTAL_ERROR, True, True),
        (exit_codes.REMOTE_CACHE_EVICTED, True, False),
        (exit_codes.BUILD_FAILURE, False, False),
        (exit_codes.TESTS_FAILED, False, False),
    ]:
        _eq("default_retry(%d)" % code, default_retry(code), retried)
        _eq("server_error(%d)" % code, server_error(code), server)

def _test_eviction_retries_are_left_to_the_loop_that_retries_them(ctx: TaskContext) -> None:
    flag = "--experimental_remote_cache_eviction_retries"
    off = [flag + "=0"]
    every = BazelTrait()

    def flags(rc, attempts = 3, bazel_trait = every, command = "build"):
        return testonly_eviction_retry_flag(ctx, bazel_trait, rc, command, attempts)

    rc = ctx.bazel.new_rc(flags = [], version = "8.4.0")
    _eq("a loop that retries evictions", flags(rc), off)
    _eq("for test too", flags(rc, command = "test"), off)
    _eq("a version that cannot be told", flags(ctx.bazel.new_rc(flags = [])), off)
    _eq("one attempt leaves Bazel's retries on", flags(rc, attempts = 1), [])
    declines = BazelTrait(build_retry = lambda code: code != exit_codes.REMOTE_CACHE_EVICTED)
    _eq("a policy that declines evictions", flags(rc, bazel_trait = declines), [])
    _eq("before Bazel 7", flags(ctx.bazel.new_rc(flags = [], version = "6.5.0")), [])
    _eq("no rc", flags(None), [])
    mine = ctx.bazel.new_rc(flags = [flag + "=2"], version = "8.4.0")
    _eq("the rc's own setting is kept", flags(mine), [])

def _test_impl(ctx: TaskContext) -> int:
    _test_exit_codes_and_retries_for_a_signal_ended_client(ctx)
    _test_a_cache_eviction_is_retried_and_is_no_server_error(ctx)
    _test_eviction_retries_are_left_to_the_loop_that_retries_them(ctx)
    _test_attempt_dispatch_empty_is_noop(ctx)
    _test_build_end_dispatch_empty_is_noop(ctx)
    _test_attempt_dispatch_invokes_in_order(ctx)
    _test_build_end_dispatch_invokes_in_order(ctx)
    _test_attempt_dispatch_does_not_fire_build_end(ctx)
    _test_default_reaches_bazel_when_nothing_else_supplies_patterns(ctx)
    _test_forwarded_flag_suppresses_the_default(ctx)
    _test_explicit_patterns_always_reach_bazel(ctx)
    _test_aspect_own_flag_suppresses_the_default(ctx)
    _test_lookup_is_command_scoped(ctx)
    _test_no_rc_yet_keeps_the_default(ctx)
    _test_resolve_targets_forwards_aspect_own_flag(ctx)
    _test_resolve_targets_reads_the_forwarded_spelling(ctx)
    _test_resolve_targets_without_the_arg(ctx)
    _test_resolve_targets_keeps_explicit_patterns(ctx)

    # Spawns a real Bazel; keep it last so a stall cannot mask the pure
    # sections above.
    _test_rejected_command_line_does_not_hang(ctx)
    print("invocation_test.axl: OK (18 sections)")
    return 0

invocation_tests = task(
    summary = "Run the bazel invocation-handle AXL unit tests.",
    kind = "test-bazel-invocation",
    group = ["dev"],
    implementation = _test_impl,
    args = {},
)
