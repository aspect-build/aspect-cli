"""The `BazelTrait` interface, Bazel exit codes, the retry budget constants, and
the `dispatch_*` helpers that fire the trait's lifecycle hooks.

Exit codes correspond to Bazel's ExitCode.java:
https://github.com/bazelbuild/bazel/blob/master/src/main/java/com/google/devtools/build/lib/util/ExitCode.java

Loaded through the `@aspect//bazel.axl` facade, which re-exports everything here.
"""

exit_codes = struct(
    SUCCESS = 0,
    BUILD_FAILURE = 1,
    PARSING_FAILURE = 1,
    COMMAND_LINE_ERROR = 2,
    TESTS_FAILED = 3,
    PARTIAL_ANALYSIS_FAILURE = 3,
    NO_TESTS_FOUND = 4,
    RUN_FAILURE = 6,
    ANALYSIS_FAILURE = 7,
    INTERRUPTED = 8,
    LOCK_HELD_NOBLOCK_FOR_LOCK = 9,
    REMOTE_ENVIRONMENTAL_ERROR = 32,
    OOM_ERROR = 33,
    REMOTE_ERROR = 34,
    LOCAL_ENVIRONMENTAL_ERROR = 36,
    BLAZE_INTERNAL_ERROR = 37,
    TRANSIENT_BUILD_EVENT_SERVICE_UPLOAD_ERROR = 38,
    REMOTE_CACHE_EVICTED = 39,
    PERSISTENT_BUILD_EVENT_SERVICE_UPLOAD_ERROR = 45,
    EXTERNAL_DEPS_ERROR = 48,
)

# Default attempt budget for the build/test/delivery retry loops. Tasks
# that wire up `--bazel-retry-attempts` use this as their `args.int`
# default; the `bazel.build(ctx)` handle / `delivery.axl` retry loops also fall
# back to it when a task doesn't define the arg at all, so adding a new
# bazel-driving task doesn't silently inherit `range(0)` or fail at load
# time.
DEFAULT_BAZEL_RETRY_ATTEMPTS = 3

# Canonical help text for the `--bazel-retry-attempts` flag. Centralized so
# `build`, `test`, `delivery` (and any future bazel-driving task) can share
# one description and not drift over time.
BAZEL_RETRY_ATTEMPTS_DESCRIPTION = (
    "Maximum number of Bazel invocation attempts (including the first attempt) before giving up. " +
    "Only retried for exit codes the build_retry trait predicate accepts " +
    "(BLAZE_INTERNAL_ERROR (37) and LOCAL_ENVIRONMENTAL_ERROR (36) by default). " +
    "Set to 1 to disable retries."
)

# https://bazel.build/run/scripts#exit-codes
def default_retry(code: int) -> bool:
    """Returns True if the given exit code is retryable.

    Retryable codes are those indicating transient infrastructure failures
    where re-running the command may succeed:
      - BLAZE_INTERNAL_ERROR (37): Bazel server crash.
      - LOCAL_ENVIRONMENTAL_ERROR (36): Local env failure, often caused by
        a queued command failing because the server is crashing.
    """
    return code == exit_codes.BLAZE_INTERNAL_ERROR or code == exit_codes.LOCAL_ENVIRONMENTAL_ERROR

BazelTrait = trait(
    # Declarative data — composable, zero-cost reads
    # One field per Bazel command AXL can run (`engine/bazel/mod.rs` exposes
    # exactly build/test/query/info), each landing in that command's rc section,
    # plus `extra_flags` as the compatibility spelling of the `build` one.
    #
    # Four fields rather than one because Bazel's section inheritance is not
    # containment: `test` and `info` read the `build` section, yet each has
    # options `bazel build` rejects outright, and `query` reads no other command
    # section at all. There is no section meaning "build and test but not
    # query", so the only safe home for such a flag is its own command's
    # section. `bazel/flags.axl`'s module docstring holds the measured
    # acceptance matrix behind that claim — each of the four commands accepts
    # something the other three reject — and the precedence table for these
    # fields against base_flags and the user's own flags. Both live there rather
    # than here, so there is one copy to keep true.
    extra_flags = attr(list[str], default = [], description = "Additional Bazel flags appended to every build/test invocation. The compatibility spelling of extra_build_flags and the right default for most flags: same reach — Bazel's `build` rc section, which every build-like command inherits (test/run/coverage/info/cquery/aquery/fetch) and `query` does not — so a build-only option here cannot break a task's sidecar query. Two kinds of entry stay unscoped here and so keep reaching a query: a `--config=NAME` reference, which Bazel expands per command anyway, and a flag that configures the repository graph (`--repo_env`, `--registry`, `--repository_cache`, and the rest of `_UNSCOPED_INJECTED` in bazel/flags.axl), because the query that selects a task's targets must resolve external repos the way the build does. A flag `bazel build` itself rejects belongs in extra_test_flags / extra_query_flags / extra_info_flags instead; most test options (`--flaky_test_attempts`, `--test_tag_filters`, `--test_output`) are not in that class — `build` accepts them and ignores them. An entry that names its own section keeps it, here and in all three siblings — a `(flag, version, command)` tuple appended to the list, `command = \"always\"` for a flag that must reach `query` too"),
    extra_build_flags = attr(list[str], default = [], description = "Additional Bazel flags scoped to Bazel's `build` rc section: `build` and every command that inherits it (test/run/coverage/info/cquery/aquery/fetch), never `query`. Same reach as extra_flags, including its `--config` and repository-flag carve-outs; named for the scope rather than stating it in prose. Prefer this spelling when the three siblings are in play and extra_flags when adding to an existing list. Not a home for a flag `bazel build` rejects even though `test`/`info` accept it — inheritance is not containment, and such a flag needs its own command's field"),
    extra_test_flags = attr(list[str], default = [], description = "Additional Bazel flags scoped to Bazel's `test` rc section: `bazel test` only, not build/query/info — including a `--config=NAME` or a repository flag, which extra_flags leaves unscoped but which is confined here, naming a command being the point of this field. The home for a test option `bazel build` rejects, which no section reachable from extra_flags can be — `--test_verbose_timeout_warnings` is one (Bazel 9.0.1, the pinned version: accepted by `test`, `Unrecognized option` on both `build` and `info`), and it is exactly what Bazel's own \"tests whose specified size is too big\" advice tells you to set. Most test options need nothing but extra_flags"),
    extra_query_flags = attr(list[str], default = [], description = "Additional Bazel flags scoped to Bazel's `query` rc section: `bazel query` only, including the sidecar queries tasks run to resolve targets. The only way to inject a query-only option through this trait — `query` inherits no command section, so nothing in extra_flags or extra_build_flags reaches it beyond the deliberately unscoped `--config` references and repository flags. A `--config=NAME` here is scoped with the rest of the field, so it applies to a query and not to the build"),
    extra_info_flags = attr(list[str], default = [], description = "Additional Bazel flags scoped to Bazel's `info` rc section: the `ctx.bazel.info` probes (e.g. `aspect test --coverage` reading output_path). `info` also reads the `build` section, so a build option reaches it through extra_flags — but it is not limited to build options: `--show_make_env` is accepted by `info` and rejected by `bazel build` (Bazel 9.0.1), so this field is its only home"),
    extra_startup_flags = attr(list[str], default = [], description = "Additional Bazel startup flags prepended before the command"),
    build_event_sinks = attr(list[bazel.build.BuildEventSink], default = [], description = "Build Event Protocol sinks to stream events to during the build"),
    execution_log_sinks = attr(list[bazel.execution_log.ExecLogSink], default = [], description = "Execution log sinks to receive the Bazel execution log after the build"),

    # Optional transforms — only called when set
    flags = attr(typing.Callable[[list], list] | None, default = None, description = "Transform function called with the full command-flag list; return value replaces the list. Entries arrive as their producer spelled them: a plain string for a plain extra_*_flags entry or a user-typed flag, or the `(flag, version_condition)` / `(flag, version_condition, command)` tuple a producer that version-gated or scoped its own entry appended. Scoping to an rc section runs AFTER this transform, so the triples it mints never arrive here and matching on flag text works on every plain entry; use flag_text / flag_name from lib/aspect_flags.axl to be indifferent to the shape. A flag the transform adds is left unscoped, like a user-typed one — and so is one it RE-SPELLS, because sections are restored by exact entry match: version-gating a plain entry into a `(flag, version)` pair, or splitting a `--flag=value` into two tokens, drops its section and lets it reach `query`. Return such an entry unchanged, or mint the `(flag, version, command)` triple yourself. A transform that de-duplicates the same text held by two per-command fields collapses it into the earlier field's section; see `_apply_plan` in bazel/flags.axl"),
    startup_flags = attr(typing.Callable[[list[str]], list[str]] | None, default = None, description = "Transform function called with the full startup flag list; return value replaces the list. Startup options take no rc command section, so these are always plain strings"),
    base_flags = attr(list[str], default = [], description = "Default Bazel flags prepended before the user's --bazel-flag overrides (user overrides win, unlike the extra_*_flags fields, which land in a command section and so outrank an unscoped typed flag). Unscoped like the user's own flags, so they reach `query` too"),
    injected_flag_filters = attr(list[typing.Callable[[list], list]], default = [], description = "The user's flag policy for a task's Bazel call: filters applied to every flag features inject (base_flags, extra_flags, extra_build_flags, extra_test_flags, extra_query_flags, extra_info_flags, extra_startup_flags, task_flags results) and never to the user's own flags. Called once per non-empty field and never for an empty one, before that field's flags are scoped, so a filter sees a flag as the feature spelled it rather than as a (flag, version, command) tuple, and a filter that adds a flag adds it once rather than once per field. Meant to drop flags, not add them. The BazelFlags feature registers --bazel-flags:omit here; Workflows and Deployment inject, the spawn path filters"),
    bes_backends = attr(list[str], default = [], description = "Extra CLI-streamed BES backend URIs to stream build events to"),
    bes_results_sources = attr(list[(str, str)], default = [], description = "(BES backend, results viewer URL) pairs the invocation's build-result link is drawn from; matched against everywhere the build reports BES, first hit wins"),

    # Task-time flag contributors — hooks that receive TaskContext and return
    # additional flags to append to the invocation. Fires late enough in the
    # task lifecycle (after the task is known but before Bazel is spawned) that
    # features can inject ctx.task-dependent flags (e.g. --build_metadata=
    # ASPECT_TASK_NAME=...). Invoked by the `bazel.build(ctx)` handle for
    # build/test and by each task's impl for lint/delivery.
    task_flags = attr(list[typing.Callable[[TaskContext], list[str]]], default = [], description = "Hooks returning additional flags; called with TaskContext at invocation time. Scoped to the `build` rc section like extra_flags, with the same per-entry opt-out: a hook that needs another section returns a `(flag, version, command)` tuple for that flag. That is strictly more expressive than a field would be — a hook can pick the section per flag and at task time — so there are deliberately no build_task_flags/test_task_flags siblings"),

    # For flags that depend on the resolved rc rather than the CLI args. `rc` is
    # the builtin RunCommand (unmodelable here), so it's typed loosely.
    rc_flags = attr(list[typing.Callable[[TaskContext, typing.Any, str], list[str]]], default = [], description = "Hooks called with (ctx, resolved rc, command) after rc parse; return flags appended to each spawn"),

    # Lifecycle hooks — lists of callables; callers close over their own state
    build_start = attr(list[typing.Callable[[TaskContext], None]], default = [], description = "Hooks called once before the Bazel invocation starts"),
    build_event = attr(list[typing.Callable[[TaskContext, dict], None]], default = [], description = "Hooks called for each Build Event Protocol event received during the build"),
    build_retry = attr(typing.Callable[[int], bool], default = default_retry, description = "Predicate called with the exit code; return True to retry the build"),
    bazel_attempt_end = attr(list[typing.Callable[[TaskContext, int], None]], default = [], description = "Hooks called once after EACH Bazel invocation attempt (including retries), with that attempt's exit code. Runs after the wait() returns and before the retry decision, so a hook can take corrective action (e.g. clean stranded sandbox state) that might let the next retry succeed. Distinct from `build_end`, which fires once after the final attempt."),
    build_end = attr(list[typing.Callable[[TaskContext, int], None]], default = [], description = "Hooks called once after the Bazel invocation completes (after all retries), with the final exit code"),
)

def dispatch_bazel_attempt_end(ctx: TaskContext, bazel_trait: BazelTrait, exit_code: int) -> None:
    """Fire every `bazel_attempt_end` hook with `exit_code`."""
    for handler in bazel_trait.bazel_attempt_end:
        handler(ctx, exit_code)

def dispatch_bazel_build_end(ctx: TaskContext, bazel_trait: BazelTrait, exit_code: int) -> None:
    """Fire every `build_end` hook with `exit_code`."""
    for handler in bazel_trait.build_end:
        handler(ctx, exit_code)
