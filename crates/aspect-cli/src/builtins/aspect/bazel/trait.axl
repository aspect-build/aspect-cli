"""The `BazelTrait` interface, the `ExecLogHook` subscription record, Bazel exit
codes, the retry policy (budget and retryable codes), and the `dispatch_*`
helpers that fire the trait's lifecycle hooks.

The `exec_log_event` hooks are driven from `./exec_log.axl` rather than by a
`dispatch_*` helper here: unlike `build_end`, they need a handle created before
the spawn and drained before `wait()`, which is a lifecycle rather than a single
call.

Exit codes correspond to Bazel's ExitCode.java:
https://github.com/bazelbuild/bazel/blob/master/src/main/java/com/google/devtools/build/lib/util/ExitCode.java

Loaded through the `@aspect//bazel.axl` facade, which re-exports everything here.
"""

load("../private/lib/exit_status.axl", _exit_code_of = "exit_code_of")

exit_codes = struct(
    SUCCESS = 0,
    BUILD_FAILURE = 1,
    PARSING_FAILURE = 1,
    COMMAND_LINE_ERROR = 2,
    TESTS_FAILED = 3,
    PARTIAL_ANALYSIS_FAILURE = 3,
    NO_TESTS_FOUND = 4,
    RUN_FAILURE = 6,
    ANALYSIS_FAILURE = 7,
    INTERRUPTED = 8,
    LOCK_HELD_NOBLOCK_FOR_LOCK = 9,
    REMOTE_ENVIRONMENTAL_ERROR = 32,
    OOM_ERROR = 33,
    REMOTE_ERROR = 34,
    LOCAL_ENVIRONMENTAL_ERROR = 36,
    BLAZE_INTERNAL_ERROR = 37,
    TRANSIENT_BUILD_EVENT_SERVICE_UPLOAD_ERROR = 38,
    REMOTE_CACHE_EVICTED = 39,
    PERSISTENT_BUILD_EVENT_SERVICE_UPLOAD_ERROR = 45,
    EXTERNAL_DEPS_ERROR = 48,
)

# Default attempt budget for the build/test/delivery retry loops: the
# `--bazel-retry-attempts` default, and `retry_attempts`' for a task without
# the arg.
DEFAULT_BAZEL_RETRY_ATTEMPTS = 3

# Canonical help text for the `--bazel-retry-attempts` flag. Centralized so
# `build`, `test`, `delivery` (and any future bazel-driving task) can share
# one description and not drift over time.
BAZEL_RETRY_ATTEMPTS_DESCRIPTION = (
    "Maximum number of Bazel invocation attempts (including the first attempt) before giving up. " +
    "Only retried for exit codes the build_retry trait predicate accepts " +
    "(BLAZE_INTERNAL_ERROR (37), LOCAL_ENVIRONMENTAL_ERROR (36) and REMOTE_CACHE_EVICTED (39) by default; " +
    "on Bazel 8+ the build's own eviction retries are then off, unless your flags set them). " +
    "Set to 1 to disable retries."
)

def retry_attempts(ctx: TaskContext) -> int:
    """The task's attempt budget: its `--bazel-retry-attempts`, or
    `DEFAULT_BAZEL_RETRY_ATTEMPTS` for a task that declares none, and at least
    one so Bazel always runs."""
    requested = ctx.args.bazel_retry_attempts if hasattr(ctx.args, "bazel_retry_attempts") else DEFAULT_BAZEL_RETRY_ATTEMPTS
    return max(1, requested)

# https://bazel.build/run/scripts#exit-codes
def server_error(code: int) -> bool:
    """Whether `code` says the Bazel server itself is in trouble:
      - BLAZE_INTERNAL_ERROR (37): Bazel server crash.
      - LOCAL_ENVIRONMENTAL_ERROR (36): Local env failure, often caused by
        a queued command failing because the server is crashing.
    """
    return code == exit_codes.BLAZE_INTERNAL_ERROR or code == exit_codes.LOCAL_ENVIRONMENTAL_ERROR

def default_retry(code: int) -> bool:
    """Returns True if the given exit code is retryable: a `server_error`, or
    REMOTE_CACHE_EVICTED (39), whose next invocation runs again the actions
    whose outputs the remote cache lost (see `bazel_flags.eviction_retries`)."""
    return server_error(code) or code == exit_codes.REMOTE_CACHE_EVICTED

# One `exec_log_event` subscription: the callback, plus the entry kinds it wants.
#
# `kinds` is not a convenience. A compact execution log carries one entry per
# spawn *plus* one per file, directory, input set and runfiles tree, so a medium
# build produces tens of thousands of entries where only a few hundred are
# spawns. Naming the kinds lets the runtime drop the rest before they ever
# become Starlark values (`bazel.execution_log.iterator(kinds = ...)`), which is
# the difference between a dispatch that costs nothing and one that adds seconds
# to the end of every build. `[]` means every kind, and is only the right answer
# for a hook that genuinely reads all of them.
#
# `on_entry` receives `(ctx, entry)` where `entry` is a
# `bazel.build.execution_log.ExecLogEntry`: `entry.id` plus `entry.type`, the
# payload, whose AXL type name (`type(entry.type)`) is the kind. A raw entry
# refers to other entries by id — a spawn names `input_set_id`, not paths — so
# `@aspect//private/lib/execlog.axl` carries the resolver that turns those ids
# back into paths and digests.
#
# `entry.id` is not an identifier for every entry. Bazel numbers only the
# entries something else refers to by id, so a `spawn` arrives with `id = 0` —
# every spawn in the log does. A hook that needs to name or deduplicate a spawn
# uses the resolver's `spawn_key(spawn)`, which is its primary output path.
#
# ## Which invocation is this?
#
# One task can drive Bazel several times — `aspect delivery` does it three
# times, a retried `build` up to three — and an entry says nothing about the
# invocation it came from. The hook's `TaskContext` does:
#
#     def _on_entry(ctx, entry):
#         phase = ctx.task.current_phase()
#         where = phase.name if phase else ""
#
# A task that opens a phase opens it before it spawns Bazel, so the phase is set
# by the time any entry reaches a hook — hence the guard above rather than a bare
# `.name`, because `cache diff` opens none and hands a hook `None`.
# `tests/exec_log_event.rs` asserts the name a hook read at every call site in
# the tree, which is the only place a live task can prove it. The names a hook
# sees today: `build` (`build`, `format`, `gazelle`, `run`, delivery phase 1),
# `test`, `lint`, `populate` (`ci warming`), `deliver` (delivery phase 3), and
# nothing at all under `cache diff`. A `run --watch` rebuild opens `rebuild_<n>`,
# and a retry opens a phase of its own, so attempt n>0 reads
# `build_retry_<n+1>` / `test_retry_<n+1>` — rebuilds and retries are
# distinguishable too. `ctx.task.name` is the other half of the answer, for a
# hook that more than one task registered.
#
# What a phase name does *not* distinguish is two invocations under one phase.
# Nothing in the built-in tree does that today, but a task that spawned Bazel
# twice without a phase transition would hand a hook the same name both times,
# and `build.sink_invocation_id` cannot stand in — it is None unless a gRPC BES
# sink exists. Closing that would mean a new accessor on the entry or the
# context, not a change to `on_entry`, so a hook written against the phase name
# keeps working either way.
ExecLogHook = record(
    on_entry = field(typing.Callable[[TaskContext, typing.Any], None]),
    kinds = field(list[str], default = []),
)

# Fired by every built-in task that drives Bazel: build, test, run, lint,
# format, gazelle, ci warming, delivery and cache diff. The runtime calls the
# `output_*` hooks itself for every `ctx.bazel.build`/`test` of any task.
BazelTrait = trait(
    # Declarative data — composable, zero-cost reads
    # One field per Bazel command AXL can run (`engine/bazel/mod.rs` exposes
    # exactly build/test/query/info), each landing in that command's rc section,
    # plus `extra_flags` as the compatibility spelling of the `build` one.
    #
    # Four fields rather than one because Bazel's section inheritance is not
    # containment: `test` and `info` read the `build` section, yet each has
    # options `bazel build` rejects outright, and `query` reads no other command
    # section at all. There is no section meaning "build and test but not
    # query", so the only safe home for such a flag is its own command's
    # section. `bazel/flags.axl`'s module docstring holds the measured
    # acceptance matrix behind that claim — each of the four commands accepts
    # something the other three reject — and the precedence table for these
    # fields against base_flags and the user's own flags. Both live there rather
    # than here, so there is one copy to keep true.
    extra_flags = attr(list[str], default = [], description = "Additional Bazel flags appended to every build/test invocation. The compatibility spelling of extra_build_flags and the right default for most flags: same reach — Bazel's `build` rc section, which every build-like command inherits (test/run/coverage/info/cquery/aquery/fetch) and `query` does not — so a build-only option here cannot break a task's sidecar query. Two kinds of entry stay unscoped here and so keep reaching a query: a `--config=NAME` reference, which Bazel expands per command anyway, and a flag that configures the repository graph (`--repo_env`, `--registry`, `--repository_cache`, and the rest of `_UNSCOPED_INJECTED` in bazel/flags.axl), because the query that selects a task's targets must resolve external repos the way the build does. A flag `bazel build` itself rejects belongs in extra_test_flags / extra_query_flags / extra_info_flags instead; most test options (`--flaky_test_attempts`, `--test_tag_filters`, `--test_output`) are not in that class — `build` accepts them and ignores them. An entry that names its own section keeps it, here and in all three siblings — a `(flag, version, command)` tuple appended to the list, `command = \"always\"` for a flag that must reach `query` too"),
    extra_build_flags = attr(list[str], default = [], description = "Additional Bazel flags scoped to Bazel's `build` rc section: `build` and every command that inherits it (test/run/coverage/info/cquery/aquery/fetch), never `query`. Same reach as extra_flags, including its `--config` and repository-flag carve-outs; named for the scope rather than stating it in prose. Prefer this spelling when the three siblings are in play and extra_flags when adding to an existing list. Not a home for a flag `bazel build` rejects even though `test`/`info` accept it — inheritance is not containment, and such a flag needs its own command's field"),
    extra_test_flags = attr(list[str], default = [], description = "Additional Bazel flags scoped to Bazel's `test` rc section: `bazel test` and the commands that inherit it (coverage, cquery), not build/query/info — including a `--config=NAME` or a repository flag, which extra_flags leaves unscoped but which is confined here, naming a command being the point of this field. The home for a test option `bazel build` rejects, which no section reachable from extra_flags can be — `--test_verbose_timeout_warnings` is one (Bazel 9.0.1, the pinned version: accepted by `test`, `Unrecognized option` on both `build` and `info`), and it is exactly what Bazel's own \"tests whose specified size is too big\" advice tells you to set. Most test options need nothing but extra_flags"),
    extra_query_flags = attr(list[str], default = [], description = "Additional Bazel flags scoped to Bazel's `query` rc section: `bazel query` only, including the sidecar queries tasks run to resolve targets. The only way to inject a query-only option through this trait — `query` inherits no command section, so nothing in extra_flags or extra_build_flags reaches it beyond the deliberately unscoped `--config` references and repository flags. A `--config=NAME` here is scoped with the rest of the field, so it applies to a query and not to the build"),
    extra_info_flags = attr(list[str], default = [], description = "Additional Bazel flags scoped to Bazel's `info` rc section: the `ctx.bazel.info` probes (e.g. `aspect test --coverage` reading output_path). `info` also reads the `build` section, so a build option reaches it through extra_flags — but it is not limited to build options: `--show_make_env` is accepted by `info` and rejected by `bazel build` (Bazel 9.0.1), so this field is its only home"),
    extra_startup_flags = attr(list[str], default = [], description = "Additional Bazel startup flags prepended before the command"),
    build_event_sinks = attr(list[bazel.build.BuildEventSink], default = [], description = "Build Event Protocol sinks to stream events to during the build"),
    keep_action_logs = attr(str, default = "none", description = "Which actions' stdout and stderr each build of `aspect build` and `aspect test` keeps in the task invocation's history (`bazel/<n>/actions/`, listed in `bazel/<n>/actions.json`): `none`, `failed` or `all`. `all` has Bazel report every action to the task alone, as `publish_all_actions` in `private/lib/aspect_flags.axl` does. See `ctx.bazel.build`'s `keep_action_logs`"),
    keep_test_logs = attr(str, default = "none", description = "Which test logs each build of `aspect build` and `aspect test` keeps in the task invocation's history (`bazel/<n>/testlogs/`, listed in `bazel/<n>/testlogs.json`): `none`, `failed`, `executed` or `all`. See `ctx.bazel.build`'s `keep_test_logs`"),
    execution_log_sinks = attr(list[bazel.execution_log.ExecLogSink], default = [], description = "Execution log sinks to receive the Bazel execution log after the build"),
    output_stages = attr(list[bazel.output.OutputStage], default = [], description = "`bazel.output.<stage>(...)` values every `ctx.bazel.build`/`ctx.bazel.test` of the task processes Bazel's console with, unless the call passes its own `output =`, whose stages it uses instead, or redirects its stdout or stderr (`stdout`, `stderr` or `stdio`), which turns processing off for that call: Bazel's output goes where the call sent it, with no flags added. Otherwise its stderr is captured, run through them and forwarded to the task's stderr (and its stdout too, in Bazel's order), with the capture's `--isatty`, `--curses=yes`, `--color=yes` and `--show_progress` after the call's and rc's flags; what is shown follows the user's own `--curses`, `--color` and `--show_progress` (Bazel's colour is how the stages tell its messages from tool output). Stages run in a fixed order of kinds, so features may append in any order. The `Console` feature appends the defaults; empty leaves stderr inherited. Lines an `intercept` stage holds are answered by the `output_intercept` hooks. Read when each build starts, so set them from a feature's implementation or config"),

    # Optional transforms — only called when set
    flags = attr(typing.Callable[[list], list] | None, default = None, description = "Transform function called with the full command-flag list; return value replaces the list. Entries arrive as their producer spelled them: a plain string for a plain extra_*_flags entry or a user-typed flag, or the `(flag, version_condition)` / `(flag, version_condition, command)` tuple a producer that version-gated or scoped its own entry appended. Scoping to an rc section runs AFTER this transform, so the triples it mints never arrive here and matching on flag text works on every plain entry; use flag_text / flag_name from lib/aspect_flags.axl to be indifferent to the shape. A flag the transform adds is left unscoped, like a user-typed one — and so is one it RE-SPELLS, because sections are restored by exact entry match: version-gating a plain entry into a `(flag, version)` pair, or splitting a `--flag=value` into two tokens, drops its section and lets it reach `query`. Return such an entry unchanged, or mint the `(flag, version, command)` triple yourself. A transform that de-duplicates the same text held by two per-command fields collapses it into the earlier field's section; see `_apply_plan` in bazel/flags.axl"),
    startup_flags = attr(typing.Callable[[list[str]], list[str]] | None, default = None, description = "Transform function called with the full startup flag list; return value replaces the list. Startup options take no rc command section, so these are always plain strings"),
    base_flags = attr(list[str], default = [], description = "Default Bazel flags prepended before the user's --bazel-flag overrides (user overrides win, unlike the extra_*_flags fields, which land in a command section and so outrank an unscoped typed flag). Unscoped like the user's own flags, so they reach `query` too"),
    injected_flag_filters = attr(list[typing.Callable[[list], list]], default = [], description = "The user's flag policy for a task's Bazel call: filters applied to every flag features inject (base_flags, extra_flags, extra_build_flags, extra_test_flags, extra_query_flags, extra_info_flags, extra_startup_flags, task_flags results) and never to the user's own flags. Called once per non-empty field and never for an empty one, before that field's flags are scoped, so a filter sees a flag as the feature spelled it rather than as a (flag, version, command) tuple, and a filter that adds a flag adds it once rather than once per field. Meant to drop flags, not add them. The BazelFlags feature registers --bazel-flags:omit here; Workflows and Deployment inject, the spawn path filters"),
    bes_backends = attr(list[str], default = [], description = "Extra CLI-streamed BES backend URIs to stream build events to"),
    bes_runner_backends = attr(list[str], default = [], description = "BES backend URIs the CLI streams to as given, without the task's --bes-header or the Aspect login: a Workflows runner's own. One whose endpoint is also a --bes-backend or on bes_backends streams once, through that sink"),
    bes_results_sources = attr(list[(str, str)], default = [], description = "(BES backend, results viewer URL) pairs the invocation's build-result link is drawn from; matched against everywhere the build reports BES, first hit wins"),

    # Task-time flag contributors — hooks that receive TaskContext and return
    # additional flags to append to the invocation. Fires late enough in the
    # task lifecycle (after the task is known but before Bazel is spawned) that
    # features can inject ctx.task-dependent flags (e.g. --build_metadata=
    # ASPECT_TASK_NAME=...). Invoked by the `bazel_invocation.build(ctx)` handle for
    # build/test and by each task's impl for lint/delivery.
    task_flags = attr(list[typing.Callable[[TaskContext], list[str]]], default = [], description = "Hooks returning additional flags; called with TaskContext at invocation time. Scoped to the `build` rc section like extra_flags, with the same per-entry opt-out: a hook that needs another section returns a `(flag, version, command)` tuple for that flag. That is strictly more expressive than a field would be — a hook can pick the section per flag and at task time — so there are deliberately no build_task_flags/test_task_flags siblings"),

    # For flags that depend on the resolved rc rather than the CLI args. `rc` is
    # the builtin Bazelrc (unmodelable here), so it's typed loosely.
    rc_flags = attr(list[typing.Callable[[TaskContext, typing.Any, str], list[str]]], default = [], description = "Hooks called with (ctx, resolved rc, command) after rc parse; return flags appended to each spawn"),

    # Lifecycle hooks — lists of callables; callers close over their own state
    build_start = attr(list[typing.Callable[[TaskContext], None]], default = [], description = "Hooks called once before the Bazel invocation starts"),
    build_event = attr(list[typing.Callable[[TaskContext, dict], None]], default = [], description = "Hooks called for each Build Event Protocol event received during the build. A task may drive Bazel several times, and an event names no invocation; read `ctx.task.current_phase().name` to tell them apart (`build`, `deliver`, `build_retry_2`, ...) and `ctx.task.name` for the task"),
    output_display = attr(str, default = "auto", description = "What is shown of the console `output_stages` process: `curses`, Bazel's curses UI as it drew it; `lines`, plain lines rendered from it; `none`, nothing, for a feature that draws the screen itself from `build.output_feed()` in an `output_frame` hook (Bazel's stdout, when it shares stderr's terminal, goes only to the feed too; a stdout of its own is still shown); or `auto` (the default), `curses` exactly when the task's stdout and stderr are both terminals. The user's own `--curses` wins over all but `none`, and their `--noshow_progress` over that: plain lines, without the status line. Bazel is captured with curses either way. The `Console` feature's agent profile sets `lines`"),
    output_progress = attr(bool, default = True, description = "Whether plain lines rendered from the console show Bazel's status line (`[n / m] …`) every few seconds. The `Console` feature's agent profile sets False"),
    output_intercept = attr(list[typing.Callable[[TaskContext, bazel.output.InterceptedLine], None]], default = [], description = "Hooks called for each console line an `intercept` stage holds, with the `InterceptedLine` (`id`, `line`). The line is not shown, and Bazel's console waits behind it, until it is answered: a hook answers with `line.keep()`, `line.replace(text)` or `line.drop()`. Hooks run in registration order until one answers; a line none answers is kept. The runtime calls them from `build.run_output_hooks()` (the build/test handles call it for every build event) and, for the rest of the console, inside `build.wait()`. Keep them quick: a line still unanswered after its stage's `timeout_ms` is shown unchanged"),
    output_frame = attr(list[typing.Callable[[TaskContext, typing.Any], None]], default = [], description = "Hooks called with the build about every 100ms while its captured console is open, and once more when it ends, before the `output_end` hooks: for a feature drawing its own screen, with `output_display = \"none\"`, from `build.output_feed()`. The runtime calls them from `build.run_output_hooks()` (the build/test handles call it for every build event and on each quiet tick) and inside `build.wait()`; a task that drains a build's events itself without calling `run_output_hooks()` gets no frames until its `wait()`. Keep them quick: they run on the task's thread, between its build events"),
    output_end = attr(list[typing.Callable[[TaskContext, typing.Any], None]], default = [], description = "Hooks called with the build once its captured console has ended, inside `build.wait()`: read `build.output_matches()`, `build.output_aggregates()`, `build.output_fatal` or `build.output_log` there. The `Console` feature emits the tips of its tip rules from one"),
    output_start = attr(list[typing.Callable[[TaskContext], list]], default = [], description = "Hooks returning more `bazel.output` stages, called when a console processor is made from the trait: once per task by the build/test handles (their retries reuse it), and at each other `ctx.bazel.build`/`test` that passes no `output =` and redirects neither stdout nor stderr. For stages built from settings that may still change once a feature's implementation has run, such as the tip rules the `Console` feature matches"),
    exec_log_event = attr(list[ExecLogHook], default = [], description = "Hooks called for each compact execution log entry Bazel writes during the build. Each is an `ExecLogHook(on_entry = fn, kinds = [...])`; the union of every hook's `kinds` is filtered in Rust before dispatch, so name them. A hook sees every entry of the kinds it asked for, never a sample: the execution log's producer blocks for its subscribers rather than dropping what one fell behind on"),
    build_retry = attr(typing.Callable[[int], bool], default = default_retry, description = "Predicate called with the exit code; return True to retry the build. It is also asked about REMOTE_CACHE_EVICTED (39) once before the first attempt: while it accepts that, as `default_retry` does, and the budget allows a retry, `bazel_invocation` handles (the build and test tasks) and delivery's first phase turn off Bazel 8+'s own eviction retries (unless the flags set them), so this predicate decides the retry, not Bazel"),
    bazel_attempt_end = attr(list[typing.Callable[[TaskContext, int], None]], default = [], description = "Hooks called once after EACH Bazel invocation attempt (including retries), with that attempt's exit code (128 + the signal when a signal ended the client, which is never retried). Runs after the wait() returns and before the retry decision, so a hook can take corrective action (e.g. clean stranded sandbox state) that might let the next retry succeed. Distinct from `build_end`, which fires once after the final attempt."),
    build_end = attr(list[typing.Callable[[TaskContext, int], None]], default = [], description = "Hooks called once after the Bazel invocation completes (after all retries), with the final exit code (128 + the signal when a signal ended the client; see `exit_code_of`)"),
)

# `exit_code_of(status)`: a Bazel client's code, or 128 + the signal that
# ended it; hooks typed `exit_code: int` take it. See `exit_status.axl`.
exit_code_of = _exit_code_of

def may_retry(bazel_trait: BazelTrait, status) -> bool:
    """Whether `bazel_trait.build_retry` may be asked to retry the attempt
    that ended with `status`, and what it says. Never one that succeeded,
    one Bazel interrupted (a cancel), or a client a signal ended: nothing a
    retry fixes, and the policy takes an exit code."""
    code = status.code
    if code == None or code == exit_codes.SUCCESS or code == exit_codes.INTERRUPTED:
        return False
    return bazel_trait.build_retry(code)

def dispatch_bazel_attempt_end(ctx: TaskContext, bazel_trait: BazelTrait, exit_code: int) -> None:
    """Fire every `bazel_attempt_end` hook with `exit_code`."""
    for handler in bazel_trait.bazel_attempt_end:
        handler(ctx, exit_code)

def dispatch_bazel_build_end(ctx: TaskContext, bazel_trait: BazelTrait, exit_code: int) -> None:
    """Fire every `build_end` hook with `exit_code`."""
    for handler in bazel_trait.build_end:
        handler(ctx, exit_code)
