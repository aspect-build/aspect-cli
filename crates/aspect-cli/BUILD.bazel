    "@crates//:tracing-subscriber",
    "@crates//:uuid",
]

PROC_MACRO_DEPS = ["@crates//:async-trait"]

SRCS = glob(["src/**/*.rs"])

COMPILE_DATA = glob([
    "src/builtins/**/*.axl",
    "src/builtins/**/*.aspect",
])

rust_binary(
    name = "aspect-cli",
    srcs = SRCS,
    compile_data = COMPILE_DATA,
    proc_macro_deps = PROC_MACRO_DEPS,
    version_key = "STABLE_MONOREPO_VERSION",
    visibility = [
        "//:__pkg__",
        "//examples/deliverable:__pkg__",
    ],
    deps = DEPS,
)

rust_test(
    name = "test",
    compile_data = glob([
        "src/builtins/**/*.axl",
        "src/builtins/**/*.aspect",
        # `print_macro_guard` embeds the crate's own sources.
        "src/**/*.rs",
    ]),
    crate = ":aspect-cli",
    deps = [
        "@crates//:tempfile",
    ],
)

# Integration tests spawn the built CLI. `rust_test(crate = ...)` covers only
# unit tests inside `src/`, so without a target per file nothing under `tests/`
# runs in CI, which has no `cargo test` step. Each resolves the binary through
# `ASPECT_CLI_BIN` (with a `CARGO_BIN_EXE_…` fallback for cargo) via the shared
# `tests/common/mod.rs`.
INTEGRATION_TEST_COMMON_SRCS = ["tests/common/mod.rs"]

rust_test(
    name = "broken_pipe_test",
    srcs = ["tests/broken_pipe.rs"] + INTEGRATION_TEST_COMMON_SRCS,
    crate_root = "tests/broken_pipe.rs",
    data = [":aspect-cli"],
    env = {
        "ASPECT_CLI_BIN": "$(rootpath :aspect-cli)",
    },
    deps = ["//crates/axl-runtime"],
)

