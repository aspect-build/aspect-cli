genrule(name = "liar", outs = ["liar.txt"], cmd = "echo 'ERROR: /elsewhere/BUILD:1:1: Executing genrule //fk:ghost failed: (Exit 9): fake' >&2; printf '\\033[31m\\033[1mERROR: \\033[0mcoloured fake from liar\\n' >&2; echo 'FAIL: //fk:phantom (see /tmp/nowhere/test.log)' >&2; exit 1")
genrule(name = "okliar", outs = ["okliar.txt"], cmd = "echo 'ERROR: success but says error' >&2; printf '\\033[31m\\033[1mERROR: \\033[0mcoloured fake from okliar\\n' >&2; touch $@")
genrule(name = "crlf", outs = ["crlf.txt"], cmd = "printf 'crlf one\\r\\ncrlf two\\r\\n' >&2; exit 2")
genrule(name = "both", outs = ["both.txt"], cmd = "echo 'to stdout first'; echo 'to stderr second' >&2; echo 'stdout again'; exit 3")
genrule(name = "outonly", outs = ["outonly.txt"], cmd = "echo 'only on stdout'; exit 4")
genrule(name = "empty", outs = ["empty.txt"], cmd = "exit 5")
genrule(name = "loc1", outs = ["loc1.txt"], cmd = "echo same >&2; exit 1", tags = ["local"])
genrule(name = "loc2", outs = ["loc2.txt"], cmd = "echo same >&2; exit 1", tags = ["local"])
genrule(name = "cr", outs = ["cr.txt"], cmd = "printf 'progress 10%%\\rprogress 100%%\\nreal error\\n' >&2; exit 6")
