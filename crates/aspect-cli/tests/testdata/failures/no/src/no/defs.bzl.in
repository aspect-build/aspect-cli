def _impl(ctx):
    o = ctx.actions.declare_file(ctx.label.name + ".out")
    ctx.actions.run_shell(outputs = [o], command = ctx.attr.cmd, progress_message = "Processing %{output}", mnemonic = "Proc")
    return [DefaultInfo(files = depset([o]))]
proc = rule(implementation = _impl, attrs = {"cmd": attr.string()})

def _two_impl(ctx):
    outs = []
    for i, cmd in enumerate(ctx.attr.cmds):
        o = ctx.actions.declare_file("%s.%d" % (ctx.label.name, i))
        ctx.actions.run_shell(outputs = [o], command = cmd, arguments = [o.path], progress_message = "Processing %{output}", mnemonic = "Proc")
        outs.append(o)
    return [DefaultInfo(files = depset(outs))]
two = rule(implementation = _two_impl, attrs = {"cmds": attr.string_list()})

def _x_impl(ctx):
    a = ctx.actions.declare_file(ctx.label.name + ".a")
    b = ctx.actions.declare_file(ctx.label.name + ".b")
    ctx.actions.run_shell(outputs = [a], command = "echo 'A side broke' >&2; exit 1", progress_message = "Preparing " + b.short_path, mnemonic = "Prep")
    ctx.actions.run_shell(outputs = [b], command = "sleep 0.5; echo 'B side broke' >&2; exit 1", progress_message = "Finishing " + a.short_path, mnemonic = "Fin")
    return [DefaultInfo(files = depset([a, b]))]
cross = rule(implementation = _x_impl)

def _n_impl(ctx):
    a = ctx.actions.declare_file(ctx.label.name + ".a")
    b = ctx.actions.declare_file(ctx.label.name + ".b")
    ctx.actions.run_shell(outputs = [a], command = "echo 'same' >&2; exit 1", progress_message = "Working", mnemonic = "W")
    ctx.actions.run_shell(outputs = [b], command = "sleep 0.5; echo 'same' >&2; exit 1", progress_message = "Working", mnemonic = "W")
    return [DefaultInfo(files = depset([a, b]))]
nomsg = rule(implementation = _n_impl)
