load("@rules_cc//cc:defs.bzl", "cc_test")
genrule(name = "brk", outs = ["brk.h"], cmd = "echo 'brk gen failed' >&2; exit 7")
cc_test(name = "unbuilt", srcs = ["ok.cc", ":brk"])
cc_test(name = "bad", srcs = ["bad.cc"])
cc_test(name = "noc", srcs = ["noc.cc"])
cc_test(name = "sh", srcs = ["sh.cc"], shard_count = 3)
cc_test(name = "rpt", srcs = ["bad.cc"])
cc_test(name = "fl", srcs = ["fl.cc"], tags = ["no-sandbox"])
cc_test(name = "good", srcs = ["ok.cc"])
