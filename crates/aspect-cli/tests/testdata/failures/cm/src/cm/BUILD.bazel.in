genrule(name = "okmid", outs = ["a"], cmd = "echo 'mid one' >&2; printf '\\033[31m\\033[1mERROR: \\033[0mmid fake\\n' >&2; echo 'mid three' >&2; touch $@")
genrule(name = "okwarn", outs = ["b"], cmd = "echo 'warn one' >&2; printf '\\033[35mWARNING: \\033[0mtool warn\\n' >&2; printf '\\033[31m\\033[1mERROR: \\033[0mafter warn fake\\n' >&2; echo 'warn four' >&2; touch $@")
genrule(name = "failwarn", outs = ["c"], cmd = "echo 'fw before' >&2; printf '\\033[35mWARNING: \\033[0mfw tool warn\\n' >&2; echo 'fw after' >&2; exit 2")
genrule(name = "failinfo", outs = ["d"], cmd = "echo 'fi before' >&2; printf '\\033[32mINFO: \\033[0mFrom fake thing:\\n' >&2; printf '\\033[31m\\033[1mERROR: \\033[0mfi fake inside\\n' >&2; echo 'fi after' >&2; exit 3")
genrule(name = "okdup1", outs = ["e"], cmd = "echo 'dup line' >&2; printf '\\033[31m\\033[1mERROR: \\033[0mdup tail\\n' >&2; touch $@")
genrule(name = "okdup2", outs = ["f"], cmd = "echo 'dup line' >&2; printf '\\033[31m\\033[1mERROR: \\033[0mdup tail\\n' >&2; touch $@")
genrule(name = "okcr", outs = ["g"], cmd = "printf 'spin 1\\rspin 2\\rdone\\n' >&2; printf '\\033[31m\\033[1mERROR: \\033[0mcr tail fake\\n' >&2; touch $@")
genrule(name = "faildebug", outs = ["h"], cmd = "echo 'fd one' >&2; echo 'DEBUG: fd debug line' >&2; echo 'fd three' >&2; exit 4")
genrule(name = "failred", outs = ["i"], cmd = "printf '\\033[31mred error text\\033[0m\\n' >&2; printf '\\033[31m\\033[1mERROR: \\033[0mfr fake last\\n' >&2; exit 5")
