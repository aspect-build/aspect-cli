load(":defs.bzl", "two", "three", "nolabel")
two(name = "two")
genrule(name = "longline", outs = ["l.txt"], cmd = "python3 -c \"print('E: ' + ' '.join(['word%d' % i for i in range(200)]))\" >&2; exit 1")
genrule(name = "empty", outs = ["e.txt"], cmd = "exit 4")
genrule(name = "unicode", outs = ["u.txt"], cmd = "echo 'エラー: ファイルが見つかりません ' >&2; python3 -c \"print('漢字' * 120)\" >&2; exit 1")
three(name = "three")
nolabel(name = "nolabel")
genrule(name = "tabs", outs = ["tabs.txt"], cmd = "printf 'E:\\tcol1\\tcol2\\tcol3\\tcol4\\tcol5\\tcol6\\tcol7\\tcol8\\tcol9\\tcol10\\tcol11\\tcol12\\tcol13\\tcol14\\tcol15\\tcol16\\tcol17\\tcol18\\tcol19\\tcol20\\n' >&2; exit 1")
genrule(name = "nospace", outs = ["ns.txt"], cmd = "python3 -c \"print('X' * 290)\" >&2; exit 1")
genrule(name = "cjkspace", outs = ["cjk.txt"], cmd = "python3 -c \"print(' '.join(['漢字漢字漢字'] * 30))\" >&2; exit 1")
genrule(name = "tabcjk", outs = ["tc.txt"], cmd = "printf '漢字\\tA\\t漢\\tBB\\t漢字漢字漢字\\tC\\n' >&2; exit 1")
