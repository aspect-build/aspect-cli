{
  "name": "_base",
  "description": "Every theme's root: the theme-level settings, the derived roles (each defined from a core role) and ANSI defaults for the core roles. Not selectable; a theme without `extends` extends this.",
  "appearance": "any",
  "bazel": "shared",
  "follow_terminal": ["muted", "subtle", "success", "warning", "error", "tip.important", "selection", "hover", "search.match"],
  "roles": {
    "text": "default",
    "muted": "default",
    "subtle": "bright-black",
    "accent": "cyan",
    "info": "@muted",
    "success": "green",
    "warning": "yellow",
    "error": "red",
    "link.hover": { "fg": "@accent", "bold": true, "underline": true },
    "selection": { "reverse": true },
    "hover": { "underline": true },
    "strong": { "fg": "@text", "bold": true },
    "heading": { "fg": "@accent", "bold": true },
    "title": { "fg": "@accent", "bold": true, "underline": true },
    "highlight": { "fg": "@accent", "bold": true },
    "progress": "@accent",
    "prompt": "@accent",
    "marker": { "fg": "@accent", "bold": true },
    "task": { "fg": "@accent", "bold": true },
    "task.label": "@text",
    "phase": { "fg": "@accent", "bold": true },
    "phase.title": "@highlight",
    "phase.update": "@muted",
    "phase.text": "@text",
    "verdict.success": "@success",
    "verdict.failure": "@error",
    "verdict.cancelled": "@warning",
    "verdict.verb": "@highlight",
    "border": "@subtle",
    "scrollbar": "@accent",
    "active": { "reverse": true },
    "header": "@strong",
    "status_bar": { "reverse": true, "bold": true },
    "search.current": "@active",
    "search.match": { "bold": true, "underline": true },
    "link": { "fg": "@accent", "underline": true },
    "link.quiet": { "fg": "@muted", "underline": true },
    "link.file": { "underline": "hyperlinks" },
    "label.debug": { "fg": "@muted" },
    "label.info": { "fg": "@info", "bold": true },
    "label.success": { "fg": "@success", "bold": true },
    "label.warning": { "fg": "@warning", "bold": true },
    "label.error": { "fg": "@error", "bold": true },
    "tip.label": "@heading",
    "tip.id": "@muted",
    "tip.warning": "@label.warning",
    "tip.important": { "fg": "magenta", "bold": true },
    "tip.suggestion": "@strong",
    "tip.note": "@label.debug",
    "bazel.error": "@label.error",
    "bazel.warning": "@label.warning",
    "bazel.info": { "fg": "@muted", "bold": true },
    "bazel.debug": { "fg": "@muted" },
    "bazel.progress": { "fg": "@muted" },
    "bazel.status.success": "@label.success",
    "bazel.status.failed": "@label.error",
    "bazel.fail": "@label.error",
    "bazel.test.passed": "@success",
    "bazel.test.flaky": "@warning",
    "bazel.test.failed": "@error",
    "bazel.test.no_status": "@muted",
    "syntax.text": "@text",
    "syntax.comment": "@muted",
    "syntax.keyword": "magenta",
    "syntax.string": "green",
    "syntax.constant": "yellow",
    "syntax.type": "yellow",
    "syntax.function": "blue",
    "syntax.variable": "red",
    "syntax.escape": "cyan"
  }
}
