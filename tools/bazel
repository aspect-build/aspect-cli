#!/usr/bin/env bash
# aspect-build/tools-bazel-wrapper
#
# Bazelisk's `tools/bazel` hook, routing `bazel <verb>` through the Aspect CLI
# for the verbs aspect wraps and to vanilla bazel for the rest. Arguments are
# forwarded verbatim; the wrapper only picks which binary to exec.
#
# Vendored from https://github.com/aspect-build/aspect-cli/blob/main/tools/bazel
# by `aspect setup tools-bazel-wrapper`; tools/bazel.md documents it. The marker
# comment above and ASPECT_BAZEL_WRAPPER_VERSION below are how aspect recognizes
# this file, so keep both if you fork it.
#
# Routing, first match wins:
#   ASPECT_CLI_RUNNING, ASPECT_WRAPPER_SKIP, or no verb   → bazel
#   verb in BAZEL_VERBS and not in ASPECT_VERBS           → bazel
#   anything else: ASPECT_VERBS or a custom .axl task     → aspect
#
# Environment:
#   ASPECT_WRAPPER_SKIP=1   forward everything to vanilla bazel, this run only
#   ASPECT_WRAPPER_TRACE=1  also trace plain bazel forwards; aspect routes always trace
#   ASPECT_WRAPPER_QUIET=1  no trace at all
#   ASPECT_CLI_RUNNING=1    set by aspect on the bazel it spawns, so the wrapper
#                           forwards straight to bazel instead of re-entering aspect
#   BAZEL_REAL              the real bazel, set by Bazelisk; found on PATH when unset

set -euo pipefail

# Bumped when the routing rules or env-var contract change.
ASPECT_BAZEL_WRAPPER_VERSION="2"
export ASPECT_BAZEL_WRAPPER_VERSION

# --- Configuration: edit these in your repo's copy -------------------------

# Verbs routed to aspect: the Bazel verbs it wraps plus its own verbs that drive
# bazel. An unlisted verb also routes to aspect, so listing one only buys the
# vanilla-bazel fallback when aspect is not installed, which helps for Bazel verbs.
ASPECT_VERBS=(build buildifier delivery format gazelle lint test)

# Every Bazel command (Bazel 9). One here and not above goes to vanilla bazel.
# Regenerate: bazel help completion | sed -n 's/^BAZEL_COMMAND_LIST="\(.*\)"$/\1/p'
# (`bazel help` hides some commands, such as `config`; one missing here is misrouted to aspect.)
BAZEL_VERBS=(
    aquery build canonicalize-flags clean config coverage cquery dump fetch
    help info license mobile-install mod print_action query run shutdown
    test vendor version
)

# Startup options that take a separate value, so `bazel --bazelrc build query`
# routes `query`, not `build`. Boolean options consume nothing and stay out.
# Regenerate: bazel help startup_options | awk '/^  --[a-z_]+ \(/ { print $1 }'
BAZEL_STARTUP_VALUE_FLAGS=(
    --bazelrc --connect_timeout_secs --digest_function --experimental_cgroup_parent
    --extra_classpath --failure_detail_out --host_jvm_args --host_jvm_profile
    --io_nice_level --local_startup_timeout_secs --macos_qos_class --max_idle_secs
    --output_base --output_user_root --server_javabase --server_jvm_out
)

# --- Helpers ----------------------------------------------------------------

DOCS="https://github.com/aspect-build/aspect-cli/blob/main/tools/bazel.md"
SKIP_HINT=" | set ASPECT_WRAPPER_SKIP=1 to skip the forward to \`aspect\`"

# has <needle> <items...>
has() {
    local needle="$1"
    shift
    [[ " $* " == *" $needle "* ]]
}

# trace <suffix> <argv...>: one `[tools/bazel] <argv><suffix>` line on stderr,
# grey where color renders (a TTY, CI logs, or forced by TRACE), with args
# quoted so the line can be pasted back into a shell.
trace() {
    [[ -n "${ASPECT_WRAPPER_QUIET:-}" ]] && return 0
    local suffix="$1" line="" grey="" reset="" a sq="'\\''"
    shift
    if [[ -t 2 || -n "${ASPECT_WRAPPER_TRACE:-}" || -n "${CI+x}${BUILDKITE+x}${GITHUB_ACTIONS+x}${CIRCLECI+x}${GITLAB_CI+x}" ]]; then
        grey=$'\033[38;5;244m' reset=$'\033[0m'
    fi
    for a in "$@"; do
        if [[ -z "$a" || -n "${a//[A-Za-z0-9._\/=:@,+-]/}" ]]; then
            line+=" '${a//\'/$sq}'"
        else
            line+=" $a"
        fi
    done
    printf '%s[tools/bazel]%s%s%s\n' "$grey" "$line" "$suffix" "$reset" >&2
}

# Plain forwarding is silent unless TRACE asks for it.
run_bazel() {
    [[ -n "${ASPECT_WRAPPER_TRACE:-}" ]] && trace "" "$BAZEL_REAL" "$@"
    exec "$BAZEL_REAL" "$@"
}

# --- Dispatch ---------------------------------------------------------------

# Bazelisk sets BAZEL_REAL; a direct or aspect-child invocation has to find the
# next `bazel` on PATH that is not this script.
if [[ -z "${BAZEL_REAL:-}" || ! -x "$BAZEL_REAL" ]]; then
    BAZEL_REAL=""
    while IFS= read -r candidate; do
        if [[ ! "$candidate" -ef "$0" ]]; then
            BAZEL_REAL="$candidate"
            break
        fi
    done < <(type -aP bazel 2>/dev/null || true)
    if [[ -z "$BAZEL_REAL" ]]; then
        echo "ERROR: tools/bazel: cannot find a real bazel binary on PATH (and BAZEL_REAL is unset)" >&2
        exit 127
    fi
fi

# A bazel spawned by aspect must not come back through aspect. No trace here:
# it would land inside aspect's own output.
[[ -n "${ASPECT_CLI_RUNNING:-}" ]] && exec "$BAZEL_REAL" "$@"
[[ -n "${ASPECT_WRAPPER_SKIP:-}" ]] && run_bazel "$@"

# The verb is the first bare token that is not a startup option's value,
# preferring one we know so `bazel --bazelrc build query` picks `query`. A
# wrong guess routes to aspect, which does its own walk. `--` ends the search.
verb="" first_bare="" skip=0
for arg in "$@"; do
    [[ "$arg" == "--" ]] && break
    if [[ "$arg" == -* ]]; then
        skip=0
        [[ "$arg" != *=* ]] && has "$arg" "${BAZEL_STARTUP_VALUE_FLAGS[@]}" && skip=1
        continue
    fi
    if ((skip)); then
        skip=0
        continue
    fi
    if has "$arg" "${BAZEL_VERBS[@]}" "${ASPECT_VERBS[@]}"; then
        verb="$arg"
        break
    fi
    : "${first_bare:=$arg}"
done
verb="${verb:-$first_bare}"

# No verb, or a Bazel verb aspect does not wrap (query, info, clean, ...).
if [[ -z "$verb" ]] || { has "$verb" "${BAZEL_VERBS[@]}" && ! has "$verb" "${ASPECT_VERBS[@]}"; }; then
    run_bazel "$@"
fi

# Everything else goes to aspect. A verb bazel also has (build, test) is being
# shadowed, so the trace says how to skip the forward.
shadow=""
has "$verb" "${BAZEL_VERBS[@]}" && shadow="$SKIP_HINT"

if ! command -v aspect >/dev/null 2>&1; then
    cat >&2 <<EOF
[tools/bazel] \`bazel ${verb}\` runs through the Aspect CLI (\`aspect\`), which is not on your PATH.

  Install it with:

    curl -fsSL https://install.aspect.build | bash

  or see https://aspect.build/docs/cli/install
EOF
    [[ -z "$shadow" ]] && exit 127
    echo "  Running it through vanilla bazel for now." >&2
    run_bazel "$@"
fi

export BAZEL_REAL
trace "$shadow — docs: $DOCS" aspect "$@"
exec aspect "$@"
