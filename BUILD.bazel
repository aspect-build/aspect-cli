# Gazelle directives — applied repo-wide. The `examples/` tree is
# user-facing fixture content (not part of the bazel build) so we
# exclude it from gazelle's BUILD-file generation.
# gazelle:exclude examples

alias(
    name = "launcher",
    actual = "//crates/aspect-launcher",
)

alias(
    name = "cli",
    actual = "//crates/aspect-cli",
)

alias(
    name = "docgen",
    actual = "//crates/axl-docgen",
)

exports_files(
    [
        "LICENSE",
        "README.md",
        ".shellcheckrc",
    ],
    visibility = ["//visibility:public"],
)

exports_files(
    ["MODULE.aspect"],
    visibility = ["//crates/aspect-cli:__pkg__"],
)

# This repo's own `.aspect/` config, for tests that load the surface it defines.
filegroup(
    name = "aspect_config",
    srcs = glob([".aspect/**"]),
    visibility = ["//crates/aspect-cli:__pkg__"],
)
