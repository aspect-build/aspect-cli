"""`OpenInvocation`: an example plugin, ported from BuildBuddy's open-source
[open-invocation](https://github.com/buildbuddy-io/buildbuddy/tree/master/cli/plugins/open-invocation)
CLI plugin. Opens the invocation's results page in a browser when the task
ends.

Off by default, as the plugin's `--open` is: `--open-invocation:enabled=true`.

The page depends on who uploads the build event stream:

- The CLI's own sinks: the viewer advertised for the backend they stream to
  joined with the sinks' invocation id, both read from the task's `Phases`
  updates (`aspect_results_url`, `sink_invocation_id`).
- Bazel itself: `--bes_results_url` joined with the uuid of the stream's
  `build_started` event. The URL is read from Bazel's parsed command line
  (`options_parsed`), which has the rc's and the task's flags in it.

The CLI's sinks win when both apply. Only on a terminal.
"""

load("@aspect//bazel.axl", "BazelTrait")
load("@aspect//traits.axl", "Phases")

def results_page(bazel_base, bazel_uuid, data):
    """The results page to open, or `""`: the CLI-streamed invocation's when
    `data` (a task update's) names one, else the one Bazel uploaded."""
    base = data.get("aspect_results_url", "") or ""
    inv = data.get("sink_invocation_id", "") or ""
    if not (base and inv):
        base, inv = bazel_base, bazel_uuid
    if not (base and inv):
        return ""
    return base.rstrip("/") + "/" + inv

def _open_impl(ctx: FeatureContext):
    state = {"base": "", "uuid": "", "data": {}}

    def _rc(task_ctx, rc, command):
        state["base"] = rc.flag_value("--bes_results_url", command = command) or ""
        return []

    def _event(task_ctx, event):
        if event.kind == "build_started" and not state["uuid"]:
            state["uuid"] = getattr(event.payload, "uuid", "") or ""
        elif event.kind == "options_parsed":
            for arg in getattr(event.payload, "cmd_line", None) or []:
                if arg.startswith("--bes_results_url="):
                    state["base"] = arg.partition("=")[2]

    def _update(task_ctx, update):
        if update.data:
            state["data"] = update.data

    def _post(task_ctx, conclusion):
        url = results_page(state["base"], state["uuid"], state["data"])
        if not (url and task_ctx.std.io.stdout.is_tty):
            return
        task_ctx.std.io.stderr.write("> Opening %s\n" % url)
        opener = "open" if task_ctx.std.env.os() == "macos" else "xdg-open"
        task_ctx.std.process.command(opener).args([url]).spawn().wait()

    t = ctx.traits[BazelTrait]
    t.rc_flags.append(_rc)
    t.build_event.append(_event)
    ctx.traits[Phases].task_update.append(_update)
    ctx.hooks.post_task(_post)

OpenInvocation = feature(
    display_name = "Open invocation",
    summary = "Open the invocation's results page in a browser when the task ends.",
    implementation = _open_impl,
    enabled = False,
)
