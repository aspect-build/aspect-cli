"""`Notify`: BuildBuddy's notify CLI plugin. A desktop notification when a task
that ran Bazel ends, with how it ended and the time Bazel took.

Off by default, as the plugin's `--notify` is: `--notify:enabled=true`, or
`ctx.features[Notify].enabled = True`. The result comes from the build event
stream (`build_finished`, `build_metrics`) rather than from Bazel's console
lines, whose wording varies and which stages may hide.
"""

load("@aspect//bazel.axl", "BazelTrait")

def _notify_impl(ctx: FeatureContext):
    state = {"ran": False, "wall_ms": 0, "status": ""}

    def _start(task_ctx):
        state["ran"] = True

    def _event(task_ctx, event):
        if event.kind == "build_metrics":
            timing = getattr(event.payload, "timing_metrics", None)
            state["wall_ms"] += getattr(timing, "wall_time_in_ms", 0) or 0
        elif event.kind == "build_finished":
            code = getattr(event.payload, "exit_code", None)
            state["status"] = getattr(code, "name", "") or "SUCCESS"

    def _post(task_ctx, conclusion):
        if not state["ran"]:
            return
        title = "aspect %s %s" % (task_ctx.task.kind, "succeeded" if conclusion.exit_code == 0 else "failed")
        body = "%s, %ds in Bazel" % (state["status"] or "done", state["wall_ms"] // 1000)
        process = task_ctx.std.process
        if task_ctx.std.env.os() == "macos":
            script = 'display notification "%s" with title "%s"' % (body, title)
            if ctx.args.sound:
                script += ' sound name "%s"' % ctx.args.sound
            process.command("osascript").args(["-e", script]).spawn().wait()
        elif process.which("notify-send"):
            process.command("notify-send").args(["--expire-time=3000", title, body]).spawn().wait()

    t = ctx.traits[BazelTrait]
    t.build_start.append(_start)
    t.build_event.append(_event)
    ctx.hooks.post_task(_post)

Notify = feature(
    display_name = "Notify",
    summary = "A desktop notification when a task that ran Bazel ends.",
    implementation = _notify_impl,
    enabled = False,
    args = {
        "sound": args.string(
            default = "",
            description = "On macOS, the name of a sound to play with it (`Tink`, `Glass`, ...); none by default.",
        ),
    },
)
