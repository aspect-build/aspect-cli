"""`Theme`: an example plugin, ported from BuildBuddy's open-source
[theme-modern](https://github.com/siggisim/theme-modern) and
[theme-mono](https://github.com/siggisim/theme-mono) CLI plugins as console
stages: Bazel's highlights recoloured, emoji on its closing lines, and each
running action's elapsed seconds coloured by how long it has run, all in the
CLI theme's roles.

The CLI's own themes now colour Bazel's console (see `docs/themes.md`), so
this is an example of what a `rewrite` stage can do rather than a way to
theme Bazel, and it is off by default: it would override the real theme for
everyone in this repo. Turn it on for a run, or with
`ctx.features[Theme].enabled = True`:

    aspect build //... --theme --theme:style=mono

Everything is a `rewrite` stage, so where curses is shown it reaches the rows
of Bazel's live progress area too; in plain lines there are none. A
rewritten row stays one row: under a PTY a row made wider than Bazel drew it
is cut to that many terminal columns, so a running action's marker takes the
place of three of its indent's spaces. Colour is added only where stderr
takes it (`std.io.stderr.color`: a terminal or a CI log that renders it, as
`NO_COLOR` and the rest allow); where the console shows none, what a stage
adds is stripped with Bazel's own.

The stages see the theme's colours, not Bazel's: with the theme's `bazel`
setting `shared`, the console recolours Bazel's labels and progress before
any stage runs. So the highlight stage matches the theme's `bazel.info` and
`bazel.progress` codes as well as Bazel's own green. To change those colours
alone, override the roles (`ctx.theme.roles` in a `config.axl`, or
`"theme": {"roles": …}` in `~/.aspect/config.json`) rather than rewrite them.
"""

load("@aspect//bazel.axl", "BazelTrait")

_RESET = "\x1b[0m"

# The escapes a row starts with; `rewrite` sees them, the other stages do not.
_LEAD = r"(?:\x1b\[[0-9;?]*[A-Za-z])*"

def _running(emoji, tail, bold):
    """A running-action row (`    Compiling x; 12s remote`): three of its
    indent's spaces become `emoji` (two columns) and a space, so the row
    stays as wide as Bazel drew it, and the first word is `bold`."""
    return bazel.output.rewrite(
        r"^(" + _LEAD + r"\s*)\s\s\s([^\s⚡🔨]\S*)(" + tail + r")$",
        "${1}" + emoji + " " + bold + "${2}" + _RESET + "${3}",
    )

def _seconds(muted, digits, sgr):
    """The `; <n>s` of a row `_running` marked, coloured `sgr` for `digits`."""
    return bazel.output.rewrite(
        r"^(.*(?:⚡️|🔨) .*?); (" + digits + r")s(.*)$",
        "${1}" + muted + "; " + _RESET + sgr + "${2}s" + _RESET + muted + "${3}" + _RESET,
    )

def _bazel_green(theme):
    """A pattern for the colour Bazel's `INFO:` and progress start with:
    Bazel's own green, or the theme's roles for them when it recoloured."""
    codes = ["32"] + [theme.params(r) for r in ["bazel.info", "bazel.progress"] if theme.params(r)]
    return r"\x1b\[(?:" + "|".join(codes) + ")m"

def _stages(theme, highlight, buckets):
    """The stages of a style: `highlight` (a role) for Bazel's green labels,
    and `(digits regex, role)` bands for a running action's seconds,
    disjoint; the rest in `theme`'s `muted`, `link` and `strong`."""
    sgr = lambda role: theme.sgr(role, stream = True)
    muted = sgr("muted")
    strong = sgr("strong")
    stages = [
        bazel.output.rewrite(r"(Starting local Bazel server.*connecting to it\.\.\.)", muted + "${1}" + _RESET),
        bazel.output.rewrite(_bazel_green(theme) + r"(INFO|Loading|Analyzing|\[)", sgr(highlight) + "${1}"),
        bazel.output.rewrite(r"(Build did NOT complete successfully)", "${1} ❌"),
        bazel.output.rewrite(r"Build completed successfully, ", "Build completed successfully ✅ "),
        bazel.output.rewrite(r"Starting clean\.", "Starting clean 🧽"),
        bazel.output.rewrite(r"(build interrupted)", "${1} 😡"),
        bazel.output.rewrite(r"(Streaming build results to: )(\S+)", "${1}" + sgr("link") + "${2}" + _RESET),
        bazel.output.rewrite(
            r"(Elapsed time: )([0-9.]+s)(, Critical Path: )([0-9.]+s)",
            "${1}" + strong + "${2}" + _RESET + " ⏳${3}" + strong + "${4}" + _RESET + " ⏰",
        ),
        # Remote first: the 🔨 pattern leaves a row already marked alone.
        _running("⚡️", r".*; [0-9]+s.* remote.*", strong),
        _running("🔨", r".*; [0-9]+s.*", strong),
    ]
    return stages + [_seconds(muted, d, sgr(role)) for d, role in buckets]

STYLES = {
    "modern": lambda theme: _stages(theme, "label.success", [
        ("[0-4]", "muted"),
        ("[5-9]|1[0-9]", "warning"),
        ("[2-5][0-9]", "error"),
        ("[6-9][0-9]|[1-9][0-9]{2,}", "label.error"),
    ]),
    "mono": lambda theme: _stages(theme, "strong", [
        ("[0-4]", "muted"),
        ("[5-9]|[12][0-9]", "strong"),
        ("[3-9][0-9]|[1-9][0-9]{2,}", "title"),
    ]),
}

def _theme_impl(ctx: FeatureContext):
    if not ctx.std.io.stderr.color:
        return
    ctx.traits[BazelTrait].output_stages.extend(STYLES[ctx.args.style](ctx.std.theme))

Theme = feature(
    display_name = "Console theme",
    summary = "Recolour Bazel's console, after BuildBuddy's theme-modern and theme-mono plugins: an example of `rewrite` stages.",
    implementation = _theme_impl,
    enabled = False,
    args = {
        "style": args.string(
            default = "modern",
            values = list(STYLES.keys()),
            description = "`modern`: highlights in the theme's success colour, seconds muted to error. `mono`: highlights bold, seconds muted to bold underlined.",
        ),
    },
)
