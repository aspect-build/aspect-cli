axl_local_dep(
    name = "demo",
    path = ".aspect/modules/demo",
    auto_use_tasks = True,
)

axl_local_dep(
    name = "dev",
    path = ".aspect/modules/dev",
    auto_use_tasks = True,
)

use_task(".aspect/user/user-task-manual.axl", "user_task_manual")

# Example plugins ported from BuildBuddy's open-source CLI plugins
# (.aspect/plugins/), showing how AXL customizes and extends Bazel. Configured
# in .aspect/config.axl.
use_feature(".aspect/plugins/theme.axl", "Theme")
use_feature(".aspect/plugins/go_highlight.axl", "GoHighlight")
use_feature(".aspect/plugins/go_deps.axl", "GoDeps")
use_feature(".aspect/plugins/notify.axl", "Notify")
use_feature(".aspect/plugins/open_invocation.axl", "OpenInvocation")
use_feature(".aspect/plugins/ping_remote.axl", "PingRemote")
